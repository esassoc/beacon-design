# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Public Mapbox access token (starts with "pk.", NOT "sk.") — used for every
# Leaflet basemap in the spoke (src/lib/basemap.ts). Get one free at
# https://account.mapbox.com/access-tokens/. Safe to expose client-side: it's
# a public token, scoped/rate-limited on Mapbox's own dashboard, not a secret.
PUBLIC_MAPBOX_TOKEN=
