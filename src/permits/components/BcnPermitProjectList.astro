---
// <BcnPermitProjectList> — the Permit Tracker's Projects index body: one heading
// ("My projects") over a responsive grid of project cards.
// Each card is an esa-card whose project name is the one real link; its ::after
// stretches over the whole card, so a click anywhere opens the project while
// keyboard focus and the accessible name stay on that single <a>.
//
// A card answers "where does this project stand on permits?" in the order a project
// manager asks it (ESA design pass):
//   name + client (header) with the project's state badge (On track / At risk /
//   Unconfirmed / All issued: the same scheduleOf() rule as the project page's "Ready to
//   break ground?"); then the two dates that badge is judged on, expected all issued
//   (with its distance from start) beside construction start; then the permit mix
//   (BcnPermitMix: issued / with the agency / preparing / not started); then a footer of
//   who and where (project number, manager, sites) and, active only, the flags that need
//   attention: waiting on another permit, expiring/expired. Zero counts are omitted.
//   Closed cards drop the dates, the mix and the flags.
//
// MEMBERSHIP: with `member`, only the projects whose team includes that person show.
// The build hides cards by the fixture team (teamOf); the client re-checks every card
// against the browser's team store (src/lib/project-team-store.ts) and re-checks on
// TEAM_EVENT, so adding or removing someone on a project page shows here. When no card
// is left, an esa-empty-state points to All projects.
//
// PROJECT EDITS: the client re-reads each card's client, number, manager and
// construction start from src/lib/project-store.ts and re-runs the state badge with the
// saved construction start (badges cloned from SSR'd templates, one per state).
//
// STATUS IS SSR: issued = the fixture statusId resolved through statusColumn() to the
// Completed category. The index renders no per-permit status chip, so it does not hook
// the browser status store (user overrides live per project, on the project page).
//
// bcn-lego-checked: the card shell IS esa-card and the meter IS esa-progress-bar —
// checked Ecology (esa-card has no href/link mode, hence the stretched-link wrapper;
// no lego for a project tile) and Beacon (projects list is a grid table, not cards).
// bcn-permit-project-list is the reusable home; only the stretched link and the fact
// rows are composition here.
import EsaCard from '@esa/ecology/esa-card.astro';
import EsaIcon from '@esa/ecology/esa-icon.astro';
import BcnPermitMix from './BcnPermitMix.astro';
import EsaEmptyState from '@esa/ecology/esa-empty-state.astro';
import EsaBadge from '@esa/ecology/esa-badge.astro';
import {
  ROUTES,
  blockers,
  expiryFlag,
  fmtDate,
  permitsOfProject,
  READINESS_BADGE,
  type ReadinessState,
  sitesOf,
  statusColumn,
  teamOf,
  type Project,
} from '../data/permit-tracker';
import { withBase } from '../../lib/base';
import { readinessView, mixCounts, mixStage } from './permit-readiness';

interface Props {
  projects: Project[];
  /** Section heading, e.g. "My projects". */
  heading: string;
  /** Show only the projects this person is on the team of. */
  member?: string;
}
const { projects, heading, member } = Astro.props;

const plural = (n: number, one: string, many = `${one}s`) => `${n} ${n === 1 ? one : many}`;

const cards = projects.map((project) => {
  const permits = permitsOfProject(project.id);
  const issued = permits.filter((p) => statusColumn(p.statusId, p.typeId).category === 'Completed').length;
  const active = project.status === 'active';
  const attention = active
    ? [
        { n: permits.filter((p) => blockers(p).length > 0).length, text: 'waiting on another permit' },
        { n: permits.filter((p) => expiryFlag(p) === 'expiring').length, text: 'expiring soon' },
        { n: permits.filter((p) => expiryFlag(p) === 'expired').length, text: 'expired' },
      ].filter((a) => a.n > 0)
    : [];
  return {
    project,
    active,
    href: withBase(ROUTES.project(project.id)),
    total: permits.length,
    issued,
    sites: sitesOf(project.id).length,
    attention,
    hidden: !!member && !teamOf(project.id).includes(member),
    view: active ? readinessView(project.id, project.constructionStart) : undefined,
    mix: mixCounts(permits.map((p) => mixStage(statusColumn(p.statusId, p.typeId).category, !!p.submitted))),
  };
});
const STATES = Object.keys(READINESS_BADGE) as ReadinessState[];
const headingId = `bcn-ppl-${heading.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

<section class="bcn-ppl stack" data-gap="sm" aria-labelledby={headingId} data-bcn-ppl data-member={member}>
  {
    STATES.map((st) => (
      <template data-ppl-badge={st}>
        <EsaBadge value={READINESS_BADGE[st].label} variant={READINESS_BADGE[st].variant} />
      </template>
    ))
  }
  <h2 id={headingId} class="bcn-ppl__heading typography-heading-md">{heading}</h2>
  <ul class="bcn-ppl__grid grid" data-gap="md">
    {
      cards.map((c) => (
        <li class="bcn-ppl__item" data-closed={c.active ? undefined : ''} data-project-id={c.project.id} hidden={c.hidden}>
          <EsaCard padding="compact">
            <div slot="header" class="bcn-ppl__head repel" data-gap="sm">
              <div class="bcn-ppl__titles">
                <h3 class="bcn-ppl__name typography-title-sm-strong">
                  <a class="bcn-ppl__link" href={c.href}>{c.project.name}</a>
                </h3>
                <p class="bcn-ppl__client typography-body-sm" data-fact="client">{c.project.client}</p>
              </div>
              {c.view && (
                <span class="bcn-ppl__state" data-ppl-state>
                  <EsaBadge value={READINESS_BADGE[c.view.state].label} variant={READINESS_BADGE[c.view.state].variant} />
                </span>
              )}
            </div>

            <div class="stack" data-gap="md">
              {c.view && (
                <dl class="bcn-ppl__dates">
                  <div class="bcn-ppl__date">
                    <dt class="typography-label-sm">{c.view.expectedLabel}</dt>
                    <dd class="typography-title-sm-strong" data-fact="expected">{c.view.expectedValue}</dd>
                    <dd class="bcn-ppl__vs typography-body-sm" data-fact="vs" data-tone={c.view.vs.tone} hidden={!c.view.vs.text}>
                      <span class="bcn-ppl__vs-icon" data-icon="late"><EsaIcon name="triangle-alert" size="sm" /></span>
                      <span class="bcn-ppl__vs-icon" data-icon="early"><EsaIcon name="circle-check" size="sm" /></span>
                      <span data-fact="vs-text">{c.view.vs.text}</span>
                    </dd>
                  </div>
                  <div class="bcn-ppl__date">
                    <dt class="typography-label-sm">Construction Start</dt>
                    <dd class="typography-title-sm-strong" data-fact="start">{fmtDate(c.project.constructionStart)}</dd>
                    <dd class="bcn-ppl__muted typography-body-sm" data-fact="start-sub">{c.view.startSub}</dd>
                  </div>
                </dl>
              )}

              {c.active ? <BcnPermitMix counts={c.mix} /> : <p class="bcn-ppl__issued typography-body-sm">{plural(c.issued, 'permit')} issued</p>}

              <div class="bcn-ppl__foot typography-body-sm">
                <span class="bcn-ppl__who">
                  <span data-fact="number">{c.project.number}</span>
                  <span aria-hidden="true">·</span>
                  <span data-fact="manager">{c.project.manager}</span>
                  <span aria-hidden="true">·</span>
                  <span>{plural(c.sites, 'site')}</span>
                </span>
                {c.attention.length > 0 && (
                  <ul class="bcn-ppl__attention cluster" data-gap="sm">
                    {c.attention.map((a) => (
                      <li>
                        <span class="bcn-ppl__n">{a.n}</span> {a.text}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </div>
          </EsaCard>
        </li>
      ))
    }
  </ul>
  {
    member && (
      <div data-ppl-empty hidden={cards.some((c) => !c.hidden)}>
        <EsaEmptyState title="You're not on any active projects" description="Find your project in All projects, then add yourself to its team." />
      </div>
    )
  }
</section>

<script>
  import { TEAM_EVENT, isOnTeam } from '../lib/project-team-store';
  import { PROJECT_EVENT, loadProject } from '../lib/project-store';
  import { fmtDate } from '../data/permit-tracker';
  import { readinessView } from './permit-readiness';

  // Every card: its facts and state badge follow the saved project record.
  document.querySelectorAll<HTMLElement>('[data-bcn-ppl]').forEach((section) => {
    const badge = (state: string) =>
      section.querySelector<HTMLTemplateElement>(`[data-ppl-badge="${state}"]`)!.content.firstElementChild!.cloneNode(true);
    const sync = () =>
      section.querySelectorAll<HTMLElement>('[data-project-id]').forEach((li) => {
        const id = li.dataset.projectId!;
        const r = loadProject(id);
        const set = (fact: string, text: string) => {
          const el = li.querySelector(`[data-fact="${fact}"]`);
          if (el) el.textContent = text;
        };
        set('client', r.client);
        set('number', r.number);
        set('manager', r.manager);
        set('start', fmtDate(r.constructionStart));
        if (li.dataset.closed !== undefined) return;
        const view = readinessView(id, r.constructionStart);
        set('expected', view.expectedValue);
        set('start-sub', view.startSub);
        set('vs-text', view.vs.text);
        const vs = li.querySelector<HTMLElement>('[data-fact="vs"]');
        if (vs) {
          vs.dataset.tone = view.vs.tone;
          vs.hidden = !view.vs.text;
        }
        li.querySelector('[data-ppl-state]')?.replaceChildren(badge(view.state));
      });
    document.addEventListener(PROJECT_EVENT, sync);
    sync();
  });

  document.querySelectorAll<HTMLElement>('[data-bcn-ppl][data-member]').forEach((section) => {
    const member = section.dataset.member!;
    const items = [...section.querySelectorAll<HTMLElement>('[data-project-id]')];
    const empty = section.querySelector<HTMLElement>('[data-ppl-empty]');
    const sync = () => {
      items.forEach((li) => (li.hidden = !isOnTeam(li.dataset.projectId!, member)));
      if (empty) empty.hidden = items.some((li) => !li.hidden);
    };
    document.addEventListener(TEAM_EVENT, sync);
    sync();
  });
</script>

<style>
  .bcn-ppl__heading {
    margin: 0;
  }
  .bcn-ppl__grid {
    --grid-min: 20rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Stretched link: the wrapper is the positioning context, the name's ::after
     covers the card. Hover re-points esa-card's public border hook. */
  .bcn-ppl [hidden] {
    display: none;
  }
  .bcn-ppl__item {
    position: relative;
    display: flex;
    flex-direction: column;
  }
  .bcn-ppl__item > :global(.esa-card) {
    flex: 1;
  }
  .bcn-ppl__item:hover {
    --card-border-color: var(--color-border-default-strong, #8d8d8d);
  }
  .bcn-ppl__head {
    align-items: start;
    flex-wrap: nowrap;
  }
  .bcn-ppl__titles {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-050, 0.125rem);
    min-width: 0;
  }
  .bcn-ppl__state {
    flex-shrink: 0;
  }
  .bcn-ppl__name {
    margin: 0;
  }
  .bcn-ppl__link {
    color: var(--color-content-default, #202020);
    text-decoration: none;
  }
  .bcn-ppl__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-md, 0.5rem);
  }
  .bcn-ppl__item:hover .bcn-ppl__link {
    text-decoration: underline;
  }
  .bcn-ppl__link:focus-visible {
    outline: none;
  }
  .bcn-ppl__link:focus-visible::after {
    outline: var(--focus-ring-width, 2px) solid var(--focus-ring-color, #0d74ce);
    outline-offset: var(--focus-ring-offset, 2px);
  }
  .bcn-ppl__client {
    margin: 0;
    color: var(--color-content-default-secondary, #646464);
  }

  /* The two dates the badge is judged on, side by side. */
  .bcn-ppl__dates {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-400, 1rem);
    margin: 0;
  }
  .bcn-ppl__date {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-050, 0.125rem);
  }
  .bcn-ppl__date dt {
    color: var(--color-content-default-secondary);
  }
  .bcn-ppl__date dd {
    margin: 0;
    color: var(--color-content-default);
    font-variant-numeric: tabular-nums;
  }
  .bcn-ppl__muted,
  .bcn-ppl__date dd.bcn-ppl__muted {
    color: var(--color-content-default-secondary);
  }
  .bcn-ppl__vs {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-100, 0.25rem);
  }
  /* Status is the icon, in its tone; the words stay in ink. */
  .bcn-ppl__date dd.bcn-ppl__vs[data-tone='late'] {
    color: var(--color-content-default);
  }
  .bcn-ppl__vs[data-tone='late'] .bcn-ppl__vs-icon {
    color: var(--color-content-utility-danger);
  }
  .bcn-ppl__vs[data-tone='early'] .bcn-ppl__vs-icon {
    color: var(--color-content-utility-success);
  }
  .bcn-ppl__vs-icon {
    display: none;
  }
  .bcn-ppl__vs[data-tone='late'] [data-icon='late'],
  .bcn-ppl__vs[data-tone='early'] [data-icon='early'] {
    display: inline-flex;
  }

  .bcn-ppl__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--spacing-100, 0.25rem) var(--spacing-400, 1rem);
    padding-top: var(--spacing-300, 0.75rem);
    border-top: 1px solid var(--color-border-default-subtle, #e8e8e8);
    color: var(--color-content-default-secondary, #646464);
  }
  .bcn-ppl__who {
    display: inline-flex;
    flex-wrap: wrap;
    gap: var(--spacing-150, 0.375rem);
  }

  .bcn-ppl__issued {
    margin: 0;
    color: var(--color-content-default-secondary, #646464);
  }

  .bcn-ppl__attention {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .bcn-ppl__n {
    font-weight: var(--typography-font-weight-semibold, 600);
    color: var(--color-content-default, #202020);
    font-variant-numeric: tabular-nums;
  }
</style>
