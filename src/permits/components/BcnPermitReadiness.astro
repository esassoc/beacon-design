---
// <BcnPermitReadiness> — "Ready to break ground?", the top section of a Permits
// project page. Answers one question: can construction start on the project's target
// date? (ESA design pass of the Permit Tracker's component of the same name.)
//
// VERDICT FIRST. The card opens on the answer, not on figures:
//   • a toned band (state badge + one sentence from readinessView().verdict) that names
//     the dates the state is judged on, so the badge is never the only carrier of why
//   • three figures under it: the permit mix (BcnPermitMix: issued / in agency review /
//     preparing / not started, replacing the single issued meter and the separate
//     category count line), expected all-issued with its distance from construction
//     start, and construction start
//   • Sites: the same per-site table (Project-wide row, then each site), unchanged
//   • "Keep an eye on": every risk and derived flag as one list with a mark per line
//     (past typical review time, not yet submitted, can't be forecast, waiting on
//     another permit, expiring, expiring before construction start, by name)
//
// FORECAST + STATE: scheduleOf() in the data module (forecastIssue walks the dependency
// chain; at risk = expected all-issued after construction start, or a permit expiring
// before it). A permit is "past its typical review time" when its expectedIssue() is
// behind TODAY.
//
// LIVE CONSTRUCTION START: the build renders with the fixture's construction start; the
// client re-runs readinessView() with the one saved in src/permits/lib/project-store.ts
// and again on PROJECT_EVENT, so editing the project re-dates the verdict, the figures,
// the badge, the expiring-before-start list and the site schedule. Badges and the
// before/after marks are cloned from SSR'd templates so they stay legos.
//
// STATUS: the build counts the fixture statusId; the client re-counts the mix through
// resolveStatus() (the status store the List and Board use) on load and on
// CHANGE_EVENT, so a card moved on the Board shows here.
//
// bcn-lego-checked: frame is esa-card, figures are esa-stat, the state is esa-badge,
// the marks are esa-icon, the mix is bcn-permit-mix. No esa-* renders a toned verdict
// band (esa-alert-box is a dismissible notice with its own icon and role, wrong for a
// standing answer); checked Beacon (no readiness summary in prod). Only the band, the
// before/after line and the watch list are composition here.
import EsaCard from '@esa/ecology/esa-card.astro';
import EsaStat from '@esa/ecology/esa-stat.astro';
import EsaBadge from '@esa/ecology/esa-badge.astro';
import EsaIcon from '@esa/ecology/esa-icon.astro';
import BcnPermitMix from './BcnPermitMix.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import BcnSiteEditor from './BcnSiteEditor.astro';
import '@esa/tokens/a11y.css';
import {
  READINESS_BADGE,
  ROUTES,
  TODAY,
  blockers,
  expectedIssue,
  expiryFlag,
  fmtDate,
  getProject,
  permitsOfProject,
  scheduleOf,
  scopeLabel,
  sitesOf,
  statusColumn,
  type ReadinessState,
} from '../data/permit-tracker';
import { withBase } from '../../lib/base';
import { readinessView, siteScheduleRows, mixCounts, mixStage } from './permit-readiness';

interface Props {
  projectId: string;
  /** Add site and per-site edit buttons (BcnSiteEditor). */
  editable?: boolean;
  /** The shared (client) page: permit names are plain text, not links into the app. */
  readOnly?: boolean;
}
const { projectId, editable = false, readOnly = false } = Astro.props;

const project = getProject(projectId);
const permits = permitsOfProject(projectId);
const plural = (n: number, one: string, many = `${one}s`) => `${n} ${n === 1 ? one : many}`;

// ── counts (independent of construction start) ────────────────────────────────
const outstanding = permits.filter((p) => !p.issued);
const pastTypical = outstanding.filter((p) => {
  const e = expectedIssue(p);
  return e !== undefined && e < TODAY;
}).length;
const notSubmitted = outstanding.filter((p) => !p.submitted).length;
const schedule = scheduleOf(permits, project.constructionStart);

const waiting = permits.filter((p) => blockers(p).length > 0).length;
const expiringSoon = permits.filter((p) => expiryFlag(p) === 'expiring').length;
const expired = permits.filter((p) => expiryFlag(p) === 'expired').length;
const mix = mixCounts(permits.map((p) => mixStage(statusColumn(p.statusId, p.typeId).category, !!p.submitted)));

/** One line per risk or flag that applies: a mark (late = warning, info = clock), then words. */
const watch: { tone: 'late' | 'info'; text: string }[] = [];
if (pastTypical > 0) watch.push({ tone: 'late', text: `${plural(pastTypical, 'permit')} past ${pastTypical === 1 ? 'its' : 'their'} typical review time` });
if (expired > 0) watch.push({ tone: 'late', text: `${plural(expired, 'permit')} expired` });
if (expiringSoon > 0) watch.push({ tone: 'late', text: `${plural(expiringSoon, 'permit')} ${expiringSoon === 1 ? 'expires' : 'expire'} within 90 days` });
if (waiting > 0) watch.push({ tone: 'info', text: `${plural(waiting, 'permit')} waiting on another permit before ${waiting === 1 ? 'it' : 'they'} can be submitted` });
if (notSubmitted > 0) watch.push({ tone: 'info', text: `${plural(notSubmitted, 'permit')} not yet submitted, dated from past timelines` });
if (schedule.unforecast > 0) watch.push({ tone: 'info', text: `${plural(schedule.unforecast, 'permit')} with no past timeline to forecast from` });

// ── start-dependent (SSR with the fixture start; the client re-runs these) ────
const view = readinessView(projectId, project.constructionStart);
const siteRows = siteScheduleRows(projectId, project.constructionStart, sitesOf(projectId));
const expiring = permits.filter((p) => p.expires).sort((a, b) => a.expires!.localeCompare(b.expires!));
const STATES = Object.keys(READINESS_BADGE) as ReadinessState[];
---

<EsaCard>
  <div class="bcn-pr stack" data-gap="lg" data-bcn-pr data-project-id={projectId}>
    <div class="bcn-pr__verdict" data-pr-tone={view.state}>
      <div class="bcn-pr__ask cluster" data-gap="sm">
        <h2 class="bcn-pr__title typography-label-md-strong">Ready to break ground?</h2>
        <span data-pr-state>
          <EsaBadge value={READINESS_BADGE[view.state].label} variant={READINESS_BADGE[view.state].variant} size="md" />
        </span>
      </div>
      <p class="bcn-pr__sentence typography-title" data-pr-verdict>{view.verdict}</p>
    </div>

    <div class="bcn-pr__figures">
      <div class="bcn-pr__figure" data-pr-issued>
        <EsaStat value={`${mix.issued} of ${permits.length}`} label="Permits issued" />
        <BcnPermitMix counts={mix} lead={false} />
      </div>
      <div class="bcn-pr__figure stack" data-gap="2xs" data-pr-expected>
        <EsaStat value={view.expectedValue} label={view.expectedLabel} />
        <span class="bcn-pr__vs typography-body-sm" data-pr-vs data-tone={view.vs.tone} hidden={!view.vs.text}>
          <span class="bcn-pr__vs-icon" data-icon="late"><EsaIcon name="triangle-alert" size="sm" /></span>
          <span class="bcn-pr__vs-icon" data-icon="early"><EsaIcon name="circle-check" size="sm" /></span>
          <span data-pr-vs-text>{view.vs.text}</span>
        </span>
      </div>
      <div class="bcn-pr__figure" data-pr-start>
        <EsaStat value={view.startValue} label="Construction start" sub={view.startSub} />
      </div>
    </div>

    <section class="bcn-pr__sites-block stack" data-gap="xs" aria-labelledby={`bcn-pr-sites-${projectId}`}>
      <div class="repel" data-gap="sm">
        <h3 id={`bcn-pr-sites-${projectId}`} class="bcn-pr__subhead typography-label-lg-strong">Sites</h3>
        {editable && <EsaButton variant="ghost" appearance="outline" size="sm" icon="plus" data-site-edit>Add site</EsaButton>}
      </div>
    <table class="bcn-pr__sites typography-body-sm" aria-labelledby={`bcn-pr-sites-${projectId}`}>
      <thead>
        <tr>
          <th scope="col">Site</th>
          <th scope="col">Issued</th>
          <th scope="col">Expected all issued</th>
          <th scope="col"><span class="visually-hidden">State</span></th>
        </tr>
      </thead>
      <tbody data-pr-site-rows>
        {
          siteRows.map((r) => (
            <tr>
              <th scope="row">
                <span class="stack" data-gap="3xs">
                  <span>{r.name}</span>
                  <span class="bcn-pr__meta typography-body-sm">{r.location}</span>
                </span>
              </th>
              <td class="bcn-pr__num">{r.issued}</td>
              <td>
                <span class="stack" data-gap="3xs">
                  <span>{r.expected}</span>
                  <span class="bcn-pr__vs typography-body-sm" data-tone={r.vs.tone} hidden={!r.vs.text}>
                    <span class="bcn-pr__vs-icon" data-icon="late"><EsaIcon name="triangle-alert" size="sm" /></span>
                    <span class="bcn-pr__vs-icon" data-icon="early"><EsaIcon name="circle-check" size="sm" /></span>
                    <span>{r.vs.text}</span>
                  </span>
                </span>
              </td>
              <td class="bcn-pr__state">
                <span class="bcn-pr__state-cell cluster" data-gap="xs">
                  <EsaBadge value={READINESS_BADGE[r.state].label} variant={READINESS_BADGE[r.state].variant} />
                  {editable && (
                    <span class="bcn-pr__edit" data-cell="edit" data-empty={r.id ? undefined : ''}>
                      <EsaButton variant="ghost" size="sm" iconOnly icon="pencil" label={`Edit ${r.name}`} data-site-edit data-site-id={r.id} />
                    </span>
                  )}
                </span>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
    </section>

    <section class="bcn-pr__watch stack" data-gap="xs" data-pr-risks aria-labelledby={`bcn-pr-watch-${projectId}`} hidden={watch.length === 0 && view.expiresBeforeStart.length === 0}>
      <h3 id={`bcn-pr-watch-${projectId}`} class="bcn-pr__subhead typography-label-lg-strong">Keep an eye on</h3>
      <ul class="bcn-pr__watch-list typography-body-sm">
        {
          watch.map((w) => (
            <li data-tone={w.tone}>
              <span class="bcn-pr__watch-icon">{w.tone === 'late' ? <EsaIcon name="triangle-alert" size="sm" /> : <EsaIcon name="history" size="sm" />}</span>
              <span>{w.text}</span>
            </li>
          ))
        }
        {
          expiring.map((p) => (
            <li data-tone="late" data-expires={p.expires} hidden={!view.expiresBeforeStart.includes(p.id)}>
              <span class="bcn-pr__watch-icon"><EsaIcon name="calendar" size="sm" /></span>
              <span>
                {readOnly ? <strong>{p.name}</strong> : <a href={withBase(ROUTES.permit(p.id))}>{p.name}</a>}
                <span class="bcn-pr__meta">
                  {' '}
                  ({scopeLabel(p)}) expires {fmtDate(p.expires!)}, before construction start
                </span>
              </span>
            </li>
          ))
        }
      </ul>
    </section>
  </div>

  <!-- Cloned by the client: one badge per state, at both sizes, and a site row. -->
  {
    STATES.map((s) => (
      <template data-pr-badge={s}>
        <EsaBadge value={READINESS_BADGE[s].label} variant={READINESS_BADGE[s].variant} size="md" />
      </template>
    ))
  }
  {
    STATES.map((s) => (
      <template data-pr-site-badge={s}>
        <EsaBadge value={READINESS_BADGE[s].label} variant={READINESS_BADGE[s].variant} />
      </template>
    ))
  }
  <template data-pr-site-row>
    <tr>
      <th scope="row">
        <span class="stack" data-gap="3xs">
          <span data-cell="name"></span>
          <span class="bcn-pr__meta typography-body-sm" data-cell="location"></span>
        </span>
      </th>
      <td class="bcn-pr__num" data-cell="issued"></td>
      <td>
        <span class="stack" data-gap="3xs">
          <span data-cell="expected"></span>
          <span class="bcn-pr__vs typography-body-sm" data-cell="vs">
            <span class="bcn-pr__vs-icon" data-icon="late"><EsaIcon name="triangle-alert" size="sm" /></span>
            <span class="bcn-pr__vs-icon" data-icon="early"><EsaIcon name="circle-check" size="sm" /></span>
            <span data-cell="vs-text"></span>
          </span>
        </span>
      </td>
      <td class="bcn-pr__state">
        <span class="bcn-pr__state-cell cluster" data-gap="xs">
          <span data-cell="state"></span>
          {editable && (
            <span class="bcn-pr__edit" data-cell="edit">
              <EsaButton variant="ghost" size="sm" iconOnly icon="pencil" label="Edit site" data-site-edit />
            </span>
          )}
        </span>
      </td>
    </tr>
  </template>
  {editable && <BcnSiteEditor projectId={projectId} />}
</EsaCard>

<script>
  import { PROJECT_EVENT, loadProject } from '../lib/project-store';
  import { readinessView, siteScheduleRows, mixCounts, mixStage, renderMix } from './permit-readiness';
  import { ensureAddedPermits } from '../lib/added-permits-store';
  import { applyPermitEdits } from '../lib/permit-edits-store';
  import { milestoneOf, permitsOfProject } from '../data/permit-tracker';
  import { CHANGE_EVENT, resolveStatus } from '../lib/permit-status-store';

  document.querySelectorAll<HTMLElement>('[data-bcn-pr]').forEach((root) => {
    const projectId = root.dataset.projectId!;
    const card = root.closest('.esa-card') ?? root.parentElement!;
    const clone = (sel: string) => (card.querySelector<HTMLTemplateElement>(sel)!.content.firstElementChild!.cloneNode(true) as HTMLElement);
    const setVs = (el: HTMLElement, textEl: HTMLElement, vs: { tone: string; text: string }) => {
      el.dataset.tone = vs.tone;
      el.hidden = !vs.text;
      textEl.textContent = vs.text;
    };

    const render = () => {
      applyPermitEdits();
      ensureAddedPermits(projectId);
      // Totals follow added permits and live statuses (the Board, Change status).
      const permits = permitsOfProject(projectId);
      const stages = permits.map((p) => {
        const col = resolveStatus(projectId, p);
        const m = milestoneOf(col);
        return mixStage(col.category, !!p.submitted || m === 'submitted' || m === 'review');
      });
      const counts = mixCounts(stages);
      const mix = root.querySelector('[data-bcn-mix]');
      if (mix) renderMix(mix, counts);
      const issuedValue = root.querySelector('[data-pr-issued] .esa-stat__value');
      if (issuedValue) issuedValue.textContent = `${counts.issued} of ${permits.length}`;
      const record = loadProject(projectId);
      const view = readinessView(projectId, record.constructionStart);

      card.querySelector('[data-pr-state]')?.replaceChildren(clone(`[data-pr-badge="${view.state}"]`));
      root.querySelector<HTMLElement>('[data-pr-verdict]')!.textContent = view.verdict;
      root.querySelector<HTMLElement>('.bcn-pr__verdict')!.dataset.prTone = view.state;

      const expected = root.querySelector<HTMLElement>('[data-pr-expected]')!;
      expected.querySelector('.esa-stat__value')!.textContent = view.expectedValue;
      expected.querySelector('.esa-stat__label')!.textContent = view.expectedLabel;
      const vs = root.querySelector<HTMLElement>('[data-pr-vs]')!;
      setVs(vs, vs.querySelector<HTMLElement>('[data-pr-vs-text]')!, view.vs);

      const start = root.querySelector<HTMLElement>('[data-pr-start]')!;
      start.querySelector('.esa-stat__value')!.textContent = view.startValue;
      const sub = start.querySelector('.esa-stat__sub');
      if (sub) sub.textContent = view.startSub;

      const rows = siteScheduleRows(projectId, record.constructionStart, record.sites);
      root.querySelector('[data-pr-site-rows]')!.replaceChildren(
        ...rows.map((r) => {
          const tr = clone('[data-pr-site-row]');
          const cell = (name: string) => tr.querySelector<HTMLElement>(`[data-cell="${name}"]`)!;
          cell('name').textContent = r.name;
          cell('location').textContent = r.location;
          const edit = tr.querySelector<HTMLElement>('[data-cell="edit"]');
          if (edit) {
            // Project-wide isn't a site: keep the slot (columns stay aligned), drop the button.
            edit.toggleAttribute('data-empty', !r.id);
            const btn = edit.querySelector<HTMLElement>('[data-site-edit]')!;
            btn.dataset.siteId = r.id;
            btn.setAttribute('aria-label', `Edit ${r.name}`);
          }
          cell('issued').textContent = r.issued;
          cell('expected').textContent = r.expected;
          setVs(cell('vs'), cell('vs-text'), r.vs);
          cell('state').replaceChildren(clone(`[data-pr-site-badge="${r.state}"]`));
          return tr;
        }),
      );

      const watch = root.querySelector<HTMLElement>('[data-pr-risks]')!;
      watch.querySelectorAll<HTMLElement>('[data-expires]').forEach((li) => (li.hidden = !(li.dataset.expires! < record.constructionStart)));
      watch.hidden = ![...watch.querySelectorAll<HTMLElement>('li')].some((li) => !li.hidden);
    };

    document.addEventListener(PROJECT_EVENT, (e) => {
      if ((e as CustomEvent).detail?.projectId === projectId) render();
    });
    document.addEventListener(CHANGE_EVENT, render);
    render();
  });
</script>

<style>
  /* ── the verdict band ─────────────────────────────────────────────────────────
     A rule in the state's tone down the left edge, a tint of it behind. The badge
     and the sentence carry the meaning; the tone only reinforces it. */
  .bcn-pr__verdict {
    --_tone: var(--color-background-utility-success);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-150, 0.375rem);
    padding: var(--spacing-400, 1rem) var(--spacing-500, 1.25rem);
    border-inline-start: 4px solid var(--_tone);
    border-radius: var(--radius-sm, 0.25rem);
    background: color-mix(in srgb, var(--_tone) 7%, var(--color-background-elevation-raised, #fff));
  }
  .bcn-pr__verdict[data-pr-tone='unconfirmed'] {
    --_tone: var(--color-background-utility-warning);
  }
  .bcn-pr__verdict[data-pr-tone='at-risk'] {
    --_tone: var(--color-background-utility-danger);
  }
  .bcn-pr__title {
    margin: 0;
    color: var(--color-content-default-secondary);
  }
  .bcn-pr__sentence {
    margin: 0;
    max-inline-size: 68ch;
    color: var(--color-content-default);
    text-wrap: balance;
  }

  /* ── figures ── the mix gets the wider track; dates sit beside it. */
  .bcn-pr__figures {
    display: grid;
    grid-template-columns: minmax(18rem, 1.6fr) repeat(2, minmax(11rem, 1fr));
    gap: var(--spacing-600, 1.5rem);
    align-items: start;
  }
  @media (max-width: 64rem) {
    .bcn-pr__figures {
      grid-template-columns: 1fr 1fr;
    }
    .bcn-pr__figure[data-pr-issued] {
      grid-column: 1 / -1;
    }
  }
  .bcn-pr__figure[data-pr-issued] {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-200, 0.5rem);
  }
  
  /* Schedule by site: a plain data table — four short columns, no sorting or
     filtering, so AG Grid's chrome would outweigh it. Includes project-wide permits. */
  .bcn-pr__sites {
    inline-size: 100%;
    border-collapse: collapse;
    color: var(--color-content-default);
  }
  .bcn-pr__sites-block {
    padding-top: var(--spacing-400, 1rem);
    border-top: 1px solid var(--color-border-default-subtle, #e8e8e8);
  }
  .bcn-pr__state-cell {
    justify-content: end;
    flex-wrap: nowrap;
  }
  /* Project-wide row: the edit slot keeps its width so badges line up, but is empty. */
  .bcn-pr__edit[data-empty] {
    visibility: hidden;
  }
  .bcn-pr__sites th,
  .bcn-pr__sites td {
    text-align: start;
    padding: var(--spacing-200, 0.5rem) var(--spacing-300, 0.75rem) var(--spacing-200, 0.5rem) 0;
    border-bottom: 1px solid var(--color-border-default-subtle, #e8e8e8);
    vertical-align: middle;
  }
  .bcn-pr__sites tbody tr:last-child > * {
    border-bottom: 0;
  }
  .bcn-pr__sites thead th {
    font-weight: var(--typography-font-weight-regular, 400);
    color: var(--color-content-default-secondary, #646464);
  }
  .bcn-pr__sites tbody th {
    font-weight: var(--typography-font-weight-semibold, 600);
  }
  .bcn-pr__num {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .bcn-pr__state {
    text-align: end;
    padding-inline-end: 0;
  }

  /* Expected vs construction start: a mark + words, never colour alone. */
  .bcn-pr__vs {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-100);
    color: var(--color-content-default-secondary);
  }
  .bcn-pr__vs[data-tone='late'] {
    color: var(--color-content-utility-danger);
    font-weight: var(--typography-font-weight-semibold, 600);
  }
  .bcn-pr__vs[data-tone='early'] {
    color: var(--color-content-utility-success);
  }
  .bcn-pr__vs-icon {
    display: none;
  }
  .bcn-pr__vs[data-tone='late'] [data-icon='late'],
  .bcn-pr__vs[data-tone='early'] [data-icon='early'] {
    display: inline-flex;
  }
  .bcn-pr [hidden] {
    display: none;
  }

  /* ── keep an eye on ── one line per risk, a mark in its tone ahead of the words. */
  .bcn-pr__watch {
    padding-top: var(--spacing-400, 1rem);
    border-top: 1px solid var(--color-border-default-subtle, #e8e8e8);
  }
  .bcn-pr__subhead {
    margin: 0;
    color: var(--color-content-default, #202020);
  }
  .bcn-pr__watch-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(22rem, 1fr));
    gap: var(--spacing-150, 0.375rem) var(--spacing-600, 1.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--color-content-default, #202020);
  }
  .bcn-pr__watch-list li {
    display: flex;
    gap: var(--spacing-200, 0.5rem);
    align-items: start;
  }
  .bcn-pr__watch-icon {
    display: inline-flex;
    padding-block-start: 2px;
    color: var(--color-content-default-secondary);
  }
  .bcn-pr__watch-list li[data-tone='late'] .bcn-pr__watch-icon {
    color: var(--color-content-utility-warning, #b05000);
  }
  .bcn-pr__watch-list a {
    color: var(--color-content-link);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .bcn-pr__meta {
    color: var(--color-content-default-secondary, #646464);
  }
</style>
