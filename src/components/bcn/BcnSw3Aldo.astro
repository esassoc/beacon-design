---
// <BcnSw3Aldo> — the scan's conversation with Aldo, and its record.
//
// Aldo opens with the scope pass's proposal. The person answers in their own words:
// narrow the scope, pause, resume, re-read, or give a rule ("references to another
// condition are not commitments"). Each message is interpreted into actions
// (sw3-steer.ts, prod's structured-output call), applied, and kept with the page the
// scan was on when it was given. Aldo also raises what needs a person as the scan reaches
// it (a find with nothing in it, a passage split across a page break, pages with nothing
// found), each with the one-click answer; a click is recorded like a typed message.
//
// Where the run is sits pinned above the composer as its status: reading (blue, with the
// page), stopped for the person's check (yellow), paused or stopped (neutral), done
// (green). A rule governs the pages not yet read; for pages already read Aldo offers a
// re-read.
//
// Buttons carry what they do in their color: green to accept (Looks right), red to
// remove (Dismiss), blue to change the record (Merge, Re-read), the primary for the next
// step, neutral for everything else. Only the send button is Aldo's green.
//
// Contract: sw3-aldo.ts `setupSw3Aldo(root)`. It renders from sw3-store and calls its
// say()/act(); "show page" answers fire `sw3:page` { page } on document for the host.
//
// bcn-lego-checked: the field IS esa-textarea, every button IS esa-button (send re-points
// the button's radius and brand tokens to Aldo's round green control, as bcn-aldo-prompt
// does), the status IS esa-alert-box, the mark IS bcn-aldo-mark. No esa- lego is a
// message thread; bcn-aldo-prompt is a one-shot composer with no history. Checked Beacon:
// its AI chat (AIController PostChatCompletions) has no thread UI in the app shell.
// bcn-sw3-aldo is the home for "a conversation that steers a running job".
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaAlertBox from '@esa/ecology/esa-alert-box.astro';
import BcnAldoMark from './BcnAldoMark.astro';
import BcnCommitmentBadge from './BcnCommitmentBadge.astro';

interface Props {
  /** Where "Review commitments" goes. */
  review: string;
}
const { review } = Astro.props;
---

<section class="bcn-sw3aldo" data-sw3-aldo data-review={review} aria-label="Aldo">
  <header class="bcn-sw3aldo__head">
    <BcnAldoMark size="sm" />
    <h3 class="bcn-sw3aldo__title typography-title-strong">Aldo</h3>
  </header>

  <ol class="bcn-sw3aldo__log" data-aldo-log aria-live="polite"></ol>

  <div class="bcn-sw3aldo__status" data-aldo-status role="status">
    <div data-status="check" hidden><EsaAlertBox variant="warning"><span data-status-text></span></EsaAlertBox></div>
    <div data-status="reading" hidden><EsaAlertBox variant="info"><span data-status-text></span></EsaAlertBox></div>
    <div data-status="done" hidden><EsaAlertBox variant="success"><span data-status-text></span></EsaAlertBox></div>
  </div>

  <div class="bcn-sw3aldo__suggest" data-aldo-suggest></div>

  <form class="bcn-sw3aldo__composer" data-aldo-form>
    <esa-textarea
      class="bcn-sw3aldo__input"
      data-aldo-input
      size="md"
      rows="1"
      max-rows="6"
      auto-resize
      aria-label="Message Aldo"
      placeholder="Steer the scan"></esa-textarea>
    <span class="bcn-sw3aldo__send"><EsaButton iconOnly icon="arrow-up" size="sm" label="Send" data-aldo-send /></span>
  </form>

  <template data-aldo-msg>
    <li class="bcn-sw3aldo__msg">
      <span class="bcn-sw3aldo__who" data-msg-who></span>
      <p class="bcn-sw3aldo__text typography-body-sm" data-msg-text></p>
      <div class="bcn-sw3aldo__extra" data-msg-extra></div>
      <span class="bcn-sw3aldo__acts" data-msg-acts></span>
    </li>
  </template>
  <template data-aldo-btn>
    <EsaButton variant="secondary" size="xs">Action</EsaButton>
  </template>
  <template data-aldo-badge>
    <span><BcnCommitmentBadge code="" size="sm" /></span>
  </template>
  <template data-aldo-btn-primary>
    <EsaButton variant="primary" size="xs">Action</EsaButton>
  </template>
  <template data-aldo-btn-success>
    <EsaButton variant="success" size="xs">Action</EsaButton>
  </template>
  <template data-aldo-btn-danger>
    <EsaButton variant="danger" appearance="soft" size="xs">Action</EsaButton>
  </template>
  <template data-aldo-btn-info>
    <EsaButton variant="info" appearance="soft" size="xs">Action</EsaButton>
  </template>
</section>

<style>
  .bcn-sw3aldo {
    display: flex;
    flex-direction: column;
    min-height: 0;
    background: var(--color-background-elevation-raised);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-200);
  }

  .bcn-sw3aldo__head {
    display: flex;
    align-items: center;
    gap: var(--spacing-200);
    padding: var(--spacing-200) var(--spacing-300);
    border-bottom: 1px solid var(--color-border-default-subtle);
  }
  .bcn-sw3aldo__title { margin: 0; font-size: 0.875rem; font-weight: 600; }

  .bcn-sw3aldo__log {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-300);
    min-height: 0;
    margin: 0;
    padding: var(--spacing-300);
    list-style: none;
    overflow-y: auto;
    /* Dense, like the library: 13px text, 12px meta (Andy, 2026-10-14). */
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  /* Messages are cloned from the template by the controller. */
  .bcn-sw3aldo__msg {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-100);
    max-width: 94%;
    animation: bcn-sw3aldo-in 220ms ease-out;
  }
  .bcn-sw3aldo__msg[data-from='aldo'] { align-self: flex-start; }
  .bcn-sw3aldo__msg[data-from='you'] { align-self: flex-end; align-items: flex-end; }
  .bcn-sw3aldo__who {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-content-default-secondary);
    font-variant-numeric: tabular-nums;
  }
  .bcn-sw3aldo__text {
    margin: 0;
    padding: var(--spacing-150, 0.375rem) var(--spacing-250, 0.625rem);
    border-radius: var(--radius-200);
    color: var(--color-content-default);
    font-size: inherit;
    line-height: inherit;
    white-space: pre-line;
  }
  .bcn-sw3aldo__msg[data-from='aldo'] .bcn-sw3aldo__text { background: var(--bcn-aldo-50); }
  .bcn-sw3aldo__msg[data-from='you'] .bcn-sw3aldo__text { background: var(--color-background-default); border: 1px solid var(--color-border-default-subtle); }
  /* A button press on one of Aldo's questions: recorded, but not a speech bubble. */
  .bcn-sw3aldo__msg[data-via='button'] .bcn-sw3aldo__text { background: none; border: 0; padding: 0; color: var(--color-content-default-secondary); }
  .bcn-sw3aldo__acts { display: flex; flex-wrap: wrap; gap: var(--spacing-150, 0.375rem); }
  .bcn-sw3aldo__acts:empty { display: none; }

  /* The check: one card per commitment read before the run goes on. Dashed until the
     person says it read right, solid after, the grammar of the boxes on the page. */
  .bcn-sw3aldo__extra:empty { display: none; }
  .bcn-sw3aldo__extra :global(.bcn-sw3aldo__checks) { display: flex; flex-direction: column; gap: var(--spacing-200); }
  .bcn-sw3aldo__extra :global(.bcn-sw3aldo__check) {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-150, 0.375rem);
    padding: var(--spacing-250, 0.625rem) var(--spacing-300);
    border: 1px dashed var(--color-border-default-strong, var(--color-border-default));
    border-radius: 6px;
    background: var(--color-background-elevation-raised);
  }
  .bcn-sw3aldo__extra :global(.bcn-sw3aldo__check[data-state='checked']) { border-style: solid; border-color: var(--color-border-default-subtle); }
  .bcn-sw3aldo__extra :global(.bcn-sw3aldo__checkhead) {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-200);
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    text-align: left;
    color: var(--color-content-default);
    cursor: pointer;
  }
  .bcn-sw3aldo__extra :global(.bcn-sw3aldo__checkhead:hover .bcn-sw3aldo__checktitle) { text-decoration: underline; }
  .bcn-sw3aldo__extra :global(.bcn-sw3aldo__checkhead:focus-visible) {
    outline: var(--focus-ring-width, 2px) solid var(--focus-ring-color);
    outline-offset: var(--focus-ring-offset, 2px);
  }
  /* The identified text, quoted, four lines until Show all. */
  .bcn-sw3aldo__extra :global(.bcn-sw3aldo__quote) {
    margin: 0;
    padding: var(--spacing-200) var(--spacing-250, 0.625rem);
    border-radius: var(--radius-100);
    background: var(--color-background-elevation-sunken);
    color: var(--color-content-default);
    font-family: var(--font-decorative);
    font-size: 0.78rem;
    line-height: 1.45;
    white-space: pre-line;
  }
  /* Four lines until Show all: the clamp is on the text, inside the quote's padding. */
  .bcn-sw3aldo__extra :global(.bcn-sw3aldo__quotetext) {
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .bcn-sw3aldo__extra :global(.bcn-sw3aldo__quote[data-all] .bcn-sw3aldo__quotetext) { display: block; }
  .bcn-sw3aldo__extra :global(.bcn-sw3aldo__checkfoot) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-200);
    flex-wrap: wrap;
  }
  .bcn-sw3aldo__extra :global(.bcn-sw3aldo__checkmeta) { display: flex; gap: var(--spacing-150, 0.375rem); }
  .bcn-sw3aldo__extra :global(.bcn-sw3aldo__fix) { display: flex; flex-direction: column; gap: var(--spacing-200); }
  .bcn-sw3aldo__extra :global(.bcn-sw3aldo__checkacts) { display: flex; gap: var(--spacing-200); }
  .bcn-sw3aldo__extra :global(.bcn-sw3aldo__ok) { display: inline-flex; align-items: center; gap: 4px; font-size: 0.75rem; font-weight: 600; color: var(--color-content-utility-success); }
  .bcn-sw3aldo__extra :global(.bcn-sw3aldo__checktitle) { font-size: 0.8125rem; font-weight: 600; line-height: 1.3; }
  /* Each commitment to check is its own message: room between them. */
  .bcn-sw3aldo__msg[data-kind='check'] { max-width: 100%; width: 100%; margin-bottom: var(--spacing-200); }

  /* Where the run is, pinned above the composer. */
  .bcn-sw3aldo__status { padding: 0 var(--spacing-300) var(--spacing-200); }
  .bcn-sw3aldo__status:not(:has(> :not([hidden]))) { display: none; }
  .bcn-sw3aldo__status > [hidden] { display: none; }
  .bcn-sw3aldo__status :global(.esa-alert-box) { padding: var(--spacing-150, 0.375rem) var(--spacing-250, 0.625rem); font-size: 0.8125rem; align-items: center; }
  .bcn-sw3aldo__status :global(.esa-alert-box__icon svg) { width: 16px; height: 16px; }

  .bcn-sw3aldo__suggest {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-200);
    padding: 0 var(--spacing-300) var(--spacing-200);
  }
  .bcn-sw3aldo__suggest:empty { display: none; }

  .bcn-sw3aldo__composer {
    display: flex;
    align-items: flex-end;
    gap: var(--spacing-200);
    margin: 0 var(--spacing-300) var(--spacing-300);
    padding: var(--spacing-100) var(--spacing-200) var(--spacing-100) var(--spacing-300);
    border: 1px solid var(--bcn-aldo-100);
    border-radius: var(--radius-200);
    background: var(--color-background-elevation-raised);
    box-shadow: var(--bcn-aldo-prompt-shadow);
  }
  /* The composer carries the field's focus (a sanctioned :focus-within wrapper). */
  .bcn-sw3aldo__composer:focus-within { outline: 2px solid var(--bcn-aldo-prompt-ring); }
  .bcn-sw3aldo__input {
    flex: 1;
    min-width: 0;
    --focus-ring-color: var(--color-background-elevation-raised);
    --form-border-width: 0;
  }
  .bcn-sw3aldo__send {
    --button-radius-sm: 999px;
    --color-background-brand: var(--bcn-aldo);
    --color-background-brand-hover: var(--bcn-aldo-600);
    display: inline-flex;
    padding-bottom: var(--spacing-100);
  }

  @keyframes bcn-sw3aldo-in {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .bcn-sw3aldo__msg { animation: none; }
  }
</style>

<script>
  import '@esa/ecology/esa-textarea';
  import '@esa/ecology/esa-text-field';
  import { setupSw3Aldo } from './sw3-aldo';
  document.querySelectorAll<HTMLElement>('[data-sw3-aldo]').forEach(setupSw3Aldo);
</script>
