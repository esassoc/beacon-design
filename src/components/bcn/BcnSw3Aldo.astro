---
// <BcnSw3Aldo> — the scan's conversation with Aldo, and its record: a manifest of the Aldo
// kit (src/components/bcn/aldo/, docs/aldo-kit-spec.md). The adapter, sw3-aldo.ts, maps
// sw3-store onto the kit's data and routes what its buttons open.
//
// Aldo opens with the scope pass's proposal. The person answers in their own words:
// narrow the scope, pause, resume, re-read, or give a rule ("references to another
// condition are not commitments"). Each message is interpreted into actions
// (sw3-steer.ts, prod's structured-output call), applied, and kept with the page the scan
// was on when it was given. What waits on the person is listed as Needs you until
// answered; where the run is sits pinned above the composer as its status.
//
// Contract: sw3-aldo.ts `setupSw3Aldo(root)`. The panel folds into a rail on the host's
// `data-aldo` (BcnSw3Scan's grid reads it).
import BcnAldoPanel from './aldo/BcnAldoPanel.astro';
import BcnAldoThread from './aldo/BcnAldoThread.astro';
import BcnAldoInstructions from './aldo/BcnAldoInstructions.astro';
import BcnAldoNeeds from './aldo/BcnAldoNeeds.astro';
import BcnAldoStatus from './aldo/BcnAldoStatus.astro';
import BcnAldoComposer from './aldo/BcnAldoComposer.astro';

interface Props {
  /** Where "Review commitments" goes. */
  review: string;
}
const { review } = Astro.props;
---

<BcnAldoPanel collapsible expandable rail="right" data-sw3-aldo data-review={review}>
  <BcnAldoThread slot="thread" />
  <BcnAldoInstructions slot="instructions" />
  <BcnAldoNeeds slot="needs" />
  <BcnAldoStatus slot="status" />
  <BcnAldoComposer slot="composer" mode="thread" placeholder="Tell Aldo what to read, skip or fix" />
</BcnAldoPanel>

<script>
  import { setupSw3Aldo } from './sw3-aldo';
  document.querySelectorAll<HTMLElement>('[data-sw3-aldo]').forEach(setupSw3Aldo);
</script>
