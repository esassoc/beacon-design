---
// <BcnReleaseStream> — the body of the Release Notes prototype (/prototypes/
// release-notes): every Beacon release as one post, newest first. A post is the
// Claude Code changelog layout with features on top: the version badge and date in a
// narrow meta column (sticky while the post scrolls), then two or three features
// (BcnReleaseFeature), and the release's full Added / Changed /
// Fixed list (BcnReleaseChangelog). Every post is a hash target (#v1-41-0); its
// features are #v1-41-0-<feature id>.
//
// Layout: each post is the .sidebar primitive (meta column + body), so on a narrow
// screen the meta column drops above the body without a media query. The meta column
// only sticks once the two sit side by side.
//
// Presentational — the whole stream comes from RELEASES (../../data/release-notes);
// no props, no client JS.
//
// bcn-lego-checked: no esa-* lego renders a changelog post — esa-card is a bordered
// container and the posts are a document flow separated by hairlines. Checked Beacon
// (no release-notes primitive). esa-badge carries the version; the features and the
// changelog are their own bcn- components.
import EsaBadge from '@esa/ecology/esa-badge.astro';
import BcnReleaseFeature from './BcnReleaseFeature.astro';
import BcnReleaseChangelog from './BcnReleaseChangelog.astro';
import { RELEASES, featureAnchor } from '../../data/release-notes';

// "October 13, 2026"; T00:00:00 pins local midnight so the date never shifts a day.
const fmtDate = (iso: string): string =>
  new Date(`${iso}T00:00:00`).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
---

<div class="bcn-release-stream">
  {RELEASES.map((release) => (
    <article class="bcn-release sidebar" data-gap="lg" id={release.anchor} aria-labelledby={`${release.anchor}-heading`}>
      <header class="bcn-release__meta">
        <div class="bcn-release__meta-inner">
          <h2 class="bcn-release__version" id={`${release.anchor}-heading`}>
            <EsaBadge value={release.version} size="lg" />
          </h2>
          <time class="bcn-release__date typography-label-sm" datetime={release.date}>{fmtDate(release.date)}</time>
        </div>
      </header>
      <div class="bcn-release__body">
        {release.features.map((feature) => (
          <BcnReleaseFeature feature={feature} anchor={featureAnchor(release, feature)} />
        ))}
        <BcnReleaseChangelog groups={release.changelog} label={`Changes in ${release.version}`} />
      </div>
    </article>
  ))}
</div>

<style>
  .bcn-release-stream {
    display: flex;
    flex-direction: column;
  }
  .bcn-release {
    --sidebar-width: 10rem;
    --sidebar-content-min: 65%;
    padding-block: var(--spacing-600);
    scroll-margin-top: var(--spacing-500);
  }
  .bcn-release + .bcn-release {
    border-top: 1px solid var(--color-border-default-subtle);
  }
  .bcn-release:first-child { padding-block-start: var(--spacing-400); }

  .bcn-release__meta-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-300);
  }
  @media (min-width: 48rem) {
    .bcn-release__meta { align-self: stretch; }
    .bcn-release__meta-inner {
      position: sticky;
      inset-block-start: var(--spacing-500);
    }
  }
  /* Phone: the meta column has dropped above the body — badge and date share a row. */
  @media (max-width: 47.99rem) {
    .bcn-release__meta-inner {
      flex-direction: row;
      align-items: center;
    }
  }
  .bcn-release__version {
    margin: 0;
    line-height: 1;
  }
  .bcn-release__date {
    color: var(--color-content-default-secondary);
  }

  .bcn-release__body {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-700);
    max-inline-size: 46rem;
  }
</style>
