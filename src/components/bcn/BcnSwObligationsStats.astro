---
// <BcnSwObligationsStats> — the shape of the thing being approved.
//
// Step 5 approves a TAXONOMY, so the figures that matter are the taxonomy's own
// dimensions: how many obligations, how many categories and subcategories they fall
// into, how many cannot start without an agency sign-off, and how the four classes
// divide. Every figure is a count over the registry rows, and every label names the
// entity it counts.
//
// No chart. The class split is four words and four numbers; a donut would add a
// second reading of the same four values and a legend to decode it.
//
// bcn-lego-checked: esa-stat IS the value/label/sub block and all four figures use
// it unchanged. The class split is bcn-sw-obligations-class-pill (esa-pill) with its
// `count` prop, so the chip a reader learns here is identical to the one on all 402
// rows. Nothing bespoke except the band's own two-part layout.
import EsaStat from '@esa/ecology/esa-stat.astro';
import BcnSwObligationsClassPill from './BcnSwObligationsClassPill.astro';
import { OBLIGATION_TOTALS } from '../../data/setup-wizard';

const t = OBLIGATION_TOTALS;
---

<section class="bcn-swo-stats">
  <div class="bcn-swo-stats__figures">
    <EsaStat value={t.obligations} label="Obligations" />
    <EsaStat value={t.categories} label="Categories" />
    <EsaStat value={t.subcategories} label="Subcategories" />
    <EsaStat value={t.gated} label="Approval gates" sub="Work cannot start until an agency approves" />
  </div>

  <div class="bcn-swo-stats__split">
    <h3 class="bcn-swo-stats__split-label">Obligations by class</h3>
    <div class="bcn-swo-stats__classes">
      {t.byClass.map((c) => <BcnSwObligationsClassPill obligationClass={c.class} count={c.count} size="lg" />)}
    </div>
  </div>
</section>

<style>
  .bcn-swo-stats {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--spacing-400) var(--spacing-700);
    padding-block-end: var(--spacing-400);
    border-bottom: 1px solid var(--color-border-default-subtle);
  }

  .bcn-swo-stats__figures {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-400) var(--spacing-700);
  }
  .bcn-swo-stats__figures > * {
    max-width: 22ch;
  }

  .bcn-swo-stats__split {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-250);
  }
  .bcn-swo-stats__split-label {
    margin: 0;
    font-size: var(--font-size-200);
    font-weight: var(--typography-font-weight-medium);
    color: var(--color-content-default-secondary);
  }
  .bcn-swo-stats__classes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-150) var(--spacing-400);
  }
</style>
