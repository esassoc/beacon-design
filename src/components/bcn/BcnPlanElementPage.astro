---
// <BcnPlanElementPage> — one work element's page (2026-10-28, decisions 1 to 8; the proposal's "page made of modules").
// The head is the title and its level; everything else is a card (2026-10-28, Andy: "I strongly hate fact strips";
// "should be a sidebar card"): status, health, dates, owners and which plan you're reading lead the side column's
// Details card. Two columns of module cards, placed by the element's level layout (the plan's configuration): which
// modules, in what order, in which column. A module that doesn't apply stays out
// (Transmittals and Completion on a non-deliverable, Progress on a leaf, Budget on a plan that doesn't track money).
//
// Plans are drafted, records are not (decision 5): in a draft, the planned side (owners, the deliverable flag, field
// values) edits; documents, sends, completion and comments stay Live's and read-only. The runtime is
// ./plan-element-page.ts; each module's is ./element-<key>.ts, on the contract in ./element-module.ts.
//
// bcn-lego-checked: badges ARE esa-badge (BcnBadgeBank), every module IS BcnElementModule (esa-card), the empty state IS
// esa-empty-state. No esa- lego is a two-column module layout; checked Beacon (prod detail pages hard-code their
// cards). The CSS is the columns.
import EsaEmptyState from '@esa/ecology/esa-empty-state.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import { withBase } from '../../lib/base';
import BcnBadgeBank from './BcnBadgeBank.astro';
import BcnElementDetails from './BcnElementDetails.astro';
import BcnElementLineage from './BcnElementLineage.astro';
import BcnElementSchedule from './BcnElementSchedule.astro';
import BcnElementProgress from './BcnElementProgress.astro';
import BcnElementBudget from './BcnElementBudget.astro';
import BcnElementDocuments from './BcnElementDocuments.astro';
import BcnElementTransmittals from './BcnElementTransmittals.astro';
import BcnElementCompletion from './BcnElementCompletion.astro';
import BcnElementObligations from './BcnElementObligations.astro';
import BcnElementComments from './BcnElementComments.astro';
import BcnElementActivity from './BcnElementActivity.astro';
import BcnHealthDialog from './BcnHealthDialog.astro';
import BcnElementEditDialog from './BcnElementEditDialog.astro';
import BcnPlanRevisionsDialog from './BcnPlanRevisionsDialog.astro';
import BcnElementCustomize from './BcnElementCustomize.astro';
import BcnPageConfigDialog from './BcnPageConfigDialog.astro';
---

<div class="bcn-pep" data-bcn-plan-element-page>
  <div class="bcn-pep__cols" data-pep-cols hidden>
    <div class="bcn-pep__col" data-pep-col="main"></div>
    <div class="bcn-pep__col" data-pep-col="side"></div>
  </div>

  <!-- Every module, banked; the runtime moves the ones that show into their column, in the level's order. -->
  <div class="bcn-pep__bank" data-pep-bank hidden>
    <BcnElementDetails />
    <BcnElementLineage />
    <BcnElementSchedule />
    <BcnElementProgress />
    <BcnElementBudget />
    <BcnElementDocuments />
    <BcnElementTransmittals />
    <BcnElementCompletion />
    <BcnElementObligations />
    <BcnElementComments />
    <BcnElementActivity />
  </div>

  <div class="bcn-pep__missing" data-pep-missing hidden>
    <EsaEmptyState title="Not in This Plan" description="This item isn't in the plan, or it was removed.">
      <a data-pep-missing-back><EsaButton variant="ghost" appearance="outline" size="sm" icon="arrow-left">Back to the Plan</EsaButton></a>
    </EsaEmptyState>
  </div>

  <div class="bcn-pep__missing" data-pep-guest hidden>
    <EsaEmptyState title="Shared With You for Review" description="This plan is shared with you for the transmittals sent to you. Your inbox lists them, with Confirm Receipt.">
      <a href={withBase('/prototypes/plans-repo/inbox/')}><EsaButton variant="primary" size="sm" icon="inbox" data-fill-icon="inbox">Sent to You</EsaButton></a>
    </EsaEmptyState>
  </div>

  <BcnBadgeBank />
  <BcnHealthDialog />
  <!-- Edit (2026-10-28, Andy): the form, then the plan's own Review and Publish for it. -->
  <BcnElementEditDialog />
  <BcnPlanRevisionsDialog />
  <!-- Configure Page (2026-10-30): the level's whole page in a modal, with its miniature. The fields dialogs are the
       in-place mode's. -->
  <BcnPageConfigDialog fieldDialogs={false} />
  <!-- Customize Page (2026-10-28): the level's page, arranged here (Configure Page's Arrange on This Page). -->
  <BcnElementCustomize />
</div>

<style>
  .bcn-pep {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-400);
    min-width: 0;
  }
  .bcn-pep__cols[hidden],
  .bcn-pep__missing[hidden] {
    display: none;
  }
  /* The data catalog detail pages' proportions (2026-10-28, Andy: "match data catalog pages"): the main column takes
     the room, the side column is a fixed 360px rail. */
  .bcn-pep__cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: var(--spacing-600);
    align-items: start;
  }
  .bcn-pep__col {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-500);
    min-width: 0;
  }
  .bcn-pep__col:empty {
    display: none;
  }
  /* Customizing, an emptied column stays a place to drop a card. */
  .bcn-pep[data-customizing] .bcn-pep__col {
    min-block-size: 6rem;
  }
  .bcn-pep[data-customizing] .bcn-pep__col:empty {
    display: flex;
    border: 1px dashed var(--color-border-default);
    border-radius: var(--radius-200);
  }
  @media (max-width: 1024px) {
    .bcn-pep__cols {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
