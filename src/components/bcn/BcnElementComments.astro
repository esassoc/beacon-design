---
// <BcnElementComments> — the Comments module (2026-10-28): the element's discussion, as Beacon's comments are
// (BcnDiscussion, from ActionImplementation): plain text, flat, newest first; each with its author's avatar, name and
// absolute time, "(edited)" when edited, and the author's own Edit and Delete. A comment is a record, kept on Live:
// read-only in a draft, and not offered to guests. The runtime is ./element-comments.ts.
//
// bcn-lego-checked: the card IS BcnElementModule (esa-card); the compose IS esa-textarea with esa-button; avatars ARE
// esa-avatar (BcnPlanPeople); Edit and Delete ARE esa-button (cloned). BcnDiscussion is the established treatment
// but renders at build time from props; this restates its layout for runtime records. Checked Beacon (comment lists
// are page templates). The CSS is the thread's rows.
import EsaButton from '@esa/ecology/esa-button.astro';
import BcnElementModule from './BcnElementModule.astro';
---

<BcnElementModule key="comments">
  <div class="bcn-ecom">
    <form class="bcn-ecom__compose" data-ecom-compose hidden>
      <esa-textarea size="sm" rows="2" auto-resize placeholder="Write a comment" aria-label="Write a comment" data-ecom-text></esa-textarea>
      <div class="bcn-ecom__compose-foot">
        <span class="bcn-ecom__as" data-ecom-as></span>
        <span data-ecom-post><EsaButton variant="primary" size="sm">Post Comment</EsaButton></span>
      </div>
    </form>
    <ol class="bcn-ecom__list" data-ecom-list></ol>
    <p class="bcn-ecom__empty" data-ecom-empty hidden></p>
  </div>
  <template data-ecom-tpl="edit"><EsaButton variant="ghost" size="xs">Edit</EsaButton></template>
  <template data-ecom-tpl="delete"><EsaButton variant="ghost" size="xs">Delete</EsaButton></template>
  <template data-ecom-tpl="save"><EsaButton variant="primary" size="xs">Save</EsaButton></template>
  <template data-ecom-tpl="cancel"><EsaButton variant="ghost" size="xs">Cancel</EsaButton></template>
</BcnElementModule>

<style>
  .bcn-ecom {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-400);
  }
  .bcn-ecom__compose {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-200);
  }
  .bcn-ecom__compose[hidden],
  .bcn-ecom__empty[hidden] {
    display: none;
  }
  .bcn-ecom__compose-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-200);
  }
  .bcn-ecom__as {
    font-size: var(--font-size-100);
    color: var(--color-content-default-secondary);
  }
  .bcn-ecom__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-400);
  }
  .bcn-ecom__list :global(li) {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: var(--spacing-300);
  }
  .bcn-ecom__list :global(.bcn-ecom__body) {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-100);
    min-width: 0;
  }
  .bcn-ecom__list :global(.bcn-ecom__who) {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--spacing-100) var(--spacing-200);
    font-size: var(--typography-label-sm-font-size);
  }
  .bcn-ecom__list :global(.bcn-ecom__who b) {
    color: var(--color-content-default);
  }
  .bcn-ecom__list :global(.bcn-ecom__who time),
  .bcn-ecom__list :global(.bcn-ecom__edited) {
    color: var(--color-content-default-secondary);
    font-size: var(--font-size-100);
  }
  .bcn-ecom__list :global(.bcn-ecom__tools) {
    margin-inline-start: auto;
    display: flex;
    gap: var(--spacing-100);
    opacity: 0;
    transition: opacity 120ms ease;
  }
  .bcn-ecom__list :global(li:hover .bcn-ecom__tools),
  .bcn-ecom__list :global(li:focus-within .bcn-ecom__tools) {
    opacity: 1;
  }
  .bcn-ecom__list :global(.bcn-ecom__text) {
    margin: 0;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    color: var(--color-content-default);
    font-size: var(--typography-body-sm-font-size);
    line-height: 1.5;
  }
  .bcn-ecom__list :global(.bcn-ecom__edit-foot) {
    display: flex;
    gap: var(--spacing-150);
    justify-content: flex-end;
  }
  .bcn-ecom__empty {
    margin: 0;
    color: var(--color-content-default-secondary);
    font-size: var(--typography-body-sm-font-size);
  }
</style>
