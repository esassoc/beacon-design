---
// <BcnSwActionsRouting> — where the project's requirements went: one proportional bar
// over a labeled legend. Project-wide and UNFILTERED, which is why it sits above the
// phase/type filter band rather than inside the board. Reading order is whole, then
// slice, then rows.
//
// WHY A BAR AND NOT FOUR STATS. The four counts are parts of one whole (854
// requirements), and a four-up stat banner throws that away: it shows four large
// numbers with no relation between them, and the reader has to add. The bar states the
// relation, and it is the fastest possible answer to the only question this step opens
// with, which is how much is still unrouted. The legend then carries the exact counts,
// each under its own label.
//
// ONE ATTENTION COLOR. Three of the four buckets are settled work and take the wizard's
// own entity colors (action, obligation, and a literal 50/50 mix for the requirements
// sitting in both). "Not yet routed" is the only bucket that asks for anything, so it
// is the only one wearing Beacon's amber flag tokens.
//
// bcn-lego-checked: esa-progress-bar carries a single value against a track and cannot
// express a four-part split; esa-stat is the four-up banner this deliberately is not.
// Checked Ecology for a stacked/segmented bar or a distribution lego (none) and Beacon
// (the actions-step has no routing summary at all — it is new to this step). The legend
// is the only reusable shape here, so bcn-sw-actions-routing owns both halves; nothing
// inside is a reinvented control.
interface Segment {
  /** What the bucket counts, in words. Labels its own number. */
  label: string;
  count: number;
  /** Which token family paints the swatch and the bar segment. */
  tone: 'action' | 'obligation' | 'both' | 'flag';
}
interface Props {
  /** Names the breakdown. */
  title: string;
  /** The denominator, and the width the segments divide. */
  total: number;
  /** The noun `total` counts. */
  totalNoun: string;
  segments: Segment[];
}
const { title, total, totalNoun, segments } = Astro.props;
const pct = (n: number) => (total > 0 ? (n / total) * 100 : 0);
---

<section class="bcn-swart">
  <div class="bcn-swart__head">
    <h3 class="bcn-swart__title typography-label-md-strong">{title}</h3>
    <p class="bcn-swart__total typography-body-sm">{total.toLocaleString()} {totalNoun}</p>
  </div>

  <div class="bcn-swart__bar">
    {segments.map((s) => (
      <span
        class="bcn-swart__seg"
        data-tone={s.tone}
        style={`--_w: ${pct(s.count).toFixed(2)}%`}
        aria-hidden="true"></span>
    ))}
  </div>

  <dl class="bcn-swart__legend">
    {segments.map((s) => (
      <div class="bcn-swart__item" data-tone={s.tone}>
        <span class="bcn-swart__swatch" aria-hidden="true"></span>
        <dt class="bcn-swart__label typography-body-sm">{s.label}</dt>
        <dd class="bcn-swart__count typography-label-md-strong">{s.count.toLocaleString()}</dd>
      </div>
    ))}
  </dl>
</section>

<style>
  .bcn-swart {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-250);
  }
  .bcn-swart__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--spacing-400);
  }
  .bcn-swart__title {
    margin: 0;
    color: var(--color-content-default);
  }
  .bcn-swart__total {
    margin: 0;
    color: var(--color-content-default-secondary);
  }

  /* The bar. Segments are flex items sized by their share, so they always sum to the
     track exactly and no rounding gap opens at the right edge. */
  .bcn-swart__bar {
    display: flex;
    width: 100%;
    height: 10px;
    overflow: hidden;
    border-radius: var(--radius-pill);
    background: var(--color-background-elevation-sunken);
  }
  .bcn-swart__seg {
    flex: 0 0 var(--_w);
    background: var(--_tone);
  }

  /* One tone assignment, read by both the segment and the swatch. */
  [data-tone='action'] {
    --_tone: var(--color-action);
  }
  [data-tone='obligation'] {
    --_tone: var(--color-obligation);
  }
  /* Literally both: the two entity colors mixed in equal parts. */
  [data-tone='both'] {
    --_tone: color-mix(in srgb, var(--color-action) 50%, var(--color-obligation));
  }
  [data-tone='flag'] {
    --_tone: var(--bcn-flag-on-color);
  }

  .bcn-swart__legend {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: var(--spacing-200) var(--spacing-500);
    margin: 0;
  }
  .bcn-swart__item {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    gap: var(--spacing-200);
    padding-bottom: var(--spacing-150);
    border-bottom: 1px solid var(--color-border-default-subtle);
  }
  .bcn-swart__swatch {
    width: 10px;
    height: 10px;
    border-radius: var(--radius-pill);
    background: var(--_tone);
    transform: translateY(-1px);
  }
  .bcn-swart__label {
    margin: 0;
    color: var(--color-content-default-secondary);
  }
  .bcn-swart__count {
    margin: 0;
    font-variant-numeric: tabular-nums;
    color: var(--color-content-default);
  }
  /* The one bucket that asks for something reads in the flag color on both channels. */
  .bcn-swart__item[data-tone='flag'] .bcn-swart__label,
  .bcn-swart__item[data-tone='flag'] .bcn-swart__count {
    color: var(--bcn-flag-on-color);
  }
  .bcn-swart__item[data-tone='flag'] {
    border-bottom-color: var(--bcn-flag-on-border);
  }
</style>
