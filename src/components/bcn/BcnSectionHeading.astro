---
// <BcnSectionHeading> — the heading a dashboard widget's section renders: a title
// naming the DATA, a subtitle naming the DISPLAY, and an optional count badge.
//
// WHY A COMPONENT AND NOT A SPAN. Every section used to hand-write its own
// `<span class="typography-label-md-strong">`, fifteen times across the page, and
// the sections that happened to have no heading (the map, the compliance lanes, the
// season timeline) simply had none. Two things then arrived at once and neither
// tolerates a hand-written span: the title/subtitle pattern (a second line, in a
// second role, from a fixed vocabulary) and a configurable title (the page script
// has to be able to FIND the title of any section and rewrite it). One component
// gives both — a single [data-section-title] hook, and a subtitle nobody has to
// remember to add.
//
// THE SUBTITLE IS NOT FREE TEXT. It comes from SECTION_DISPLAYS, keyed by the
// section's `display`, so "Bar chart" is spelled one way everywhere. The whole value
// of naming the display type is that a reader learns the vocabulary once; eleven
// spellings of "time series" would teach them nothing.
//
// COUNT SECTIONS DO NOT USE THIS, and that is deliberate rather than an omission.
// A headline figure IS an esa-stat, whose label is the accessible name of the
// number — pulling the title out into a heading and leaving the lego an empty label
// would strip the figure's name from the a11y tree. So a count section's title is
// its stat label and its subtitle is the stat's `sub`, with both ordered above the
// value in BcnDashboardWidget. The page script therefore looks for the title under
// `[data-section-title], .esa-stat__label` — the union is the cost of that call.
//
// bcn-lego-checked: the badge IS esa-badge and the layout primitives are `.stack`
// and `.cluster` from @esa/tokens/layouts.css; the type is the label-md-strong and
// label-sm roles, not bespoke sizes. Checked the esa-* catalog for a heading lego:
// esa-page-header is page-level chrome (title/lede/actions, its own margins and rule)
// and there is no section-heading component; esa-card supplies a header SLOT but this
// heading sits inside a card body, not in card chrome. Checked Beacon prod: its
// monitoring panels carry plain h4s with no display subtitle to port.
// bcn-section-heading is the reusable home; the CSS here is two lines and a colour.
import EsaBadge from '@esa/ecology/esa-badge.astro';
import { SECTION_DISPLAYS, type SectionDisplay } from '../../data/monitoring-streams';

interface Props {
  /** What data this section shows, in as few words as say it. The registry's
   *  `title`, which is also the default of the section's `title` setting. */
  title: string;
  /** How it shows it. Spelled out through SECTION_DISPLAYS. */
  display: SectionDisplay;
  /** A count worth stating beside the title (rows outstanding, items in a lane).
   *  Omit — do not pass 0 — when there is nothing to count. */
  count?: number;
}
const { title, display, count } = Astro.props;
---

<div class="bcn-shead stack" data-gap="none">
  <span class="cluster bcn-shead__line" data-gap="sm">
    {/* The hook the page rewrites when a user renames the section. */}
    <span class="bcn-shead__title typography-label-md-strong" data-section-title>{title}</span>
    {count !== undefined && <EsaBadge value={count} size="sm" />}
  </span>
  <span class="bcn-shead__sub typography-label-sm">{SECTION_DISPLAYS[display]}</span>
</div>

<style>
  /* data-gap="none" on the stack, not a rule here: the two lines are ONE heading, so
     they sit on their own leading rather than being spaced apart like two blocks. The
     primitive already publishes a zero step, so the gap stays declarative in markup.

     THE BADGE TREATMENT LIVES HERE, not at each call site. It was an inline
     `style="--badge-bg: …; --badge-text-color: …"` on the one section that had a
     count, and it is the same quiet grey BcnComplianceList re-points its lane counts
     to: a count beside a section title says how many rows follow, which is not the
     brand-navy-on-white announcement esa-badge defaults to. One home for it means
     the next section that needs a count inherits the treatment instead of copying a
     style attribute. */
  .bcn-shead__line {
    align-items: center;
    --badge-bg: var(--color-background-elevation-sunken);
    --badge-text-color: var(--color-content-default-secondary);
  }

  /* Secondary ink at the label-sm role — the same treatment the retired panel label
     carried. The subtitle is metadata ABOUT the element, so it has to sit clearly
     below the title in the reading order without competing with the widget's own
     chrome for attention. */
  .bcn-shead__sub {
    color: var(--color-content-default-secondary);
  }
</style>
