---
// <BcnPlanBudgetSheet> — a plan's budget by fiscal year (new, 2026-10-28, Andy: "manage the schedule via this Gantt
// chart, but manage the budget via an Excel-like table... by fiscal year"). The plan's other projected view: the same
// elements the Gantt draws, one row each (parents sum their children), one column per California fiscal year (July to
// June) across the plan, a Total column, and a pinned Plan Total row.
//
// Live reads; your draft edits a task's cells, each change one edit of the draft. The schedule shows through: a year
// outside an element's dates is hatched, and money in one is flagged.
//
// It reads and behaves like a spreadsheet (2026-10-28, Andy: "as Excel and Google Sheets like as possible"). The
// spreadsheet is <BcnSheet> (2026-10-30: the name box and value bar, the cursor, the cell kinds, the parents' shading,
// the keys), shared with the Schedule Table; this is the budget's key, its year header, and its money cells (right-
// aligned in the UI font's tabular figures, design QA 2026-10-29: mono is for identifiers, not money; hatched outside
// the dates; flagged when stray; green where the draft changed them; the total). The runtime is ./plan-budget-sheet.ts.
//
// bcn-lego-checked: the sheet IS <BcnSheet> (AG Grid community on the spoke's Beacon theme, as Beacon's grids are); its
// editor is AG Grid's. No esa- lego is an editable grid. The CSS is the budget's own cell states and year header.
import BcnSheet from './BcnSheet.astro';
---

<BcnSheet class="bcn-pbs" hooks="pbs" data-bcn-plan-budget-sheet>
  <!-- What the cells mean (2026-10-28, Andy: "so unclear which cells are editable vs rollups"). Editable shows in your
       draft only. -->
  <Fragment slot="legend">
    <span data-legend="edit"><i></i>Editable</span>
    <span data-legend="sum"><i></i>Sum</span>
    <span data-legend="off"><i></i>Outside Its Dates</span>
  </Fragment>
</BcnSheet>

<!-- is:global: the cells are AG Grid's, built at runtime; every selector is under .bcn-pbs. -->
<style is:global>
  /* The year header: its label over its months, right-aligned over the figures, on Beacon's teal band; the current
     year underlined (brand ink can't read on the band). */
  .bcn-pbs .bcn-pbs__head { display: flex; flex-direction: column; align-items: flex-end; inline-size: 100%; line-height: 1.2; cursor: pointer; }
  .bcn-pbs .bcn-pbs__head-fy { display: inline-flex; gap: var(--spacing-100); font-weight: 600; }
  .bcn-pbs .bcn-pbs__head-span { font-size: var(--typography-body-xs-font-size); font-weight: 400; color: color-mix(in srgb, var(--color-content-default-knockout) 80%, transparent); white-space: nowrap; }
  .bcn-pbs .bcn-pbs__head[data-current] .bcn-pbs__head-fy { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 3px; }
  .bcn-pbs .bcn-pbs__head[data-current] .bcn-pbs__head-span { font-weight: 600; color: var(--color-content-default-knockout); }
  /* A year column too narrow for its months drops them; the header's tooltip keeps them. */
  .bcn-pbs .ag-header-cell-comp-wrapper { container-type: inline-size; }
  @container (max-width: 104px) {
    .bcn-pbs .bcn-pbs__head-span { display: none; }
  }

  /* Money in the UI font's tabular figures, right-aligned with its header (design QA, 2026-10-29: prod's grids set DM
     Sans 13px; mono is for identifiers only). Sums in the grid's semibold. */
  .bcn-pbs .bcn-pbs__money { font-size: var(--bcn-type-size-meta); font-variant-numeric: tabular-nums; }
  .bcn-pbs .bcn-pbs__money:is(.bcn-sheet__parent, .bcn-pbs__changed, .bcn-pbs__stray),
  .bcn-pbs .ag-row-pinned .bcn-pbs__money { font-weight: 600; }
  .bcn-pbs .bcn-pbs__money.bcn-pbs__zero { color: var(--color-content-default-tertiary); font-weight: 400; }
  /* A year the task doesn't run in: hatched, and quieter. */
  .bcn-pbs .bcn-pbs__off { background-image: var(--_sheet-hatch); color: var(--color-content-default-tertiary); }
  /* Money in a year the element doesn't run in: worth a look. */
  .bcn-pbs .bcn-pbs__stray { color: var(--color-content-utility-warning); font-weight: 600; }
  /* A cell the draft changed from Live: the draft's green, as its badge, over whatever kind of cell it is. */
  .bcn-pbs .ag-cell.bcn-pbs__changed,
  .bcn-pbs.bcn-sheet[data-editable='true'] .ag-cell.bcn-pbs__changed { background-color: color-mix(in srgb, var(--bcn-mark-green) 16%, var(--color-background-elevation-raised)); font-weight: 600; }
  /* In your draft the non-editable task years go gray under the hatch, so only the fields stay white. */
  .bcn-pbs[data-editable='true'] .ag-cell.bcn-pbs__off:not(.bcn-sheet__edit) { background-color: var(--_sheet-sum); }
  /* The total: its own column, and the plan's row along the foot. */
  .bcn-pbs .bcn-pbs__total { background-color: color-mix(in srgb, var(--color-content-default) 2%, transparent); }
  .bcn-pbs .ag-floating-bottom { border-block-start: 1px solid var(--color-border-default-strong, var(--color-border-default)); }
  .bcn-pbs .ag-row-pinned { background-color: var(--color-background-elevation-sunken); }
  .bcn-pbs .ag-row-pinned .ag-cell { font-weight: 600; }
  /* A figure is typed where it shows: at the cell's end. */
  .bcn-pbs .ag-cell-inline-editing input { text-align: end; }
</style>
