---
// <BcnPlanFieldsPages> — Plan Settings' Fields and Pages section (2026-10-28, the proposal's "Fields per level" and
// "Configuring a plan: Aaron's setup"): per level, which fields its items carry and how its page is laid out, with a
// live preview of a real item at that level. The monitoring portal's Configure dialog (BcnConfigDialog, its widget
// registry and saved layout) moved from the dashboard to the record: options beside a preview that redraws as you go.
//
//   Editor    the level's name and its Can Be a Deliverable switch, then two tabs:
//               Page    Main Column and Side Column, a row per module: grip, glyph, name, a quiet kind note, a switch
//                       (core and shared modules are always on: they move, they don't go), and the module's options
//                       (Budget: who sees it; Documents: which types it offers; Schedule: the children's timeline).
//                       Drag a row, or use its Move buttons, to reorder it or move it to the other column.
//               Fields  the fields its items carry: All Levels' first (read-only here), then the level's own, each
//                       with Required to Complete and Shown In. Add Field from the plan's library or New Field; the
//                       Field Library below lists every definition and where it's used.
//             All Levels has Fields only.
//   Preview   the element page itself, in an iframe, drawn with the unsaved configuration (`&preview=1` reads it from
//             PREVIEW_CONFIG_KEY), scaled to fit the column so the whole layout shows. A select picks the item.
//
// The level picker sits in the settings page's left nav, under Fields and Pages, as in the proposal's wireframe. The
// runtime is ./plan-fields-pages.ts; the field dialog is BcnFieldDefDialog; the drag is ./plan-sortable.ts.
//
// bcn-lego-checked: tabs ARE esa-button-toggle, switches ARE esa-switch-toggle, module options ARE esa-select (multiple
// for document types) and esa-switch-toggle, Shown In IS esa-chip-group (multiple), Add Field IS esa-dropdown-menu,
// glyphs ARE esa-icon, the All Levels tag IS esa-badge, every button IS esa-button under esa-tooltip, the empty preview
// IS esa-empty-state. The module rows follow BcnConfigSections' bars (grip, switch, settings under the row), which
// can't be reused directly: it is bound to the monitoring widget registry. No esa- lego is a two-column sortable list
// or a scaled live page preview; checked Beacon (prod has no per-level layout; its custom field admin is a grid with
// no level scope). bcn-plan-fields-pages is the home; the CSS is the three regions, the rows and the stage.
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaIcon from '@esa/ecology/esa-icon.astro';
import EsaBadge from '@esa/ecology/esa-badge.astro';
import EsaEmptyState from '@esa/ecology/esa-empty-state.astro';
import { MODULES, MODULE_ORDER, type ModuleKind } from '../../lib/planning/plan-config';
import { PLAN_ICON_PATHS } from '../../lib/planning/icons';

const KIND_NOTE: Record<ModuleKind, string> = {
  core: 'Always On',
  shared: 'Always On',
  optional: '',
  deliverable: 'Deliverables Only',
  parents: 'Items With Children Only',
};
const modules = MODULE_ORDER.map((key) => MODULES[key]);
const grip = PLAN_ICON_PATHS['grip-vertical'];
---

<div class="bcn-pfp" data-bcn-fields-pages>
  <div class="bcn-pfp__editor" data-pfp-editor>
    <header class="bcn-pfp__head">
      <div class="bcn-pfp__title-row">
        <h2 class="bcn-pfp__title" data-pfp-title>Level</h2>
        <span class="bcn-pfp__count typography-body-sm" data-pfp-count></span>
        <span class="bcn-pfp__tabs" data-pfp-tabs-wrap><esa-button-toggle size="sm" label="" aria-label="Edit the level's" data-pfp-tabs></esa-button-toggle></span>
      </div>
      <p class="bcn-pfp__lede typography-body-sm" data-pfp-lede></p>
      <div class="bcn-pfp__deliverable" data-pfp-deliverable>
        <esa-switch-toggle size="sm" label="Can Be a Deliverable" data-pfp-can-deliver></esa-switch-toggle>
        <p class="bcn-pfp__hint typography-body-sm" data-pfp-deliver-hint></p>
      </div>
    </header>

    <!-- ── Page: the level's two columns ── -->
    <section class="bcn-pfp__panel" data-pfp-panel="page" aria-label="Page layout">
      <h3 class="bcn-pfp__zone typography-label-sm-strong">Main Column</h3>
      <ol class="bcn-pfp__modules" data-pfp-col="main" aria-label="Main Column"></ol>
      <h3 class="bcn-pfp__zone typography-label-sm-strong">Side Column</h3>
      <ol class="bcn-pfp__modules" data-pfp-col="side" aria-label="Side Column"></ol>
      <div class="bcn-pfp__panel-foot" data-pfp-edit-only>
        <span data-pfp-reset><EsaButton variant="ghost" size="xs" icon="rotate-ccw">Reset to Default Layout</EsaButton></span>
      </div>

      <!-- Every module's row, rendered once; the runtime moves each into its column, in the level's order. -->
      <div hidden data-pfp-module-bank>
        {
          modules.map((m) => (
            <li class="bcn-pfp__row bcn-pfp__module" data-pfp-module={m.key} data-kind={m.kind}>
              <div class="bcn-pfp__bar">
                <button type="button" class="bcn-pfp__grip" data-pfp-grip tabindex="-1" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" set:html={grip} />
                </button>
                <span class="bcn-pfp__glyph">
                  <EsaIcon name={m.icon} paths={PLAN_ICON_PATHS[m.icon]} size="sm" />
                </span>
                <span class="bcn-pfp__name">
                  <span class="bcn-pfp__name-row">
                    <span class="bcn-pfp__label typography-label-sm-strong" id={`pfp-mod-${m.key}`}>{m.title}</span>
                    {KIND_NOTE[m.kind] && <span class="bcn-pfp__kind typography-body-xs">{KIND_NOTE[m.kind]}</span>}
                  </span>
                  <span class="bcn-pfp__why typography-body-xs" data-pfp-why hidden />
                </span>
                <span class="bcn-pfp__tools" data-pfp-tools>
                  <esa-tooltip text="Move Up" position="above"><span data-pfp-act="up"><EsaButton variant="ghost" size="xs" iconOnly icon="arrow-up" label={`Move ${m.title} Up`} /></span></esa-tooltip>
                  <esa-tooltip text="Move Down" position="above"><span data-pfp-act="down"><EsaButton variant="ghost" size="xs" iconOnly icon="arrow-down" label={`Move ${m.title} Down`} /></span></esa-tooltip>
                  <esa-tooltip text="Move to Side Column" position="above" align="end" data-pfp-across-tip>
                    <span data-pfp-act="across"><EsaButton variant="ghost" size="xs" iconOnly icon="move-horizontal" data-fill-icon="move-horizontal" label={`Move ${m.title} to the Other Column`} /></span>
                  </esa-tooltip>
                </span>
                <esa-switch-toggle class="bcn-pfp__switch" size="sm" aria-labelledby={`pfp-mod-${m.key}`} data-pfp-switch />
              </div>
              {m.key === 'budget' && (
                <div class="bcn-pfp__opts" data-pfp-opts>
                  <span class="bcn-pfp__opt-label typography-label-xs" id="pfp-opt-visible">Visible To</span>
                  <esa-select size="sm" aria-labelledby="pfp-opt-visible" data-pfp-opt="visibleTo" />
                </div>
              )}
              {m.key === 'documents' && (
                <div class="bcn-pfp__opts" data-pfp-opts>
                  <span class="bcn-pfp__opt-label typography-label-xs" id="pfp-opt-types">Document Types</span>
                  <esa-select size="sm" multiple placeholder="All of the Plan's Types" aria-labelledby="pfp-opt-types" data-pfp-opt="documentTypes" />
                </div>
              )}
              {m.key === 'schedule' && (
                <div class="bcn-pfp__opts" data-pfp-opts>
                  <esa-switch-toggle class="bcn-pfp__opt-switch" size="sm" label="Show the Children's Timeline" data-pfp-opt="childTimeline" />
                </div>
              )}
            </li>
          ))
        }
      </div>
    </section>

    <!-- ── Fields: what the level's items carry ── -->
    <section class="bcn-pfp__panel" data-pfp-panel="fields" aria-label="Fields" hidden>
      <p class="bcn-pfp__hint typography-body-sm">No field is required to create an item. A field marked Required to Complete needs a value before the item can be marked complete.</p>
      <div class="bcn-pfp__group" data-pfp-inherited-wrap>
        <div class="bcn-pfp__group-head">
          <h3 class="bcn-pfp__zone typography-label-sm-strong">From All Levels</h3>
          <span data-pfp-goto-all><EsaButton variant="ghost" size="xs">Edit in All Levels</EsaButton></span>
        </div>
        <ul class="bcn-pfp__fields" data-pfp-inherited role="list"></ul>
      </div>
      <div class="bcn-pfp__group">
        <h3 class="bcn-pfp__zone typography-label-sm-strong" data-pfp-own-heading>This Level's Fields</h3>
        <ul class="bcn-pfp__fields" data-pfp-fields role="list"></ul>
        <p class="bcn-pfp__empty typography-body-sm" data-pfp-fields-empty hidden>No fields yet.</p>
        <div class="bcn-pfp__panel-foot" data-pfp-edit-only>
          <esa-dropdown-menu data-pfp-add-menu position="below-start">
            <EsaButton variant="ghost" appearance="outline" size="xs" icon="plus" iconRight="chevron-down">Add Field</EsaButton>
          </esa-dropdown-menu>
        </div>
      </div>

      <section class="bcn-pfp__library" aria-labelledby="pfp-library-heading">
        <div class="bcn-pfp__group-head">
          <h3 class="bcn-pfp__zone typography-label-sm-strong" id="pfp-library-heading">Field Library</h3>
          <span data-pfp-new-field data-pfp-edit-only><EsaButton variant="ghost" size="xs" icon="plus">New Field</EsaButton></span>
        </div>
        <p class="bcn-pfp__hint typography-body-sm">Every field this plan defines, and the levels that use it. A field in use can't be deleted; take it off its levels first.</p>
        <ul class="bcn-pfp__library-list" data-pfp-library role="list"></ul>
      </section>
    </section>
  </div>

  <!-- ── The live preview ── -->
  <aside class="bcn-pfp__preview" aria-label="Preview" data-pfp-preview>
    <div class="bcn-pfp__preview-head">
      <span class="bcn-pfp__preview-label typography-label-sm-strong">Preview</span>
      <esa-select class="bcn-pfp__preview-pick" size="sm" aria-label="Item to Preview" data-pfp-preview-el></esa-select>
      <esa-tooltip text="Open the Preview in a New Tab" position="below" align="end">
        <span class="bcn-pfp__preview-open" data-pfp-preview-open><EsaButton variant="ghost" size="xs" iconOnly icon="external-link" label="Open the Preview in a New Tab" href="#" target="_blank" /></span>
      </esa-tooltip>
    </div>
    <div class="bcn-pfp__stage" data-pfp-stage>
      <iframe class="bcn-pfp__frame" data-pfp-frame title="Preview of the item's page" tabindex="-1" aria-hidden="true"></iframe>
      <div class="bcn-pfp__shield" data-pfp-shield aria-hidden="true"></div>
      <div class="bcn-pfp__preview-empty" data-pfp-preview-empty hidden>
        <EsaEmptyState size="sm" title="No Items at This Level Yet" description="Add one to the plan to preview its page." />
      </div>
    </div>
    <p class="bcn-pfp__preview-note typography-body-xs" data-pfp-preview-note>The page as it will look with these settings. Saving applies it to every item at this level.</p>
  </aside>

  <!-- ── Runtime rows ── -->
  <template data-pfp-tpl="field">
    <li class="bcn-pfp__row bcn-pfp__field" data-pfp-field>
      <div class="bcn-pfp__bar">
        <button type="button" class="bcn-pfp__grip" data-pfp-grip tabindex="-1" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" set:html={grip}></svg>
        </button>
        <span class="bcn-pfp__name">
          <span class="bcn-pfp__name-row">
            <span class="bcn-pfp__label typography-label-sm-strong" data-f-label></span>
            <span class="bcn-pfp__kind typography-body-xs" data-f-type></span>
          </span>
        </span>
        <span class="bcn-pfp__tools" data-pfp-tools>
          <esa-tooltip text="Move Up" position="above"><span data-pfp-act="up"><EsaButton variant="ghost" size="xs" iconOnly icon="arrow-up" label="Move Up" /></span></esa-tooltip>
          <esa-tooltip text="Move Down" position="above"><span data-pfp-act="down"><EsaButton variant="ghost" size="xs" iconOnly icon="arrow-down" label="Move Down" /></span></esa-tooltip>
          <esa-tooltip text="Edit Field" position="above"><span data-pfp-act="edit"><EsaButton variant="ghost" size="xs" iconOnly icon="pencil" label="Edit Field" /></span></esa-tooltip>
          <esa-tooltip text="Remove From This Level" position="above" align="end"><span data-pfp-act="remove"><EsaButton variant="ghost" size="xs" iconOnly icon="x" label="Remove From This Level" /></span></esa-tooltip>
        </span>
      </div>
      <div class="bcn-pfp__field-opts">
        <esa-switch-toggle class="bcn-pfp__opt-switch" size="sm" label="Required to Complete" data-f-required></esa-switch-toggle>
        <div class="bcn-pfp__shown">
          <span class="bcn-pfp__opt-label typography-label-xs" data-f-shown-label>Shown In</span>
          <esa-chip-group multiple size="xs" data-f-shown></esa-chip-group>
        </div>
      </div>
    </li>
  </template>
  <template data-pfp-tpl="inherited">
    <li class="bcn-pfp__row bcn-pfp__field bcn-pfp__field--inherited" data-pfp-inherited-row>
      <div class="bcn-pfp__bar">
        <span class="bcn-pfp__name">
          <span class="bcn-pfp__name-row">
            <span class="bcn-pfp__label typography-label-sm-strong" data-f-label></span>
            <span class="bcn-pfp__kind typography-body-xs" data-f-type></span>
          </span>
          <span class="bcn-pfp__why typography-body-xs" data-f-summary></span>
        </span>
        <EsaBadge value="All Levels" size="xs" />
      </div>
    </li>
  </template>
  <template data-pfp-tpl="library">
    <li class="bcn-pfp__lib-row" data-pfp-lib-row>
      <span class="bcn-pfp__name">
        <span class="bcn-pfp__name-row">
          <span class="bcn-pfp__label typography-label-sm" data-lib-label></span>
          <span class="bcn-pfp__kind typography-body-xs" data-lib-type></span>
        </span>
      </span>
      <span class="bcn-pfp__lib-used typography-body-xs" data-lib-used></span>
      <span class="bcn-pfp__lib-tools" data-pfp-edit-only>
        <esa-tooltip text="Edit Field" position="above"><span data-lib-act="edit"><EsaButton variant="ghost" size="xs" iconOnly icon="pencil" label="Edit Field" /></span></esa-tooltip>
        <esa-tooltip text="Delete Field" position="above" align="end"><span data-lib-act="delete"><EsaButton variant="ghost" size="xs" iconOnly icon="trash-2" label="Delete Field" /></span></esa-tooltip>
      </span>
    </li>
  </template>
</div>

<script>
  import '@esa/ecology/esa-button-toggle';
  import '@esa/ecology/esa-switch-toggle';
  import '@esa/ecology/esa-select';
  import '@esa/ecology/esa-chip-group';
  import '@esa/ecology/esa-dropdown-menu';
  import '@esa/ecology/esa-tooltip';
</script>

<style>
  .bcn-pfp {
    display: grid;
    grid-template-columns: minmax(24rem, 27rem) minmax(0, 1fr);
    gap: var(--spacing-600);
    align-items: start;
    min-inline-size: 0;
  }
  .bcn-pfp :global([hidden]) {
    display: none !important;
  }

  /* ── The editor ── */
  .bcn-pfp__editor {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-400);
    min-inline-size: 0;
  }
  .bcn-pfp__head {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-200);
  }
  .bcn-pfp__title-row {
    display: flex;
    align-items: center;
    gap: var(--spacing-200);
    min-inline-size: 0;
  }
  .bcn-pfp__title {
    margin: 0;
    font-size: var(--font-size-300);
    font-weight: var(--typography-font-weight-semibold);
    color: var(--color-content-default);
  }
  .bcn-pfp__count {
    color: var(--color-content-default-secondary);
    white-space: nowrap;
  }
  .bcn-pfp__tabs {
    margin-inline-start: auto;
  }
  .bcn-pfp__lede,
  .bcn-pfp__hint {
    margin: 0;
    color: var(--color-content-default-secondary);
  }
  .bcn-pfp__deliverable {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-100);
    padding: var(--spacing-300);
    border-radius: var(--radius-200);
    background: var(--color-background-elevation-sunken);
  }
  .bcn-pfp__deliverable esa-switch-toggle {
    align-self: flex-start;
  }
  .bcn-pfp__deliverable .bcn-pfp__hint {
    padding-inline-start: calc(32px + var(--spacing-200));
  }
  .bcn-pfp__panel {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-200);
  }
  .bcn-pfp__zone {
    margin: var(--spacing-200) 0 0;
    color: var(--color-content-default);
  }
  .bcn-pfp__panel > .bcn-pfp__zone:first-child {
    margin-block-start: 0;
  }
  .bcn-pfp__group {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-200);
  }
  .bcn-pfp__group-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-200);
    margin-block-start: var(--spacing-200);
  }
  .bcn-pfp__group-head .bcn-pfp__zone {
    margin: 0;
  }
  .bcn-pfp__panel-foot {
    display: flex;
    align-items: center;
    gap: var(--spacing-200);
  }
  .bcn-pfp__empty {
    margin: 0;
    padding: var(--spacing-300);
    border: 1px dashed var(--color-border-default);
    border-radius: var(--radius-200);
    color: var(--color-content-default-secondary);
    text-align: center;
  }

  /* ── Rows: one band per module or field, a hairline between, as BcnConfigSections' bars. ── */
  .bcn-pfp__modules,
  .bcn-pfp__fields {
    list-style: none;
    margin: 0;
    padding: 0;
    min-block-size: 2.75rem;
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-200);
    background: var(--color-background-elevation-raised);
  }
  .bcn-pfp__fields:empty {
    display: none;
  }
  .bcn-pfp__row {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-150);
    padding: var(--spacing-200) var(--spacing-200) var(--spacing-200) var(--spacing-150);
    background: var(--color-background-elevation-raised);
  }
  .bcn-pfp__row + .bcn-pfp__row {
    border-block-start: 1px solid var(--color-border-default-subtle);
  }
  .bcn-pfp__row:first-child {
    border-start-start-radius: var(--radius-200);
    border-start-end-radius: var(--radius-200);
  }
  .bcn-pfp__row:last-child {
    border-end-start-radius: var(--radius-200);
    border-end-end-radius: var(--radius-200);
  }
  .bcn-pfp__row.is-dragging {
    opacity: 0.35;
  }
  .bcn-pfp__bar {
    display: flex;
    align-items: center;
    gap: var(--spacing-200);
    min-inline-size: 0;
  }
  .bcn-pfp__grip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    inline-size: 1rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-content-default-tertiary);
    cursor: grab;
    touch-action: none;
  }
  .bcn-pfp__glyph {
    display: inline-flex;
    flex: none;
    color: var(--color-content-default-secondary);
  }
  .bcn-pfp__name {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-inline-size: 0;
  }
  .bcn-pfp__name-row {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-200);
    min-inline-size: 0;
  }
  .bcn-pfp__label {
    color: var(--color-content-default);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .bcn-pfp__kind {
    color: var(--color-content-default-tertiary);
    white-space: nowrap;
  }
  .bcn-pfp__why {
    color: var(--color-content-default-secondary);
  }
  /* The row's tools wait for the row: on hover, or when one has focus (keyboard users tab straight to them). */
  .bcn-pfp__tools {
    display: inline-flex;
    align-items: center;
    flex: none;
    opacity: 0;
    transition: opacity 120ms ease;
  }
  .bcn-pfp__row:hover .bcn-pfp__tools,
  .bcn-pfp__row:focus-within .bcn-pfp__tools {
    opacity: 1;
  }
  .bcn-pfp__switch {
    flex: none;
  }
  /* Off: the row steps back; it keeps its place, so switching it on again puts it where it was. */
  .bcn-pfp__module[data-off] .bcn-pfp__glyph,
  .bcn-pfp__module[data-off] .bcn-pfp__label {
    color: var(--color-content-default-tertiary);
  }
  .bcn-pfp__module[data-off] .bcn-pfp__opts {
    display: none;
  }
  /* A module's options sit under its name, indented past the grip and the glyph. */
  .bcn-pfp__opts {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    align-items: center;
    gap: var(--spacing-200);
    padding-inline-start: calc(1rem + var(--spacing-200) + 16px + var(--spacing-200));
    padding-inline-end: var(--spacing-100);
  }
  .bcn-pfp__opts:has(.bcn-pfp__opt-switch) {
    grid-template-columns: minmax(0, 1fr);
  }
  .bcn-pfp__opt-label {
    color: var(--color-content-default-secondary);
  }
  .bcn-pfp__opt-switch {
    justify-self: start;
    align-self: flex-start;
  }
  .bcn-pfp__opt-switch::part(label) {
    font-size: var(--typography-label-xs-font-size);
    color: var(--color-content-default-secondary);
  }
  .bcn-pfp__opts esa-select {
    --_field-padding-y: var(--spacing-100);
  }

  /* Fields: Required to Complete, then Shown In, under the field's name. */
  .bcn-pfp__field-opts {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-100);
    padding-inline-start: calc(1rem + var(--spacing-200));
  }
  .bcn-pfp__shown {
    display: flex;
    align-items: center;
    gap: var(--spacing-200);
    min-inline-size: 0;
  }
  .bcn-pfp__shown esa-chip-group {
    flex: 1;
    min-inline-size: 0;
  }
  .bcn-pfp__field--inherited {
    padding-inline-start: var(--spacing-300);
  }
  .bcn-pfp__field--inherited .bcn-pfp__name {
    gap: 2px;
  }
  .bcn-pfp__fields--inherited {
    background: var(--color-background-elevation-sunken);
  }

  /* Read-only: no grips, no tools, nothing to add. */
  .bcn-pfp[data-readonly] .bcn-pfp__grip,
