---
// <BcnSw3Sources> — the project's source documents and their files, the sidebar of the
// Setup Wizard's first step. Prod's model: a source (name, reference number) holds files,
// and each file is scanned on its own.
//
// The list is the Library (the page is already Source Documents). A source folds open or
// shut by its chevron. A source is its name over its reference number, with ⋯ for Edit details, Add files and
// Delete source; selecting it opens its details in the main pane (prod's source view:
// fields, files, the upload dropzone). Its files sit under it, one row each: the file's
// name (middle-truncated) and one state, never a string of counts:
//   Not scanned
//   Reading p. 16 of 170 (with a progress bar under the row)
//   3 to check (a warning badge: the run has stopped for the person)
//   Paused at p. 40
//   157 commitments / No commitments
// Selecting a file brings its scan into view; ⋯ on it downloads it, restarts its scan or
// deletes it. New source document is pinned at the foot.
//
// Rows are built by the controller (sources and files change at runtime) from the
// templates below, which hold the legos.
//
// Contract: sw3-sources-ui.ts `setupSw3SourcesUi(root, handlers)` returns { render }.
//
// bcn-lego-checked: the menus ARE esa-dropdown-menu behind esa-icon-button, the badge IS
// esa-badge, the bar IS esa-progress-bar, the footer IS esa-button. esa-file-list lists
// uploads with no per-file state or selection; esa-sidebar-nav is app navigation. Checked
// Beacon: the setup wizard's source list (prod screenshots, 2026-10-14) is this, minus
// the nesting and the scan state. bcn-sw3-sources is the home.
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaIconButton from '@esa/ecology/esa-icon-button.astro';
import EsaIcon from '@esa/ecology/esa-icon.astro';
import EsaBadge from '@esa/ecology/esa-badge.astro';
import EsaProgressBar from '@esa/ecology/esa-progress-bar.astro';
---

<aside class="bcn-sw3src" data-sw3-sources aria-label="Library">
  <header class="bcn-sw3src__head">
    <h3 class="bcn-sw3src__title">Library</h3>
    <EsaButton variant="chrome" iconOnly icon="chevrons-left" label="Collapse the library" size="xs" data-rail-close="library" />
  </header>
  <div class="bcn-sw3src__list" data-src-list></div>
  <footer class="bcn-sw3src__foot">
    <EsaButton variant="ghost" size="xs" icon="plus" data-ico="file-plus" data-src-new>New source document</EsaButton>
  </footer>

  <template data-src-tpl>
    <section class="bcn-sw3src__source" data-source>
      <div class="bcn-sw3src__srcrow">
        <EsaButton variant="chrome" iconOnly icon="chevron-down" label="Collapse" size="xs" class="bcn-sw3src__fold" data-src-fold aria-expanded="true" />
        <button type="button" class="bcn-sw3src__srcbtn" data-src-open>
          <span class="bcn-sw3src__name" data-src-name></span>
        </button>
        <esa-dropdown-menu class="bcn-sw3src__menu" position="below-end" data-src-menu>
          <EsaIconButton icon="menu" label="Source document actions" size="xs" data-ico="ellipsis" />
        </esa-dropdown-menu>
      </div>
      <ol class="bcn-sw3src__files" data-src-files></ol>
    </section>
  </template>

  <template data-file-tpl>
    <li class="bcn-sw3src__file" data-file>
      <button type="button" class="bcn-sw3src__filebtn" data-file-open>
        <span class="bcn-sw3src__fileicon"><EsaIcon name="file-text" size="xs" /></span>
        <span class="bcn-sw3src__filetext">
          <span class="bcn-sw3src__fname" data-file-name><span class="bcn-sw3src__fstart" data-file-start></span><span class="bcn-sw3src__fend" data-file-end></span></span>
          <span class="bcn-sw3src__fstate">
            <span data-file-state></span>
            <span data-file-badge hidden><EsaBadge value="3 to check" variant="warning" size="xs" /></span>
          </span>
          <span class="bcn-sw3src__progress" data-file-progress hidden><EsaProgressBar size="xs" value={0} showValue={false} /></span>
        </span>
      </button>
      <esa-dropdown-menu class="bcn-sw3src__menu" position="below-end" data-file-menu>
        <EsaIconButton icon="menu" label="File actions" size="xs" data-ico="ellipsis" />
      </esa-dropdown-menu>
    </li>
  </template>
</aside>

<style>
  /* Dense: the library is a list to scan, so 13px names and 12px states, heavier as
     they shrink (Andy, 2026-10-14: below the 14px dense floor on purpose). */
  .bcn-sw3src {
    display: flex;
    flex-direction: column;
    min-height: 0;
    height: 100%;
    overflow: hidden;
    background: var(--color-background-elevation-raised);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-200);
    box-shadow: var(--elevation-3);
    font-size: 0.8125rem;
    line-height: 1.3;
  }
  /* The header is a gray band, as prod's list heads are. */
  .bcn-sw3src__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--spacing-200) var(--spacing-200) var(--spacing-200) var(--spacing-400);
    background: var(--color-background-elevation-sunken);
    border-bottom: 1px solid var(--color-border-default);
  }
  .bcn-sw3src__title {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-content-default);
  }
  .bcn-sw3src__list {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: var(--spacing-200);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-300);
  }
  .bcn-sw3src__foot {
    padding: var(--spacing-200) var(--spacing-300);
    border-top: 1px solid var(--color-border-default-subtle);
  }

  /* Rows are cloned from the templates by the controller: reached through :global(). */
  .bcn-sw3src__list :global(.bcn-sw3src__srcrow),
  .bcn-sw3src__list :global(.bcn-sw3src__file) {
    position: relative;
    display: flex;
    align-items: flex-start;
    border-radius: var(--radius-100);
  }
  .bcn-sw3src__list :global(.bcn-sw3src__srcrow:hover),
  .bcn-sw3src__list :global(.bcn-sw3src__file:hover) { background: var(--color-background-elevation-sunken); }
  .bcn-sw3src__list :global(.bcn-sw3src__source[data-selected] > .bcn-sw3src__srcrow),
  .bcn-sw3src__list :global(.bcn-sw3src__file[data-selected]) {
    background: var(--color-background-elevation-sunken);
    box-shadow: inset 0 0 0 1px var(--color-border-default);
  }
  .bcn-sw3src__list :global(.bcn-sw3src__fold) { flex: none; padding: 4px 0 0 2px; }
  .bcn-sw3src__list :global(.bcn-sw3src__fold svg) { transition: transform 150ms ease; }
  .bcn-sw3src__list :global(.bcn-sw3src__source[data-collapsed] .bcn-sw3src__fold svg) { transform: rotate(-90deg); }
  .bcn-sw3src__list :global(.bcn-sw3src__source[data-collapsed] .bcn-sw3src__files) { display: none; }
  .bcn-sw3src__list :global(.bcn-sw3src__srcbtn),
  .bcn-sw3src__list :global(.bcn-sw3src__filebtn) {
    flex: 1;
    min-width: 0;
    display: flex;
    gap: var(--spacing-150, 0.375rem);
    padding: var(--spacing-150, 0.375rem) var(--spacing-200);
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    border-radius: var(--radius-100);
  }
  .bcn-sw3src__list :global(.bcn-sw3src__srcbtn) { flex-direction: column; gap: 0; padding-left: 2px; }
  .bcn-sw3src__list :global(.bcn-sw3src__srcbtn:focus-visible),
  .bcn-sw3src__list :global(.bcn-sw3src__filebtn:focus-visible) {
    outline: var(--focus-ring-width, 2px) solid var(--focus-ring-color);
    outline-offset: -2px;
  }
  .bcn-sw3src__list :global(.bcn-sw3src__name) { font-weight: 600; color: var(--color-content-default); }
  .bcn-sw3src__list :global(.bcn-sw3src__files) {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 2px 0 0;
    padding: 0 0 0 var(--spacing-400);
    list-style: none;
  }
  .bcn-sw3src__list :global(.bcn-sw3src__fileicon) {
    flex: none;
    padding-top: 1px;
    color: var(--color-content-default-secondary);
  }
  .bcn-sw3src__list :global(.bcn-sw3src__filetext) {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  /* Middle truncation in CSS: the start gives way, the end (version, date, extension) stays. */
  .bcn-sw3src__list :global(.bcn-sw3src__fname) {
    display: flex;
    min-width: 0;
    font-weight: 500;
    color: var(--color-content-default);
    white-space: nowrap;
  }
  .bcn-sw3src__list :global(.bcn-sw3src__fstart) {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .bcn-sw3src__list :global(.bcn-sw3src__fend) { flex: none; }
  .bcn-sw3src__list :global(.bcn-sw3src__fstate) {
    display: flex;
    align-items: center;
    gap: var(--spacing-200);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-content-default-secondary);
    font-variant-numeric: tabular-nums;
  }
  .bcn-sw3src__list :global(.bcn-sw3src__fstate [data-file-state]:empty) { display: none; }
  .bcn-sw3src__list :global(.bcn-sw3src__progress) { display: block; margin-top: 2px; }
  .bcn-sw3src__list :global(.bcn-sw3src__progress[hidden]) { display: none; }
  /* Row menus show on hover, on focus, and while open. */
  .bcn-sw3src__list :global(.bcn-sw3src__menu) {
    flex: none;
    padding: 2px 2px 0 0;
    opacity: 0;
  }
  .bcn-sw3src__list :global(.bcn-sw3src__srcrow:hover > .bcn-sw3src__menu),
  .bcn-sw3src__list :global(.bcn-sw3src__file:hover > .bcn-sw3src__menu),
  .bcn-sw3src__list :global(.bcn-sw3src__menu:focus-within),
  .bcn-sw3src__list :global(.bcn-sw3src__menu[open]) { opacity: 1; }
</style>

<script>
  import '@esa/ecology/esa-dropdown-menu';
</script>
