---
// <BcnCommitmentBadge> — the standard commitment-ID chip: mono, semibold, the
// commitment purple on a 12% tint. Extracted from BcnCommitmentRow (round 10)
// so every surface that shows a commitment code renders the SAME badge — the
// modules, the timeline popovers, and the tracker rows.
//
// bcn-lego-checked: esa-badge and esa-pill are the nearest legos but neither
// carries the mono/entity-color treatment Beacon uses for commitment IDs (and
// esa-badge fills solid). Checked Beacon — this IS the prod commitment-code
// chip. bcn-commitment-badge is the reusable home; it reads only semantic
// tokens (--color-commitment / --radius / --spacing).
interface Props {
  code: string;
  /** `sm` for dense rows (timeline popovers, module lists). */
  size?: 'sm' | 'md';
  /**
   * `neutral` renders the same CHIP in gray — for companions that must match this badge's
   * height and radius exactly but are not themselves a commitment (e.g. a "+ 2 more"
   * overflow tag sitting beside one). Extending this component keeps a single definition
   * of the chip's metrics; a hand-matched copy would drift the first time either moved.
   */
  tone?: 'commitment' | 'neutral';
}
const { code, size = 'md', tone = 'commitment' } = Astro.props;
---

<span class:list={['bcn-cbadge', `bcn-cbadge--${size}`, tone === 'neutral' && 'bcn-cbadge--neutral']}>{code}</span>

<style>
  .bcn-cbadge {
    display: inline-block;
    flex-shrink: 0;
    font-family: var(--typography-font-family-mono);
    font-weight: var(--typography-font-weight-semibold);
    color: var(--color-commitment);
    background: color-mix(in srgb, var(--color-commitment) 12%, white);
    border-radius: var(--radius-100);
    white-space: nowrap;
  }
  .bcn-cbadge--md {
    font-size: var(--font-size-100);
    padding: 1px var(--spacing-200);
  }
  .bcn-cbadge--sm {
    font-size: 0.75rem;
    padding: 1px var(--spacing-150);
  }
  /* Same chip, no entity colour — the gray companion. */
  .bcn-cbadge--neutral {
    font-family: var(--typography-font-family-sans);
    color: var(--bcn-gray-700);
    background: var(--bcn-gray-100);
  }
</style>
