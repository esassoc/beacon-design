---
// <BcnSw3Toolbar> — the console for the scan of the file in view, under the step's header
// in one panel (a gray rule between). A sunken tray across the panel, as steps 2 and 3
// carry theirs (bcn-sw-step-nav): Prev at its left end and Next at its right, each a page;
// the scan's keys centered between. Transport first, as on a deck: Scan (start,
// resume, or go on past the check), Pause and Restart. Then the page in view of the file's page count (type a page to go to it),
// and the speed. Beside them, the status's one action when it has one (Review the N so far).
// Below,
// every page of the file in one strip.
//
// The buttons set the run's state, so each one is enabled only when it can act: Scan
// while the run is not reading, Pause while it is, Restart
// once it has begun. The one that matches the run's state reads as pressed.
//
// Speed is the person's choice of how much to watch:
//   One at a time  the run stops after each commitment parses;
//   Slow           slow enough to follow (the default while it learns);
//   Fast           let it rip, and raise only what needs a person.
// In prod speed is how fast the job dispatches page windows, a real control. Every change,
// like pause and resume, is recorded as a steer.
//
// Markup only: the workspace controller (sw3-scan.ts) wires it.
//
// bcn-lego-checked: the transport IS esa-button-group over icon-only esa-buttons (icons
// per lucide-extra.ts where the registry lacks the glyph), the speed IS esa-dropdown-menu
// behind an esa-button, the page is esa-text-field with its prefix and suffix, the strip
// IS bcn-page-scrubber. No esa- lego is a transport over
// a running job; checked Beacon (source-pdf-viewer has page number and zoom only).
// bcn-sw3-toolbar is the home for "the controls of a watched run".
import EsaButton from '@esa/ecology/esa-button.astro';
import BcnPageScrubber from './BcnPageScrubber.astro';

const SPEEDS = [
  { label: 'One at a time', action: 'step' },
  { label: 'Slow', action: 'watch' },
  { label: 'Fast', action: 'run' },
];
---

<div class="bcn-sw3bar" data-sw3-toolbar>
  <div class="bcn-sw3bar__console">
    <span class="bcn-sw3bar__end">
      <EsaButton variant="secondary" size="sm" icon="chevron-left" title="Previous page ([)" data-bar-prev>Prev</EsaButton>
    </span>
    <span class="bcn-sw3bar__keys">
      <esa-button-group class="bcn-sw3bar__transport" aria-label="Scan transport">
        <EsaButton variant="secondary" size="sm" icon="plus" data-ico="scan-text" data-tx="play">Scan</EsaButton>
        <EsaButton variant="secondary" size="sm" icon="plus" data-ico="pause" data-tx="pause">Pause</EsaButton>
        <EsaButton variant="secondary" size="sm" icon="rotate-ccw" data-tx="restart">Restart</EsaButton>
      </esa-button-group>
      <esa-text-field
        class="bcn-sw3bar__page"
        size="sm"
        inputmode="numeric"
        aria-label="Page"
        prefix="p."
        suffix="of 1"
        data-bar-page></esa-text-field>
      <esa-dropdown-menu position="below-start" data-bar-speed data-items={JSON.stringify(SPEEDS)}>
        <EsaButton variant="secondary" size="sm" icon="plus" data-ico="gauge" iconRight="chevron-down" data-bar-speed-btn>Slow</EsaButton>
      </esa-dropdown-menu>
      <p class="bcn-sw3bar__status" data-bar-status role="status" hidden>
        <!-- No readout (text and dot removed 2026-10-14): the keys, the page and the strip say
             where the run is. Only the status's action shows here. -->
        <span class="bcn-sw3bar__status-act" data-bar-status-action></span>
      </p>
    </span>
    <span class="bcn-sw3bar__end bcn-sw3bar__end--next">
      <EsaButton variant="secondary" size="sm" iconRight="chevron-right" title="Next page (])" data-bar-next>Next</EsaButton>
    </span>
  </div>
  <div class="bcn-sw3bar__scrub">
    <BcnPageScrubber label="Pages of the file" />
  </div>
</div>

<style>
  .bcn-sw3bar {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-300);
    padding: var(--spacing-300) var(--spacing-500) var(--spacing-200);
    border-top: 1px solid var(--color-border-default);
  }
  /* The status: only its action, by the keys. */
  .bcn-sw3bar__status {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-200);
    margin: 0;
    min-width: 0;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--color-content-default);
    font-variant-numeric: tabular-nums;
  }
  .bcn-sw3bar__status[hidden] { display: none; }
  .bcn-sw3bar__status-act:empty { display: none; }
  /* The tray: sunken, across the panel, as on steps 2 and 3; Prev at its left end, Next at
     its right, the scan's keys centered between. */
  .bcn-sw3bar__console {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--spacing-200);
    padding: var(--spacing-100);
    background: var(--color-background-elevation-sunken);
    border: 1px solid var(--color-border-default-subtle);
    border-radius: var(--radius-200);
  }
  /* A narrow pane (Aldo expanded beside it) wraps the keys, never spills them. */
  .bcn-sw3bar__keys {
    grid-column: 2;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--spacing-200);
    min-width: 0;
  }
  .bcn-sw3bar__end { grid-row: 1; grid-column: 1; justify-self: start; }
  .bcn-sw3bar__end--next { grid-column: 3; justify-self: end; }
  .bcn-sw3bar :global([data-bar-prev]:disabled),
  .bcn-sw3bar :global([data-bar-next]:disabled) { opacity: 0.38; }
  /* The page in view, of how many: a field as tall as the keys, as wide as its number. */
  .bcn-sw3bar__page {
    width: 7.25rem;
    /* The number sits between "p." and "of 247", not floating in the middle: the field's
       own padding (its private hook, as glyph fields use) is tightened to the keys'. */
    --_field-padding-x: 0.4375rem;
    /* The keys' weight, not the subtle field weight: it reads as live, not disabled. */
    --typography-microcopy-xs-subtle-font-weight: var(--typography-microcopy-xs-font-weight, 500);
    /* One key, in the keys' colors: the affixes are white with the default text and no
       inner rules, so "p. 131 of 247" reads as a single live control. */
    --form-affix-bg: var(--color-background-elevation-raised);
    --form-affix-color: var(--color-content-default);
    --form-affix-border-color: transparent;
    --color-background-field: var(--color-background-elevation-raised);
  }
  /* The state the run is in reads as a pressed key. */
  .bcn-sw3bar :global([data-tx][aria-pressed='true']) {
    background: var(--color-background-elevation-sunken);
    box-shadow: inset 0 1px 3px color-mix(in srgb, var(--color-content-default) 22%, transparent);
  }
  /* The speed menu is dense: the lego has no density hook (a /request-lego candidate), so
     its spacing roles are re-pointed on the host and put back on the trigger. */
  .bcn-sw3bar__console :global(esa-dropdown-menu[data-bar-speed]) {
    --spacing-200: 0.25rem;
    --spacing-300: 0.5rem;
    --dropdown-menu-min-width: 8.5rem;
    --typography-body-md-font-size: 0.8125rem;
    --typography-body-md-line-height: 1.3;
    --typography-body-md-font-weight: var(--typography-font-weight-medium);
  }
  .bcn-sw3bar__console :global([data-bar-speed] > *) {
    --spacing-200: 0.5rem;
    --spacing-300: 0.75rem;
  }
  /* A key that cannot act now is plainly off. */
  .bcn-sw3bar :global([data-tx] button:disabled),
  .bcn-sw3bar :global(button[data-tx]:disabled) { opacity: 0.38; }
  /* A source's details are in view: no file, so nothing to control. */
  .bcn-sw3bar[data-disabled] { opacity: 0.4; }
  .bcn-sw3bar[data-disabled] .bcn-sw3bar__scrub { visibility: hidden; }
</style>

<script>
  import '@esa/ecology/esa-button-group';
  import '@esa/ecology/esa-dropdown-menu';
  import '@esa/ecology/esa-text-field';
</script>
