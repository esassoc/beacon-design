---
// <BcnSw3Toolbar> — the controls of the scan of the file in view, under the step's
// header in one panel (a gray rule between): mark a missed commitment on the left, the
// pace in the middle, the one primary on the right (Let it run, Pause, Resume, or
// Continue when the run has stopped for a check) with the rare actions behind ⋯ (restart
// the scan, download or delete the file). Below them, every page of the file in one strip.
// Where the scan is ("Reading 04_DCP_MMRP_ADA.pdf, p. 16 of 170") is the header's status
// line, not repeated here.
//
// Pace is the person's choice of how much to watch:
//   One at a time  the run stops after each commitment parses;
//   Watch          slow enough to follow (the default while it learns);
//   Full speed     let it rip, and raise only what needs a person.
// In prod pace is how fast the job dispatches page windows, a real control. Every pace
// change, like pause and resume, is recorded as a steer.
//
// Markup only: the workspace controller (sw3-scan.ts) wires it.
//
// bcn-lego-checked: every control is a lego: esa-button (icons per lucide-extra.ts where
// the registry lacks the glyph), esa-button-toggle with per-option icons, esa-dropdown-menu
// behind an esa-icon-button, bcn-page-scrubber for the strip. No esa- lego is a transport
// bar over a running job; checked Beacon (source-pdf-viewer has page number and zoom only).
// bcn-sw3-toolbar is the home for "the controls of a watched run".
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaIconButton from '@esa/ecology/esa-icon-button.astro';
import BcnPageScrubber from './BcnPageScrubber.astro';
import { LUCIDE_EXTRA } from '../../lib/lucide-extra';

const PACES = [
  { value: 'step', label: 'One at a time', icon: LUCIDE_EXTRA['step-forward'] },
  { value: 'watch', label: 'Watch', icon: LUCIDE_EXTRA.eye },
  { value: 'run', label: 'Full speed', icon: LUCIDE_EXTRA['fast-forward'] },
];
const MORE = [
  { label: 'Restart this scan', action: 'restart' },
  { label: 'Download file', action: 'download' },
  { divider: true },
  { label: 'Delete file', action: 'delete', variant: 'danger' },
  { divider: true },
  { label: 'Reset the prototype', action: 'reset' },
];
---

<div class="bcn-sw3bar" data-sw3-toolbar>
  <div class="bcn-sw3bar__row">
    <EsaButton variant="secondary" size="sm" icon="plus" data-ico="square-dashed" data-bar-mark aria-pressed="false">Mark missed</EsaButton>
    <esa-button-toggle class="bcn-sw3bar__pace" size="sm" value="watch" aria-label="Pace" data-bar-pace data-options={JSON.stringify(PACES)}></esa-button-toggle>
    <div class="bcn-sw3bar__end">
      <EsaButton variant="primary" size="sm" icon="plus" data-ico="play" data-bar-toggle>Let it run</EsaButton>
      <esa-dropdown-menu position="below-end" data-bar-more data-items={JSON.stringify(MORE)}>
        <EsaIconButton icon="menu" label="More scan actions" size="sm" data-ico="ellipsis" />
      </esa-dropdown-menu>
    </div>
  </div>
  <div class="bcn-sw3bar__scrub">
    <BcnPageScrubber label="Pages of the file" />
  </div>
</div>

<style>
  .bcn-sw3bar {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-300);
    padding: var(--spacing-300) var(--spacing-500) var(--spacing-200);
    border-top: 1px solid var(--color-border-default);
  }
  .bcn-sw3bar__row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--spacing-300);
  }
  .bcn-sw3bar__row > :global(:first-child) { justify-self: start; }
  .bcn-sw3bar__end {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: var(--spacing-200);
  }
  /* A source's details are in view: no file, so nothing to control. */
  .bcn-sw3bar[data-disabled] { opacity: 0.4; }
  .bcn-sw3bar[data-disabled] .bcn-sw3bar__scrub { visibility: hidden; }
  /* Mark missed is a mode: pressed while the page is a drawing surface. */
  .bcn-sw3bar :global([data-bar-mark][aria-pressed='true']) {
    background: var(--color-background-elevation-sunken);
    border-color: var(--color-content-default);
  }
</style>

<script>
  import '@esa/ecology/esa-button-toggle';
  import '@esa/ecology/esa-dropdown-menu';
</script>
