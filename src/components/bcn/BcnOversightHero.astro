---
// <BcnOversightHero> — the Compliance Dashboard's severity overview band.
//
// A clickable severity-breakdown donut of the CURRENT active set (same
// ACTIVE_OBSERVATIONS backlog as everywhere else on the dashboard, so
// needs-attention/non-compliance counts always match) on the left, a legend
// of the same severities, and two category count lists — Needs Attention and
// Non-Compliance — on the right, in the same top row. EVERY severity is a
// real link: the SVG ring segment AND its legend row both point at
// `${observationsHref}?severity=<severity>`, and the donut's center total links
// to the unfiltered active list.
//
// bcn-lego-checked: NO esa-* chart lego exists anywhere in Ecology (checked the
// full catalog — esa-progress-bar is a single fixed bar, esa-stat/esa-card are
// static blocks, esa-badge/esa-pill are fixed-variant chips); Beacon prod draws
// its dashboard donuts as bespoke SVG too. This generalizes the page-local
// `exec-hero-band-kpis-donut` pattern in prototypes/permit-tracking.astro into a
// reusable component, and upgrades it: a flat conic-gradient div (what both
// permit-tracking and BcnMonitoringStats use) CANNOT carry one click target per
// slice, so the ring here is stacked <circle> strokes (stroke-dasharray =
// percent at r=15.915, circumference ~100) each wrapped in an SVG <a>. The two
// category lists are plain label+count rows (no bar viz — a bar track needs a
// non-inline display that a bare <span> doesn't have by default, which is
// exactly what silently broke it here before; a count list doesn't have that
// failure mode and reads just as clearly at this width). Segment COLORS come
// from semantic token strings (var(--color-background-utility-success) etc) via inline style,
// never hardcoded. bcn-oversight-hero is the reusable home; the shell is
// esa-card.
import EsaCard from '@esa/ecology/esa-card.astro';

interface SeveritySlice {
  severity: string;
  label: string;
  hex: string;
  value: number;
}

interface CategorySlice {
  category: string;
  value: number;
}

interface Props {
  /** Ordered in-compliance, needs-attention, non-compliance. */
  severityBreakdown: SeveritySlice[];
  needsAttentionCategories: CategorySlice[];
  nonComplianceCategories: CategorySlice[];
  /** Target list route, already base-prefixed by the caller. */
  observationsHref: string;
  /** Short label under the donut's center total, e.g. "active". */
  asOfLabel: string;
  title?: string;
}

const {
  severityBreakdown,
  needsAttentionCategories,
  nonComplianceCategories,
  observationsHref,
  asOfLabel,
  title = 'Severity Overview',
} = Astro.props;

// ── Donut geometry. r = 15.915 → circumference ≈ 100, so stroke-dasharray and
// stroke-dashoffset units ARE percentages. Each circle draws the full ring but
// dashes away everything past its own share; the running offset (negative, to
// advance clockwise) slides each share to where the previous one ended.
const sliceTotal = severityBreakdown.reduce((sum, s) => sum + s.value, 0);
let cumulative = 0;
const segments = severityBreakdown.map((slice) => {
  const pct = sliceTotal > 0 ? (slice.value / sliceTotal) * 100 : 0;
  const offset = -cumulative;
  cumulative += pct;
  return {
    ...slice,
    pct,
    dasharray: `${pct.toFixed(3)} ${(100 - pct).toFixed(3)}`,
    dashoffset: offset.toFixed(3),
    share: Math.round(pct),
    href: `${observationsHref}?severity=${encodeURIComponent(slice.severity)}`,
  };
});

---

<EsaCard title={title}>
  <div class="bcn-ohero cluster" data-gap="xl" data-align="start" data-justify="between">
    <!-- ── Clickable severity donut + legend ── -->
    <section class="stack" data-gap="xs">
      <!-- Names the set the donut plots. Must agree with asOfLabel in the donut hole:
           this read "Yesterday's Observations" after the donut moved from a prior-day
           sweep to the current active backlog, so the heading contradicted the data.
           It is now the only thing naming the set — the card's caption, which restated
           it and told the reader to click, came out with `subtitle` on 2026-08-16. -->
      <h4 class="bcn-ohero__section-title typography-title">Active Observations</h4>
      <div class="cluster" data-gap="lg" data-align="center">
        <div class="bcn-ohero__donut">
          <svg class="bcn-ohero__ring" viewBox="0 0 42 42" role="group" aria-label="Active observations by severity">
            <circle
              class="bcn-ohero__track"
              cx="21"
              cy="21"
              r="15.915"
              fill="transparent"
              stroke-width="6"
            ></circle>
            {segments.filter((s) => s.pct > 0).map((s) => (
              <a
                class="bcn-ohero__seg"
                href={s.href}
                aria-label={`${s.label}: ${s.value} (${s.share}%) — open the filtered list`}
              >
                <circle
                  cx="21"
                  cy="21"
                  r="15.915"
                  fill="transparent"
                  stroke-width="6"
                  stroke-dasharray={s.dasharray}
                  stroke-dashoffset={s.dashoffset}
                  style={`stroke: ${s.hex};`}
                >
                  <title>{s.label}: {s.value} ({s.share}%)</title>
                </circle>
              </a>
            ))}
          </svg>
          <a class="bcn-ohero__hole" href={observationsHref}>
            <span class="bcn-ohero__hole-value">{sliceTotal}</span>
            <span class="bcn-ohero__hole-cap typography-meta">{asOfLabel}</span>
          </a>
        </div>

        <ul class="bcn-ohero__legend stack" data-gap="2xs">
          {segments.map((s) => (
            <li>
              <a class="bcn-ohero__legend-row" href={s.href}>
                <span class="bcn-ohero__dot" style={`--_c: ${s.hex};`}></span>
                <span class="bcn-ohero__legend-label typography-body-sm">{s.label}</span>
                <span class="bcn-ohero__legend-value typography-label-xs">{s.value}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ── Two category count lists, by severity ── -->
    <div class="bcn-ohero__breakdowns cluster" data-gap="xl" data-align="start">
      <section class="stack" data-gap="xs">
        <h4 class="bcn-ohero__section-title typography-title">Needs Attention by Category</h4>
        <ul class="bcn-ohero__counts stack" data-gap="2xs">
          {needsAttentionCategories.map((c) => (
            <li class="bcn-ohero__count-row">
              <span class="bcn-ohero__count-label typography-body-sm">{c.category}</span>
              <span class="bcn-ohero__count-value typography-label-xs">{c.value}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="stack" data-gap="xs">
        <h4 class="bcn-ohero__section-title typography-title">Non-Compliance by Category</h4>
        <ul class="bcn-ohero__counts stack" data-gap="2xs">
          {nonComplianceCategories.map((c) => (
            <li class="bcn-ohero__count-row">
              <span class="bcn-ohero__count-label typography-body-sm">{c.category}</span>
              <span class="bcn-ohero__count-value typography-label-xs">{c.value}</span>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </div>
</EsaCard>

<style>
  .bcn-ohero {
    --_donut-size: 168px;
  }
  .bcn-ohero__breakdowns {
    flex: 1 1 26rem;
    min-inline-size: 0;
  }
  /* Shared by the donut's own heading and the two count-list headings — one
     step up from .typography-label-xs so all three sections read with equal weight. */
  .bcn-ohero__section-title {
    margin: 0;
    color: var(--color-content-default);
  }

  /* ── Donut: stacked circle strokes, each an <a>. Color from data (--_c / the
     per-segment inline stroke). ── */
  .bcn-ohero__donut {
    position: relative;
    inline-size: var(--_donut-size);
    block-size: var(--_donut-size);
    flex-shrink: 0;
  }
  .bcn-ohero__ring {
    inline-size: 100%;
    block-size: 100%;
    /* Start the first segment at 12 o'clock, donut-chart convention. */
    transform: rotate(-90deg);
    overflow: visible;
  }
  .bcn-ohero__track {
    stroke: var(--color-background-elevation-sunken);
  }
  .bcn-ohero__seg circle {
    transition: stroke-width 120ms ease-out, opacity 120ms ease-out;
  }
  .bcn-ohero__seg:hover circle,
  .bcn-ohero__seg:focus-visible circle {
    stroke-width: 7.5;
  }
  .bcn-ohero__ring:hover .bcn-ohero__seg:not(:hover) circle {
    opacity: 0.55;
  }
  .bcn-ohero__seg:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring-color);
    outline-offset: var(--focus-ring-offset, 2px);
  }

  /* Center label — the sweep total, linking to the unfiltered active list. */
  .bcn-ohero__hole {
    position: absolute;
    inset: 30px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1px;
    border-radius: var(--radius-full);
    background: var(--color-background-elevation-raised);
    text-decoration: none;
    color: var(--color-content-default);
  }
  .bcn-ohero__hole-value {
    font-family: var(--typography-font-family-display, var(--typography-font-family-sans));
    font-size: var(--font-size-600);
    font-weight: var(--typography-font-weight-bold);
    line-height: 1;
  }
  .bcn-ohero__hole-cap {
    color: var(--color-content-default-tertiary);
  }
  .bcn-ohero__hole:hover .bcn-ohero__hole-value {
    color: var(--color-background-brand-hover);
  }
  .bcn-ohero__hole:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring-color);
    outline-offset: var(--focus-ring-offset, 2px);
  }

  /* ── Legend: each row is the same link as its segment, but a fat target. ── */
  .bcn-ohero__legend {
    list-style: none;
    padding: 0;
    min-inline-size: 0;
  }
  .bcn-ohero__legend-row {
    display: grid;
    grid-template-columns: 10px minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--spacing-200);
    padding: var(--spacing-100) var(--spacing-200);
    border-radius: var(--radius-200);
    text-decoration: none;
    color: var(--color-content-default-secondary);
  }
  .bcn-ohero__legend-row:hover {
    background: var(--color-background-elevation-sunken);
    color: var(--color-content-default);
  }
  .bcn-ohero__legend-row:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring-color);
    outline-offset: var(--focus-ring-offset, 2px);
  }
  .bcn-ohero__dot {
    inline-size: 10px;
    block-size: 10px;
    border-radius: var(--radius-full);
    background: var(--_c);
  }
  .bcn-ohero__legend-label {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .bcn-ohero__legend-value {
    color: var(--color-content-default);
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  /* ── Category counts — a plain label+value list (no bar viz; see the
     header comment for why). ── */
  .bcn-ohero__counts { list-style: none; padding: 0; margin: 0; }
  .bcn-ohero__count-row {
    display: grid;
    grid-template-columns: minmax(6rem, 1fr) auto;
    align-items: baseline;
    gap: var(--spacing-300);
    padding-block: var(--spacing-100);
  }
  .bcn-ohero__count-row + .bcn-ohero__count-row {
    border-top: 1px solid var(--color-border-default-subtle);
  }
  .bcn-ohero__count-label {
    color: var(--color-content-default-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .bcn-ohero__count-value {
    color: var(--color-content-default);
    font-variant-numeric: tabular-nums;
    text-align: right;
  }
</style>
