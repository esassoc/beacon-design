---
// <BcnListCard> — one project list as it sits in a group on the Lists index.
//
// The row is one line: the ENTITY MARK of the registry the list draws from, the
// list's NAME as the only link on it, the member COUNT, and the date the list last
// changed, pushed to the far right and labelled "Updated". A second line appears
// only when the list carries a description, and it is clamped to one.
//
// THE MARK IS THE WIZARD'S, NOT A NEW ONE. The glyph and the accent come from
// LIST_TYPE_MARK, which reads SETUP_STEPS — so a commitment list is marked with the
// same clipboard and the same purple the setup wizard uses for commitments, an
// action list with the wizard's radar and pink, an obligation list with its shield
// and coral. Nothing about the type is re-decided here. The mark is a tinted stroke
// only: no fill, no dot, and never a coloured border on the card, which is a banned
// pattern. It is decorative to assistive tech, because the group heading directly
// above the row already says which registry these lists come from.
//
// THE TYPE NOUN IS GONE FROM THE COUNT. It used to read "44 obligations", which was
// the type mark before the index had groups. The group heading carries the type now,
// so the visible number stands alone and the noun survives only in the badge's
// accessible name, where a screen reader still hears "44 obligations".
//
// EMPTY IS HONEST. A list with no description renders the first line and stops. No
// placeholder sentence is ever substituted for the missing one.
//
// THE ROW IS A GRID ROW WITH A SECOND LINE. Title 14px semibold in the page's own dark
// ink, description and date 12px, 8px of block padding, 2px between the two lines. The
// name is not link-coloured: nineteen green names down a page read as nineteen calls to
// action, so the affordance is the row's hover tint, the pointer, and an underline on
// hover. What this pays is the at-a-glance scannability of a larger title — a reader
// hunting one list by name now reads a denser column — and it is the trade the page
// asked for: nineteen rows the eye can take in at once beats nineteen rows that read
// comfortably four at a time.
//
// Contract with <BcnListIndexBoard>: the root carries `data-list-row` and `data-type`;
// the two searchable strings carry `data-list-text`, which is what the board's keyword
// filter reads and repaints with <mark> hits. The board touches nothing else on it.
//
// bcn-lego-checked: the shell IS esa-card (variant="outlined", padding="compact",
// default slot only, header slot deliberately unfilled — see the note in the style
// block); the mark IS esa-icon fed the wizard's Lucide paths; the count IS
// bcn-sw-count-badge; the rows ARE `.stack` / `.repel` / `.cluster` from
// @esa/tokens/layouts.css and the type is typography composites. Checked Ecology —
// esa-link-column is a nav column of bare links, and esa-card's own `meta` pairs take
// strings, so neither can hold the count badge — and Beacon, whose Lists page is an
// AG Grid rather than a card stack. What this file adds over the legos is the link
// ink, the mark's tint and the one-line clamp.
import EsaCard from '@esa/ecology/esa-card.astro';
import EsaIcon from '@esa/ecology/esa-icon.astro';
import BcnSwCountBadge from './BcnSwCountBadge.astro';
import { LIST_TYPE_MARK, memberCountLabel, type ProjectList } from '../../data/lists';

interface Props {
  list: ProjectList;
  /** Where the name links. */
  href: string;
}
const { list, href } = Astro.props;

const mark = LIST_TYPE_MARK[list.type];
// The badge carries the whole phrase as its accessible name; the visible glyph is the
// number alone.
const countLabel = memberCountLabel(list.type, list.memberCount);
const updated = new Date(`${list.updatedAt}T00:00:00`).toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});
---

<article class="bcn-lc" data-list-row data-type={list.type}>
  <EsaCard variant="outlined" padding="none">
    <div class="bcn-lc__row cluster" data-gap="xs" style={`--_mark: var(--color-${mark.token});`}>
      <span class="bcn-lc__mark">
        <EsaIcon name={mark.iconName} paths={mark.iconPaths} size="sm" />
      </span>
      <div class="bcn-lc__body stack" data-gap="3xs">
        <div class="bcn-lc__head repel" data-gap="sm">
          <div class="cluster" data-gap="2xs">
            <a class="bcn-lc__name typography-label-sm-strong" href={href} data-list-text>
              {list.name}
            </a>
            <BcnSwCountBadge value={list.memberCount} label={countLabel} size="sm" />
          </div>
          <span class="bcn-lc__updated typography-body-xs">Updated {updated}</span>
        </div>
        {
          list.description && (
            <p class="bcn-lc__desc typography-body-xs" data-list-text>
              {list.description}
            </p>
          )
        }
      </div>
    </div>
  </EsaCard>
</article>

<style>
  /* Everything sits in esa-card's DEFAULT slot, and the header slot is left unfilled.
     That is the density decision. A filled header slot is a titled band: 56px min-height,
     1rem block padding and a hairline under it, which turned a one-line row into two
     stacked bands about 135px tall. On an index of nineteen rows that band is the whole
     budget. Leaving the header out drops the card to its body padding and the lego
     renders no header at all (esa-card only emits one for a title, meta, or a filled
     header/actions slot), so there is nothing to override and no empty-body case to
     hide.

     The card takes padding="none" and the ROW pays its own. esa-card sets --_card-padding
     from a class on its own root, so an inherited override cannot reach it and its
     tightest step, "compact", is 12px on all four sides — square, where a row wants more
     inline than block. Zeroing the lego's padding and setting it here is the only way to
     get 8/12 without reaching into the lego's internals. */

  .bcn-lc__row {
    padding: var(--spacing-200) var(--spacing-300);
  }

  .bcn-lc__body {
    flex: 1;
    min-width: 0;
  }

  /* The row is the target, not just the name: the title is dark ink like every other
     word on the page, so the hover tint and the pointer are what say it is clickable.
     Pointer-events stay on the anchor — the tint is a hint, the link is the link. */
  .bcn-lc:hover .bcn-lc__row {
    background: var(--color-background-default-hover);
  }

  /* `--_mark` is set inline from the list's type, the same idiom the Setup Wizard card
     uses for its numerals. The accent is a stroke on white at 3.1:1, which clears the
     3:1 minimum for a graphical object; it is never used for text.

     It is pinned to the NAME's line, not centred on the card: a described row is two
     lines and an undescribed one is a single line, and a mark centred on the card would
     sit at a different height in each — the column would jog as you scan it. The box is
     one line of the name tall, which is the name's own size times the leading token, so
     nothing here is a measured offset. */
  .bcn-lc__mark {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    block-size: calc(var(--font-size-150) * var(--line-height-normal));
    color: var(--_mark);
    flex-shrink: 0;
  }

  .bcn-lc__head {
    align-items: baseline;
  }

  /* Dark ink, not link ink. Nineteen green names stacked down a page read as nineteen
     calls to action; in dark ink they read as nineteen list names, which is what they
     are. The affordance moves to the row hover and the pointer, and the underline still
     appears on hover for anyone who needs the confirmation before they click. */
  .bcn-lc__name {
    color: var(--color-content-default);
    text-decoration: none;
  }

  .bcn-lc__name:hover {
    text-decoration: underline;
  }

  .bcn-lc__name:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring-color);
    outline-offset: var(--focus-ring-offset);
    border-radius: var(--radius-sm);
  }

  .bcn-lc__updated {
    color: var(--color-content-default-tertiary);
    white-space: nowrap;
  }

  /* One line. A list's description is a handle, not a paragraph; the full text is on
     the list's own page. */
  .bcn-lc__desc {
    margin: 0;
    color: var(--color-content-default-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>
