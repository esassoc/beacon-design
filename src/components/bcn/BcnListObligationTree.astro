---
// <BcnListObligationTree> — the body of the obligation-list detail page: everything
// ONE LIST holds, filed the way the registry files it. The documented sibling of
// <BcnSwObligationsTree> (step 5, the registry tree).
//
// The ROW is not a sibling: it is one definition, in src/styles/bcn-tree.css, which
// both components import. They kept their own copies until 2026-09-16 and the copies
// drifted — this one's zebra band pointed at --color-background-default, which mixed
// 50% with white is one value off the panel under it, so the banding read as present
// in the file and as absent on the screen. Panel shell, banding, row rhythm, chevron,
// name, the right-hand verb set and the card padding all come from there now.
//
// What is still this tree's own is the MECHANICS, because the registry tree edits the
// registry and this tree edits the LIST.
//
// Gone, all of it, because filing belongs to the registry and this page cannot change
// it: drag to refile, every drop target, duplicate, unlink, add and remove category,
// add and remove subcategory, add and remove obligation, the editor drawer dispatch,
// the grip handles, and every verb on a requirement row.
//
// What this tree owns instead:
//   - REMOVE FROM LIST on an obligation, guarded by esa-confirm-dialog. Not the danger
//     variant: nothing is destroyed. The member row comes off the list and the
//     obligation stays in the project's registry, and the guard says so by name.
//   - RENAME FOR THIS LIST ONLY on a category or a subcategory. The registry's own
//     wording is kept on the row (data-registry-name) and shown in the obligation
//     panel; clearing a rename restores it. The row itself carries no second name.
//   - MOVE, LIST TITLE and LIST DESCRIPTION per member, and nothing else. Andy,
//     2026-09-23: a list does not "edit" an obligation; it can move it to another
//     category / subcategory and give it its own title and description. All three are
//     written in <BcnListObligationPanel>; the tree applies them on list:obligation-saved.
//     A move into a branch this list does not hold creates the branch; the branch it
//     left drops out when empty. The card keeps a dot when its wording is the list's.
//   - EXPAND TO REQUIREMENTS and COLLAPSE on a branch, step 5's verbs with step 5's
//     glyphs and reach: the row, every branch inside it, and every card's implementation
//     list. One level deeper than the chevron on a subcategory, two on a category.
//
// A list shows only what it holds, so a subcategory whose last obligation is removed
// drops out, and a category whose last subcategory drops out goes with it. Counts
// re-tally off what is visible after every removal and every addition.
//
// Contract with siblings: listens on `document` for `list:members-added` with
// `{ items: AddedItem[] }`, where an item carries everything needed to stamp a card
// without a round trip: id, title, class, description, catId, catName, subId, subName
// and reqs [{ id, code, name }]. An item whose card is present but removed is revealed
// again; an item with no card is stamped from the templates below, creating its
// subcategory and category rows if this list does not hold them yet. New cards flash.
//
// bcn-lego-checked: esa-tree-view is a selection tree with its own row chrome and no
// card leaf; esa-accordion is one level of panels; esa-data-table has no nesting.
// The leaf IS bcn-list-obligation-card, the filter line IS bcn-sw-filter-row, the
// counts ARE bcn-sw-count-badge, the guard IS esa-confirm-dialog, the verbs ARE
// esa-button, the glyphs ARE esa-icon, the tooltips ARE esa-tooltip.
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaIcon from '@esa/ecology/esa-icon.astro';
import BcnSwCountBadge from './BcnSwCountBadge.astro';
import BcnSwFilterRow from './BcnSwFilterRow.astro';
import BcnListObligationCard from './BcnListObligationCard.astro';
import BcnListViewTabs from './BcnListViewTabs.astro';
import BcnCommitmentBadge from './BcnCommitmentBadge.astro';
import { OBLIGATION_CLASS_LABEL, STEP_GLYPH } from '../../data/setup-wizard';
import { COMPONENTS } from '../../data/evidence-drawer';
import { COMMITMENT_TITLES, listTree, type ListObligation, type ObligationList } from '../../data/lists';
// The row anatomy this tree shares, verbatim, with <BcnSwObligationsTree>.
import '../../styles/bcn-tree.css';

interface Props {
  list: ObligationList;
}
const { list } = Astro.props;
const tree = listTree(list);
const categoryOptions = tree.map((c) => ({ label: c.name, value: c.id }));
// In place of the action tree's Status filter: an obligation has no lifecycle, only
// evidence of compliance or none yet (Andy, 2026-09-23). Values match list-impls.ts.
const EVIDENCE_OPTIONS = [
  { value: 'has', label: 'Has Evidence' },
  { value: 'none', label: 'Has No Evidence' },
];

/**
 * The blank card the script clones for an added member. Its first implementation row
 * is the prototype list-impls.ts copies per implementation, so the row has exactly one
 * definition and it lives in BcnListImplementations.
 */
const CARD_STAMP: ListObligation = {
  id: '',
  title: '',
  class: 'adhere',
  phases: [],
  species: [],
  activities: [],
  description: '',
  trigger: '',
  gate: false,
  requirements: [{ id: '', code: '', name: '', text: '', inActions: 0, inObligations: 0 }],
  memberId: '',
  occurrence: 1,
  copies: 1,
  listDescription: '',
  descriptionOverridden: false,
};
---

<!-- The controls are their own surface above the object they act on, the way the
  index puts its filter panel above the list groups and the wizard puts its filter
  row in the step panel above the tree. Inside the tree's own border it would be a
  rounded box inside a rounded box. -->
<div class="stack" data-gap="md">
  <BcnListViewTabs views={[
    { id: 'category', label: 'By Compliance Index' },
    { id: 'commitment', label: 'By commitment' },
    { id: 'az', label: 'A–Z' },
  ]} />
  <BcnSwFilterRow
    searchName="list-search"
    searchPlaceholder="Search obligations"
    panel
    pickers={[
      { label: 'Category', value: 'All categories', options: categoryOptions },
      { label: 'Component', value: 'All components', options: COMPONENTS.map((c) => ({ label: c.name, value: c.id })) },
      { label: 'Evidence', value: 'Any evidence', options: EVIDENCE_OPTIONS },
    ]}
  />
  <div class="bcn-lot__folds">
    <EsaButton variant="ghost" size="xs" data-list-expand>
      <span class="bcn-lot__verb-label"><EsaIcon name="chevrons-up-down" size="xs" paths={STEP_GLYPH['chevrons-up-down']} />Expand all</span>
    </EsaButton>
    <EsaButton variant="ghost" size="xs" data-list-collapse>
      <span class="bcn-lot__verb-label"><EsaIcon name="chevrons-down-up" size="xs" paths={STEP_GLYPH['chevrons-down-up']} />Collapse all</span>
    </EsaButton>
  </div>

  <section
    class="bcn-lot"
    aria-label={list.name}
    data-list-label={list.name}
    data-list-class-labels={JSON.stringify(OBLIGATION_CLASS_LABEL)}
    data-list-titles={JSON.stringify(COMMITMENT_TITLES)}
  >

    <p class="bcn-lot__nomatch" data-list-nomatch hidden>No obligations match.</p>

    <div class="bcn-lot__body" data-list-cats>
      {tree.map((cat) => (
        <details class="bcn-lot__cat" data-list-cat={cat.id} open>
          <summary class="bcn-lot__row bcn-lot__row--cat">
            <span class="bcn-lot__chevron" aria-hidden="true"><EsaIcon name="chevron-right" size="sm" /></span>
            <span class="bcn-lot__name" data-list-name data-list-text={cat.name} data-registry-name={cat.registryName}>{cat.name}</span>
            <span data-list-count="cat"><BcnSwCountBadge value={cat.count} label={`${cat.count} obligations`} /></span>
            <span class="bcn-lot__verbs">
              <esa-tooltip text="Rename for this list"><button type="button" class="bcn-lot__verb bcn-lot__verb--quiet" aria-label="Rename this category for this list" data-list-rename><EsaIcon name="square-pen" size="xs" paths={STEP_GLYPH['square-pen']} /></button></esa-tooltip>
            </span>
          </summary>
          <div class="bcn-lot__subs" data-list-subs>
            {cat.subcategories.map((sub) => (
              <details class="bcn-lot__sub" data-list-sub={sub.id}>
                <summary class="bcn-lot__row bcn-lot__row--sub">
                  <span class="bcn-lot__chevron" aria-hidden="true"><EsaIcon name="chevron-right" size="sm" /></span>
                  <span class="bcn-lot__name" data-list-name data-list-text={sub.name} data-registry-name={sub.registryName}>{sub.name}</span>
                  <span data-list-count="sub"><BcnSwCountBadge value={sub.obligations.length} label={`${sub.obligations.length} obligations`} /></span>
                  <span class="bcn-lot__verbs">
                    <esa-tooltip text="Rename for this list"><button type="button" class="bcn-lot__verb bcn-lot__verb--quiet" aria-label="Rename this subcategory for this list" data-list-rename><EsaIcon name="square-pen" size="xs" paths={STEP_GLYPH['square-pen']} /></button></esa-tooltip>
                    <esa-tooltip text="Expand to implementations"><button type="button" class="bcn-lot__verb bcn-lot__verb--quiet" aria-label="Expand this subcategory to implementations" data-list-branch-expand><EsaIcon name="chevrons-up-down" size="xs" paths={STEP_GLYPH['chevrons-up-down']} /></button></esa-tooltip>
                    <esa-tooltip text="Collapse" align="end"><button type="button" class="bcn-lot__verb bcn-lot__verb--quiet" aria-label="Collapse this subcategory" data-list-branch-collapse><EsaIcon name="chevrons-down-up" size="xs" paths={STEP_GLYPH['chevrons-down-up']} /></button></esa-tooltip>
                  </span>
                </summary>
                <ul class="bcn-lot__cards" data-list-cards>
                  {sub.obligations.map((o) => <BcnListObligationCard obligation={o} />)}
                </ul>
              </details>
            ))}
          </div>
        </details>
      ))}
    </div>

    <!-- The By commitment and A–Z views, rebuilt from the master above (list-views.ts). -->
    <div class="bcn-lot__body" data-list-mirror-body></div>

    <!-- The mirror's two group rows: a permit section, and a commitment inside it. -->
    <template data-list-tpl="section">
      <details class="bcn-lot__cat" data-list-group>
        <summary class="bcn-lot__row bcn-lot__row--cat">
          <span class="bcn-lot__chevron" aria-hidden="true"><EsaIcon name="chevron-right" size="sm" /></span>
          <BcnCommitmentBadge code="COA" size="sm" />
          <span class="bcn-lot__name" data-list-name></span>
          <span data-list-count="group"><BcnSwCountBadge value={0} /></span>
        </summary>
        <div class="bcn-lot__subs" data-list-subs></div>
      </details>
    </template>
    <template data-list-tpl="commitment">
      <details class="bcn-lot__sub" data-list-group>
        <summary class="bcn-lot__row bcn-lot__row--sub">
          <span class="bcn-lot__chevron" aria-hidden="true"><EsaIcon name="chevron-right" size="sm" /></span>
          <BcnCommitmentBadge code="COA" size="sm" />
          <span class="bcn-lot__name" data-list-name></span>
          <span data-list-count="group"><BcnSwCountBadge value={0} /></span>
        </summary>
        <ul class="bcn-lot__cards" data-list-cards></ul>
      </details>
    </template>

    <!-- Stamps for a member added from the picker: its category row, its subcategory
         row, and its card. The card stamp carries implementation rows; the first is the
         prototype for the member's own. -->
    <template data-list-tpl="cat">
      <details class="bcn-lot__cat" open>
        <summary class="bcn-lot__row bcn-lot__row--cat">
          <span class="bcn-lot__chevron" aria-hidden="true"><EsaIcon name="chevron-right" size="sm" /></span>
          <span class="bcn-lot__name" data-list-name></span>
          <span data-list-count="cat"><BcnSwCountBadge value={0} /></span>
          <span class="bcn-lot__verbs">
            <esa-tooltip text="Rename for this list"><button type="button" class="bcn-lot__verb bcn-lot__verb--quiet" aria-label="Rename this category for this list" data-list-rename><EsaIcon name="square-pen" size="xs" paths={STEP_GLYPH['square-pen']} /></button></esa-tooltip>
          </span>
        </summary>
        <div class="bcn-lot__subs" data-list-subs></div>
      </details>
    </template>
    <template data-list-tpl="sub">
      <details class="bcn-lot__sub" open>
        <summary class="bcn-lot__row bcn-lot__row--sub">
          <span class="bcn-lot__chevron" aria-hidden="true"><EsaIcon name="chevron-right" size="sm" /></span>
          <span class="bcn-lot__name" data-list-name></span>
          <span data-list-count="sub"><BcnSwCountBadge value={0} /></span>
          <span class="bcn-lot__verbs">
            <esa-tooltip text="Rename for this list"><button type="button" class="bcn-lot__verb bcn-lot__verb--quiet" aria-label="Rename this subcategory for this list" data-list-rename><EsaIcon name="square-pen" size="xs" paths={STEP_GLYPH['square-pen']} /></button></esa-tooltip>
            <esa-tooltip text="Expand to implementations"><button type="button" class="bcn-lot__verb bcn-lot__verb--quiet" aria-label="Expand this subcategory to implementations" data-list-branch-expand><EsaIcon name="chevrons-up-down" size="xs" paths={STEP_GLYPH['chevrons-up-down']} /></button></esa-tooltip>
            <esa-tooltip text="Collapse" align="end"><button type="button" class="bcn-lot__verb bcn-lot__verb--quiet" aria-label="Collapse this subcategory" data-list-branch-collapse><EsaIcon name="chevrons-down-up" size="xs" paths={STEP_GLYPH['chevrons-down-up']} /></button></esa-tooltip>
          </span>
        </summary>
        <ul class="bcn-lot__cards" data-list-cards></ul>
      </details>
    </template>
    <template data-list-tpl="obl"><BcnListObligationCard obligation={CARD_STAMP} /></template>

    <esa-confirm-dialog
      data-list-confirm
      heading="Remove from this list?"
      confirm-label="Remove"
      cancel-label="Cancel"
      show-close-button
      style="--z-modal: 1500; --z-modal-backdrop: 1450;"></esa-confirm-dialog>
  </section>
</div>

<script>
  import '@esa/ecology/esa-confirm-dialog';
  import '@esa/ecology/esa-tooltip';
  import { buildMirror, foldMirror, initialView, type ListView } from './list-views';
  import { addEvidence, announceImpl, fillImpls, passImpls } from './list-impls';
  import { implementationsOf } from '../../data/list-implementations';

  interface AddedItem {
    id: string;
    title: string;
    class: string;
    description: string;
    catId: string;
    catName: string;
    subId: string;
    subName: string;
    reqs: { id: string; code: string; name: string }[];
  }

  const root = document.querySelector<HTMLElement>('.bcn-lot');
  if (root) {
    const q = <T extends Element>(sel: string, from: ParentNode = root) => from.querySelector<T>(sel);
    const qa = <T extends Element>(sel: string, from: ParentNode = root) => [...from.querySelectorAll<T>(sel)];
    const tpl = (name: string) =>
      (q<HTMLTemplateElement>(`template[data-list-tpl="${name}"]`)!.content.firstElementChild as HTMLElement).cloneNode(true) as HTMLElement;
    const badgeOf = (host: Element | null) => host?.querySelector<HTMLElement>('.bcn-swcb') ?? null;
    const nomatch = q<HTMLElement>('[data-list-nomatch]');
    const listName = root.dataset.listLabel ?? '';
    const CLASS_LABEL: Record<string, string> = JSON.parse(root.dataset.listClassLabels || '{}');

    // A card taken off the list stays in the DOM, marked, so the picker can put it
    // back without a round trip. Marked cards never count and never show.
    const gone = (card: HTMLElement) => card.hasAttribute('data-list-removed');
    // The master's cards only. The By commitment and A–Z views hold clones marked
    // data-list-mirror; a verb on a clone resolves to its master through cardOf.
    const cards = (from: ParentNode = root) => qa<HTMLElement>('[data-list-card]:not([data-list-mirror])', from);
    const cardOf = (el: Element) => {
      const c = el.closest<HTMLElement>('[data-list-card]');
      return c?.hasAttribute('data-list-mirror') ? byMember(c.dataset.memberId ?? '') : c;
    };

    // ---- Views. The category tree is the master; the other two are rebuilt from it.
    const mirrorBody = q<HTMLElement>('[data-list-mirror-body]')!;
    const TITLES: Record<string, string> = JSON.parse(root.dataset.listTitles || '{}');
    let view: ListView = initialView(['category', 'commitment', 'az']);
    root.dataset.listView = view;
    const mirror = () => {
      if (view === 'category') { mirrorBody.replaceChildren(); mirrorBody.removeAttribute('data-built'); return; }
      buildMirror({
        body: mirrorBody,
        source: cards().filter((c) => !gone(c) && !c.hidden && !c.closest('[data-list-cat][hidden]')),
        view,
        stamp: (name) => tpl(name),
        titles: TITLES,
        noun: 'obligations',
      });
    };
    const flash = (el: HTMLElement) => { el.classList.add('is-new'); setTimeout(() => el.classList.remove('is-new'), 1000); };

    // ---- Counts, always off what the list still holds. A branch that holds nothing
    // is marked empty and the stylesheet drops it: a list never shows an empty branch.
    const recount = () => {
      cards().forEach((card) => {
        const n = card.querySelectorAll('[data-list-impl]').length;
        const b = badgeOf(card.querySelector('[data-list-count="obligation"]'));
        if (b) { b.textContent = String(n); b.setAttribute('aria-label', `${n} implementations`); }
      });
      let total = 0;
      qa<HTMLDetailsElement>('[data-list-cat]').forEach((cat) => {
        let catN = 0;
        qa<HTMLDetailsElement>('[data-list-sub]', cat).forEach((sub) => {
          const n = cards(sub).filter((c) => !gone(c)).length;
          catN += n;
          const b = badgeOf(sub.querySelector('[data-list-count="sub"]'));
          if (b) { b.textContent = String(n); b.setAttribute('aria-label', `${n} obligations`); }
          sub.toggleAttribute('data-list-empty', n === 0);
        });
        const b = badgeOf(cat.querySelector('[data-list-count="cat"]'));
        if (b) { b.textContent = String(catN); b.setAttribute('aria-label', `${catN} obligations`); }
        cat.toggleAttribute('data-list-empty', catN === 0);
        total += catN;
      });
      // The page's title-row badge, the step 5 mechanism ([data-swo-count="title"]).
      // Without this a remove or an add leaves the header claiming the seeded count
      // while the tree below it shows another, which is the one disagreement on this
      // page a reader would actually catch.
      const tb = badgeOf(document.querySelector('[data-list-count="title"]'));
      if (tb) { tb.textContent = String(total); tb.setAttribute('aria-label', `${total} obligations`); }
    };

    // ---- Search with <mark> hit highlighting, the step 5 mechanism: every searchable
    // span keeps its own text in data-list-text and the query rewrites it with the
    // hits wrapped.
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    const rx = (needle: string) => new RegExp(needle.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'gi');
    const paint = (el: HTMLElement | null, needle: string) => {
      if (!el || el.classList.contains('is-editing')) return false;
      const text = el.dataset.listText ?? el.textContent ?? '';
      if (!needle) { el.textContent = text; return false; }
      if (!rx(needle).test(text)) { el.textContent = text; return false; }
      el.innerHTML = esc(text).replace(rx(needle), (m) => `<mark class="bcn-lot__hit">${m}</mark>`);
      return true;
    };
    // The description is NOT searched. The card no longer prints it, and a card that
    // appears in the results with nothing on it matching the query is worse than a
    // miss: the reader cannot tell why it is there. Title, class and the component on
    // each implementation are visible on the card, so a hit on any of them shows. A
    // commitment code still finds the obligations carved from it (data-codes).
    const cardHit = (card: HTMLElement, needle: string) => {
      const titleHit = paint(card.querySelector<HTMLElement>('[data-list-title]'), needle);
      const lower = needle.toLowerCase();
      const classHit = !!needle && (card.dataset.class ?? '').toLowerCase().includes(lower);
      const codeHit = !!needle && (card.dataset.codes ?? '').toLowerCase().includes(lower);
      let implHit = false;
      card.querySelectorAll<HTMLElement>('[data-list-impl]').forEach((row) => {
        implHit = paint(row.querySelector<HTMLElement>('.bcn-loc__req-name'), needle) || implHit;
      });
      if (needle && implHit) (card.querySelector('details') as HTMLDetailsElement).open = true;
      return titleHit || classHit || codeHit || implHit;
    };
    // Four filters share one pass: the search text, the category picker, and the
    // component and evidence pickers. A hit at any level keeps that level and
    // everything under it. Component and Evidence narrow each card to the
    // implementations that pass both, and a card left with none drops out. It stands where the action tree's Status
    // filter does: an obligation has no lifecycle to filter by (Andy, 2026-09-23).
    const filters = { needle: '', cat: '', component: '', evidence: '' };
    const apply = () => {
      const { needle, cat, component, evidence } = filters;
      const rowFilter = !!(component || evidence);
      const active = !!(needle || cat || rowFilter);
      let shown = 0;
      qa<HTMLDetailsElement>('[data-list-cat]').forEach((catEl) => {
        if (cat && catEl.dataset.listCat !== cat) { catEl.hidden = true; return; }
        // A branch name only counts as a hit where branches are on screen; in the
        // other views a card kept for its category's name would show no reason why.
        const branchNeedle = view === 'category' ? needle : '';
        const catHit = paint(catEl.querySelector<HTMLElement>(':scope > summary [data-list-name]'), branchNeedle);
        let catAny = false;
        qa<HTMLDetailsElement>('[data-list-sub]', catEl).forEach((sub) => {
          const subHit = paint(sub.querySelector<HTMLElement>(':scope > summary [data-list-name]'), branchNeedle);
          let subAny = false;
          cards(sub).forEach((card) => {
            if (gone(card)) { card.hidden = true; return; }
            const own = cardHit(card, needle); // painted even when the branch above already matched
            const inEvidence = passImpls(card, { component, evidence });
            if (rowFilter && inEvidence) (card.querySelector('details') as HTMLDetailsElement).open = true;
            const hit = (!needle || catHit || subHit || own) && inEvidence;
            card.hidden = !hit;
            if (hit) { shown++; subAny = true; }
          });
          const keep = rowFilter ? subAny : !needle || subHit || subAny;
          sub.hidden = !keep;
          if (active && keep) sub.open = true;
          catAny = catAny || keep;
        });
        const keep = rowFilter ? catAny : !needle || catHit || catAny;
        catEl.hidden = !keep;
        if (active && keep) catEl.open = true;
      });
      if (nomatch) nomatch.hidden = shown > 0 || !active;
      mirror();
    };
    const search = document.querySelector<HTMLElement & { value: string }>('esa-text-field[name="list-search"]');
    if (search) {
      const read = () => search.value ?? search.shadowRoot?.querySelector('input')?.value ?? '';
      const on = () => { filters.needle = read().trim(); apply(); };
      search.addEventListener('input', on);
      search.addEventListener('change', on);
    }
    const catPick = document.querySelector<HTMLElement & { value: string; options: { label: string; value: string }[] }>(
      'esa-select[name="list-search-category"]',
    );
    catPick?.addEventListener('change', () => { filters.cat = catPick.value ?? ''; apply(); });
    const evidencePick = document.querySelector<HTMLElement & { value: string }>('esa-select[name="list-search-evidence"]');
    evidencePick?.addEventListener('change', () => { filters.evidence = evidencePick.value ?? ''; apply(); });
    const componentPick = document.querySelector<HTMLElement & { value: string }>('esa-select[name="list-search-component"]');
    componentPick?.addEventListener('change', () => { filters.component = componentPick.value ?? ''; apply(); });

    // Evidence attached from the bottom drawer raises the count on each chosen
    // member's row for that component, then the mirrors rebuild off the master.
    document.addEventListener('list:evidence-added', (e) => {
      const { componentId, evidenceIds, memberIds } = (e as CustomEvent<{ componentId: string; evidenceIds: string[]; memberIds: string[] }>).detail;
      const n = evidenceIds.length;
      cards().filter((c) => memberIds.includes(c.dataset.memberId ?? '')).forEach((c) => {
        addEvidence(c, componentId, n);
        (c.querySelector('details') as HTMLDetailsElement).open = true;
      });
      recount();
      apply();
    });

    // ---- Expand / collapse. The filter row's pair works both branch levels: open
    // every category and every subcategory, or close them. The implementations stay where
    // the reader left them; they are reference.
    //
    // The per row pair reaches one level deeper, which is the point of it: a branch
    // verb opens the row it sits on, every branch inside that row, and every card's
    // implementation list. On a subcategory that is one level deeper than the chevron;
    // on a category it is two. Same verbs, same glyphs and same reach as step 5.
    const setBranch = (branch: HTMLDetailsElement, open: boolean) => {
      branch.open = open;
      qa<HTMLDetailsElement>('details', branch).forEach((d) => (d.open = open));
    };
    // The filter bar's pair works the category level, as step 5's does: expanded shows
    // every subcategory row and nothing beneath it, collapsed shows only the categories.
    // Each subcategory row's own pair goes the rest of the way down.
    const setCats = (open: boolean) => {
      qa<HTMLDetailsElement>('[data-list-cat]').forEach((c) => (c.open = open));
      qa<HTMLDetailsElement>('[data-list-sub]').forEach((s) => setBranch(s, false));
    };
    const fold = (open: boolean) => (view === 'category' ? setCats(open) : foldMirror(mirrorBody, open));
    document.querySelector('[data-list-expand]')?.addEventListener('click', () => fold(true));
    document.querySelector('[data-list-collapse]')?.addEventListener('click', () => fold(false));
    document.addEventListener('list:view', (e) => {
      view = (e as CustomEvent<ListView>).detail;
      root.dataset.listView = view;
      mirrorBody.removeAttribute('data-built');
      apply();
    });

    // ---- Editing in place. One mechanism, two subjects: a branch name renamed for
    // this list, and an obligation's list description. Focus, select the contents,
    // and commit on Enter, Escape or blur; emptied, each falls back to what the
    // registry says rather than to a placeholder.
    const startEdit = (el: HTMLElement, commit: (text: string) => void) => {
      if (el.isContentEditable) return;
      el.textContent = el.dataset.listText ?? el.textContent ?? '';
      el.contentEditable = 'true';
      el.classList.add('is-editing');
      el.focus();
      const sel = window.getSelection();
      const range = document.createRange();
      range.selectNodeContents(el);
      sel?.removeAllRanges();
      sel?.addRange(range);
      const done = () => {
        el.contentEditable = 'false';
        el.classList.remove('is-editing');
        commit((el.textContent ?? '').replace(/\s+/g, ' ').trim());
        apply();
      };
      el.addEventListener('blur', done, { once: true });
      el.addEventListener('keydown', (ev) => {
        if (ev.key === 'Enter' || ev.key === 'Escape') { ev.preventDefault(); el.blur(); }
      });
    };

    // A renamed row shows the registry's own name beside it, labelled, so the two
    // names are never set side by side for the reader to relate. Renaming a row that
    // was not renamed before is what reveals that secondary.
    const rename = (row: HTMLElement) => {
      const name = row.querySelector<HTMLElement>('[data-list-name]');
      if (!name) return;
      startEdit(name, (text) => {
        const registry = name.dataset.registryName ?? '';
        const next = text || registry;
        name.textContent = next;
        name.dataset.listText = next;
      });
    };

    // ---- Duplicate. A second MEMBERSHIP pointing at the same registry obligation,
    // so one form can ask about one duty twice with different instructions. It is not
    // a filing verb and it does not touch the registry: the copy lands immediately
    // after the row it was made from, inside the same subcategory, because filing is
    // the registry's and this page cannot change it.
    //
    // The new member id continues the obligation's own run rather than counting live
    // cards, so a member removed earlier can never have its id handed to a later copy.
    const nextMemberId = (obligationId: string) => {
      const used = cards()
        .filter((c) => c.dataset.id === obligationId)
        .map((c) => Number((c.dataset.memberId ?? '').split('-m').pop()) || 0);
      return `${obligationId}-m${Math.max(0, ...used) + 1}`;
    };
    const duplicate = (card: HTMLElement) => {
      const copy = card.cloneNode(true) as HTMLElement;
      copy.dataset.memberId = nextMemberId(card.dataset.id ?? '');
      copy.removeAttribute('data-list-removed');
      copy.hidden = false;
      // A duplicate inherits the wording it was copied from — including the "edited"
      // state, because a copy of an edited member IS edited. It is changed from the
      // panel, which is the only place a list description is written.
      card.after(copy);
      recount();
      apply();
      flash(copy);
    };

    // ---- Remove from list. The guard is not the danger variant: nothing is
    // destroyed, the member row comes off and the obligation stays in the registry.
    type Confirm = HTMLElement & { open: boolean; message: string };
    const guard = q<Confirm>('[data-list-confirm]');
    let pending: (() => void) | null = null;
    guard?.addEventListener('confirm', () => { pending?.(); pending = null; });
    guard?.addEventListener('cancel', () => { pending = null; });
    guard?.addEventListener('dismiss', () => { pending = null; });
    const drop = (card: HTMLElement) => {
      card.setAttribute('data-list-removed', '');
      card.hidden = true;
      recount();
      apply();
    };
    const removeFromList = (card: HTMLElement) => {
      if (!guard) { drop(card); return; }
      const title = card.querySelector<HTMLElement>('[data-list-title]')?.dataset.listText ?? '';
      pending = () => drop(card);
      guard.message = `"${title}" comes off ${listName}. The obligation stays in the project's obligation registry.`;
      guard.open = true;
    };

    // ---- Members added from the picker. An item already on the page is revealed
    // again; anything else is stamped, creating its subcategory and its category when
    // this list does not hold them yet.
    //
    // A stamped row is FILED, never appended. OBLIGATION_TREE sorts categories and
    // subcategories by name and obligations by title, all through localeCompare, so the
    // seeded tree is already in that order and a row that landed at the end would be
    // the one row in the tree out of the registry's filing. The comparison runs on the
    // REGISTRY name, not the shown one: a branch this list renamed keeps the registry's
    // slot, which is why "Chemicals and fuels on site" sits between "Fire prevention"
    // and "Refueling and equipment servicing" — it files under "Hazardous materials".
    const filingName = (branch: Element) => {
      const el = branch.querySelector<HTMLElement>('[data-list-name]');
      return el?.dataset.registryName || el?.dataset.listText || el?.textContent || '';
    };
    const file = (parent: Element, row: HTMLElement, sel: string, key: (el: Element) => string) => {
      const name = key(row);
      const after = qa<HTMLElement>(sel, parent).find((s) => key(s).localeCompare(name) > 0);
      parent.insertBefore(row, after ?? null);
    };
    const setBranchName = (branch: HTMLElement, name: string) => {
      const el = branch.querySelector<HTMLElement>('[data-list-name]')!;
      el.textContent = name;
      el.dataset.listText = name;
      el.dataset.registryName = name;
    };
    const buildCard = (item: AddedItem) => {
      const card = tpl('obl');
      card.dataset.id = item.id;
      card.dataset.memberId = nextMemberId(item.id);
      card.dataset.class = item.class;
      const tag = card.querySelector<HTMLElement>('[data-list-class-tag]');
      if (tag) tag.textContent = CLASS_LABEL[item.class] ?? item.class;
      const title = card.querySelector<HTMLElement>('[data-list-title]')!;
      title.textContent = item.title;
      title.dataset.listText = item.title;
      title.dataset.registryTitle = item.title;
      // A member added from the picker starts on the registry's own wording, so the
      // two fields agree and nothing is marked as edited for this list.
      card.dataset.listDescription = item.description;
      card.dataset.registryDesc = item.description;
      const edited = card.querySelector<HTMLElement>('[data-list-edited]');
      if (edited) edited.hidden = true;
      card.dataset.codes = [...new Set(item.reqs.map((r) => r.code))].join('|');
      // The stamp ships implementation rows; the first is the prototype for this member's own.
      fillImpls(card.querySelector<HTMLElement>('[data-list-impls]')!, implementationsOf(item.id));
      return card;
    };
    // The category and subcategory rows for a filing, created (and filed) when this
    // list does not hold them yet. Shared by an add from the picker and a move.
    const branchFor = (catId: string, catName: string, subId: string, subName: string) => {
      let cat = qa<HTMLDetailsElement>('[data-list-cat]').find((c) => c.dataset.listCat === catId) ?? null;
      if (!cat) {
        cat = tpl('cat') as HTMLDetailsElement;
        cat.dataset.listCat = catId;
        setBranchName(cat, catName);
        file(q('[data-list-cats]')!, cat, ':scope > [data-list-cat]', filingName);
        if (catPick) {
          catPick.options = [...(catPick.options ?? []), { label: catName, value: catId }]
            .sort((a, b) => a.label.localeCompare(b.label));
        }
      }
      let sub = qa<HTMLDetailsElement>('[data-list-sub]', cat).find((s) => s.dataset.listSub === subId) ?? null;
      if (!sub) {
        sub = tpl('sub') as HTMLDetailsElement;
        sub.dataset.listSub = subId;
        setBranchName(sub, subName);
        file(cat.querySelector('[data-list-subs]')!, sub, ':scope > [data-list-sub]', filingName);
      }
      return { cat, sub };
    };
    const fileCard = (sub: Element, card: HTMLElement) =>
      file(
        sub.querySelector('[data-list-cards]')!,
        card,
        ':scope > [data-list-card]',
        (el) => el.querySelector<HTMLElement>('[data-list-title]')?.dataset.listText ?? '',
      );
    const addItem = (item: AddedItem) => {
      const existing = cards().find((c) => c.dataset.id === item.id && gone(c));
      if (existing) {
        existing.removeAttribute('data-list-removed');
        existing.hidden = false;
        const sub = existing.closest<HTMLDetailsElement>('[data-list-sub]');
        const cat = existing.closest<HTMLDetailsElement>('[data-list-cat]');
        if (sub) sub.open = true;
        if (cat) cat.open = true;
        flash(existing);
        return;
      }
      const { cat, sub } = branchFor(item.catId, item.catName, item.subId, item.subName);
      const card = buildCard(item);
      fileCard(sub, card);
      cat.open = true;
      sub.open = true;
      flash(card);
    };
    // ---- What the panel sends back. The panel writes the list's own title,
    // description and filing for one member, and asks for the other two verbs rather
    // than doing them, so Remove still routes through this tree's guard and a duplicate is still
    // filed by the same code path as the card's own copy verb.
    const byMember = (id: string) => cards().find((c) => c.dataset.memberId === id) ?? null;
    interface Saved {
      memberId: string; listTitle: string; listDescription: string;
      catId: string; catName: string; subId: string; subName: string;
    }
    document.addEventListener('list:obligation-saved', (e) => {
      const s = (e as CustomEvent<Saved>).detail;
      const card = byMember(s.memberId);
      if (!card) return;
      // Emptied, a field falls back to the registry's wording — which is also what
      // makes the pair of attributes agree again, and the mark below go away.
      const registry = card.dataset.registryDesc ?? '';
      card.dataset.listDescription = s.listDescription || registry;
      const title = card.querySelector<HTMLElement>('[data-list-title]')!;
      const registryTitle = title.dataset.registryTitle ?? title.dataset.listText ?? '';
      const nextTitle = s.listTitle || registryTitle;
      title.dataset.listText = nextTitle;
      title.textContent = nextTitle;
      const mark = card.querySelector<HTMLElement>('[data-list-edited]');
      if (mark) mark.hidden = card.dataset.listDescription === registry && nextTitle === registryTitle;
      // The move. Re-filed by title even when it stays put, since a new title changes
      // its place in the subcategory's A-Z.
      if (s.catId && s.subId) {
        const { cat, sub } = branchFor(s.catId, s.catName, s.subId, s.subName);
        fileCard(sub, card);
        cat.open = true;
        (sub as HTMLDetailsElement).open = true;
      }
      recount();
      apply();
      flash(card);
    });
    document.addEventListener('list:remove-member', (e) => {
      const card = byMember((e as CustomEvent<string>).detail);
      if (card) removeFromList(card);
    });
    document.addEventListener('list:duplicate-member', (e) => {
      const card = byMember((e as CustomEvent<string>).detail);
      if (card) duplicate(card);
    });

    document.addEventListener('list:members-added', (e) => {
      const items = (e as CustomEvent<{ items: AddedItem[] }>).detail?.items ?? [];
      items.forEach(addItem);
      recount();
      apply();
    });

    // ---- Verbs. Seven of them on the whole tree: open a branch to its implementations,
    // close it again, rename a branch for this list, open a membership in the panel,
    // duplicate one, take one off the list, and open one implementation.
    root.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('.is-editing')) { e.preventDefault(); return; }
      const btn = t.closest<HTMLElement>('button');
      if (btn?.matches('[data-list-branch-expand], [data-list-branch-collapse]')) {
        e.preventDefault();
        setBranch(btn.closest<HTMLDetailsElement>('details')!, btn.matches('[data-list-branch-expand]'));
        return;
      }
      if (btn?.matches('[data-list-rename]')) {
        e.preventDefault();
        rename(btn.closest('summary')!);
        return;
      }
      if (btn?.matches('[data-list-edit]')) {
        e.preventDefault();
        const card = cardOf(btn)!;
        document.dispatchEvent(new CustomEvent('list:edit-obligation', { detail: card.dataset.memberId, bubbles: true }));
        return;
      }
      if (btn?.matches('[data-list-duplicate]')) {
        e.preventDefault();
        duplicate(cardOf(btn)!);
        return;
      }
      if (btn?.matches('[data-list-remove]')) {
        e.preventDefault();
        removeFromList(cardOf(btn)!);
        return;
      }
      // An implementation row is the way into its upsert dialog. The whole row is the
      // target — the name is the button, the row forwards to it.
      const impl = t.closest<HTMLElement>('[data-list-impl]');
      if (impl) {
        e.preventDefault();
        announceImpl(impl);
        return;
      }
    });

    recount();
    if (view !== 'category') apply();
  }
</script>

<style>
  /* The row anatomy — panel shell, zebra banding, rows, chevron, name, the right-hand
     verb set and the card padding — is ONE definition in src/styles/bcn-tree.css,
     shared verbatim with <BcnSwObligationsTree>. What stays scoped here is what only
     the list tree has: the registry's own name beside a renamed row, and the
     empty-branch rule that keeps a list to what it holds.

     VERBS ON A BRANCH ROW — a list-tree-only departure, made in the markup so the
     wizard keeps its own behaviour. Deep expand/collapse is a SUBCATEGORY verb here:
     a subcategory holds obligations, so "expand to implementations" has a definite
     meaning on it. A category holds subcategories, so the same pair on a category row
     was a second, louder way to do what its own chevron already does. The pair that
     remains carries `--quiet`, like the rename beside it, so a branch row rests as
     chevron / name / count and answers on hover or keyboard focus. */
  /* Expand/Collapse all sit under the filter panel, right-aligned, not inside it. */
  .bcn-lot__folds { display: flex; justify-content: flex-end; gap: var(--spacing-200); }
  .bcn-lot__verb-label { display: inline-flex; align-items: center; gap: var(--spacing-100); }

  /* A list shows only what it holds: a branch holding no member drops out. */
  .bcn-lot__cat[data-list-empty], .bcn-lot__sub[data-list-empty] { display: none; }

  .bcn-lot__row:focus-visible { outline: 2px solid var(--color-obligation); outline-offset: -2px; }
</style>
