---
// <BcnListIndexBoard> — the Lists index: every list a project keeps, filed under the
// registry it draws from. A keyword search across all of them, then three groups, in
// the order setup fills them: Commitments, Actions, Obligations.
//
// WHAT THIS SECTION SACRIFICED. Completeness of arrangement. There is one axis and it
// is the registry, so the index cannot be read by recency across all nineteen lists any
// more, and there is no second facet — no type picker, no owner, no date range. What it
// buys is that the type is structural rather than something the reader infers from a
// row, and that each group carries its own verb: the button that makes a commitment
// list sits on the commitments heading, so the type of the new list is chosen by which
// button was pressed rather than inside the dialog.
//
// THE SEARCH IS THE WIZARD'S. Same control (bcn-sw-filter-row), same behaviour as step
// 5's obligations search: type and the rows narrow live, every hit wrapped in <mark>.
// It reads a list's NAME and its DESCRIPTION, the two strings a row shows, so what is
// searched is exactly what is on screen.
//
// A GROUP WITH NO HITS KEEPS ITS HEADING AND ITS VERB, and puts a dashed box where its
// rows were. This reverses an earlier cut that hid the whole group: hiding it also hid
// the add button that rides its heading, so a search — the exact moment a reader has
// discovered the list they want does not exist — was the one moment they could not start
// it. The page also stopped holding still; three headings became one and the eye had to
// re-find the surface on every keystroke. What it costs is the thing that cut bought:
// two "no lists match" boxes now sit around one surviving row, and the answer is less
// concentrated than it was.
//
// ORDER INSIDE A GROUP is newest change first — `listsOfType` filters PROJECT_LISTS,
// which is already sorted that way, and this board never re-sorts it.
//
// EVERY NUMBER COUNTS ITSELF. A heading's badge is the length of its own group, so a
// seed added to src/data/lists.ts moves the heading without anyone editing this file,
// and while a search is running the badge counts the HITS — a heading reading 12 over
// two visible rows is a heading telling the reader something untrue. The badge beside a
// heading counts LISTS and the badge on a row counts that list's MEMBERS; the two are
// told apart by their accessible names ("4 commitment lists" vs "64 commitments"), which
// is why both carry one and why the script rewrites the label along with the number.
//
// ONE EMPTY BOX PER GROUP, AND ITS WORDS ARE SETTLED AT BUILD TIME. A group that holds
// lists can only ever be emptied by a search, so its box reads "No lists match". A group
// that holds none is empty whether or not anything was typed, so its box reads "No
// commitment lists" and keeps saying that through a search, which is still true. Nothing
// rewrites a string at runtime; the script only shows and hides.
//
// HREFS. Every row links to /prototypes/lists/<id>, the one detail route that serves
// obligation, action and commitment lists alike.
//
// Contract with siblings: each row is a <BcnListCard> and carries `data-list-row`, with
// its searchable strings marked `data-list-text`. Each heading's button carries
// `data-list-create="<type>"`, which is <BcnListCreateDialog>'s trigger hook — the
// attribute's VALUE is the type the dialog opens preset to. The page carries no script
// for any of it.
//
// bcn-lego-checked: the search row IS bcn-sw-filter-row (the step-5 control, in its new
// page-level `panel` presentation, which is permit tracking's filter-bar surface), the
// headings' verbs ARE esa-button with its own `icon` prop feeding esa-icon's registered
// "plus", the empty copy IS esa-empty-state, the stacks and heading rows ARE `.stack` /
// `.repel` / `.cluster` from @esa/tokens/layouts.css, the counts ARE bcn-sw-count-badge
// at its `sm` cut and the rows ARE bcn-list-card. Checked Ecology for a grouped-index
// lego — esa-filter-container pairs a filter bar with an AG Grid, which this index
// deliberately is not, and esa-card's header slot is a titled band too tall to use as a
// group heading — and Beacon, whose Lists page is that grid plus an info callout, and
// the callout is cut. The one thing esa-empty-state does NOT carry is the dashed box
// Andy asked for: it is a centred column with padding and no border and no minimum
// height, so the box is this file's, and the lego sits inside it.
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaEmptyState from '@esa/ecology/esa-empty-state.astro';
import BcnListCard from './BcnListCard.astro';
import BcnSwCountBadge from './BcnSwCountBadge.astro';
import BcnSwFilterRow from './BcnSwFilterRow.astro';
import {
  LIST_GROUP_LABEL,
  LIST_GROUP_ORDER,
  LIST_TYPE_LABEL,
  addListLabel,
  listCountLabel,
  listsOfType,
  type ListType,
  type ProjectList,
} from '../../data/lists';
import { withBase } from '../../lib/base';

// Every list type has its detail page now (2026-09-23): one route, three bodies.
const hrefFor = (list: ProjectList): string => withBase(`/prototypes/lists/${list.id}`);

const GROUPS = LIST_GROUP_ORDER.map((type: ListType) => ({
  type,
  label: LIST_GROUP_LABEL[type],
  // "commitment list" — the singular the badge's accessible name is rebuilt from when a
  // search changes the number it reports.
  noun: LIST_TYPE_LABEL[type].toLowerCase(),
  lists: listsOfType(type),
}));
---

<div class="stack" data-gap="lg" data-list-index>
  <BcnSwFilterRow panel searchPlaceholder="Search lists" searchName="lists-search" />

  <div class="stack" data-gap="2xl">
    {
      GROUPS.map((group) => (
        <section
          class="stack"
          data-gap="sm"
          aria-labelledby={`lists-${group.type}`}
          data-list-group={group.type}
          data-list-noun={group.noun}
        >
          <div class="bcn-lib__head repel" data-gap="sm">
            <div class="cluster" data-gap="xs">
              <h2 class="bcn-lib__title typography-title-strong" id={`lists-${group.type}`}>
                {group.label}
              </h2>
              <BcnSwCountBadge
                value={group.lists.length}
                label={listCountLabel(group.type, group.lists.length)}
                data-group-count
                data-total={group.lists.length}
              />
            </div>
            <EsaButton
              variant="ghost"
              appearance="outline"
              size="sm"
              icon="plus"
              data-list-create={group.type}
            >
              {addListLabel(group.type)}
            </EsaButton>
          </div>

          <div class="stack" data-gap="xs">
            {group.lists.map((list) => (
              <BcnListCard list={list} href={hrefFor(list)} />
            ))}
            <div class="bcn-lib__empty" data-group-empty hidden={group.lists.length > 0}>
              <EsaEmptyState
                title={group.lists.length > 0 ? 'No lists match' : `No ${group.noun}s`}
                size="sm"
              />
            </div>
          </div>
        </section>
      ))
    }
  </div>
</div>

<script>
  // Keyword search across all three groups. Lifted from the setup wizard's obligations
  // tree so the two behave identically: the query narrows what is shown and every hit is
  // repainted with a <mark>, live on each keystroke.
  const root = document.querySelector<HTMLElement>('[data-list-index]');
  if (root) {
    const qa = <T extends HTMLElement>(sel: string, scope: ParentNode = root): T[] =>
      Array.from(scope.querySelectorAll<T>(sel));

    const esc = (s: string) =>
      s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    const rx = (needle: string) => new RegExp(needle.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'gi');

    // Every searchable string is plain text between queries, so textContent is always the
    // original: a <mark> is inline and contributes its own text back. No copy is kept.
    const paint = (el: HTMLElement, needle: string): boolean => {
      const text = el.textContent ?? '';
      if (!needle || !rx(needle).test(text)) {
        el.textContent = text;
        return false;
      }
      el.innerHTML = esc(text).replace(rx(needle), (m) => `<mark class="bcn-lib__hit">${m}</mark>`);
      return true;
    };

    const apply = (needle: string) => {
      qa<HTMLElement>('[data-list-group]').forEach((group) => {
        let shown = 0;
        qa<HTMLElement>('[data-list-row]', group).forEach((row) => {
          // Both strings are repainted on every pass whatever the first one returned —
          // a hit on the name must not leave a stale <mark> in the description.
          let hit = !needle;
          qa<HTMLElement>('[data-list-text]', row).forEach((el) => {
            hit = paint(el, needle) || hit;
          });
          row.hidden = !hit;
          if (hit) shown++;
        });
        // The heading and its add button never move. Only the rows go, and the box that
        // stands in their place has its wording already — see the note at the top.
        const empty = group.querySelector<HTMLElement>('[data-group-empty]');
        if (empty) empty.hidden = shown > 0;

        const badge = group.querySelector<HTMLElement>('[data-group-count]');
        if (badge) {
          const n = needle ? shown : Number(badge.dataset.total ?? 0);
          const noun = group.dataset.listNoun ?? '';
          badge.textContent = String(n);
          badge.setAttribute('aria-label', `${n} ${noun}${n === 1 ? '' : 's'}`);
        }
      });
    };

    const search = document.querySelector<HTMLElement & { value: string }>(
      'esa-text-field[name="lists-search"]',
    );
    if (search) {
      const read = () => search.value ?? search.shadowRoot?.querySelector('input')?.value ?? '';
      const on = () => apply(read().trim());
      search.addEventListener('input', on);
      search.addEventListener('change', on);
    }
  }
</script>

<style>
  /* Composition glue only: the heading row is a .repel, and this is the hairline that
     separates a group's verb row from its rows. */
  .bcn-lib__head {
    align-items: baseline;
    padding-block-end: var(--spacing-200);
    border-block-end: 1px solid var(--color-border-default-subtle);
  }

  .bcn-lib__title {
    margin: 0;
    color: var(--color-content-default);
  }

  /* The box that stands where a group's rows were. esa-empty-state centres its own
     column but carries no border and no minimum height, so both are here: a dashed rule
     says "nothing is filed here" without drawing a card that looks like a row, and the
     floor keeps the group from collapsing to a heading and a line of text as you type —
     the three headings hold their positions through a search, which is the whole point
     of keeping them. Radius matches the filter panel above, not the rows: this is a
     container standing in for a stack, not one more row. */
  .bcn-lib__empty {
    display: grid;
    place-items: center;
    min-block-size: 88px;
    border: 1px dashed var(--color-border-default);
    border-radius: var(--radius-200);
  }

  /* `display: grid` above is an author rule and outranks the user agent's
     `[hidden] { display: none }`, so without this the box renders while `hidden` is
     set. The rows do not need it — a row is a plain <article> with no display rule. */
  .bcn-lib__empty[hidden] {
    display: none;
  }

  /* The hit mark, same yellow as the setup wizard's — there is no highlight token in
     @esa/tokens, and a search on two surfaces of the same product that highlights in two
     colours is worse than one hard-coded hex in each.

     `:global` is load-bearing, not tidiness. The <mark> is injected by the script above,
     at runtime, into a SIBLING component's row, so it carries neither this component's
     scope attribute nor that one's. Astro sometimes leaves a class like this unscoped on
     its own — the wizard's identical rule ships global — but it scoped this one, and the
     measured result was a browser-default pure-yellow highlight. Declared global, it is
     not a coin flip. */
  :global(mark.bcn-lib__hit) {
    background: #fff176;
    color: inherit;
    border-radius: 2px;
    padding: 0 1px;
  }
</style>
