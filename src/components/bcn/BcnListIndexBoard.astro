---
// <BcnListIndexBoard> — the Lists index: every list a project keeps, filed under the
// registry it draws from. Three groups, in the order setup fills them: Commitments,
// Actions, Obligations.
//
// WHAT THIS SECTION SACRIFICED. Completeness of arrangement. There is one axis and it
// is the registry, so the index cannot be read by recency across all nineteen lists any
// more, and there is no search field and no second filter. What it buys is that the
// type is now structural rather than something the reader has to infer from a row, and
// that each group carries its own verb: the button that makes a commitment list sits
// on the commitments heading, so the type of the new list is chosen by which button was
// pressed rather than inside the dialog.
//
// ORDER INSIDE A GROUP is newest change first — `listsOfType` filters PROJECT_LISTS,
// which is already sorted that way, and this board never re-sorts it.
//
// EVERY NUMBER COUNTS ITSELF. A heading's badge is the length of its own group, so a
// seed added to src/data/lists.ts moves the heading without anyone editing this file.
// The badge beside a heading counts LISTS and the badge on a row counts that list's
// MEMBERS; the two are told apart by their accessible names ("4 commitment lists" vs
// "64 commitments"), which is why both carry one.
//
// AN EMPTY GROUP KEEPS ITS HEADING. The heading is where the add verb lives, so hiding
// the group would hide the only way to make the first list of that type. The rows are
// replaced by an empty state; the heading and its button stay.
//
// HREFS. Obligation lists have a detail page on this branch. Action and commitment
// lists link to "#" on purpose: those detail pages are prod's and out of scope here,
// so the row is present and findable while the destination stays unbuilt.
//
// Contract with siblings: each row is a <BcnListCard>. Each heading's button carries
// `data-list-create="<type>"`, which is <BcnListCreateDialog>'s trigger hook — the
// attribute's VALUE is the type the dialog opens preset to. The page carries no script
// for any of it.
//
// bcn-lego-checked: the headings' verbs ARE esa-button, the empty IS esa-empty-state,
// the stacks and heading rows ARE `.stack` / `.repel` / `.cluster` from
// @esa/tokens/layouts.css, the counts ARE bcn-sw-count-badge and the rows ARE
// bcn-list-card. Checked Ecology for a grouped-index lego — esa-filter-container pairs
// a filter bar with an AG Grid, which this index deliberately is not, and esa-card's
// header slot is a titled band too tall to use as a group heading — and Beacon, whose
// Lists page is that grid plus an info callout, and the callout is cut.
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaEmptyState from '@esa/ecology/esa-empty-state.astro';
import BcnListCard from './BcnListCard.astro';
import BcnSwCountBadge from './BcnSwCountBadge.astro';
import {
  LIST_GROUP_LABEL,
  LIST_GROUP_ORDER,
  LIST_TYPE_LABEL,
  addListLabel,
  listCountLabel,
  listsOfType,
  type ListType,
  type ProjectList,
} from '../../data/lists';
import { withBase } from '../../lib/base';

const hrefFor = (list: ProjectList): string =>
  list.type === 'obligation' ? withBase(`/prototypes/lists/${list.id}`) : '#';

const GROUPS = LIST_GROUP_ORDER.map((type: ListType) => ({
  type,
  label: LIST_GROUP_LABEL[type],
  lists: listsOfType(type),
}));
---

<div class="stack" data-gap="xl" data-list-index>
  {
    GROUPS.map((group) => (
      <section class="stack" data-gap="sm" aria-labelledby={`lists-${group.type}`}>
        <div class="bcn-lib__head repel" data-gap="sm">
          <div class="cluster" data-gap="xs">
            <h2 class="bcn-lib__title typography-title-strong" id={`lists-${group.type}`}>
              {group.label}
            </h2>
            <BcnSwCountBadge
              value={group.lists.length}
              label={listCountLabel(group.type, group.lists.length)}
            />
          </div>
          <EsaButton variant="ghost" appearance="outline" size="sm" data-list-create={group.type}>
            {addListLabel(group.type)}
          </EsaButton>
        </div>

        <div class="stack" data-gap="sm">
          {group.lists.length > 0 ? (
            group.lists.map((list) => <BcnListCard list={list} href={hrefFor(list)} />)
          ) : (
            <EsaEmptyState title={`No ${LIST_TYPE_LABEL[group.type].toLowerCase()}s`} size="sm" />
          )}
        </div>
      </section>
    ))
  }
</div>

<style>
  /* Composition glue only: the heading row is a .repel, and this is the hairline that
     separates a group's verb row from its rows. */
  .bcn-lib__head {
    align-items: baseline;
    padding-block-end: var(--spacing-200);
    border-block-end: 1px solid var(--color-border-default-subtle);
  }

  .bcn-lib__title {
    margin: 0;
    color: var(--color-content-default);
  }
</style>
