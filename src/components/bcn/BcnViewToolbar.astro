---
// <BcnViewToolbar> — the one filter band a view panel carries, flush under its header (2026-10-28, Andy: "Why does the
// documents and deliverables have their filters below the chrome, but schedule and budget above?" and "Why are the ui
// elements different for filters on all four tabs"). Every plan view uses it, in the same place, with the same
// controls: what narrows the list on the left (the search first, then the facets), what shapes or acts on it on the
// right (the count, a pivot, Export). "Anything that narrows goes left, anything that acts goes right" (BcnFilterBar's
// rule, Beacon's grid header), on one row instead of BcnFilterBar's two bands: a panel header is above it already.
//
// One control height, 32px, and one text size, 14px, whatever the lego: the search is esa-text-field (mark it
// data-vtb-search for the band's width), facets are esa-filter-dropdown at sm, a pivot is esa-button-toggle at sm.
//
//   <BcnViewToolbar>
//     <esa-text-field data-vtb-search size="sm" placeholder="Search Documents" ...></esa-text-field>
//     <esa-filter-dropdown size="sm" label="Type" ...></esa-filter-dropdown>
//     <span slot="end" class="typography-body-sm">25 Documents</span>
//     <EsaButton slot="end" ...>Export</EsaButton>
//   </BcnViewToolbar>
//
// bcn-lego-checked: the row of facets IS esa-filter-container; every control in it is the host's lego. BcnFilterBar is
// the carded two-band bar for a page's data surface; this is its single band for a surface that already has a header
// (the plan page's view panel). No esa- lego is a one-row toolbar with a right-hand end. bcn-view-toolbar is the
// reusable home; the CSS is the row and the 32px control height (BcnFilterBar's compact technique).
import FilterContainer from '@esa/ecology/esa-filter-container.astro';
---

<div class="bcn-vtb">
  <div class="bcn-vtb__narrow">
    <FilterContainer><slot /></FilterContainer>
  </div>
  {
    Astro.slots.has('end') && (
      <div class="bcn-vtb__end">
        <slot name="end" />
      </div>
    )
  }
</div>

<style>
  .bcn-vtb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-300) var(--spacing-400);
    padding: var(--spacing-300) var(--spacing-400);
    border-block-end: 1px solid var(--color-border-default);
    background: var(--color-background-elevation-raised);
    /* One text size in the band, 14px, for every lego's microcopy. */
    --typography-microcopy-md-font-size: 14px;
    --typography-microcopy-md-strong-font-size: 14px;
    --typography-microcopy-md-subtle-font-size: 14px;
  }
  .bcn-vtb :global([hidden]) {
    display: none !important;
  }
  .bcn-vtb__narrow {
    flex: 1 1 auto;
    min-inline-size: 0;
  }
  .bcn-vtb__end {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-300);
    margin-inline-start: auto;
    white-space: nowrap;
    color: var(--color-content-default-secondary);
  }
  /* The search: the same width on every view. */
  .bcn-vtb :global([data-vtb-search]) {
    inline-size: 16rem;
  }
  /* 32px controls, from each lego's own padding hook (BcnFilterBar's compact technique). */
  .bcn-vtb :global(esa-text-field) {
    --_field-padding-y: calc((32px - 1.3em) / 2 - var(--form-border-width, 1px));
  }
  .bcn-vtb :global(esa-button-toggle) {
    --_icon-size: 14px;
    --_pad-y: calc((26px - max(1lh, 14px)) / 2);
  }
</style>
