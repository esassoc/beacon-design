---
// <BcnListIndexBranchPanel> — rename a category or subcategory for one Compliance Index
// VERSION (Andy, 2026-10-19: "rename its cat/sub-cat"). Opened from the pen on the row in
// <BcnListIndexTree>; never inline, because names are edited in a side panel.
//
// One field, the name this list uses, and beneath it, read only, where the branch comes
// from in the project's Compliance Index: "Category › Subcategory" for each canonical
// subcategory it draws on (indexSources). An emptied name falls back to the first one's
// canonical name, the way an emptied list title falls back to the index's. The name is
// the version's alone: the canonical index and every other version keep theirs.
//
// Contract with <BcnListIndexTree>, on `document`:
//   in   list:rename-index-branch   detail: { level: 'cat' | 'sub', id }
//   out  list:index-branch-renamed  detail: { id, name }
//
// bcn-lego-checked: the frame IS esa-side-dialog at a compact width (one field), the field IS esa-text-field, the buttons ARE esa-button; the
// labels and footer split are bcn-obligation-drawer.css, shared with the list panels.
import EsaButton from '@esa/ecology/esa-button.astro';
import { indexSources, type ComplianceIndexList } from '../../data/lists';
import '../../styles/bcn-obligation-drawer.css';

interface Props {
  list: ComplianceIndexList;
}
const { list } = Astro.props;
const sources = indexSources(list);
---

<esa-side-dialog
  id="lib-editor"
  heading="Rename for this list"
  position="right"
  show-close-button
  style="--_width: min(480px, 94vw); --z-modal: 1300; --z-modal-backdrop: 1250;"
>
  <form class="bcn-swo-edit bcn-lib" data-index-branch-panel data-lib-data={JSON.stringify(sources)}>
    <esa-text-field label="Name" size="sm" name="lib-name"></esa-text-field>

    <div class="bcn-swo-edit__section">
      <span class="bcn-swo-edit__label">In the Compliance Index</span>
      <ul class="bcn-lib__sources" data-lib-sources></ul>
    </div>
  </form>

  <span slot="footer" class="bcn-swo-edit__foot bcn-swo-edit__foot--end">
    <span class="bcn-swo-edit__foot-right">
      <EsaButton variant="primary" size="sm" data-lib-save>Save</EsaButton>
      <EsaButton variant="ghost" size="sm" data-lib-cancel>Cancel</EsaButton>
    </span>
  </span>
</esa-side-dialog>

<script>
  import '@esa/ecology/esa-side-dialog';
  import '@esa/ecology/esa-text-field';

  type Source = { category: string; subcategory: string };
  type Field = HTMLElement & { value: string };

  const form = document.querySelector<HTMLFormElement>('[data-index-branch-panel]');
  if (form) {
    const dialog = document.querySelector<HTMLElement & { open: boolean; heading: string }>('#lib-editor')!;
    const field = form.querySelector<Field>('esa-text-field[name="lib-name"]')!;
    const host = form.querySelector<HTMLElement>('[data-lib-sources]')!;
    const sources = JSON.parse(form.dataset.libData || '{}') as Record<string, Source[]>;
    let target: { level: 'cat' | 'sub'; id: string; fallback: string } | null = null;

    document.addEventListener('list:rename-index-branch', (e) => {
      const { level, id } = (e as CustomEvent<{ level: 'cat' | 'sub'; id: string }>).detail;
      const row = document.querySelector<HTMLElement>(`[data-index-${level}="${CSS.escape(id)}"] > summary [data-list-name]`);
      const from = sources[id] ?? [];
      // A category lists the canonical categories its subcategories come from, once each.
      const lines = level === 'cat'
        ? [...new Set(from.map((s) => s.category))]
        : from.map((s) => `${s.category} › ${s.subcategory}`);
      const fallback = (level === 'cat' ? from[0]?.category : from[0]?.subcategory) ?? row?.dataset.listText ?? '';
      target = { level, id, fallback };
      dialog.heading = level === 'cat' ? 'Rename category for this list' : 'Rename subcategory for this list';
      field.value = row?.dataset.listText ?? '';
      field.setAttribute('help-text', `Leave this empty and the list uses “${fallback}”.`);
      host.replaceChildren(...lines.map((text) => Object.assign(document.createElement('li'), { textContent: text })));
      dialog.open = true;
    });

    const close = () => {
      dialog.open = false;
      setTimeout(() => { target = null; field.value = ''; }, 200);
    };
    form.addEventListener('submit', (e) => e.preventDefault());
    document.querySelector('[data-lib-save]')?.addEventListener('click', () => {
      if (!target) return;
      const name = (field.value ?? '').replace(/\s+/g, ' ').trim() || target.fallback;
      document.dispatchEvent(new CustomEvent('list:index-branch-renamed', { detail: { id: target.id, name }, bubbles: true }));
      close();
    });
    document.querySelector('[data-lib-cancel]')?.addEventListener('click', close);
  }
</script>

<style>
  /* Read only: where this branch comes from, one line per canonical branch. */
  .bcn-lib__sources {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-100);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-content-default);
  }
</style>
