---
// <BcnPlanGantt> — the plan's Gantt chart: a port of Beacon's `ui-viz-gantt` (shared/ui/components/ui-viz-gantt on
// origin/develop, Jamie Quishenberry, BCN-1652). An indented outline of rows beside a timeline plot of bars, roll-up
// brackets and milestone diamonds, with dependency arrows, planned-window bands, scheduled cut-off rules, landmark
// lines with header tags, a today line, a pointer readout, collapse, selection and edit-mode drag. Domain-free like
// hers: it takes pre-flattened rows / links / landmarks; the page maps a plan onto them (planGanttView).
//
// The runtime is plan-gantt-chart.ts (PlanGanttChart). This file is the persistent frame, the EsaButton shells the
// runtime clones (EsaButton is compile-time, so the caret and the drop's Apply / Revert are pre-rendered here), and
// the stylesheet — Jamie's ui-viz-gantt.component.scss, token for token. Her SCSS tokens map to the spoke's
// semantic layer as: surface → elevation-raised, text / text-muted / text-subtle → content-default / -secondary /
// -tertiary, border-subtle / border / border-strong → border-default-subtle / -default / -strong, brand-solid(-hover)
// → background-brand(-hover), brand-surface → background-brand-subtle, brand-border / brand-text → border-brand /
// content-brand, warning-solid(-hover) / danger-solid(-hover) → background-utility-warning / -danger(-hover),
// warning-text → content-utility-warning, surface-hover → background-default-hover, $shadow-150 → --shadow-100.
// APPROXIMATION: accent-surface (her shift+click selection tint) has no spoke token; it is mixed from
// --color-background-accent over the surface.
//
// The markup is built at runtime (innerHTML), so every rule below is :global() under the host class.
//
// bcn-lego-checked: no esa- lego draws a Gantt / timeline plot (checked the catalog: no chart, no timeline, no
// tree-grid); checked Beacon (ui-viz-gantt — this is its port; the spoke's BcnWorkBreakdown is the fish prototype
// it was adapted FROM and has a different, CSS-grid geometry). The caret, Apply and Revert are EsaButtons; the
// readout panel is ui-viz-tip's chrome. bcn-plan-gantt is the reusable home.
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaBadge from '@esa/ecology/esa-badge.astro';

interface Props {
  /** The accessible-name prefix for the plot's role="img". */
  label: string;
  /** A hook the page's controller finds this instance by. */
  id?: string;
}

const { label, id } = Astro.props;
---

<div class="bcn-plan-gantt-host" id={id} data-bcn-plan-gantt data-label={label}>
  <div class="bcn-plan-gantt" hidden></div>
  <!-- A quiet row marker (new design: "Scheduled", and "Unsaved changes" visible only to its author); the runtime sets its text. -->
  <template data-gantt-tpl="badge"><EsaBadge value="Unsaved changes" variant="secondary" size="sm" /></template>
  <template data-gantt-tpl="caret"><EsaButton variant="ghost" iconOnly icon="chevron-down" label="Collapse" size="xs" /></template>
  <template data-gantt-tpl="apply"><EsaButton variant="primary" iconOnly icon="check" label="Apply change" size="sm" /></template>
  <template data-gantt-tpl="revert"><EsaButton variant="ghost" iconOnly icon="undo-2" label="Revert change" size="sm" data-fill-icon="undo-2" /></template>
</div>

<style>
  .bcn-plan-gantt-host {
    /* `contain: inline-size` requires a block container, so the explicit display matters. */
    display: block;
    position: relative;
    min-inline-size: 0;
    contain: inline-size;
    /* --bcn-plan-gantt-surface: the consumer's hook for the chart's surface (a draft takes a whisper of its hue). */
    --_s: var(--bcn-plan-gantt-surface, var(--color-background-elevation-raised));
    --_text: var(--color-content-default);
    --_muted: var(--color-content-default-secondary);
    --_subtle: var(--color-content-default-tertiary);
    --_b-subtle: var(--color-border-default-subtle);
    --_b: var(--color-border-default);
    --_b-strong: var(--color-border-default-strong);
    --_brand: var(--color-background-brand);
    --_brand-hover: var(--color-background-brand-hover);
    --_brand-surface: var(--color-background-brand-subtle);
    --_brand-border: var(--color-border-brand);
    --_brand-text: var(--color-content-brand);
    --_warn: var(--color-background-utility-warning);
    --_warn-hover: var(--color-background-utility-warning-hover);
    --_warn-text: var(--color-content-utility-warning);
    --_danger: var(--color-background-utility-danger);
    --_danger-hover: var(--color-background-utility-danger-hover);
    /* An overrun's edge (new): its own colour a step darker. The utility -hover steps don't do that evenly (warning's
       is lighter than its fill), so each is its fill mixed a fifth of the way toward the text colour. */
    --_warn-edge: color-mix(in srgb, var(--_warn) 80%, var(--_text));
    --_danger-edge: color-mix(in srgb, var(--_danger) 80%, var(--_text));
    --_accent: var(--color-background-accent);
    --_accent-surface: color-mix(in srgb, var(--color-background-accent) 14%, var(--_s));
    /* Beacon's $type-size-meta (0.8125rem); the spoke's font sizes are fluid, Beacon's are fixed. */
    --_meta: 0.8125rem;
    --_indent: var(--spacing-400);
    /* The caret's slot (the xs icon button). A leaf's spacer takes the same width, so each level's name steps in by
       exactly --_indent from its parent's (2026-10-28: leaves sat under their parent's name, the spacer a half caret). */
    --_caret: 2rem;
    /* The Budget column's width: a compact figure ("$2.4M") with room to breathe. */
    --_budget-w: 3.75rem;
  }

  /* THE FRAME: the one scroller. --bcn-plan-gantt-max-height is the consumer hook (ui-viz-gantt's
     --ui-viz-gantt-max-height): set it and the frame scrolls vertically too, so the axis sticks. */
  .bcn-plan-gantt-host :global(.bcn-plan-gantt) {
    overflow: auto;
    max-block-size: var(--bcn-plan-gantt-max-height, none);
    border: 1px solid var(--_b);
    border-radius: var(--radius-md);
    background: var(--_s);
  }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt[hidden]) { display: none; }

  .bcn-plan-gantt-host :global(.bcn-plan-gantt__canvas) {
    position: relative;
    display: grid;
    inline-size: max-content;
    min-inline-size: 100%;
  }

  .bcn-plan-gantt-host :global(.bcn-plan-gantt__corner),
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__axis) {
    position: sticky;
    inset-block-start: 0;
    background: var(--_s);
    border-block-end: 1px solid var(--_b);
    box-sizing: border-box;
  }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__corner) {
    inset-inline-start: 0;
    z-index: 3;
    display: flex;
    align-items: flex-end;
    padding: var(--spacing-200) var(--spacing-300);
    border-inline-end: 1px solid var(--_b);
    font-size: var(--font-size-100);
    font-weight: 600;
    color: var(--_subtle);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  /* --bcn-plan-gantt-plot-surface: the consumer's hook for the timeline side alone (the plot and its axis), leaving the
     outline as it is — a draft tints just its working area. */
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__axis) { z-index: 2; overflow: hidden; background: var(--bcn-plan-gantt-plot-surface, var(--_s)); }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__plot) { background: var(--bcn-plan-gantt-plot-surface, transparent); }

  .bcn-plan-gantt-host :global(.bcn-plan-gantt__year) {
    position: absolute;
    inset-block: 0;
    display: flex;
    align-items: flex-end;
    padding-block-end: var(--spacing-100);
    box-shadow: inset 1px 0 0 var(--_b-subtle);
  }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__year--emphasis) { box-shadow: inset 1px 0 0 var(--_b-strong); }
  /* Zoomed (new): a year cut by the window's left edge has no gridline there; with finer ticks the year moves up. */
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__year--clipped) { box-shadow: none; }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__year--top) { align-items: flex-start; padding-block: var(--spacing-050) 0; }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__tick) {
    position: absolute;
    inset-block-start: 50%;
    display: flex;
    align-items: flex-end;
    padding-block-end: var(--spacing-100);
    box-shadow: inset 1px 0 0 var(--_b-subtle);
  }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__tick-label) {
    padding-inline-start: var(--spacing-100);
    font-size: var(--_meta);
    color: var(--_subtle);
    line-height: 1;
    white-space: nowrap;
  }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__year-label) {
    padding-inline-start: var(--spacing-100);
    font-size: var(--_meta);
    font-variant-numeric: tabular-nums;
    color: var(--_subtle);
    line-height: 1;
  }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__year--emphasis .bcn-plan-gantt__year-label) { color: var(--_muted); font-weight: 600; }

  .bcn-plan-gantt-host :global(.bcn-plan-gantt__today) {
    position: absolute;
    inset-block: 0;
    background: var(--_warn);
    pointer-events: none;
  }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__today-flag) {
    position: absolute;
    inset-block-start: var(--spacing-050);
    inset-inline-start: var(--spacing-100);
    font-size: var(--font-size-100);
    font-weight: 600;
    color: var(--_warn-text);
    white-space: nowrap;
    line-height: 1;
  }

  .bcn-plan-gantt-host :global(.bcn-plan-gantt__landmarks) { position: absolute; inset-inline: 0; inset-block-end: 0; }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__landmark-tag) {
    position: absolute;
    box-sizing: border-box;
    transform: translateX(-50%);
    padding: 1px var(--spacing-100);
    border: 1px solid var(--_brand-border);
    border-radius: var(--radius-sm);
    background: var(--_s);
    font-size: var(--_meta);
    font-weight: 600;
    line-height: 1;
    color: var(--_brand-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ── The outline ── */
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__outline) {
    position: sticky;
    inset-inline-start: 0;
    z-index: 1;
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--_s);
    border-inline-end: 1px solid var(--_b);
    min-inline-size: 0;
  }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__item) {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--spacing-150);
    box-sizing: border-box;
    padding-inline: calc(var(--spacing-200) + var(--bcn-plan-gantt-depth, 0) * var(--_indent)) var(--spacing-200);
    border-block-end: 1px solid var(--_b-subtle);
    min-inline-size: 0;
    /* An explicit surface, so the row actions laid over the Budget column (background: inherit) cover it. */
    background: var(--_s);
  }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__item--tier-0) { background: color-mix(in srgb, var(--_text) 3%, var(--_s)); }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__item--tier-1) { background: color-mix(in srgb, var(--_text) 1.5%, var(--_s)); }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__item:hover) { background: var(--color-background-default-hover); }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__item--selected),
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__item--selected:hover) { background: var(--_brand-surface); }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__item--picked),
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__item--picked:hover) { background: var(--_accent-surface); }

  .bcn-plan-gantt-host :global(.bcn-plan-gantt__caret) { flex-shrink: 0; }
  /* Points down when expanded, rotates to point right when collapsed. */
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__caret svg) { transition: transform 120ms ease; }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__caret[aria-expanded='false'] svg) { transform: rotate(-90deg); }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__caret) { inline-size: var(--_caret); }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__caret-spacer) { flex-shrink: 0; inline-size: var(--_caret); }

  .bcn-plan-gantt-host :global(.bcn-plan-gantt__schedule-summary) {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* The row's selection control, reset to read exactly as the plain text it replaced. */
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__select) {
    display: flex;
    flex: 1 1 auto;
    align-items: center;
    gap: var(--spacing-150);
    align-self: stretch;
    min-inline-size: 0;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: var(--radius-sm);
    background: none;
    font: inherit;
    color: inherit;
    text-align: start;
    cursor: pointer;
  }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__select:hover .bcn-plan-gantt__name) { text-decoration: underline; }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__select:focus-visible) {
    /* Inset, so the ring stays inside the 28px row rather than under its neighbours. */
    outline: var(--focus-ring-width) solid var(--focus-ring-color);
    outline-offset: calc(-1 * var(--focus-ring-width));
  }

  /* The caller's row controls: revealed by OPACITY only, so they never leave the tab order. */
  /* Revealed over the END OF THE NAME, just left of the Budget column, rather than holding their own room: hidden, they
     take no width from the name, and the budget figure stays in view (new, 2026-10-21). They carry the row's own
     background, so the name's tail reads as tucked under them. */
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__actions) {
    position: absolute;
    inset-block: 0;
    inset-inline-end: calc(var(--spacing-200) + var(--_budget-w) + var(--spacing-150));
    display: flex;
    align-items: center;
    gap: var(--spacing-100);
    padding-inline-start: var(--spacing-200);
    background: inherit;
    opacity: 0;
    transition: opacity 120ms ease;
  }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__actions:has([aria-expanded='true'])),
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__actions:has([open])),
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__item:hover .bcn-plan-gantt__actions),
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__item:focus-within .bcn-plan-gantt__actions),
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__item--selected .bcn-plan-gantt__actions) { opacity: 1; }
  @media (hover: none) {
    .bcn-plan-gantt-host :global(.bcn-plan-gantt__actions) { opacity: 1; }
  }

  /* The level tag reads as a quiet prefix, the name as the content: the tag a step lighter than her secondary grey, the
     name in the body colour at medium weight (parents keep their semibold). */
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__tag) {
    flex-shrink: 0;
    font-size: var(--_meta);
    font-weight: 400;
    color: var(--_subtle);
    white-space: nowrap;
  }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__badge) { flex-shrink: 0; }
  /* The Budget column (new, 2026-10-21): pinned to the outline's right edge, after the row actions, so the figures line
     up down the column under the corner's "Budget"; a compact figure keeps it narrow without crowding the name. */
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__budget) {
    flex: 0 0 var(--_budget-w);
    margin-inline-start: auto;
    font-size: var(--_meta);
    font-variant-numeric: tabular-nums;
    color: var(--_muted);
    text-align: end;
    white-space: nowrap;
  }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__item--tier-0 .bcn-plan-gantt__budget),
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__item--tier-1 .bcn-plan-gantt__budget) { color: var(--_text); }
  /* A draft's Change column: the shift, bold where the planner moved it, regular where a cascade did. */
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__delta) { color: var(--_muted); }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__delta--own) { color: var(--_text); font-weight: 600; }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__corner-heading) { flex: 1 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  /* The corner is inset a step more than a row; the heading reaches back so it sits over the column's figures. */
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__corner-budget) {
    flex: 0 0 var(--_budget-w);
    margin-inline-end: calc(var(--spacing-200) - var(--spacing-300));
    text-align: end;
  }
  /* A milestone row (new): the chart's diamond, in its colour, centred in the caret's place left of the tag. */
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__caret-spacer) { display: inline-flex; align-items: center; justify-content: center; }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__milestone-icon) { fill: var(--_brand); stroke: var(--_brand-hover); stroke-width: 1; }
  /* The name takes only its own width, so a row marker sits right after it. */
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__name) {
    flex: 0 1 auto;
    min-inline-size: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: var(--font-size-150);
    font-weight: 500;
    color: var(--_text);
  }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__item--tier-0 .bcn-plan-gantt__name),
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__item--tier-1 .bcn-plan-gantt__name) { font-weight: 600; }
  /* The search's hits in the names (2026-10-27): the house highlighter yellow (the work breakdown's and the setup
     wizard's), tight to the letters. */
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__match) {
    background: var(--bcn-marker-selection);
    color: inherit;
  }

  /* ── The plot ── */
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__plot) { display: block; }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__band--tier-0) { fill: color-mix(in srgb, var(--_text) 3%, transparent); }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__band--tier-1) { fill: color-mix(in srgb, var(--_text) 1.5%, transparent); }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__selected) { fill: var(--_brand-surface); }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__grid) { stroke: var(--_b-subtle); stroke-width: 1; }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__grid--emphasis) { stroke: var(--_b); }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__grid--minor) { stroke: var(--_b-subtle); stroke-dasharray: 2 3; }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__rule) { stroke: var(--_b-subtle); stroke-width: 1; }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__landmark) {
    stroke: color-mix(in srgb, var(--_brand) 35%, transparent);
    stroke-width: 1;
    stroke-dasharray: 4 4;
  }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__landmark-hit) { fill: transparent; }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__today-line) { fill: var(--_warn); }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__bar) { fill: var(--_brand); stroke: var(--_brand-hover); stroke-width: 1; }
  /* EXPERIMENT (2026-10-20): a parent's roll-up bracket is the children's teal, lightening one step per level outward
     — the deepest parent (nearest its bars) strongest, the program lightest — in place of her greys. */
  /* EXPERIMENT (2026-10-21): no edge on any parent bracket (hers carried a grey one on the top two tiers, for weight
     only), so every tier reads alike and differs only in teal depth and height. The end ticks and an overrun's are
     the bracket's own fill colour; an end in the overrun takes its amber, or red past a Scheduled window. */
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__summary--tier-0),
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__summary-tick--tier-0) { fill: color-mix(in srgb, var(--_brand) 30%, transparent); }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__summary--tier-1),
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__summary-tick--tier-1) { fill: color-mix(in srgb, var(--_brand) 50%, transparent); }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__summary--tier-2),
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__summary-tick--tier-2) { fill: color-mix(in srgb, var(--_brand) 72%, transparent); }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__summary-tick--overrun) { fill: var(--_warn); }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__summary-tick--overrun-scheduled) { fill: var(--_danger); }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__summary-tick) { stroke: none; }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__milestone) { fill: var(--_brand); stroke: var(--_brand-hover); stroke-width: 1; }
  /* EXPERIMENT (2026-10-21): the planned window reads a little more strongly than her 6% fill / default border, so the
     box a parent's bracket should sit in is visible at a glance without going heavy. */
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__window) {
    fill: color-mix(in srgb, var(--_text) 7%, transparent);
    stroke: var(--_b-strong);
    stroke-width: 1;
  }
  /* An overrun carries its own edge, a darker step of its colour, over the bar's teal or grey one; a borderless
     sub-study bracket's overrun stays borderless. */
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__overrun) { fill: var(--_warn); stroke: var(--_warn-edge); stroke-width: 1; }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__overrun--scheduled) { fill: var(--_danger); stroke: var(--_danger-edge); }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__overrun--borderless) { stroke: none; }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__milestone--overrun) { fill: var(--_warn); stroke: var(--_warn-hover); }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__milestone--overrun-scheduled) { fill: var(--_danger); stroke: var(--_danger-hover); }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__cutoff) { fill: var(--_muted); }
  /* A Scheduled (fixed) planned window is outlined a step darker; an Estimated one keeps the strong border grey, still
     clearly visible. */
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__window:not(.bcn-plan-gantt__window--estimated)) { stroke: var(--_subtle); }


  /* The outline's divider (new): drag, arrow keys or double-click to reset. A wide transparent grip over the outline's
     right border, showing a brand line while hovered, focused or dragged. */
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__splitter) {
    position: absolute;
    inset-block: 0;
    z-index: 4;
    inline-size: 9px;
    margin-inline-start: -5px;
    cursor: col-resize;
    touch-action: none;
  }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__splitter[hidden]) { display: none; }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__splitter)::after {
    content: '';
    position: absolute;
    inset-block: 0;
    inset-inline-start: 4px;
    inline-size: 2px;
    background: transparent;
    transition: background 120ms ease;
  }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__splitter:hover)::after,
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__splitter--dragging)::after,
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__splitter:focus-visible)::after { background: var(--_brand); }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__splitter:focus-visible) { outline: none; }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__link) { pointer-events: none; }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__link-line) { fill: none; stroke: var(--_subtle); stroke-width: 1; }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__link-head) { fill: var(--_subtle); }
  /* A selectable dependency (new, 2026-10-27): a 12px invisible hit line along the route; hovered, the line darkens. */
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__link-hit) { fill: none; stroke: transparent; stroke-width: 12; pointer-events: stroke; cursor: pointer; }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__link--hovered .bcn-plan-gantt__link-line) { stroke: var(--_text); stroke-width: 2; }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__link--hovered .bcn-plan-gantt__link-head) { fill: var(--_text); }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__hit) { fill: transparent; cursor: pointer; }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__mark--hovered) { filter: brightness(1.08); }

  /* ── Edit mode ── */
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__picked) { fill: var(--_accent-surface); }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__mark--picked .bcn-plan-gantt__bar),
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__mark--picked .bcn-plan-gantt__summary),
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__mark--picked .bcn-plan-gantt__milestone) { stroke: var(--_accent); stroke-width: 2; }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__mark--previewed) { opacity: 0.4; }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__window-edit) { pointer-events: none; }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__window-edit-band) { fill: none; stroke: var(--_brand); stroke-width: 1; stroke-dasharray: 3 2; }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__window-handle) { fill: var(--_brand); }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__ghost) {
    fill: color-mix(in srgb, var(--_brand) 35%, transparent);
    stroke: var(--_brand);
    stroke-width: 1;
    stroke-dasharray: 3 2;
    pointer-events: none;
  }
  /* ── Tactile density (new, 2026-10-26, the repo-model prototype): marks you want to grab ──
     Revised 2026-10-27 (Andy: the bezel was "so out of place"): no hard ledge, no lit band, no darkened edge. A bar is
     the brand teal as a gentle vertical gradient (the top a few percent lighter, the bottom a step deeper), resting on
     one soft, low shadow. Hovered it rises 2px and the shadow widens; pressed it settles; carried (the drag ghost) it
     floats highest while the original it left fades. Motion is cut under prefers-reduced-motion. */
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__fill-top) { stop-color: color-mix(in srgb, var(--_brand) 86%, white); }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__fill-bottom) { stop-color: color-mix(in srgb, var(--_brand) 92%, black); }
  .bcn-plan-gantt-host[data-feel='tactile'] :global(.bcn-plan-gantt__mark) {
    filter: drop-shadow(0 1px 2px rgb(0 0 0 / 0.1));
    transition: transform 160ms cubic-bezier(0.2, 0.8, 0.2, 1), filter 160ms ease;
  }
  .bcn-plan-gantt-host[data-feel='tactile'] :global(.bcn-plan-gantt__mark--hovered) {
    transform: translateY(-2px);
    filter: drop-shadow(0 4px 6px rgb(0 0 0 / 0.14));
  }
  .bcn-plan-gantt-host[data-feel='tactile'] :global(.bcn-plan-gantt__mark--pressed) {
    transform: translateY(0);
    filter: brightness(0.97) drop-shadow(0 1px 1px rgb(0 0 0 / 0.12));
    transition-duration: 60ms;
  }
  .bcn-plan-gantt-host[data-feel='tactile'] :global(.bcn-plan-gantt__mark--previewed) { opacity: 0.25; filter: none; transform: none; }
  .bcn-plan-gantt-host[data-feel='tactile'] :global(.bcn-plan-gantt__bar) { stroke: none; }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__bar-grip) {
    stroke: rgb(255 255 255 / 0.6);
    stroke-width: 1.25;
    stroke-linecap: round;
    pointer-events: none;
    opacity: 0;
    transition: opacity 160ms ease;
  }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__mark--hovered .bcn-plan-gantt__bar-grip),
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__mark--pressed .bcn-plan-gantt__bar-grip) { opacity: 1; }
  .bcn-plan-gantt-host[data-feel='tactile'] :global(.bcn-plan-gantt__ghost) {
    stroke: none;
    stroke-dasharray: none;
    rx: 7px;
    filter: drop-shadow(0 10px 14px rgb(0 0 0 / 0.2));
    transform: translateY(-4px);
  }
  .bcn-plan-gantt-host[data-density='tactile'] :global(.bcn-plan-gantt__name) { font-size: var(--font-size-200, 0.9375rem); }
  /* ── Study variants (2026-10-27): set by the page from its URL, one data attribute each ── */

  /* Levels: how Program, Study, Sub-study, Task and Milestone differ. Default (equal): Jamie's, every row a level word
     and a name at one size. ladder: no level words (the indent and the header say it); weight and colour step down
     from Program to Task. sections: the ladder, plus Programs and Studies read as section heads on a grey band. */
  .bcn-plan-gantt-host[data-levels='ladder'] :global(.bcn-plan-gantt__tag),
  .bcn-plan-gantt-host[data-levels='sections'] :global(.bcn-plan-gantt__tag) { display: none; }
  .bcn-plan-gantt-host[data-levels='ladder'] :global(li[aria-level='1'] .bcn-plan-gantt__name),
  .bcn-plan-gantt-host[data-levels='sections'] :global(li[aria-level='1'] .bcn-plan-gantt__name) { font-weight: 650; color: var(--_text); }
  .bcn-plan-gantt-host[data-levels='ladder'] :global(li[aria-level='2'] .bcn-plan-gantt__name),
  .bcn-plan-gantt-host[data-levels='sections'] :global(li[aria-level='2'] .bcn-plan-gantt__name) { font-weight: 600; color: var(--_text); }
  .bcn-plan-gantt-host[data-levels='ladder'] :global(li[aria-level='3'] .bcn-plan-gantt__name),
  .bcn-plan-gantt-host[data-levels='sections'] :global(li[aria-level='3'] .bcn-plan-gantt__name) { font-weight: 550; color: var(--_muted); }
  .bcn-plan-gantt-host[data-levels='ladder'] :global(li[aria-level='4'] .bcn-plan-gantt__name),
  .bcn-plan-gantt-host[data-levels='sections'] :global(li[aria-level='4'] .bcn-plan-gantt__name) { font-weight: 450; color: var(--_text); }
  /* rules: the ladder, plus only Tasks and Milestones look movable (parents lose the lift and shadow and read as flat
     brackets), and parents' budgets step back to grey. */
  .bcn-plan-gantt-host[data-levels='rules'] :global(.bcn-plan-gantt__tag) { display: none; }
  .bcn-plan-gantt-host[data-levels='rules'] :global(li[aria-level='1'] .bcn-plan-gantt__name) { font-weight: 650; color: var(--_text); }
  .bcn-plan-gantt-host[data-levels='rules'] :global(li[aria-level='2'] .bcn-plan-gantt__name) { font-weight: 600; color: var(--_text); }
  .bcn-plan-gantt-host[data-levels='rules'] :global(li[aria-level='3'] .bcn-plan-gantt__name) { font-weight: 550; color: var(--_muted); }
  .bcn-plan-gantt-host[data-levels='rules'] :global(li[aria-level='4'] .bcn-plan-gantt__name) { font-weight: 450; color: var(--_text); }
  .bcn-plan-gantt-host[data-levels='rules'] :global(li:not([aria-level='4']) .bcn-plan-gantt__budget) { color: var(--_subtle); font-weight: 400; }
  /* budget=off (the levels study): the Budget column leaves the outline; the readout and About still carry it. */
  .bcn-plan-gantt-host[data-budget='off'] :global(.bcn-plan-gantt__budget),
  .bcn-plan-gantt-host[data-budget='off'] :global(.bcn-plan-gantt__corner-budget) { display: none; }
  .bcn-plan-gantt-host[data-levels='rules'] :global(.bcn-plan-gantt__mark:has(.bcn-plan-gantt__summary)) { filter: none; transform: none; }
  .bcn-plan-gantt-host[data-levels='sections'] :global(li[aria-level='1']),
  .bcn-plan-gantt-host[data-levels='sections'] :global(li[aria-level='2']) { background: var(--color-background-elevation-sunken); }
  .bcn-plan-gantt-host[data-levels='sections'] :global(.bcn-plan-gantt__band--tier-0),
  .bcn-plan-gantt-host[data-levels='sections'] :global(.bcn-plan-gantt__band--tier-1) { fill: var(--color-background-elevation-sunken); }

  /* Scheduled: what a fixed date looks like. Default: Jamie's square corners only. pin: a white pin at the bar's start.
     caps: a dark cap at each end, a stake in the ground. tentative: Estimated bars go light and dashed; Scheduled stay
     solid, so firm reads as the strong form. */
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__sched-pin),
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__sched-cap) { display: none; pointer-events: none; }
  .bcn-plan-gantt-host[data-sched='pin'] :global(.bcn-plan-gantt__sched-pin) { display: inline; fill: var(--color-background-elevation-raised); stroke: var(--_text); stroke-width: 1.5; }
  .bcn-plan-gantt-host[data-sched='caps'] :global(.bcn-plan-gantt__sched-cap) { display: inline; fill: var(--_text); }
  .bcn-plan-gantt-host[data-sched='tentative'] :global(.bcn-plan-gantt__mark:not(.bcn-plan-gantt__mark--scheduled) .bcn-plan-gantt__bar) {
    fill-opacity: 0.4;
    stroke: var(--_brand);
    stroke-width: 1.25;
    stroke-dasharray: 4 3;
  }

  /* Cascade preview: what a drag will move, before the drop. spotlight: everything else fades. outline: the chain gets
     a dark ring and its links darken. rows: the chain's outline rows tint and its bars lift with the one you hold. */
  .bcn-plan-gantt-host[data-cascade='spotlight'] :global(.bcn-plan-gantt__plot--chaining .bcn-plan-gantt__mark:not(.bcn-plan-gantt__mark--chain):not(.bcn-plan-gantt__mark--chain-root)),
  .bcn-plan-gantt-host[data-cascade='spotlight'] :global(.bcn-plan-gantt__plot--chaining .bcn-plan-gantt__link:not(.bcn-plan-gantt__link--chain)) { opacity: 0.22; }
  .bcn-plan-gantt-host[data-cascade='outline'] :global(.bcn-plan-gantt__mark--chain .bcn-plan-gantt__bar),
  .bcn-plan-gantt-host[data-cascade='outline'] :global(.bcn-plan-gantt__mark--chain .bcn-plan-gantt__milestone) { stroke: var(--_text); stroke-width: 2; }
  .bcn-plan-gantt-host[data-cascade]:not([data-cascade='none']) :global(.bcn-plan-gantt__link--chain .bcn-plan-gantt__link-line) { stroke: var(--_text); stroke-width: 1.75; }
  .bcn-plan-gantt-host[data-cascade]:not([data-cascade='none']) :global(.bcn-plan-gantt__link--chain .bcn-plan-gantt__link-head) { fill: var(--_text); }
  .bcn-plan-gantt-host[data-cascade='rows'] :global(.bcn-plan-gantt__item--chain),
  .bcn-plan-gantt-host[data-cascade='rows'] :global(.bcn-plan-gantt__item--chain-root) { background: var(--color-background-elevation-sunken); }
  .bcn-plan-gantt-host[data-cascade='rows'] :global(.bcn-plan-gantt__mark--chain) { transform: translateY(-2px); filter: drop-shadow(0 4px 6px rgb(0 0 0 / 0.14)); }

  @media (prefers-reduced-motion: reduce) {
    .bcn-plan-gantt-host[data-feel='tactile'] :global(.bcn-plan-gantt__mark),
    .bcn-plan-gantt-host[data-feel='tactile'] :global(.bcn-plan-gantt__ghost) { transition: none; transform: none; }
  }

  /* ── Issued and working (the draft study's directions A and D, 2026-10-27) ──
     Print: a read view (Live, someone else's draft) draws its marks flat, the brand fill with no gradient, shadow, lift
     or grips, and the cursor stays an arrow; the readout still opens on hover. Depth means "you can move this". */
  .bcn-plan-gantt-host[data-feel='print'] :global(.bcn-plan-gantt__mark) { filter: none; transform: none; transition: none; }
  .bcn-plan-gantt-host[data-feel='print'] :global(.bcn-plan-gantt__bar) { stroke: none; }
  .bcn-plan-gantt-host[data-feel='print'] :global(.bcn-plan-gantt__bar-grip) { display: none; }
  .bcn-plan-gantt-host[data-feel='print'] :global(.bcn-plan-gantt__hit) { cursor: default; }
  /* Entering your draft: the bars stand up onto their shadow, once. */
  .bcn-plan-gantt-host[data-rise] :global(.bcn-plan-gantt__mark) { animation: bcn-plan-gantt-stand 560ms cubic-bezier(0.2, 0.8, 0.2, 1) both; }
  @keyframes bcn-plan-gantt-stand {
    from { filter: none; transform: translateY(1px); }
    to { filter: drop-shadow(0 1px 2px rgb(0 0 0 / 0.1)); transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .bcn-plan-gantt-host[data-rise] :global(.bcn-plan-gantt__mark) { animation: none; }
  }
  /* The title block: the corner, pinned with the axis, says what this chart is. Live's sits on the chart's surface; a
     draft's on the sunken neutral the band uses, so the two read as one statement. */
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__corner--titled) {
    flex-direction: column;
    align-items: stretch;
    justify-content: space-between;
    gap: var(--spacing-100);
  }
  .bcn-plan-gantt-host[data-in-draft] :global(.bcn-plan-gantt__corner--titled) { background: var(--color-background-elevation-sunken); }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__title-block) {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-200);
    min-inline-size: 0;
    overflow: hidden;
    white-space: nowrap;
  }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__title-status) { font-size: var(--font-size-150); font-weight: 650; color: var(--_text); }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__title-fact) { font-size: var(--_meta); font-weight: 500; color: var(--_muted); overflow: hidden; text-overflow: ellipsis; }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__corner-row) { display: flex; align-items: flex-end; min-inline-size: 0; }
  /* The stamp: one line repeated faintly across a draft's plot, under the marks, never taking the pointer. */
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__stamp) { pointer-events: none; }
  .bcn-plan-gantt-host :global(.bcn-plan-gantt__stamp-text) {
    fill: var(--_text);
    fill-opacity: 0.05;
    font-size: 1.75rem;
    font-weight: 650;
    user-select: none;
    -webkit-user-select: none;
  }

  /* ── Draft-mode concepts (2026-10-27, second round): what being in a draft looks like on the chart ──
     The page sets data-draft-look to the concept and data-in-draft while it shows a draft; the draft overlay marks the
     rows the draft changed (never a ghost of Live). */

  /* Pencil: what the draft changed is pencilled in, a teal wash inside a dashed outline, and lies flat on the paper;
     everything else is ink, raised on its shadow. data-pencil="all" pencils every mark while in a draft. */
  .bcn-plan-gantt-host[data-draft-look='pencil'] :global(.bcn-plan-gantt__mark--draft-changed),
  .bcn-plan-gantt-host[data-draft-look='pencil'][data-pencil='all'][data-in-draft] :global(.bcn-plan-gantt__mark) { filter: none; }
  .bcn-plan-gantt-host[data-draft-look='pencil'] :global(.bcn-plan-gantt__mark--draft-changed :is(.bcn-plan-gantt__bar, .bcn-plan-gantt__milestone)),
  .bcn-plan-gantt-host[data-draft-look='pencil'][data-pencil='all'][data-in-draft] :global(.bcn-plan-gantt__mark :is(.bcn-plan-gantt__bar, .bcn-plan-gantt__milestone)) {
    fill-opacity: 0.14;
    stroke-dasharray: 5 3;
  }
  /* A conflict keeps its red edge in pencil: the pencil says provisional, the red says broken. */
  .bcn-plan-gantt-host[data-draft-look='pencil'] :global(.bcn-plan-gantt__mark--draft-changed:not(.bcn-plan-gantt__mark--conflict) :is(.bcn-plan-gantt__bar, .bcn-plan-gantt__milestone)),
  .bcn-plan-gantt-host[data-draft-look='pencil'][data-pencil='all'][data-in-draft] :global(.bcn-plan-gantt__mark:not(.bcn-plan-gantt__mark--conflict) :is(.bcn-plan-gantt__bar, .bcn-plan-gantt__milestone)) {
    stroke: var(--_brand);
    stroke-width: 1.5;
  }
  .bcn-plan-gantt-host[data-draft-look='pencil'] :global(.bcn-plan-gantt__mark--draft-changed :is(.bcn-plan-gantt__summary, .bcn-plan-gantt__summary-tick)),
  .bcn-plan-gantt-host[data-draft-look='pencil'][data-pencil='all'][data-in-draft] :global(.bcn-plan-gantt__mark :is(.bcn-plan-gantt__summary, .bcn-plan-gantt__summary-tick)) { fill-opacity: 0.4; }
  .bcn-plan-gantt-host[data-draft-look='pencil'] :global(.bcn-plan-gantt__mark--draft-changed .bcn-plan-gantt__overrun),
  .bcn-plan-gantt-host[data-draft-look='pencil'][data-pencil='all'][data-in-draft] :global(.bcn-plan-gantt__mark .bcn-plan-gantt__overrun) { fill-opacity: 0.3; stroke-dasharray: 5 3; }
  .bcn-plan-gantt-host[data-draft-look='pencil'] :global(.bcn-plan-gantt__mark--draft-changed .bcn-plan-gantt__bar-grip) { stroke: var(--_brand); }
  /* In review, where Live had it is rubbed out, not drawn: a faint smudge, no outline, so dashes only ever mean pencil. */
  .bcn-plan-gantt-host[data-draft-look='pencil'] :global(.bcn-plan-gantt__baseline) {
    fill: color-mix(in srgb, var(--_text) 7%, transparent);
    stroke: none;
  }
  /* Publish: the rows that were pencil ink in once on Live, filling and rising onto their shadow. */
  .bcn-plan-gantt-host[data-draft-look='pencil'] :global(.bcn-plan-gantt__mark--draft-inked) { animation: bcn-plan-gantt-rise 1100ms cubic-bezier(0.2, 0.8, 0.2, 1) both; }
  .bcn-plan-gantt-host[data-draft-look='pencil'] :global(.bcn-plan-gantt__mark--draft-inked :is(.bcn-plan-gantt__bar, .bcn-plan-gantt__milestone)) {
    stroke: var(--_brand);
    stroke-width: 1.5;
    stroke-dasharray: 5 3;
    animation: bcn-plan-gantt-ink 1100ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  @keyframes bcn-plan-gantt-ink {
    from { fill-opacity: 0.14; stroke-opacity: 1; }
    to { fill-opacity: 1; stroke-opacity: 0; }
  }
  @keyframes bcn-plan-gantt-rise {
    from { filter: none; transform: translateY(0); }
    55% { filter: drop-shadow(0 4px 6px rgb(0 0 0 / 0.14)); transform: translateY(-2px); }
    to { filter: drop-shadow(0 1px 2px rgb(0 0 0 / 0.1)); transform: translateY(0); }
  }

  /* Drafting: the draft is a working drawing. Graph paper ruled to the time scale (months, split nearer square when
     zoomed, and each row in quarters), the year and row rules a step stronger as the paper's major lines; each move
     measured in its own lane; each moved row tagged with the edit that moved it; construction lines while carrying.
     The paper is its own switch (data-paper), so pencil can be drawn on it: the recommended pencil-paper. */
  .bcn-plan-gantt-host[data-paper][data-in-draft] { --bcn-plan-gantt-plot-surface: var(--bcn-drafting-paper); }
  /* The measurements mark what moved, so the moved bars stay plain ink. */
  .bcn-plan-gantt-host[data-draft-look='drafting'] :global(.bcn-plan-gantt__mark--draft-changed :is(.bcn-plan-gantt__bar, .bcn-plan-gantt__milestone)) { stroke: none; }
