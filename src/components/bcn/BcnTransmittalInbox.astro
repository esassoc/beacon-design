---
// <BcnTransmittalInbox> — Sent to You (2026-10-28, the proposal's "Transmittals and receipt"): every transmittal,
// across every plan, that names the signed-in person as a To or Cc recipient. Number, subject (its plan under it), who
// sent it and when, where their own receipt stands (Confirm Receipt while a To recipient hasn't; Confirmed once they
// have) and when a response is due. The ones still waiting on them come first. A row opens the transmittal, where
// Confirm Receipt is. Hidden entirely when nothing was sent to them, so the Plans index looks the same for everyone
// else. The runtime is ./transmittal-inbox.ts: setupTransmittalInbox(root).draw().
//
// bcn-lego-checked: the shell IS esa-card, the glyph IS esa-icon, the count IS esa-badge, badges ARE esa-badge
// (BcnBadgeBank, which the page includes), avatars ARE esa-avatar (BcnPlanPeople, which the page includes). No esa-
// lego is a register with columns (esa-link-column is a nav list; there is no esa-table); checked Beacon (prod lists are
// ag-grid, too heavy for a short inbox). The register IS bcn-rtable (bcn-record-table.css, design QA 2026-10-29: one
// read-list table, not a grid of divs). bcn-transmittal-inbox is the reusable home; the CSS is its columns.
import EsaCard from '@esa/ecology/esa-card.astro';
import EsaIcon from '@esa/ecology/esa-icon.astro';
import EsaBadge from '@esa/ecology/esa-badge.astro';
import { PLAN_ICON_PATHS } from '../../lib/planning/icons';
import '../../styles/bcn-record-table.css';
---

<section class="bcn-tib" data-bcn-transmittal-inbox aria-labelledby="tib-title" hidden>
  <EsaCard padding="compact">
    <div slot="header" class="bcn-tib__head">
      <span class="bcn-tib__glyph"><EsaIcon name="inbox" paths={PLAN_ICON_PATHS.inbox} size="sm" /></span>
      <span class="bcn-tib__titles">
        <span class="bcn-tib__title-row">
          <h2 class="bcn-tib__title typography-label-md-strong" id="tib-title">Sent to You</h2>
          <span data-tib-count><EsaBadge value="0" size="xs" /></span>
        </span>
        <span class="bcn-tib__note typography-body-sm" data-tib-note></span>
      </span>
    </div>
    <div class="bcn-tib__scroll">
      <table class="bcn-tib__table bcn-rtable" aria-labelledby="tib-title">
        <thead>
          <tr>
            <th scope="col" class="bcn-tib__col-num">Number</th>
            <th scope="col" class="bcn-tib__col-subject">Subject</th>
            <th scope="col">From</th>
            <th scope="col">Sent</th>
            <th scope="col">Your Receipt</th>
            <th scope="col">Response Due</th>
          </tr>
        </thead>
        <tbody class="bcn-tib__rows" data-tib-rows></tbody>
      </table>
    </div>
  </EsaCard>

  <template data-tib-tpl="row">
    <tr class="bcn-tib__row" data-tib-row data-rtable-link>
      <td class="bcn-tib__num" data-tib-num></td>
      <td class="bcn-tib__subject">
        <a class="bcn-rtable__primary" data-tib-subject></a>
        <span class="bcn-rtable__sub" data-tib-plan></span>
      </td>
      <td><span class="bcn-tib__from" data-tib-from></span></td>
      <td class="bcn-tib__date" data-tib-sent></td>
      <td><span class="bcn-tib__state" data-tib-state></span></td>
      <td class="bcn-tib__date" data-tib-due></td>
    </tr>
  </template>
</section>

<style>
  .bcn-tib[hidden] {
    display: none;
  }
  /* Glyph, title and count on one centre line (2026-10-29, measured): a grid, the glyph and the title row centred in its
     first row, the note in the second under the title; the count's wrapper a flex box, no inline baseline under it. */
  .bcn-tib__head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    column-gap: var(--spacing-200);
    row-gap: 2px;
    min-width: 0;
  }
  .bcn-tib__glyph {
    display: inline-flex;
    grid-row: 1;
    color: var(--color-content-default-secondary);
  }
  .bcn-tib__titles {
    display: contents;
  }
  .bcn-tib__title-row {
    display: flex;
    grid-row: 1;
    grid-column: 2;
    align-items: center;
    gap: var(--spacing-150);
  }
  .bcn-tib__title-row [data-tib-count]:not([hidden]) {
    display: inline-flex;
  }
  .bcn-tib__note {
    grid-row: 2;
    grid-column: 2;
  }
  .bcn-tib__title {
    margin: 0;
    color: var(--color-content-default);
  }
  .bcn-tib__note,
  .bcn-tib__muted {
    color: var(--color-content-default-secondary);
  }

  /* The register is bcn-rtable (rows, head, hover, focus, the pointer on a whole-row link); flush to the card's edges.
     What's here is its columns and cells. */
  .bcn-tib :global(.esa-card__body:has(.bcn-tib__scroll)) {
    padding: 0;
  }
  .bcn-tib__scroll {
    overflow-x: auto;
  }
  .bcn-tib__col-num {
    inline-size: 4.5rem;
  }
  .bcn-tib__col-subject {
    inline-size: 38%;
  }
  .bcn-tib__table td {
    white-space: nowrap;
  }
  .bcn-tib__table td.bcn-tib__subject {
    white-space: normal;
  }
  /* A transmittal number is an identifier: the one place mono reads (design QA, 2026-10-29). */
  .bcn-tib__num {
    font-family: var(--bcn-font-figures);
    font-size: var(--typography-body-xs-font-size);
    font-weight: 600;
    color: var(--color-content-default-secondary);
  }
  .bcn-tib__subject a {
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .bcn-tib__row:hover .bcn-tib__subject a {
    text-decoration: underline;
  }
  .bcn-tib__from {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-150);
    max-inline-size: 14rem;
    min-width: 0;
    vertical-align: middle;
  }
  .bcn-tib__from :global(small) {
    color: var(--color-content-default-secondary);
    font-size: inherit;
  }
  /* The sender on one line, cut short with the full name on hover. */
  .bcn-tib__from :global(.bcn-tib__who) {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .bcn-tib__date {
    font-variant-numeric: tabular-nums;
  }
  .bcn-tib__date[data-tone='danger'] {
    color: var(--color-content-utility-danger);
    font-weight: 600;
  }
  .bcn-tib__date[data-tone='quiet'] {
    color: var(--color-content-default-secondary);
  }
  .bcn-tib__state {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--spacing-100);
    vertical-align: middle;
  }
  @media (max-width: 960px) {
    .bcn-tib__table :is(th, td):is(:nth-child(3), :nth-child(4), :nth-child(6)) {
      display: none;
    }
  }
</style>
