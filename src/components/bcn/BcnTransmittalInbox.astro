---
// <BcnTransmittalInbox> — Sent to You (2026-10-28, the proposal's "Transmittals and receipt"): every transmittal,
// across every plan, that names the signed-in person as a To or Cc recipient. Number, subject (its plan under it), who
// sent it and when, where their own receipt stands (Confirm Receipt while a To recipient hasn't; Confirmed once they
// have) and when a response is due. The ones still waiting on them come first. A row opens the transmittal, where
// Confirm Receipt is. Hidden entirely when nothing was sent to them, so the Plans index looks the same for everyone
// else. The runtime is ./transmittal-inbox.ts: setupTransmittalInbox(root).draw().
//
// bcn-lego-checked: the shell IS esa-card, the glyph IS esa-icon, the count IS esa-badge, badges ARE esa-badge
// (BcnBadgeBank, which the page includes), avatars ARE esa-avatar (BcnPlanPeople, which the page includes). No esa-
// lego is a register with columns (esa-link-column is a nav list; there is no esa-table); checked Beacon (prod lists are
// ag-grid, too heavy for a short inbox). bcn-transmittal-inbox is the reusable home; the CSS is the grid.
import EsaCard from '@esa/ecology/esa-card.astro';
import EsaIcon from '@esa/ecology/esa-icon.astro';
import EsaBadge from '@esa/ecology/esa-badge.astro';
import { PLAN_ICON_PATHS } from '../../lib/planning/icons';
---

<section class="bcn-tib" data-bcn-transmittal-inbox aria-labelledby="tib-title" hidden>
  <EsaCard padding="compact">
    <div slot="header" class="bcn-tib__head">
      <span class="bcn-tib__glyph"><EsaIcon name="inbox" paths={PLAN_ICON_PATHS.inbox} size="sm" /></span>
      <span class="bcn-tib__titles">
        <span class="bcn-tib__title-row">
          <h2 class="bcn-tib__title typography-label-md-strong" id="tib-title">Sent to You</h2>
          <span data-tib-count><EsaBadge value="0" size="xs" /></span>
        </span>
        <span class="bcn-tib__note typography-body-sm" data-tib-note></span>
      </span>
    </div>
    <div class="bcn-tib__grid" role="table" aria-labelledby="tib-title">
      <div class="bcn-tib__row bcn-tib__row--head typography-label-xs" role="row">
        <span role="columnheader">Number</span>
        <span role="columnheader">Subject</span>
        <span role="columnheader">From</span>
        <span role="columnheader">Sent</span>
        <span role="columnheader">Your Receipt</span>
        <span role="columnheader">Response Due</span>
      </div>
      <div class="bcn-tib__rows" role="rowgroup" data-tib-rows></div>
    </div>
  </EsaCard>

  <template data-tib-tpl="row">
    <div class="bcn-tib__row" role="row" data-tib-row>
      <span class="bcn-tib__num" role="cell" data-tib-num></span>
      <span class="bcn-tib__subject" role="cell">
        <a class="typography-label-sm-strong" data-tib-subject></a>
        <span class="bcn-tib__muted typography-body-sm" data-tib-plan></span>
      </span>
      <span class="bcn-tib__from typography-body-sm" role="cell" data-tib-from></span>
      <span class="bcn-tib__date typography-body-sm" role="cell" data-tib-sent></span>
      <span class="bcn-tib__state" role="cell" data-tib-state></span>
      <span class="bcn-tib__date typography-body-sm" role="cell" data-tib-due></span>
    </div>
  </template>
</section>

<style>
  .bcn-tib[hidden] {
    display: none;
  }
  .bcn-tib__head {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-200);
    min-width: 0;
  }
  .bcn-tib__glyph {
    display: inline-flex;
    padding-block-start: 2px;
    color: var(--color-content-default-secondary);
  }
  .bcn-tib__titles {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .bcn-tib__title-row {
    display: flex;
    align-items: center;
    gap: var(--spacing-150);
  }
  .bcn-tib__title {
    margin: 0;
    color: var(--color-content-default);
  }
  .bcn-tib__note,
  .bcn-tib__muted {
    color: var(--color-content-default-secondary);
  }

  /* The register: one row per transmittal, its columns aligned down the list; a hairline between. The whole row opens it. */
  .bcn-tib__row {
    display: grid;
    grid-template-columns: 3.5rem minmax(14rem, 2.4fr) minmax(10rem, 1.2fr) 7rem minmax(9rem, 1fr) 7.5rem;
    align-items: center;
    gap: var(--spacing-300);
    padding: var(--spacing-200);
  }
  .bcn-tib__row--head {
    padding-block: 0 var(--spacing-200);
    color: var(--color-content-default-secondary);
    border-block-end: 1px solid var(--color-border-default);
  }
  .bcn-tib__rows .bcn-tib__row {
    border-radius: var(--radius-200);
    cursor: pointer;
  }
  .bcn-tib__rows .bcn-tib__row + .bcn-tib__row {
    border-block-start: 1px solid var(--color-border-default-subtle);
  }
  .bcn-tib__rows .bcn-tib__row:hover {
    background: var(--color-background-default-hover);
  }
  .bcn-tib__num {
    font-family: var(--bcn-font-figures);
    font-size: var(--typography-label-sm-font-size);
    font-weight: 600;
    color: var(--color-content-default-secondary);
  }
  /* The subject, and the plan it's from under it. */
  .bcn-tib__subject {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .bcn-tib__subject a {
    color: var(--color-content-default);
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .bcn-tib__row:hover .bcn-tib__subject a {
    text-decoration: underline;
  }
  .bcn-tib__from {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-150);
    min-width: 0;
    color: var(--color-content-default);
  }
  .bcn-tib__from :global(small) {
    color: var(--color-content-default-secondary);
    font-size: inherit;
  }
  /* The sender on one line, cut short with the full name on hover. */
  .bcn-tib__from :global(.bcn-tib__who) {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .bcn-tib__date {
    font-variant-numeric: tabular-nums;
    color: var(--color-content-default);
    white-space: nowrap;
  }
  .bcn-tib__date[data-tone='danger'] {
    color: var(--color-content-utility-danger);
    font-weight: 600;
  }
  .bcn-tib__date[data-tone='quiet'] {
    color: var(--color-content-default-secondary);
  }
  .bcn-tib__state {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--spacing-100);
  }
  @media (max-width: 960px) {
    .bcn-tib__row {
      grid-template-columns: 3.5rem minmax(0, 1fr) auto;
    }
    .bcn-tib__row--head {
      display: none;
    }
    .bcn-tib__row > :nth-child(3),
    .bcn-tib__row > :nth-child(4),
    .bcn-tib__row > :nth-child(6) {
      display: none;
    }
  }
</style>
