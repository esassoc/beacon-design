---
// <BcnPlanElementMoveDialog> — "Move 'X'", a port of Jamie's plan-element-move-dialog
// (Beacon.Web pages/plan-gantt, BCN-1820): pick an element to move under, or the
// plan's top level. The subtree moves with it. The dialog is a picker only; the
// opener sends the move.
//
// ONE pre-rendered shell per page, found by [data-bcn-plan-element-move-dialog] and
// driven by ./plan-element-move-dialog.ts (openPlanElementMoveDialog).
//
// bcn-lego-checked: the shell IS esa-dialog (size sm), "Move under" IS esa-combobox
// (her ui-search-select: a required, searchable pick over the targets), the buttons
// ARE esa-button. No CSS beyond the dialog's width and footer row: esa-combobox
// renders each option as one label string, so her two-line option (level tag + name,
// path beneath) is carried in that string by the controller rather than styled here.
import EsaButton from '@esa/ecology/esa-button.astro';
---

<div class="bcn-plan-element-move" data-bcn-plan-element-move-dialog>
  <esa-dialog class="bcn-plan-element-move__dialog" size="sm" heading="Move">
    <esa-combobox
      label="Move under"
      help-text="Everything under it moves too, and it goes last among its new siblings."
      placeholder="Search…"
      required
      data-pem-target
    ></esa-combobox>

    <div slot="footer" class="bcn-plan-element-move__actions">
      <EsaButton variant="primary" type="button" disabled data-pem-move>Move</EsaButton>
      <EsaButton variant="ghost" appearance="outline" type="button" data-pem-cancel>Cancel</EsaButton>
    </div>
  </esa-dialog>

  <!-- esa-button's own spinner, which the shared button-state helper expects to find (Move never goes busy). -->
  <template data-pem-tpl="spinner"><EsaButton variant="primary" loading>Move</EsaButton></template>
</div>

<script>
  import '@esa/ecology/esa-dialog';
  import '@esa/ecology/esa-combobox';
</script>

<style>
  /* Beacon's ui-dialog--sm caps at 440px; the lego's sm is 360px. */
  .bcn-plan-element-move__dialog {
    --dialog-width-sm: min(90vw, 440px);
  }
  .bcn-plan-element-move__actions {
    display: flex;
    justify-content: flex-end;
    gap: var(--spacing-200);
  }
</style>
