---
// <BcnSettingsShell> — the frame every Unified Settings page renders inside: a persistent
// rail (search + section nav) beside the page's own content. Pages compose it as
// `<BcnSettingsShell activePageId="...">…</BcnSettingsShell>` and own nothing of the chrome.
//
// Frame: the .sidebar layout primitive carries the two columns — a 15rem rail that sticks
// within the .modern-layout__content scroll container, and the slotted content. The sticky
// top is a small breathing gap, NOT the 52px topbar height, because that scroll container
// already starts below the fixed topbar (AppShell's .modern-layout__body carries
// padding-top: 52px). Same rail conventions as bcn-release-nav / bcn-kb-browser.
//
// SCROLL OWNERSHIP: the rail sticks and caps its height but is NOT itself the scrollport —
// an inner div around the nav is. When the rail scrolled, everything inside it was clipped
// at its padding edge, which cost the search field the outer half of its focus ring and cut
// off the results panel. So the two jobs are split: the rail owns sticky geometry, the inner
// .__nav-scroll owns overflow, and the search sits above it as a non-scrolling child whose
// absolutely-positioned results panel can overlap the nav freely.
//
// AUDIENCE: pages an ESA admin owns are marked in the registry (`audience: 'esa-admin'`).
// The marker is display-only — in the real product the audience comes from who the
// signed-in user IS (User.IsEsaAdmin), not from anything selectable here. (A "View as"
// preview switch shipped in v1 and was removed on review, 2026-07-29.)
//
// ESA SURFACE: an ESA-admin page passes `esaSurface`, which stamps `data-esa-surface` on
// the content column and puts its CARDS into the same dark-glass chrome family as the ESA
// block in the rail and the floating help bar. The mechanism is a token re-point, not
// per-component styling: the semantic layer (--color-text-*, --color-border*,
// --color-surface-sunken) is re-pointed once on .esa-card and every bcn-* and esa-* thing
// inside inherits it, because they all read the semantic layer and never the raw ramp.
//
// The re-point lives on the CARD, not on the column, and that is load-bearing. Overlays
// rendered beside a card — bcn-op-card's esa-dialog confirm, the tenants side dialog —
// are page-level surfaces that must stay LIGHT; scoping to .esa-card leaves them alone
// for free instead of needing a reset. Same for bcn-danger-zone, which keeps its light
// red-bordered box so a destructive action stays in its own visual register.
//
// bcn-lego-checked: the two columns are the .sidebar primitive. No esa-* lego frames a
// settings rail: esa-app-shell is the app-wide topbar/body chrome one level up, and
// esa-sidebar-nav is the nav list that goes INSIDE this rail (bcn-settings-nav's job),
// not the rail's sticky geometry. Checked Beacon (Beacon.Web has no unified-settings
// shell — its settings pages each re-declare their own layout, which is the drift this
// replaces). The CSS below is composition glue only: rail stickiness, the nav scrollport,
// and the content column's overflow behavior.
import BcnSettingsSearch from './BcnSettingsSearch.astro';
import BcnSettingsNav from './BcnSettingsNav.astro';

interface Props {
  /** Which nav row reads as current — handed straight to <BcnSettingsNav>. */
  activePageId: string;
  /**
   * True on a page the registry marks `audience: 'esa-admin'`. Stamps `data-esa-surface`
   * on the content column, which re-points the semantic token layer for the cards inside
   * it (see the ESA SURFACE note above). Pages pass `page.audience === 'esa-admin'`.
   */
  esaSurface?: boolean;
}

const { activePageId, esaSurface = false } = Astro.props;
---

<div
  class="bcn-settings-shell sidebar"
  data-gap="xl"
  style="--sidebar-width: 15rem; --sidebar-content-min: 62%;"
  data-settings-shell
>
  <div class="bcn-settings-shell__rail stack" data-gap="lg">
    <div class="bcn-settings-shell__search">
      <BcnSettingsSearch />
    </div>
    <div class="bcn-settings-shell__nav-scroll">
      <BcnSettingsNav activePageId={activePageId} />
    </div>
  </div>

  <div class="bcn-settings-shell__content" data-esa-surface={esaSurface ? '' : undefined}>
    <slot />
  </div>
</div>

<style>
  /* Sticky rail — geometry only, no overflow (see SCROLL OWNERSHIP above). top is a small
     breathing gap: the .modern-layout__content scroll container already begins below the
     fixed 52px topbar, so no header offset is added here. align-self:start keeps the flex
     item from stretching, giving the sticky element slack to move. .stack already makes it
     a flex column, which is what lets the nav scroller claim the leftover height. */
  .bcn-settings-shell__rail {
    position: sticky;
    top: var(--spacing-500, 1.5rem);
    align-self: start;
    max-block-size: calc(100vh - var(--spacing-900, 6rem));
  }

  /* The search keeps its natural height no matter how tall the nav is — it is the rail's
     fixed head, and its overlay panel must never be the thing that gets squeezed. */
  .bcn-settings-shell__search {
    flex: none;
  }

  /* The rail's scrollport. min-block-size:0 is what allows a flex item to shrink below its
     content height — without it the div would refuse to compress and the whole rail would
     spill past the viewport instead of scrolling here. overflow-y:auto also clips the inline
     axis, so the box is bled 4px wider than the rail and padded back in; that gutter is
     what the nav links' 2px-offset focus rings live in. */
  .bcn-settings-shell__nav-scroll {
    flex: 1;
    min-block-size: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding-inline: var(--spacing-100);
    margin-inline: calc(-1 * var(--spacing-100));
    /* Generous tail padding: the last rows should land with air under them, not jammed
       against the scrollport edge — reaching the bottom of the list was reading harder
       than it should. */
    padding-block-end: var(--spacing-700, 2.5rem);
  }

  .bcn-settings-shell__content {
    min-inline-size: 0; /* let long tables/code scroll inside the column, not widen it */
    /* Settings cards sit on pure white (Andy's call, 2026-07-29) — esa-card's default
       --color-surface is the theme's near-white gray, which read as tinted against the
       page. Re-pointed once here through the lego's own public token so every card in
       the slotted content inherits it. */
    --card-bg: #ffffff;
  }

  /* Snapshot of the LIGHT semantic ink, captured on the column — one level above the
     re-point below, so these resolve against the theme's own values and then inherit
     down unchanged. It is how anything that must stay light chrome inside a dark card
     gets handed the original values back without reading the raw --bcn-gray-* ramp. */
  .bcn-settings-shell__content[data-esa-surface] {
    --bcn-esa-ink-light: var(--color-text-primary);
    --bcn-esa-ink-light-secondary: var(--color-text-secondary);

    /* Footer fill is set HERE rather than on .esa-card below so a card that has its own
       opinion still wins — bcn-op-card deliberately zeroes it so its Run action sits on
       the card surface behind a single hairline, and a re-point on the card itself would
       silently overrule that. The mix is spelled out because at this level the semantic
       tokens are still the light ones. */
    --card-footer-bg: color-mix(in srgb, var(--color-text-inverse) 10%, transparent);
  }

  /* Re-skins the hub's .esa-card class: the token re-point that turns an ESA-admin page's
     cards into dark glass. --card-bg and the blur are the chrome; everything else is the
     SEMANTIC layer, re-pointed here so slotted bcn-* components and esa-* legos invert by
     inheritance rather than by being restyled one at a time. Ink is mixed off
     --color-text-inverse; the percentages are contrast-driven against the composited
     glass (~#494b4d over the page ground), which is lighter than a solid inverse surface:
     secondary lands ~6.2:1, tertiary ~4.8:1, both AA at the 14–16px these carry.
     --color-surface deliberately does NOT move — it still has to paint esa-switch-toggle's
     thumb and esa-select's option panel white. */
  .bcn-settings-shell__content[data-esa-surface] :global(.esa-card) {
    --card-bg: var(--bcn-helpbar-bg);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    backdrop-filter: blur(14px) saturate(1.4);

    /* Deeper white than gray-1, and hotter mixes — the first pass read muddy on the
       glass (Andy, 2026-07-30). Primary is pure white; secondary ~88% holds ~7:1 on the
       composited glass, tertiary ~72% stays comfortably AA at caption sizes. */
    --color-text-primary: #ffffff;
    --color-text-secondary: color-mix(in srgb, #ffffff 88%, transparent);
    --color-text-tertiary: color-mix(in srgb, #ffffff 72%, transparent);
    --color-border: color-mix(in srgb, #ffffff 24%, transparent);
    --color-border-light: color-mix(in srgb, #ffffff 15%, transparent);
    --color-surface-sunken: color-mix(in srgb, #ffffff 10%, transparent);

    /* Accents on the dark surface: the Beacon teal on-track (#005862) sinks into the
       charcoal, so checked switches run in Aldo green — the house's one bright accent
       (Andy's call, 2026-07-30). Off-tracks go to a light translucent gray so the state
       pair reads by hue AND value; the lego's thumb stays white via --color-surface. */
    --switch-toggle-track-bg-checked: var(--bcn-aldo);
    --switch-toggle-track-bg: color-mix(in srgb, #ffffff 34%, transparent);

    /* esa-card reads each of these as `var(--card-X, var(--semantic-X))`, so re-pointing
       the semantic layer alone is NOT enough: the hub ships a fully resolved --card-*
       layer on :root (--card-header-color #3d3d3d, --card-header-border-color #efefef,
       --card-footer-bg #efefef), which short-circuits the fallback and left card titles
       dark and header hairlines near-white on the glass. Pointing them back at the
       semantic tokens re-opens the chain the lego documents — and because these are
       declared on the same element, they pick up the re-points above. (--card-footer-bg
       is handled a level up; see the note there.) */
    --card-border-color: var(--color-border);
    --card-header-color: var(--color-text-primary);
    --card-header-border-color: var(--color-border-light);
  }

  /* No backdrop-filter support (either prefix) → opaque dark fallback, same as the help bar. */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .bcn-settings-shell__content[data-esa-surface] :global(.esa-card) {
      --card-bg: var(--bcn-helpbar-bg-solid);
    }
  }
  @media (prefers-reduced-transparency: reduce) {
    .bcn-settings-shell__content[data-esa-surface] :global(.esa-card) {
      --card-bg: var(--bcn-helpbar-bg-solid);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  /* An alert inside a dark card keeps its light tinted fill (--color-warning-subtle and
     friends are the whole point of the variant), so its ink has to stay dark or it turns
     white-on-amber. Handed back through esa-alert-box's OWN public tokens. */
  .bcn-settings-shell__content[data-esa-surface] :global(.esa-alert-box) {
    --alert-box-title-color: var(--bcn-esa-ink-light);
    --alert-box-text-color: var(--bcn-esa-ink-light-secondary);
  }

  /* When the .sidebar primitive folds the rail above the content on narrow viewports, drop
     the sticky geometry AND the inner scrollport so the whole thing reads as a plain header
     block that grows with its content. */
  @media (max-width: 48rem) {
    .bcn-settings-shell__rail {
      position: static;
      max-block-size: none;
    }
    .bcn-settings-shell__nav-scroll {
      flex: none;
      overflow: visible;
    }
  }
</style>
