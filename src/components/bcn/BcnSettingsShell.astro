---
// <BcnSettingsShell> — the frame every Unified Settings page renders inside: a persistent
// rail (search + section nav) beside the page's own content. Pages compose it as
// `<BcnSettingsShell activePageId="...">…</BcnSettingsShell>` and own nothing of the chrome.
//
// Frame: the .sidebar layout primitive carries the two columns — a 15rem rail that sticks
// within the .modern-layout__content scroll container, and the slotted content. The sticky
// top is a small breathing gap, NOT the 52px topbar height, because that scroll container
// already starts below the fixed topbar (AppShell's .modern-layout__body carries
// padding-top: 52px). Same rail conventions as bcn-release-nav / bcn-kb-browser.
//
// SCROLL: the rail scrolls WITH the page — no sticky, no inner scrollport (Andy,
// 2026-07-30; earlier sticky/own-scrollbar arrangements fought the page scroll). The one
// standing rule from those rounds: NOTHING in the rail may clip overflow — an overflowing
// rail cost the search field half its focus ring and cut off its results panel, which is
// also why the results panel can safely overlay the nav below it.
//
// AUDIENCE: pages an ESA admin owns are marked in the registry (`audience: 'esa-admin'`).
// The marker is display-only — in the real product the audience comes from who the
// signed-in user IS (User.IsEsaAdmin), not from anything selectable here. (A "View as"
// preview switch shipped in v1 and was removed on review, 2026-07-29.)
//
// ESA SURFACE: an ESA-admin page passes `esaSurface`, which stamps `data-esa-surface` on
// the content column and gives its cards a DARK HEADER BAND in the settings chrome's
// charcoal (the help-bar family) — title + subtitle in light ink, body in normal light
// mode. (v2: the fully dark-glass card bodies shipped 2026-07-30 AM were pulled the same
// day — the band alone marks ESA territory without asking controls to live on charcoal.)
// Mechanism: esa-card's own public header tokens, nothing per-component.
//
// bcn-lego-checked: the two columns are the .sidebar primitive. No esa-* lego frames a
// settings rail: esa-app-shell is the app-wide topbar/body chrome one level up, and
// esa-sidebar-nav is the nav list that goes INSIDE this rail (bcn-settings-nav's job),
// not the rail's sticky geometry. Checked Beacon (Beacon.Web has no unified-settings
// shell — its settings pages each re-declare their own layout, which is the drift this
// replaces). The CSS below is composition glue only: rail stickiness, the nav scrollport,
// and the content column's overflow behavior.
import BcnSettingsSearch from './BcnSettingsSearch.astro';
import BcnSettingsNav from './BcnSettingsNav.astro';

interface Props {
  /** Which nav row reads as current — handed straight to <BcnSettingsNav>. */
  activePageId: string;
  /**
   * True on a page the registry marks `audience: 'esa-admin'`. Stamps `data-esa-surface`
   * on the content column, which re-points the semantic token layer for the cards inside
   * it (see the ESA SURFACE note above). Pages pass `page.audience === 'esa-admin'`.
   */
  esaSurface?: boolean;
}

const { activePageId, esaSurface = false } = Astro.props;
---

<div
  class="bcn-settings-shell sidebar"
  data-gap="xl"
  style="--sidebar-width: 15rem; --sidebar-content-min: 62%;"
  data-settings-shell
>
  <div class="bcn-settings-shell__rail stack" data-gap="lg">
    <div class="bcn-settings-shell__search">
      <BcnSettingsSearch />
    </div>
    <div class="bcn-settings-shell__nav-scroll">
      <BcnSettingsNav activePageId={activePageId} />
    </div>
  </div>

  <div class="bcn-settings-shell__content" data-esa-surface={esaSurface ? '' : undefined}>
    <slot />
  </div>
</div>

<style>
  /* The rail scrolls WITH the page — no sticky, no inner scrollport (Andy, 2026-07-30;
     the sticky-rail-with-its-own-scrollbar arrangement fought the page scroll). The one
     structural rule that remains: NOTHING in the rail may clip overflow, so the search's
     absolutely-positioned results panel and the links' focus rings always render freely.
     align-self:start keeps the .sidebar primitive from stretching the rail's background
     to the content column's height. */
  .bcn-settings-shell__rail {
    align-self: start;
  }

  .bcn-settings-shell__content {
    min-inline-size: 0; /* let long tables/code scroll inside the column, not widen it */
    /* Settings cards sit on pure white (Andy's call, 2026-07-29) — esa-card's default
       --color-surface is the theme's near-white gray, which read as tinted against the
       page. Re-pointed once here through the lego's own public token so every card in
       the slotted content inherits it. */
    --card-bg: #ffffff;
  }

  /* Re-skins the hub's .esa-card class on ESA-admin pages: a dark
     HEADER BAND only — the body stays light (Andy, 2026-07-30: fully dark card bodies
     weren't working; the band alone marks the territory). Solid dark rather than glass:
     a shallow band over a white body has nothing worth blurring behind it. The card's
     own overflow:hidden clips the band into the rounded corners, and this is the same
     anatomy the lego's `headerVariant="primary"` ships — a colored band with inverse
     ink — stated in the settings chrome's charcoal instead of the brand fill. */
  .bcn-settings-shell__content[data-esa-surface] :global(.esa-card) {
    --card-header-bg: var(--bcn-helpbar-bg-solid);
    --card-header-color: #ffffff;
    --card-header-border-color: transparent;
  }
  /* The subtitle reads the secondary text token, not the header-color chain — hand it
     light ink inside the band only. */
  .bcn-settings-shell__content[data-esa-surface] :global(.esa-card__header .esa-card__subtitle) {
    color: color-mix(in srgb, #ffffff 82%, transparent);
  }
</style>
