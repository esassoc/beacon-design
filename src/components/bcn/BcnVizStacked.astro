---
// <BcnVizStacked> — counts over time, stacked by category. Time on x, count on y,
// one color per type.
//
// The "spread over time" reading for widgets that have NO date-range control
// (2026-09-08). Those widgets report state or totals rather than a windowed
// quantity, so a range selector could not honestly re-derive their figures — but
// the shape of activity over time is still worth showing, and this is how they show
// it. Where BcnVizTrend answers "how much per period", this answers "how much per
// period, and of what".
//
// Bucketing is NOT done here: the caller passes points already through
// `bucketStacked()`, which picks one unit from the combined span so every series
// shares the same columns. Doing it here would hide the unit from the caller, and
// the caller needs it for the chart title ("Observations per day" → "per week").
//
// SCALE: each column is a share of the tallest column's TOTAL, and segments within
// a column are shares of that column. So height compares periods and the stack
// compares composition — the two readings a stacked bar is for. The scale is local
// to this chart, like BcnVizTrend's: counts of observations and counts of anything
// else share no unit, so a scale shared across widgets would be meaningless.
//
// bcn-lego-checked: no esa-* lego draws a stacked time series — esa-progress-bar is
// a single 0-100 bar (no time axis, no categories), esa-chart is the AG Charts
// wrapper the dashboard spec rules out for micro-viz (§8: ~2.8MB peer dep for a
// 30-column strip). Checked the spoke: BcnVizTrend is single-series columns,
// BcnVizBars is horizontal categories with no time axis, BcnVizMeter is one
// proportion bar, BcnVizStrip is per-day presence/absence. Checked Beacon prod: its
// dashboard has a pie by type and no time series at all. bcn-viz-stacked is the
// reusable home.
import type { StackPoint } from '../../lib/bucket-series';

export interface StackSeries {
  /** Matches a key in StackPoint.values. */
  key: string;
  /** Legend text. */
  label: string;
  /** Any CSS color. */
  color: string;
}

interface Props {
  /** Already bucketed — see the note above. Chronological. */
  points: StackPoint[];
  /** Stack order, bottom first. Also the legend order. */
  series: StackSeries[];
  /** Names the derivation for screen readers. */
  label: string;
  /** 'md' (96px, the default) or 'sm' (60px) for a tighter panel. */
  height?: 'sm' | 'md';
  /** First/last axis labels, already formatted by the caller. */
  axisStart?: string;
  axisEnd?: string;
}

const { points, series, label, height = 'md', axisStart, axisEnd } = Astro.props;

const totalOf = (p: StackPoint): number =>
  series.reduce((n, s) => n + (p.values[s.key] ?? 0), 0);

const max = Math.max(1, ...points.map(totalOf));

/**
 * Strip height in PIXELS, not a percentage.
 *
 * The bars are wrapped in esa-tooltip, whose host is `display: inline-block` around
 * a shadow-DOM anchor with auto height. A percentage height on the bar would have to
 * resolve against that anchor, which has no definite height and is unreachable from
 * outside — so the bars would collapse. Computing the height here removes the
 * dependency on any ancestor's height, and the CSS reads the same number so the two
 * cannot drift.
 */
const STRIP_PX = height === 'sm' ? 60 : 96;

const MONTH_DAY = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
/** UTC-parsed: a bare YYYY-MM-DD is UTC midnight, so a negative-offset zone would
    otherwise report the previous day. Same rule as the bucketing module. */
const dayLabel = (iso: string): string => {
  const m = /^(\d{4})-(\d{2})-(\d{2})/.exec(iso);
  if (!m) return iso;
  const d = new Date(Date.UTC(Number(m[1]), Number(m[2]) - 1, Number(m[3])));
  return Number.isNaN(d.getTime()) ? iso : MONTH_DAY.format(d);
};

const columns = points.map((p) => {
  const total = totalOf(p);
  const segments = series
    .map((sr) => ({ key: sr.key, label: sr.label, color: sr.color, value: p.values[sr.key] ?? 0 }))
    .filter((seg) => seg.value > 0);

  // The popup gets STRUCTURE rather than a joined string: a date line, then one
  // line per type. esa-popover takes markup in slot="content", so the rows can be
  // real elements with their own swatch — which also means the colour that
  // identifies a segment in the chart identifies it in the popup too.

  return {
    date: p.date,
    total,
    zero: total === 0,
    // Floored at 3px so a 1-count period is still a visible bar rather than a
    // hairline indistinguishable from the empty-period stub.
    heightPx: total === 0 ? 0 : Math.max(3, Math.round((total / max) * STRIP_PX)),
    // flex-grow per segment, so the browser does the within-column proportions and
    // rounding cannot make the parts disagree with the whole.
    segments,
    dateLabel: dayLabel(p.date),
  };
});

// A legend is required: color is the ONLY thing distinguishing the series, so
// without it the chart is unreadable rather than merely undecorated.
const legend = series;
---

{
  points.length > 0 && (
    <div class:list={['bcn-vizstack', height === 'sm' && 'bcn-vizstack--sm']}>
      {/* role="img" + aria-label is the accessible reading: it replaces the subtree,
          so the popovers below are a POINTER enhancement rather than the only
          carrier. Deliberately no tabindex on the bars — esa-popover does open on
          focus, but making every column a tab stop would put 31 of them in the
          middle of the dashboard's tab order. If per-period detail needs keyboard
          parity, the right fix is a visually-hidden table beside the strip, not tab
          stops on the bars. */}
      <div class="bcn-vizstack__strip" role="img" aria-label={label} style={`--_stack-height:${STRIP_PX}px`}>
        {columns.map((col) => (
          <esa-popover class="bcn-vizstack__slot" trigger="hover" position="top">
            {col.zero ? (
              <span class="bcn-vizstack__col bcn-vizstack__col--zero" />
            ) : (
              <span class="bcn-vizstack__col" style={`block-size:${col.heightPx}px`}>
                {col.segments.map((seg) => (
                  <span
                    class="bcn-vizstack__seg"
                    style={`flex:${seg.value};background:${seg.color}`}
                  />
                ))}
              </span>
            )}

            <div slot="content" class="bcn-vizstack__tip">
              <span class="bcn-vizstack__tip-date">{col.dateLabel}</span>
              {col.zero ? (
                <span class="bcn-vizstack__tip-empty">No observations</span>
              ) : (
                col.segments.map((seg) => (
                  <span class="bcn-vizstack__tip-row">
                    <span class="bcn-vizstack__swatch" style={`background:${seg.color}`} aria-hidden="true" />
                    <span class="bcn-vizstack__tip-label">{seg.label}:</span>
                    <span class="bcn-vizstack__tip-value">{seg.value}</span>
                  </span>
                ))
              )}
            </div>
          </esa-popover>
        ))}
      </div>

      {(axisStart || axisEnd) && (
        <div class="bcn-vizstack__axis">
          <span>{axisStart}</span>
          {axisEnd && <span>{axisEnd}</span>}
        </div>
      )}

      <ul class="bcn-vizstack__legend">
        {legend.map((s) => (
          <li class="bcn-vizstack__key">
            <span class="bcn-vizstack__swatch" style={`background:${s.color}`} aria-hidden="true" />
            {s.label}
          </li>
        ))}
      </ul>
    </div>
  )
}

<script>
  // esa-popover owns the hover behaviour, the panel and its positioning — composed,
  // not reimplemented. It is a Lit custom element, so the module has to be
  // registered. Chosen over esa-tooltip because a tooltip's `text` is a single
  // string: this popup needs a line per type, which means real markup in
  // slot="content". Its reflected `open` attribute is also what lets the widget
  // shell un-clip the card (see the CLIPPING note in the styles below).
  import '@esa/ecology/esa-popover';
</script>

<style>
  .bcn-vizstack {
    /* Taller than BcnVizTrend's 72px: a stack has to resolve into parts, and at 72px
       a two-count segment inside a nine-count column is a sliver. */
    --_stack-height: 96px;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-200);
    min-inline-size: 0;
  }

  .bcn-vizstack--sm {
    --_stack-height: 60px;
  }

  .bcn-vizstack__strip {
    display: flex;
    align-items: flex-end;
    /* 2px, matching BcnVizTrend — deliberately under the 4px spacing floor, because
       at 4px a 30-column strip spends a third of its width on gaps. */
    gap: 2px;
    block-size: var(--_stack-height);
  }

  /* The slot IS the esa-tooltip host. Overriding its `:host { display: inline-block }`
     from out here is legal — outer-document rules beat :host on the same element —
     and is what lets the host behave as a flex item in the strip. The bar inside
     carries its own pixel height, so nothing depends on the shadow anchor's size. */
  /* CLIPPING: esa-card sets `overflow: hidden`, so a popup anchored inside a widget
     would be cut off at the card edge. Nothing is needed here to fix it —
     BcnDashboardWidget already carries
     `.bcn-dwidget:has(esa-popover[open]) .esa-card { overflow: visible }` plus a
     z-index lift, keyed on esa-popover's REFLECTED `open` attribute. So choosing
     esa-popover (rather than a hand-rolled panel) is what buys the overflow — one
     more reason it is the right lego here. */
  .bcn-vizstack__slot {
    flex: 1;
    min-inline-size: 2px;
    /* GRID, not flex, and this is load-bearing. The tooltip's anchor lives in its
       shadow root and cannot be selected from out here, so the only way to size it
       is via the layout its host imposes. As a flex container the host stretched the
       anchor vertically but left its width content-driven — and the bar's
       `inline-size: 100%` then resolved against an auto width, i.e. against itself,
       collapsing to ZERO. The bars had height and no width: present, invisible.
       In grid, `justify-items` defaults to stretch, so the single child fills the
       host on BOTH axes and the percentage has something real to resolve against. */
    display: grid;
    align-items: end;
  }

  .bcn-vizstack__col {
    inline-size: 100%;
    min-inline-size: 2px;
    /* column-reverse so the FIRST series in the array sits at the bottom — stack
       order matches the legend order the caller declared. */
    display: flex;
    flex-direction: column-reverse;
    min-block-size: 3px;
    border-radius: 1px;
    overflow: hidden;
  }

  .bcn-vizstack__seg {
    display: block;
    /* Without this a 1-count segment in a tall column can round to nothing and the
       stack silently loses a category. */
    min-block-size: 2px;
  }

  /* A period with no records, present and readable as empty — same idiom as
     BcnVizTrend's zero day, so the two charts agree on what absence looks like. */
  .bcn-vizstack__col--zero {
    inline-size: 100%;
    block-size: 2px;
    min-block-size: 0;
    background: var(--color-border-default);
  }

  .bcn-vizstack__axis {
    display: flex;
    justify-content: space-between;
    font-size: max(0.8125rem, var(--font-size-100));
    color: var(--color-content-default-tertiary);
  }

  .bcn-vizstack__legend {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-100) var(--spacing-300);
    font-size: max(0.8125rem, var(--font-size-100));
    color: var(--color-content-default-secondary);
  }

  .bcn-vizstack__key {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-100);
    min-inline-size: 0;
  }

  /* The popup: one line per type, so it is a stack rather than a sentence. */
  .bcn-vizstack__tip {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-050);
    white-space: nowrap;
  }

  .bcn-vizstack__tip-date {
    font-weight: var(--typography-font-weight-semibold, 600);
  }

  .bcn-vizstack__tip-row {
    display: flex;
    align-items: center;
    gap: var(--spacing-100);
  }

  /* The count is pushed to the right edge so a multi-row popup reads as a small
     table rather than ragged text. */
  .bcn-vizstack__tip-value {
    margin-inline-start: auto;
    font-variant-numeric: tabular-nums;
    font-weight: var(--typography-font-weight-semibold, 600);
  }

  .bcn-vizstack__tip-empty,
  .bcn-vizstack__tip-label {
    color: inherit;
  }

  .bcn-vizstack__swatch {
    inline-size: 8px;
    block-size: 8px;
    border-radius: var(--radius-xs); /* 2px, matching BcnGisLayerPanel's swatch */
    flex: none;
  }
</style>
