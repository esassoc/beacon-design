---
// <BcnSw3IndexRun> — step 3's run console, inside the step panel under its header (PR
// #1520's draft strip, made watchable).
//
//   building  the console's peek: Build index as a session, two tool calls whose output
//             streams the commitments it reads and the categories and subcategories it
//             proposes, a spinner and the two stages ticking below it
//   built     nothing on the page (View Log opens Build index's record), until a Re-run:
//             then the console shows it as a diff: the
//             guidance as the prompt, Propose index as the tool, + added, − removed, and
//             the bins kept because they are locked
//   drafting  the console's peek: its newest lines in a strip no taller than 100px; pressing
//             it opens the whole session in a dialog. The Draft run as a session. Each of develop's four stages
//             is a tool call whose output streams what the run is doing to this project
//             (the commitments it reads, the bins it files into, the duties it merges, the
//             actions it completes), from the drafts file; a spinner names the stage with
//             elapsed time and its count; the four stages tick below it
//   drafted   nothing on the page: View Log in the console (bcn-sw3-index-actions) opens
//             the run's record in the same dialog (develop's processing log)
//
// Contract, on `document`:
//   in   sw3i:change, sw3i:tick   repaint
//   in   sw3i:view-log            open the run's record
//
// bcn-lego-checked: the console IS bcn-console (its "+N more" keys are esa-button); keys
// ARE esa-button; the lightbox is a native <dialog> (top layer, Esc) holding only the console, by Andy's call that the run log is not a form dialog; its close key IS esa-button. Checked Beacon: draft-obligations' strip
// and processing-run-log are this. bcn-sw3-index-run is its home.
import EsaButton from '@esa/ecology/esa-button.astro';
import BcnConsole from './BcnConsole.astro';
---

<div class="bcn-sw3ir" data-sw3-index-run>

  <div class="bcn-sw3ir__peek" data-ir-peek>
    <BcnConsole label="Draft run" maxHeight="100px" data-ir-console />
    <span class="bcn-sw3ir__expand" data-ir-expand><EsaButton variant="chrome" size="xs">Open log</EsaButton></span>
  </div>
</div>

<dialog class="bcn-sw3ir-box" aria-label="Draft run" data-ir-dialog>
  <span class="bcn-sw3ir-box__close" data-ir-close><EsaButton variant="chrome" size="sm" iconOnly icon="x" label="Close" /></span>
  <BcnConsole label="Draft run" maxHeight="min(82vh, 52rem)" data-ir-console-full />
</dialog>

<style>
  .bcn-sw3ir {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-300);
    padding: 0 var(--spacing-500) var(--spacing-400);
    font-size: 0.875rem;
    color: var(--color-content-default);
  }
  .bcn-sw3ir [hidden] { display: none !important; }
  .bcn-sw3ir:not(:has(> :not([hidden]))) { display: none; }
  /* the peek: the console's newest lines, fading out at the top; the whole strip opens it */
  .bcn-sw3ir__peek { position: relative; cursor: pointer; border-radius: var(--radius-300, 8px); }
  .bcn-sw3ir__peek :global(.bcn-console__body) {
    overflow: hidden;
    padding-block: var(--spacing-300);
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 2.25rem);
    mask-image: linear-gradient(to bottom, transparent 0, #000 2.25rem);
  }
  .bcn-sw3ir__peek :global(.bcn-console__more),
  .bcn-sw3ir__peek :global(.bcn-console__todo) { display: none; }
  .bcn-sw3ir__peek:hover :global(.bcn-console) { border-color: var(--bcn-console-fg-dim); }
  .bcn-sw3ir__expand { position: absolute; top: var(--spacing-200); right: var(--spacing-300); color: var(--bcn-console-fg-muted); }
  .bcn-sw3ir__peek:hover .bcn-sw3ir__expand { color: var(--bcn-console-fg); }
  /* the lightbox: the console alone on the page, its close key in the corner */
  /* The lightbox: a terminal window's shape, one fixed size however much the log holds. */
  .bcn-sw3ir-box {
    width: min(50rem, calc(100vw - 2 * var(--spacing-500)));
    max-width: none;
    max-height: none;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: visible;
  }
  .bcn-sw3ir-box::backdrop { background: var(--bcn-console-scrim); }
  .bcn-sw3ir-box[open] { animation: bcn-sw3ir-in 160ms ease-out; }
  @keyframes bcn-sw3ir-in { from { opacity: 0; transform: scale(0.985); } }
  @media (prefers-reduced-motion: reduce) { .bcn-sw3ir-box[open] { animation: none; } }
  .bcn-sw3ir-box :global(.bcn-console__body) { height: min(32rem, calc(100vh - 6rem)); box-sizing: border-box; padding-right: calc(var(--spacing-500) + 2.25rem); }
  .bcn-sw3ir-box__close { position: absolute; top: var(--spacing-200); right: var(--spacing-200); z-index: 1; color: var(--bcn-console-fg-dim); }
  .bcn-sw3ir-box__close:hover { color: var(--bcn-console-fg); }
</style>

<script>
  import { consoleKit, type ConsoleRow } from './console';
  import {
    initIndex,
    phase,
    subOf,
    rerunSummary,
    runProgress,
    currentRun,
    runMs,
    runDrafts,
    plan,
    STAGES,
    unfiled,
    filedBySuggest,
    lastRun,
    buildProgress,
    proposed,
    BUILD_STAGES,
    BUILD_MS,
    type RunCounts,
  } from './sw3-index-store';
  import { peek, requirementsOf, docIds, foundCodes } from './sw3-store';
  import { locatorRef } from './sw3-index';
  import type { IndexEntry, Sw3IndexDrafts } from '../../data/sw3-index-types';

  const root = document.querySelector<HTMLElement>('[data-sw3-index-run]');
  if (root) {
    initIndex();
    const $ = <T extends HTMLElement = HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const peekEl = $('[data-ir-peek]');
    const host = $('[data-ir-console]');
    const kit = consoleKit(host);
    const dialog = document.querySelector<HTMLDialogElement>('[data-ir-dialog]')!;
    const full = consoleKit(dialog.querySelector<HTMLElement>('[data-ir-console-full]')!);
    const peekBody = host.querySelector<HTMLElement>('[data-console-body]')!;
    peekBody.tabIndex = -1;
    host.setAttribute('aria-hidden', 'true');
    const n = (x: number) => x.toLocaleString('en-US');
    const plural = (x: number, one: string, many = `${one}s`) => `${n(x)} ${x === 1 ? one : many}`;
    const secs = (ms: number) => `${Math.max(0, Math.round(ms / 1000))}s`;

    // ── What each stage streams, from the drafts file (built once per proposal) ──────
    interface Streams {
      basis: string;
      rows: ConsoleRow[][];
      nouns: string[];
    }
    let streams: Streams | null = null;
    const streamsFor = (d: Sw3IndexDrafts): Streams => {
      if (streams?.basis === d.basis) return streams;
      const P = plan();
      const proposal = d.basis === 'rerun' ? P.rerun.categories : P.base;
      const order = proposal.flatMap((c) => c.subcategories.map((s) => ({ c, s })));
      const homes = order.flatMap(({ s }) => (d.placement[s.id]?.home ?? []).map((id) => d.entries[id]).filter((e): e is IndexEntry => !!e));
      const title = (e: IndexEntry) => (e.kind === 'action' ? e.name : e.title);

      // Read requirements: each commitment, its step 2 requirements, the items found in it.
      const byCode = new Map<string, { doc: string; items: number }>();
      for (const l of [...homes.flatMap((e) => e.locators), ...d.unfiled.flatMap((u) => u.locators)]) {
        const c = byCode.get(l.code) ?? { doc: l.doc, items: 0 };
        c.items++;
        byCode.set(l.code, c);
      }
      const read: ConsoleRow[] = [...byCode.entries()]
        .sort(([a, x], [b, y]) => x.doc.localeCompare(y.doc) || a.localeCompare(b, 'en', { numeric: true }))
        .map(([code, c]) => {
          const reqs = peek(c.doc, () => requirementsOf(code).length);
          return { text: code, meta: `${reqs ? `${plural(reqs, 'requirement')}, ` : ''}${plural(c.items, 'item')}` };
        });

      // File into bins: each bin the items land in, and what fits none, where the run met it.
      const file: ConsoleRow[] = [];
      const bins = order.filter(({ s }) => d.placement[s.id]?.home.length);
      const every = Math.max(1, Math.floor(bins.length / (d.unfiled.length + 1)));
      let u = 0;
      bins.forEach(({ s }, i) => {
        const items = d.placement[s.id].home.reduce((a, id) => a + (d.entries[id]?.locators.length ?? 0), 0);
        file.push({ text: s.name, meta: plural(items, 'item') });
        if ((i + 1) % every === 0 && u < d.unfiled.length) file.push({ text: d.unfiled[u++].statement, meta: 'fits no subcategory', tone: 'warn' });
      });
      while (u < d.unfiled.length) file.push({ text: d.unfiled[u++].statement, meta: 'fits no subcategory', tone: 'warn' });

      // Merge duties: each draft made of more than one item, and the requirements behind it.
      const merge: ConsoleRow[] = homes
        .filter((e) => e.locators.length > 1)
        .map((e) => {
          const refs = e.locators.map(locatorRef);
          const shown = refs.slice(0, 3).join(', ') + (refs.length > 3 ? ` +${refs.length - 3}` : '');
          return { text: title(e), meta: `${e.locators.length} items: ${shown}` };
        });

      // Complete drafts: each action's type, scope and responsible party.
      const complete: ConsoleRow[] = homes
        .filter((e) => e.kind === 'action')
        .map((e) => {
          const a = e as Extract<IndexEntry, { kind: 'action' }>;
          const parts = [a.type, a.scope].filter(Boolean).join(', ');
          return a.responsibleParty
            ? { text: a.name, meta: `${parts}, ${a.responsibleParty}` }
            : { text: a.name, meta: `${parts}, no responsible party`, tone: 'warn' as const };
        });

      streams = { basis: d.basis, rows: [read, file, merge, complete], nouns: ['commitments', 'subcategories', 'merged drafts', 'actions'] };
      return streams;
    };

    /** Draft again streams what Suggest subcategories filed, into its bin. */
    const againRows = (): ConsoleRow[] =>
      Object.entries(filedBySuggest()).map(([uid, subId]) => ({
        text: unfiled().find((x) => x.id === uid)?.statement ?? uid,
        meta: `into ${subOf(subId)?.sub.name ?? 'a new subcategory'}`,
      }));

    // ── Each stage's sentence, as draft-stages.ts words it ────────────────────────────
    const detail = (i: number, c: RunCounts) =>
      [
        `${n(c.read)} of ${n(c.requirements)} requirements read, ${plural(c.items, 'item')} found`,
        `${n(c.filed)} of ${n(c.items)} items filed, ${n(c.noBin)} fit no subcategory`,
        `${n(c.merged)} of ${n(c.toMerge)} items merged into ${plural(c.drafts, 'draft')}`,
        `${n(c.completed)} of ${n(c.toComplete)} draft actions completed`,
      ][i];
    const againDetail = (i: number, c: RunCounts) =>
      [`${plural(c.items, 'item')} outstanding`, `${n(c.filed)} of ${plural(c.items, 'item')} filed`, `${plural(c.drafts, 'draft')} made`, 'No draft actions to complete'][i];
    const arg = (i: number, c: RunCounts, again: boolean) =>
      again ? '' : [`${n(c.requirements)} requirements`, `${n(c.items)} items`, `${n(c.toMerge)} items`, `${n(c.toComplete)} draft actions`][i];
    const VERBS = ['Reading requirements', 'Filing into bins', 'Merging duties', 'Completing drafts'];
    const count = (i: number, c: RunCounts, again: boolean) =>
      again
        ? `${n([c.items, c.filed, c.merged, c.completed][i])} of ${plural([c.items, c.items, c.toMerge, c.toComplete][i], 'item')}`
        : [`${n(c.read)} of ${n(c.requirements)} requirements`, `${n(c.filed)} of ${n(c.items)} items`, `${n(c.merged)} of ${n(c.toMerge)} items`, `${n(c.completed)} of ${n(c.toComplete)} actions`][i];

    /** File into bins folds bins and what fit none: name both. */
    const moreLabel = (i: number, rows: ConsoleRow[], again: boolean) => {
      if (again || i !== 1) return undefined;
      const none = rows.filter((r) => r.tone === 'warn').length;
      return `Show ${plural(rows.length - none, 'subcategory', 'subcategories')}${none ? ` and ${plural(none, 'item')} with none` : ''}`;
    };
    const open = new Set<string>();
    const toggle = (k: string) => () => {
      open.has(k) ? open.delete(k) : open.add(k);
      render();
    };
    const TAIL = 5;
    let frame = 0;

    /** The Draft run as a session: live while it runs, the record after. */
    const runNodes = (c: RunCounts, again: boolean, at: { stage: number; frac: number[]; elapsed: number } | null): Node[] => {
      const d = runDrafts();
      const rows = again ? [[], againRows(), [], []] : d ? streamsFor(d).rows : [[], [], [], []];
      const nouns = again ? ['', 'items', '', ''] : (streams?.nouns ?? []);
      const nodes: Node[] = [kit.prompt(again ? 'Draft again' : 'Draft actions & obligations')];
      const last = at ? at.stage : 3;
      for (let i = 0; i <= last; i++) {
        const done = !at || i < at.stage;
        const words = (again ? againDetail : detail)(i, c);
        if (done) {
          const warn: ConsoleRow[] = [];
          if (!again && i === 0 && c.neither) warn.push({ text: `${plural(c.neither, 'requirement')} bind no action or obligation`, tone: 'dim' });
          if (!again && i === 3 && c.needParty) warn.push({ text: `${plural(c.needParty, 'draft action')} name no responsible party`, tone: 'warn' });
          const k = `s${i}`;
          nodes.push(
            kit.tool({
              name: STAGES[i],
              arg: arg(i, c, again),
              state: 'done',
              rows: [{ text: words }, ...warn],
              more: rows[i].length ? { count: rows[i].length, noun: nouns[i], label: moreLabel(i, rows[i], again), open: open.has(k), toggle: toggle(k) } : undefined,
              tail: open.has(k) ? rows[i] : [],
            }),
          );
        } else {
          const shown = rows[i].slice(0, Math.round(rows[i].length * at!.frac[i]));
          nodes.push(kit.tool({ name: STAGES[i], arg: arg(i, c, again), state: 'running', rows: shown.slice(-TAIL) }));
        }
      }
      if (at) {
        nodes.push(kit.spinner({ frame, verb: VERBS[at.stage], meta: [secs(at.elapsed), count(at.stage, c, again)] }));
        nodes.push(kit.todo(STAGES.map((s, i) => ({ text: s, state: i < at.stage ? 'done' : i === at.stage ? 'active' : 'pending' }))));
      } else {
        const warn: ConsoleRow[] = [];
        if (c.noBin) warn.push({ text: `${plural(c.noBin, 'item')} fit no subcategory`, tone: 'warn' });
        nodes.push(kit.message(`Done in ${secs(runMs(again))}. ${plural(c.drafts, 'draft')} filed for review.`, warn));
      }
      return nodes;
    };

    // ── Build index: what it reads, and the index it proposes ─────────────────────────
    let buildRows: { read: ConsoleRow[]; propose: ConsoleRow[]; requirements: number; cats: number; subs: number } | null = null;
    const buildStreams = () => {
      if (buildRows) return buildRows;
      const read: ConsoleRow[] = docIds().flatMap((doc) =>
        peek(doc, () =>
          foundCodes().map((code) => {
            const reqs = requirementsOf(code).length;
            return { text: code, meta: plural(reqs, 'requirement') };
          }),
        ),
      );
      const base = plan().base;
      const propose: ConsoleRow[] = base.flatMap((c) => [
        { sign: '+' as const, text: c.name, tone: 'add' as const },
        ...c.subcategories.map((sc) => ({ sign: '+' as const, text: `${c.name} › ${sc.name}`, meta: plural(sc.evidence.length, 'citation'), tone: 'add' as const })),
      ]);
      const subs = base.reduce((a, c) => a + c.subcategories.length, 0);
      buildRows = { read, propose, requirements: plan().requirements, cats: base.length, subs };
      return buildRows;
    };
    const BUILD_VERBS = ['Reading requirements', 'Proposing the index'];
    /** Build index as a session: live while it runs, the record after. */
    const buildNodes = (at: { stage: number; frac: number[]; elapsed: number } | null): Node[] => {
      const b = buildStreams();
      const rows = [b.read, b.propose];
      const sizes = `${plural(b.cats, 'category', 'categories')} and ${plural(b.subs, 'subcategory', 'subcategories')}`;
      const words = [`${n(b.requirements)} approved requirements read from ${plural(b.read.length, 'commitment')}`, `${sizes} proposed`];
      const args = [`${n(b.requirements)} requirements`, `${n(b.requirements)} requirements`];
      const nouns = ['commitments', 'lines'];
      const nodes: Node[] = [kit.prompt('Build index')];
      const last = at ? at.stage : 1;
      for (let i = 0; i <= last; i++) {
        const k = `b${i}`;
        if (!at || i < at.stage)
          nodes.push(
            kit.tool({
              name: BUILD_STAGES[i],
              arg: args[i],
              state: 'done',
              rows: [{ text: words[i] }],
              more: rows[i].length ? { count: rows[i].length, noun: nouns[i], label: i ? `Show the ${sizes}` : undefined, open: open.has(k), toggle: toggle(k) } : undefined,
              tail: open.has(k) ? rows[i] : [],
            }),
          );
        else nodes.push(kit.tool({ name: BUILD_STAGES[i], arg: args[i], state: 'running', rows: rows[i].slice(0, Math.round(rows[i].length * at.frac[i])).slice(-TAIL) }));
      }
      if (at) {
        const shown = Math.round([b.read.length, b.cats][at.stage] * at.frac[at.stage]);
        const of = at.stage ? `${n(shown)} of ${plural(b.cats, 'category', 'categories')}` : `${n(shown)} of ${plural(b.read.length, 'commitment')}`;
        nodes.push(kit.spinner({ frame, verb: BUILD_VERBS[at.stage], meta: [secs(at.elapsed), of] }));
        nodes.push(kit.todo(BUILD_STAGES.map((t, i) => ({ text: t, state: i < at.stage ? 'done' : i === at.stage ? 'active' : 'pending' }))));
      } else nodes.push(kit.message(`Done in ${secs(BUILD_MS)}. ${sizes[0].toUpperCase()}${sizes.slice(1)} to review.`));
      return nodes;
    };

    /** A Re-run, as a diff of the index. */
    const rerunNodes = (): Node[] => {
      const rr = rerunSummary()!;
      const diff: ConsoleRow[] = [
        ...rr.added.map((t) => ({ sign: '+' as const, text: t, tone: 'add' as const })),
        ...rr.removed.map((t) => ({ sign: '−' as const, text: t, tone: 'remove' as const })),
        ...rr.keptLocked.map((t) => ({ sign: ' ' as const, text: t, meta: 'kept, locked', tone: 'dim' as const })),
      ];
      const FOLD = 10;
      const k = 'rerun';
      const counts = [rr.added.length && `${rr.added.length} added`, rr.removed.length && `${rr.removed.length} removed`, rr.keptLocked.length && `${rr.keptLocked.length} kept because locked`].filter(Boolean).join(', ');
      return [
        kit.prompt(rr.guidance ? `Re-run with “${rr.guidance}”` : 'Re-run'),
        kit.tool({
          name: 'Propose index',
          arg: counts,
          state: 'done',
          rows: diff.length ? (open.has(k) ? diff : diff.slice(0, FOLD)) : [{ text: 'The re-run changed nothing.' }],
          more: diff.length > FOLD ? { count: diff.length - FOLD, noun: 'changes', label: `+${diff.length - FOLD} more changes`, open: open.has(k), toggle: toggle(k) } : undefined,
        }),
      ];
    };

    /** What the console shows now: a Re-run's diff, the live run, or the last run's record. */
    const session = (): { heading: string; nodes: () => Node[] } | null => {
      const ph = phase();
      if (ph === 'building') {
        const p = buildProgress()!;
        return { heading: 'Build index', nodes: () => buildNodes(p) };
      }
      if (ph === 'built') return rerunSummary() ? { heading: 'Re-run', nodes: rerunNodes } : proposed() ? { heading: 'Build index', nodes: () => buildNodes(null) } : null;
      if (ph === 'drafting') {
        const p = runProgress()!;
        const r = currentRun()!;
        return { heading: r.again ? 'Draft again' : 'Draft run', nodes: () => runNodes(p.counts, r.again, { stage: p.stage, frac: p.frac, elapsed: Date.now() - r.started }) };
      }
      const last = lastRun();
      return ph === 'drafted' && last ? { heading: last.requirements === 0 ? 'Draft again' : 'Draft run', nodes: () => runNodes(last, last.requirements === 0, null) } : null;
    };

    const paintConsoles = () => {
      const s = session();
      const ph = phase();
      // The peek shows what is running, or a Re-run's diff; a finished run's record is View Log's.
      peekEl.hidden = !s || ph === 'drafted' || (ph === 'built' && !rerunSummary());
      if (s && !peekEl.hidden) {
        kit.paint(s.nodes());
        peekBody.scrollTop = peekBody.scrollHeight;
      }
      if (dialog.open) {
        if (!s) return dialog.close();
        dialog.setAttribute('aria-label', s.heading);
        full.paint(s.nodes());
      }
    };

    const openLog = () => {
      if (!session()) return;
      paintConsoles();
      dialog.showModal();
      paintConsoles();
    };

    const render = () => {
      const ph = phase();
      if (ph === 'drafting' || ph === 'building') frame++;
      paintConsoles();
    };

    document.addEventListener('sw3i:view-log', openLog);
    peekEl.addEventListener('click', openLog);
    dialog.querySelector('[data-ir-close]')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => e.target === dialog && dialog.close());
    document.addEventListener('sw3i:change', render);
    document.addEventListener('sw3i:tick', render);
    render();
  }
</script>
