---
// <BcnPlanRepoIndex> — the Plans index in the repo model (new design, 2026-10-26; streamlined 2026-10-28, Andy struck
// the named revision's tag, the Live line and the draft rows): the project's plans as a list. Each row is one plan:
// its name, the description, then what it tracks (Schedule, Budget), its span, items, budget, open drafts, revisions
// and people; at the right a miniature of its schedule with today marked, or of its budget by fiscal year when it
// tracks only money. Owners get the plan's settings from the row. A find field and a filter (All, Has Drafts) head
// the list. Rows are built by ./plan-repo-index.ts from a <template> here, so the scoped CSS reaches them.
//
// bcn-lego-checked: the find field IS esa-text-field, the filter IS esa-button-toggle, Private IS esa-badge, the
// settings button IS esa-button, the spinner IS esa-loading-spinner, the empty list IS esa-empty-state, avatars ARE
// esa-avatar (cloned from BcnPlanPeople). No esa- lego is a list of plan rows with facts and a miniature (esa-card is
// a card; esa-link-column is a nav column); checked Beacon (pages/plan-list is a plain linked list: BcnPlanList is its
// port, with no history or drafts). bcn-plan-repo-index is the reusable home for a plans index in the repo model.
import EsaBadge from '@esa/ecology/esa-badge.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaEmptyState from '@esa/ecology/esa-empty-state.astro';
import EsaLoadingSpinner from '@esa/ecology/esa-loading-spinner.astro';
---

<section class="bcn-pri" data-bcn-plan-repo-index>
  <div class="bcn-pri__bar">
    <esa-text-field class="bcn-pri__find" data-pri-find placeholder="Find a Plan" size="sm" aria-label="Find a Plan"></esa-text-field>
    <esa-button-toggle size="sm" data-pri-filter label=""></esa-button-toggle>
    <span class="bcn-pri__count" data-pri-count></span>
  </div>

  <div class="bcn-pri__loading" data-pri-loading>
    <EsaLoadingSpinner decorative />
    <span data-pri-progress>Loading plans…</span>
  </div>

  <ul class="bcn-pri__rows" data-pri-rows hidden></ul>
  <div data-pri-none hidden>
    <EsaEmptyState size="sm" title="No Plans Match" description="Try another word, or show all plans." />
  </div>

  <template data-pri-row>
    <li class="bcn-pri__row">
      <div class="bcn-pri__main">
        <div class="bcn-pri__title">
          <a class="bcn-pri__name" data-pri-name></a>
          <span data-pri-private hidden><EsaBadge value="Private" variant="neutral" size="sm" /></span>
        </div>
        <p class="bcn-pri__desc" data-pri-desc></p>
        <div class="bcn-pri__meta">
          <span class="bcn-pri__tracks" data-pri-tracks></span>
          <span data-pri-span></span>
          <span data-pri-items></span>
          <span data-pri-budget hidden></span>
          <a class="bcn-pri__metalink" data-pri-drafts hidden><span data-glyph="git-branch"></span><span data-pri-drafts-text></span></a>
          <a class="bcn-pri__metalink bcn-pri__metalink--you" data-pri-waiting hidden><span data-glyph="git-pull-request"></span><span data-pri-waiting-text></span></a>
          <a class="bcn-pri__metalink" data-pri-history><span data-glyph="history"></span><span data-pri-versions></span></a>
          <span class="bcn-pri__people" data-pri-people></span>
        </div>
      </div>
      <a class="bcn-pri__mini" data-pri-mini tabindex="-1" aria-hidden="true"></a>
      <!-- The plan's settings, for its Owners: the row's top-right corner (2026-10-28, Andy). -->
      <span class="bcn-pri__settings" data-pri-settings hidden><esa-tooltip text="Plan Settings" position="below" align="end"><EsaButton variant="ghost" size="xs" iconOnly icon="settings" label="Plan Settings" /></esa-tooltip></span>
    </li>
  </template>
</section>

<script>
  import '@esa/ecology/esa-text-field';
  import '@esa/ecology/esa-button-toggle';
</script>

<style>
  .bcn-pri[hidden] { display: none; }
  .bcn-pri { display: flex; flex-direction: column; gap: var(--spacing-300); }
  .bcn-pri :global([hidden]) { display: none !important; }

  .bcn-pri__bar { display: flex; align-items: center; gap: var(--spacing-300); flex-wrap: wrap; }
  .bcn-pri__find { inline-size: min(22rem, 100%); }
  .bcn-pri__count { margin-inline-start: auto; color: var(--color-content-default-secondary); font-size: var(--font-size-150); }

  .bcn-pri__loading { display: flex; align-items: center; gap: var(--spacing-200); color: var(--color-content-default-secondary); padding-block: var(--spacing-600); }

  .bcn-pri__rows {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-300, 8px);
    background: var(--color-background-elevation-raised);
    overflow: hidden;
  }
  /* The plan on the left, then the miniature, then the settings in the top-right corner. */
  .bcn-pri__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 17rem 1.5rem;
    gap: var(--spacing-500);
    padding: var(--spacing-400) var(--spacing-400) var(--spacing-400) var(--spacing-500);
  }
  .bcn-pri__settings { align-self: start; }
  .bcn-pri__row + .bcn-pri__row { border-block-start: 1px solid var(--color-border-default); }
  .bcn-pri__main { display: flex; flex-direction: column; gap: var(--spacing-200); min-inline-size: 0; }

  .bcn-pri :global([data-glyph]) { display: inline-flex; color: var(--color-content-default-tertiary); }
  .bcn-pri :global([data-glyph] svg) { display: block; }

  .bcn-pri__title { display: flex; align-items: center; gap: var(--spacing-200); flex-wrap: wrap; min-block-size: 1.75rem; }
  .bcn-pri__name { font-size: var(--font-size-300, 1.25rem); font-weight: 600; color: var(--color-content-default); text-decoration: none; }
  .bcn-pri__name:hover { color: var(--color-content-brand); text-decoration: underline; }
  .bcn-pri__desc {
    margin: 0;
    color: var(--color-content-default-secondary);
    font-size: var(--font-size-150);
    max-inline-size: 70ch;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }


  .bcn-pri__meta { display: flex; align-items: center; flex-wrap: wrap; gap: var(--spacing-400); color: var(--color-content-default-secondary); font-size: var(--font-size-100); margin-block-start: var(--spacing-100); }
  .bcn-pri__meta > * { display: inline-flex; align-items: center; gap: var(--spacing-100); }
  .bcn-pri__tracks { gap: var(--spacing-150); }
  .bcn-pri__tracks :global(span.bcn-pri__track) {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-100);
    padding: 0 var(--spacing-200);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-100, 4px);
    color: var(--color-content-default);
    line-height: 1.6;
  }
  .bcn-pri__metalink { color: inherit; text-decoration: none; }
  .bcn-pri__metalink:hover { color: var(--color-content-brand); }
  .bcn-pri__metalink--you { color: var(--color-content-brand); font-weight: 600; }
  .bcn-pri__people { margin-inline-start: auto; }

  .bcn-pri__mini {
    display: block;
    align-self: start;
    border: 1px solid var(--color-border-default-subtle);
    border-radius: var(--radius-200, 6px);
    background: var(--color-background-default);
    padding: var(--spacing-200);
    transition: border-color 120ms ease, box-shadow 120ms ease;
  }
  .bcn-pri__row:hover .bcn-pri__mini { border-color: var(--color-border-default); box-shadow: var(--shadow-100); }
  .bcn-pri__mini :global(svg) { display: block; inline-size: 100%; block-size: auto; }
  .bcn-pri__mini :global(.mini-axis) { fill: var(--color-content-default-tertiary); font-size: 9px; }
  .bcn-pri__mini :global(.mini-grid) { stroke: var(--color-border-default-subtle); stroke-width: 1; }
  .bcn-pri__mini :global(.mini-bar) { fill: var(--color-background-brand); }
  .bcn-pri__mini :global(.mini-bar--0) { opacity: 0.35; }
  .bcn-pri__mini :global(.mini-bar--1) { opacity: 0.6; }
  .bcn-pri__mini :global(.mini-today) { stroke: var(--color-background-utility-warning); stroke-width: 1.5; }
  .bcn-pri__mini :global(.mini-money) { fill: var(--color-background-brand); opacity: 0.7; }
  .bcn-pri__mini :global(.mini-money--now) { opacity: 1; }

  .bcn-pri :global(.bcn-plan-people-stack) { display: inline-flex; }
  .bcn-pri :global(.bcn-plan-people-stack > *) { margin-inline-start: -4px; box-shadow: 0 0 0 2px var(--color-background-elevation-raised); border-radius: 999px; }
  .bcn-pri :global(.bcn-plan-people-stack > :first-child) { margin-inline-start: 0; }
  .bcn-pri :global(.bcn-plan-people-stack__more) { font-size: var(--font-size-100); padding-inline-start: var(--spacing-150); box-shadow: none; }

  @media (max-width: 900px) {
    .bcn-pri__row { grid-template-columns: minmax(0, 1fr) 1.5rem; }
    .bcn-pri__mini { grid-column: 1; }
    .bcn-pri__settings { grid-column: 2; grid-row: 1; }
    .bcn-pri__mini { max-inline-size: 22rem; }
  }
</style>
