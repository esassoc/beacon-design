---
// <BcnHelpDotsAdmin> — the ESA admin's Dots on This Page list, which lives in the Help &
// Guidance drawer next to the rest of help authoring (plan item 10). Rendered hidden on
// the page; the help-dots controller moves it into the drawer's
// `[data-help-dots-admin-slot]` section and unhides that section, in the admin view only.
//
// A row per dot (<BcnHelpDotRow>), Claude drafts first since they are what the admin has
// to act on. A dot whose spot is gone from the page moves under Needs a New Spot. Add Dot
// starts pick mode. Rows for dots made in the session are cloned from the <template> at
// the foot. The controller owns all state; every hook here is `data-hda-*`.
import EsaButton from '@esa/ecology/esa-button.astro';
import BcnHelpDotRow from './BcnHelpDotRow.astro';
import type { HelpDot, HelpDotPage } from '../../data/help-dots';

interface Props {
  page: HelpDotPage;
}
const { page } = Astro.props;

const spotLabel = (spot: string): string => page.spots.find((s) => s.spot === spot)?.label ?? spot;
const rows: HelpDot[] = [...page.dots].sort(
  (a, b) => Number(b.status === 'draft') - Number(a.status === 'draft'),
);
---

<div class="bcn-hda stack" data-gap="md" data-hda hidden>
  <div class="stack" data-gap="xs" data-hda-list>
    {rows.map((dot) => <BcnHelpDotRow dot={dot} spotLabel={spotLabel(dot.spot)} />)}
  </div>

  <div class="stack" data-gap="xs" data-hda-orphans-wrap hidden>
    <h3 class="bcn-hda__subhead typography-label-md-strong">Needs a New Spot</h3>
    <div class="stack" data-gap="xs" data-hda-orphans></div>
  </div>

  <div>
    <EsaButton variant="primary" appearance="outline" size="sm" icon="plus" data-hda-add>Add Dot</EsaButton>
  </div>

  <template data-hda-template>
    <BcnHelpDotRow />
  </template>
</div>

<style>
  .bcn-hda[hidden],
  .bcn-hda [hidden] {
    display: none;
  }
  .bcn-hda__subhead {
    margin: 0;
    color: var(--color-content-default);
  }
</style>
