---
// <BcnPageView> — one page of a source document, rendered large, with boxes drawn over
// it. A box is a find (a whole item on the page) or a span within one (a child of it),
// and either is drawn in two states: found (dashed) and parsed (solid). New boxes draw
// in as they arrive. In select mode the person drags a rectangle over the page to mark
// something the reader missed.
//
// The page is the source PDF, rendered live by pdf.js (page-view.ts). Boxes are page
// fractions (0–1), prod's PdfBoundingBoxDto shape, so they ride the render at any width.
//
// Contract: page-view.ts `setupPageView(root, handlers)` returns { show, setSelecting }.
//   show(pdfUrl, page, boxes, label)
//   out  onBox(id)               a find's box was clicked
//   out  onRegion(page, box)     a rectangle was dragged in select mode
//   out  onEdit(id, page, box)   a selected (editable) box was moved or resized
//   out  onRemove(id, page)      Delete on a selected box
//   out  onSplit(id, page, y)    split mode: a click inside the box cuts it at y
// setSplitting(id) arms split mode on one find; setHideAldo(on) hides Aldo's boxes (the
// person's stay). A selected box passed a `chip` wears its ID and name above it.
// A box passed with `editable` gets eight handles: drag the body to move, a handle to
// resize; arrows nudge (Shift for more, Alt to resize), Delete removes, Escape lets go.
//
// bcn-lego-checked: no esa- lego renders a document page or overlays on an image
// (esa-file-list lists files; esa-loading-overlay is a spinner scrim). Checked Beacon:
// its source-pdf-viewer draws absolute boxes over a pdf.js page, which is this. bcn-page-view is
// the reusable home for "a source page with anchored boxes".
interface Props {
  /** height / width of the page. */
  aspect: number;
}
const { aspect } = Astro.props;
---

<div class="bcn-pv" data-page-view>
  <div class="bcn-pv__sheet" data-pv-sheet style={`aspect-ratio: 1 / ${aspect};`}>
    <canvas class="bcn-pv__img" data-pv-canvas role="img"></canvas>
    <div class="bcn-pv__boxes" data-pv-boxes></div>
    <div class="bcn-pv__drag" data-pv-drag hidden></div>
    <div class="bcn-pv__guide" data-pv-guide hidden></div>
  </div>
</div>

<style>
  .bcn-pv {
    display: flex;
    justify-content: center;
    min-width: 0;
  }

  .bcn-pv__sheet {
    position: relative;
    width: 100%;
    box-shadow: var(--shadow-200);
    border-radius: var(--radius-050);
    overflow: hidden;
  }
  .bcn-pv__sheet[data-selecting] { cursor: crosshair; }

  .bcn-pv__img {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--color-background-elevation-raised);
  }

  .bcn-pv__boxes {
    position: absolute;
    inset: 0;
  }

  /* Boxes are built by the controller, so they are reached through :global(). */
  .bcn-pv__boxes :global(.bcn-pv__box) {
    position: absolute;
    /* Room above for the box's tools when it is scrolled to. */
    scroll-margin: 56px 16px 16px;
    border-radius: 3px;
    animation: bcn-pv-draw 360ms ease-out;
  }
  /* A find: dashed while found, solid once parsed. */
  .bcn-pv__boxes :global(.bcn-pv__box[data-kind='find']) {
    outline: 2px dashed var(--color-commitment);
    outline-offset: 4px;
    background: color-mix(in srgb, var(--color-commitment) 5%, transparent);
    cursor: pointer;
  }
  .bcn-pv__boxes :global(.bcn-pv__box[data-kind='find'][data-parsed]) { outline-style: solid; }
  .bcn-pv__boxes :global(.bcn-pv__box[data-kind='find'][data-selected]) {
    outline-width: 3px;
    background: color-mix(in srgb, var(--color-commitment) 9%, transparent);
  }
  /* A span within a find: fills in as it parses. */
  .bcn-pv__boxes :global(.bcn-pv__box[data-kind='span']) {
    background: color-mix(in srgb, var(--color-requirement) 18%, transparent);
    pointer-events: none;
    animation-duration: 600ms;
  }
  .bcn-pv__boxes :global(.bcn-pv__box[data-kind='span'][data-shade='2']) {
    background: color-mix(in srgb, var(--color-requirement) 30%, transparent);
  }
  /* A region a person marked, before Beacon knows what it is. */
  .bcn-pv__boxes :global(.bcn-pv__box[data-kind='mark']) {
    outline: 2px solid var(--color-content-default);
    outline-offset: 4px;
  }

  /* A box a person drew or adjusted is theirs: solid, whatever the scan thought. */
  .bcn-pv__boxes :global(.bcn-pv__box[data-edited]) { outline-style: solid; }
  .bcn-pv__boxes :global(.bcn-pv__box:focus-visible) {
    outline-color: var(--focus-ring-color);
    outline-style: solid;
  }
  /* Selected and editable: drag the body to move it, a handle to resize it. The handles
     sit on the outline, which is drawn 4px outside the box. */
  .bcn-pv__boxes :global(.bcn-pv__box[data-editable]) { cursor: move; touch-action: none; }
  .bcn-pv__boxes :global(.bcn-pv__handle) {
    position: absolute;
    width: 10px;
    height: 10px;
    margin: -5px 0 0 -5px;
    border: 2px solid var(--color-commitment);
    border-radius: 2px;
    background: var(--color-background-elevation-raised);
  }
  .bcn-pv__boxes :global(.bcn-pv__handle[data-handle='nw']) { left: -4px; top: -4px; cursor: nwse-resize; }
  .bcn-pv__boxes :global(.bcn-pv__handle[data-handle='n']) { left: 50%; top: -4px; cursor: ns-resize; }
  .bcn-pv__boxes :global(.bcn-pv__handle[data-handle='ne']) { left: calc(100% + 4px); top: -4px; cursor: nesw-resize; }
  .bcn-pv__boxes :global(.bcn-pv__handle[data-handle='e']) { left: calc(100% + 4px); top: 50%; cursor: ew-resize; }
  .bcn-pv__boxes :global(.bcn-pv__handle[data-handle='se']) { left: calc(100% + 4px); top: calc(100% + 4px); cursor: nwse-resize; }
  .bcn-pv__boxes :global(.bcn-pv__handle[data-handle='s']) { left: 50%; top: calc(100% + 4px); cursor: ns-resize; }
  .bcn-pv__boxes :global(.bcn-pv__handle[data-handle='sw']) { left: -4px; top: calc(100% + 4px); cursor: nesw-resize; }
  .bcn-pv__boxes :global(.bcn-pv__handle[data-handle='w']) { left: -4px; top: 50%; cursor: ew-resize; }
  .bcn-pv__boxes :global(.bcn-pv__box[data-dragging]) { animation: none; transition: none; }

  /* The selected box's ID and name, sat on its top edge. */
  .bcn-pv__boxes :global(.bcn-pv__chip) {
    position: absolute;
    left: -6px;
    bottom: calc(100% + 8px);
    max-width: min(28rem, 90vw);
    padding: 2px 6px;
    overflow: hidden;
    border-radius: 4px;
    background: var(--color-commitment);
    color: var(--color-content-default-knockout);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.35;
    white-space: nowrap;
    text-overflow: ellipsis;
    pointer-events: none;
  }
  /* Aldo's boxes hidden: the dashed ones go, a person's stay, and so does the selection. */
  .bcn-pv[data-hide-aldo] :global(.bcn-pv__box[data-kind='find']:not([data-mine]):not([data-selected])) { visibility: hidden; }
  /* Split: the box to cut takes a row cursor, and a guide runs across it at the pointer. */
  .bcn-pv__boxes :global(.bcn-pv__box[data-splitting]) { cursor: row-resize; }
  .bcn-pv__guide {
    position: absolute;
    height: 0;
    border-top: 2px dashed var(--color-content-default);
    pointer-events: none;
  }
  .bcn-pv__guide[hidden] { display: none; }

  .bcn-pv__drag {
    position: absolute;
    border: 2px solid var(--color-content-default);
    background: color-mix(in srgb, var(--color-content-default) 8%, transparent);
    pointer-events: none;
  }

  @keyframes bcn-pv-draw {
    from { opacity: 0; clip-path: inset(0 100% 0 0); }
    to { opacity: 1; clip-path: inset(0 0 0 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .bcn-pv__boxes :global(.bcn-pv__box) { animation: none; }
  }
</style>
