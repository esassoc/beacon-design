---
// <BcnSetupQueue> — Model B of two for Component setup. The sibling, <BcnSetupWorkspace>,
// is Model A: a faceted list with bulk power, which makes deciding fast once you have
// started. This one makes STARTING possible, and makes stopping meaningful.
//
// THE ARGUMENT. "52 pending" is not a rendering bug — prod has no pending state at all.
// ComponentCommitment.IsApplicable is a NOT NULL bit, so pending is manufactured by a view
// that LEFT JOINs every component in the project against every commitment in the project
// and calls the misses pending. That number is a cross product: it counts the project, not
// the component, and it RE-INFLATES the moment any source document gains a commitment. A
// list — however well faceted — inherits that arithmetic: it is a pile that never shrinks,
// so nobody opens it. A queue does not argue with the number, it refuses to show it. You
// pick a BATCH with a defined end, you answer one question at a time, and the batch
// finishes. The fix for a treadmill is not a better readout of the belt; it is a length.
//
// WHAT THE DECISION DOES, said before it is made. Applying a commitment materializes its
// actions against this component (prod runs ReconcileImplementationsForApplicabilityChange
// on save) — that is what fills the tracker. Dismissing deletes the deletable ones back
// out. Prod's screen says none of this. Every card here spells it out by code and name.
//
// VOCABULARY. "Actions", never "implementations". "Suggested", never "AI" — the marker is a
// derived attribute overlap (shared species, requirement type, or commitment series with
// something already applied here). It attaches nothing, carries no persona and no sparkle.
//
// PRE-RENDER STRATEGY. Astro is compile-time, so every undecided commitment is rendered
// ONCE as a full card (hidden) and ONCE as a compact summary row (hidden, in a pool). The
// controller only ever toggles `hidden` and moves pooled rows into the summary's three
// lists — the same data-*-panel idiom BcnProjectDataPanel and BcnSearchResults use. No card
// is ever built in JavaScript.
//
// THE FRAME NEVER MOVES. esa-side-dialog's panel is fixed to the viewport edges, so the
// footprint is stable by construction; inside it the progress header and the keyboard
// legend are pinned and only the card region scrolls. A frame that resizes on every card
// would make the queue unusable, which is the one thing it cannot afford to be.
//
// bcn-lego-checked: the frame IS esa-side-dialog (own backdrop, focus trap, Esc + backdrop
// close, working close button, symmetric slide-out), sized through its exposed custom
// properties. esa-progress-bar is the progress readout; esa-button every decision and
// footer action; esa-textarea the optional rationale; esa-badge the quiet Suggested marker
// and the batch counts; esa-kbd the key hints; esa-empty-state the finished-nothing state;
// bcn-commitment-badge the code chip (tone="neutral" for the action codes, which are NOT
// commitments). Checked Ecology for a triage/queue lego — none exists, and esa-card is a
// static container with no notion of one-of-N — and Beacon prod, whose Component setup is
// the broken screen this replaces. bcn-setup-queue is the reusable home; the only bespoke
// primitive is the batch ROW (a selectable two-line radio with a count, which no lego
// renders), and its own CSS is the panel/card/summary composition.
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaBadge from '@esa/ecology/esa-badge.astro';
import EsaKbd from '@esa/ecology/esa-kbd.astro';
import EsaProgressBar from '@esa/ecology/esa-progress-bar.astro';
import EsaEmptyState from '@esa/ecology/esa-empty-state.astro';
import BcnCommitmentBadge from './BcnCommitmentBadge.astro';
import {
  SETUP_COMMITMENTS,
  UNDECIDED,
  NEW_SINCE_REVIEW,
  STANDING_BACKLOG,
  SETUP_TOTALS,
  DECIDED_PERCENT,
  LAST_REVIEWED,
  SETUP_SOURCES,
  SOURCE_BY_ID,
  SPECIES_LABEL,
  fmtDate,
} from '../../data/component-commitments';
import type { ApplicableCommitment } from '../../data/component-commitments';

interface Props {
  id?: string;
  componentName: string;
  heading?: string;
}
const {
  id = 'bcn-setup-queue',
  componentName,
  heading = 'Component setup — review commitments',
} = Astro.props;

const ACTION_TYPE_LABEL: Record<string, string> = {
  tracking: 'Tracking',
  monitoring: 'Monitoring',
  reporting: 'Reporting',
};

// ── The Suggested reason, derived at build time from what is ALREADY APPLIED here ────
// Three rules, checked in order, all of them attributes the fixture actually carries:
// shared species → shared requirement type → shared commitment series. Deterministic, and
// stated as a fact about the data rather than as a recommendation from a voice.
const APPLIED_HERE = SETUP_COMMITMENTS.filter((c) => c.decision === 'applied');
const series = (code: string): string => code.split('-')[0];


// ── The batches. Each one is a door with a number on it, and every number is scoped to
//    THIS component, so the count and the cards behind it are the same set. ────────────
const isNew = (c: ApplicableCommitment): boolean => c.addedOn > LAST_REVIEWED;

const SOURCE_BATCHES = SETUP_SOURCES.map((s) => ({
  key: `source:${s.id}`,
  title: s.name,
  sub: s.short,
  count: UNDECIDED.filter((c) => c.sourceId === s.id).length,
})).filter((b) => b.count > 0);

const speciesLine = (c: ApplicableCommitment): string =>
  c.species.length ? c.species.map((s) => `${s} · ${SPECIES_LABEL[s]}`).join(', ') : 'No species';
---

<esa-side-dialog
  id={id}
  class="bcn-sq"
  data-sq
  data-sq-component={componentName}
  position="right"
  size="lg"
  heading={heading}
>
  <div slot="header" class="bcn-sq__head">
    <span class="bcn-sq__heading">{heading}</span>
    <span class="bcn-sq__component">{componentName}</span>
  </div>

  <div class="bcn-sq__body">
    <!-- ── 1. Batch chooser — the entry state. Nothing here is a list of 52; every row is
         a door with a finite number behind it. ── -->
    <section class="bcn-sq__panel bcn-sq__panel--chooser" data-sq-panel="chooser">
      <div class="bcn-sq-standing">
        <EsaProgressBar value={DECIDED_PERCENT} size="sm" />
        <p class="bcn-sq-standing__line">
          {SETUP_TOTALS.decided} of {SETUP_TOTALS.total} commitments on this component carry a
          decision. {SETUP_TOTALS.undecided} do not. Last decision {fmtDate(LAST_REVIEWED)}.
        </p>
      </div>

      <!-- ONE radiogroup, not two: there is exactly one batch, and the source rows are
           part of the same choice. The h3 sits inside it as a labelled subdivision.
           Roving tabindex + arrow keys are wired in the controller. -->
      <div class="bcn-sq-choice" role="radiogroup" aria-label="Choose a batch to review">
      <div class="bcn-sq-batches">
        <button
          type="button"
          class="bcn-sq-batch"
          role="radio"
          aria-checked="true"
          tabindex="0"
          data-sq-batch="new"
          data-sq-batch-label="New since your last review"
          data-sq-batch-count={SETUP_TOTALS.newSince}
        >
          <span class="bcn-sq-batch__main">
            <span class="bcn-sq-batch__title">
              New since your last review
              <span class="bcn-sq-batch__mark"><EsaBadge value="Recommended" size="sm" /></span>
            </span>
            <span class="bcn-sq-batch__sub">
              Added to the project after {fmtDate(LAST_REVIEWED)}, the last time anyone decided
              anything here.
            </span>
          </span>
          <span class="bcn-sq-batch__count"><EsaBadge value={SETUP_TOTALS.newSince} size="sm" /></span>
        </button>

        <button
          type="button"
          class="bcn-sq-batch"
          role="radio"
          aria-checked="false"
          tabindex="-1"
          data-sq-batch="all"
          data-sq-batch-label="Everything undecided"
          data-sq-batch-count={SETUP_TOTALS.undecided}
        >
          <span class="bcn-sq-batch__main">
            <span class="bcn-sq-batch__title">Everything undecided</span>
            <span class="bcn-sq-batch__sub">
              {STANDING_BACKLOG.length} carried over, {NEW_SINCE_REVIEW.length} new.
            </span>
          </span>
          <span class="bcn-sq-batch__count"><EsaBadge value={SETUP_TOTALS.undecided} size="sm" /></span>
        </button>
      </div>

      <div class="bcn-sq-group">
        <h3 class="bcn-sq-group__title">By source document</h3>
        <div class="bcn-sq-batches">
          {
            SOURCE_BATCHES.map((b) => (
              <button
                type="button"
                class="bcn-sq-batch"
                role="radio"
                aria-checked="false"
                tabindex="-1"
                data-sq-batch={b.key}
                data-sq-batch-label={b.title}
                data-sq-batch-count={b.count}
              >
                <span class="bcn-sq-batch__main">
                  <span class="bcn-sq-batch__title">{b.title}</span>
                  <span class="bcn-sq-batch__sub">{b.sub}</span>
                </span>
                <span class="bcn-sq-batch__count">
                  <EsaBadge value={b.count} size="sm" />
                </span>
              </button>
            ))
          }
        </div>
      </div>
    </div>
    </section>

    <!-- ── 2. The queue — one commitment, full width, in a frame that does not move. ── -->
    <section class="bcn-sq__panel bcn-sq__panel--queue" data-sq-panel="queue" hidden>
      <header class="bcn-sq-progress">
        <div class="bcn-sq-progress__row">
          <span class="bcn-sq-progress__pos" data-sq-position>1 of 1</span>
          <span class="bcn-sq-progress__batch" data-sq-batch-name></span>
        </div>
        <div data-sq-bar><EsaProgressBar value={0} size="sm" /></div>
      </header>

      <div class="bcn-sq-cards" data-sq-cards>
        {
          UNDECIDED.map((c) => (
            <article
              class="bcn-sq-card"
              data-sq-card={c.id}
              data-sq-code={c.code}
              data-sq-title={c.title}
              data-sq-source={c.sourceId}
              data-sq-new={String(isNew(c))}
              data-sq-actions={c.actions.length}
              tabindex="-1"
              aria-labelledby={`${id}-title-${c.id}`}
              hidden
            >
              <header class="bcn-sq-card__head">
                <BcnCommitmentBadge code={c.code} />
                <h3 class="bcn-sq-card__title" id={`${id}-title-${c.id}`}>
                  {c.title}
                </h3>
              </header>

              {/* The one screen where the user must actually READ what they are deciding
                  on — the theme's document voice, at a comfortable reading size. */}
              <p class="bcn-sq-card__text">{c.text}</p>

              <p class="bcn-sq-card__meta">
                {SOURCE_BY_ID[c.sourceId].name}
                <span class="bcn-sq-card__dot">·</span>
                {c.requirementType}
                <span class="bcn-sq-card__dot">·</span>
                {c.requirements} requirements
                <span class="bcn-sq-card__dot">·</span>
                {speciesLine(c)}
              </p>

              {/* The part production omits entirely. */}
              <section class="bcn-sq-does">
                <h4 class="bcn-sq-does__title">What this decision does</h4>
                {c.actions.length > 0 ? (
                  <>
                    <p class="bcn-sq-does__line">
                      Applying this creates {c.actions.length}{' '}
                      {c.actions.length === 1 ? 'action' : 'actions'} on {componentName}:
                    </p>
                    <ul class="bcn-sq-does__list">
                      {c.actions.map((a) => (
                        <li class="bcn-sq-does__item">
                          <BcnCommitmentBadge code={a.code} size="sm" tone="neutral" />
                          <span class="bcn-sq-does__name">{a.name}</span>
                          <span class="bcn-sq-does__type">{ACTION_TYPE_LABEL[a.type]}</span>
                        </li>
                      ))}
                    </ul>
                    <p class="bcn-sq-does__line">
                      Dismissing records it as not applicable, and removes the actions it
                      created here that carry no recorded work.
                    </p>
                  </>
                ) : (
                  <>
                    <p class="bcn-sq-does__line">
                      Applying this creates no actions on {componentName}. It records the
                      commitment as applicable and nothing is materialized.
                    </p>
                    <p class="bcn-sq-does__line">
                      Dismissing records it as not applicable. It created nothing here, so
                      nothing is removed.
                    </p>
                  </>
                )}
              </section>

              {/* One rationale, for one commitment. Never required, never shared — so a
                  decision made in a queue can never silently overwrite another's reason. */}
              <esa-textarea
                class="bcn-sq-card__rationale"
                data-sq-rationale
                label="Rationale (optional)"
                rows="2"
                placeholder="Why this applies, or why it does not."
              ></esa-textarea>

              <div class="bcn-sq-card__decide">
                <EsaButton color="primary" size="md" data-sq-decide="applied">Apply</EsaButton>
                <EsaButton color="secondary" appearance="outline" size="md" data-sq-decide="dismissed">
                  Dismiss
                </EsaButton>
                <EsaButton color="ghost" size="md" data-sq-decide="skipped">Skip</EsaButton>
              </div>
            </article>
          ))
        }
      </div>

      <!-- Pinned, so it never moves under the pointer as cards advance. -->
      <footer class="bcn-sq-keys">
        <span class="bcn-sq-keys__item"><EsaKbd>A</EsaKbd> Apply</span>
        <span class="bcn-sq-keys__item"><EsaKbd>D</EsaKbd> Dismiss</span>
        <span class="bcn-sq-keys__item"><EsaKbd>S</EsaKbd> Skip</span>
        <span class="bcn-sq-keys__item"><EsaKbd>←</EsaKbd> Back</span>
      </footer>
    </section>

    <!-- ── 3. Batch summary — the END. This is the queue's whole argument: it finishes. ── -->
    <section class="bcn-sq__panel bcn-sq__panel--summary" data-sq-panel="summary" hidden>
      <div class="bcn-sq-sum__totals" data-sq-sum-totals>
        <p class="bcn-sq-sum__lead" data-sq-sum-lead></p>
        <p class="bcn-sq-sum__actions" data-sq-sum-actions></p>
      </div>

      <div class="bcn-sq-sum__empty" data-sq-sum-empty hidden>
        <EsaEmptyState
          title="Nothing decided in this batch"
          description="Nothing here carries a decision, so every commitment in the batch stays undecided and nothing is saved."
        />
      </div>

      <section class="bcn-sq-sum__group" data-sq-sum-group="applied" hidden>
        <h3 class="bcn-sq-sum__title">Applied <span data-sq-sum-count="applied"></span></h3>
        <p class="bcn-sq-sum__note">Saving creates the actions listed on each card.</p>
        <ul class="bcn-sq-sum__list" data-sq-sum-list="applied"></ul>
      </section>

      <section class="bcn-sq-sum__group" data-sq-sum-group="dismissed" hidden>
        <h3 class="bcn-sq-sum__title">Dismissed <span data-sq-sum-count="dismissed"></span></h3>
        <p class="bcn-sq-sum__note">
          Recorded as not applicable. Actions they created here that carry no recorded work are
          removed.
        </p>
        <ul class="bcn-sq-sum__list" data-sq-sum-list="dismissed"></ul>
      </section>

      <section class="bcn-sq-sum__group" data-sq-sum-group="skipped" hidden>
        <h3 class="bcn-sq-sum__title">Skipped <span data-sq-sum-count="skipped"></span></h3>
        <p class="bcn-sq-sum__note">These stay undecided and come back in the next batch.</p>
        <ul class="bcn-sq-sum__list" data-sq-sum-list="skipped"></ul>
      </section>
    </section>

    <!-- Summary-row pool: one compact row per undecided commitment, pre-rendered and moved
         into the three lists above. Rendering them here keeps the summary out of JS. -->
    <ul class="bcn-sq-sum__pool" data-sq-srow-pool hidden>
      {
        UNDECIDED.map((c) => (
          <li class="bcn-sq-srow" data-sq-srow={c.id}>
            <BcnCommitmentBadge code={c.code} size="sm" />
            <span class="bcn-sq-srow__title">{c.title}</span>
            {c.actions.length > 0 && (
              <span class="bcn-sq-srow__actions">
                {c.actions.length} {c.actions.length === 1 ? 'action' : 'actions'}
              </span>
            )}
            <span class="bcn-sq-srow__why" data-sq-srow-why hidden />
          </li>
        ))
      }
    </ul>
  </div>

  <!-- Footer — Windows order: the primary sits LEFT of Cancel inside a right-aligned
       group; the step-back action is tertiary, far left. One affordance per action. -->
  <div slot="footer" class="bcn-sq__foot">
    <div class="bcn-sq__foot-left">
      <span data-sq-foot="queue" hidden>
        <EsaButton color="ghost" size="md" data-sq-change-batch>Choose a different batch</EsaButton>
      </span>
      <span data-sq-foot="summary" hidden>
        <EsaButton color="ghost" size="md" data-sq-back-to-queue>Back to the queue</EsaButton>
      </span>
    </div>
    <div class="bcn-sq__foot-right">
      <span data-sq-foot="chooser">
        <EsaButton color="primary" size="md" data-sq-start>Start review</EsaButton>
      </span>
      <span data-sq-foot="queue" hidden>
        <EsaButton color="secondary" appearance="outline" size="md" data-sq-finish>Finish now</EsaButton>
      </span>
      <span data-sq-foot="summary" hidden>
        <EsaButton color="primary" size="md" data-sq-confirm>Save decisions</EsaButton>
      </span>
      <span data-sq-close>
        <EsaButton color="ghost" appearance="outline" size="md">Cancel</EsaButton>
      </span>
    </div>
  </div>
</esa-side-dialog>

<script>
  // Register the legos this drawer composes (each guards its own define), then hand off.
  import '@esa/ecology/esa-side-dialog';
  import '@esa/ecology/esa-textarea';
  import { initSetupQueue } from './setup-queue';
  initSetupQueue();
</script>

<style>
  /* ── Frame geometry. Configured through the lego's own custom properties, which cascade
     into its shadow DOM. WIDE, because the commitment text is the point of the screen; the
     panel is fixed to the viewport edges by the lego, so the footprint is stable by
     construction and cannot resize as cards advance. ── */
  .bcn-sq {
    --side-dialog-width-lg: min(760px, 94vw);
    --z-modal-backdrop: 1300;
    --z-modal: 1301;
    --backdrop-filter: blur(2px);
  }

  /* ── header (projected into the lego's header slot) ── */
  .bcn-sq__head {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .bcn-sq__heading {
    font-size: var(--type-size-400);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    line-height: 1.2;
  }
  .bcn-sq__component {
    font-size: var(--type-size-150);
    color: var(--color-text-secondary);
    line-height: 1.4;
  }

  /* ── body: a fixed-height column so the progress header and key legend pin and only the
     cards scroll. The lego's .body is flex:1 in the panel column, so height:100% here
     resolves against a definite height. ── */
  .bcn-sq__body {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
  }
  .bcn-sq__panel {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-500);
  }
  .bcn-sq__panel[hidden] {
    display: none;
  }
  .bcn-sq__panel--chooser,
  .bcn-sq__panel--summary {
    overflow-y: auto;
  }

  /* ── 1. chooser ─────────────────────────────────────────────────────────────── */
  .bcn-sq-standing {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-250);
  }
  .bcn-sq-standing__line {
    margin: 0;
    font-size: var(--type-size-150);
    line-height: 1.5;
    color: var(--color-text-secondary);
  }

  .bcn-sq-choice {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-500);
  }
  .bcn-sq-batches {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-200);
  }

  /* The batch row: a two-line radio carrying a count. No lego renders a selectable row
     with a trailing badge, so this is the one owned primitive — a real <button> with
     radio semantics, not a styled div. */
  .bcn-sq-batch {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-400);
    width: 100%;
    padding: var(--spacing-300) var(--spacing-400);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-200);
    background: var(--color-surface);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: border-color 120ms ease, background 120ms ease;
  }
  .bcn-sq-batch:hover {
    background: var(--color-surface-sunken);
  }
  .bcn-sq-batch[aria-checked='true'] {
    border-color: var(--color-primary);
    background: var(--color-primary-subtle);
  }
  .bcn-sq-batch:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }
  .bcn-sq-batch__main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-100);
  }
  .bcn-sq-batch__title {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--spacing-200);
    font-size: var(--type-size-250);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    line-height: 1.3;
  }
  .bcn-sq-batch__sub {
    font-size: var(--type-size-150);
    color: var(--color-text-secondary);
    line-height: 1.45;
  }
  /* Quiet neutral counts — a number is information, not a call to action, and the brand
     fill esa-badge defaults to is reserved for the single primary button. */
  .bcn-sq-batch__count :global(.esa-badge) {
    --badge-bg: var(--color-surface-sunken);
    --badge-text-color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
    font-variant-numeric: tabular-nums;
  }
  .bcn-sq-batch__count {
    flex: none;
    display: inline-flex;
    margin-top: 2px;
  }
  .bcn-sq-batch__mark :global(.esa-badge) {
    --badge-bg: var(--color-info-subtle);
    --badge-text-color: var(--color-text-primary);
    border: 1px solid color-mix(in srgb, var(--color-info) 35%, transparent);
    font-weight: var(--font-weight-medium);
  }

  .bcn-sq-group {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-250);
  }
  .bcn-sq-group__title {
    margin: 0;
    font-size: var(--type-size-250);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
  }

  /* ── 2. queue ───────────────────────────────────────────────────────────────── */
  .bcn-sq__panel--queue {
    gap: var(--spacing-400);
  }
  .bcn-sq-progress {
    flex: none;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-200);
  }
  .bcn-sq-progress__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--spacing-300);
  }
  .bcn-sq-progress__pos {
    font-size: var(--type-size-200);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    font-variant-numeric: tabular-nums;
  }
  .bcn-sq-progress__batch {
    font-size: var(--type-size-150);
    color: var(--color-text-secondary);
    text-align: right;
    min-width: 0;
  }

  .bcn-sq-cards {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
  }
  .bcn-sq-card {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-400);
    padding: var(--spacing-500);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-300);
    background: var(--color-surface);
  }
  .bcn-sq-card[hidden] {
