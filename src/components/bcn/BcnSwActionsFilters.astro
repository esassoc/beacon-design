---
// <BcnSwActionsFilters> — the band that scopes the board: one phase, one requirement
// type, and the count that results. Prod carried all three inline inside the step's H2
// ("Actions during [Phase v] for [Type v] (N)"); here each control gets its own label
// and the count is a labeled field rather than a bare badge welded to a heading.
//
// PHASE IS A SEGMENTED CONTROL, NOT PILLS. esa-pill renders a <span>: it can show which
// phase is chosen but it cannot be pressed, focused, or arrowed between, so a row of
// them is a picture of a filter. esa-button-toggle is the kit's one-of-N control, it
// carries a real radiogroup with roving tabindex, and — the deciding property — its
// `value` is a declared reactive property, so the current selection can be set from
// markup with no script. That last point is not true of esa-select or
// esa-filter-dropdown, whose selection lives in private state and can only be seeded by
// a controller at runtime.
//
// TYPE IS A DROPDOWN MENU WITH A SLOTTED TRIGGER, which is exactly prod's shape
// (ui-dropdown + a trigger button showing the current value). Twelve requirement types
// is too many for a segmented control, and this is the one remaining lego whose
// resting-state label is authored rather than derived from hidden state.
//
// bcn-lego-checked: esa-button-toggle is the phase control, esa-dropdown-menu plus a
// slotted esa-button is the type control, and BcnKeyValue supplies the label tier for
// the two controls that do not bring their own (it mirrors esa-select's field label
// exactly, so all three labels line up). Checked Ecology for a filter BAR lego —
// esa-filter-container is a panel of stacked filter groups for a sidebar, and
// esa-filter-pills renders already-applied filters as removable chips, neither of which
// is a one-line scope band — and Beacon, whose equivalent is the H2 this replaces.
// bcn-sw-actions-filters is the reusable home for the band.
import EsaButton from '@esa/ecology/esa-button.astro';
import BcnKeyValue from './BcnKeyValue.astro';

interface Props {
  /** Label over the phase control. */
  phaseLabel: string;
  /** The project's lifecycle, in order. */
  phases: readonly string[];
  /** The phase currently scoping the board. */
  activePhase: string;
  /** Label over the type control. */
  typeLabel: string;
  /** The requirement type currently scoping the board, as displayed. */
  activeType: string;
  /** Every requirement type, for the menu. */
  typeOptions: readonly string[];
  /** Names what `resultCount` counts. */
  resultLabel: string;
  /** How many records match both filters. */
  resultCount: number;
}
const { phaseLabel, phases, activePhase, typeLabel, activeType, typeOptions, resultLabel, resultCount } =
  Astro.props;

const phaseJson = JSON.stringify(phases.map((p) => ({ label: p, value: p })));
const typeJson = JSON.stringify(typeOptions.map((t) => ({ label: t, action: t })));
---

<div class="bcn-swaf">
  <esa-button-toggle
    class="bcn-swaf__phase"
    label={phaseLabel}
    size="md"
    options={phaseJson}
    value={activePhase}></esa-button-toggle>

  <div class="bcn-swaf__type">
    <BcnKeyValue label={typeLabel}>
      <esa-dropdown-menu position="below-start" width="auto" items={typeJson}>
        <EsaButton variant="chrome" appearance="outline" size="md" iconRight="chevron-down">
          {activeType}
        </EsaButton>
      </esa-dropdown-menu>
    </BcnKeyValue>
  </div>

  <div class="bcn-swaf__result">
    <BcnKeyValue label={resultLabel} value={resultCount.toLocaleString()} />
  </div>
</div>

<script>
  // Registration only — both are Lit custom elements that ship their own behavior.
  import '@esa/ecology/esa-button-toggle';
  import '@esa/ecology/esa-dropdown-menu';
</script>

<style>
  .bcn-swaf {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--spacing-300) var(--spacing-500);
    padding: var(--spacing-400);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md);
    background: var(--color-background-elevation-sunken);
  }
  .bcn-swaf__phase {
    flex: 1 1 auto;
    min-width: 0;
  }
  .bcn-swaf__type {
    flex: 0 0 auto;
  }
  /* The result count closes the band on the right: it is what the two controls to its
     left produced. */
  .bcn-swaf__result {
    flex: 0 0 auto;
    margin-left: auto;
    padding-left: var(--spacing-500);
    border-left: 1px solid var(--color-border-default-subtle);
  }
  .bcn-swaf__result :global(.bcn-key-value__val) {
    font-size: var(--typography-title-sm-strong-font-size);
    font-variant-numeric: tabular-nums;
  }
  /* The dropdown trigger sits in BcnKeyValue's value slot, which stacks — pull it onto
     the same rhythm as the toggle's own segments. */
  .bcn-swaf__type :global(.bcn-key-value) {
    gap: var(--spacing-150);
  }
</style>
