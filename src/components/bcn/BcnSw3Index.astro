---
// <BcnSw3Index> — step 3's workspace: the Compliance Index, in develop's two phases.
//
// The three panes from the start. No index yet: the index pane and Aldo are empty and the
// center holds an empty state (Build index and + Category are keys in the step's console,
// bcn-sw3-index-actions). Building: the run streams in the console's log
// (bcn-sw3-index-run) and the center is blank. Then step 2's shell, under the step's panel (whose foot carries the
// subcategory scrubber, bcn-sw-step-nav hook "ix"): the index (left, edited by hand,
// folds to a rail), the subcategory in view (center), and Aldo, one conversation per
// subcategory (right). Before drafting, the center shows what the proposal cited for the
// subcategory and Aldo takes Re-run guidance; once drafted, the center is the review.
//
// A locator opens the commitment it rests on (bcn-sw3-commitment-panel), so the page carries
// step 2's payload as well as the plan.
//
// Composes: esa-empty-state, esa-button,
// bcn-sw3-index-tree, bcn-sw3-index-page, bcn-sw3-index-aldo.
//
// bcn-lego-checked: the empty state IS esa-empty-state; the panes are the review's own grid, as step 2's
// bcn-sw3-review is. Checked Beacon: compliance-index-step is a bin sidebar and a main pane
// with no strip of bins. bcn-sw3-index is this step's home.
import EsaEmptyState from '@esa/ecology/esa-empty-state.astro';
import BcnSw3IndexTree from './BcnSw3IndexTree.astro';
import BcnSw3IndexPage from './BcnSw3IndexPage.astro';
import BcnSw3IndexAldo from './BcnSw3IndexAldo.astro';
import PLAN from '../../data/sw3-index.json';
import type { Sw3IndexPlan } from '../../data/sw3-index-types';
import { REVIEW_DOCS } from '../../data/sw3-docs';

const plan = PLAN as unknown as Sw3IndexPlan;
---

<section class="bcn-sw3ix" data-sw3-ix data-aldo="open" data-index="open" data-phase="empty">
  <div class="bcn-sw3ix__start">
    <div data-ix-empty>
      <EsaEmptyState title="No index yet" description={`Build it from ${plan.requirements.toLocaleString('en-US')} approved requirements.`} />
    </div>
  </div>

  <div class="bcn-sw3ix__tree">
    <BcnSw3IndexTree />
  </div>

  <div class="bcn-sw3ix__page" data-ix-page>
    <BcnSw3IndexPage />
  </div>

  <div class="bcn-sw3ix__aldo">
    <BcnSw3IndexAldo />
  </div>

  <script type="application/json" data-sw3-index set:html={JSON.stringify(plan)} />
  <script type="application/json" data-sw3-payload set:html={JSON.stringify({ docs: REVIEW_DOCS })} />
</section>

<style>
  /* The workspace fills the window below the step's panel (sw3-index.ts sets --_fit); only
     the panes scroll. */
  .bcn-sw3ix {
    display: grid;
    grid-template-columns: 17rem minmax(0, 1fr) 22rem;
    grid-template-rows: minmax(0, 1fr);
    gap: var(--spacing-300);
    height: var(--_fit, calc(100vh - 14rem));
    min-height: 520px;
    --color-background-brand-muted: var(--color-background-elevation-raised);
    --color-background-brand-muted-hover: var(--color-background-elevation-sunken);
    --color-content-on-brand-muted: var(--color-content-default);
  }
  .bcn-sw3ix[data-index='closed'] { grid-template-columns: 2.75rem minmax(0, 1fr) 22rem; }
  .bcn-sw3ix[data-aldo='closed'] { grid-template-columns: 17rem minmax(0, 1fr) 2.75rem; }
  .bcn-sw3ix[data-index='closed'][data-aldo='closed'] { grid-template-columns: 2.75rem minmax(0, 1fr) 2.75rem; }

  /* No index yet, or one on its way: the center pane is the start; the index and Aldo
     stand empty beside it. */
  .bcn-sw3ix__start {
    grid-column: 2;
    grid-row: 1;
    display: none;
    align-items: center;
    justify-content: center;
    min-height: 0;
    background: var(--color-background-elevation-raised);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-200);
  }
  .bcn-sw3ix[data-phase='empty'] .bcn-sw3ix__start,
  .bcn-sw3ix[data-phase='building'] .bcn-sw3ix__start { display: flex; }
  .bcn-sw3ix[data-phase='building'] [data-ix-empty] { display: none; }
  .bcn-sw3ix[data-phase='empty'] .bcn-sw3ix__page,
  .bcn-sw3ix[data-phase='building'] .bcn-sw3ix__page { display: none; }

  .bcn-sw3ix__tree,
  .bcn-sw3ix__page {
    min-height: 0;
    overflow-y: auto;
    background: var(--color-background-elevation-raised);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-200);
  }
  .bcn-sw3ix__tree { overflow: hidden; }
  .bcn-sw3ix__aldo { grid-column: 3; grid-row: 1; min-height: 0; display: flex; flex-direction: column; }
  .bcn-sw3ix__aldo > :global(*) { flex: 1; min-height: 0; }

  @media (max-width: 1280px) {
    .bcn-sw3ix { grid-template-columns: 15rem minmax(0, 1fr) 20rem; }
    .bcn-sw3ix[data-aldo='closed'] { grid-template-columns: 15rem minmax(0, 1fr) 2.75rem; }
    .bcn-sw3ix[data-index='closed'] { grid-template-columns: 2.75rem minmax(0, 1fr) 20rem; }
  }
</style>

<script>
  import { setupSw3Index } from './sw3-index';
  document.querySelectorAll<HTMLElement>('[data-sw3-ix]').forEach(setupSw3Index);
</script>
