---
// <BcnSw3Index> — step 3's workspace: the Compliance Index, in develop's two phases.
//
// No index yet: an empty state with Build index and + Category. Building: the proposal is
// on its way. Then step 2's shell: the subcategory scrubber across the top (a rule and the
// category's name where each category starts); under it the index (left, edited by hand,
// folds to a rail), the subcategory in view (center), and Aldo, one conversation per
// subcategory (right). Before drafting, the center shows what the proposal cited for the
// subcategory and Aldo takes Re-run guidance; once drafted, the center is the review.
//
// A locator opens the commitment it rests on (bcn-sw3-commitment-panel), so the page carries
// step 2's payload as well as the plan.
//
// Composes: esa-empty-state, esa-loading-spinner, esa-button, bcn-commitment-scrubber,
// bcn-sw3-index-tree, bcn-sw3-index-page, bcn-sw3-index-aldo.
//
// bcn-lego-checked: every key is esa-button; the empty and building states ARE
// esa-empty-state and esa-loading-spinner; the panes are the review's own grid, as step 2's
// bcn-sw3-review is. Checked Beacon: compliance-index-step is a bin sidebar and a main pane
// with no strip of bins. bcn-sw3-index is this step's home.
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaEmptyState from '@esa/ecology/esa-empty-state.astro';
import EsaLoadingSpinner from '@esa/ecology/esa-loading-spinner.astro';
import BcnCommitmentScrubber from './BcnCommitmentScrubber.astro';
import BcnSw3IndexTree from './BcnSw3IndexTree.astro';
import BcnSw3IndexPage from './BcnSw3IndexPage.astro';
import BcnSw3IndexAldo from './BcnSw3IndexAldo.astro';
import PLAN from '../../data/sw3-index.json';
import type { Sw3IndexPlan } from '../../data/sw3-index-types';
import { REVIEW_DOCS } from '../../data/sw3-docs';

const plan = PLAN as unknown as Sw3IndexPlan;
---

<section class="bcn-sw3ix" data-sw3-ix data-aldo="open" data-index="open" data-phase="empty">
  <div class="bcn-sw3ix__start" data-ix-empty>
    <EsaEmptyState title="No index yet" description={`Build it from ${plan.requirements.toLocaleString('en-US')} approved requirements.`}>
      <EsaButton variant="primary" size="md" icon="sparkles" data-ix-build>Build index</EsaButton>
      <EsaButton variant="secondary" size="md" icon="plus" data-ix-add-cat>Category</EsaButton>
    </EsaEmptyState>
  </div>
  <div class="bcn-sw3ix__start" data-ix-building>
    <EsaLoadingSpinner size="md" label="Building the index" />
    <p class="bcn-sw3ix__building">Building the index</p>
  </div>

  <div class="bcn-sw3ix__nav">
    <div class="bcn-sw3ix__where">
      <span class="bcn-sw3ix__pos" data-ix-pos></span>
      <span data-ix-next-open><EsaButton variant="secondary" size="xs" iconRight="arrow-right">Next to review</EsaButton></span>
    </div>
    <BcnCommitmentScrubber label="Subcategory" />
  </div>

  <div class="bcn-sw3ix__tree">
    <BcnSw3IndexTree />
  </div>

  <div class="bcn-sw3ix__page" data-ix-page>
    <BcnSw3IndexPage />
  </div>

  <div class="bcn-sw3ix__aldo">
    <BcnSw3IndexAldo />
  </div>

  <script type="application/json" data-sw3-index set:html={JSON.stringify(plan)} />
  <script type="application/json" data-sw3-payload set:html={JSON.stringify({ docs: REVIEW_DOCS })} />
</section>

<style>
  /* The workspace fills the window below the step's panel (sw3-index.ts sets --_fit); only
     the panes scroll. */
  .bcn-sw3ix {
    display: grid;
    grid-template-columns: 17rem minmax(0, 1fr) 22rem;
    grid-template-rows: auto minmax(0, 1fr);
    gap: var(--spacing-300);
    height: var(--_fit, calc(100vh - 14rem));
    min-height: 520px;
    --color-background-brand-muted: var(--color-background-elevation-raised);
    --color-background-brand-muted-hover: var(--color-background-elevation-sunken);
    --color-content-on-brand-muted: var(--color-content-default);
  }
  .bcn-sw3ix[data-index='closed'] { grid-template-columns: 2.75rem minmax(0, 1fr) 22rem; }
  .bcn-sw3ix[data-aldo='closed'] { grid-template-columns: 17rem minmax(0, 1fr) 2.75rem; }
  .bcn-sw3ix[data-index='closed'][data-aldo='closed'] { grid-template-columns: 2.75rem minmax(0, 1fr) 2.75rem; }

  /* No index yet, or one on its way: the whole workspace is the start. */
  .bcn-sw3ix__start {
    grid-column: 1 / -1;
    grid-row: 1 / -1;
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-300);
    background: var(--color-background-elevation-raised);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-200);
  }
  .bcn-sw3ix[data-phase='empty'] [data-ix-empty],
  .bcn-sw3ix[data-phase='building'] [data-ix-building] { display: flex; }
  .bcn-sw3ix[data-phase='empty'] > :not(.bcn-sw3ix__start, script),
  .bcn-sw3ix[data-phase='building'] > :not(.bcn-sw3ix__start, script) { display: none; }
  .bcn-sw3ix__building { margin: 0; font-size: 0.9375rem; font-weight: 500; color: var(--color-content-default-secondary); }

  .bcn-sw3ix__nav {
    grid-column: 1 / 3;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-150);
    padding: var(--spacing-200) var(--spacing-400) var(--spacing-150);
    background: var(--color-background-elevation-raised);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-200);
  }
  .bcn-sw3ix__where { display: flex; align-items: center; justify-content: space-between; gap: var(--spacing-300); min-height: 28px; }
  .bcn-sw3ix__where [hidden] { display: none; }
  .bcn-sw3ix__pos {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-content-default-secondary);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .bcn-sw3ix__tree,
  .bcn-sw3ix__page {
    min-height: 0;
    overflow-y: auto;
    background: var(--color-background-elevation-raised);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-200);
  }
  .bcn-sw3ix__tree { overflow: hidden; }
  .bcn-sw3ix__aldo { grid-column: 3; grid-row: 1 / 3; min-height: 0; display: flex; flex-direction: column; }
  .bcn-sw3ix__aldo > :global(*) { flex: 1; min-height: 0; }

  @media (max-width: 1280px) {
    .bcn-sw3ix { grid-template-columns: 15rem minmax(0, 1fr) 20rem; }
    .bcn-sw3ix[data-aldo='closed'] { grid-template-columns: 15rem minmax(0, 1fr) 2.75rem; }
    .bcn-sw3ix[data-index='closed'] { grid-template-columns: 2.75rem minmax(0, 1fr) 20rem; }
  }
</style>

<script>
  import { setupSw3Index } from './sw3-index';
  document.querySelectorAll<HTMLElement>('[data-sw3-ix]').forEach(setupSw3Index);
</script>
