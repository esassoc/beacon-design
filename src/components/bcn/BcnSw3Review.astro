---
// <BcnSw3Review> — step 2: one commitment at a time, carved into structured data, for a
// QA/QC pass before the Compliance Index turns it into actions and obligations.
//
// Layout: the commitment scrubber across the top (every commitment, colored by what is left
// to do); under it the commitment as a marked-up page (left), everything parsed out of it,
// read only (the rail), and Aldo, who takes corrections in plain words (right). Nothing on
// the page is a form: a requirement's record changes in its side panel (Edit) or by telling
// Aldo; its words change by telling Aldo.
//
// The scan may still be running: commitments appear as they are found, and fill in as they
// parse. Rendering is from sw3-store.
//
// Composes: bcn-commitment-scrubber, bcn-sw3-commitment, bcn-sw3-attributes,
// bcn-sw3-review-aldo, esa-button.
//
// bcn-lego-checked: every key is esa-button; the panes are the review's own grid, as
// step 1's workspace is. Checked Beacon: its commitment page is tabs (Overview,
// Requirements, Revision History) on a page per commitment, with no review queue.
// bcn-sw3-review is this step's home.
import EsaButton from '@esa/ecology/esa-button.astro';
import BcnCommitmentScrubber from './BcnCommitmentScrubber.astro';
import BcnSw3Commitment from './BcnSw3Commitment.astro';
import BcnSw3Attributes from './BcnSw3Attributes.astro';
import BcnSw3ReviewAldo from './BcnSw3ReviewAldo.astro';
import { paintAnchored } from './anchored-text-paint';
import { COMMITMENTS, REQUIREMENT_BY_ID } from '../../data/setup-wizard-3-step';
import { REVIEW_DOCS } from '../../data/sw3-docs';
import { withBase } from '../../lib/base';

const first = COMMITMENTS[0];
const firstHtml = paintAnchored({
  text: first.text,
  spans: first.requirementIds
    .map((id) => REQUIREMENT_BY_ID.get(id)!)
    .filter((r) => r.anchor)
    .map((r) => ({ id: r.id, start: r.anchor!.charStart, end: r.anchor!.charEnd, suggested: true, label: r.name })),
  gaps: [],
  family: 'amber',
});
---

<section class="bcn-sw3rev" data-sw3-review data-aldo="open" data-base={withBase('/')}>
  <div class="bcn-sw3rev__nav">
    <div class="bcn-sw3rev__where">
      <span class="bcn-sw3rev__pos" data-rev-pos></span>
      <span data-rev-next-open><EsaButton variant="secondary" size="xs" iconRight="arrow-right">Next to settle</EsaButton></span>
    </div>
    <BcnCommitmentScrubber label="Commitment" />
  </div>

  <div class="bcn-sw3rev__doc" data-rev-doc>
    <BcnSw3Commitment code={first.code} title={first.title} pages={first.pages} html={firstHtml} />
  </div>

  <aside class="bcn-sw3rev__attrs" aria-label="Parsed from the commitment">
    <BcnSw3Attributes />
  </aside>

  <div class="bcn-sw3rev__aldo">
    <BcnSw3ReviewAldo />
  </div>

  <script type="application/json" data-sw3-payload set:html={JSON.stringify({ docs: REVIEW_DOCS })} />
</section>

<style>
  /* The workspace fills the window below the step's panel (sw3-review.ts sets --_fit);
     only the panes scroll. */
  .bcn-sw3rev {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 19rem 22rem;
    grid-template-rows: auto minmax(0, 1fr);
    gap: var(--spacing-300);
    height: var(--_fit, calc(100vh - 14rem));
    min-height: 520px;
    --color-background-brand-muted: var(--color-background-elevation-raised);
    --color-background-brand-muted-hover: var(--color-background-elevation-sunken);
    --color-content-on-brand-muted: var(--color-content-default);
  }
  .bcn-sw3rev[data-aldo='closed'] { grid-template-columns: minmax(0, 1fr) 21rem 2.75rem; }

  .bcn-sw3rev__nav {
    grid-column: 1 / 3;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-150);
    padding: var(--spacing-200) var(--spacing-400) var(--spacing-150);
    background: var(--color-background-elevation-raised);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-200);
  }
  .bcn-sw3rev__where { display: flex; align-items: center; justify-content: space-between; gap: var(--spacing-300); min-height: 28px; }
  .bcn-sw3rev__pos {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-content-default-secondary);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .bcn-sw3rev__doc,
  .bcn-sw3rev__attrs {
    min-height: 0;
    overflow-y: auto;
    background: var(--color-background-elevation-raised);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-200);
  }
  .bcn-sw3rev__aldo { grid-column: 3; grid-row: 1 / 3; min-height: 0; display: flex; flex-direction: column; }
  .bcn-sw3rev__aldo > :global(*) { flex: 1; min-height: 0; }

  @media (max-width: 1280px) {
    .bcn-sw3rev { grid-template-columns: minmax(0, 1fr) 16rem 20rem; }
    .bcn-sw3rev[data-aldo='closed'] { grid-template-columns: minmax(0, 1fr) 18rem 2.75rem; }
  }
</style>

<script>
  import { setupSw3Review } from './sw3-review';
  document.querySelectorAll<HTMLElement>('[data-sw3-review]').forEach(setupSw3Review);
</script>
