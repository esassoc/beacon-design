---
// <BcnHelpDots> — the help-dot layer for one page. On a page that mounts it, Guidance on
// the Guidance bar turns the dots on instead of opening the drawer (round 4): a pulsing Aldo
// dot (<BcnHelpDot>) on each spot that has a published dot, a popover about that thing on
// click. A dark button above the bar, Open Help & Guidance, opens the drawer. Guidance
// again, or Esc, turns the dots off. Pages without this layer keep Guidance opening the
// drawer.
//
// Each dot is placed by measuring its spot's target against this layer, which sits in the
// page's own scroll container, so dots scroll with the page and need re-measuring only
// when the layout moves. A dot whose spot is missing from the page is hidden.
//
// ADMIN (`?as=admin`, round 15). ESA admins also see draft dots, muted, and work the
// dots by hand on the page:
//   - Add Dot (the drawer segment's header) or Option/Alt-click anywhere arms placement. A
//     dot rides the pointer, the part under it is outlined with its name, a click drops the
//     dot there and opens <BcnHelpDotEditor> beside it.
//   - Drag any dot onto another part to move it; the editor opens with "Check this text
//     still fits". Pick Again on a dot whose spot is gone arms the same placement.
//   - A part is anything carrying a `data-help-spot` id (src/lib/help-spot.ts); the
//     outline snaps to the nearest one under the pointer.
// The pick bar along the top says what a click will do and carries Cancel.
//
// All behavior lives in the help-dots controller (help-dots.ts). Contract with siblings,
// all by data-* hook:
//   - bar (<BcnHelpBar>): the controller sets `data-help-dots-claimed` on `[data-help-trigger]`
//     so the drawer leaves it alone, and `aria-pressed` while the dots show.
//   - drawer (<BcnGuidanceDrawer>, `[data-gd]`): `[data-help-dots-admin-slot]` receives
//     <BcnHelpDotsAdmin>.
//   - admin list (<BcnHelpDotsAdmin>): `data-hda-*`. Editor (<BcnHelpDotEditor>, mounted
//     here): `data-hde-*`.
//
// TONE. The popovers take the Guidance bar's dark (round 2). `?popover=light` puts back
// the light panel for comparison.
//
// bcn-lego-checked: the HIGHLIGHT is a positioned outline drawn around a measured box and
// the carried dot is the Aldo mark following the pointer, which no esa-* lego renders; the pick bar reuses the Guidance bar's dark
// glass tokens and its Cancel IS esa-button; so does the panel bar, whose button IS esa-button. Everything else is a lego or a bcn-help-dot.
// Checked Beacon: nothing places marks on a page. bcn-help-dots is the home.
import BcnAldoMark from './aldo/BcnAldoMark.astro';
import BcnHelpDot from './BcnHelpDot.astro';
import BcnHelpDotEditor from './BcnHelpDotEditor.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import type { HelpDotPage } from '../../data/help-dots';
import { withBase } from '../../lib/base';

interface Props {
  page: HelpDotPage;
}
const { page } = Astro.props;

// The controller's copy of the page: dots with their image paths resolved, and the base
// the spot captures sit under.
const resolve = <T extends { src: string }>(shot: T): T => ({ ...shot, src: withBase(shot.src) });
const clientPage = {
  routeKey: page.routeKey,
  spots: page.spots,
  dots: page.dots.map((d) => ({ ...d, shot: d.shot ? resolve(d.shot) : undefined })),
  base: withBase('/'),
};
---

<div class="bcn-help-dots" data-help-dots data-route-key={page.routeKey} hidden>
  {page.dots.map((dot) => <BcnHelpDot dot={dot} />)}

  <BcnHelpDotEditor />

  <template data-help-dot-template>
    <BcnHelpDot />
  </template>
</div>

<div class="bcn-help-dots__highlight bcn-help-dots__highlight--hover" data-help-highlight-hover hidden></div>
<div class="bcn-help-dots__highlight" data-help-highlight hidden>
  <span class="bcn-help-dots__highlight-label typography-label-xs-strong" data-help-highlight-label></span>
</div>
<div class="bcn-help-dots__carry" data-help-carry hidden>
  <BcnAldoMark size="sm" />
</div>

<div class="bcn-help-dots__pickbar cluster" data-gap="sm" data-help-pickbar role="status" hidden>
  <BcnAldoMark size="sm" />
  <span class="bcn-help-dots__pickbar-text" data-help-pick-text>Click a part of the page to put a dot on it</span>
  <EsaButton variant="chrome" size="sm" data-help-pick-cancel>Cancel</EsaButton>
</div>

<div class="bcn-help-dots__panelbar" data-help-panelbar hidden>
  <EsaButton variant="chrome" size="sm" data-help-panel-open>Open Help &amp; Guidance</EsaButton>
</div>

<script type="application/json" data-help-dots-page set:html={JSON.stringify(clientPage)} />

<script>
  import { setupHelpDots } from './help-dots';
  setupHelpDots();
</script>

<style>
  /* A zero-height box in the page's flow: it scrolls with the page, and each dot and
     the editor is positioned from its top-left corner. */
  .bcn-help-dots {
    position: relative;
    block-size: 0;
  }

  /* Placing or dragging: the part the dot would land on, outlined in Aldo green with its
     name on its top edge. Fixed and click-through, so it never takes the pointer. */
  .bcn-help-dots__highlight {
    position: fixed;
    inset-inline-start: var(--_x, 0);
    inset-block-start: var(--_y, 0);
    inline-size: var(--_w, 0);
    block-size: var(--_h, 0);
    z-index: 990;
    border: 2px solid var(--bcn-aldo);
    border-radius: var(--radius-200);
    background: color-mix(in srgb, var(--bcn-aldo-50) 45%, transparent);
    pointer-events: none;
  }
  /* The part under the pointer when its dot shows on another, first one: faint. */
  .bcn-help-dots__highlight--hover {
    border: 1px dashed color-mix(in srgb, var(--bcn-aldo) 60%, transparent);
    background: color-mix(in srgb, var(--bcn-aldo-50) 30%, transparent);
  }
  .bcn-help-dots__highlight-label {
    position: absolute;
    inset-inline-start: -2px;
    inset-block-end: 100%;
    padding: 2px var(--spacing-150);
    border-radius: var(--radius-200) var(--radius-200) 0 0;
    background: var(--bcn-aldo);
    color: var(--color-content-default-knockout);
    white-space: nowrap;
  }
  /* The dot being carried to its spot, on the pointer. */
  .bcn-help-dots__carry {
    position: fixed;
    inset-inline-start: var(--_x, 0);
    inset-block-start: var(--_y, 0);
    z-index: 995;
    translate: -50% -50%;
    line-height: 0;
    pointer-events: none;
    filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.3));
  }
  .bcn-help-dots__carry :global(.bcn-aldo-mark) {
    background: var(--bcn-aldo-raised-fill);
    box-shadow: var(--bcn-aldo-raised-shadow);
  }
  /* While placing, the page under the pointer is a target, not a link. */
  :global(html[data-help-placing]),
  :global(html[data-help-placing] *) {
    cursor: crosshair !important;
  }

  /* The pick bar and the panel bar: the Guidance bar's dark glass. */
  .bcn-help-dots__pickbar,
  .bcn-help-dots__panelbar {
    position: fixed;
    inset-inline-start: 50%;
    translate: -50% 0;
    z-index: 1000;
    color: var(--bcn-helpbar-fg);
    background: var(--bcn-helpbar-bg);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    backdrop-filter: blur(14px) saturate(1.4);
    border: 1px solid var(--bcn-helpbar-border);
    border-radius: var(--radius-400, 14px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.28); /* the Guidance bar's lift */
  }
  /* Along the top of the page, under the 52px topbar. */
  .bcn-help-dots__pickbar {
    inset-block-start: 68px;
    padding: var(--spacing-100) var(--spacing-100) var(--spacing-100) var(--spacing-250);
  }
  /* Just above the Guidance bar (20px off the bottom, 58px tall), so it reads as part of it. */
  .bcn-help-dots__panelbar {
    inset-block-end: 86px;
    padding: var(--spacing-075, 3px);
  }
  .bcn-help-dots__pickbar-text {
    font-weight: var(--typography-font-weight-medium);
    white-space: nowrap;
  }
  .bcn-help-dots__pickbar :global(.esa-button),
  .bcn-help-dots__panelbar :global(.esa-button) {
    color: var(--bcn-helpbar-fg);
    --focus-ring-color: var(--bcn-helpbar-fg);
  }

  .bcn-help-dots[hidden],
  .bcn-help-dots__highlight[hidden],
  .bcn-help-dots__carry[hidden],
  .bcn-help-dots__pickbar[hidden],
  .bcn-help-dots__panelbar[hidden] {
    display: none;
  }
</style>
