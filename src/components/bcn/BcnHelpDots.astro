---
// <BcnHelpDots> — the help-dot layer for one page. Switched on from the Help & Guidance
// drawer, it puts a pulsing Aldo dot (<BcnHelpDot>) on each spot that has a published dot;
// a click opens a popover about that thing. Switched off, the dots are gone. The switch
// only shows on a page that mounts this layer.
//
// Each dot is placed by measuring its spot's target against this layer, which sits in the
// page's own scroll container, so dots scroll with the page and need re-measuring only
// when the layout moves. A dot whose spot is missing from the page is hidden.
//
// ADMIN (round 3, `?as=admin`). ESA admins also see draft dots, muted, and get pick
// mode: Add Dot (or Pick Again) closes the drawer, outlines every free spot on the page,
// and leaves the used spots showing their dots; clicking an outline reopens the drawer on
// the dot form (<BcnHelpDotForm>). The pick bar along the top carries Cancel.
//
// All behavior lives in the help-dots controller (help-dots.ts). Contract with siblings,
// all by data-* hook:
//   - drawer (<BcnGuidanceDrawer>, `[data-gd]`): `[data-help-dots-slot]` holds the switch
//     `[data-help-dots-toggle]`; `[data-help-dots-admin-slot]` receives <BcnHelpDotsAdmin>.
//   - admin list (<BcnHelpDotsAdmin>): `data-hda-*`. Form (<BcnHelpDotForm>): `data-hdf-*`.
//
// TONE. The popovers take the Guidance bar's dark (round 2). `?popover=light` puts back
// the light panel for comparison.
//
// bcn-lego-checked: the spot OUTLINE in pick mode is a positioned button drawn around a
// measured box, which no esa-* lego renders; the pick bar reuses the Guidance bar's dark
// glass tokens and its Cancel IS esa-button. Everything else is a lego or a bcn-help-dot.
// Checked Beacon: nothing places marks on a page. bcn-help-dots is the home.
import BcnAldoMark from './aldo/BcnAldoMark.astro';
import BcnHelpDot from './BcnHelpDot.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import type { HelpDotPage } from '../../data/help-dots';
import { withBase } from '../../lib/base';

interface Props {
  page: HelpDotPage;
}
const { page } = Astro.props;

// The controller's copy of the page: spots and dots with their image paths resolved.
const resolve = <T extends { src: string }>(shot: T): T => ({ ...shot, src: withBase(shot.src) });
const clientPage = {
  routeKey: page.routeKey,
  spots: page.spots.map((s) => ({ ...s, capture: resolve(s.capture) })),
  dots: page.dots.map((d) => ({ ...d, shot: d.shot ? resolve(d.shot) : undefined })),
};
---

<div class="bcn-help-dots" data-help-dots data-route-key={page.routeKey} hidden>
  {page.dots.map((dot) => <BcnHelpDot dot={dot} />)}

  {
    page.spots.map((spot) => (
      <button
        type="button"
        class="bcn-help-dots__outline"
        data-help-spot-outline
        data-spot={spot.spot}
        aria-label={`Put a dot on ${spot.label}`}
        hidden
      >
        <span class="bcn-help-dots__outline-label typography-label-xs-strong">{spot.label}</span>
      </button>
    ))
  }

  <template data-help-dot-template>
    <BcnHelpDot />
  </template>
</div>

<div class="bcn-help-dots__pickbar cluster" data-gap="sm" data-help-pickbar role="status" hidden>
  <BcnAldoMark size="sm" />
  <span class="bcn-help-dots__pickbar-text">Pick a Spot</span>
  <EsaButton variant="chrome" size="sm" data-help-pick-cancel>Cancel</EsaButton>
</div>

<script type="application/json" data-help-dots-page set:html={JSON.stringify(clientPage)} />

<script>
  import { setupHelpDots } from './help-dots';
  setupHelpDots();
</script>

<style>
  /* A zero-height box in the page's flow: it scrolls with the page, and each dot and
     outline is positioned from its top-left corner. */
  .bcn-help-dots {
    position: relative;
    block-size: 0;
  }

  /* Pick mode: a free spot, outlined in Aldo green with its name on its top edge. */
  .bcn-help-dots__outline {
    position: absolute;
    inset-inline-start: var(--_x, 0);
    inset-block-start: var(--_y, 0);
    inline-size: var(--_w, 0);
    block-size: var(--_h, 0);
    z-index: 19;
    padding: 0;
    border: 2px solid var(--bcn-aldo);
    border-radius: var(--radius-200);
    background: color-mix(in srgb, var(--bcn-aldo-50) 55%, transparent);
    cursor: pointer;
  }
  .bcn-help-dots__outline:hover {
    background: color-mix(in srgb, var(--bcn-aldo-100) 70%, transparent);
  }
  .bcn-help-dots__outline:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring-color);
    outline-offset: var(--focus-ring-offset);
  }
  .bcn-help-dots__outline-label {
    position: absolute;
    inset-inline-start: -2px;
    inset-block-end: 100%;
    padding: 2px var(--spacing-150);
    border-radius: var(--radius-200) var(--radius-200) 0 0;
    background: var(--bcn-aldo);
    color: var(--color-content-default-knockout);
    white-space: nowrap;
  }

  /* The pick bar: the Guidance bar's dark glass, along the top of the page. */
  .bcn-help-dots__pickbar {
    position: fixed;
    inset-block-start: 68px; /* under the 52px topbar */
    inset-inline-start: 50%;
    translate: -50% 0;
    z-index: 1000;
    padding: var(--spacing-100) var(--spacing-100) var(--spacing-100) var(--spacing-250);
    color: var(--bcn-helpbar-fg);
    background: var(--bcn-helpbar-bg);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    backdrop-filter: blur(14px) saturate(1.4);
    border: 1px solid var(--bcn-helpbar-border);
    border-radius: var(--radius-400, 14px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.28); /* the Guidance bar's lift */
  }
  .bcn-help-dots__pickbar-text {
    font-weight: var(--typography-font-weight-medium);
    white-space: nowrap;
  }
  .bcn-help-dots__pickbar :global(.esa-button) {
    color: var(--bcn-helpbar-fg);
    --focus-ring-color: var(--bcn-helpbar-fg);
  }

  .bcn-help-dots[hidden],
  .bcn-help-dots__outline[hidden],
  .bcn-help-dots__pickbar[hidden] {
    display: none;
  }
</style>
