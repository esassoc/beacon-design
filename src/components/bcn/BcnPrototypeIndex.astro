---
// <BcnPrototypeIndex> — the spoke's prototype index: the shared two-band filter bar over
// a table of EFFORTS, newest first, each expanding to the pages built for it.
//
// The effort is the line item. A flat list of every discrete page answered "what screens
// exist" when the question is "what work is here" — and at 28 pages across 8 efforts it
// had stopped being scannable either way. Pages are the detail you open an effort to see.
//
// ROWS ARE SERVER-RENDERED, ALL OF THEM, EXPANDED. The controller collapses on init and
// then only toggles `hidden` — so the catalog never enters the JS bundle, and with JS off
// the page is a complete, fully-expanded index rather than eight dead rows.
//
// Every column traces to a registry field: effort/page titles are authored, tenant resolves
// through the group, status is stored per page. The one derivation is an effort's date —
// its newest page's — and it is labelled "Latest", not presented as a stored fact.
//
// Descriptions are searched but not shown (they run to full paragraphs and made the grid
// unreadable), so a description-only match surfaces the row without a visible highlight.
//
// Composes: BcnFilterBar (which wraps esa-filter-container) + esa-filter-dropdown ×2 +
// esa-text-field + esa-icon-button + esa-empty-state. Behavior in ./prototype-index.ts.
//
// bcn-lego-checked: the ROW GRID is a semantic <table> — the hub ships no table/data-grid
// lego (checked the full catalog: esa-card is a box, esa-link-column is a card of bare
// links, esa-collapsible is a single disclosure, not a table with expandable rows), and
// Beacon's own grids are AG Grid, far too heavy for a 28-row static index and it would put
// the catalog in the bundle. Every CONTROL above the table IS a lego and the bar shell is
// bcn-filter-bar. bcn-prototype-index is the reusable home.
import BcnFilterBar from './BcnFilterBar.astro';
import EsaIconButton from '@esa/ecology/esa-icon-button.astro';
import EsaEmptyState from '@esa/ecology/esa-empty-state.astro';
import FilterClearButton from '@esa/ecology/esa-filter-clear-button.astro';
import {
  allPrototypeEfforts,
  TENANT_LABEL,
  type PrototypeStatus,
  type PrototypeTenant,
} from '../../data/prototypes';
import { withBase } from '../../lib/base';

const efforts = allPrototypeEfforts();
const pageCount = efforts.reduce((n, e) => n + e.pages.length, 0);

const STATUS_LABEL: Record<PrototypeStatus, string> = {
  live: 'Live',
  'in-progress': 'In progress',
  planned: 'Planned',
  archived: 'Archived',
};

const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
// Format from the ISO parts directly — new Date() can roll a UTC-midnight date back a
// day in the build environment.
const fmtDate = (iso: string): string => {
  const [y, m, d] = iso.split('-').map(Number);
  return `${MONTHS[m - 1]} ${d}, ${y}`;
};

// Facet options are DERIVED from the efforts actually present, so a facet can never offer
// a value that matches nothing, and a new tenant appears without a code edit. Counts ride
// along as the option label suffix.
const tenantCounts = new Map<PrototypeTenant, number>();
for (const e of efforts) tenantCounts.set(e.tenant, (tenantCounts.get(e.tenant) ?? 0) + 1);
const tenantOptions = (Object.keys(TENANT_LABEL) as PrototypeTenant[])
  .filter((t) => tenantCounts.has(t))
  .map((t) => ({ value: t, label: `${TENANT_LABEL[t]} (${tenantCounts.get(t)})` }));

const statusCounts = new Map<PrototypeStatus, number>();
for (const e of efforts) for (const p of e.pages) statusCounts.set(p.status, (statusCounts.get(p.status) ?? 0) + 1);
const statusOptions = (Object.keys(STATUS_LABEL) as PrototypeStatus[])
  .filter((s) => statusCounts.has(s))
  .map((s) => ({ value: s, label: `${STATUS_LABEL[s]} (${statusCounts.get(s)})` }));

// A facet whose values are all identical cannot narrow anything, so it is not a filter —
// it is a label pretending to be one. Drop any facet with fewer than two options; it
// reappears on its own the day the registry gains a second value. (Today that silently
// retires Status: every prototype is 'in-progress'.)
const facets = [
  { key: 'tenant', label: 'Tenant', options: tenantOptions },
  { key: 'status', label: 'Status', options: statusOptions },
].filter((f) => f.options.length > 1);
---

<section class="bcn-pi" aria-labelledby="bcn-pi-title" data-prototype-index>
  <div class="bcn-pi__head">
    <h2 id="bcn-pi-title" class="bcn-pi__title type-section-title">Prototypes</h2>
    <p class="bcn-pi__count">
      <span data-pi-count>{efforts.length}</span> of {efforts.length} efforts · {pageCount} pages
    </p>
  </div>

  <BcnFilterBar>
    <esa-text-field
      slot="search"
      data-pi-search
      placeholder="Search efforts and pages…"
      aria-label="Search prototypes"
      size="md"></esa-text-field>
    <span slot="search" data-pi-search-clear hidden>
      <EsaIconButton icon="x" label="Clear search" size="sm" />
    </span>

    {
      facets.map((f) => (
        <esa-filter-dropdown
          data-pi-filter={f.key}
          label={f.label}
          multiple
          size="sm"
          data-options={JSON.stringify(f.options)}
        />
      ))
    }

    <span slot="actions" data-pi-clear><FilterClearButton /></span>
  </BcnFilterBar>

  <table class="bcn-pi__table">
    <thead>
      <tr>
        <th scope="col">Effort</th>
        <th scope="col">Tenant</th>
        <th scope="col">Latest</th>
        <th scope="col">Status</th>
      </tr>
    </thead>
    <tbody>
      {
        efforts.map((e) => (
          <>
            <tr class="bcn-pi__row bcn-pi__row--effort" data-pi-effort={e.slug} data-tenant={e.tenant} data-title={e.title}>
              <th scope="rowgroup" class="bcn-pi__cell-effort">
                <button
                  type="button"
                  class="bcn-pi__toggle"
                  data-pi-toggle={e.slug}
                  aria-expanded="true"
                  aria-controls={e.pages.map((p) => `pi-page-${p.slug}`).join(' ')}
                >
                  <svg
                    class="bcn-pi__chevron"
                    viewBox="0 0 24 24"
                    width="16"
                    height="16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="m9 18 6-6-6-6" />
                  </svg>
                  <span class="bcn-pi__effort-title" data-pi-title>
                    {e.title}
                  </span>
                  <span class="bcn-pi__pages" data-pi-pagecount>
                    {e.pages.length} page{e.pages.length === 1 ? '' : 's'}
                  </span>
                </button>
              </th>
              <td class="bcn-pi__cell-meta">{TENANT_LABEL[e.tenant]}</td>
              <td class="bcn-pi__cell-date">
                <time datetime={e.latest}>{fmtDate(e.latest)}</time>
              </td>
              <td />
            </tr>

            {e.pages.map((p) => (
              <tr
                class="bcn-pi__row bcn-pi__row--page"
                id={`pi-page-${p.slug}`}
                data-pi-page={e.slug}
                data-tenant={p.tenant}
                data-status={p.status}
                data-title={p.title}
                data-desc={p.description}
              >
                <td class="bcn-pi__cell-page">
                  <a class="bcn-pi__link" href={withBase(p.route)} data-pi-title>
                    {p.title}
                  </a>
                </td>
                <td />
                <td class="bcn-pi__cell-date">
                  <time datetime={p.createdAt}>{fmtDate(p.createdAt)}</time>
                </td>
                <td>
                  <span class="bcn-pi__status" data-status={p.status}>
                    <span class="bcn-pi__status-dot" aria-hidden="true" />
                    {STATUS_LABEL[p.status]}
                  </span>
                </td>
              </tr>
            ))}
          </>
        ))
      }
    </tbody>
  </table>

  <div data-pi-empty hidden>
    <EsaEmptyState
      title="No prototypes match"
      description="Try fewer filters, or a different keyword."
      size="sm"
    />
  </div>
</section>

<script>
  import '@esa/ecology/esa-text-field';
  import '@esa/ecology/esa-filter-dropdown';
  import { setupPrototypeIndex } from './prototype-index';
  setupPrototypeIndex();
</script>

<style>
  .bcn-pi {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-400);
  }

  .bcn-pi__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--spacing-300);
  }
  .bcn-pi__title {
    margin: 0;
    color: var(--color-text-primary);
  }
  /* A genuine tally, so 14px tertiary is honest meta. */
  .bcn-pi__count {
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-text-tertiary);
    font-variant-numeric: tabular-nums;
  }

  /* esa-text-field's focus tokens default to Radix grass — an off-brand green ring.
     Re-point its PUBLIC focus properties to the house link colour, scoped to this
     surface so nothing leaks. (Same fix bcn-kb-hero carries.) */
  .bcn-pi :global([data-pi-search]) {
    --form-border-color-focus: var(--color-text-link);
    --focus-ring-color: var(--color-text-link);
  }

  /* ── Table skin. Rows divide with hairlines; no outer box fights the filter card. ── */
  .bcn-pi__table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--type-size-200);
    /* FIXED, not auto: with auto layout the browser re-measures every column from the
       rows currently VISIBLE, so expanding an effort — which introduces long page titles
       and the first non-empty Status cells — resized the whole table under the cursor.
       Fixed layout takes its widths from the header row alone, so the columns hold still
       no matter which rows are open. */
    table-layout: fixed;
  }
  .bcn-pi__table th:nth-child(1) { width: 52%; }
  .bcn-pi__table th:nth-child(2) { width: 18%; }
  .bcn-pi__table th:nth-child(3) { width: 15%; }
  .bcn-pi__table th:nth-child(4) { width: 15%; }
  .bcn-pi__table th[scope='col'] {
    padding: var(--spacing-250) var(--spacing-300);
    text-align: left;
    font-size: 0.875rem;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-secondary);
    border-bottom: 1px solid var(--color-border);
    white-space: nowrap;
  }
  .bcn-pi__table td,
  .bcn-pi__table th[scope='rowgroup'] {
    padding: var(--spacing-250) var(--spacing-300);
    text-align: left;
    vertical-align: middle;
    border-bottom: 1px solid var(--color-border-light);
  }
  .bcn-pi__row[hidden] {
    display: none;
  }

  /* ── Effort row — the line item. Its hairline is full-strength so each effort reads
        as the start of a block; its pages divide with the lighter rule. ── */
  .bcn-pi__row--effort th {
    border-bottom-color: var(--color-border);
  }
  .bcn-pi__row--effort:hover {
    background: var(--color-surface-sunken);
  }
  .bcn-pi__cell-effort {
    padding: 0 !important;
  }

  /* The whole effort cell is the disclosure control. */
  .bcn-pi__toggle {
    display: flex;
    align-items: center;
    gap: var(--spacing-200);
    inline-size: 100%;
    padding: var(--spacing-250) var(--spacing-300);
    background: none;
    border: 0;
    font: inherit;
    text-align: left;
    cursor: pointer;
    color: var(--color-text-primary);
  }
  .bcn-pi__toggle:focus-visible {
    outline: 2px solid var(--color-text-link);
    outline-offset: -2px;
  }
  .bcn-pi__chevron {
    flex: none;
    color: var(--color-text-tertiary);
    transition: transform 140ms ease;
  }
  .bcn-pi__toggle[aria-expanded='true'] .bcn-pi__chevron {
    transform: rotate(90deg);
  }
  .bcn-pi__effort-title {
    font-weight: var(--font-weight-semibold);
    line-height: 1.35;
  }
  /* Search hits — highlighter-yellow with dark text, the same #fde047 the omni-search
     palette and results page use. One search-hit treatment across the spoke. */
  .bcn-pi__toggle :global(mark),
  .bcn-pi__link :global(mark) {
    background: #fde047;
    color: var(--color-text-primary);
    border-radius: 2px;
    padding: 0 1px;
  }
  /* A genuine count, so 13px tertiary is honest meta. */
  .bcn-pi__pages {
    font-size: 0.8125rem;
    font-weight: var(--font-weight-regular);
    color: var(--color-text-tertiary);
    white-space: nowrap;
  }

  /* ── Page row — indented under its effort, quieter than the line item. ── */
  .bcn-pi__cell-page {
    padding-left: calc(var(--spacing-300) + var(--spacing-600)) !important;
  }
  .bcn-pi__row--page:hover {
    background: var(--color-surface-sunken);
  }
  .bcn-pi__link {
    color: var(--color-text-link);
    text-decoration: none;
    line-height: 1.35;
  }
  .bcn-pi__link:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .bcn-pi__cell-meta {
    color: var(--color-text-secondary);
    white-space: nowrap;
  }
  .bcn-pi__cell-date {
    white-space: nowrap;
    color: var(--color-text-tertiary);
    font-variant-numeric: tabular-nums;
  }

  /* Status — a quiet dot + word. No filled pill, no colour block. */
  .bcn-pi__status {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-150);
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    white-space: nowrap;
  }
  .bcn-pi__status-dot {
    inline-size: 8px;
    block-size: 8px;
    border-radius: 50%;
    flex: none;
    background: var(--color-text-muted);
  }
  .bcn-pi__status[data-status='live'] .bcn-pi__status-dot {
    background: var(--color-success);
  }
  .bcn-pi__status[data-status='in-progress'] .bcn-pi__status-dot {
    background: var(--bcn-flag-on-color);
  }

  /* Narrow: drop the tenant column rather than scroll the table sideways. The remaining
     three are re-declared so the percentages still sum to 100 — under fixed layout a
     hidden column does not hand its width back on its own. */
  @media (max-width: 48rem) {
    .bcn-pi__table th:nth-child(2),
    .bcn-pi__table td:nth-child(2) {
      display: none;
    }
    .bcn-pi__table th:nth-child(1) { width: 54%; }
    .bcn-pi__table th:nth-child(3) { width: 23%; }
    .bcn-pi__table th:nth-child(4) { width: 23%; }
  }
</style>
