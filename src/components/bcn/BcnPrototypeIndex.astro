---
// <BcnPrototypeIndex> — the spoke's prototype index as ONE filterable surface: the shared
// two-band filter bar over a table of every prototype, newest first. It replaced the
// per-effort stacked tables on the home page, which grew past scanning once the registry
// crossed ~28 pages across 8 efforts.
//
// The bar and the grid are one interactive unit — the bar drives nothing else — so they
// live in one section component rather than being wired across the page.
//
// ROWS ARE SERVER-RENDERED, ALL OF THEM. The controller only shows/hides rows and wraps
// matches in <mark>; nothing about the catalog enters the JS bundle. Same progressive
// strategy the help-centre search uses, and it means the full index is present for anyone
// with JS off — they simply get an unfiltered list, which is the honest fallback.
//
// Every column traces to a registry field: title/description are authored, tenant resolves
// through the group, createdAt and status are stored. Nothing on screen is derived prose.
//
// Composes: BcnFilterBar (which wraps esa-filter-container) + esa-filter-dropdown ×3 +
// esa-text-field + esa-icon-button + esa-empty-state. Behavior in ./prototype-index.ts.
//
// bcn-lego-checked: the ROW GRID is a semantic <table> — the hub ships no table/data-grid
// lego (checked the full catalog: esa-card is a box, esa-link-column is a card of bare
// links, esa-pillbox is chips), and Beacon's own grids are AG Grid, which is far too heavy
// for a 28-row static index and would put the catalog into the JS bundle. Every CONTROL
// above the table IS a lego, and the filter-bar shell is bcn-filter-bar. bcn-prototype-index
// is the reusable home; its CSS is the table skin plus the status token.
import BcnFilterBar from './BcnFilterBar.astro';
import EsaIconButton from '@esa/ecology/esa-icon-button.astro';
import EsaEmptyState from '@esa/ecology/esa-empty-state.astro';
import FilterClearButton from '@esa/ecology/esa-filter-clear-button.astro';
import {
  allPrototypeRows,
  prototypeGroups,
  TENANT_LABEL,
  type PrototypeStatus,
  type PrototypeTenant,
} from '../../data/prototypes';
import { withBase } from '../../lib/base';

const rows = allPrototypeRows();

const STATUS_LABEL: Record<PrototypeStatus, string> = {
  live: 'Live',
  'in-progress': 'In progress',
  planned: 'Planned',
  archived: 'Archived',
};

const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
// Format from the ISO parts directly — new Date() can roll a UTC-midnight date back a
// day in the build environment.
const fmtDate = (iso: string): string => {
  const [y, m, d] = iso.split('-').map(Number);
  return `${MONTHS[m - 1]} ${d}, ${y}`;
};

// Facet options are DERIVED from the rows actually present, so a facet can never offer a
// value that matches nothing, and a new tenant/effort/status appears without a code edit.
// Counts ride along as the option label suffix the dropdown shows at rest.
const countBy = <T extends string>(pick: (r: (typeof rows)[number]) => T): Map<T, number> => {
  const m = new Map<T, number>();
  for (const r of rows) m.set(pick(r), (m.get(pick(r)) ?? 0) + 1);
  return m;
};

const tenantCounts = countBy((r) => r.tenant);
const tenantOptions = (Object.keys(TENANT_LABEL) as PrototypeTenant[])
  .filter((t) => tenantCounts.has(t))
  .map((t) => ({ value: t, label: `${TENANT_LABEL[t]} (${tenantCounts.get(t)})` }));

// Effort options keep REGISTRY ORDER (the groups array), not alphabetical — the registry
// order is authored and reads as the shape of the work.
const effortCounts = countBy((r) => r.groupSlug);
const effortOptions = prototypeGroups
  .filter((g) => effortCounts.has(g.slug))
  .map((g) => ({ value: g.slug, label: `${g.title} (${effortCounts.get(g.slug)})` }));

const statusCounts = countBy((r) => r.status);
const statusOptions = (Object.keys(STATUS_LABEL) as PrototypeStatus[])
  .filter((s) => statusCounts.has(s))
  .map((s) => ({ value: s, label: `${STATUS_LABEL[s]} (${statusCounts.get(s)})` }));

// A facet whose values are all identical cannot narrow anything, so it is not a filter —
// it is a label pretending to be one. Drop any facet with fewer than two options; it
// reappears on its own the day the registry gains a second value. (Today that silently
// retires Status: every prototype is 'in-progress'.)
const facets = [
  { key: 'tenant', label: 'Tenant', options: tenantOptions },
  { key: 'effort', label: 'Effort', options: effortOptions },
  { key: 'status', label: 'Status', options: statusOptions },
].filter((f) => f.options.length > 1);
---

<section class="bcn-pi" aria-labelledby="bcn-pi-title" data-prototype-index>
  <div class="bcn-pi__head">
    <h2 id="bcn-pi-title" class="bcn-pi__title type-section-title">Prototypes</h2>
    <p class="bcn-pi__count">
      <span data-pi-count>{rows.length}</span> of {rows.length}
    </p>
  </div>

  <BcnFilterBar>
    <esa-text-field
      slot="search"
      data-pi-search
      placeholder="Search prototypes…"
      aria-label="Search prototypes"
      size="md"></esa-text-field>
    <span slot="search" data-pi-search-clear hidden>
      <EsaIconButton icon="x" label="Clear search" size="sm" />
    </span>

    {
      facets.map((f) => (
        <esa-filter-dropdown
          data-pi-filter={f.key}
          label={f.label}
          multiple
          size="sm"
          data-options={JSON.stringify(f.options)}
        />
      ))
    }

    <span slot="actions" data-pi-clear><FilterClearButton /></span>
  </BcnFilterBar>

  <table class="bcn-pi__table">
    <thead>
      <tr>
        <th scope="col">Prototype</th>
        <th scope="col">Tenant</th>
        <th scope="col">Effort</th>
        <th scope="col">Built</th>
        <th scope="col">Status</th>
      </tr>
    </thead>
    <tbody data-pi-body>
      {
        rows.map((r) => (
          <tr
            class="bcn-pi__row"
            data-pi-row
            data-tenant={r.tenant}
            data-effort={r.groupSlug}
            data-status={r.status}
            data-title={r.title}
            data-desc={r.description}
          >
            <td class="bcn-pi__cell-main">
              <a class="bcn-pi__link" href={withBase(r.route)} data-pi-title>
                {r.title}
              </a>
              <span class="bcn-pi__desc" data-pi-desc>
                {r.description}
              </span>
            </td>
            <td class="bcn-pi__cell-meta">{TENANT_LABEL[r.tenant]}</td>
            <td class="bcn-pi__cell-meta">{r.groupTitle}</td>
            <td class="bcn-pi__cell-date">
              <time datetime={r.createdAt}>{fmtDate(r.createdAt)}</time>
            </td>
            <td>
              <span class="bcn-pi__status" data-status={r.status}>
                <span class="bcn-pi__status-dot" aria-hidden="true" />
                {STATUS_LABEL[r.status]}
              </span>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>

  <div data-pi-empty hidden>
    <EsaEmptyState
      title="No prototypes match"
      description="Try fewer filters, or a different keyword."
      size="sm"
    />
  </div>
</section>

<script>
  import '@esa/ecology/esa-text-field';
  import '@esa/ecology/esa-filter-dropdown';
  import { setupPrototypeIndex } from './prototype-index';
  setupPrototypeIndex();
</script>

<style>
  .bcn-pi {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-400);
  }

  .bcn-pi__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--spacing-300);
  }
  .bcn-pi__title {
    margin: 0;
    color: var(--color-text-primary);
  }
  /* A genuine tally, so 14px tertiary is honest meta. */
  .bcn-pi__count {
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-text-tertiary);
    font-variant-numeric: tabular-nums;
  }

  /* ── Table skin. Rows divide with hairlines; no outer box fights the filter card. ── */
  .bcn-pi__table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--type-size-200);
  }
  .bcn-pi__table th {
    padding: var(--spacing-250) var(--spacing-300);
    text-align: left;
    font-size: 0.875rem;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-secondary);
    border-bottom: 1px solid var(--color-border);
    white-space: nowrap;
  }
  .bcn-pi__table td {
    padding: var(--spacing-300);
    vertical-align: top;
    border-bottom: 1px solid var(--color-border-light);
  }
  .bcn-pi__row[hidden] {
    display: none;
  }
  .bcn-pi__row:hover {
    background: var(--color-surface-sunken);
  }

  /* Two-line main cell: the title link over its one-line description. */
  .bcn-pi__cell-main {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 22rem;
  }
  .bcn-pi__link {
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-link);
    text-decoration: none;
    line-height: 1.35;
  }
  .bcn-pi__link:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  /* esa-text-field's focus tokens default to Radix grass — an off-brand green ring.
     Re-point its PUBLIC focus properties to the house link colour, scoped to this
     surface so nothing leaks. (Same fix bcn-kb-hero carries.) */
  .bcn-pi :global([data-pi-search]) {
    --form-border-color-focus: var(--color-text-link);
    --focus-ring-color: var(--color-text-link);
  }

  /* The registry description, clamped to two lines — several run long. */
  .bcn-pi__desc {
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--color-text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  /* The clamp stays put while searching. A hit deeper in the text stays visible because
     the controller re-windows the description around the match rather than un-clamping —
     these registry descriptions run long enough that un-clamping three results fills a
     screen. */

  /* Matched substring — a neutral translucent wash that reads on white AND on the
     sunken hover row. Never a tint (the house bans colour as an accent here). */
  .bcn-pi__link :global(mark),
  .bcn-pi__desc :global(mark) {
    background: color-mix(in srgb, var(--color-text-primary) 16%, transparent);
    color: inherit;
    border-radius: 2px;
    padding: 0 1px;
  }

  .bcn-pi__cell-meta {
    color: var(--color-text-secondary);
    white-space: nowrap;
  }
  .bcn-pi__cell-date {
    white-space: nowrap;
    color: var(--color-text-tertiary);
    font-variant-numeric: tabular-nums;
  }

  /* Status — a quiet dot + word. No filled pill, no colour block. */
  .bcn-pi__status {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-150);
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    white-space: nowrap;
  }
  .bcn-pi__status-dot {
    inline-size: 8px;
    block-size: 8px;
    border-radius: 50%;
    flex: none;
    background: var(--color-text-muted);
  }
  .bcn-pi__status[data-status='live'] .bcn-pi__status-dot {
    background: var(--color-success);
  }
  .bcn-pi__status[data-status='in-progress'] .bcn-pi__status-dot {
    background: var(--bcn-flag-on-color);
  }

  /* Narrow: drop the two nowrap meta columns rather than scroll the table sideways. */
  @media (max-width: 60rem) {
    .bcn-pi__table th:nth-child(3),
    .bcn-pi__table td:nth-child(3),
    .bcn-pi__table th:nth-child(4),
    .bcn-pi__table td:nth-child(4) {
      display: none;
    }
    .bcn-pi__cell-main {
      min-width: 0;
    }
  }
</style>
