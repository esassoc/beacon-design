---
// <BcnHelpBar> — Aldo's home: a floating utility pill fixed to the bottom-center of the
// viewport (Figma-toolbar energy — a dark GLASS surface, deliberately distinct from the white
// app chrome, with an inner hairline + soft lift). The What's-new popover it opens stays a
// white content surface. Mounted app-wide in the AppShell chrome. Left → right: the primary "Guidance"
// affordance (the Aldo rings, labelled by their tooltip; the divider went 2026-10-21), the
// evidence paper clip, and a
// "What's new" icon-button that opens a popover of the latest release (no unread dot: the
// button is a doorway, not a notifier).
//
// Wiring is by data-* hook, composed BLIND against siblings — this component adds NO open
// behavior for the evidence or guidance drawers; it only advertises the hooks the siblings
// already listen on:
//   • [data-help-trigger]     — the route-aware guidance drawer (sibling) opens on clicks here,
//                               unless a page with help dots claims it (data-help-dots-claimed):
//                               there it turns the dots on and off, and shows aria-pressed.
//   • [data-evidence-trigger] — the global evidence drawer (sibling) opens on clicks here.
//   • [data-whatsnew]         — LOCAL only: the What's-new trigger, measured to fit the panel.
//
// The middle slot held a SECOND search button until the 2026-08-04 product meeting; it was
// redundant with the top bar's search field and ⌘K, and this bar is where Beacon's bottom
// affordances live, so the global evidence drawer took the slot.
//
// bcn-lego-checked: the floating bottom-center utility BAR has no esa-* equivalent — esa-app-bar
// is the fixed TOP chrome strip, not a detached toolbar (checked Beacon — none), so the pill
// shell + its internal layout is this component's own composition glue. The "Guidance" control
// is a BRANDED affordance (the BcnAldoMark rings); esa-button / esa-icon-button
// only accept a Lucide `icon` NAME, not a custom SVG mark, so it is bespoke. Everything else IS a
// lego: esa-icon-button (Search + What's-new triggers), esa-tooltip (Search hint), and
// esa-popover (the What's-new panel, anchored above the trigger). bcn-help-bar is the
// reusable home. The panel is text-only: the latest release's version pill and features
// (serif title, one-sentence summary), then one row per earlier release, no screenshots.
//
// The What's-new trigger uses 'notepad-text' — the release-notes glyph, matching the
// Release Notes page title. esa-icon-button forwards only a registry `icon` name (no
// custom `paths` passthrough), so the glyph was registered in the ecology icon-registry.
import BcnAldoMark from './aldo/BcnAldoMark.astro';
import EsaIconButton from '@esa/ecology/esa-button.astro';
import EsaIcon from '@esa/ecology/esa-icon.astro';
import { scopeIcon } from '../../data/global-search';
import { LATEST_RELEASE as latest, RELEASES, featureAnchor } from '../../data/release-notes';
import { withBase } from '../../lib/base';

// The two releases before the latest, one row each under "Earlier".
const earlier = RELEASES.slice(1, 3);

// The release-notes page; the panel lists the latest post's features, each deep-linking
// to its block on the page (`#v1-41-0-lists`).
const releaseNotesHref = withBase('/prototypes/release-notes');

// "October 13, 2026" — the release date beside the version pill.
const fmtLong = (iso: string): string =>
  new Date(`${iso}T00:00:00`).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
---

<div class="bcn-help-bar" data-help-bar role="toolbar" aria-label="Help &amp; utilities">
  <!-- Primary: Guidance — the Aldo mark alone (the label went 2026-10-21), named by
       aria-label and the tooltip; opens the guidance drawer via hook. -->
  <esa-tooltip class="bcn-help-bar__tooltip" text="Help & Guidance" position="above" delay="150">
    <button type="button" class="bcn-help-bar__guidance" data-help-trigger aria-haspopup="dialog" aria-label="Help & Guidance">
      <BcnAldoMark variant="rings" />
    </button>
  </esa-tooltip>



  <!-- Attach Evidence of Compliance — icon-only; the tooltip host carries the drawer's open hook.
       GLYPH: the paper clip, as on prod's bar and in global-search's SCOPES (what the ⌘K
       palette shows for Evidence of Compliance). The hub registry has no paperclip and
       iconOnly takes only a registry name, so the glyph rides in the lego's default slot
       as an EsaIcon with `paths`, and the esa-button--icon-only class keeps the square
       icon-button geometry. Swap to icon="paperclip" once the hub registers it.
       This slot used to hold a duplicate Search button. It was replaced (product meeting
       2026-08-04): search already has the top bar's own field and ⌘K, and this bar is
       where Beacon's bottom affordances live, which is where the global evidence drawer
       belongs. -->
  <esa-tooltip class="bcn-help-bar__tooltip" text="Add Evidence" position="above" delay="150" data-evidence-trigger>
    <EsaIconButton variant="chrome" class="esa-button--icon-only" aria-label="Add Evidence" size="md">
      <EsaIcon name="paperclip" paths={scopeIcon('evidence')} size="md" />
    </EsaIconButton>
  </esa-tooltip>

  <!-- What's new — icon-only trigger; esa-popover panel opens above the bar. -->
  <esa-popover class="bcn-help-bar__popover" position="top" trigger="click" offset={12}>
    <esa-tooltip class="bcn-help-bar__tooltip" text="Release Notes" position="above" delay="150">
      <span class="bcn-help-bar__whatsnew" data-whatsnew>
        <EsaIconButton variant="chrome" iconOnly icon="notepad-text" label="Release Notes" size="md" />
      </span>
    </esa-tooltip>

    <div slot="content" class="bcn-help-bar__panel">
      <p class="bcn-help-bar__panel-release">
        <span class="bcn-help-bar__pill">{latest.version}</span>
        <time class="bcn-help-bar__panel-date" datetime={latest.date}>{fmtLong(latest.date)}</time>
      </p>
      <p class="bcn-help-bar__panel-title">What's New</p>
      <ul class="bcn-help-bar__panel-list">
        {latest.features.map((feature) => (
          <li>
            <a class="bcn-help-bar__panel-link" href={`${releaseNotesHref}#${featureAnchor(latest, feature)}`}>
              <span class="bcn-help-bar__panel-item-title">{feature.title}</span>
              <span class="bcn-help-bar__panel-item-text">{feature.summary}</span>
            </a>
          </li>
        ))}
      </ul>
      {earlier.length > 0 && (
        <div class="bcn-help-bar__panel-prev">
          <p class="bcn-help-bar__panel-earlier">Earlier</p>
          <ul class="bcn-help-bar__panel-prev-list">
            {earlier.map((release) => (
              <li>
                <a class="bcn-help-bar__panel-prev-link" href={`${releaseNotesHref}#${release.anchor}`}>
                  <span class="bcn-help-bar__pill bcn-help-bar__pill--sm">{release.version}</span>
                  <span class="bcn-help-bar__panel-prev-text">{release.features.map((f) => f.title).join('\u00a0· ')}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
      <a class="bcn-help-bar__panel-all" href={releaseNotesHref}>
        All release notes <EsaIcon name="arrow-right" size="sm" />
      </a>
    </div>
  </esa-popover>
</div>

<script>
  // Register the Lit legos used above (idempotent — each guards its own customElements.define),
  // then fit the What's-new panel to the screen. esa-popover handles open/close, Esc, and
  // outside-click for the panel.
  import '@esa/ecology/esa-popover';
  import '@esa/ecology/esa-tooltip';

  const bar = document.querySelector<HTMLElement>('[data-help-bar]');

  if (bar) {
    const trigger = bar.querySelector<HTMLElement>('[data-whatsnew]');

    // esa-tooltip opens on mouseenter and any focusin, so a click left it standing: the
    // press focuses the button, and focus kept it up until focus moved (round 16), and a
    // tap opened it on touch. On this bar a tooltip shows for a mouse hover that has not
    // clicked, or for keyboard focus (:focus-visible) only, and a press hides it until the
    // pointer leaves. `open` reflects and is the lego's public state. The fix belongs in
    // esa-tooltip (logged in the improvement ledger).
    const whatsNew = bar.querySelector<HTMLElement & { open: boolean }>('.bcn-help-bar__popover');
    bar.querySelectorAll<HTMLElement & { open: boolean }>('esa-tooltip').forEach((tip) => {
      let hover = false;
      let pressed = false;
      tip.addEventListener('pointerenter', (e) => (hover = e.pointerType === 'mouse'));
      tip.addEventListener('pointerleave', () => {
        hover = false;
        pressed = false;
      });
      tip.addEventListener(
        'pointerdown',
        () => {
          pressed = true;
          tip.open = false;
        },
        true,
      );
      const allowed = () =>
        !whatsNew?.open && ((hover && !pressed) || !!tip.querySelector(':focus-visible'));
      new MutationObserver(() => {
        if (tip.open && !allowed()) tip.open = false;
      }).observe(tip, { attributes: true, attributeFilter: ['open'] });
    });

    // esa-popover centres its panel over the trigger and never moves it to stay on screen.
    // The notepad sits right of the bar's centre, so on a phone the panel ran off the right
    // edge; cap its width to twice the room beside the trigger (same gap as the help dots'
    // fit, logged in the improvement ledger).
    const panel = bar.querySelector<HTMLElement>('.bcn-help-bar__panel');
    const fitPanel = () => {
      if (!trigger || !panel) return;
      const r = trigger.getBoundingClientRect();
      const mid = r.left + r.width / 2;
      const room = Math.min(mid, document.documentElement.clientWidth - mid) - 12; // 12px from the edge
      panel.style.setProperty('--_room', `${Math.round(room * 2 - 50)}px`); // less the popover's padding + border
      // Height too: on a phone the narrow panel runs tall, so hold it below the top bar and
      // let it scroll (the popover sits 12px + its 8px arrow above the trigger).
      const roomH = r.top - 20 - 64 - 42; // gap + arrow, top bar, padding + border
      panel.style.setProperty('--_room-h', `${Math.round(roomH)}px`);
    };
    // Measured as it opens (the bar re-centres when the sidebar collapses) and on resize.
    trigger?.addEventListener('click', fitPanel);
    window.addEventListener('resize', fitPanel);

  }
</script>

<style>
  /* The floating pill. position:fixed with only `left` set keeps it shrink-to-fit, so the bar
     occupies just its own box — clicks outside the pill pass through to the page. */
  /* Dark glass — the design-principles carve-out: a floating tool reads distinct from the
     white app chrome. Semantic dark-glass tokens; opaque fallback where blur is unsupported. */
  .bcn-help-bar {
    position: fixed;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1000; /* under the z-1100 topbar; the guidance drawer overlay sits at 1300 */
    display: flex;
    align-items: center;
    gap: var(--spacing-100);
    padding: var(--spacing-100) var(--spacing-150);
    color: var(--bcn-helpbar-fg);
    background: var(--bcn-helpbar-bg);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    backdrop-filter: blur(14px) saturate(1.4);
    border: 1px solid var(--bcn-helpbar-border);
    border-radius: var(--radius-400, 14px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.28); /* dark chrome needs more lift; shadows aren't tokenized here */
  }
  /* Aldo expanded over the right half: the bar keeps to the left half, over the work. */

  /* No backdrop-filter support (either prefix) → opaque dark fallback. */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .bcn-help-bar {
      background: var(--bcn-helpbar-bg-solid);
    }
  }
  /* Honor a reduced-transparency preference — drop the blur, go solid. */
  @media (prefers-reduced-transparency: reduce) {
    .bcn-help-bar {
      background: var(--bcn-helpbar-bg-solid);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  /* Primary: Guidance — branded affordance, quiet neutral hover on the dark shell. */
  .bcn-help-bar__guidance {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-200, 8px);
    background: transparent;
    color: var(--bcn-helpbar-fg);
    font-family: inherit;
    font-size: var(--font-size-200, 0.9375rem);
    font-weight: var(--typography-font-weight-medium);
    line-height: 1;
    cursor: pointer;
    transition: background var(--transition-fast, 150ms ease);
  }
  .bcn-help-bar__guidance:hover {
    background: var(--bcn-helpbar-hover-bg);
  }
  /* The Aldo rings, ramped from the hub's teal-7 to Aldo green (round 6, option B), sized
     so their ink matches the paper clip's and notepad's (about 19-20px tall) and an even box
     centres on the bar's pixel grid (round 7). */
  .bcn-help-bar__guidance {
    --bcn-aldo-mark-size: 20px;
    --bcn-aldo-ring-from: var(--color-teal-7);
    --bcn-aldo-ring-to: var(--bcn-aldo);
  }

  /* On a page with help dots, Guidance turns them on: pressed while they show. */
  .bcn-help-bar__guidance[aria-pressed='true'] {
    background: var(--bcn-helpbar-hover-bg);
    box-shadow: inset 0 0 0 1px var(--bcn-aldo);
  }
  .bcn-help-bar__guidance:focus-visible {
    outline: 2px solid var(--bcn-helpbar-fg); /* light foreground — visible on the dark shell, monochrome (no aldo tint) */
    outline-offset: 2px;
  }


  /* Icon triggers inherit the 40px hit target + focus ring from esa-icon-button. The tooltip
     and popover hosts are inline wrappers, so they don't disturb the flex row. */
  .bcn-help-bar__tooltip,
  .bcn-help-bar__popover {
    display: inline-flex;
  }
  /* The What's-new panel: white, 12px corners, 20px by 24px of room. esa-popover reads
     these from private hooks only (no public padding/radius surface yet). */
  .bcn-help-bar__popover {
    --_popover-bg: var(--color-background-default);
    --_popover-radius: 12px;
    --_popover-padding: 20px 24px;
  }
  /* Dark tooltips (round 16): the bar's own surface and ink, through the knockout roles
     esa-tooltip's bubble and arrow read. Solid, as the bar's own fallback is: the arrow is a
     square under the bubble, and a translucent fill shows the overlap. */
  .bcn-help-bar__tooltip {
    --color-background-default-knockout: var(--bcn-helpbar-bg-solid);
    --color-content-default-knockout: var(--bcn-helpbar-fg);
  }
  /* The paper clip rides in esa-button's label slot (no registry glyph), whose text line
     box sat it 1.5px above the bar's centre; collapse the line so it centres like the
     icon-only buttons beside it. */
  .bcn-help-bar__tooltip :global(.esa-button__label) {
    display: inline-flex;
    line-height: 0;
  }
  /* Theme the icon-button legos to the dark zone. esa-icon-button already exposes the hook
     --icon-button-bg-hover and draws its focus outline from currentColor, so both adapt to the
     zone by construction — we only point the hook at the zone token and drive the glyph tone
     (muted at rest, full-strength on hover/focus, which also brightens the currentColor ring). */
  .bcn-help-bar :global(.esa-icon-button) {
    color: var(--bcn-helpbar-fg-muted);
    --icon-button-bg-hover: var(--bcn-helpbar-hover-bg);
  }
  .bcn-help-bar :global(.esa-icon-button:hover),
  .bcn-help-bar :global(.esa-icon-button:focus-visible) {
    color: var(--bcn-helpbar-fg);
  }

  /* What's-new trigger wrapper: the anchor fitPanel measures. */
  .bcn-help-bar__whatsnew {
    display: inline-flex;
  }
  /* What's New panel: the latest release's features under its version pill, then the
     two releases before it as one row each. The pill sets a light foreground, so the
     panel re-establishes dark-on-white text. */
  .bcn-help-bar__panel {
    display: flex;
    flex-direction: column;
    width: min(400px, var(--_room, 400px));
    max-block-size: var(--_room-h, none);
    overflow-y: auto;
    color: var(--color-content-default);
    white-space: normal;
    text-align: start;
  }
  :where(.bcn-help-bar__panel) p {
    margin: 0;
  }
  .bcn-help-bar__panel-release {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  /* The version pill: brand teal on a 10% tint of itself, tabular figures. */
  .bcn-help-bar__pill {
    flex: none;
    padding: 3px var(--spacing-200);
    border-radius: 7px;
    background: color-mix(in srgb, var(--color-content-brand) 10%, transparent);
    color: var(--color-content-brand);
    font-size: 13px;
    line-height: 18px;
    font-weight: var(--typography-font-weight-medium);
    font-variant-numeric: tabular-nums;
  }
  .bcn-help-bar__pill--sm {
    padding: 2px 6px;
    border-radius: 6px;
    font-size: 12px;
    line-height: 16px;
  }
  .bcn-help-bar__panel-date,
  .bcn-help-bar__panel-earlier {
    font-size: 13px;
    line-height: 18px;
    color: var(--color-content-default-tertiary);
  }
  .bcn-help-bar__panel-title,
  .bcn-help-bar__panel-item-title {
    font-family: var(--font-decorative);
    font-weight: var(--typography-font-weight-medium);
    color: var(--color-content-default);
  }
  .bcn-help-bar__panel-title {
    margin: 12px 0 4px;
    font-size: 24px;
    line-height: 30px;
  }
  .bcn-help-bar__panel-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .bcn-help-bar__panel-list li + li {
    border-block-start: 1px solid var(--color-border-default-subtle);
  }
  .bcn-help-bar__panel-link {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-050);
    padding-block: 14px;
    color: inherit;
    text-decoration: none;
  }
  .bcn-help-bar__panel-item-title {
    font-size: 17px;
    line-height: 23px;
    transition: color var(--transition-fast, 150ms ease);
  }
  .bcn-help-bar__panel-link:hover .bcn-help-bar__panel-item-title {
    color: var(--color-content-brand);
  }
  .bcn-help-bar__panel-item-text {
    font-size: 14px;
    line-height: 21px;
    color: var(--color-content-default-tertiary);
  }
  .bcn-help-bar__panel-link:focus-visible,
  .bcn-help-bar__panel-prev-link:focus-visible,
  .bcn-help-bar__panel-all:focus-visible {
    outline: 2px solid var(--color-content-link);
    outline-offset: 1px;
    border-radius: var(--radius-md);
  }
  /* Earlier: one row per previous release, its pill and its feature titles. */
  .bcn-help-bar__panel-prev {
    border-block-start: 1px solid var(--color-border-default-subtle);
  }
  .bcn-help-bar__panel-earlier {
    margin: 14px 0 6px;
    font-weight: var(--typography-font-weight-medium);
  }
  .bcn-help-bar__panel-prev-list {
    list-style: none;
    margin: 0 calc(var(--spacing-200) * -1) 14px;
    padding: 0;
  }
  .bcn-help-bar__panel-prev-link {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 6px var(--spacing-200);
    border-radius: var(--radius-lg);
    color: var(--color-content-default-secondary);
    text-decoration: none;
    transition: background var(--transition-fast, 150ms ease), color var(--transition-fast, 150ms ease);
  }
  .bcn-help-bar__panel-prev-link .bcn-help-bar__pill--sm {
    margin-block-start: 2px;
  }
  .bcn-help-bar__panel-prev-link:hover {
    background: var(--color-background-elevation-sunken);
    color: var(--color-content-brand);
  }
  .bcn-help-bar__panel-prev-text {
    font-size: 14px;
    line-height: 20px;
  }
  /* Footer: the way to every release. */
  .bcn-help-bar__panel-all {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-100);
    align-self: flex-start;
    padding-block-start: 14px;
    border-block-start: 1px solid var(--color-border-default-subtle);
    inline-size: 100%;
    font-size: 14px;
    line-height: 20px;
    font-weight: var(--typography-font-weight-medium);
    color: var(--color-content-brand);
    text-decoration: none;
  }
  .bcn-help-bar__panel-all:hover {
    text-decoration: underline;
  }
</style>
