---
// <BcnNoteComposer> — the one composer for writing about a passage of a response, in
// three modes (set at runtime by its host through note-composer.ts):
//   note    New note on selected text (the selection bubble). Neutral: your avatar.
//   reply   Reply in a note's thread (a footnote card). Neutral, no passage shown.
//   aldo    Revise with Aldo: from the selection bubble (rewrite the selection) or from
//           a note (the note is the prompt, prefilled). Aldo's mark and green accents.
// A card whose field is borderless (the card is the field, as BcnAldoPrompt's composer),
// the passage it is about set in the document voice above the field, ⌘Enter to submit,
// Esc to cancel. The two kinds read apart at a glance, without a wash:
//   a person   a squared neutral card, your avatar, the passage in the notes' yellow
//              highlight, a worded Add note / Reply button.
//   Aldo       Aldo's own shape (the rounded card of his prompt), his green border and
//              ring, his mark and green title, the passage on his tint (it is what will
//              change), and his round green send.
//
// One instance per host; the host moves it where it is needed (the bubble, a card).
//
// bcn-lego-checked: the field IS esa-textarea (border hooks zeroed, as BcnAldoPrompt), the
// avatar IS esa-avatar, the actions ARE esa-button, the mark IS BcnAldoMark. No esa-
// composer lego (esa-dialog / esa-popover are overlays, this sits in flow or in the
// bubble). Checked Beacon (comment forms are a bare textarea + button). Shared by the
// selection bubble and BcnResponseNotes, so bcn-note-composer is the home.
import EsaAvatar from '@esa/ecology/esa-avatar.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import BcnAldoMark from './BcnAldoMark.astro';
---

<div class="bcn-nc" role="group" aria-label="New Note" data-note-composer data-mode="note" hidden>
  <div class="bcn-nc__head">
    <span class="bcn-nc__who" data-nc-who="me"><EsaAvatar name="You" size="xs" /></span>
    <span class="bcn-nc__who" data-nc-who="aldo" hidden><BcnAldoMark size="sm" /></span>
    <span class="bcn-nc__title" data-nc-title>New Note</span>
  </div>
  <p class="bcn-nc__quote" data-nc-quote><span class="bcn-nc__hl" data-nc-hl></span></p>
  <esa-textarea class="bcn-nc__input" rows="2" max-rows="8" auto-resize aria-label="Note" placeholder="" data-nc-field></esa-textarea>
  <div class="bcn-nc__foot">
    <span class="bcn-nc__keys" data-nc-keys aria-live="polite">⌘ Enter</span>
    <EsaButton size="sm" variant="ghost" data-nc-cancel>Cancel</EsaButton>
    <span class="bcn-nc__submit" data-nc-submit-wrap><EsaButton size="sm" variant="primary" data-nc-submit>Add Note</EsaButton></span>
    <span class="bcn-nc__send" data-nc-send-wrap hidden><EsaButton size="md" variant="primary" iconOnly icon="arrow-up" label="Revise (⌘ Enter)" data-nc-send /></span>
  </div>
</div>

<style>
  .bcn-nc {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-200);
    width: min(30rem, 100%);
    padding: var(--spacing-300) var(--spacing-400) var(--spacing-300);
    background: var(--color-background-elevation-raised);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md);
    box-shadow: var(--elevation-3);
    font-family: var(--typography-font-family-sans);
    animation: bcn-nc-in 180ms cubic-bezier(0.2, 0.8, 0.2, 1);

    /* esa-textarea, borderless: the card is the field. */
    --form-border-width: 0;
    --color-background-field: transparent;
  }

  .bcn-nc[hidden],
  .bcn-nc [hidden] {
    display: none;
  }

  /* The card carries the field's focus (a sanctioned :focus-within wrapper). */
  .bcn-nc:focus-within {
    outline: var(--focus-ring-width, 2px) solid var(--focus-ring-color);
    outline-offset: 0;
  }

  /* In a footnote card the composer sits in flow: no float, no shadow. */
  .bcn-nc[data-inline] {
    width: 100%;
    box-shadow: none;
    animation: none;
  }

  /* Aldo writing: his shape, his green, his round send. */
  .bcn-nc[data-mode='aldo'] {
    border: 1.5px solid var(--bcn-aldo);
    border-radius: 20px;
    box-shadow: var(--bcn-aldo-prompt-shadow);
  }

  .bcn-nc[data-mode='aldo'][data-inline] {
    box-shadow: none;
  }

  .bcn-nc[data-mode='aldo']:focus-within {
    outline-color: var(--bcn-aldo-prompt-ring);
  }

  .bcn-nc__head {
    display: flex;
    align-items: center;
    gap: var(--spacing-200);
  }

  .bcn-nc__who {
    display: inline-flex;
  }

  .bcn-nc__title {
    font-size: var(--typography-label-md-strong-font-size);
    font-weight: var(--typography-label-md-strong-font-weight);
    color: var(--color-content-default);
  }

  .bcn-nc[data-mode='aldo'] .bcn-nc__title {
    color: var(--bcn-aldo-600);
  }


  /* The passage, in the document voice: what the note is about. */
  .bcn-nc__quote {
    margin: 0;
    font-family: var(--font-decorative, var(--typography-font-family-sans));
    font-style: italic;
    font-size: var(--typography-body-md-font-size);
    line-height: 1.5;
    color: var(--color-content-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* A person's note: the passage in the notes' highlight. */
  .bcn-nc:not([data-mode='aldo']) .bcn-nc__quote {
    font-style: normal;
  }

  .bcn-nc__hl {
    padding: 0.05em 0.1em;
    border-radius: 2px;
    background: var(--bcn-note-tint);
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  /* Aldo's: the passage on his tint, in italic (it is what will change). */
  .bcn-nc[data-mode='aldo'] .bcn-nc__hl {
    background: var(--bcn-aldo-50);
  }

  /* One ring, not two: the card's outline is this field's focus indicator, so the
     field's own ring is cleared (it would paint a band inside the card). */
  .bcn-nc__input {
    display: block;
    margin: 0 calc(-1 * var(--spacing-200));
    --focus-ring-color: transparent;
  }

  .bcn-nc__foot {
    display: flex;
    align-items: center;
    gap: var(--spacing-100);
  }

  .bcn-nc__keys {
    margin-right: auto;
    font-size: var(--typography-label-sm-font-size);
    color: var(--color-content-default-tertiary);
    white-space: nowrap;
  }

  /* Aldo's send: a round green control, re-pointing the button's own tokens (as
     BcnAldoPrompt's). */
  .bcn-nc__send {
    display: inline-flex;
    --button-radius-md: 999px;
    --color-background-brand: var(--bcn-aldo);
    --color-background-brand-hover: var(--bcn-aldo-600);
  }

  /* Aldo at work: a shimmer runs along the card's foot, the field dims and locks, and
     the keys hint reads "Aldo is revising…" in his green. */
  .bcn-nc[data-working] {
    position: relative;
    overflow: hidden;
  }

  .bcn-nc[data-working]::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--bcn-aldo), transparent);
    background-size: 50% 100%;
    background-repeat: no-repeat;
    animation: bcn-nc-work 1.1s linear infinite;
  }

  .bcn-nc[data-working] .bcn-nc__input {
    opacity: 0.6;
  }

  .bcn-nc[data-working] .bcn-nc__keys {
    color: var(--bcn-aldo-600);
    font-weight: var(--typography-font-weight-semibold);
  }

  @keyframes bcn-nc-work {
    from { background-position: -50% 0; }
    to { background-position: 150% 0; }
  }

  @keyframes bcn-nc-in {
    from { opacity: 0; transform: translateY(-3px); }
    to { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .bcn-nc { animation: none; }
    .bcn-nc[data-working]::after { animation: none; background: var(--bcn-aldo); }
  }
</style>
