---
// <BcnPlanRepoPage> — one plan in the repo model (new design, 2026-10-26; reworked 2026-10-27 after Andy's review,
// anchored on the setup wizard's three-step screens, which he praised 2026-10-15).
//
//   head card   the branch menu (Live, your draft, other people's drafts) and the page's quiet actions, the latest
//               change as one line, then Jamie's range control: Show and Dates as the console row, the overview as
//               the strip under it, the full width of the card (the wizard's console over its page strip)
//   body        the Gantt at the tactile density beside About, a pane with a grey header band that folds into a rail
//               from its own header (the wizard's Library pane)
//
// A draft is the same page in the same neutral chrome: the branch menu reads "Your draft", the title carries a quiet
// badge and the status line is the draft's. Nothing floods the page. Drags on Live check out the viewer's draft;
// Review and publish opens the revisions page. The runtime is ./plan-repo-page.ts.
//
// bcn-lego-checked: every control IS esa-button (ghost, small, with an icon) and the branch menu IS esa-popover;
// avatars ARE esa-avatar (BcnPlanPeople); counts ARE esa-badge; the chart and range ARE BcnPlanGantt and
// BcnPlanGanttRange. No esa- lego is a branch list, a commit line or a folding side pane; the pane and its rail
// follow the setup wizard's Library (BcnSw3Scan: a raw <button> rail, because esa-button lays out one horizontal
// label and the rail is a vertical one). Checked Beacon (pages/plan-gantt has a title row and a toolbar only).
// bcn-plan-repo-page is the reusable home for a plan page in the repo model.
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaBadge from '@esa/ecology/esa-badge.astro';
import EsaIcon from '@esa/ecology/esa-icon.astro';
import EsaEmptyState from '@esa/ecology/esa-empty-state.astro';
import EsaAlertBox from '@esa/ecology/esa-alert-box.astro';
import EsaCollapsible from '@esa/ecology/esa-collapsible.astro';
import BcnPlanGantt from './BcnPlanGantt.astro';
import BcnPlanGanttRange from './BcnPlanGanttRange.astro';
import BcnPlanRevisionsDialog from './BcnPlanRevisionsDialog.astro';
import BcnChangeNote from './BcnChangeNote.astro';
import BcnPlanBudgetSheet from './BcnPlanBudgetSheet.astro';
import BcnPlanItemsTable from './BcnPlanItemsTable.astro';
import BcnPlanImportDialog from './BcnPlanImportDialog.astro';
import BcnPlanSetupDialog from './BcnPlanSetupDialog.astro';
import BcnPlanDeliverables from './BcnPlanDeliverables.astro';
import BcnPlanDocuments from './BcnPlanDocuments.astro';
import BcnPlanElementMoveDialog from './BcnPlanElementMoveDialog.astro';
import { PLAN_ICON_PATHS } from '../../lib/planning/icons';
import { withBase } from '../../lib/base';

---

<div class="bcn-prp" data-bcn-plan-repo-page data-about="open">
  <!-- A link that points nowhere (2026-10-28, the review: a pasted link opened a blank "Plan"), and a Guest, who is on
       the plan for the transmittals sent to them, not its schedule or money (decision 2). Either stands in for the page. -->
  <div class="bcn-prp__stop" data-prp-stop="missing" hidden>
    <EsaEmptyState title="Plan Not Found" description="This link points to a plan that isn't here. It may have been deleted, or the sample was started over.">
      <a href={withBase('/prototypes/plans-repo/')}><EsaButton variant="ghost" appearance="outline" size="sm" icon="arrow-left">Back to Plans</EsaButton></a>
    </EsaEmptyState>
  </div>
  <div class="bcn-prp__stop" data-prp-stop="guest" hidden>
    <EsaEmptyState title="Shared With You for Review" description="This plan is shared with you for the transmittals sent to you. Your inbox lists them, with Confirm Receipt.">
      <a href={withBase('/prototypes/plans-repo/inbox/')}><EsaButton variant="primary" size="sm" icon="inbox" data-fill-icon="inbox">Sent to You</EsaButton></a>
    </EsaEmptyState>
  </div>
  <div class="bcn-prp__stop" data-prp-stop="outside" hidden>
    <EsaEmptyState title="Not Shared With You" description="You aren’t on this plan’s People.">
      <a href={withBase('/prototypes/plans-repo/')}><EsaButton variant="ghost" appearance="outline" size="sm" icon="arrow-left">Back to Plans</EsaButton></a>
    </EsaEmptyState>
  </div>
  <!-- Word for the person whose draft someone else published (2026-10-28), shown until they dismiss it. -->
  <div class="bcn-prp__notice" data-prp-notice hidden>
    <EsaAlertBox variant="success" title="Your Draft Was Published">
      <span class="bcn-prp__notice-body">
        <span data-prp-notice-text></span>
        <span class="bcn-prp__notice-actions">
          <span data-prp-notice-view><EsaButton variant="ghost" appearance="outline" size="sm">View Revision</EsaButton></span>
          <span data-prp-notice-dismiss><EsaButton variant="ghost" size="sm">Dismiss</EsaButton></span>
        </span>
      </span>
    </EsaAlertBox>
  </div>
  <section class="bcn-prp__head">
    <!-- In a draft (the band, kept 2026-10-27), this row becomes a neutral strip across the top of the card: the branch
         menu is its name, then the revision it's based on, then the draft's actions. One row, never a second switcher. -->
    <div class="bcn-prp__bar" data-prp-bar>
      <span class="bcn-prp__plan typography-title" data-prp-plan-name hidden></span>
      <!-- Edit-mode study, "tabs": Live and your draft as a two-way switch in place of the branch menu. -->
      <esa-button-toggle size="sm" label="" data-prp-tabs hidden></esa-button-toggle>
      <esa-popover position="bottom" trigger="click" data-prp-branch-popover>
        <span data-prp-branch-trigger>
          <!-- Every action in the strip names what it does on hover (2026-10-28): esa-tooltip, the dark knockout tip. -->
          <esa-tooltip text="Switch between Live and the drafts" position="below" align="start">
            <EsaButton variant="ghost" appearance="outline" size="sm" icon="git-branch" iconRight="chevron-down" data-fill-icon="git-branch">
              <span data-prp-branch-label>Live Plan</span>
            </EsaButton>
          </esa-tooltip>
        </span>
        <div slot="content" class="bcn-prp__branches" data-prp-branches role="menu" aria-label="Live Plan and Drafts"></div>
      </esa-popover>
      <span class="bcn-prp__base typography-body-sm" data-prp-base hidden>
        <span data-prp-base-rev></span>
        <span class="bcn-prp__behind" data-prp-base-behind hidden><span data-glyph="triangle-alert"></span><span data-prp-base-behind-text></span></span>
      </span>
      <esa-tooltip class="bcn-prp__count-tip" text="Compare and restore past revisions" position="below"><a class="bcn-prp__count typography-label-sm" data-prp-history-link><span data-glyph="history"></span><b data-prp-version-count>0</b> <span data-prp-version-noun>Revisions</span></a></esa-tooltip>
      <esa-tooltip class="bcn-prp__count-tip" text="Open a draft, or start yours" position="below"><a href="#" role="button" class="bcn-prp__count typography-label-sm" data-prp-draft-counter><span data-glyph="git-branch"></span><b data-prp-draft-count>0</b> <span data-prp-draft-noun>Drafts</span></a></esa-tooltip>
      <!-- The latest change, in the same row (2026-10-27): named as that, with when, then who and what (2026-10-28). It
           takes the row's free width, right-aligned, and truncates. -->
      <span class="bcn-prp__status typography-body-sm" data-prp-status>
        <span class="bcn-prp__status-when"><strong data-prp-status-label>Last Update</strong> <time data-prp-status-time></time></span>
        <span data-prp-status-avatar></span>
        <span class="bcn-prp__status-text"><strong data-prp-status-who></strong> <span data-prp-status-message></span></span>
        <span class="bcn-prp__status-meta typography-meta" data-prp-status-meta></span>
      </span>
    </div>

  </section>

  <div class="bcn-prp__body">
    <div class="bcn-prp__main">
      <!-- The plan's projected views (2026-10-28, Andy): Schedule, the Gantt, and Budget, the fiscal-year sheet; the
           same elements in both, switched from the page header. The panel's own header names the view, as About's does,
           and carries the plan's actions (2026-10-28, out of the strip). -->
      <section class="bcn-prp__views" aria-labelledby="prp-view-title">
        <!-- Draft mode, made unmistakable (2026-10-28, Andy: "going into draft mode isn't clear enough"): in a draft the
             header below fills with the draft owner's color (fill, Andy's pick). The other studies stay behind
             &drafthead=; ribbon puts this strip across the panel's top. -->
        <div class="bcn-prp__ribbon typography-label-sm" data-prp-ribbon hidden>
          <span data-prp-ribbon-avatar></span>
          <span data-prp-ribbon-text></span>
        </div>
        <header class="bcn-prp__views-head">
          <h2 class="bcn-prp__views-title typography-label-md-strong" id="prp-view-title">
            <span data-prp-view-title="schedule"><EsaIcon name="calendar" size="sm" />Schedule</span>
            <span data-prp-view-title="budget" hidden><EsaIcon name="sheet" paths={PLAN_ICON_PATHS.sheet} size="sm" />Budget</span>
            <span data-prp-view-title="documents" hidden><EsaIcon name="files" paths={PLAN_ICON_PATHS.files} size="sm" />Documents</span>
            <span data-prp-view-title="deliverables" hidden><EsaIcon name="package" paths={PLAN_ICON_PATHS.package} size="sm" />Deliverables</span>
          </h2>
          <!-- Which plan you're in, beside the view's title (2026-10-28, Andy, in place of the H1's badge): the plan
               menu's dot (orange Live, green yours, gray someone else's) and its name; then why it won't edit. -->
          <span class="bcn-prp__state typography-label-sm-strong" data-prp-state><span class="bcn-prp__state-dot" data-dot="live"></span><span class="bcn-prp__state-avatar" data-prp-state-avatar></span><span data-prp-state-label>Live Plan</span></span>
          <span class="bcn-prp__state-note" data-prp-state-note></span>
          <div class="bcn-prp__actions">
          <span class="bcn-prp__status-actions" data-prp-draft-actions hidden>
            <span data-prp-undo><esa-tooltip text="Undo (Ctrl+Z)" position="below"><EsaButton variant="ghost" size="xs" iconOnly icon="undo-2" label="Undo (Ctrl+Z)" data-fill-icon="undo-2" /></esa-tooltip></span>
            <span data-prp-redo><esa-tooltip text="Redo (Ctrl+Shift+Z)" position="below"><EsaButton variant="ghost" size="xs" iconOnly icon="redo-2" label="Redo (Ctrl+Shift+Z)" data-fill-icon="redo-2" /></esa-tooltip></span>
            <span data-prp-discard><esa-tooltip text="Delete this draft. Live is not affected." position="below"><EsaButton variant="ghost" size="xs" icon="trash-2">Discard</EsaButton></esa-tooltip></span>
          </span>
          <!-- Add the plan's top-level item (2026-10-28, the build-from-scratch review), named for its level; from Live it
               goes to your draft. Rows add their own children from the outline. -->
          <span data-prp-settings-head hidden><esa-tooltip text="Plan Settings" position="below" align="end"><EsaButton variant="ghost" size="xs" iconOnly icon="settings" label="Plan Settings" data-fill-icon="settings" /></esa-tooltip></span>
          <span data-prp-import hidden><esa-tooltip text="Add items from a CSV or a spreadsheet" position="below" align="end"><EsaButton variant="ghost" size="xs" icon="upload">Import</EsaButton></esa-tooltip></span>
          <span data-prp-add hidden><esa-tooltip text="Add an item at the top of the outline" position="below" align="end"><EsaButton variant="ghost" size="xs" icon="plus"><span data-prp-add-label>Add</span></EsaButton></esa-tooltip></span>
          <!-- Live's one action, with an edit pencil; ghost and small in the panel's header (2026-10-28, Andy). -->
          <span data-prp-edit><esa-tooltip text="Change dates without touching Live" position="below" align="end"><EsaButton variant="ghost" size="xs" icon="pencil" data-fill-icon="pencil">Edit in a Draft</EsaButton></esa-tooltip></span>
          <!-- Someone else's draft (2026-10-28): the way back to the plan of record, beside its one action. -->
          <span data-prp-back hidden><esa-tooltip text="Leave this draft for Live" position="below" align="end"><EsaButton variant="ghost" appearance="outline" size="xs" icon="arrow-left" data-fill-icon="arrow-left">Back to Live Plan</EsaButton></esa-tooltip></span>
          <span data-prp-copy hidden><esa-tooltip text="Start your draft from this one" position="below" align="end"><EsaButton variant="ghost" appearance="outline" size="xs" icon="copy">Copy to My Draft</EsaButton></esa-tooltip></span>
          <!-- The draft's way out, outlined and small like the rest of the header (2026-10-28, Andy: "they look so big"). -->
          <span data-prp-review hidden><esa-tooltip text="Compare with Live, then publish" position="below" align="end"><EsaButton variant="ghost" appearance="outline" size="xs" icon="git-merge" data-fill-icon="git-merge">Review and Publish</EsaButton></esa-tooltip></span>
          <!-- Someone who can't publish asks someone who can (2026-10-27); once asked, the button becomes its state. -->
          <span data-prp-ask hidden><esa-tooltip text="Ask someone who can publish" position="below" align="end"><EsaButton variant="ghost" appearance="outline" size="xs" icon="git-pull-request" data-fill-icon="git-pull-request">Ask to Publish</EsaButton></esa-tooltip></span>
          <span data-prp-asked hidden><EsaBadge value="Publish Requested" variant="neutral" size="sm" /></span>
          </div>
        </header>
        <!-- Scope (2026-10-27): what the chart shows. Search narrows the rows to the ones that match (with their parents,
             and the contents of a matching parent) and marks the hits; Show, Dates and the overview set the stretch of
             time. The panel's filter band, flush under its header, where Documents and Deliverables carry theirs
             (2026-10-28, Andy: "Why does the documents and deliverables have their filters below the chrome, but
             schedule and budget above?"): BcnViewToolbar's place, inset and 32px controls. -->
        <section class="bcn-prp__scope" aria-label="What the chart shows">
          <BcnPlanGanttRange stacked>
            <esa-text-field slot="lead" class="bcn-prp__search" size="sm" placeholder="Search the Plan" aria-label="Search the Plan" autocomplete="off" data-prp-search></esa-text-field>
            <!-- What needs attention across the whole plan (2026-10-28, the SOW review: the overdue view covered only
                 deliverables): every task and milestone by health, or due within 30 days. -->
            <esa-filter-dropdown slot="lead" size="sm" label="Health" name="health" multiple data-prp-health></esa-filter-dropdown>
            <!-- The schedule as a chart or a table you can edit (2026-10-28, the SOW review: table editing). -->
            <esa-button-toggle slot="lead" size="sm" label="" aria-label="Show As" data-prp-showas></esa-button-toggle>
          </BcnPlanGanttRange>
        </section>
        <div class="bcn-prp__view" data-prp-pane="schedule">
        <BcnPlanGantt label="Plan schedule" />
        <div class="bcn-prp__table" data-prp-table hidden><BcnPlanItemsTable /></div>
        <!-- What the bars' colors and outlines mean (2026-10-28): health fills, a conflict's outline, Scheduled's square ends. -->
        <div class="bcn-prp__legend typography-body-sm" data-prp-legend aria-label="Chart key">
          <span><i data-key="late"></i>Late</span>
          <span><i data-key="risk"></i>At Risk</span>
          <span><i data-key="blocked"></i>Blocked</span>
          <span><i data-key="done"></i>Completed</span>
          <span><i data-key="track"></i>On Track</span>
          <span><i data-key="conflict"></i>Conflict</span>
          <span><i data-key="scheduled"></i>Scheduled (Fixed)</span>
        </div>
        <!-- A plan with no items yet (2026-10-28, the build-from-scratch review): where its first one comes from. -->
        <div class="bcn-prp__no-match" data-prp-empty hidden>
          <EsaEmptyState size="sm" title="No Items Yet" description="Start the outline with its first item. It goes to your draft; Review and Publish takes it to Live.">
            <span class="bcn-prp__empty-actions">
              <span data-prp-empty-import><EsaButton variant="ghost" appearance="outline" size="sm" icon="upload">Import From a File</EsaButton></span>
              <span data-prp-empty-add><EsaButton variant="primary" size="sm" icon="plus"><span data-prp-empty-add-label>Add</span></EsaButton></span>
            </span>
          </EsaEmptyState>
        </div>
        <!-- A search that matches nothing: the chart steps aside for this (its own rule with no rows). -->
        <div class="bcn-prp__no-match" data-prp-no-match hidden>
          <EsaEmptyState size="sm" title="Nothing Matches" description="Try another word.">
            <span data-prp-search-clear><EsaButton variant="ghost" appearance="outline" size="sm">Clear Search</EsaButton></span>
          </EsaEmptyState>
        </div>
        </div>
        <div class="bcn-prp__view bcn-prp__view--budget" data-prp-pane="budget" hidden><BcnPlanBudgetSheet /></div>
        <!-- The plan's records, as views beside its projections (2026-10-28, decisions 1 to 8): every deliverable with its
             status, last send, receipt and completion. Records are Live's, so these read Live in any draft. -->
        <div class="bcn-prp__view bcn-prp__view--records" data-prp-pane="documents" hidden><BcnPlanDocuments /></div>
        <div class="bcn-prp__view bcn-prp__view--records" data-prp-pane="deliverables" hidden><BcnPlanDeliverables /></div>
      </section>
      <!-- A dependency, opened from its line: the two items, the lag, Unlink; saved to your draft. Anchored where it was clicked. -->
      <esa-popover position="bottom" trigger="click" class="bcn-prp__link-pop" data-prp-link-pop>
        <span class="bcn-prp__link-anchor" data-prp-link-anchor></span>
        <div slot="content" class="bcn-prp__link typography-body-sm">
          <div class="bcn-prp__link-names"><b data-prp-link-from></b><span data-glyph="arrow-right"></span><b data-prp-link-to></b></div>
          <esa-text-field data-prp-link-lag label="Lag (Days)" type="number" size="sm"></esa-text-field>
          <p class="bcn-prp__link-where" data-prp-link-where></p>
          <div class="bcn-prp__link-actions">
            <span data-prp-link-unlink><EsaButton variant="danger" appearance="soft" size="sm" icon="x">Unlink</EsaButton></span>
            <span data-prp-link-save><EsaButton variant="primary" size="sm">Save</EsaButton></span>
          </div>
        </div>
      </esa-popover>
    </div>

    <aside class="bcn-prp__about" aria-label="About this plan">
      <header class="bcn-prp__about-head">
        <span class="typography-label-md-strong" data-prp-pane-title>About</span>
        <span class="bcn-prp__about-tools">
          <!-- The plan's setup (2026-10-28, Andy: "an edit link to the about panel to edit the basic details/scope"): its
               Owners open BcnPlanSetupDialog here ("the basics of the plan config should be in a modal"). -->
          <span data-prp-settings hidden><esa-tooltip text="Name, Levels, People and Lists" position="below" align="end"><EsaButton variant="ghost" size="xs" icon="settings" data-fill-icon="settings">Settings</EsaButton></esa-tooltip></span>
          <EsaButton variant="chrome" iconOnly icon="chevrons-right" label="Collapse About" size="xs" data-prp-about-close />
        </span>
      </header>
      <div class="bcn-prp__about-body typography-body-sm">
        <!-- In a draft (2026-10-28, Andy: "as a user I have no idea what you're trying to show"): not the log of each
             drag, which Undo already walks, but what publishing it would change. One block per item the draft changed,
             its name on its own line, then each changed value named as the Review modal names it. Items that only
             moved with them fold into one line. -->
        <section class="bcn-prp__changes" data-prp-edits hidden>
          <p class="bcn-prp__draft-meta" data-prp-draft-meta></p>
          <h2 class="bcn-prp__changes-head typography-label-md-strong">Changes From Live <span data-prp-change-count hidden><EsaBadge value="0" size="xs" /></span></h2>
          <ol class="bcn-prp__change-list" data-prp-change-list></ol>
          <p class="bcn-prp__changes-empty" data-prp-changes-empty hidden></p>
          <div data-prp-followed hidden>
            <EsaCollapsible title="Followed" flush>
              <ul class="bcn-prp__followed" data-prp-followed-list></ul>
            </EsaCollapsible>
          </div>
        </section>
        <h2 class="typography-label-md-strong" data-prp-about-head hidden>About This Plan</h2>
        <p data-prp-desc></p>
        <dl class="bcn-prp__facts">
          <div><dt>Tracks</dt><dd data-prp-tracks></dd></div>
          <div><dt>Span</dt><dd data-prp-span></dd></div>
          <div><dt>Items</dt><dd data-prp-items></dd></div>
          <div><dt>Dependencies</dt><dd data-prp-deps></dd></div>
        </dl>
        <section>
          <h2 class="typography-label-md-strong">Revisions</h2>
          <div class="bcn-prp__list" data-prp-releases></div>
        </section>
        <section>
          <h2 class="typography-label-md-strong">Drafts</h2>
          <ul class="bcn-prp__list" data-prp-draftlist></ul>
        </section>
        <section>
          <h2 class="typography-label-md-strong">People</h2>
          <ul class="bcn-prp__people" data-prp-people></ul>
        </section>
      </div>
    </aside>
    <!-- The page's guard (2026-10-28, Andy: a UI modal, not the browser's confirm): Discard, and Copy over a draft. -->
    <esa-confirm-dialog data-prp-confirm variant="danger"></esa-confirm-dialog>
    <!-- Collapsed: a narrow rail, as the setup wizard's Library and the app's side nav fold. -->
    <button type="button" class="bcn-prp__rail" data-prp-about-open aria-label="Show About" title="Show About">
      <EsaIcon name="chevrons-left" size="sm" />
      <span class="bcn-prp__railname typography-label-sm-strong">About</span>
    </button>
  </div>
  <!-- Revisions in a modal (2026-10-28, after TalentBridge): the history, and a draft's review before it publishes. -->
  <BcnPlanRevisionsDialog />
  <BcnPlanSetupDialog />
  <BcnPlanElementMoveDialog />
  <BcnPlanImportDialog />
  <!-- An outline row's actions (2026-10-28): + Add (named for the level it adds) and its menu. -->
  <template data-prp-row-tpl="add"><span><esa-tooltip text="Add" position="below"><EsaButton variant="ghost" iconOnly icon="plus" label="Add" size="xs" /></esa-tooltip></span></template>
  <template data-prp-row-tpl="menu">
    <esa-dropdown-menu position="below-end">
      <EsaButton variant="ghost" iconOnly icon="ellipsis-vertical" label="Actions" size="xs" data-fill-icon="ellipsis-vertical" />
    </esa-dropdown-menu>
  </template>
  <BcnChangeNote />
</div>

<script>
  import '@esa/ecology/esa-popover';
  import '@esa/ecology/esa-confirm-dialog';
  import '@esa/ecology/esa-tooltip';
  import '@esa/ecology/esa-text-field';
  import '@esa/ecology/esa-button-toggle';
  import '@esa/ecology/esa-dropdown-menu';
  import '@esa/ecology/esa-filter-dropdown';
</script>

<style>
  .bcn-prp { display: flex; flex-direction: column; gap: var(--spacing-400); }
  .bcn-prp__notice-body { display: flex; align-items: center; flex-wrap: wrap; gap: var(--spacing-200) var(--spacing-400); }
  .bcn-prp__notice-actions { display: inline-flex; gap: var(--spacing-200); margin-inline-start: auto; }
  /* The H1's badge (2026-10-28, Andy): solid, white text, his orange on Live (below AA, his call) and the identity
     green in a draft. A label in a solid fill, against esa-badge's tinted rule, by Andy's call. */
  :global(.bcn-plan-state-badge) {
    --badge-bg: var(--bcn-live-badge);
    --badge-text-color: var(--color-content-default-knockout);
    --badge-border-color: transparent;
  }
  :global(.bcn-plan-state-badge[data-state='draft']) { --badge-bg: var(--bcn-mark-green); }
  .bcn-prp :global([hidden]) { display: none !important; }
  /* Not found, or a Guest: the empty state alone. */
  .bcn-prp[data-stopped] > :not([data-prp-stop]) { display: none !important; }
  .bcn-prp__stop { padding-block: var(--spacing-800); }
  .bcn-prp :global([data-glyph]) { display: inline-flex; color: var(--color-content-default-tertiary); }
  .bcn-prp :global([data-glyph] svg) { display: block; }

  /* ── The head: one row, chromeless in every mode (2026-10-28, Andy: no band, no padding when a draft opens) ── */
  /* Which plan and version this is, and what last happened to it, straight on the page. The scope card under it holds
     what the chart shows. Which plan you're in reads beside the view's title, below. */
  .bcn-prp__head { display: flex; flex-direction: column; }
  /* The view panel's filter band, as BcnViewToolbar draws it on Documents and Deliverables: flush under the panel's
     header, the band's inset, a rule under it, 32px controls at 14px. */
  .bcn-prp__scope {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-300);
    padding: var(--spacing-300) var(--spacing-400);
    background: var(--color-background-elevation-raised);
    border-block-end: 1px solid var(--color-border-default);
    --typography-microcopy-md-font-size: 14px;
    --typography-microcopy-md-strong-font-size: 14px;
    --typography-microcopy-md-subtle-font-size: 14px;
  }
  .bcn-prp__scope :global(esa-text-field) { --_field-padding-y: calc((32px - 1.3em) / 2 - var(--form-border-width, 1px)); }
  /* The search: BcnViewToolbar's width, on every view. */
  .bcn-prp__search { inline-size: 16rem; }
  .bcn-prp__bar { display: flex; align-items: center; gap: var(--spacing-200) var(--spacing-300); min-inline-size: 0; }
  .bcn-prp__bar[data-band] :is(.bcn-prp__count, .bcn-prp__count-tip) { display: none; }
  .bcn-prp__base { display: inline-flex; align-items: center; gap: var(--spacing-300); color: var(--color-content-default-secondary); white-space: nowrap; }
  .bcn-prp__behind { display: inline-flex; align-items: center; gap: var(--spacing-100); color: var(--color-content-default); }
  .bcn-prp__behind [data-glyph] { color: var(--color-content-utility-warning); }
  .bcn-prp__plan { white-space: nowrap; }
  /* Issued and working (2026-10-27): the chart scrolls inside its own frame, short enough that the page can never push
     its top under the app bar, so its axis and the title block in its corner stay in view while the rows scroll. */
  .bcn-prp[data-concept='issued'] { --bcn-plan-gantt-max-height: calc(100vh - 7rem); }
  .bcn-prp__count { display: inline-flex; align-items: center; gap: var(--spacing-100); color: var(--color-content-default-secondary); text-decoration: none; }
  .bcn-prp__count b { color: var(--color-content-default); font-weight: 600; }
  a.bcn-prp__count:hover { color: var(--color-content-default); }
  .bcn-prp__spacer { flex: 1; }

  /* The plan menu (dense, 2026-10-28): each row a bold name over a quiet line of facts, the current one checked at the
     right. Groups under small headed rules; no avatars, no indents. */
  .bcn-prp__branches { display: flex; flex-direction: column; inline-size: calc(20rem - 2px); padding: var(--spacing-100); }
  .bcn-prp__branches :global(.bcn-prp__branch-head) {
    display: flex;
    justify-content: space-between;
    gap: var(--spacing-200);
    margin-block-start: var(--spacing-100);
    padding: var(--spacing-200) var(--spacing-200) var(--spacing-100);
    border-block-start: 1px solid var(--color-border-default-subtle);
    color: var(--color-content-default-secondary);
  }
  .bcn-prp__branches :global(.bcn-prp__branch-head span) { color: var(--color-content-default-tertiary); font-weight: 400; }
  .bcn-prp__branches :global(.bcn-prp__branch-row) {
    display: grid;
    grid-template-columns: 0.5rem minmax(0, 1fr) 1rem;
    align-items: center;
    gap: var(--spacing-200);
    padding: var(--spacing-150, 6px) var(--spacing-200);
    border-radius: var(--radius-100, 4px);
    color: var(--color-content-default);
    text-decoration: none;
  }
  .bcn-prp__branches :global(.bcn-prp__branch-row:hover),
  .bcn-prp__branches :global(.bcn-prp__branch-row:focus-visible) { background: var(--color-background-elevation-sunken); }
  .bcn-prp__branches :global(.bcn-prp__branch-check) { display: inline-flex; color: var(--color-content-default); }
  /* bcn-lego-checked: esa-badge's dot is compile-time (.astro) and these rows are built at runtime; the dot is a
     colored span on the name's first line, in the H1 badge's colors. */
  .bcn-prp__branches :global(.bcn-prp__branch-dot) {
    align-self: start;
    inline-size: 0.5rem;
    block-size: 0.5rem;
    margin-block-start: 0.375rem;
    border-radius: 50%;
  }
  .bcn-prp__branches :global(.bcn-prp__branch-dot[data-dot='live']) { background: var(--bcn-live-badge); }
  .bcn-prp__branches :global(.bcn-prp__branch-dot[data-dot='mine']) { background: var(--bcn-mark-green); }
  .bcn-prp__branches :global(.bcn-prp__branch-dot[data-dot='other']) { background: var(--color-content-default-tertiary); }
  .bcn-prp__branches :global(.bcn-prp__branch-row--start) {
    display: flex;
    gap: var(--spacing-200);
    color: var(--color-content-link, var(--color-content-brand));
  }
  .bcn-prp__branches :global(.bcn-prp__branch-text) { display: flex; flex-direction: column; min-inline-size: 0; }
  .bcn-prp__branches :global(.bcn-prp__branch-name),
  .bcn-prp__branches :global(.bcn-prp__branch-sub) { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .bcn-prp__branches :global(.bcn-prp__branch-sub) { color: var(--color-content-default-secondary); }

  /* The latest change takes the row's free width, a step in from the counts, and truncates before anything else does. */
  /* The last update sits at the row's right end (2026-10-28, Andy: "the last update line in the header should be right
     aligned"): the plan menu and the counts lead, what last happened closes the row. It still truncates from the item's
     name when the row runs short. */
  .bcn-prp__status {
    display: flex;
    flex: 1 1 auto;
    justify-content: flex-end;
    align-items: center;
    gap: var(--spacing-200);
    min-inline-size: 0;
    margin-inline-start: var(--spacing-200);
  }
  /* The plan menu on the bare page (2026-10-28, Andy: it and Edit in a draft "should appear similarly sized"): the
     ghost button's transparent fill and pale edge vanished into the page, so it read smaller than the solid button
     beside it at the same 38px. A raised surface and the strong edge make it a select-like block of the same size. */
  .bcn-prp__bar [data-prp-branch-trigger] :global(.esa-button__native) {
    background: var(--color-background-elevation-raised);
    border-color: var(--color-border-default-strong);
  }
  .bcn-prp__bar [data-prp-branch-trigger] :global(.esa-button__native:hover) { background: var(--color-background-elevation-sunken); }
  .bcn-prp__status-when { white-space: nowrap; }
  .bcn-prp__status-when strong { font-weight: 600; }
  .bcn-prp__status-when time { color: var(--color-content-default-secondary); }
  .bcn-prp__status-when:has(time:empty) time { display: none; }
  /* Who, a hairline, then the change as data (BcnChangeNote): the item's name gives way first. */
  .bcn-prp__status-text { display: inline-flex; align-items: center; gap: var(--spacing-200); min-inline-size: 0; white-space: nowrap; }
  .bcn-prp__status-text strong { font-weight: 600; }
  .bcn-prp__status-text [data-prp-status-message] { display: inline-flex; min-inline-size: 0; }
  .bcn-prp__status-text strong:not(:empty) + [data-prp-status-message] { padding-inline-start: var(--spacing-200); border-inline-start: 1px solid var(--color-border-default); }
  .bcn-prp__notice-body [data-prp-notice-text] { display: inline-flex; align-items: center; gap: var(--spacing-300); min-inline-size: 0; }
  .bcn-prp__notice-body :global(.bcn-prp__notice-meta) { color: var(--color-content-default-secondary); white-space: nowrap; }
  .bcn-prp__status-meta { display: inline-flex; gap: var(--spacing-300); margin-inline-start: auto; color: var(--color-content-default-secondary); white-space: nowrap; }
  .bcn-prp__status-actions { display: inline-flex; align-items: center; gap: var(--spacing-100); }

  /* ── Body: the chart beside About (the wizard's Library pane, on the right) ── */
  /* About runs the chart's full height, open or folded (2026-10-28). The chart sets the row's height: About takes none
     of its own (block-size 0) and stretches to the row, its body scrolling when it holds more. */
  .bcn-prp__body { display: grid; grid-template-columns: minmax(0, 1fr) 17rem; gap: var(--spacing-400); align-items: stretch; }
  .bcn-prp[data-about='closed'] .bcn-prp__body { grid-template-columns: minmax(0, 1fr) 2.75rem; }
  .bcn-prp__main { min-inline-size: 0; position: relative; }
  /* The views' panel, About's twin (2026-10-28): a raised card under a sunken header that names the view and holds
     the plan's actions. Both headers share one height. */
  .bcn-prp__views {
    overflow: hidden;
    background: var(--color-background-elevation-raised);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-200);
    box-shadow: var(--elevation-2);
  }
  .bcn-prp__views-head,
  .bcn-prp__about-head { min-block-size: 3.25rem; box-sizing: border-box; }
  .bcn-prp__views-head {
    display: flex;
    align-items: center;
    gap: var(--spacing-300);
    padding: var(--spacing-100) var(--spacing-300) var(--spacing-100) var(--spacing-400);
    background: var(--color-background-elevation-sunken);
    border-block-end: 1px solid var(--color-border-default);
  }
  .bcn-prp__views-title { margin: 0; }
  .bcn-prp__views-title span { display: inline-flex; align-items: center; gap: var(--spacing-200); }
  .bcn-prp__views-title :global(.esa-icon) { color: var(--color-content-default-secondary); }
  .bcn-prp__actions { display: flex; align-items: center; gap: var(--spacing-200); margin-inline-start: auto; }
  .bcn-prp__state { display: inline-flex; align-items: center; gap: var(--spacing-150); white-space: nowrap; padding-inline-start: var(--spacing-100); }
  .bcn-prp__state-dot { inline-size: 0.5rem; block-size: 0.5rem; border-radius: 50%; background: var(--color-content-default-tertiary); flex: none; }
  .bcn-prp__state-dot[data-dot='live'] { background: var(--bcn-live-badge); }
  .bcn-prp__state-dot[data-dot='mine'] { background: var(--bcn-mark-green); }
  .bcn-prp__state-note { min-inline-size: 0; font-size: var(--font-size-100); font-style: italic; color: var(--color-content-default-secondary); }
  .bcn-prp__state-note:empty { display: none; }

  /* ── Draft mode studies (&drafthead=, 2026-10-28): --prp-draft is the draft owner's color, set in a draft only ── */
  .bcn-prp__state-avatar { display: none; }
  .bcn-prp__ribbon { display: none; }
  .bcn-prp[data-drafthead] .bcn-prp__state-avatar:not(:empty) { display: inline-flex; }
  .bcn-prp[data-drafthead] .bcn-prp__state-avatar:not(:empty) + * { margin-inline-start: 0; }
  .bcn-prp[data-drafthead] .bcn-prp__state:has(.bcn-prp__state-avatar:not(:empty)) .bcn-prp__state-dot { display: none; }

  /* 1. fill (Andy's): the header in their color, everything in it white. */
  .bcn-prp[data-drafthead='fill'] .bcn-prp__views-head,
  .bcn-prp[data-drafthead='full'] .bcn-prp__views-head {
    background: var(--prp-draft);
    border-block-end-color: var(--prp-draft);
    color: #fff;
  }
  .bcn-prp:is([data-drafthead='fill'], [data-drafthead='full']) .bcn-prp__views-head :is(.bcn-prp__views-title, .bcn-prp__state, .bcn-prp__state-note) { color: #fff; }
  .bcn-prp:is([data-drafthead='fill'], [data-drafthead='full']) .bcn-prp__views-title :global(.esa-icon) { color: #fff; }
  .bcn-prp:is([data-drafthead='fill'], [data-drafthead='full']) .bcn-prp__views-head :global(.esa-button__native) {
    color: #fff;
    background: transparent;
    border-color: rgb(255 255 255 / 0.55);
  }
  .bcn-prp:is([data-drafthead='fill'], [data-drafthead='full']) .bcn-prp__views-head :global(.esa-button__native:hover:not(:disabled)) { background: rgb(255 255 255 / 0.14); }
  .bcn-prp:is([data-drafthead='fill'], [data-drafthead='full']) .bcn-prp__views-head :global(.esa-button__native svg) { color: #fff; }
  .bcn-prp:is([data-drafthead='fill'], [data-drafthead='full']) .bcn-prp__state-avatar :global(.esa-avatar) { box-shadow: 0 0 0 2px rgb(255 255 255 / 0.85); }

  /* 2. tint: a wash of their color, the title and the draft's name in their ink, their avatar beside it. */
  .bcn-prp[data-drafthead='tint'] .bcn-prp__views-head {
    background: color-mix(in srgb, var(--prp-draft) 12%, var(--color-background-elevation-raised));
    border-block-end-color: color-mix(in srgb, var(--prp-draft) 35%, var(--color-border-default));
  }
  .bcn-prp[data-drafthead='tint'] .bcn-prp__views-head :is(.bcn-prp__views-title, .bcn-prp__state) { color: var(--prp-draft); }
  .bcn-prp[data-drafthead='tint'] .bcn-prp__views-title :global(.esa-icon) { color: var(--prp-draft); }

  /* 3. frame: a ring of their color round the whole panel, and the draft's name as a filled pill. */
  .bcn-prp[data-drafthead='frame'] .bcn-prp__views,
  .bcn-prp[data-drafthead='full'] .bcn-prp__views {
    border-color: var(--prp-draft);
    box-shadow: 0 0 0 1px var(--prp-draft), var(--elevation-2);
  }
  .bcn-prp[data-drafthead='frame'] .bcn-prp__state {
    padding: 2px var(--spacing-200) 2px 2px;
    border-radius: 999px;
    background: var(--prp-draft);
    color: #fff;
  }
  .bcn-prp[data-drafthead='frame'] .bcn-prp__state-avatar :global(.esa-avatar) { box-shadow: 0 0 0 1.5px rgb(255 255 255 / 0.85); }

  /* 4. ribbon: a strip of their color across the panel's top, saying so in words; the header stays as it is. */
  .bcn-prp[data-drafthead='ribbon'] .bcn-prp__ribbon:not([hidden]) {
    display: flex;
    align-items: center;
    gap: var(--spacing-200);
    padding: var(--spacing-150) var(--spacing-400);
    background: var(--prp-draft);
    color: #fff;
  }
  .bcn-prp__ribbon :global(.esa-avatar) { box-shadow: 0 0 0 1.5px rgb(255 255 255 / 0.85); }
  .bcn-prp__ribbon b { font-weight: 700; }

  /* 5. full: fill and frame together, the loudest. */
  /* On the sunken header an outlined ghost washes out: Review and Publish, Back and Copy keep a raised face. */
  .bcn-prp__actions :global(.esa-button--variant-ghost.esa-button--appearance-outline .esa-button__native) { background: var(--color-background-elevation-raised); }
  .bcn-prp__actions :global(.esa-button--variant-ghost.esa-button--appearance-outline .esa-button__native:hover:not(:disabled)) { background: color-mix(in srgb, var(--color-content-default) 6%, var(--color-background-elevation-raised)); }
  /* Inside the card, the chart drops its own frame. */
  .bcn-prp__view :global(.bcn-plan-gantt-host .bcn-plan-gantt) { border: 0; border-radius: 0; }
  /* The sheet runs flush in the panel, as the chart does; past the viewport it scrolls inside, header and total pinned. */
  .bcn-prp__view--budget { display: block; --bcn-pbs-max-height: calc(100vh - 10rem); }
  .bcn-prp__view .bcn-prp__no-match { border: 0; border-radius: 0; }
  /* The chart's key, quiet under the chart. Swatches read the same tokens the bars do. */
  .bcn-prp__legend { display: flex; flex-wrap: wrap; gap: var(--spacing-100) var(--spacing-400); padding: var(--spacing-200) var(--spacing-400); color: var(--color-content-default-secondary); border-top: 1px solid var(--color-border-default); }
  .bcn-prp__legend span { display: inline-flex; align-items: center; gap: var(--spacing-150); }
  .bcn-prp__legend i { inline-size: 1rem; block-size: 0.625rem; border-radius: 3px; background: var(--color-background-brand); }
  .bcn-prp__legend i[data-key='late'] { background: var(--bcn-status-overdue); }
  .bcn-prp__legend i[data-key='risk'] { background: var(--bcn-status-in-progress); }
  .bcn-prp__legend i[data-key='blocked'] { background: var(--bcn-status-on-hold); }
  .bcn-prp__legend i[data-key='done'] { background: var(--color-border-utility-success); }
  .bcn-prp__legend i[data-key='conflict'] { background: transparent; outline: 2px solid var(--color-border-utility-danger); outline-offset: -2px; }
  .bcn-prp__legend i[data-key='scheduled'] { border-radius: 0; }
  .bcn-prp__legend[hidden] { display: none; }
  .bcn-prp__table[hidden] { display: none; }
  .bcn-prp__empty-actions { display: inline-flex; gap: var(--spacing-200); flex-wrap: wrap; justify-content: center; }
  .bcn-prp__empty-actions [hidden] { display: none; }
  .bcn-prp[data-showas='table'] [data-prp-pane='schedule'] :global(.bcn-plan-gantt-host),
  .bcn-prp[data-showas='table'] .bcn-prp__legend { display: none; }
  /* Budget is about money, not dates: the date cluster and the scrubber step aside. */
  /* The record views carry their own search and filters: no chart scope, and no draft actions (records are Live's). */
  .bcn-prp:is([data-view='deliverables'], [data-view='documents']) .bcn-prp__scope,
  .bcn-prp:is([data-view='deliverables'], [data-view='documents']) .bcn-prp__actions { display: none; }
  /* Flush, as the chart and the sheet: the band runs edge to edge under the header, the table under it. */
  .bcn-prp__view--records { padding: 0; }
  .bcn-prp[data-view='budget'] .bcn-prp__scope :global(:is(.bcn-plan-range__group, .bcn-plan-range__overview, .bcn-plan-range__label)) { display: none; }
  .bcn-prp__no-match {
    padding: var(--spacing-800) var(--spacing-400);
    background: var(--color-background-elevation-raised);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-200);
  }
  .bcn-prp__link-pop { position: absolute; inset-inline-start: 0; inset-block-start: 0; }
  .bcn-prp__link-anchor { display: block; inline-size: 1px; block-size: 1px; }
  .bcn-prp__link { display: flex; flex-direction: column; gap: var(--spacing-300); inline-size: 20rem; }
  .bcn-prp__link-names { display: flex; align-items: center; gap: var(--spacing-200); flex-wrap: wrap; }
  .bcn-prp__link-actions { display: flex; justify-content: flex-end; gap: var(--spacing-200); }
  .bcn-prp__link-where { margin: 0; color: var(--color-content-default-secondary); }

  .bcn-prp__about {
    display: flex;
    flex-direction: column;
    block-size: 0;
    min-block-size: 100%;
    overflow: hidden;
    background: var(--color-background-elevation-raised);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-200);
    box-shadow: var(--elevation-2);
  }
  .bcn-prp[data-about='closed'] .bcn-prp__about { display: none; }
  .bcn-prp__about-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--spacing-200) var(--spacing-200) var(--spacing-200) var(--spacing-400);
    background: var(--color-background-elevation-sunken);
    border-block-end: 1px solid var(--color-border-default);
  }
  .bcn-prp__about-body { display: flex; flex: 1 1 auto; min-block-size: 0; overflow-y: auto; flex-direction: column; gap: var(--spacing-400); padding: var(--spacing-400); }
  .bcn-prp__about-body p { margin: 0; color: var(--color-content-default-secondary); }
  .bcn-prp__about-body section { display: flex; flex-direction: column; gap: var(--spacing-200); }
  .bcn-prp__about-body h2 { margin: 0; }
  .bcn-prp__about-tools { display: inline-flex; align-items: center; gap: var(--spacing-100); }
  /* A plan that tracks one view has no switch (esa-button-toggle's own display beats the hidden attribute). */
  :global([data-prp-view-toggle][hidden]) { display: none !important; }
  /* People: avatar, name, and their role at the end. */
  .bcn-prp__people { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--spacing-150); }
  .bcn-prp__people :global(li) { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: var(--spacing-200); }
  .bcn-prp__people :global(.bcn-prp__person-name) { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .bcn-prp__people :global(.bcn-prp__person-role) { color: var(--color-content-default-secondary); font-size: var(--font-size-100); }
  .bcn-prp__facts { margin: 0; display: flex; flex-direction: column; gap: var(--spacing-100); }
  .bcn-prp__facts div { display: flex; justify-content: space-between; gap: var(--spacing-200); }
  .bcn-prp__facts dt { color: var(--color-content-default-secondary); }
  .bcn-prp__facts dd { margin: 0; font-weight: 600; font-variant-numeric: tabular-nums; }
  /* A draft's changes from Live: each item a block, its name wrapping (never truncated to nothing), its values a
     two-column list under it; the figures in the figures face, as the sheet's. */
  .bcn-prp__changes { display: flex; flex-direction: column; gap: var(--spacing-200); padding-block-end: var(--spacing-300); border-block-end: 1px solid var(--color-border-default-subtle); }
  .bcn-prp__draft-meta { margin: 0; color: var(--color-content-default-secondary); }
  .bcn-prp__changes-head { display: flex; align-items: center; gap: var(--spacing-150); margin: 0; }
  .bcn-prp__changes-head [hidden] { display: none; }
  .bcn-prp__change-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .bcn-prp__change-list :global(li) { display: flex; flex-direction: column; gap: var(--spacing-100); padding-block: var(--spacing-200); }
  .bcn-prp__change-list :global(li + li) { border-block-start: 1px solid var(--color-border-default-subtle); }
  .bcn-prp__change-list :global(.bcn-prp__change-name) {
    all: unset;
    cursor: pointer;
    font-weight: 600;
    color: var(--color-content-default);
    overflow-wrap: anywhere;
  }
  .bcn-prp__change-list :global(.bcn-prp__change-name:hover) { text-decoration: underline; }
  .bcn-prp__change-list :global(.bcn-prp__change-name:focus-visible) { outline: 2px solid var(--color-border-focus, var(--color-content-brand)); outline-offset: 2px; border-radius: var(--radius-sm); }
  .bcn-prp__change-list :global(dl) { margin: 0; display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 2px var(--spacing-300); }
  .bcn-prp__change-list :global(dt) { color: var(--color-content-default-secondary); }
