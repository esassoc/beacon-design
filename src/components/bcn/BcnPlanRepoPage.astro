---
// <BcnPlanRepoPage> — one plan in the repo model (new design, 2026-10-26; reworked 2026-10-27 after Andy's review,
// anchored on the setup wizard's three-step screens, which he praised 2026-10-15).
//
//   head card   the branch menu (Live, your draft, other people's drafts) and the page's quiet actions, the latest
//               change as one line, then Jamie's range control: Show and Dates as the console row, the overview as
//               the strip under it, the full width of the card (the wizard's console over its page strip)
//   body        the Gantt at the tactile density beside About, a pane with a grey header band that folds into a rail
//               from its own header (the wizard's Library pane)
//
// A draft is the same page in the same neutral chrome: the branch menu reads "Your draft", the title carries a quiet
// badge and the status line is the draft's. Nothing floods the page. Drags on Live check out the viewer's draft;
// Review and publish opens the revisions page. The runtime is ./plan-repo-page.ts.
//
// bcn-lego-checked: every control IS esa-button (ghost, small, with an icon) and the branch menu IS esa-popover;
// avatars ARE esa-avatar (BcnPlanPeople); counts ARE esa-badge; the chart and range ARE BcnPlanGantt and
// BcnPlanGanttRange. No esa- lego is a branch list, a commit line or a folding side pane; the pane and its rail
// follow the setup wizard's Library (BcnSw3Scan: a raw <button> rail, because esa-button lays out one horizontal
// label and the rail is a vertical one). Checked Beacon (pages/plan-gantt has a title row and a toolbar only).
// bcn-plan-repo-page is the reusable home for a plan page in the repo model.
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaBadge from '@esa/ecology/esa-badge.astro';
import EsaIcon from '@esa/ecology/esa-icon.astro';
import BcnPlanGantt from './BcnPlanGantt.astro';
import BcnPlanGanttRange from './BcnPlanGanttRange.astro';
---

<div class="bcn-prp" data-bcn-plan-repo-page data-about="open">
  <section class="bcn-prp__head">
    <!-- Edit-mode study, "band": in a draft, a neutral strip across the top of the card carries the draft and its actions. -->
    <div class="bcn-prp__band typography-body-sm" data-prp-band hidden>
      <span data-glyph="git-branch"></span>
      <span class="bcn-prp__band-text" data-prp-band-text></span>
      <span class="bcn-prp__spacer"></span>
      <span class="bcn-prp__band-actions" data-prp-band-actions></span>
    </div>
    <div class="bcn-prp__bar">
      <!-- Edit-mode study, "tabs": Live and your draft as a two-way switch in place of the branch menu. -->
      <esa-button-toggle size="sm" label="" data-prp-tabs hidden></esa-button-toggle>
      <esa-popover position="bottom" trigger="click" data-prp-branch-popover>
        <span data-prp-branch-trigger>
          <EsaButton variant="ghost" appearance="outline" size="sm" icon="git-branch" iconRight="chevron-down" data-fill-icon="git-branch">
            <span data-prp-branch-label>Live plan</span>
          </EsaButton>
        </span>
        <div slot="content" class="bcn-prp__branches" data-prp-branches role="menu" aria-label="Live plan and drafts"></div>
      </esa-popover>
      <a class="bcn-prp__count typography-label-sm" data-prp-history-link><span data-glyph="history"></span><b data-prp-version-count>0</b> revisions</a>
      <span class="bcn-prp__count typography-label-sm"><span data-glyph="git-branch"></span><b data-prp-draft-count>0</b> drafts</span>
      <span class="bcn-prp__spacer"></span>
      <span data-prp-edit><EsaButton variant="ghost" appearance="outline" size="sm" icon="git-branch" data-fill-icon="git-branch">Edit in a draft</EsaButton></span>
      <span data-prp-copy hidden><EsaButton variant="ghost" appearance="outline" size="sm" icon="copy">Copy to my draft</EsaButton></span>
      <span data-prp-review hidden><EsaButton variant="primary" size="sm" icon="git-merge" data-fill-icon="git-merge">Review and publish</EsaButton></span>
    </div>

    <div class="bcn-prp__status typography-body-sm" data-prp-status>
      <span data-prp-status-avatar></span>
      <span class="bcn-prp__status-text"><strong data-prp-status-who></strong> <span data-prp-status-message></span></span>
      <span class="bcn-prp__status-meta typography-meta" data-prp-status-meta></span>
      <span class="bcn-prp__status-actions" data-prp-draft-actions hidden>
        <span data-prp-undo><EsaButton variant="ghost" size="sm" iconOnly icon="undo-2" label="Undo (Ctrl+Z)" data-fill-icon="undo-2" /></span>
        <span data-prp-redo><EsaButton variant="ghost" size="sm" iconOnly icon="redo-2" label="Redo (Ctrl+Shift+Z)" data-fill-icon="redo-2" /></span>
        <span data-prp-discard><EsaButton variant="ghost" size="sm" icon="trash-2">Discard</EsaButton></span>
      </span>
    </div>

    <BcnPlanGanttRange stacked />
  </section>

  <div class="bcn-prp__body">
    <div class="bcn-prp__main">
      <BcnPlanGantt label="Plan schedule" />
      <!-- A dependency, opened from its line on Live: the two items, the lag, Unlink. Anchored where it was clicked. -->
      <esa-popover position="bottom" trigger="click" class="bcn-prp__link-pop" data-prp-link-pop>
        <span class="bcn-prp__link-anchor" data-prp-link-anchor></span>
        <div slot="content" class="bcn-prp__link typography-body-sm">
          <div class="bcn-prp__link-names"><b data-prp-link-from></b><span data-glyph="arrow-right"></span><b data-prp-link-to></b></div>
          <esa-text-field data-prp-link-lag label="Lag (days)" type="number" size="sm"></esa-text-field>
          <div class="bcn-prp__link-actions">
            <span data-prp-link-unlink><EsaButton variant="danger" appearance="soft" size="sm" icon="x">Unlink</EsaButton></span>
            <span data-prp-link-save><EsaButton variant="primary" size="sm">Save</EsaButton></span>
          </div>
        </div>
      </esa-popover>
    </div>

    <aside class="bcn-prp__about" aria-label="About this plan">
      <header class="bcn-prp__about-head">
        <span class="typography-label-md-strong" data-prp-pane-title>About</span>
        <EsaButton variant="chrome" iconOnly icon="chevrons-right" label="Collapse About" size="xs" data-prp-about-close />
      </header>
      <div class="bcn-prp__about-body typography-body-sm">
        <section data-prp-edits hidden>
          <h2 class="typography-label-md-strong">Edits</h2>
          <ol class="bcn-prp__edits" data-prp-edit-list></ol>
        </section>
        <p data-prp-desc></p>
        <dl class="bcn-prp__facts">
          <div><dt>Span</dt><dd data-prp-span></dd></div>
          <div><dt>Items</dt><dd data-prp-items></dd></div>
          <div><dt>Dependencies</dt><dd data-prp-deps></dd></div>
        </dl>
        <section>
          <h2 class="typography-label-md-strong">Revisions</h2>
          <div class="bcn-prp__list" data-prp-releases></div>
        </section>
        <section>
          <h2 class="typography-label-md-strong">Drafts</h2>
          <ul class="bcn-prp__list" data-prp-draftlist></ul>
        </section>
        <section>
          <h2 class="typography-label-md-strong">Contributors</h2>
          <div data-prp-people></div>
        </section>
      </div>
    </aside>
    <template data-prp-tpl="back"><EsaButton variant="ghost" size="xs" iconOnly icon="rotate-ccw" label="Go back to this edit" /></template>
    <!-- Collapsed: a narrow rail, as the setup wizard's Library and the app's side nav fold. -->
    <button type="button" class="bcn-prp__rail" data-prp-about-open aria-label="Show About" title="Show About">
      <EsaIcon name="chevrons-left" size="sm" />
      <span class="bcn-prp__railname typography-label-sm-strong">About</span>
    </button>
  </div>
</div>

<script>
  import '@esa/ecology/esa-popover';
  import '@esa/ecology/esa-text-field';
  import '@esa/ecology/esa-button-toggle';
</script>

<style>
  .bcn-prp { display: flex; flex-direction: column; gap: var(--spacing-400); }
  .bcn-prp :global([hidden]) { display: none !important; }
  .bcn-prp :global([data-glyph]) { display: inline-flex; color: var(--color-content-default-tertiary); }
  .bcn-prp :global([data-glyph] svg) { display: block; }

  /* ── The head card: the wizard's step panel ── */
  .bcn-prp__head {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-300);
    padding: var(--spacing-400);
    background: var(--color-background-elevation-raised);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-200);
    box-shadow: var(--elevation-2);
  }
  .bcn-prp__band {
    display: flex;
    align-items: center;
    gap: var(--spacing-200);
    margin: calc(-1 * var(--spacing-400)) calc(-1 * var(--spacing-400)) 0;
    padding: var(--spacing-200) var(--spacing-400);
    background: var(--color-background-elevation-sunken);
    border-block-end: 1px solid var(--color-border-default);
    border-start-start-radius: var(--radius-200);
    border-start-end-radius: var(--radius-200);
  }
  .bcn-prp__band-text b { font-weight: 600; }
  .bcn-prp__band-actions { display: inline-flex; align-items: center; gap: var(--spacing-200); }
  .bcn-prp__bar { display: flex; align-items: center; flex-wrap: wrap; gap: var(--spacing-200) var(--spacing-300); }
  .bcn-prp__count { display: inline-flex; align-items: center; gap: var(--spacing-100); color: var(--color-content-default-secondary); text-decoration: none; }
  .bcn-prp__count b { color: var(--color-content-default); font-weight: 600; }
  a.bcn-prp__count:hover { color: var(--color-content-default); }
  .bcn-prp__spacer { flex: 1; }

  .bcn-prp__branches { display: flex; flex-direction: column; inline-size: calc(24rem - 2px); padding: var(--spacing-100) 0; }
  .bcn-prp__branches :global(.bcn-prp__branch-head) { color: var(--color-content-default-secondary); padding: var(--spacing-200) var(--spacing-300) var(--spacing-100); }
  .bcn-prp__branches :global(.bcn-prp__branch-row) {
    display: grid;
    grid-template-columns: 1.25rem auto minmax(0, 1fr);
    align-items: center;
    gap: var(--spacing-200);
    padding: var(--spacing-200) var(--spacing-300);
    border-radius: var(--radius-100, 4px);
    color: var(--color-content-default);
    text-decoration: none;
  }
  .bcn-prp__branches :global(.bcn-prp__branch-row:hover),
  .bcn-prp__branches :global(.bcn-prp__branch-row:focus-visible) { background: var(--color-background-elevation-sunken); }
  .bcn-prp__branches :global(.bcn-prp__branch-check) { color: var(--color-content-default); }
  .bcn-prp__branches :global(.bcn-prp__branch-name) { display: flex; flex-direction: column; min-inline-size: 0; }
  .bcn-prp__branches :global(.bcn-prp__branch-sub) { color: var(--color-content-default-secondary); }

  .bcn-prp__status {
    display: flex;
    align-items: center;
    gap: var(--spacing-200);
    min-block-size: 2rem;
    padding-block-start: var(--spacing-300);
    border-block-start: 1px solid var(--color-border-default-subtle);
  }
  .bcn-prp__status-text { min-inline-size: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .bcn-prp__status-text strong { font-weight: 600; }
  .bcn-prp__status-meta { margin-inline-start: auto; color: var(--color-content-default-secondary); white-space: nowrap; }
  .bcn-prp__status-actions { display: inline-flex; align-items: center; gap: var(--spacing-100); }

  /* ── Body: the chart beside About (the wizard's Library pane, on the right) ── */
  .bcn-prp__body { display: grid; grid-template-columns: minmax(0, 1fr) 17rem; gap: var(--spacing-400); align-items: start; }
  .bcn-prp[data-about='closed'] .bcn-prp__body { grid-template-columns: minmax(0, 1fr) 2.75rem; }
  .bcn-prp__main { min-inline-size: 0; position: relative; }
  .bcn-prp__link-pop { position: absolute; inset-inline-start: 0; inset-block-start: 0; }
  .bcn-prp__link-anchor { display: block; inline-size: 1px; block-size: 1px; }
  .bcn-prp__link { display: flex; flex-direction: column; gap: var(--spacing-300); inline-size: 20rem; }
  .bcn-prp__link-names { display: flex; align-items: center; gap: var(--spacing-200); flex-wrap: wrap; }
  .bcn-prp__link-actions { display: flex; justify-content: flex-end; gap: var(--spacing-200); }

  .bcn-prp__about {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--color-background-elevation-raised);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-200);
    box-shadow: var(--elevation-2);
  }
  .bcn-prp[data-about='closed'] .bcn-prp__about { display: none; }
  .bcn-prp__about-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--spacing-200) var(--spacing-200) var(--spacing-200) var(--spacing-400);
    background: var(--color-background-elevation-sunken);
    border-block-end: 1px solid var(--color-border-default);
  }
  .bcn-prp__about-body { display: flex; flex-direction: column; gap: var(--spacing-400); padding: var(--spacing-400); }
  .bcn-prp__about-body p { margin: 0; color: var(--color-content-default-secondary); }
  .bcn-prp__about-body section { display: flex; flex-direction: column; gap: var(--spacing-200); }
  .bcn-prp__about-body h2 { margin: 0; }
  .bcn-prp__facts { margin: 0; display: flex; flex-direction: column; gap: var(--spacing-100); }
  .bcn-prp__facts div { display: flex; justify-content: space-between; gap: var(--spacing-200); }
  .bcn-prp__facts dt { color: var(--color-content-default-secondary); }
  .bcn-prp__facts dd { margin: 0; font-weight: 600; font-variant-numeric: tabular-nums; }
  .bcn-prp__edits { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .bcn-prp__edits :global(li) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--spacing-200);
    align-items: start;
    padding-block: var(--spacing-200);
  }
  .bcn-prp__edits :global(li + li) { border-block-start: 1px solid var(--color-border-default-subtle); }
  .bcn-prp__edits :global(small) { display: block; color: var(--color-content-default-secondary); }
  .bcn-prp__edits :global(li[data-current]) { font-weight: 600; }
  .bcn-prp__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--spacing-200); }
  .bcn-prp__about :global(.bcn-prp__item) { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--spacing-200); align-items: start; }
  .bcn-prp__about :global(.bcn-prp__item a),
  .bcn-prp__about :global(.bcn-prp__item b) { color: var(--color-content-default); font-weight: 600; text-decoration: none; }
  .bcn-prp__about :global(.bcn-prp__item a:hover) { text-decoration: underline; }
  .bcn-prp__about :global(.bcn-prp__item small) { display: block; color: var(--color-content-default-secondary); }
  .bcn-prp__about :global(a.bcn-prp__more) { color: var(--color-content-default-secondary); text-decoration: underline; }

  .bcn-prp__rail {
    display: none;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-300);
    min-block-size: 10rem;
    padding: var(--spacing-300) 0;
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-200);
    background: var(--color-background-elevation-raised);
    box-shadow: var(--elevation-2);
    color: var(--color-content-default-secondary);
    font: inherit;
    cursor: pointer;
  }
  .bcn-prp[data-about='closed'] .bcn-prp__rail { display: flex; }
  .bcn-prp__rail:hover { color: var(--color-content-default); background: var(--color-background-elevation-sunken); }
  .bcn-prp__rail:focus-visible { outline: var(--focus-ring-width, 2px) solid var(--focus-ring-color); outline-offset: 2px; }
  .bcn-prp__railname { writing-mode: vertical-rl; color: var(--color-content-default); }

  .bcn-prp :global(.bcn-plan-people-stack) { display: inline-flex; flex-wrap: wrap; }
  .bcn-prp :global(.bcn-plan-people-stack > *) { margin-inline-start: -4px; box-shadow: 0 0 0 2px var(--color-background-elevation-raised); border-radius: 999px; }
  .bcn-prp :global(.bcn-plan-people-stack > :first-child) { margin-inline-start: 0; }

  @media (max-width: 1100px) {
    .bcn-prp__body, .bcn-prp[data-about='closed'] .bcn-prp__body { grid-template-columns: 1fr; }
    .bcn-prp__rail { display: none !important; }
  }
</style>
