---
// <BcnListActions>: the action group the obligation-list detail page sets in
// PageLayout's `utilities` slot, on the title row: Edit details, then Add
// obligations, lighter commitment then heavier.
//
// It decides nothing and holds no list state. Each control announces itself on
// `document` and the sibling that owns that surface answers:
//   Edit details        -> `list:edit-details`    (no detail) -> BcnListEditDetailsDialog
//   Add obligations     -> `list:add-obligations` (no detail) -> BcnListAddObligations
//   Add actions / commitments -> `list:add-members` -> BcnListAddMembers (addEvent prop)
//   Add evidence        -> `list:add-evidence`    ({one, many} noun) -> the app-wide
//                          bottom BcnEvidenceDrawer, in list mode (evidence-drawer.ts).
//                          Action and obligation lists; `evidence` prop is the noun.
// So the page can mount this before either of those exists.
//
// EXPORT IS NOT HERE. It was a third control opening a menu of three formats, and a
// menu is the wrong shape for what the formats turned out to be: two of them are files
// you download and the third is a live endpoint with a key to roll and a URL to copy.
// A dropdown row cannot hold a key. The three now sit as a section of the details rail,
// where the endpoint's own fields have somewhere to live. See BcnListExportPanel.
//
// bcn-lego-checked: esa-button is both controls and .cluster is the row. What is left
// in this file is the composition and the event wiring, which no lego provides.
import EsaButton from '@esa/ecology/esa-button.astro';

interface Props {
  /** The add verb's label and the event it announces. An obligation list adds
      obligations; an action or commitment list adds its own kind of member. */
  addLabel?: string;
  addEvent?: string;
  /** Offer bulk evidence for the list's members, named by this [one, many] noun. A
      commitment list has no evidence, so it passes none. */
  evidence?: readonly [string, string];
}
const { addLabel = 'Add obligations', addEvent = 'list:add-obligations', evidence } = Astro.props;
---

<div class="cluster bcn-list-actions" data-gap="sm" data-list-actions>
  {/* Neutral outline, both of them — Andy, 2026-09-23, from prod's own Edit Details /
      Edit Actions pair. esa-button's secondary paints a pale green outline, a banned
      accent here; ghost + outline is the house's neutral bordered button (BcnGridFooter,
      BcnWorkAreaBoard). The icon carries the verb, so neither needs to be filled to read
      as the way in. */}
  <EsaButton variant="ghost" appearance="outline" size="sm" icon="pencil" type="button" data-list-edit-details>Edit details</EsaButton>
  <EsaButton variant="ghost" appearance="outline" size="sm" icon="plus" type="button" data-list-add-obligations data-list-add-event={addEvent}>{addLabel}</EsaButton>
  {evidence && <EsaButton variant="ghost" appearance="outline" size="sm" icon="upload" type="button" data-list-add-evidence data-one={evidence[0]} data-many={evidence[1]}>Add evidence</EsaButton>}
</div>

<script>
  // Guarded: on a page without this group the whole block is inert.
  const root = document.querySelector<HTMLElement>('[data-list-actions]');

  if (root) {
    const announce = (type: string, detail?: unknown) => document.dispatchEvent(new CustomEvent(type, { bubbles: true, detail }));

    root
      .querySelector<HTMLButtonElement>('[data-list-edit-details]')
      ?.addEventListener('click', () => announce('list:edit-details'));
    root
      .querySelector<HTMLButtonElement>('[data-list-add-obligations]')
      ?.addEventListener('click', (e) =>
        announce((e.currentTarget as HTMLElement).dataset.listAddEvent || 'list:add-obligations'));
    root
      .querySelector<HTMLButtonElement>('[data-list-add-evidence]')
      ?.addEventListener('click', (e) => {
        const { one, many } = (e.currentTarget as HTMLElement).dataset;
        announce('list:add-evidence', { one, many });
      });
  }
</script>

<style>
  /* No outer margin: PageLayout's `utilities` slot is itself a flex row inside a
     space-between title row, so the title row already owns this group's placement.
     flex-end is what keeps it against the right edge in the one case the parent
     cannot cover -- when the two controls wrap onto their own line. */
  .bcn-list-actions {
    margin: 0;
    justify-content: flex-end;
  }
</style>
