---
// <BcnListActions>: the action group the obligation-list detail page sets in
// PageLayout's `utilities` slot, on the title row: Edit details, then Add
// obligations, lighter commitment then heavier.
//
// It decides nothing and holds no list state. Each control announces itself on
// `document` and the sibling that owns that surface answers:
//   Edit details        -> `list:edit-details`    (no detail) -> BcnListEditDetailsDialog
//   Add obligations     -> `list:add-obligations` (no detail) -> BcnListAddObligations
// So the page can mount this before either of those exists.
//
// EXPORT IS NOT HERE. It was a third control opening a menu of three formats, and a
// menu is the wrong shape for what the formats turned out to be: two of them are files
// you download and the third is a live endpoint with a key to roll and a URL to copy.
// A dropdown row cannot hold a key. The three now sit as a section of the details rail,
// where the endpoint's own fields have somewhere to live. See BcnListExportPanel.
//
// bcn-lego-checked: esa-button is both controls and .cluster is the row. What is left
// in this file is the composition and the event wiring, which no lego provides.
import EsaButton from '@esa/ecology/esa-button.astro';
---

<div class="cluster bcn-list-actions" data-gap="sm" data-list-actions>
  {/* Ghost, not secondary. esa-button's secondary paints --color-background-brand-subtle
      (#effefb) inside --color-border-brand (#b9d6d2) — a pale green outline, which is a
      banned accent in this house and read as a second primary beside the real one. Ghost
      puts the weight where the commitment is: one filled button on this row. */}
  <EsaButton variant="ghost" size="sm" type="button" data-list-edit-details>Edit details</EsaButton>

  <EsaButton variant="primary" size="sm" type="button" data-list-add-obligations>Add obligations</EsaButton>
</div>

<script>
  // Guarded: on a page without this group the whole block is inert.
  const root = document.querySelector<HTMLElement>('[data-list-actions]');

  if (root) {
    const announce = (type: string) => document.dispatchEvent(new CustomEvent(type, { bubbles: true }));

    root
      .querySelector<HTMLButtonElement>('[data-list-edit-details]')
      ?.addEventListener('click', () => announce('list:edit-details'));
    root
      .querySelector<HTMLButtonElement>('[data-list-add-obligations]')
      ?.addEventListener('click', () => announce('list:add-obligations'));
  }
</script>

<style>
  /* No outer margin: PageLayout's `utilities` slot is itself a flex row inside a
     space-between title row, so the title row already owns this group's placement.
     flex-end is what keeps it against the right edge in the one case the parent
     cannot cover -- when the two controls wrap onto their own line. */
  .bcn-list-actions {
    margin: 0;
    justify-content: flex-end;
  }
</style>
