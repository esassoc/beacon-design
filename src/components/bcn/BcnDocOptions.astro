---
// <BcnDocOptions> — the brief's open questions as switches above an export document:
// Layout, Action Rows, Brand, Paper. Specimen chrome only; prod's print route has none
// of it and prints whichever answer Andy picks.
//
// Each switch writes one data attribute on <BcnDocSheet>'s root (data-doc-<key>), which
// is all the document reads, and mirrors it into the URL (?layout=table&paper=a4) so a
// variant can be linked to and the PDF script can print it. Paper also writes the
// page's @page size; @page cannot live in a component's scoped CSS (or prod's Shadow
// DOM), so it is a <style> this script owns in <head>.
//
// bcn-lego-checked: every switch IS esa-button-toggle (the segmented single-select);
// the row is .cluster from layouts.css. The bar's surface is this file's: no esa- lego
// is a free-standing toolbar (esa-app-bar is page chrome with a title slot).
import { DOC_OPTIONS } from '../../data/list-export-documents';

interface Props {
  /** Hide the switches that only matter to documents holding actions. */
  hasActions: boolean;
}
const { hasActions } = Astro.props;
const sets = DOC_OPTIONS.filter((s) => hasActions || !s.actionsOnly);
---

<div class="bcn-doc-options" data-doc-options>
  <div class="cluster" data-gap="md">
    {sets.map((s) => (
      <esa-button-toggle
        size="sm"
        label={s.label}
        value={s.default}
        data-doc-option={s.key}
        data-default={s.default}
        data-options={JSON.stringify(s.options)}
      ></esa-button-toggle>
    ))}
  </div>
</div>

<script>
  import '@esa/ecology/esa-button-toggle';

  type Toggle = HTMLElement & { options: unknown[]; value: string };
  const PAGE_SIZE: Record<string, string> = { letter: 'letter', a4: 'A4' };

  const doc = document.querySelector<HTMLElement>('[data-doc]');
  const toggles = Array.from(document.querySelectorAll<Toggle>('[data-doc-option]'));

  if (doc && toggles.length) {
    const pageRule = document.createElement('style');
    pageRule.dataset.docPage = '';
    document.head.append(pageRule);

    const params = new URLSearchParams(window.location.search);

    const apply = (key: string, value: string) => {
      doc.setAttribute(`data-doc-${key}`, value);
      if (key === 'paper') pageRule.textContent = `@page { size: ${PAGE_SIZE[value] ?? 'letter'}; margin: 20mm; }`;
    };

    const syncUrl = () => {
      const next = new URLSearchParams();
      toggles.forEach((t) => {
        const key = t.dataset.docOption!;
        if (t.value && t.value !== t.dataset.default) next.set(key, t.value);
      });
      const q = next.toString();
      history.replaceState(null, '', `${window.location.pathname}${q ? `?${q}` : ''}`);
    };

    // Every attribute is settled before the element upgrades, so a printed page never
    // sees the defaults flash in ahead of the URL's choice.
    toggles.forEach((t) => {
      const key = t.dataset.docOption!;
      apply(key, params.get(key) ?? t.dataset.default ?? '');
    });

    customElements.whenDefined('esa-button-toggle').then(() => {
      toggles.forEach((t) => {
        const key = t.dataset.docOption!;
        t.options = JSON.parse(t.dataset.options ?? '[]');
        t.value = params.get(key) ?? t.dataset.default ?? '';
        t.addEventListener('change', () => {
          apply(key, t.value);
          syncUrl();
        });
      });
    });
  }
</script>

<style>
  .bcn-doc-options {
    max-inline-size: var(--bcn-print-letter-width);
    margin: 0 auto var(--spacing-400);
    padding: var(--spacing-300) var(--spacing-400);
    background: var(--color-background-elevation-raised);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md);
  }

  @media print {
    .bcn-doc-options {
      display: none;
    }
  }
</style>
