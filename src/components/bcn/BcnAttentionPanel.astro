---
// <BcnAttentionPanel> — the Compliance Dashboard's "Needs Attention &
// Non-Compliance" panel. One esa-card holding three things the compliance lead
// asks in sequence: WHERE the active ones are (a non-interactive
// BcnObservationMap inset), WHAT is still outstanding (the item list,
// worst-first, each linking straight into its Observations detail), and HOW to
// take it off-platform (spreadsheet + KML exports). The category breakdown
// lives in bcn-oversight-hero instead (split by severity, next to the donut) —
// this panel doesn't repeat it.
//
// Everything is handed in already sorted by the caller — this component never sorts,
// filters, or reasons about severity; it only renders and derives the map pins.
//
// bcn-lego-checked: everything here IS a lego: esa-card shell + actions/footer
// slots, esa-button for all four actions (exports are plain client-side Blob
// downloads — no primitive gap), esa-badge for the age, esa-empty-state for the
// zero case, bcn-status-chip for the value-driven severity color, and
// bcn-observation-map for the inset.
import EsaCard from '@esa/ecology/esa-card.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaBadge from '@esa/ecology/esa-badge.astro';
import EsaEmptyState from '@esa/ecology/esa-empty-state.astro';
import BcnStatusChip from './BcnStatusChip.astro';
import BcnObservationMap from './BcnObservationMap.astro';

interface OutstandingItem {
  id: string;
  category: string;
  severity: 'needs-attention' | 'non-compliance';
  severityLabel: string;
  /** SSR color for the severity chip; may be a `var(--color-background-utility-danger)` string. */
  severityHex: string;
  daysActive: number;
  area: string;
  lat: number;
  lng: number;
}
interface Props {
  /** Already sorted worst-first by the caller. */
  outstanding: OutstandingItem[];
  /** Base route to the Observations list page. */
  observationsHref: string;
  /** Base filename (no extension) for the two exports. */
  exportFileBase?: string;
}
const {
  outstanding,
  observationsHref,
  exportFileBase = 'cottonwood-oversight-observations',
} = Astro.props;

// Map pins come straight off the outstanding items — the inset shows exactly the
// rows in the list beside it, colored by the same severity value.
const mapPins = outstanding.map((item) => ({
  id: item.id,
  lat: item.lat,
  lng: item.lng,
  label: `${item.id} — ${item.category}`,
  hex: item.severityHex,
}));

// `?open=<id>` — the Observations page reads this on load and auto-opens the detail
// dialog. `?severity=<severity>` pre-filters that list to one severity.
const openHref = (id: string) => `${observationsHref}?open=${encodeURIComponent(id)}`;
const severityHref = (severity: string) => `${observationsHref}?severity=${encodeURIComponent(severity)}`;

const attentionCount = outstanding.filter((i) => i.severity === 'needs-attention').length;
const nonComplianceCount = outstanding.filter((i) => i.severity === 'non-compliance').length;

const payload = { outstanding, fileBase: exportFileBase };
---

<EsaCard title="Needs Attention & Non-Compliance">
  <Fragment slot="actions">
    <EsaButton id="ap-export-csv" variant="ghost" appearance="outline" size="sm" icon="arrow-down">
      Export spreadsheet
    </EsaButton>
    <EsaButton id="ap-export-kml" variant="ghost" appearance="outline" size="sm" icon="map-pin">
      Export KMZ
    </EsaButton>
  </Fragment>

  <!-- Where the active ones are (fixed aside) + what is still outstanding (fluid
       main). The `sidebar` primitive gives its FIRST child the fixed
       `--sidebar-width` basis and its LAST child the fluid flex-grow:999 — DOM
       order sets those roles; `data-side="end"` only reorders them visually. So
       the map goes first (fixed-width role) and the list goes last (fluid
       role), and `data-side="end"` then draws the map on the right where it
       reads as the aside. -->
  <div class="bcn-apanel__body sidebar" data-gap="lg" data-side="end">
    <div class="bcn-apanel__inset stack" data-gap="xs">
      <h4 class="bcn-apanel__heading typography-label-xs">Active issue locations</h4>
      <BcnObservationMap
        observations={mapPins}
        mapId="attention-panel"
        height="260px"
        interactive={false}
      />
    </div>

    <section class="bcn-apanel__outstanding stack" data-gap="sm">
      <h4 class="bcn-apanel__heading typography-label-xs">Outstanding items ({outstanding.length})</h4>
      {outstanding.length === 0 ? (
        <EsaEmptyState
          size="sm"
          title="Nothing outstanding"
          description="Every flagged observation has been resolved or closed out."
        />
      ) : (
        <ul class="bcn-apanel__list stack" data-gap="2xs">
          {outstanding.map((item) => (
            <li class="bcn-apanel__row">
              <a class="bcn-apanel__id" href={openHref(item.id)}>{item.id}</a>
              <BcnStatusChip
                status={item.severity}
                label={item.severityLabel}
                hex={item.severityHex}
              />
              <span class="bcn-apanel__category typography-body-sm">{item.category}</span>
              <span class="bcn-apanel__area typography-body-sm">{item.area}</span>
              <EsaBadge
                value={`${item.daysActive}d active`}
                variant={item.severity === 'non-compliance' ? 'danger' : 'warning'}
                size="sm"
              />
            </li>
          ))}
        </ul>
      )}
    </section>
  </div>

  <Fragment slot="footer">
    <div class="cluster" data-gap="sm">
      <EsaButton
        variant="ghost"
        appearance="outline"
        size="sm"
        href={severityHref('needs-attention')}
      >
        All needs attention ({attentionCount})
      </EsaButton>
      <EsaButton
        variant="ghost"
        appearance="outline"
        size="sm"
        href={severityHref('non-compliance')}
      >
        All non-compliance ({nonComplianceCount})
      </EsaButton>
    </div>
  </Fragment>
</EsaCard>

<script type="application/json" id="ap-data" set:html={JSON.stringify(payload)}></script>

<script>
  // Exports are hand-built here (no grid on this panel to delegate to): the same
  // Blob + URL.createObjectURL + temporary <a download> technique AG Grid's
  // exportDataAsCsv uses on the table pages in this repo.
  type Row = {
    id: string;
    category: string;
    severity: string;
    severityLabel: string;
    daysActive: number;
    area: string;
    lat: number;
    lng: number;
  };

  const node = document.getElementById('ap-data');
  const data = JSON.parse(node?.textContent || '{}') as {
    outstanding?: Row[];
    fileBase?: string;
  };
  const rows = data.outstanding ?? [];
  const fileBase = data.fileBase ?? 'oversight-observations';

  function download(contents: string, filename: string, mime: string) {
    const url = URL.createObjectURL(new Blob([contents], { type: mime }));
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);
  }

  // RFC-4180: quote any field containing a comma, quote or newline; double the quotes.
  function csvField(value: string | number) {
    const s = String(value);
    return /[",\r\n]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s;
  }

  function toCsv(items: Row[]) {
    const header = ['ID', 'Category', 'Severity', 'Area', 'Days Active'];
    const lines = [header.join(',')];
    for (const r of items) {
      lines.push(
        [r.id, r.category, r.severityLabel || r.severity, r.area, r.daysActive]
          .map(csvField)
          .join(','),
      );
    }
    return lines.join('\r\n');
  }

  function xml(value: string | number) {
    return String(value)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&apos;');
  }

  // A real KMZ is just this KML zipped; pulling in a zip library for a design
  // prototype is unwarranted scope, and a bare .kml opens in Google Earth / ArcGIS
  // / QGIS all the same.
  function toKml(items: Row[]) {
    const placemarks = items
      .map(
        (r) => `  <Placemark>
    <name>${xml(r.id)}</name>
    <description>Category: ${xml(r.category)}
Severity: ${xml(r.severityLabel || r.severity)}
Days active: ${xml(r.daysActive)}
Work area: ${xml(r.area)}</description>
    <Point><coordinates>${r.lng},${r.lat},0</coordinates></Point>
  </Placemark>`,
      )
      .join('\n');
    return `<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
<Document>
  <name>${xml(fileBase)}</name>
${placemarks}
</Document>
</kml>`;
  }

  document.getElementById('ap-export-csv')?.addEventListener('click', () => {
    download(toCsv(rows), `${fileBase}.csv`, 'text/csv;charset=utf-8');
  });

  document.getElementById('ap-export-kml')?.addEventListener('click', () => {
    download(toKml(rows), `${fileBase}.kml`, 'application/vnd.google-earth.kml+xml');
  });
</script>

<style>
  /* ── Composition glue: the map inset is the sidebar primitive's fixed-width
     aside (data-side="end" renders it right of the outstanding list, which
     stays first in reading order). ── */
  .bcn-apanel__body {
    --sidebar-width: 19rem;
    --sidebar-content-min: 52%;
    align-items: stretch;
  }

  .bcn-apanel__heading {
    margin: 0;
    color: var(--color-content-default-secondary);
  }

  /* ── Outstanding items ── */
  .bcn-apanel__list { list-style: none; padding: 0; margin: 0; }
  .bcn-apanel__row {
    display: grid;
    /* Category and area each get their OWN flexible share (not one 1fr next to
       an uncapped auto) so neither column crowds the other, and the row gets
       its own inline padding so content doesn't sit flush against the card's
       edges. */
    grid-template-columns: 7.5rem auto minmax(8rem, 1fr) minmax(9rem, 1fr) auto;
    align-items: center;
    gap: var(--spacing-400);
    padding-block: var(--spacing-150);
    padding-inline: var(--spacing-200);
  }
  .bcn-apanel__list > li + li { border-top: 1px solid var(--color-border-default-subtle); }

  .bcn-apanel__id {
    font-size: var(--font-size-150);
    font-weight: var(--typography-font-weight-semibold);
    color: var(--color-background-brand);
    text-decoration: underline;
    text-underline-offset: 2px;
    white-space: nowrap;
  }
  .bcn-apanel__id:hover { color: var(--color-background-brand-hover); }

  /* Dense data row: .typography-body-sm (14px), darkened rather than grayed out. */
  .bcn-apanel__category,
  .bcn-apanel__area {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .bcn-apanel__category { color: var(--color-content-default); }
  .bcn-apanel__area { color: var(--color-content-default-secondary); }

  /* Narrow: the row wraps to id + chip on one line, the rest beneath. */
  @media (max-width: 40rem) {
    .bcn-apanel__row {
      grid-template-columns: auto 1fr;
      row-gap: var(--spacing-100);
    }
    .bcn-apanel__category { grid-column: 1 / -1; }
    .bcn-apanel__area { grid-column: 1 / -1; }
  }
</style>
