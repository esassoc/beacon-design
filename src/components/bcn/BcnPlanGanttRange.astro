---
// <BcnPlanGanttRange> — the plan Gantt's toolbar (new design, 2026-10-21, not in Beacon): what stretch of time the
// chart shows, and the page's actions. Composed on BcnFilterBar, the house two-band filter bar, compact (32px controls) and plain:
//
//   top band     Show [Whole plan · 5 years · 2 years · 1 year · 6 months · Custom]        …the page's actions →
//   range band   Dates [From] [To] [the overview strip, the rest of the band]
//
// Filters left, verbs right (BcnSwFilterRow's rule, Beacon's grid header): the `actions` slot lands in the bar's `verbs`
// slot. The overview is a mini-map of the plan's parents with the range in view as a window to drag (move it by its
// middle, resize it by either edge, or click the map to centre it there). A chosen range is fitted to the chart's
// width; Whole plan is her fixed scale, scrolling sideways. Remembered per plan in this browser. Plain (no card): the
// bands head the chart directly. With nothing dated, the date controls and the range band hide and only the actions
// remain.
//
// The runtime is plan-gantt-range.ts (setupPlanGanttRange), driven by plan-workspace.ts.
//
// bcn-lego-checked: the card IS BcnFilterBar (its lead / scope / verbs slots and filters band); the presets ARE
// esa-button-toggle, From / To ARE esa-date-picker. No esa- lego is a date-range zoom control (esa-filter-* are list
// filters, not a chart window; esa-range-slider takes one number, not a draggable window over a mini-map); checked
// Beacon (ui-viz-gantt has a fixed scale and no zoom). The overview is this component's own: the mini-map, the window
// and its two edge handles (each a role="slider" for the keyboard).
import BcnFilterBar from './BcnFilterBar.astro';

interface Props {
  /** The overview on its own row under the bar, the full width of the host and taller (new, 2026-10-27: the repo-model
   *  prototype, after the setup wizard's page strip). Off, it sits in the Dates band beside the pickers (Jamie's). */
  stacked?: boolean;
}
const { stacked = false } = Astro.props;
---

<div class:list={['bcn-plan-range', stacked && 'bcn-plan-range--stacked']} data-bcn-plan-range>
  {stacked ? (
    <>
      {/* Stacked (the setup wizard's console over its strip): one row, Show left and Dates right, then the strip. */}
      <div class="bcn-plan-range__console">
        <!-- lead: the page's own scoping control that comes first (the plan page's search, 2026-10-27). -->
        <slot name="lead" />
        <span class="bcn-plan-range__label typography-label-sm">Show</span>
        <esa-button-toggle size="sm" label="" data-pr-preset></esa-button-toggle>
        <span class="bcn-plan-range__spacer"></span>
        <slot name="actions" />
        {/* The label and its pickers wrap as one, never "Dates" alone at the end of a line. */}
        <span class="bcn-plan-range__group">
          <span class="bcn-plan-range__label typography-label-sm">Dates</span>
          <span class="bcn-plan-range__dates" role="group" aria-label="Dates">
            <esa-date-picker size="sm" data-pr-start></esa-date-picker>
            <esa-date-picker size="sm" data-pr-end></esa-date-picker>
          </span>
        </span>
      </div>
    <div class="bcn-plan-range__overview" data-pr-overview role="group" aria-label="Range">
      <svg class="bcn-plan-range__mini" data-pr-mini aria-hidden="true" preserveAspectRatio="none"></svg>
      <div class="bcn-plan-range__shade" data-pr-shade="start"></div>
      <div class="bcn-plan-range__shade" data-pr-shade="end"></div>
      <div class="bcn-plan-range__window" data-pr-window tabindex="0" role="group">
        <span class="bcn-plan-range__handle bcn-plan-range__handle--start" data-pr-handle="start" role="slider" tabindex="0" aria-label="Range start"></span>
        <span class="bcn-plan-range__handle bcn-plan-range__handle--end" data-pr-handle="end" role="slider" tabindex="0" aria-label="Range end"></span>
      </div>
    </div>
    </>
  ) : (
    <BcnFilterBar compact plain fillFilters leadLabel="Show" filtersLabel="Dates">
      <esa-button-toggle slot="lead" size="sm" label="" data-pr-preset></esa-button-toggle>
      <slot name="actions" slot="verbs" />

      <span class="bcn-plan-range__dates" role="group" aria-label="Dates">
        <esa-date-picker size="sm" data-pr-start></esa-date-picker>
        <esa-date-picker size="sm" data-pr-end></esa-date-picker>
      </span>
    <div class="bcn-plan-range__overview" data-pr-overview role="group" aria-label="Range">
      <svg class="bcn-plan-range__mini" data-pr-mini aria-hidden="true" preserveAspectRatio="none"></svg>
      <div class="bcn-plan-range__shade" data-pr-shade="start"></div>
      <div class="bcn-plan-range__shade" data-pr-shade="end"></div>
      <div class="bcn-plan-range__window" data-pr-window tabindex="0" role="group">
        <span class="bcn-plan-range__handle bcn-plan-range__handle--start" data-pr-handle="start" role="slider" tabindex="0" aria-label="Range start"></span>
        <span class="bcn-plan-range__handle bcn-plan-range__handle--end" data-pr-handle="end" role="slider" tabindex="0" aria-label="Range end"></span>
      </div>
    </div>
    </BcnFilterBar>
  )}
</div>

<script>
  import '@esa/ecology/esa-button-toggle';
  import '@esa/ecology/esa-date-picker';
</script>

<style>
  .bcn-plan-range :global([hidden]) { display: none !important; }
  .bcn-plan-range__dates { display: inline-flex; align-items: center; gap: var(--spacing-200); }
  /* The pickers keep to a date's width; the strip after them takes the rest of the band. */
  .bcn-plan-range__dates esa-date-picker { width: 9.5rem; }

  /* ── The overview: the whole plan in miniature, the range in view as a window over it ── */
  .bcn-plan-range__overview {
    position: relative;
    /* The compact bar's control height (32px), so it reads as one of the bar's controls. It takes the band's free width,
       up to a cap: past ~80rem a strip only spreads the same years thinner (a very large monitor). */
    block-size: 2rem;
    min-inline-size: 14rem;
    max-inline-size: 80rem;
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md);
    background: var(--color-background-elevation-raised);
    cursor: pointer;
    touch-action: none;
    user-select: none;
  }
  .bcn-plan-range--stacked { display: flex; flex-direction: column; gap: var(--spacing-300); }
  .bcn-plan-range__console { display: flex; align-items: center; flex-wrap: wrap; gap: var(--spacing-200) var(--spacing-300); }
  .bcn-plan-range__label { color: var(--color-content-default-secondary); }
  .bcn-plan-range__group { display: inline-flex; align-items: center; gap: var(--spacing-300); }
  .bcn-plan-range__spacer { flex: 1; }
  .bcn-plan-range--stacked .bcn-plan-range__overview { block-size: 2.75rem; max-inline-size: none; inline-size: 100%; }
  .bcn-plan-range__mini { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; clip-path: inset(0 round var(--radius-md)); }
  /* The parents' lanes, in the chart's tier teals: lightest at the top level, deepest nearest the tasks. */
  .bcn-plan-range__mini :global(.bcn-plan-range__mini-bar--tier-0) { fill: color-mix(in srgb, var(--color-background-brand) 30%, transparent); }
  .bcn-plan-range__mini :global(.bcn-plan-range__mini-bar--tier-1) { fill: color-mix(in srgb, var(--color-background-brand) 50%, transparent); }
  .bcn-plan-range__mini :global(.bcn-plan-range__mini-bar--tier-2) { fill: color-mix(in srgb, var(--color-background-brand) 72%, transparent); }
  .bcn-plan-range__mini :global(.bcn-plan-range__mini-year) { stroke: var(--color-border-default-subtle); stroke-width: 1; }
  .bcn-plan-range__mini :global(.bcn-plan-range__mini-today) { stroke: var(--color-background-utility-warning); stroke-width: 2; }
  .bcn-plan-range__mini :global(.bcn-plan-range__mini-label) { font-size: 0.6875rem; fill: var(--color-content-default-tertiary); }
  /* Outside the range, the map dims. */
  .bcn-plan-range__shade {
    position: absolute;
    inset-block: 0;
    background: color-mix(in srgb, var(--color-background-default) 70%, transparent);
    pointer-events: none;
  }
  .bcn-plan-range__shade[data-pr-shade='start'] { inset-inline-start: 0; border-start-start-radius: var(--radius-md); border-end-start-radius: var(--radius-md); }
  .bcn-plan-range__shade[data-pr-shade='end'] { inset-inline-end: 0; border-start-end-radius: var(--radius-md); border-end-end-radius: var(--radius-md); }
  /* The window: a hairline frame, the dimmed map outside it doing most of the work, and two small raised grips on its
     edges as the cue that it moves. */
  .bcn-plan-range__window {
    /* Between the strong border grey (too faint) and the tertiary text grey (a touch heavy): both opaque, so the mix is. */
    --_frame: color-mix(in srgb, var(--color-content-default-tertiary) 65%, var(--color-border-default-strong));
    position: absolute;
    inset-block: 0;
    box-sizing: border-box;
    border: 1px solid var(--_frame);
    border-radius: var(--radius-md);
    cursor: grab;
  }
  .bcn-plan-range__window:active { cursor: grabbing; }
  /* Keyboard focus darkens the frame and rings the grips, rather than a separate outline box. */
  .bcn-plan-range__window:focus,
  .bcn-plan-range__handle:focus { outline: none; }
  .bcn-plan-range__window:focus-visible { --_frame: var(--color-content-default-secondary); }
  .bcn-plan-range__handle:focus-visible::after { box-shadow: 0 0 0 2px var(--focus-ring-color); }
  /* Each grip: a wide invisible hit area centred on the edge, a small white pill drawn in it. */
  .bcn-plan-range__handle {
    position: absolute;
    inset-block: 0;
    inline-size: 14px;
    cursor: ew-resize;
  }
  .bcn-plan-range__handle--start { inset-inline-start: -7.5px; }
  .bcn-plan-range__handle--end { inset-inline-end: -7.5px; }
  .bcn-plan-range__handle::after {
    content: '';
    position: absolute;
    inset-block: 50% auto;
    inset-inline-start: 4px;
    inline-size: 6px;
    block-size: 0.875rem;
    transform: translateY(-50%);
    box-sizing: border-box;
    border: 1px solid var(--_frame);
    border-radius: var(--radius-full);
    background: var(--color-background-elevation-raised);
    box-shadow: var(--shadow-100);
  }

</style>
