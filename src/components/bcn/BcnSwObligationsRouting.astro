---
// <BcnSwObligationsRouting> — where the approved requirements went.
//
// A requirement becomes an ACTION (dated work with a deliverable) or an OBLIGATION
// (a standing duty in effect while its conditions apply). This band answers the one
// question the obligation list cannot answer about itself: which requirements the
// extraction pass placed, and which it left. The four buckets are EXCLUSIVE and sum
// to the 854 requirements, rather than overlapping roll-ups that read as coverage.
//
// The unrouted set is not an edge case here: it is 662 of 854, so the disclosure is
// labelled by what it holds and carries its real count, not softened into
// "exceptions". It stays closed, because the step's job is the taxonomy.
//
// bcn-lego-checked: esa-stat carries every figure; the codes are the existing
// bcn-commitment-badge; the disclosure is a native <details> for the same reason as
// the tree (esa-collapsible's summary is a string, and this one carries a label and
// a count). esa-alert-box was checked and rejected — 662 unrouted requirements is a
// state of the data, not a message to the user, and an alert would editorialise it.
import BcnCommitmentBadge from './BcnCommitmentBadge.astro';
import EsaStat from '@esa/ecology/esa-stat.astro';
import EsaIcon from '@esa/ecology/esa-icon.astro';
import { ITP, ROUTE_OF, ROUTING_TOTALS } from '../../data/setup-wizard';

const countOf = (route: string) => ROUTING_TOTALS.find((r) => r.route === route)?.count ?? 0;

const unrouted = ITP.requirements
  .filter((r) => ROUTE_OF.get(r.id) === 'unrouted')
  .sort((a, b) => a.commitment.localeCompare(b.commitment, undefined, { numeric: true }) || a.name.localeCompare(b.name));

const CHEVRON = '<path d="m9 18 6-6-6-6"/>';
---

<section class="bcn-swo-routing">
  <h3 class="bcn-swo-routing__title">Requirement routing</h3>

  <div class="bcn-swo-routing__figures">
    <EsaStat value={ITP.requirements.length} label="Requirements" sub="Incidental Take Permit" />
    <EsaStat value={countOf('obligation')} label="Routed to an obligation" />
    <EsaStat value={countOf('action')} label="Routed to an action" />
    <EsaStat value={countOf('both')} label="Routed to both" />
    <EsaStat value={countOf('unrouted')} label="Not yet routed" />
  </div>

  <details class="bcn-swo-routing__panel">
    <summary class="bcn-swo-routing__summary">
      <span class="bcn-swo-routing__caret" aria-hidden="true"><EsaIcon name="chevron-right" paths={CHEVRON} size="sm" /></span>
      <span class="bcn-swo-routing__summary-label">Requirements not yet routed</span>
      <span class="bcn-swo-routing__summary-count">{unrouted.length}</span>
    </summary>

    <ul class="bcn-swo-routing__list">
      {
        unrouted.map((r) => (
          <li class="bcn-swo-routing__item">
            <BcnCommitmentBadge code={r.commitment} size="sm" />
            <span class="bcn-swo-routing__name">{r.name}</span>
            <button class="bcn-swo-routing__verb" type="button">Route to obligation</button>
          </li>
        ))
      }
    </ul>
  </details>
</section>

<style>
  .bcn-swo-routing {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-300);
  }

  .bcn-swo-routing__title {
    margin: 0;
    font-size: var(--font-size-300);
    font-weight: var(--typography-font-weight-semibold);
    color: var(--color-content-default);
  }

  .bcn-swo-routing__figures {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-400) var(--spacing-700);
  }
  .bcn-swo-routing__figures > * {
    max-width: 24ch;
  }

  .bcn-swo-routing__panel {
    align-self: flex-start;
    width: 100%;
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md);
    background: var(--color-background-elevation-raised);
  }
  .bcn-swo-routing__summary {
    display: flex;
    align-items: center;
    gap: var(--spacing-200);
    padding: var(--spacing-250) var(--spacing-300);
    cursor: pointer;
    list-style: none;
  }
  .bcn-swo-routing__summary::-webkit-details-marker {
    display: none;
  }
  .bcn-swo-routing__summary:focus-visible {
    outline: 2px solid var(--color-background-brand);
    outline-offset: -2px;
    border-radius: var(--radius-md);
  }
  .bcn-swo-routing__caret {
    display: inline-flex;
    color: var(--color-content-default-tertiary);
    transition: transform 120ms ease;
  }
  .bcn-swo-routing__panel[open] .bcn-swo-routing__caret {
    transform: rotate(90deg);
  }
  .bcn-swo-routing__summary-label {
    font-size: var(--font-size-250);
    font-weight: var(--typography-font-weight-semibold);
    color: var(--color-content-default);
  }
  .bcn-swo-routing__summary-count {
    font-size: var(--font-size-250);
    font-variant-numeric: tabular-nums;
    color: var(--color-content-default-secondary);
  }

  .bcn-swo-routing__list {
    margin: 0;
    padding: 0;
    list-style: none;
    max-height: 540px;
    overflow-y: auto;
    border-top: 1px solid var(--color-border-default-subtle);
  }
  .bcn-swo-routing__item {
    display: grid;
    grid-template-columns: 112px minmax(0, 1fr) 150px;
    align-items: center;
    column-gap: var(--spacing-300);
    padding: var(--spacing-100) var(--spacing-300);
    border-top: 1px solid var(--color-border-default-subtle);
  }
  .bcn-swo-routing__item:first-child {
    border-top: 0;
  }
  .bcn-swo-routing__item:hover {
    background: var(--color-background-elevation-sunken);
  }
  .bcn-swo-routing__name {
    min-width: 0;
    font-size: var(--font-size-250);
    line-height: 1.35;
    color: var(--color-content-default);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .bcn-swo-routing__verb {
    justify-self: end;
    padding: 0;
    border: 0;
    background: none;
    font-family: inherit;
    font-size: var(--font-size-150);
    color: var(--color-content-default-secondary);
    cursor: pointer;
    white-space: nowrap;
    opacity: 0;
    transition: opacity 100ms ease;
  }
  .bcn-swo-routing__item:hover .bcn-swo-routing__verb,
  .bcn-swo-routing__item:focus-within .bcn-swo-routing__verb {
    opacity: 1;
  }
  .bcn-swo-routing__verb:hover {
    color: var(--color-content-brand);
    text-decoration: underline;
  }
</style>
