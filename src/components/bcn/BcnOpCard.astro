---
// <BcnOpCard> — one admin operation in the Operations console, rendered as a
// self-describing, confirmed, observable job instead of a navigation tile.
//
// Three facts from the registry drive the whole card:
//   • name         → the card title
//   • description  → what the job does, in plain language, on the card AND in the confirm
//   • scope        → for 'all-tenants', a warning alert + a typed-name gate (the header
//                    scope badge was removed on review 2026-07-29 — scope reads from the
//                    description and the alert, not a chip)
//
// The scope line is the one derivation: 'tenant' → "Runs for this tenant only.",
// 'all-tenants' → "Runs across every tenant on the platform." It renders in the confirm
// dialog; on the card only the all-tenants alert repeats it. Nothing else on the card is
// authored here; the copy is the registry's.
//
// GUIDED vs INSTANT. A guided op links to its own multi-step run and gets no dialog. An
// instant op fires from the card, so it carries an esa-dialog confirm; an 'all-tenants'
// instant op additionally makes the confirm button wait on the operator typing the
// operation name back.
//
// Behavior in ./ops-console.ts (one controller for every card on the page). On confirm it
// dispatches `bcn-op-run` on document — the run-history sibling listens and prepends a row.
//
// bcn-lego-checked: esa-confirm-dialog was the first stop for the confirm and does NOT
// fit — its body is a single `message` STRING with no slots, so it cannot carry the
// description + scope alert + esa-text-field the typed-name gate needs. Composed
// esa-dialog (the lego built for slotted bodies) instead. Everything else IS a lego:
// esa-card (outlined), esa-alert-box (the warning line), esa-button, esa-text-field,
// plus stack/cluster primitives and type roles. The only CSS left is two text colors,
// the card/dialog token re-points, and one hub-bug patch. Checked Beacon (prod ships
// these jobs as bare nav tiles — nothing to port). bcn-op-card is the reusable home.
import type { Operation } from '../../data/settings-registry';
import EsaCard from '@esa/ecology/esa-card.astro';
import EsaAlertBox from '@esa/ecology/esa-alert-box.astro';
import EsaButton from '@esa/ecology/esa-button.astro';

interface Props {
  op: Operation;
}
const { op } = Astro.props;

const allTenants = op.scope === 'all-tenants';
const scopeLine = allTenants
  ? 'Runs across every tenant on the platform.'
  : 'Runs for this tenant only.';
---

<article
  class="bcn-op"
  data-op-card
  data-op-id={op.id}
  data-op-name={op.name}
  data-op-scope={op.scope}
>
  <EsaCard variant="outlined" title={op.name}>
    <div class="stack" data-gap="sm">
      <p class="bcn-op__desc type-body-small">{op.description}</p>
      {allTenants && <EsaAlertBox variant="warning">{scopeLine}</EsaAlertBox>}
    </div>

    <div class="cluster" data-gap="sm" slot="footer">
      {
        op.guided ? (
          <EsaButton color="ghost" appearance="outline" size="md" icon="arrow-right" href="#">
            Open guided run
          </EsaButton>
        ) : (
          <EsaButton color="primary" size="md" data-op-run={op.id}>
            Run…
          </EsaButton>
        )
      }
    </div>
  </EsaCard>

  {
    /* Instant ops confirm in place. Rendered as a SIBLING of the card, not inside it —
       the dialog is a page-level overlay and has no business living in card chrome. */
    !op.guided && (
      <esa-dialog data-op-dialog={op.id} heading={`Run ${op.name}?`}>
        <div class="stack" data-gap="sm">
          {/* Full size here, unlike the card's 14px: in the confirm the description is
              not a caption under a title, it IS what the operator is reading. */}
          <p class="bcn-op__dialog-desc type-body">{op.description}</p>
          {allTenants ? (
            <EsaAlertBox variant="warning">{scopeLine}</EsaAlertBox>
          ) : (
            <p class="bcn-op__scope-line type-body">{scopeLine}</p>
          )}
          {allTenants && (
            <esa-text-field
              label="Type the operation name to confirm"
              placeholder={op.name}
              data-op-confirm-input
            ></esa-text-field>
          )}
        </div>

        <div class="cluster" data-gap="sm" slot="footer" style="--justify: flex-end">
          <EsaButton color="ghost" appearance="outline" size="sm" data-op-cancel={op.id}>
            Cancel
          </EsaButton>
          <EsaButton color="primary" size="sm" disabled={allTenants} data-op-confirm={op.id}>
            Run now
          </EsaButton>
        </div>
      </esa-dialog>
    )
  }
</article>

<style>
  .bcn-op {
    display: block;
    /* esa-card fills its footer with --color-surface-sunken by default, which reads as a
       mid-gray band under the description. Re-pointed through the lego's OWN public token
       (inherited down to the card) so the Run action sits on the card surface behind a
       single hairline — the lego's border-top already resolves to --color-border-light. */
    --card-footer-bg: transparent;
  }

  /* The confirm has to clear the app's fixed topbar (z 1100). esa-dialog defaults to
     --z-modal 400 / --z-modal-backdrop 300, which would render the panel AND its
     backdrop underneath it — leaving the topbar lit and clickable behind a modal. */
  .bcn-op esa-dialog {
    --z-modal: 1300;
    --z-modal-backdrop: 1250;
  }

  /* HUB BUG (esa-alert-box): the variant icon is an inline <svg> inside
     .esa-alert-box__icon, so it sits on that div's text baseline and the inherited line
     box hangs ~6px of descender space UNDER the 20px glyph — a one-line warning measures
     53px where its text needs 47px, and the icon reads low against the line it labels.
     Blocking the svg collapses the line box to the glyph; nothing moves, the dead space
     goes. Scoped to .bcn-op, :global because the lego's internals carry its own hash. */
  .bcn-op :global(.esa-alert-box__icon svg) {
    display: block;
  }

  /* Same scale as the settings rows beside them (BcnSettingRow's __desc). */
  .bcn-op__desc {
    line-height: 1.4;
    color: var(--color-text-secondary);
  }

  .bcn-op__dialog-desc {
    color: var(--color-text-secondary);
  }

  .bcn-op__scope-line {
    color: var(--color-text-tertiary);
  }
</style>

<script>
  import '@esa/ecology/esa-dialog';
  import '@esa/ecology/esa-text-field';
  import { setupOpsConsole } from './ops-console';

  setupOpsConsole();
</script>
