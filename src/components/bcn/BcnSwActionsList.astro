---
// <BcnSwActionsList> — the right column's stack of drafted actions.
//
// A list and not a grid: the cards are of one kind and are read in order, and a grid
// would ask the reviewer to scan in two directions through records that have no
// relationship to each other besides matching the filter.
//
// bcn-lego-checked: every item IS BcnSwActionsCard, which is itself a composition of
// esa-card / esa-badge / esa-button. Checked Ecology for a list lego (esa-link-column is
// a column of links; there is no record-list container) and Beacon (.action-list, a bare
// ul). bcn-sw-actions-list is the reusable home for the stack's rhythm.
import BcnSwActionsCard from './BcnSwActionsCard.astro';

interface Props {
  actions: {
    id: string;
    name: string;
    status: 'draft' | 'approved';
    statusLabel: string;
    meta: { label: string; value: string }[];
  }[];
}
const { actions } = Astro.props;
---

<div class="bcn-swal">
  {actions.map((a) => (
    <BcnSwActionsCard name={a.name} status={a.status} statusLabel={a.statusLabel} meta={a.meta} />
  ))}
</div>

<style>
  .bcn-swal {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-250);
  }
</style>
