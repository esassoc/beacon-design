---
// <BcnTrackingRegistry> — the Registry half of the Obligation Tracking page, in the SAME
// TWO VIEWS the setup wizard's step 5 offers, read-only:
//
//   By category    obligations filed in the subject taxonomy — category > subcategory >
//                  obligation > requirement(s). BcnSwObligationsTree.
//   By commitment  the permit read top-down — commitment > requirement > the obligation(s)
//                  it became, with the route and orphan counts. BcnSwChainTree.
//
// The wizard makes these two separate PAGES and its view switch navigates between them.
// Here they are two panels in one tab, because a tab that navigates away is not a tab —
// and because this page already has two levels of tab and a third would be absurd. The
// switch reveals; both trees render at build time.
//
// BOTH TREES ARE THE WIZARD'S OWN, in mode="browse". Setup gets rename, remove, add, drag
// and the editor drawer; this gets none of them. What survives is everything that NAVIGATES
// rather than decides: expand and collapse, search with hit highlighting, and the pickers.
// One component with a mode, not a second tree — setup approves along these and this page
// reads along them, so they must not be free to drift.
//
// EACH VIEW CARRIES ITS OWN FILTER ROW, because the two trees listen on different field
// names — `swo-search` and `swc-search` — and narrow by different things. The category view
// filters by class and by category; the commitment view filters by coverage (all / orphaned
// / in several obligations). The chips announce themselves as bubbling `sw:chip` events, so
// a tree picks up its own by name wherever the chip sits on the page.
//
// bcn-lego-checked: both trees and the filter row are reused, not reimplemented
// (bcn-sw-obligations-tree, bcn-sw-chain-tree, bcn-sw-filter-row, bcn-sw-select-chip). The
// view switch IS esa-button-toggle — the same lego bcn-sw-view-switch uses, but wired to
// reveal a panel instead of navigating, which is the one thing that component cannot do.
// Checked Ecology for an in-page view switcher (esa-tab-layout is the tab host already used
// twice above; a third nesting is what this avoids).
import EsaCard from '@esa/ecology/esa-card.astro';
import EsaIcon from '@esa/ecology/esa-icon.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import BcnSwObligationsTree from './BcnSwObligationsTree.astro';
import BcnSwChainTree from './BcnSwChainTree.astro';
import BcnSwFilterRow from './BcnSwFilterRow.astro';
import BcnSwSelectChip from './BcnSwSelectChip.astro';
import { OBLIGATION_CLASS_LABEL, OBLIGATION_TREE, STEP_GLYPH } from '../../data/setup-wizard';

const VIEWS = [
  { label: 'By category', value: 'category' },
  { label: 'By commitment', value: 'commitment' },
];


const CLASS_PICKS = Object.entries(OBLIGATION_CLASS_LABEL).map(([value, label]) => ({ label, value }));
const CATEGORY_PICKS = [
  { label: 'All categories', value: '' },
  ...OBLIGATION_TREE.map((c) => ({ label: c.name, value: c.id })),
];
const COVERAGE_PICKS = [
  { label: 'All requirements', value: '' },
  { label: 'Orphaned requirements', value: 'unrouted' },
  { label: 'In several obligations', value: 'several' },
];
---

<section class="bcn-treg stack" data-gap="md">
  {/* THE SWITCH CHOOSES WHICH VIEW; the panel below filters WITHIN it. See the note by
      .bcn-treg__bar for why it sits above the panel rather than in the card's header slot. */}
  <header class="bcn-treg__bar">
    <esa-button-toggle
      class="bcn-treg__switch"
      size="sm"
      value="category"
      aria-label="Registry view"
      data-treg-switch
      data-options={JSON.stringify(VIEWS)}></esa-button-toggle>
  </header>

  {/* THE CONTROL PANEL. esa-card outlined — the bordered raised surface the wizard's controls
      sit on, which this page had been missing entirely: the filters were loose on the page
      ground and bcn-sw-filter-row's own top hairline had nothing above it to separate from.
      padding="none" because the filter row brings its own inset.

      NO COUNTS ON IT (Kim, 2026-09-17). A pass earlier that day put the registry's shape in the
      card header as esa-card `meta` — Requirements 854 · Obligations 333 · Commitments 294 —
      standing in for the wizard's step title. Not necessary for this view, and the same
      judgement that took the counts off both tab rows (§1): the tree below carries a count on
      every category and subcategory row, so a total restated above told a reader nothing they
      were about to be shown. With them gone the card has no header at all. */}
  <EsaCard variant="outlined" padding="none">
    {/* EACH VIEW BRINGS ITS OWN FILTER ROW, because the two trees listen on different field
        names (swo-search / swc-search) and narrow by different things: class and category for
        the taxonomy, coverage for the chain. */}
    <div class="bcn-treg__filters" data-treg-view="category">
      <BcnSwFilterRow
        searchPlaceholder="Search obligations"
        searchName="swo-search"
        pickers={[{ label: 'Class', value: 'All classes', options: CLASS_PICKS }]}
      >
        <BcnSwSelectChip slot="filters" label="Category" name="category" value="All categories" options={CATEGORY_PICKS} />
        <EsaButton variant="ghost" size="xs" data-swo-expand title="Open every category">
          <span class="bcn-treg__verb"><EsaIcon name="chevrons-up-down" size="xs" paths={STEP_GLYPH['chevrons-up-down']} />Expand all</span>
        </EsaButton>
        <EsaButton variant="ghost" size="xs" data-swo-collapse title="Close every category">
          <span class="bcn-treg__verb"><EsaIcon name="chevrons-down-up" size="xs" paths={STEP_GLYPH['chevrons-down-up']} />Collapse all</span>
        </EsaButton>
      </BcnSwFilterRow>
    </div>

    <div class="bcn-treg__filters" data-treg-view="commitment" hidden>
      <BcnSwFilterRow searchPlaceholder="Search requirements" searchName="swc-search">
        <BcnSwSelectChip slot="filters" label="Coverage" name="coverage" value="All requirements" options={COVERAGE_PICKS} />
        <EsaButton variant="ghost" size="xs" data-swc-expand title="Open every commitment">
          <span class="bcn-treg__verb"><EsaIcon name="chevrons-up-down" size="xs" paths={STEP_GLYPH['chevrons-up-down']} />Expand all</span>
        </EsaButton>
        <EsaButton variant="ghost" size="xs" data-swc-collapse title="Close every commitment">
          <span class="bcn-treg__verb"><EsaIcon name="chevrons-down-up" size="xs" paths={STEP_GLYPH['chevrons-down-up']} />Collapse all</span>
        </EsaButton>
      </BcnSwFilterRow>
    </div>
  </EsaCard>

  {/* THE TREES SIT OUTSIDE THE PANEL, as they do in the wizard — the panel holds the controls,
      the tree is the content they act on. */}
  <div class="bcn-treg__view" data-treg-view="category">
    <BcnSwObligationsTree mode="browse" title="Obligation registry" />
  </div>

  <div class="bcn-treg__view" data-treg-view="commitment" hidden>
    <BcnSwChainTree mode="browse" />
  </div>
</section>

<script>
  import '@esa/ecology/esa-button-toggle';

  type Toggle = HTMLElement & { options: unknown[]; value: string };

  for (const sw of document.querySelectorAll<Toggle>('[data-treg-switch]')) {
    const root = sw.closest('.bcn-treg');
    if (!root) continue;
    const views = [...root.querySelectorAll<HTMLElement>('[data-treg-view]')];

    customElements.whenDefined('esa-button-toggle').then(() => {
      sw.options = JSON.parse(sw.dataset.options ?? '[]');
      sw.value = 'category';
    });

    // Reveal only — both trees are already rendered, with their own scripts bound.
    sw.addEventListener('change', () => {
      for (const v of views) v.hidden = v.dataset.tregView !== sw.value;
    });
  }
</script>

<style>
  /* The switch chooses WHICH view; the panel below filters WITHIN it. Two different jobs, so
     the switch sits above the panel rather than inside its header. It was briefly in the card's
     `actions` slot, which was right while the header also carried the registry counts on the
     left — once those came off (Kim: not necessary for this view) that header became a 71px band
     holding one control, pinned 1px from the card's border because padding="none" zeroes the
     header inset along with the body's. Giving it back its inset would mean reaching inside the
     lego; moving the switch out means not having to. */
  .bcn-treg__bar {
    display: flex;
    justify-content: flex-end;
  }

  /* [hidden] loses to an author display rule, so every visible state is guarded. The switch
     drives FOUR elements, not two — each view owns a filter row inside the panel and a tree
     below it, and they carry the same data-treg-view so one listener reveals both. */
  .bcn-treg__view:not([hidden]),
  .bcn-treg__filters:not([hidden]) { display: block; }

  .bcn-treg__verb {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-100);
  }
</style>
