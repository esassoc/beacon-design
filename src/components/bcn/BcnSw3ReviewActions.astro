---
// <BcnSw3ReviewActions> — step 2's keys in the console at the foot of its panel
// (bcn-sw-step-nav's slot), after Previous and Next: Confirm all for every commitment nothing
// is flagged on (one-step undo in the toast), and Export, the review for offline reading.
//
// bcn-lego-checked: the keys ARE esa-button, the toast is esa-snackbar-container via
// src/lib/snackbar. Checked Beacon (page actions are ui-button). bcn-sw3-review-actions is
// the home.
import EsaButton from '@esa/ecology/esa-button.astro';
---

<div class="bcn-sw3ra" data-sw3-review-actions>
  <EsaButton variant="secondary" size="sm" icon="circle-check" data-ra-confirm-all>Confirm all</EsaButton>
  <EsaButton variant="secondary" size="sm" icon="download" title="Export for offline review (.docx)" data-ra-export>Export</EsaButton>
</div>

<style>
  .bcn-sw3ra { display: flex; align-items: center; gap: var(--spacing-200); flex-wrap: wrap; }
</style>

<script>
  import { initSw3, cleanUnconfirmed, confirmAllClean, undoConfirmAll } from './sw3-store';
  import { snackbarHost, toast } from '../../lib/snackbar';

  const root = document.querySelector<HTMLElement>('[data-sw3-review-actions]');
  if (root) {
    initSw3();
    const label = (sel: string, text: string) => {
      const b = root.querySelector<HTMLElement>(sel)!;
      (b.querySelector('.esa-button__label') ?? b).textContent = text;
      return b;
    };
    root.querySelector('[data-ra-export]')!.addEventListener('click', () => toast('Exported the commitments for review (.docx).', 'success'));

    let undoToast: string | null = null;
    root.querySelector('[data-ra-confirm-all]')!.addEventListener('click', () => {
      const n = confirmAllClean();
      if (!n) return;
      const host = snackbarHost();
      if (undoToast) host.dismiss(undoToast);
      undoToast = (host.show as (c: object) => string)({
        message: `Confirmed ${n} commitment${n === 1 ? '' : 's'} with nothing flagged.`,
        variant: 'success',
        action: 'Undo',
        duration: 0,
      });
    });
    document.addEventListener('snackbar-action', (e) => {
      if ((e as CustomEvent<{ id: string }>).detail?.id !== undoToast) return;
      undoConfirmAll();
      snackbarHost().dismiss(undoToast!);
      undoToast = null;
    });

    const render = () => {
      const n = cleanUnconfirmed().length;
      const btn = label('[data-ra-confirm-all]', n ? `Confirm all (${n})` : 'Confirm all');
      const inner = btn.querySelector('button') ?? btn;
      (inner as HTMLButtonElement).disabled = !n;
    };
    document.addEventListener('sw3:change', render);
    render();
  }
</script>
