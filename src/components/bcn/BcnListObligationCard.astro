---
// <BcnListObligationCard> — one obligation as it sits in ONE LIST: one MEMBERSHIP,
// not one obligation, because a list may hold the same registry obligation twice.
//
// The anatomy is <BcnSwObligationCard>'s, and since 2026-09-16 it is not a copy of it:
// both components import src/styles/bcn-obligation-card.css, where the shape is defined
// once with the two class namespaces paired in every selector. Andy, with the two cards
// side by side: "Much prefer setup wizard." What was here before — a description
// paragraph under the card line, then a "Requirements (n)" summary row that opened a
// second disclosure — is gone. One row, and the requirements are its children.
//
// The card, top to bottom:
//   1. the card row: chevron, class chip, title, the "Edited for this list" mark, the
//      copy marker when this list holds the obligation more than once, the requirement
//      count, and three hover verbs pushed right — edit, duplicate, and the x that
//      takes this membership off the list. The row is the disclosure; the title is not,
//      it opens the panel, exactly as the wizard's title opens its editor;
//   2. the requirements as DIRECT CHILDREN: commitment code, then the requirement's
//      name. Read only — no drag, no duplicate, no unlink, no verb of any kind —
//      because a list cannot change what an obligation derives from. That read-only
//      quality is the declared sacrifice of this page, not an omission.
//
// No grip, and that is deliberate rather than an oversight. The wizard's grip drags a
// card to refile it; this page cannot refile, and a row added here is FILED into the
// registry's own A-Z order rather than appended (2026-09-15). A grip that cannot be
// dragged is a lie about affordance, so the row starts at the chevron and the
// requirement indent clears the chevron instead of a grip.
//
// The LIST DESCRIPTION is no longer printed here. It is a stored field, so it stays on
// the card as data — data-list-description, with the registry's own sentence in
// data-registry-desc — and it is read and written in <BcnListObligationPanel>, which
// reads both attributes straight off this element. What survives on the row is the
// SIGNAL that this list said it differently. The two attributes are also the whole
// override test: the member has its own wording exactly when they disagree, so there is
// no third attribute to keep in step with them.
//
// Contract with <BcnListObligationTree>: the card is presentational. The tree owns
// every listener, exactly as step 5 splits card and tree, and reaches in through
// `data-list-card`, `data-list-edit`, `data-list-duplicate`, `data-list-remove`, `data-list-edited`,
// `data-list-copy`, `data-list-req` and `data-list-text`.
//
// IDENTITY: the card is keyed by `data-member-id`, NOT by `data-id`. `data-id` is the
// registry obligation and two cards may share it; the member id is this row's alone.
//
// bcn-lego-checked: esa-card carries its own padding, a 56px header band and its own
// type scale; esa-collapsible is a panel, not a dense 13px disclosure row; esa-list-item
// has no nested child list. The count IS bcn-sw-count-badge, the commitment code IS
// bcn-commitment-badge, the glyphs ARE esa-icon, the tooltips ARE esa-tooltip, and the
// card's shape IS the shared bcn-obligation-card stylesheet.
import EsaIcon from '@esa/ecology/esa-icon.astro';
import BcnCommitmentBadge from './BcnCommitmentBadge.astro';
import BcnSwCountBadge from './BcnSwCountBadge.astro';
import { OBLIGATION_CLASS_LABEL, STEP_GLYPH } from '../../data/setup-wizard';
import type { ListObligation } from '../../data/lists';
import '../../styles/bcn-obligation-card.css';

interface Props {
  obligation: ListObligation;
  /** Requirements folded open on load. Closed is the default, by design. */
  open?: boolean;
}
const { obligation: o, open = false } = Astro.props;
---

<li
  class="bcn-loc"
  data-list-card
  data-member-id={o.memberId}
  data-id={o.id}
  data-class={o.class}
  data-list-description={o.listDescription}
  data-registry-desc={o.description}
>
  <details class="bcn-loc__node" data-list-reqs-branch open={open}>
    <summary class="bcn-loc__main">
      <span class="bcn-loc__chevron" aria-hidden="true"><EsaIcon name="chevron-right" size="sm" /></span>
      <span class="bcn-loc__class" data-list-class-tag>{OBLIGATION_CLASS_LABEL[o.class]}</span>
      <button type="button" class="bcn-loc__title" data-list-edit data-list-title data-list-text={o.title}>{o.title}</button>
      <span class="bcn-loc__edited" data-list-edited hidden={!o.descriptionOverridden}>Edited for this list</span>
      <span class="bcn-loc__copy" data-list-copy hidden={o.copies < 2}>{o.copies > 1 ? `Copy ${o.occurrence} of ${o.copies}` : ''}</span>
      <span data-list-count="obligation"><BcnSwCountBadge value={o.requirements.length} label={`${o.requirements.length} requirements`} /></span>
      <esa-tooltip text="Edit for this list"><button
        type="button"
        class="bcn-loc__verb"
        aria-label="Edit this obligation for this list"
        data-list-edit
      ><EsaIcon name="square-pen" size="xs" paths={STEP_GLYPH['square-pen']} /></button></esa-tooltip>
      <esa-tooltip text="Duplicate for this list"><button
        type="button"
        class="bcn-loc__verb"
        aria-label="Hold this obligation again with its own wording"
        data-list-duplicate
      ><EsaIcon name="copy" size="xs" paths={STEP_GLYPH.copy} /></button></esa-tooltip>
      <esa-tooltip text="Remove from this list" align="end"><button
        type="button"
        class="bcn-loc__verb bcn-loc__verb--danger"
        aria-label="Remove from this list"
        data-list-remove
      ><EsaIcon name="x" size="xs" paths={STEP_GLYPH.x} /></button></esa-tooltip>
    </summary>
    <ul class="bcn-loc__reqs">
      {o.requirements.map((r) => (
        <li class="bcn-loc__req" data-list-req data-code={r.code}>
          <BcnCommitmentBadge code={r.code} size="sm" />
          <span class="bcn-loc__req-name" data-list-text={r.name}>{r.name}</span>
        </li>
      ))}
    </ul>
  </details>
</li>

<style>
  /* Everything this card shares with the wizard's is in bcn-obligation-card.css.
     What is left here is what only a LIST row carries. */

  /* The requirement indent is NOT overridden. Measured at 1440: the shared 22px puts
     the commitment badge 6px right of the class chip on both cards, which is exactly
     the wizard's own relationship — there the 22px clears a grip, here it clears the
     chevron, and both land in the same place. A 24px "correction" for the missing grip
     moved it 2px and broke the rhyme. */

  /* This list said it differently. The only trace of the list description on the row,
     now that the sentence itself is read and written in the panel. */
  .bcn-loc__edited {
    flex-shrink: 0;
    font-size: 0.6875rem;
    color: var(--color-content-default-tertiary);
    white-space: nowrap;
  }
  .bcn-loc__edited[hidden] { display: none; }

  /* Which copy this is, shown only when the list holds more than one. Two rows
     carrying the same title are otherwise indistinguishable once the description
     comes off the card, and the reader has to be able to tell them apart. */
  .bcn-loc__copy {
    flex-shrink: 0;
    font-size: 0.6875rem;
    color: var(--color-content-default-tertiary);
    white-space: nowrap;
  }
  .bcn-loc__copy[hidden] { display: none; }

  /* Requirements are reference here, never the subject, so they carry secondary ink.
     The wizard's own rows stay at default: there they ARE the thing being edited. */
  .bcn-loc__req { color: var(--color-content-default-secondary); }
</style>
