---
// <BcnSwObligationsHeader> — step 5's header band: the step numeral, the step
// title, the one-line instruction, and the collapsed AI receipt.
//
// Ported from prod's actions-step header (origin/develop,
// pages/project-setup/actions-step/actions-step.component.html): a `.step-indicator`
// numeral leading an `<h2>`, an `.actions-step__intro` line beneath, then the
// `.ai-panel` disclosure whose header is the aldo-mark, a label and an Experimental
// badge. Step 4 fills its title with two dropdowns because it works one phase and
// type at a time; step 5 reviews ONE list, so the title is the noun and nothing else.
//
// The numeral is where the step colour lives on this page (the only other place is
// the approval count in the footer). --color-obligation is a 3.09:1 fill, so it is
// used exactly as the step nav uses it: a filled badge with knockout text, never
// text on white.
//
// bcn-lego-checked: the receipt is a native <details>, not esa-collapsible, because
// esa-collapsible takes its summary as a `title` STRING plus one registry icon —
// there is no slot, and this summary has to carry the Aldo mark, a label and a
// badge. Checked esa-alert-box (a message, not a disclosure) and esa-card (no
// disclosure at all). Beacon prod has this exact band as `.ai-panel`, so this is a
// port of it; the mark is the existing bcn-aldo-mark and the badge is esa-badge.
import EsaIcon from '@esa/ecology/esa-icon.astro';
import BcnAldoMark from './BcnAldoMark.astro';
import { OBLIGATIONS, OBLIGATION_TOTALS, DRAFTED_BY } from '../../data/setup-wizard';

interface Props {
  /** The step's number in SETUP_STEPS. */
  n: number;
  /** The step's entity colour token name, e.g. "obligation". */
  token: string;
}
const { n, token } = Astro.props;

// Receipt figures, all derived from the rows themselves.
const commitmentCodes = new Set(OBLIGATIONS.flatMap((o) => o.commitments)).size;
const multiSubject = OBLIGATIONS.filter((o) => o.subjects.length > 1).length;

const FLASK =
  '<path d="M14 2v6a2 2 0 0 0 .245.96l5.51 10.08A2 2 0 0 1 18 22H6a2 2 0 0 1-1.755-2.96l5.51-10.08A2 2 0 0 0 10 8V2"/><path d="M6.453 15h11.094"/><path d="M8.5 2h7"/>';
const CHEVRON = '<path d="m9 18 6-6-6-6"/>';
---

<header class="bcn-swo-head" style={`--_step: var(--color-${token});`}>
  <div class="bcn-swo-head__row">
    <span class="bcn-swo-head__numeral">{n}</span>
    <h2 class="bcn-swo-head__title">Obligations</h2>
  </div>

  <p class="bcn-swo-head__intro">Review the list, fix what is wrong, then approve it as a whole.</p>

  <details class="bcn-swo-head__ai">
    <summary class="bcn-swo-head__ai-summary">
      <BcnAldoMark size="sm" />
      <span class="bcn-swo-head__ai-label">{DRAFTED_BY}</span>
      <span class="bcn-swo-head__ai-flag">
        <EsaIcon name="flask-conical" size="xs" paths={FLASK} />
        Experimental
      </span>
      <span class="bcn-swo-head__ai-caret" aria-hidden="true"><EsaIcon name="chevron-right" size="sm" paths={CHEVRON} /></span>
    </summary>
    <dl class="bcn-swo-head__ai-body">
      <div class="bcn-swo-head__fact">
        <dt>Obligations drafted</dt>
        <dd>{OBLIGATION_TOTALS.obligations}</dd>
      </div>
      <div class="bcn-swo-head__fact">
        <dt>Commitment codes cited</dt>
        <dd>{commitmentCodes}</dd>
      </div>
      <div class="bcn-swo-head__fact">
        <dt>Obligations filed under more than one subject</dt>
        <dd>{multiSubject}</dd>
      </div>
    </dl>
  </details>
</header>

<style>
  .bcn-swo-head {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-300);
  }

  /* Prod's .actions-step__header-row: numeral, then the title. */
  .bcn-swo-head__row {
    display: flex;
    align-items: center;
    gap: var(--spacing-300);
  }
  .bcn-swo-head__numeral {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    border-radius: var(--radius-full);
    background: var(--_step);
    color: var(--color-content-default-knockout);
    font-size: var(--font-size-250);
    font-weight: var(--typography-font-weight-bold);
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }
  .bcn-swo-head__title {
    margin: 0;
    font-family: var(--font-decorative, var(--typography-font-family-sans));
    font-size: var(--font-size-500);
    font-weight: var(--typography-font-weight-semibold);
    line-height: 1.2;
    color: var(--color-content-default);
  }

  .bcn-swo-head__intro {
    margin: 0;
    max-width: 78ch;
    font-size: var(--font-size-250);
    line-height: 1.55;
    color: var(--color-content-default-secondary);
  }

  /* Prod's .ai-panel, collapsed. */
  .bcn-swo-head__ai {
    align-self: flex-start;
    min-width: min(100%, 560px);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md);
    background: var(--color-background-elevation-raised);
  }
  .bcn-swo-head__ai-summary {
    display: flex;
    align-items: center;
    gap: var(--spacing-250);
    padding: var(--spacing-250) var(--spacing-300);
    cursor: pointer;
    list-style: none;
  }
  .bcn-swo-head__ai-summary::-webkit-details-marker {
    display: none;
  }
  .bcn-swo-head__ai-summary:focus-visible {
    outline: 2px solid var(--color-background-brand);
    outline-offset: -2px;
    border-radius: var(--radius-md);
  }
  .bcn-swo-head__ai-label {
    font-size: var(--font-size-200);
    font-weight: var(--typography-font-weight-semibold);
    color: var(--color-content-default);
  }
  .bcn-swo-head__ai-flag {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-100);
    padding: var(--spacing-050) var(--spacing-150);
    border-radius: var(--radius-chip);
    background: var(--color-background-elevation-sunken);
    color: var(--color-content-default-tertiary);
    font-size: var(--font-size-150);
    white-space: nowrap;
  }
  .bcn-swo-head__ai-caret {
    display: inline-flex;
    margin-left: auto;
    color: var(--color-content-default-tertiary);
    transition: transform 150ms ease;
  }
  .bcn-swo-head__ai[open] .bcn-swo-head__ai-caret {
    transform: rotate(90deg);
  }

  .bcn-swo-head__ai-body {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-500);
    margin: 0;
    padding: var(--spacing-300);
    border-top: 1px solid var(--color-border-default-subtle);
  }
  .bcn-swo-head__fact {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-050);
  }
  .bcn-swo-head__fact dt {
    font-size: var(--font-size-200);
    color: var(--color-content-default-secondary);
  }
  .bcn-swo-head__fact dd {
    margin: 0;
    font-size: var(--font-size-300);
    font-weight: var(--typography-font-weight-semibold);
    font-variant-numeric: tabular-nums;
    color: var(--color-content-default);
  }
</style>
