---
// <BcnSettingsNav> — the grouped left rail for the Unified Settings area. Cross-page
// wayfinding, NOT an in-page TOC; every page is a real link to its own route. The
// current page is resolved at BUILD time from the `activePageId` prop, so the rail
// ships with zero client JS — no scroll-spy, no observers, no hydration.
//
// STRUCTURE (Andy's call, 2026-07-30): AUDIENCE is the first-order grouping — an
// "ESA Admin" block and a "Tenant Admin" block, divided by a hairline — and the
// product zones (General, People & Access, …) are subgroups within each. Both tiers
// derive from existing registry data (zone order × page `audience`); a zone shows
// inside an audience block only when it has pages there, so General can appear in
// both blocks with different pages. The audience heading replaced the per-item ESA
// chips — the block says what the chip used to. In the real product the blocks would
// come from who the signed-in user IS (User.IsEsaAdmin); the rail states ownership
// without simulating gating.
//
// Frame: a plain grouped list that owns NO rail geometry. <BcnSettingsShell> is the
// rail — it holds the sticky position, the height cap, and the scrollport this list
// sits inside. Dropping something else in beside it means giving that wrapper the
// same treatment.
//
// bcn-lego-checked: a two-tier grouped settings rail with a build-time active route
// has no esa-* equivalent. esa-sidebar-nav is the closest lego but wrong on the same
// counts BcnReleaseNav documented: shadow-DOM property-driven internals, group
// headings locked to the banned 11px uppercase micro-label, single-level grouping.
// This rail is also strictly SIMPLER — static links, no client runtime at all.
// Checked Beacon (prod settings nav is a bespoke Angular list). Owned quiet list;
// bcn-settings-nav is its reusable home.
import { SETTINGS_ZONES, pagesByZone, settingsPagePath } from '../../data/settings-registry';
import type { SettingsAudience } from '../../data/settings-registry';
import { withBase } from '../../lib/base';

interface Props {
  /** id of the settings page currently being viewed — gets the current state. */
  activePageId: string;
}
const { activePageId } = Astro.props;

// ESA Admin leads (the "Platform near the top" call, generalized). Within a block,
// zones keep registry order; a zone with no pages for that audience is dropped so no
// heading ever sits over nothing.
const AUDIENCE_BLOCKS: { id: SettingsAudience; title: string }[] = [
  { id: 'esa-admin', title: 'ESA Admin' },
  { id: 'tenant-admin', title: 'Tenant Admin' },
];

const blocks = AUDIENCE_BLOCKS.map((block) => ({
  ...block,
  zones: SETTINGS_ZONES.map((zone) => ({
    zone,
    pages: pagesByZone(zone.id).filter((p) => p.audience === block.id),
  })).filter((z) => z.pages.length > 0),
})).filter((b) => b.zones.length > 0);
---

<nav class="bcn-settings-nav" aria-label="Settings">
  {blocks.map((block) => (
    <section
      class={`bcn-settings-nav__block${block.id === 'esa-admin' ? ' bcn-settings-nav__block--esa' : ''}`}
      aria-labelledby={`settings-aud-${block.id}`}
    >
      <h2 class="type-body-small bcn-settings-nav__aud" id={`settings-aud-${block.id}`}>
        {block.title}
      </h2>
      {block.zones.map(({ zone, pages }) => (
        <div class="bcn-settings-nav__group">
          <h3
            class="type-body-small bcn-settings-nav__zone"
            id={`settings-zone-${block.id}-${zone.id}`}
          >
            {zone.title}
          </h3>
          <ul
            class="bcn-settings-nav__list"
            aria-labelledby={`settings-zone-${block.id}-${zone.id}`}
            role="list"
          >
            {pages.map((page) => (
              <li class="bcn-settings-nav__item">
                <a
                  class="type-body-small bcn-settings-nav__link"
                  href={withBase(settingsPagePath(page.id))}
                  aria-current={page.id === activePageId ? 'page' : undefined}
                >
                  {page.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>
  ))}
</nav>

<style>
  /* Just the group rhythm — stickiness, the height cap, and the scrolling all belong to
     the shell's rail now (see Frame above). */
  .bcn-settings-nav {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-500, 1.5rem);
  }

  .bcn-settings-nav__block {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-400, 1rem);
  }

  /* The ESA Admin block is a quiet dark panel — the house inverse surface (the topbar's
     family, same as the help bar's dark chrome), so platform-operator territory reads as
     a different world at a glance. The panel IS the divider between the two audience
     blocks; no hairline needed. */
  .bcn-settings-nav__block--esa {
    background: var(--color-surface-inverse);
    border-radius: var(--radius-300, 0.5rem);
    padding: var(--spacing-300, 0.75rem);
  }
  .bcn-settings-nav__block--esa .bcn-settings-nav__aud {
    color: var(--color-text-inverse);
  }
  .bcn-settings-nav__block--esa .bcn-settings-nav__zone {
    color: color-mix(in srgb, var(--color-text-inverse) 64%, transparent);
  }
  .bcn-settings-nav__block--esa .bcn-settings-nav__link {
    color: color-mix(in srgb, var(--color-text-inverse) 78%, transparent);
  }
  .bcn-settings-nav__block--esa .bcn-settings-nav__link:hover {
    background: color-mix(in srgb, var(--color-text-inverse) 8%, transparent);
    color: var(--color-text-inverse);
  }
  .bcn-settings-nav__block--esa .bcn-settings-nav__link[aria-current='page'] {
    background: var(--color-surface-inverse-hover);
    color: var(--color-text-inverse);
  }
  /* The teal focus ring drowns on the dark surface — ring in inverse ink instead. */
  .bcn-settings-nav__block--esa .bcn-settings-nav__link:focus-visible {
    outline-color: var(--color-text-inverse);
  }

  /* Tier 1 — the audience heading. Same 14px as everything in the rail (hierarchy by
     weight and ink, never case/tracking/micro sizes); semibold primary, the strongest
     text here. */
  .bcn-settings-nav__aud {
    margin: 0;
    padding-inline: var(--spacing-300, 0.75rem);
    font-weight: var(--font-weight-semibold, 600);
    color: var(--color-text-primary);
  }

  /* Tier 2 — zone subheadings step down to medium/secondary so they read as internal
     structure under the audience heading, not as its peer. */
  .bcn-settings-nav__zone {
    margin: 0 0 var(--spacing-100, 0.25rem);
    padding-inline: var(--spacing-300, 0.75rem);
    font-weight: var(--font-weight-medium, 500);
    color: var(--color-text-secondary);
  }

  .bcn-settings-nav__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .bcn-settings-nav__link {
    display: block;
    padding: var(--spacing-150, 0.375rem) var(--spacing-300, 0.75rem);
    border-radius: var(--radius-200, 0.5rem);
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: background 0.1s ease, color 0.1s ease;
  }
  /* Hover — HALF the sunken wash, so the current row stays the darkest thing in the
     rail. Both states are neutral, so value is the only thing separating them. */
  .bcn-settings-nav__link:hover {
    background: color-mix(in srgb, var(--color-surface-sunken) 50%, transparent);
    color: var(--color-text-primary);
  }
  .bcn-settings-nav__link:focus-visible {
    outline: var(--focus-ring-width, 2px) solid
      var(--focus-ring-color, var(--color-text-link, #005862));
    outline-offset: 2px;
  }

  /* Current page — the darkest row in the rail, stated in NEUTRAL house value: a full
     sunken wash, primary ink, semibold. No brand tint and no colour bar. */
  .bcn-settings-nav__link[aria-current='page'] {
    background: var(--color-surface-sunken);
    color: var(--color-text-primary);
    font-weight: var(--font-weight-semibold, 600);
  }
</style>
