---
// <BcnSettingsNav> — the grouped left rail for the Unified Settings area. Cross-page
// wayfinding, NOT an in-page TOC; every page is a real link to its own route. The
// current page is resolved at BUILD time from the `activePageId` prop, so the rail
// ships with zero client JS — no scroll-spy, no observers, no hydration.
//
// STRUCTURE (Andy's call, 2026-07-30): AUDIENCE is the first-order grouping — an
// "ESA Admin" block and a "Tenant Admin" block, divided by a hairline — and the
// product zones (General, People & Access, …) are subgroups within each. Both tiers
// derive from existing registry data (zone order × page `audience`); a zone shows
// inside an audience block only when it has pages there, so General can appear in
// both blocks with different pages. The audience heading replaced the per-item ESA
// chips — the block says what the chip used to. In the real product the blocks would
// come from who the signed-in user IS (User.IsEsaAdmin); the rail states ownership
// without simulating gating.
//
// Frame: a plain grouped list that owns NO rail geometry. <BcnSettingsShell> is the
// rail — it holds the sticky position, the height cap, and the scrollport this list
// sits inside. Dropping something else in beside it means giving that wrapper the
// same treatment.
//
// bcn-lego-checked: a two-tier grouped settings rail with a build-time active route
// has no esa-* equivalent. esa-sidebar-nav is the closest lego but wrong on the same
// counts BcnReleaseNav documented: shadow-DOM property-driven internals, group
// headings locked to the banned 11px uppercase micro-label, single-level grouping.
// This rail is also strictly SIMPLER — static links, no client runtime at all.
// Checked Beacon (prod settings nav is a bespoke Angular list). Owned quiet list;
// bcn-settings-nav is its reusable home.
import EsaIcon from '@esa/ecology/esa-icon.astro';
import {
  SETTINGS_ZONES,
  pagesByZone,
  settingsPagePath,
  settingsPageCount,
} from '../../data/settings-registry';
import type { SettingsAudience } from '../../data/settings-registry';
import { withBase } from '../../lib/base';

// Lucide glyphs the shared icon registry doesn't ship — handed to esa-icon through its
// documented `paths` fallback (the AppShell sliders-horizontal precedent). shield = the
// platform operator; building-2 = the tenant organization.
const AUD_ICON_PATHS: Record<SettingsAudience, string> = {
  'esa-admin':
    '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1 1 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>',
  'tenant-admin':
    '<path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/><path d="M10 6h4"/><path d="M10 10h4"/><path d="M10 14h4"/><path d="M10 18h4"/>',
};

interface Props {
  /** id of the settings page currently being viewed — gets the current state. */
  activePageId: string;
}
const { activePageId } = Astro.props;

// ESA Admin leads (the "Platform near the top" call, generalized). Within a block,
// zones keep registry order; a zone with no pages for that audience is dropped so no
// heading ever sits over nothing.
const AUDIENCE_BLOCKS: { id: SettingsAudience; title: string }[] = [
  { id: 'esa-admin', title: 'ESA Admin' },
  { id: 'tenant-admin', title: 'Tenant Admin' },
];

const blocks = AUDIENCE_BLOCKS.map((block) => ({
  ...block,
  zones: SETTINGS_ZONES.map((zone) => ({
    zone,
    pages: pagesByZone(zone.id).filter((p) => p.audience === block.id),
  })).filter((z) => z.pages.length > 0),
})).filter((b) => b.zones.length > 0);
---

<nav class="bcn-settings-nav" aria-label="Settings">
  {blocks.map((block) => (
    <section
      class={`bcn-settings-nav__block${block.id === 'esa-admin' ? ' bcn-settings-nav__block--esa' : ''}`}
      aria-labelledby={`settings-aud-${block.id}`}
    >
      <h2 class="typography-body-md bcn-settings-nav__aud" id={`settings-aud-${block.id}`}>
        <span class="bcn-settings-nav__aud-icon" aria-hidden="true">
          <EsaIcon name={block.id} size="sm" paths={AUD_ICON_PATHS[block.id]} />
        </span>
        {block.title}
      </h2>
      {block.zones.map(({ zone, pages }) => (
        <div class="bcn-settings-nav__group">
          <h3
            class="typography-label bcn-settings-nav__zone"
            id={`settings-zone-${block.id}-${zone.id}`}
          >
            {zone.title}
          </h3>
          <ul
            class="bcn-settings-nav__list"
            aria-labelledby={`settings-zone-${block.id}-${zone.id}`}
            role="list"
          >
            {pages.map((page) => {
              const count = settingsPageCount(page);
              return (
                <li class="bcn-settings-nav__item">
                  <a
                    class="typography-body-sm bcn-settings-nav__link"
                    href={withBase(settingsPagePath(page.id))}
                    aria-current={page.id === activePageId ? 'page' : undefined}
                  >
                    <span class="bcn-settings-nav__page">{page.title}</span>
                    {count !== undefined && (
                      <span class="bcn-settings-nav__count" aria-label={`${count} records`}>
                        {count}
                      </span>
                    )}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </section>
  ))}
</nav>

<style>
  /* Just the group rhythm — stickiness, the height cap, and the scrolling all belong to
     the shell's rail now (see Frame above). */
  .bcn-settings-nav {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-500, 1.5rem);
  }

  .bcn-settings-nav__block {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-400, 1rem);
  }
  /* Extra air between the two audience worlds, on top of the rail's own gap. */
  .bcn-settings-nav__block + .bcn-settings-nav__block {
    margin-block-start: var(--spacing-300, 0.75rem);
  }

  /* The ESA Admin block is a dark-GLASS panel, deliberately the same chrome family as
     the floating help bar (bcn-help-bar) rather than the flat --color-background-default-knockout
     it used to be: solid inverse read as a near-black slab dropped into the rail, while
     the translucent recipe lets the page value through and settles into a mid-charcoal.
     Same tokens, same blur, same fallbacks as the action bar. The panel IS the divider
     between the two audience blocks; no hairline needed. */
  .bcn-settings-nav__block--esa {
    background: var(--bcn-helpbar-bg);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    backdrop-filter: blur(14px) saturate(1.4);
    border: 1px solid var(--bcn-helpbar-border);
    border-radius: var(--radius-300, 0.5rem);
    padding: var(--spacing-300, 0.75rem);
  }
  /* No backdrop-filter support (either prefix) → opaque dark fallback. */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .bcn-settings-nav__block--esa {
      background: var(--bcn-helpbar-bg-solid);
    }
  }
  /* Honor a reduced-transparency preference — drop the blur, go solid. */
  @media (prefers-reduced-transparency: reduce) {
    .bcn-settings-nav__block--esa {
      background: var(--bcn-helpbar-bg-solid);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }
  /* Pure-white ink basis at hotter mixes than the first pass — gray-1 through the glass
     read muddy (Andy, 2026-07-30). Links at 88% hold ~7:1; eyebrows at 78% clear AA at
     their small size. */
  .bcn-settings-nav__block--esa .bcn-settings-nav__aud {
    color: #ffffff;
  }
  .bcn-settings-nav__block--esa .bcn-settings-nav__zone {
    color: color-mix(in srgb, #ffffff 78%, transparent);
  }
  .bcn-settings-nav__block--esa .bcn-settings-nav__link {
    color: color-mix(in srgb, #ffffff 88%, transparent);
  }
  .bcn-settings-nav__block--esa .bcn-settings-nav__link:hover {
    background: color-mix(in srgb, #ffffff 8%, transparent);
    color: #ffffff;
  }
  /* Current page — the same "hover is half of current" logic as the light block, run in
     the other direction: on dark, the most prominent row is the LIGHTEST, so it takes a
     16% ink wash. (--color-background-default-knockout-hover is a solid near-black and would now sink
     the current row BELOW the glass it sits on.) */
  .bcn-settings-nav__block--esa .bcn-settings-nav__link[aria-current='page'] {
    background: color-mix(in srgb, #ffffff 18%, transparent);
    color: #ffffff;
  }
  /* The teal focus ring drowns on the dark surface — ring in white instead. */
  .bcn-settings-nav__block--esa .bcn-settings-nav__link:focus-visible {
    outline-color: #ffffff;
  }

  /* Tier 1 — the audience heading, the strongest text in the rail: .typography-body-md (a step
     ABOVE the links' .typography-body-sm), semibold, primary ink, underscored by a
     hairline that fences the heading off from its first zone group. */
  .bcn-settings-nav__aud {
    display: flex;
    align-items: center;
    gap: var(--spacing-200, 0.5rem);
    margin: 0;
    padding-inline: var(--spacing-300, 0.75rem);
    padding-block-end: var(--spacing-200, 0.5rem);
    border-block-end: 1px solid var(--color-border-default-subtle, var(--color-border-default));
    font-weight: var(--typography-font-weight-semibold, 600);
    color: var(--color-content-default);
  }
  /* The glyph hangs off the heading's own ink; flex kills its baseline slack. */
  .bcn-settings-nav__aud-icon {
    display: inline-flex;
    flex: none;
  }
  /* On the glass panel the hairline runs in white-mix so it reads on charcoal. */
  .bcn-settings-nav__block--esa .bcn-settings-nav__aud {
    border-block-end-color: color-mix(in srgb, #ffffff 18%, transparent);
  }

  /* Tier 2 — zone subheadings as classic eyebrow labels: uppercase, tracked, tertiary,
     a step BELOW the links so the three tiers read 15 semibold > 12 eyebrow > 14 link.
     This deliberately overrides the house "no ornamental section labels" rule — Andy's
     explicit call for the settings rail (2026-07-30). Do not revert it on review: the
     rail carries two grouping tiers in one narrow column, and the eyebrow is what keeps
     the zone from competing with the audience heading above it. */
  .bcn-settings-nav__zone {
    margin: 0 0 var(--spacing-100, 0.25rem);
    padding-inline: var(--spacing-300, 0.75rem);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    /* Bold, not the typography-label role's default weight (Andy, 2026-07-30) — at eyebrow
       size the extra weight is what keeps the label legible against its tracking. */
    font-weight: var(--typography-font-weight-bold, 700);
    color: var(--color-content-default-tertiary);
  }

  .bcn-settings-nav__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .bcn-settings-nav__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-200, 0.5rem);
    /* 13px, under the typography-body-sm role it carries — Andy's explicit call for this
       rail (2026-07-30), same override register as the eyebrow labels above. Do not
       "fix" back to 14 on review. */
    font-size: 0.8125rem;
    padding: var(--spacing-150, 0.375rem) var(--spacing-300, 0.75rem);
    border-radius: var(--radius-200, 0.5rem);
    color: var(--color-content-default-secondary);
    text-decoration: none;
    transition: background 0.1s ease, color 0.1s ease;
  }
  .bcn-settings-nav__page {
    min-width: 0;
  }
  /* Record count — the house quiet-badge shape (4px radius, tinted fill; the BcnCount
     register, never a full pill), mirroring the live count badges on the real admin
     dashboard tiles. */
  .bcn-settings-nav__count {
    flex: none;
    font-size: 0.6875rem; /* 11px inside the chip — genuine meta */
    line-height: 1.2;
    padding: 1px 5px;
    border-radius: var(--radius-100, 0.25rem); /* 4px */
    background: var(--color-background-elevation-sunken);
    color: var(--color-content-default-secondary);
    font-variant-numeric: tabular-nums;
  }
  .bcn-settings-nav__block--esa .bcn-settings-nav__count {
    background: color-mix(in srgb, #ffffff 14%, transparent);
    color: color-mix(in srgb, #ffffff 78%, transparent);
  }
  /* The current row's count keeps the row's ink; the fill steps up a notch so the chip
     doesn't vanish against the active row's own wash. */
  .bcn-settings-nav__link[aria-current='page'] .bcn-settings-nav__count {
    color: inherit;
    background: color-mix(in srgb, var(--color-content-default) 10%, transparent);
  }
  .bcn-settings-nav__block--esa .bcn-settings-nav__link[aria-current='page'] .bcn-settings-nav__count {
    background: color-mix(in srgb, #ffffff 20%, transparent);
  }
  /* Hover — HALF the sunken wash, so the current row stays the darkest thing in the
     rail. Both states are neutral, so value is the only thing separating them. */
  .bcn-settings-nav__link:hover {
    background: color-mix(in srgb, var(--color-background-elevation-sunken) 50%, transparent);
    color: var(--color-content-default);
  }
  .bcn-settings-nav__link:focus-visible {
    outline: var(--focus-ring-width, 2px) solid
      var(--focus-ring-color, var(--color-content-link, #005862));
    outline-offset: 2px;
  }

  /* Current page — the darkest row in the rail, stated in NEUTRAL house value: a full
     sunken wash, primary ink. Weight stays NORMAL (Andy, 2026-07-30) — the wash alone
     carries the state, and a weight change makes the row jitter as you navigate. */
  .bcn-settings-nav__link[aria-current='page'] {
    background: var(--color-background-elevation-sunken);
    color: var(--color-content-default);
  }
</style>
