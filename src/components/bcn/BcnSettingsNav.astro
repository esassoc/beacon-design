---
// <BcnSettingsNav> — the grouped left rail for the Unified Settings area. Cross-page
// wayfinding, NOT an in-page TOC: every zone in SETTINGS_ZONES becomes a group
// (readable zone title + its pages), and every page is a real link to its own route.
// The current page is resolved at BUILD time from the `activePageId` prop, so the
// rail ships with zero client JS — no scroll-spy, no observers, no hydration.
//
// Audience: pages (and whole zones) that only ESA staff can reach carry a quiet
// "ESA" marker and a `data-esa-only` attribute. The shell's view-as toggle sets
// `data-audience="tenant-admin"` on the shell root, and the shell's single
// [data-audience] rule hides every [data-esa-only] descendant — including these rows.
//
// Frame: designed to be the :first-child aside of the page's .sidebar primitive —
// the PAGE owns the .sidebar wrapper and sets --sidebar-width (~15rem). The rail
// sticks WITHIN the .modern-layout__content scroll container, so its sticky top is a
// small breathing gap, NOT the 52px topbar height (AppShell's .modern-layout__body
// already carries that padding). Mirrors BcnReleaseNav's rail conventions.
//
// bcn-lego-checked: a grouped settings rail with a build-time active route and an
// audience marker has no esa-* equivalent. esa-sidebar-nav is the closest lego but
// wrong on three counts (same reasons BcnReleaseNav declined it): it lives behind a
// shadow-DOM, property-driven boundary — so the per-item `data-esa-only` attribute
// the shell's view-as toggle filters on cannot be projected onto its internals; its
// group headings are the banned ornamental micro-label (11px uppercase letter-
// spaced); and its per-item hint can only be a saturated filled badge pill, not the
// quiet ESA marker this rail needs. This rail is also strictly SIMPLER than the lego
// — static links, no client runtime at all. Checked Beacon (prod settings nav is a
// bespoke Angular list). Owned quiet list; bcn-settings-nav is its reusable home.
import EsaBadge from '@esa/ecology/esa-badge.astro';
import { SETTINGS_ZONES, pagesByZone, settingsPagePath } from '../../data/settings-registry';
import { withBase } from '../../lib/base';

interface Props {
  /** id of the settings page currently being viewed — gets the current state. */
  activePageId: string;
}
const { activePageId } = Astro.props;

// Zones render in registry order. A zone with no pages is dropped so the rail never
// shows a heading over nothing. A group is ESA-only when the ZONE is ESA-only or
// when every page under it is — either way the whole group disappears in tenant view,
// so no orphan heading is left behind (resolved at build time, not with CSS :has).
const groups = SETTINGS_ZONES.map((zone) => ({ zone, pages: pagesByZone(zone.id) }))
  .filter((g) => g.pages.length > 0)
  .map((g) => ({
    ...g,
    esaOnly: g.zone.audience === 'esa-admin' || g.pages.every((p) => p.audience === 'esa-admin'),
  }));
---

<nav class="bcn-settings-nav" aria-label="Settings">
  {groups.map(({ zone, pages, esaOnly }) => (
    <div class="bcn-settings-nav__group" data-esa-only={esaOnly ? '' : undefined}>
      <h2 class="type-body-small bcn-settings-nav__zone" id={`settings-zone-${zone.id}`}>
        {zone.title}
        {esaOnly && (
          <span class="bcn-settings-nav__esa">
            <EsaBadge value="ESA" size="sm" />
          </span>
        )}
      </h2>
      <ul class="bcn-settings-nav__list" aria-labelledby={`settings-zone-${zone.id}`} role="list">
        {pages.map((page) => (
          <li
            class="bcn-settings-nav__item"
            data-esa-only={!esaOnly && page.audience === 'esa-admin' ? '' : undefined}
          >
            <a
              class="type-body-small bcn-settings-nav__link"
              href={withBase(settingsPagePath(page.id))}
              aria-current={page.id === activePageId ? 'page' : undefined}
            >
              <span class="bcn-settings-nav__title">{page.title}</span>
              {!esaOnly && page.audience === 'esa-admin' && (
                <span class="bcn-settings-nav__esa">
                  <EsaBadge value="ESA" size="sm" />
                </span>
              )}
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))}
</nav>

<style>
  /* Sticky rail. top is a small breathing gap — the .modern-layout__content scroll
     container already begins below the fixed 52px topbar, so no header offset is
     added here. align-self:start keeps the flex item from stretching, giving the
     sticky element slack to move; the height cap + auto-scroll handle long lists. */
  .bcn-settings-nav {
    position: sticky;
    top: var(--spacing-500, 1.5rem);
    align-self: start;
    max-block-size: calc(100vh - var(--spacing-900, 6rem));
    overflow-y: auto;
    overscroll-behavior: contain;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-400, 1rem);
  }

  /* Audience hiding is NOT re-declared here: this rail only ever renders inside
     <BcnSettingsShell>, whose single [data-audience] rule hides every
     [data-esa-only] descendant — including these groups and rows. */

  /* Zone title — readable words at the same 14px as its links. Hierarchy comes from
     weight and ink, never from case, tracking, or a micro size. */
  .bcn-settings-nav__zone {
    display: flex;
    align-items: center;
    gap: var(--spacing-200, 0.5rem);
    margin: 0 0 var(--spacing-150, 0.375rem);
    padding-inline: var(--spacing-300, 0.75rem);
    font-weight: var(--font-weight-semibold, 600);
    color: var(--color-text-primary);
  }

  .bcn-settings-nav__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .bcn-settings-nav__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-200, 0.5rem);
    padding: var(--spacing-150, 0.375rem) var(--spacing-300, 0.75rem);
    border-radius: var(--radius-200, 0.5rem);
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: background 0.1s ease, color 0.1s ease;
  }
  /* Hover — HALF the sunken wash, so the current row stays the darkest thing in the
     rail. Both states are neutral, so value is the only thing separating them. */
  .bcn-settings-nav__link:hover {
    background: color-mix(in srgb, var(--color-surface-sunken) 50%, transparent);
    color: var(--color-text-primary);
  }
  .bcn-settings-nav__link:focus-visible {
    outline: var(--focus-ring-width, 2px) solid
      var(--focus-ring-color, var(--color-text-link, #005862));
    outline-offset: 2px;
  }

  /* Current page — the darkest row in the rail, stated in NEUTRAL house value: a full
     sunken wash, primary ink, semibold. No brand tint and no colour bar; --color-surface-
     sunken is the deepest surface the semantic layer offers (there is no
     surface-sunken-strong), so hover is softened above rather than active deepened. */
  .bcn-settings-nav__link[aria-current='page'] {
    background: var(--color-surface-sunken);
    color: var(--color-text-primary);
    font-weight: var(--font-weight-semibold, 600);
  }

  .bcn-settings-nav__title {
    min-width: 0;
  }

  /* ESA marker — esa-badge re-tokened through its PUBLIC --badge-* surface to the
     quiet neutral chip this rail needs; the lego's six variants are all saturated
     fills, which would shout on every ESA-only row. flex:none keeps it off the
     title's wrap. */
  .bcn-settings-nav__esa {
    flex: none;
    display: inline-flex;
    --badge-bg: var(--color-surface-sunken);
    --badge-text-color: var(--color-text-tertiary);
  }

  /* When the .sidebar primitive folds the rail above the content on narrow
     viewports, drop the sticky + height cap so it reads as a plain header list. */
  @media (max-width: 48rem) {
    .bcn-settings-nav {
      position: static;
      max-block-size: none;
      overflow: visible;
    }
  }
</style>
