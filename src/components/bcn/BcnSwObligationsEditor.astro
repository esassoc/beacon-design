---
// <BcnSwObligationsEditor> — the one place an obligation is read and changed. Clicking
// a card's title or its pencil opens this drawer filled with that record; there is no
// read-only view, so everything the record holds is here, and the drawer's heading is
// the record's title, following the field as it is typed.
//
// The fields are the anatomy of an obligation (projects/beacon/shaping/obligation-anatomy.md)
// as it stands after the 2026-09-14 round: Title; Class; where it is filed (Category /
// Subcategory); the Trigger a classifier matches evidence against; and the Requirements
// it derives from, each folding open to its exact source text. Scope (phases, species)
// lives on the requirements; there is no Gate field, since whether an obligation waits on
// an approved plan is read off its requirements' actions; and there is no Thresholds
// table, since the numbers stay in the source text until Beacon has something to compare
// them against (dropped 2026-09-14).
//
// Requirements are managed here as well as in the tree: each row can be duplicated,
// moved to another obligation, or unlinked; "Link requirement" adds from the permit's
// full list. Move and Link open a second, narrower drawer stacked over this one.
// Every change lands on the card in the tree at once, so the list and the drawer never
// disagree. Remove routes through the tree's delete guard.
//
// bcn-lego-checked: both frames ARE esa-side-dialog; the controls are esa-text-field,
// esa-select, esa-textarea, esa-checkbox, esa-button. The requirement list is native <details> because esa-accordion carries a heading scale
// this record does not want; the picker rows are native buttons with role=option because
// esa-list-item is not selectable.
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaIcon from '@esa/ecology/esa-icon.astro';
import { ACTIONS_OF, ITP, OBLIGATION_CLASS_LABEL, OBLIGATION_TREE, STEP_GLYPH } from '../../data/setup-wizard';

const CLASS_OPTIONS = JSON.stringify(
  (['adhere', 'monitor', 'notify', 'roster'] as const).map((c) => ({ label: OBLIGATION_CLASS_LABEL[c], value: c })),
);
const CATEGORY_OPTIONS = JSON.stringify(OBLIGATION_TREE.map((c) => ({ label: c.name, value: c.id })));

// The drawer is filled by script from this: every obligation keyed by id, EVERY permit
// requirement keyed by id (with its exact text, so Link can offer all of them), and the
// taxonomy for the two selects.
const requirements: Record<string, { code: string; name: string; text: string; inActions: number }> = {};
for (const r of ITP.requirements) requirements[r.id] = { code: r.commitment, name: r.name, text: r.text, inActions: ACTIONS_OF.get(r.id)?.length ?? 0 };
const obligations: Record<string, unknown> = {};
for (const cat of OBLIGATION_TREE)
  for (const sub of cat.subcategories)
    for (const o of sub.obligations) obligations[o.id] = { title: o.title, class: o.class, trigger: o.trigger, cat: cat.id, sub: sub.id };
const DATA = JSON.stringify({
  obligations,
  requirements,
  classes: OBLIGATION_CLASS_LABEL,
  taxonomy: OBLIGATION_TREE.map((c) => ({ id: c.id, name: c.name, subs: c.subcategories.map((s) => ({ id: s.id, name: s.name })) })),
});
---

<esa-side-dialog
  id="swo-editor"
  heading="Obligation"
  position="right"
  style="--_width: min(640px, 94vw); --z-modal: 1300; --z-modal-backdrop: 1250;">
  <form class="bcn-swo-edit" data-swo-form>
    <esa-text-field label="Title" size="sm" name="swo-title" required></esa-text-field>

    <esa-select label="Class" size="sm" options={CLASS_OPTIONS} name="swo-class" required></esa-select>

    <div class="bcn-swo-edit__pair">
      <esa-select label="Category" size="sm" options={CATEGORY_OPTIONS} name="swo-category" required></esa-select>
      <esa-select label="Subcategory" size="sm" options="[]" name="swo-subcategory" required></esa-select>
    </div>

    <esa-textarea label="Trigger" size="sm" rows={2} name="swo-trigger"></esa-textarea>

    <div class="bcn-swo-edit__section">
      <div class="bcn-swo-edit__label-row">
        <span class="bcn-swo-edit__label">Requirements <span class="bcn-swo-edit__label-n" data-swo-req-n>0</span></span>
        <EsaButton variant="ghost" size="xs" data-swo-link>
          <span class="bcn-swo-edit__verb"><EsaIcon name="plus" size="xs" paths={STEP_GLYPH.plus} />Link requirement</span>
        </EsaButton>
      </div>
      <div class="bcn-swo-edit__reqs" data-swo-reqs></div>
      <p class="bcn-swo-edit__empty" data-swo-req-empty hidden>No requirements linked. This obligation has nothing to stand on.</p>
    </div>
  </form>

  <span slot="footer" class="bcn-swo-edit__foot">
    <EsaButton variant="danger" appearance="soft" size="sm" data-swo-editor-remove>Remove obligation</EsaButton>
    <span class="bcn-swo-edit__foot-right">
      <EsaButton variant="ghost" size="sm" data-swo-editor-cancel>Cancel</EsaButton>
      <EsaButton variant="primary" size="sm" data-swo-editor-save>Save</EsaButton>
    </span>
  </span>

  <template data-swo-tpl="req">
    <details class="bcn-swo-edit__req">
      <summary class="bcn-swo-edit__req-row">
        <span class="bcn-swo-edit__chev" aria-hidden="true"><EsaIcon name="chevron-right" size="xs" /></span>
        <span class="bcn-swo-edit__code"></span>
        <span class="bcn-swo-edit__req-name"></span>
        <span class="bcn-swo-edit__also"></span>
        <span class="bcn-swo-edit__req-verbs">
          <esa-tooltip text="Duplicate"><button type="button" class="bcn-swo-edit__x" aria-label="Duplicate requirement" data-swo-req-verb="dup"><EsaIcon name="copy" size="xs" paths={STEP_GLYPH.copy} /></button></esa-tooltip>
          <esa-tooltip text="Move"><button type="button" class="bcn-swo-edit__x" aria-label="Move requirement" data-swo-req-verb="move"><EsaIcon name="arrow-right" size="xs" /></button></esa-tooltip>
          <esa-tooltip text="Unlink"><button type="button" class="bcn-swo-edit__x bcn-swo-edit__x--danger" aria-label="Unlink requirement" data-swo-req-verb="unlink"><EsaIcon name="x" size="xs" paths={STEP_GLYPH.x} /></button></esa-tooltip>
        </span>
      </summary>
      <blockquote class="bcn-swo-edit__text"></blockquote>
    </details>
  </template>
</esa-side-dialog>

<!-- The second drawer, stacked over the first: Link (pick any number of the permit's
     requirements) or Move (pick the obligation this requirement goes to). -->
<esa-side-dialog
  id="swo-picker"
  heading="Link requirements"
  position="right"
  style="--_width: min(460px, 90vw); --z-modal: 1400; --z-modal-backdrop: 1350;">
  <div class="bcn-swo-pick">
    <esa-text-field size="sm" name="swo-pick-search" placeholder="Search by commitment, name or text…" aria-label="Search"></esa-text-field>
    <p class="bcn-swo-pick__meta" data-swo-pick-meta></p>
    <div class="bcn-swo-pick__list" data-swo-pick-list role="listbox"></div>
  </div>
  <span slot="footer" class="bcn-swo-edit__foot bcn-swo-edit__foot--end">
    <EsaButton variant="ghost" size="sm" data-swo-pick-cancel>Cancel</EsaButton>
    <EsaButton variant="primary" size="sm" data-swo-pick-ok>Link</EsaButton>
  </span>

  <template data-swo-tpl="pick-req">
    <button type="button" class="bcn-swo-pick__row" role="option" aria-selected="false">
      <esa-checkbox size="sm" aria-hidden="true" tabindex="-1"></esa-checkbox>
      <span class="bcn-swo-edit__code"></span>
      <span class="bcn-swo-pick__name"></span>
      <span class="bcn-swo-edit__also"></span>
    </button>
  </template>
  <template data-swo-tpl="pick-obl">
    <button type="button" class="bcn-swo-pick__row" role="option" aria-selected="false">
      <span class="bcn-swo-pick__class"></span>
      <span class="bcn-swo-pick__name"></span>
      <span class="bcn-swo-pick__n"></span>
    </button>
  </template>
  <template data-swo-tpl="pick-group"><div class="bcn-swo-pick__group" role="presentation"></div></template>
</esa-side-dialog>

<script type="application/json" id="swo-data" set:html={DATA}></script>

<script>
  import '@esa/ecology/esa-side-dialog';
  import '@esa/ecology/esa-text-field';
  import '@esa/ecology/esa-textarea';
  import '@esa/ecology/esa-select';
  import '@esa/ecology/esa-checkbox';
  import '@esa/ecology/esa-tooltip';

  type Obl = { title: string; class: string; trigger: string; cat: string; sub: string };
  type Req = { code: string; name: string; text: string; inActions: number };
  type Data = {
    obligations: Record<string, Obl>;
    requirements: Record<string, Req>;
    classes: Record<string, string>;
    taxonomy: { id: string; name: string; subs: { id: string; name: string }[] }[];
  };
  type Drawer = HTMLElement & { open: boolean; heading: string };
  type Valued = HTMLElement & { value: string };
  type Selectish = Valued & { options: unknown[] };

  const editor = document.getElementById('swo-editor') as Drawer | null;
  const picker = document.getElementById('swo-picker') as Drawer | null;
  const data = JSON.parse(document.getElementById('swo-data')?.textContent ?? '{}') as Data;
  const field = (name: string) => editor?.querySelector<Valued>(`[name="${name}"]`) ?? null;
  const tplFrom = (host: HTMLElement | null, name: string) =>
    (host?.querySelector<HTMLTemplateElement>(`template[data-swo-tpl="${name}"]`)!.content.firstElementChild as HTMLElement).cloneNode(true) as HTMLElement;
  const tpl = (name: string) => tplFrom(editor, name);
  const also = (n: number) => (n ? `also in ${n} ${n === 1 ? 'action' : 'actions'}` : '');
  const changed = () => document.dispatchEvent(new CustomEvent('swo:changed'));
  let current: HTMLElement | null = null;

  // ---- Heading follows the title.
  const setHeading = (v: string) => { if (editor) editor.heading = v.trim() || 'Untitled obligation'; };
  const titleField = field('swo-title');
  titleField?.addEventListener('change', () => setHeading(titleField.value));
  titleField?.addEventListener('input', () => setHeading(titleField.value));

  // ---- Filing.
  const setSubOptions = (catId: string, subId?: string) => {
    const sel = field('swo-subcategory') as Selectish | null;
    const cat = data.taxonomy.find((c) => c.id === catId);
    if (!sel) return;
    sel.options = (cat?.subs ?? []).map((s) => ({ label: s.name, value: s.id }));
    sel.value = subId ?? cat?.subs[0]?.id ?? '';
  };

  // ---- Requirements: the drawer's list mirrors the card's rows, by index.
  const cardRows = () => (current ? [...current.querySelectorAll<HTMLElement>('.bcn-swoc__req')] : []);
  const reqOf = (row: HTMLElement): Req =>
    data.requirements[row.dataset.req ?? ''] ?? { code: row.dataset.code ?? '', name: row.querySelector('.bcn-swoc__req-name')?.textContent ?? '', text: '', inActions: 0 };
  const renderReqs = () => {
    const host = editor?.querySelector<HTMLElement>('[data-swo-reqs]');
    if (!host) return;
    host.replaceChildren();
    const rows = cardRows();
    rows.forEach((row, i) => {
      const r = reqOf(row);
      const d = tpl('req');
      d.dataset.index = String(i);
      d.querySelector('.bcn-swo-edit__code')!.textContent = r.code;
      d.querySelector('.bcn-swo-edit__req-name')!.textContent = r.name;
      d.querySelector('.bcn-swo-edit__also')!.textContent = also(r.inActions);
      d.querySelector('.bcn-swo-edit__text')!.textContent = (r.text || '(source text not in this fixture)').replace(/\s*\n\s*/g, ' ');
      host.append(d);
    });
    (host.firstElementChild as HTMLDetailsElement | null)?.setAttribute('open', '');
    editor!.querySelector('[data-swo-req-n]')!.textContent = String(rows.length);
    editor!.querySelector<HTMLElement>('[data-swo-req-empty]')!.hidden = rows.length > 0;
  };
  // A new requirement row is stamped from a live one so the card's scoped styles apply
  // (a template in this file would carry this file's scope, not the card's).
  const stampReq = (id: string): HTMLElement | null => {
    const src = document.querySelector<HTMLElement>('.bcn-swoc__req:has(.bcn-swoc__also)') ?? document.querySelector<HTMLElement>('.bcn-swoc__req');
    const r = data.requirements[id];
    if (!src || !r) return null;
    const li = src.cloneNode(true) as HTMLElement;
    li.classList.remove('is-new', 'is-dragging');
    li.hidden = false;
    li.dataset.req = id;
    li.dataset.code = r.code;
    li.querySelector('.bcn-cbadge')!.textContent = r.code;
    const name = li.querySelector<HTMLElement>('.bcn-swoc__req-name')!;
    name.textContent = r.name;
    name.dataset.swoText = r.name;
    const alsoEl = li.querySelector('.bcn-swoc__also');
    if (r.inActions && alsoEl) alsoEl.textContent = also(r.inActions);
    else alsoEl?.remove();
    return li;
  };
  const flash = (el: HTMLElement) => { el.classList.add('is-new'); setTimeout(() => el.classList.remove('is-new'), 1000); };

  editor?.querySelector('[data-swo-reqs]')?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-swo-req-verb]');
    if (!btn) return;
    e.preventDefault();
    const d = btn.closest<HTMLElement>('.bcn-swo-edit__req')!;
    const row = cardRows()[Number(d.dataset.index)];
    if (!row) return;
    if (btn.dataset.swoReqVerb === 'dup') {
      const copy = row.cloneNode(true) as HTMLElement;
      row.after(copy);
      flash(copy);
      changed();
      renderReqs();
    } else if (btn.dataset.swoReqVerb === 'unlink') {
      row.remove();
      changed();
      renderReqs();
    } else if (btn.dataset.swoReqVerb === 'move') {
      openPicker('move', row);
    }
  });
  editor?.querySelector('[data-swo-link]')?.addEventListener('click', (e) => { e.preventDefault(); openPicker('link'); });

  // ---- The picker: one list, two modes.
  type Mode = 'link' | 'move';
  let mode: Mode = 'link';
  let moving: HTMLElement | null = null;
  const selected = new Set<string>();
  const targets = new Map<string, HTMLElement>();
  const pickList = picker?.querySelector<HTMLElement>('[data-swo-pick-list]');
  const pickMeta = picker?.querySelector<HTMLElement>('[data-swo-pick-meta]');
  const pickSearch = picker?.querySelector<Valued>('[name="swo-pick-search"]');
  const pickOk = picker?.querySelector<HTMLButtonElement>('[data-swo-pick-ok]');
  const CAP = 60;
  // Disabled is toggled on the native button only: the lego's own `disabled` prop
  // also kills pointer events on its wrapper, which script cannot lift.
  if (pickOk) pickOk.disabled = true;

  const syncOk = () => {
    if (!pickOk) return;
    pickOk.disabled = selected.size === 0;
    pickOk.textContent = mode === 'link' ? (selected.size > 1 ? `Link ${selected.size}` : 'Link') : 'Move';
  };
  const renderPick = () => {
    if (!pickList || !pickMeta) return;
    const needle = (pickSearch?.value ?? '').trim().toLowerCase();
    pickList.replaceChildren();
    targets.clear();
    if (mode === 'link') {
      pickList.setAttribute('aria-multiselectable', 'true');
      const linked = new Set(cardRows().map((r) => r.dataset.req));
      const all = Object.entries(data.requirements).filter(([id]) => !linked.has(id));
      const hits = needle ? all.filter(([, r]) => `${r.code} ${r.name} ${r.text}`.toLowerCase().includes(needle)) : all;
      hits.slice(0, CAP).forEach(([id, r]) => {
        const b = tplFrom(picker, 'pick-req');
        b.dataset.id = id;
        b.querySelector('.bcn-swo-edit__code')!.textContent = r.code;
        b.querySelector('.bcn-swo-pick__name')!.textContent = r.name;
        b.querySelector('.bcn-swo-edit__also')!.textContent = also(r.inActions);
        pickList.append(b);
      });
      pickMeta.textContent = hits.length > CAP ? `Showing ${CAP} of ${hits.length}. Narrow the search.` : `${hits.length} of the permit's ${Object.keys(data.requirements).length} requirements${linked.size ? `; ${linked.size} already linked here` : ''}.`;
    } else {
      pickList.removeAttribute('aria-multiselectable');
      let n = 0;
      document.querySelectorAll<HTMLElement>('[data-swo-sub]').forEach((sub) => {
        const catName = sub.closest('[data-swo-cat]')?.querySelector('[data-swo-name]')?.textContent?.trim() ?? '';
        const subName = sub.querySelector('[data-swo-name]')?.textContent?.trim() ?? '';
        const cards = [...sub.querySelectorAll<HTMLElement>('[data-swo-card]')].filter((c) => c !== current);
        const rows = cards.filter((c) => !needle || `${catName} ${subName} ${c.querySelector('.bcn-swoc__title')?.textContent ?? ''}`.toLowerCase().includes(needle));
        if (!rows.length) return;
        const g = tplFrom(picker, 'pick-group');
        g.textContent = `${catName} › ${subName}`;
        pickList.append(g);
        rows.forEach((c) => {
          const key = `t${++n}`;
          targets.set(key, c);
          const b = tplFrom(picker, 'pick-obl');
          b.dataset.id = key;
          b.querySelector('.bcn-swo-pick__class')!.textContent = data.classes[c.dataset.class ?? ''] ?? c.dataset.class ?? '';
          b.querySelector('.bcn-swo-pick__name')!.textContent = c.querySelector('.bcn-swoc__title')?.textContent?.trim() ?? '';
          const k = c.querySelectorAll('.bcn-swoc__req').length;
          b.querySelector('.bcn-swo-pick__n')!.textContent = String(k);
          pickList.append(b);
        });
      });
      pickMeta.textContent = `${n} ${n === 1 ? 'obligation' : 'obligations'}${needle ? ' match' : ''}.`;
    }
    pickList.querySelectorAll<HTMLElement>('[role="option"]').forEach((b) => paint(b));
  };
  const paint = (b: HTMLElement) => {
    const on = selected.has(b.dataset.id ?? '');
    b.setAttribute('aria-selected', String(on));
    const cb = b.querySelector('esa-checkbox') as (HTMLElement & { checked: boolean }) | null;
    if (cb) cb.checked = on;
  };
  const openPicker = (m: Mode, row?: HTMLElement) => {
    if (!picker) return;
    mode = m;
    moving = row ?? null;
    selected.clear();
    picker.heading = m === 'link' ? 'Link requirements' : `Move ${row ? reqOf(row).code : 'requirement'} to…`;
    if (pickSearch) pickSearch.value = '';
    Promise.all(['esa-checkbox', 'esa-text-field'].map((t) => customElements.whenDefined(t))).then(() => {
      renderPick();
      syncOk();
      picker.open = true;
    });
  };
  pickList?.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[role="option"]');
    if (!b) return;
    e.preventDefault();
    const id = b.dataset.id ?? '';
    if (mode === 'link') {
      if (selected.has(id)) selected.delete(id);
      else selected.add(id);
      paint(b);
    } else {
      selected.clear();
      selected.add(id);
      pickList.querySelectorAll<HTMLElement>('[role="option"]').forEach((x) => paint(x));
    }
    syncOk();
  });
  pickSearch?.addEventListener('change', () => renderPick());
  pickSearch?.addEventListener('input', () => renderPick());
  picker?.querySelector('[data-swo-pick-cancel]')?.addEventListener('click', () => (picker.open = false));
  pickOk?.addEventListener('click', () => {
    if (!current || !picker) return;
    if (mode === 'link') {
      const host = current.querySelector('.bcn-swoc__reqs');
      selected.forEach((id) => {
        const li = stampReq(id);
        if (li && host) { host.append(li); flash(li); }
      });
      (current.querySelector('.bcn-swoc__node') as HTMLDetailsElement | null)?.setAttribute('open', '');
    } else if (moving) {
      const card = targets.get([...selected][0] ?? '');
      const host = card?.querySelector('.bcn-swoc__reqs');
      if (card && host) {
        host.append(moving);
        (card.querySelector('.bcn-swoc__node') as HTMLDetailsElement | null)?.setAttribute('open', '');
        (card.closest('.bcn-swot__sub') as HTMLDetailsElement | null)?.setAttribute('open', '');
        (card.closest('[data-swo-cat]') as HTMLDetailsElement | null)?.setAttribute('open', '');
        flash(moving);
      }
    }
    picker.open = false;
    changed();
    renderReqs();
  });

  // ---- Fill from a card.
  const fill = (card: HTMLElement) => {
    current = card;
    const id = card.dataset.id ?? '';
    const o: Obl = data.obligations[id] ?? {
      title: card.querySelector('.bcn-swoc__title')?.textContent?.trim() ?? '',
      class: card.dataset.class ?? 'adhere', trigger: '',
      cat: card.closest<HTMLElement>('[data-swo-cat]')?.dataset.swoCat ?? '', sub: card.closest<HTMLElement>('[data-swo-sub]')?.dataset.swoSub ?? '',
    };
    // Where the card sits NOW wins over where the fixture filed it — it may have been dragged.
    const catNow = card.closest<HTMLElement>('[data-swo-cat]')?.dataset.swoCat ?? o.cat;
    const subNow = card.closest<HTMLElement>('[data-swo-sub]')?.dataset.swoSub ?? o.sub;

    const title = card.querySelector('.bcn-swoc__title')?.textContent?.trim() ?? o.title;
    field('swo-title')!.value = title;
    setHeading(title);
    field('swo-class')!.value = card.dataset.class ?? o.class;
    field('swo-trigger')!.value = o.trigger;
    const cat = field('swo-category') as Selectish | null;
    if (cat) {
      // A category made in this session is not in the fixture's options; add it by its live name.
      const known = data.taxonomy.some((c) => c.id === catNow);
      if (!known) {
        const name = card.closest('[data-swo-cat]')?.querySelector('[data-swo-name]')?.textContent?.trim() ?? 'New category';
        const subs = [...(card.closest('[data-swo-cat]')?.querySelectorAll<HTMLElement>('[data-swo-sub]') ?? [])].map((s) => ({ id: s.dataset.swoSub ?? '', name: s.querySelector('[data-swo-name]')?.textContent?.trim() ?? '' }));
        data.taxonomy.push({ id: catNow, name, subs });
        cat.options = data.taxonomy.map((c) => ({ label: c.name, value: c.id }));
      }
      cat.value = catNow;
    }
    setSubOptions(catNow, subNow);

    renderReqs();
  };

  const open = (card: HTMLElement) => {
    if (!editor) return;
    Promise.all(['esa-select', 'esa-text-field', 'esa-textarea', 'esa-side-dialog'].map((t) => customElements.whenDefined(t))).then(() => {
      fill(card);
      editor.open = true;
    });
  };

  // Any card's title or pencil opens the drawer on that card.
  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const trigger = t.closest<HTMLElement>('[data-swo-open]');
    if (!trigger) return;
    const card = trigger.closest<HTMLElement>('[data-swo-card]');
    if (!card) return;
    e.preventDefault();
    open(card);
  });

  field('swo-category')?.addEventListener('change', (e) => setSubOptions((e.target as Valued).value));
  editor?.querySelector('[data-swo-editor-cancel]')?.addEventListener('click', () => (editor.open = false));
  // Remove hands the card to the tree's delete guard; the drawer closes only if the
  // guard confirms (the card's removal is what closes it).
  editor?.querySelector('[data-swo-editor-remove]')?.addEventListener('click', () => {
    current?.dispatchEvent(new CustomEvent('swo:remove-card', { bubbles: true }));
  });
  document.addEventListener('swo:changed', () => { if (editor?.open && current && !current.isConnected) editor.open = false; });
  // Save writes the title and class back onto the card, and refiles it if the
  // category or subcategory changed — the same move as a drag.
  editor?.querySelector('[data-swo-editor-save]')?.addEventListener('click', () => {
    if (!current) return;
    const title = field('swo-title')!.value.trim();
    const cls = field('swo-class')!.value;
    const t = current.querySelector<HTMLElement>('.bcn-swoc__title');
    if (t && title) { t.textContent = title; t.dataset.swoText = title; }
    if (cls) {
      current.dataset.class = cls;
      const tag = current.querySelector('[data-swo-class-tag]');
      if (tag) tag.textContent = data.classes[cls] ?? cls;
    }
    const subId = field('swo-subcategory')!.value;
    const dest = document.querySelector<HTMLElement>(`[data-swo-sub="${subId}"] [data-swo-cards]`);
    if (dest && !dest.contains(current)) {
      dest.prepend(current);
      (dest.closest('details') as HTMLDetailsElement).open = true;
      (dest.closest('[data-swo-cat]') as HTMLDetailsElement).open = true;
    }
    editor.open = false;
    changed();
  });
</script>

