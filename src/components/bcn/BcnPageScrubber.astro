---
// <BcnPageScrubber> — every page of a document in one strip: which pages have been read,
// which have finds (a pip per find, hollow while found and solid once parsed), which were
// read and have none (a gap, where a missed item hides), how far ahead the reader is (the
// head), and which page the person is looking at (the thumb). Drag or click to jump to a
// page; click a pip to land on that find.
//
// A slider for the keyboard: arrows step a page, Page Up/Down step five, Home/End go to
// the ends. Pips are pointer shortcuts; the list beside the strip is the keyboard path to
// a find.
//
// Contract: page-scrubber.ts `setupPageScrubber(root, handlers)` returns `update(model)`.
//   out  onPage(page)            the person picked a page (click, drag, keys)
//   out  onFind(id)              the person clicked a pip
//
// bcn-lego-checked: esa-range-slider is a single native range input (no per-step state,
// no markers, no second indicator), esa-progress-bar is one ratio, esa-pagination is
// numbered buttons; checked Beacon (no page strip; its PDF viewer pages by toolbar).
// The timeline components here (BcnScheduleTimeline, BcnTimelineExplorer) lay out dated
// bars, not discrete pages. bcn-page-scrubber is the reusable home for "a document's
// pages, with per-page state and markers".
interface Props {
  first: number;
  last: number;
  /** Accessible name for the strip. */
  label?: string;
}
const { first, last, label = 'Page' } = Astro.props;
const pages = Array.from({ length: last - first + 1 }, (_, i) => first + i);
const ticks = pages.filter((p) => p === first || p === last || p % 10 === 0);
---

<div class="bcn-scrub" data-page-scrubber data-first={first} data-last={last} style={`--_n: ${pages.length};`}>
  <div
    class="bcn-scrub__track"
    role="slider"
    tabindex="0"
    aria-label={label}
    aria-valuemin={first}
    aria-valuemax={last}
    aria-valuenow={first}
    aria-valuetext={`Page ${first}`}
    data-scrub-track
  >
    {
      pages.map((n) => (
        <span class="bcn-scrub__page" data-page={n} data-state="pending">
          <span class="bcn-scrub__pips" data-scrub-pips />
        </span>
      ))
    }
    <span class="bcn-scrub__head" data-scrub-head hidden aria-hidden="true"></span>
    <span class="bcn-scrub__thumb" data-scrub-thumb aria-hidden="true"></span>
  </div>
  <div class="bcn-scrub__ticks typography-microcopy-sm" aria-hidden="true">
    {ticks.map((n) => <span class="bcn-scrub__tick" style={`--_i: ${n - first};`}>{n}</span>)}
  </div>
</div>

<style>
  .bcn-scrub {
    --_cell: calc(100% / var(--_n));
    display: flex;
    flex-direction: column;
    gap: var(--spacing-100);
    user-select: none;
  }

  .bcn-scrub__track {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--_n), minmax(0, 1fr));
    gap: 2px;
    height: 40px;
    padding: 4px 0;
    cursor: pointer;
    touch-action: none;
    border-radius: var(--radius-100);
  }
  .bcn-scrub__track:focus-visible {
    outline: var(--focus-ring-width, 2px) solid var(--focus-ring-color);
    outline-offset: var(--focus-ring-offset, 2px);
  }

  /* A page: empty until read, then filled. Pips sit along its top. */
  .bcn-scrub__page {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding-top: 4px;
    border-radius: 2px;
    background: var(--color-background-elevation-sunken);
    border: 1px solid var(--color-border-default-subtle);
    transition: background-color 160ms ease;
  }
  .bcn-scrub__page[data-state='scanned'] {
    background: color-mix(in srgb, var(--color-content-default) 26%, var(--color-background-elevation-raised));
    border-color: transparent;
  }
  /* A gap: read, in scope, and nothing found on it. */
  .bcn-scrub__page[data-state='gap'] {
    background: repeating-linear-gradient(
      135deg,
      var(--color-background-warning-subtle),
      var(--color-background-warning-subtle) 3px,
      var(--color-background-elevation-raised) 3px,
      var(--color-background-elevation-raised) 6px
    );
    border-color: var(--color-border-warning);
  }
  .bcn-scrub__page[data-state='out'] {
    background: transparent;
    border-style: dashed;
    opacity: 0.5;
  }

  .bcn-scrub__pips {
    display: flex;
    flex-direction: column;
    gap: 2px;
    align-items: center;
  }
  .bcn-scrub__pips :global(.bcn-scrub__pip) {
    display: block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    border: 1.5px solid var(--color-commitment);
    background: var(--color-background-elevation-raised);
    cursor: pointer;
    animation: bcn-scrub-pop 220ms ease-out;
  }
  .bcn-scrub__pips :global(.bcn-scrub__pip[data-parsed]) { background: var(--color-commitment); }
  .bcn-scrub__pips :global(.bcn-scrub__pip[data-selected]) {
    box-shadow: 0 0 0 2px var(--color-background-elevation-raised), 0 0 0 3.5px var(--color-commitment);
  }

  /* The scan head: a bar at the page being read. */
  .bcn-scrub__head {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--_cell) * var(--_head, 0));
    width: var(--_cell);
    border-radius: 2px;
    background: color-mix(in srgb, var(--color-background-brand) 22%, transparent);
    box-shadow: inset 0 -3px 0 var(--color-background-brand);
    pointer-events: none;
    transition: left 300ms ease;
  }

  /* The thumb: the page in view. */
  .bcn-scrub__thumb {
    position: absolute;
    top: -3px;
    bottom: -3px;
    left: calc(var(--_cell) * var(--_view, 0) - 2px);
    width: calc(var(--_cell) + 4px);
    border: 2px solid var(--color-content-default);
    border-radius: 4px;
    pointer-events: none;
  }

  .bcn-scrub__ticks {
    position: relative;
    height: 1.25rem;
    line-height: 1.25rem;
    color: var(--color-content-default-secondary);
    font-variant-numeric: tabular-nums;
  }
  .bcn-scrub__tick {
    position: absolute;
    left: calc(var(--_cell) * var(--_i) + var(--_cell) / 2);
    transform: translateX(-50%);
  }

  @keyframes bcn-scrub-pop {
    from { transform: scale(0); }
    to { transform: scale(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .bcn-scrub__pips :global(.bcn-scrub__pip),
    .bcn-scrub__head { animation: none; transition: none; }
  }
</style>
