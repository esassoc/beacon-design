---
// <BcnPageScrubber> — every page of a document, a window at a time: which pages have
// been read, which are outside the scope (skipped, not read), which have finds (a pip per
// find, hollow while found and solid once parsed), which were read and have none (a gap,
// where a missed item hides), how far ahead the reader is (the head), and which page the
// person is looking at (the thumb). Drag or click to jump to a page; click a pip to land
// on that find. A document of hundreds of pages will not fit one strip, so the strip shows
// a window (50 pages by default) with previous / next beside it; the window follows the
// page in view unless the person pages it themselves.
//
// A slider for the keyboard: arrows step a page, Page Up/Down step five, Home/End go to
// the ends of the document. Pips are pointer shortcuts; the cards beside the page are the
// keyboard path to a find.
//
// Contract: page-scrubber.ts `setupPageScrubber(root, handlers)` returns `update(model)`;
// the model carries the document's page count, so one strip serves any document.
//   out  onPage(page)            the person picked a page (click, drag, keys)
//   out  onFind(id)              the person clicked a pip
//
// bcn-lego-checked: esa-range-slider is a single native range input (no per-step state,
// no markers, no second indicator), esa-progress-bar is one ratio, esa-pagination is
// numbered buttons; the window's previous / next ARE esa-icon-button. Checked Beacon (no
// page strip; its PDF viewer pages by toolbar). bcn-page-scrubber is the reusable home
// for "a document's pages, with per-page state and markers".
import EsaIconButton from '@esa/ecology/esa-icon-button.astro';

interface Props {
  /** Accessible name for the strip. */
  label?: string;
  /** Pages per window. */
  size?: number;
}
const { label = 'Page', size = 50 } = Astro.props;
---

<div class="bcn-scrub" data-page-scrubber data-size={size} style={`--_n: ${size};`}>
  <span data-scrub-prev><EsaIconButton icon="chevrons-left" label="Earlier pages" size="sm" /></span>
  <div class="bcn-scrub__strip">
    <div
      class="bcn-scrub__track"
      role="slider"
      tabindex="0"
      aria-label={label}
      aria-valuemin="1"
      aria-valuemax="1"
      aria-valuenow="1"
      data-scrub-track
    >
      <span class="bcn-scrub__head" data-scrub-head hidden aria-hidden="true"></span>
      <span class="bcn-scrub__thumb" data-scrub-thumb aria-hidden="true"></span>
      <span class="bcn-scrub__tip typography-label-sm" data-scrub-tip hidden aria-hidden="true"></span>
    </div>
    <div class="bcn-scrub__ticks typography-microcopy-sm" aria-hidden="true" data-scrub-ticks></div>
  </div>
  <span data-scrub-next><EsaIconButton icon="chevrons-right" label="Later pages" size="sm" /></span>
</div>

<style>
  .bcn-scrub {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: start;
    gap: var(--spacing-200);
    user-select: none;
  }
  .bcn-scrub > span { padding-top: 6px; }
  .bcn-scrub__strip {
    --_cell: calc(100% / var(--_n));
    display: flex;
    flex-direction: column;
    gap: var(--spacing-100);
    min-width: 0;
  }

  .bcn-scrub__track {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--_n), minmax(0, 1fr));
    gap: 2px;
    height: 44px;
    padding: 6px;
    cursor: pointer;
    touch-action: none;
    border-radius: var(--radius-100);
    /* Sunken, so a blank (unread) page reads as a white cell on it. */
    background: var(--color-background-elevation-sunken);
  }
  .bcn-scrub__track:focus-visible {
    outline: var(--focus-ring-width, 2px) solid var(--focus-ring-color);
    outline-offset: var(--focus-ring-offset, 2px);
  }

  /* A page: empty until read, then filled. Pips sit along its top. Cells are built by the
     controller, so they are reached through :global(). */
  .bcn-scrub__track :global(.bcn-scrub__page) {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding-top: 4px;
    border-radius: 2px;
    /* Unread and in scope: a blank page, outlined so every page is visible. */
    background: var(--color-background-elevation-raised);
    border: 1px solid var(--color-border-default);
    transition: background-color 160ms ease;
  }
  .bcn-scrub__track :global(.bcn-scrub__page[data-state='scanned']) {
    background: color-mix(in srgb, var(--color-content-default) 20%, var(--color-background-elevation-raised));
    border-color: transparent;
  }
  /* Read with nothing found: just read. Silence is not a warning. */
  .bcn-scrub__track :global(.bcn-scrub__page[data-state='gap']) {
    background: color-mix(in srgb, var(--color-content-default) 20%, var(--color-background-elevation-raised));
    border-color: transparent;
  }
  /* Outside the scope: skipped, never read. */
  .bcn-scrub__track :global(.bcn-scrub__page[data-state='out']) {
    background: color-mix(in srgb, var(--color-content-default) 6%, var(--color-background-elevation-sunken));
    border-color: transparent;
  }
  /* Past the document's end, in the last window. */
  .bcn-scrub__track :global(.bcn-scrub__page[data-state='none']) { visibility: hidden; }

  .bcn-scrub__track :global(.bcn-scrub__pips) {
    display: flex;
    flex-direction: column;
    gap: 2px;
    align-items: center;
  }
  .bcn-scrub__track :global(.bcn-scrub__pip) {
    display: block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    border: 1.5px solid var(--color-commitment);
    background: var(--color-background-elevation-raised);
    cursor: pointer;
    animation: bcn-scrub-pop 220ms ease-out;
  }
  .bcn-scrub__track :global(.bcn-scrub__pip[data-parsed]) { background: var(--color-commitment); }
  .bcn-scrub__track :global(.bcn-scrub__pip[data-selected]) {
    box-shadow: 0 0 0 2px var(--color-background-elevation-raised), 0 0 0 3.5px var(--color-commitment);
  }

  /* The scan head: a bar at the page being read. */
  .bcn-scrub__head {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--_cell) * var(--_head, 0));
    width: var(--_cell);
    border-radius: 2px;
    background: color-mix(in srgb, var(--bcn-aldo) 24%, transparent);
    box-shadow: inset 0 -3px 0 var(--bcn-aldo);
    pointer-events: none;
    transition: left 300ms ease;
  }

  /* The thumb: the page in view. */
  .bcn-scrub__thumb {
    position: absolute;
    top: -3px;
    bottom: -3px;
    left: calc(var(--_cell) * var(--_view, 0) - 2px);
    width: calc(var(--_cell) + 4px);
    border: 2px solid var(--color-content-default);
    border-radius: 4px;
    pointer-events: none;
  }

  /* The page under the pointer, floated above its cell while hovering or dragging. */
  .bcn-scrub__tip {
    position: absolute;
    bottom: calc(100% + 4px);
    left: calc(var(--_cell) * var(--_tip, 0) + var(--_cell) / 2);
    transform: translateX(-50%);
    padding: 1px var(--spacing-150, 0.375rem);
    border-radius: var(--radius-100);
    background: var(--color-content-default);
    color: var(--color-content-default-knockout);
    white-space: nowrap;
    pointer-events: none;
    z-index: 1;
  }

  .bcn-scrub__ticks {
    position: relative;
    height: 1.25rem;
    line-height: 1.25rem;
    color: var(--color-content-default-secondary);
    font-variant-numeric: tabular-nums;
  }
  .bcn-scrub__ticks :global(.bcn-scrub__tick) {
    position: absolute;
    left: calc(var(--_cell) * var(--_i) + var(--_cell) / 2);
    transform: translateX(-50%);
  }

  @keyframes bcn-scrub-pop {
    from { transform: scale(0); }
    to { transform: scale(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .bcn-scrub__track :global(.bcn-scrub__pip),
    .bcn-scrub__head { animation: none; transition: none; }
  }
</style>
