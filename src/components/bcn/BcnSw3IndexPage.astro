---
// <BcnSw3IndexPage> — one subcategory in the center pane, as develop's main pane shows it.
//
// The tools, in one bar pinned across the top of the pane, as the PDF's page tools are on
// step 1 (borderless keys; a tool that needs a selection in its place, off until there is
// one): where it sits, Category › Subcategory as plain text with each one's color dot (the
// category's hue, as in the index and the scrubber), never links; then Merge (two or more
// ticked), Discard all and Approve all (N).
//
// Before drafting: its lists as develop renders them before a run fills them: Actions (0)
// and Obligations (0), each reading None, the keys disabled.
//
// Drafted: the review, in Beacon's document voice. Two lists, Actions then Obligations,
// then Discarded (N), folded. Each draft is one line: a box to tick for Merge; its kind (an
// action's requirement type in the action color, an obligation's class chip); its title,
// cut to the line; the commitments it rests on, as commitment badges (more than one stack
// left to right, and open a popover listing them all); an approved check. Pressing the
// title opens its edit form in the side panel (bcn-sw3-entry-edit), where Approve, Discard
// and Restore live.
//
// The controller is the host's (sw3-index.ts): this component is markup, templates and look.
//
// bcn-lego-checked: the trail IS esa-breadcrumbs with no links (its icon slot holds the
// color dot); the kind mark IS bcn-draft-kind (develop's obligation-class-chip, and a
// requirement-type chip on its metrics); the cites ARE bcn-commitment-badge in esa-popover;
// every key IS esa-button; the tick IS esa-checkbox; the check IS esa-icon. Checked Beacon:
// subcategory-review lists actions then obligations with checkboxes on the rows and opens
// the edit dialogs (ObligationEditDialog, ActionsStepEditDialog). bcn-sw3-index-page is
// its home.
import EsaButton from '@esa/ecology/esa-button.astro';
import BcnDraftKind from './BcnDraftKind.astro';
import BcnCommitmentBadge from './BcnCommitmentBadge.astro';
import EsaIcon from '@esa/ecology/esa-icon.astro';
import EsaBreadcrumbs from '@esa/ecology/esa-breadcrumbs.astro';
import { glyphPaths } from './comment-glyphs';

const dot = '<span class="bcn-sw3ip__dot" data-ip-dot></span>';
---

<BcnDraftKind />
<article class="bcn-sw3ip" data-sw3-index-page aria-label="Subcategory">
  <div class="bcn-sw3ip__tools" role="toolbar" aria-label="Subcategory tools">
    <div class="bcn-sw3ip__crumbs" data-ip-crumbs>
      <EsaBreadcrumbs size="sm" items={[{ label: 'Category', icon: dot }, { label: 'Subcategory', icon: dot }]} />
    </div>
    <div class="bcn-sw3ip__toolkeys" data-ip-acts>
      <EsaButton variant="ghost" size="sm" icon="plus" title="Merge the ticked drafts" data-ip-merge>Merge</EsaButton>
      <span class="bcn-sw3ip__rule" aria-hidden="true"></span>
      <EsaButton variant="ghost" size="sm" icon="x" title="Discard all" data-ip-discard-all>Discard all</EsaButton>
      <EsaButton variant="secondary" size="sm" icon="circle-check" data-ip-approve-all>Approve all</EsaButton>
    </div>
  </div>

  <div class="bcn-sw3ip__review" data-ip-review>
    <div class="bcn-sw3ip__groups" data-ip-groups></div>
    <p class="bcn-sw3ip__empty" data-ip-empty hidden></p>
    <details class="bcn-sw3ip__discarded" data-ip-discarded>
      <summary class="bcn-sw3ip__gh"><span data-ip-discarded-label>Discarded</span></summary>
      <div class="bcn-sw3ip__discarded-acts" data-ip-restore-all-wrap>
        <EsaButton variant="ghost" size="xs" icon="rotate-ccw" data-ip-restore-all>Restore all</EsaButton>
      </div>
      <ol class="bcn-sw3ip__entries" data-ip-discarded-list></ol>
    </details>
  </div>

  <template data-ip-tpl="group">
    <section class="bcn-sw3ip__group">
      <h3 class="bcn-sw3ip__gh" data-g-name></h3>
      <ol class="bcn-sw3ip__entries" data-g-entries></ol>
    </section>
  </template>

  <template data-ip-tpl="entry">
    <li class="bcn-sw3ip__entry" data-status="draft">
      <div class="bcn-sw3ip__line">
        <span class="bcn-sw3ip__tick" data-e-tick><esa-checkbox size="sm" aria-label="Select for merge"></esa-checkbox></span>
        <span class="bcn-sw3ip__chip" data-e-chip></span>
        <a class="bcn-sw3ip__name" href="#" data-e-open></a>
        <span class="bcn-sw3ip__cites" data-e-cites></span>
        <span class="bcn-sw3ip__ok" data-e-ok><EsaIcon name="circle-check" size="sm" label="Approved" /></span>
      </div>
    </li>
  </template>
  <template data-ip-tpl="badge"><BcnCommitmentBadge code="" size="sm" /></template>
  <span hidden data-ip-merge-glyph set:html={glyphPaths('merge')} />
</article>

<style>
  .bcn-sw3ip { display: flex; flex-direction: column; min-height: 100%; }
  .bcn-sw3ip [hidden] { display: none !important; }
  /* The tools: one strip pinned across the top of the pane, as the PDF's page tools are. */
  .bcn-sw3ip__tools {
    container-type: inline-size;
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-100) var(--spacing-300);
    min-height: 2.75rem;
    box-sizing: border-box;
    padding: var(--spacing-150, 0.375rem) var(--spacing-200) var(--spacing-150, 0.375rem) var(--spacing-600);
    background: var(--color-background-elevation-raised);
    border-bottom: 1px solid var(--color-border-default);
  }
  /* A narrow pane: Merge and Discard all fold to their icons, the titles carry them, and the
     trail keeps the room. */
  @container (max-width: 720px) {
    .bcn-sw3ip__toolkeys :global(:is([data-ip-merge], [data-ip-discard-all]) .esa-button__label) { display: none; }
  }
  .bcn-sw3ip__toolkeys { display: flex; align-items: center; gap: var(--spacing-100); flex: none; }
  .bcn-sw3ip__rule { width: 1px; align-self: stretch; margin: 2px var(--spacing-100); background: var(--color-border-default); }
  .bcn-sw3ip__tools :global(button:disabled) { opacity: 0.38; }
  /* Where it sits: Category > Subcategory, each cut to fit, each with its color dot. */
  .bcn-sw3ip__crumbs { flex: 1; min-width: 0; font-size: 0.8125rem; }
  .bcn-sw3ip__crumbs :global(.esa-breadcrumbs__list) { flex-wrap: nowrap; --_crumb-gap: var(--spacing-150, 6px); }
  .bcn-sw3ip__crumbs :global(.esa-breadcrumbs__item) { min-width: 0; }
  .bcn-sw3ip__crumbs :global(.esa-breadcrumbs__item:first-child) { flex: 0 1 auto; max-width: 45%; }
  .bcn-sw3ip__crumbs :global(.esa-breadcrumbs__link),
  .bcn-sw3ip__crumbs :global(.esa-breadcrumbs__current) { display: block; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .bcn-sw3ip__crumbs :global(.esa-breadcrumbs__icon) { display: inline-flex; vertical-align: middle; margin-right: var(--spacing-150, 6px); }
  /* The category reads as the parent: regular weight, secondary. */
  .bcn-sw3ip__crumbs :global(.esa-breadcrumbs__item:first-child .esa-breadcrumbs__current) { font-weight: 400; color: var(--color-content-default-secondary); }
  .bcn-sw3ip__crumbs :global(.bcn-sw3ip__dot) { width: 8px; height: 8px; border-radius: 50%; background: var(--_hue, var(--color-content-default-tertiary)); }
  .bcn-sw3ip :global(.bcn-sw3ip__gh) {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-content-default);
    padding-bottom: var(--spacing-100);
    border-bottom: 1px solid var(--color-border-default);
  }
  .bcn-sw3ip__empty { margin: 0; color: var(--color-content-default-secondary); font-size: 0.875rem; }

  .bcn-sw3ip__review { display: flex; flex-direction: column; gap: var(--spacing-500); padding: var(--spacing-500) var(--spacing-600); }
  .bcn-sw3ip__groups { display: flex; flex-direction: column; gap: var(--spacing-500); }
  .bcn-sw3ip :global(.bcn-sw3ip__group) { display: flex; flex-direction: column; gap: var(--spacing-200); }
  /* A list's rows share its columns (subgrid): the kind column is as wide as its widest
     chip, so an action's type and an obligation's class sit snug against the title. */
  .bcn-sw3ip :global(.bcn-sw3ip__entries) {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: auto fit-content(9.5rem) minmax(0, 1fr) auto auto;
    column-gap: var(--spacing-200);
    row-gap: var(--spacing-100);
  }
  .bcn-sw3ip :global(.bcn-sw3ip__entries > li) { grid-column: 1 / -1; }
  .bcn-sw3ip :global(.bcn-sw3ip__entry) { display: grid; grid-template-columns: subgrid; }

  .bcn-sw3ip__discarded { display: flex; flex-direction: column; gap: var(--spacing-200); }
  .bcn-sw3ip__discarded > summary { cursor: pointer; list-style-position: inside; }
  .bcn-sw3ip__discarded-acts { display: flex; justify-content: flex-end; padding: var(--spacing-150) 0; }

  /* A draft: one index line. Draft dashed, approved solid, discarded struck. */
  .bcn-sw3ip :global(.bcn-sw3ip__entry) {
    border: 1px dashed var(--color-border-default-strong, var(--color-border-default));
    border-radius: var(--radius-100);
    background: var(--color-background-elevation-raised);
  }
  .bcn-sw3ip :global(.bcn-sw3ip__entry[data-status='approved']) { border-style: solid; border-color: var(--color-border-default); }
  .bcn-sw3ip :global(.bcn-sw3ip__entry[data-status='discarded']) { border-color: transparent; background: none; }
  .bcn-sw3ip :global(.bcn-sw3ip__entry[data-open]) { border-style: solid; border-color: var(--color-border-default-strong, var(--color-border-default)); }
  .bcn-sw3ip :global(.bcn-sw3ip__entry[data-focus]) { border-color: var(--color-border-default-focus); }

  .bcn-sw3ip :global(.bcn-sw3ip__line) {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    align-items: center;
    gap: var(--spacing-200);
    padding: var(--spacing-150) var(--spacing-300);
    font-size: 0.875rem;
  }
  .bcn-sw3ip :global(.bcn-sw3ip__tick) { display: flex; width: 1.25rem; padding-right: var(--spacing-100); line-height: 0; }
  .bcn-sw3ip :global(.bcn-sw3ip__ok) { display: flex; width: 1.25rem; }
  .bcn-sw3ip :global(.bcn-sw3ip__entry:not([data-status='draft']) .bcn-sw3ip__tick) { visibility: hidden; }
  .bcn-sw3ip :global(.bcn-sw3ip__chip) { display: flex; min-width: 0; line-height: 0; }
  .bcn-sw3ip :global(.bcn-sw3ip__chip .bcn-draft-kind) { max-width: 100%; }
  /* One line each: the title is cut to the row; the side panel holds it in full. */
  .bcn-sw3ip :global(.bcn-sw3ip__name) { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--color-content-default); font-weight: 500; text-decoration: none; }
  .bcn-sw3ip :global(.bcn-sw3ip__none) { padding: var(--spacing-150) var(--spacing-300); font-size: 0.875rem; color: var(--color-content-default-secondary); }
  .bcn-sw3ip :global(.bcn-sw3ip__name:hover) { text-decoration: underline; }
  .bcn-sw3ip :global(.bcn-sw3ip__entry[data-status='discarded'] .bcn-sw3ip__name) { text-decoration: line-through; color: var(--color-content-default-tertiary); }
  .bcn-sw3ip :global(.bcn-sw3ip__entry[data-open]) { background: var(--color-background-elevation-sunken); }
  .bcn-sw3ip :global(.bcn-sw3ip__ok) { visibility: hidden; line-height: 0; color: var(--color-content-success); }
  .bcn-sw3ip :global(.bcn-sw3ip__entry[data-status='approved'] .bcn-sw3ip__ok) { visibility: visible; }

  /* The commitments a draft rests on: one badge, or a stack of them. */
  .bcn-sw3ip :global(.bcn-sw3ip__cites) { display: flex; justify-content: flex-end; line-height: 0; }
  .bcn-sw3ip :global(:is(.bcn-sw3ip__cite, .bcn-sw3ip__stack)) {
    display: inline-flex;
    padding: 0;
    border: 0;
    background: none;
    border-radius: var(--radius-100);
    text-decoration: none;
    cursor: pointer;
    font: inherit;
    line-height: 1.5;
  }
  .bcn-sw3ip :global(.bcn-sw3ip__cite:hover .bcn-cbadge),
  .bcn-sw3ip :global(.bcn-sw3ip__stack:hover .bcn-cbadge:first-child) { background: color-mix(in srgb, var(--color-commitment) 22%, var(--color-background-elevation-raised)); }
  /* Stacked left to right: the first on top, each one under it a step to the right, its
     edge in a deeper tint so the layers read as cards. */
  .bcn-sw3ip :global(.bcn-sw3ip__stack) { display: inline-grid; padding-right: calc((var(--_n) - 1) * 9px); }
  .bcn-sw3ip :global(.bcn-sw3ip__stack .bcn-cbadge) { grid-area: 1 / 1; box-shadow: 1.5px 0 0 0 var(--color-background-elevation-raised), 0 0 0 1px var(--color-background-elevation-raised); }
  .bcn-sw3ip :global(.bcn-sw3ip__stack .bcn-cbadge:nth-child(1)) { z-index: 3; }
  .bcn-sw3ip :global(.bcn-sw3ip__stack .bcn-cbadge:nth-child(2)) {
    z-index: 2;
    transform: translateX(9px) scaleY(0.84);
    color: transparent;
    background: color-mix(in srgb, var(--color-commitment) 26%, var(--color-background-elevation-raised));
  }
  .bcn-sw3ip :global(.bcn-sw3ip__stack .bcn-cbadge:nth-child(3)) {
    z-index: 1;
    transform: translateX(18px) scaleY(0.68);
    color: transparent;
    background: color-mix(in srgb, var(--color-commitment) 40%, var(--color-background-elevation-raised));
  }
  /* The popover: every commitment, its badge and its title; each opens it. */
  .bcn-sw3ip :global(.bcn-sw3ip__stack:hover .bcn-cbadge:nth-child(2)) { transform: translateX(11px) scaleY(0.84); }
  .bcn-sw3ip :global(.bcn-sw3ip__stack:hover .bcn-cbadge:nth-child(3)) { transform: translateX(22px) scaleY(0.68); }
  .bcn-sw3ip :global(.bcn-sw3ip__stack .bcn-cbadge) { transition: transform 120ms ease-out; }
  @media (prefers-reduced-motion: reduce) { .bcn-sw3ip :global(.bcn-sw3ip__stack .bcn-cbadge) { transition: none; } }
  .bcn-sw3ip :global(.bcn-sw3ip__citelist) { display: flex; flex-direction: column; width: max-content; min-width: 16rem; max-width: min(26rem, 60vw); margin: calc(-1 * var(--spacing-100)); line-height: 1.4; }
  .bcn-sw3ip :global(.bcn-sw3ip__citelist a) {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: baseline;
    gap: var(--spacing-200);
    padding: var(--spacing-150) var(--spacing-200);
    border-radius: var(--radius-100);
    font-size: 0.8125rem;
    color: var(--color-content-default);
    text-decoration: none;
  }
  .bcn-sw3ip :global(.bcn-sw3ip__citelist a:hover) { background: var(--color-background-elevation-sunken); }
  .bcn-sw3ip :global(.bcn-sw3ip__citelist a span:last-child) { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
</style>
