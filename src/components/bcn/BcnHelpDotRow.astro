---
// <BcnHelpDotRow> — one dot in the admin's Dots on This Page list (<BcnHelpDotsAdmin>), on
// the drawer's dark admin segment. One dense line (round 15): the title, the spot it sits
// on, muted, a Draft tag when it is one, and small icon actions that show on hover or focus.
// A Claude draft carries Publish, Edit and Dismiss, and its Draft tag's tooltip says what it
// was drafted from. Any other dot carries Edit and Detach. A dot whose spot is gone (under
// Needs a New Spot) carries Pick Again and Detach.
//
// Every action is in the markup and the help-dots controller shows the set the dot's state
// calls for, so a status change never rebuilds the row. Without a `dot` the row renders
// blank: that is the template new dots are cloned from.
//
// bcn-lego-checked: the row is a single-line flex layout on the dark segment, which no
// esa-* lego renders (esa-card's header band is too tall for a list row). The actions ARE
// esa-button (chrome, iconOnly) and the tooltip IS esa-tooltip. The Draft tag is the
// settings rail's count tag on dark (BcnSettingsNav.astro), as esa-badge has no dark
// variant. Checked Beacon: the drawer rows are Angular markup over the same tokens.
// bcn-help-dot-row is the home.
import EsaButton from '@esa/ecology/esa-button.astro';
import type { HelpDot } from '../../data/help-dots';

interface Props {
  dot?: HelpDot;
  /** The spot's label, as the admin reads it. */
  spotLabel?: string;
}
const { dot, spotLabel = '' } = Astro.props;
const from = dot?.draftedFrom ? `Drafted from ${dot.draftedFrom}` : '';
---

<div class="bcn-hdr" data-hda-row data-dot-id={dot?.id}>
  <span class="bcn-hdr__title typography-label-sm-strong" data-hda-title>{dot?.title}</span>
  <span class="bcn-hdr__tag" data-hda-draft hidden>
    {from ? <esa-tooltip text={from}><span class="bcn-hdr__tag-text typography-label-xs">Draft</span></esa-tooltip> : <span class="bcn-hdr__tag-text typography-label-xs">Draft</span>}
  </span>
  <span class="bcn-hdr__spot typography-body-xs" data-hda-spot>{spotLabel}</span>
  <span class="bcn-hdr__tools">
    <span data-hda-act="publish"><EsaButton variant="chrome" iconOnly icon="check" label="Publish" size="xs" data-hda-publish /></span>
    <span data-hda-act="pickagain"><EsaButton variant="chrome" iconOnly icon="map-pin" label="Pick Again" size="xs" data-hda-pickagain /></span>
    <span data-hda-act="edit"><EsaButton variant="chrome" iconOnly icon="pencil" label="Edit" size="xs" data-hda-edit /></span>
    <span data-hda-act="dismiss"><EsaButton variant="chrome" iconOnly icon="x" label="Dismiss" size="xs" data-hda-dismiss /></span>
    <span data-hda-act="detach"><EsaButton variant="chrome" iconOnly icon="x" label="Detach from This Page" size="xs" data-hda-detach /></span>
  </span>
</div>

<script>
  import '@esa/ecology/esa-tooltip';
</script>

<style>
  .bcn-hdr {
    display: flex;
    align-items: center;
    gap: var(--spacing-200);
    min-block-size: 34px;
    padding-inline: var(--spacing-200) var(--spacing-100);
    border-radius: var(--radius-200);
    color: color-mix(in srgb, #ffffff 88%, transparent);
  }
  /* The settings rail's dark hover: an 8% white wash. */
  .bcn-hdr:hover,
  .bcn-hdr:focus-within {
    background: color-mix(in srgb, #ffffff 8%, transparent);
    color: #ffffff;
  }
  .bcn-hdr__title {
    flex: none;
    max-inline-size: 55%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .bcn-hdr__spot {
    flex: 1;
    min-inline-size: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: color-mix(in srgb, #ffffff 58%, transparent);
  }
  .bcn-hdr__tag {
    display: inline-flex;
    flex: none;
  }
  .bcn-hdr__tag-text {
    padding: 0 var(--spacing-150);
    border-radius: var(--radius-100);
    background: color-mix(in srgb, #ffffff 14%, transparent);
    color: color-mix(in srgb, #ffffff 78%, transparent);
  }
  /* Actions come up on hover or focus, so a list of a dozen dots reads as a list. */
  .bcn-hdr__tools {
    display: inline-flex;
    flex: none;
    gap: 2px;
    opacity: 0;
    color: #ffffff;
  }
  .bcn-hdr:hover .bcn-hdr__tools,
  .bcn-hdr:focus-within .bcn-hdr__tools {
    opacity: 1;
  }
  @media (hover: none) {
    .bcn-hdr__tools {
      opacity: 1;
    }
  }
  .bcn-hdr__tools > span {
    display: inline-flex;
  }
  /* Last, so it outranks the display rules above at equal specificity. */
  .bcn-hdr[hidden],
  .bcn-hdr [hidden] {
    display: none;
  }
</style>
