---
// <BcnHelpDotRow> — one dot in the admin's Dots on This Page list (<BcnHelpDotsAdmin>).
// Its title, a Draft badge when it is one, the spot it sits on, and the drawer's edit and
// detach controls, the same two prod's drawer rows carry. A Claude draft adds its
// "Drafted from" line and Publish, Edit and Dismiss in place of the two controls. A row
// whose spot is gone shows Pick Again instead.
//
// Every variant is in the markup and the help-dots controller shows the one the dot's
// state calls for, so a status change never rebuilds the row. Without a `dot` the row
// renders blank: that is the template new dots are cloned from.
//
// bcn-lego-checked: the row is a two-part layout, a bordered content card and then the two
// icon controls outside it as in prod's drawer authoring rows, which no esa-* lego
// renders. esa-card was checked: its header slot is a titled band too tall for a list row.
// Everything inside IS a lego: esa-badge (Draft), esa-button (Publish, Edit, Dismiss, Pick
// Again), esa-icon-button (edit, detach). Checked Beacon: the drawer rows are Angular
// markup over the same tokens. bcn-help-dot-row is the home.
import EsaBadge from '@esa/ecology/esa-badge.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaIconButton from '@esa/ecology/esa-icon-button.astro';
import type { HelpDot } from '../../data/help-dots';

interface Props {
  dot?: HelpDot;
  /** The spot's label, as the admin reads it. */
  spotLabel?: string;
}
const { dot, spotLabel = '' } = Astro.props;
---

<div class="bcn-hdr" data-hda-row data-dot-id={dot?.id}>
  <div class="bcn-hdr__card stack" data-gap="3xs">
    <div class="cluster" data-gap="xs">
      <span class="bcn-hdr__title typography-label-md-strong" data-hda-title>{dot?.title}</span>
      <span class="bcn-hdr__badge" data-hda-draft hidden>
        <EsaBadge value="Draft" size="sm" />
      </span>
    </div>
    <span class="bcn-hdr__meta typography-body-sm" data-hda-spot>{spotLabel}</span>
    <span class="bcn-hdr__meta typography-body-sm" data-hda-from hidden>Drafted from {dot?.draftedFrom}</span>
    <div class="bcn-hdr__review cluster" data-gap="xs" data-hda-review hidden>
      <EsaButton variant="primary" size="sm" data-hda-publish>Publish</EsaButton>
      <EsaButton variant="ghost" appearance="outline" size="sm" data-hda-edit>Edit</EsaButton>
      <EsaButton variant="ghost" size="sm" data-hda-dismiss>Dismiss</EsaButton>
    </div>
    <div class="bcn-hdr__review cluster" data-gap="xs" data-hda-repick hidden>
      <EsaButton variant="ghost" appearance="outline" size="sm" data-hda-pickagain>Pick Again</EsaButton>
    </div>
  </div>
  <div class="bcn-hdr__tools" data-hda-tools>
    <EsaIconButton icon="pencil" label="Edit" size="sm" data-hda-edit />
    <EsaIconButton icon="x" label="Detach from This Page" size="sm" data-hda-detach />
  </div>
</div>

<style>
  .bcn-hdr {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-150);
  }
  .bcn-hdr__card {
    flex: 1;
    min-width: 0;
    padding: var(--spacing-250) var(--spacing-300);
    background: var(--color-background-elevation-raised);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-200);
  }
  .bcn-hdr__title {
    color: var(--color-content-default);
  }
  .bcn-hdr__badge {
    display: inline-flex;
  }
  .bcn-hdr__meta {
    color: var(--color-content-default-secondary);
  }
  .bcn-hdr__review {
    padding-block-start: var(--spacing-150);
  }
  .bcn-hdr__tools {
    display: flex;
    gap: var(--spacing-050);
    padding-block-start: var(--spacing-150);
    color: var(--color-content-default-secondary);
  }
  /* Last, so it outranks the display rules above at equal specificity. */
  .bcn-hdr[hidden],
  .bcn-hdr [hidden] {
    display: none;
  }
</style>
