---
// <BcnSettingRow> — the atom of the Unified Settings prototype. ONE setting, rendered as
// the Framer / Laravel Cloud row anatomy: name + plain-language description on the left,
// its control on the right, collapsing to a single column when the row gets cramped.
//
// Everything the row shows comes off the SettingItem record — label, description, and the
// control's own kind + value. The row authors nothing.
//
// ANCHORS: the wrapper carries id="s-<item.id>", so search results deep-link to
// `#s-<id>`. Arriving there fires a :target animation that settles a synthesis-blue tint
// (--color-info-subtle) back to transparent, which is what tells the reader WHICH row the
// result meant. scroll-margin keeps the row clear of a sticky app bar.
//
// LABELLING: toggle / text / select / textarea each resolve to a single form-associated
// custom element, and a form-associated custom element is a *labelable* element — so the
// visible name is a real <label for> bound to the lego host (plus aria-labelledby, which
// names the host wherever AT exposes it). upload and chips are groups, not single
// controls, so their name is a plain <span> and the control column takes
// role="group" aria-labelledby instead; their buttons keep their own names ("Replace",
// "Add") and reference the setting name via aria-describedby.
//
// esa-switch-toggle additionally gets the lego's own `label` prop, visually clipped via
// ::part(label): its inner <button role="switch"> lives in shadow DOM and is otherwise
// unnamed, and the exposed part is the only handle a spoke has to name it without showing
// the text twice. esa-text-field / esa-textarea / esa-select expose no such part, so their
// shadow-internal <input> relies on the host-level association above — see the hub gap
// noted in the handoff.
//
// bcn-lego-checked: every control here IS a lego (esa-switch-toggle, esa-text-field,
// esa-select, esa-textarea, esa-button, esa-pill) and the row geometry is the .repel /
// .stack / .cluster primitives from @esa/tokens — no bespoke flex or grid. Checked
// Ecology (no esa-* settings-row / labelled-field-row lego exists; esa-form-field stacks a
// label ABOVE its control, which is the opposite anatomy) and Beacon (prod settings are
// per-feature Angular forms, no shared row). bcn-setting-row is the reusable home for the
// label/description/control row. The only CSS below is composition glue: primitive --gap /
// --align / --justify tuning, the control column's basis, and the :target highlight.
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaPill from '@esa/ecology/esa-pill.astro';
import type { SettingItem } from '../../data/settings-registry';

interface Props {
  item: SettingItem;
}

const { item } = Astro.props;
const control = item.control;

const rowId = `s-${item.id}`;
const labelId = `${rowId}-label`;
const controlId = `${rowId}-control`;

// Single labelable control vs. a group of them — decides <label for> vs role="group".
const isGroup = control.kind === 'upload' || control.kind === 'chips';

// The control column's inner primitive, by kind: a right-justified cluster for the
// affordance kinds, a bare block for the full-width fields, a stack where a hint sits
// under the control.
const CONTROL_LAYOUT: Record<string, string> = {
  toggle: 'cluster',
  text: '',
  select: '',
  textarea: '',
  upload: 'stack',
  chips: 'cluster',
};
const controlClass = ['bcn-setting-row__control', CONTROL_LAYOUT[control.kind]].filter(Boolean).join(' ');

// esa-select hydrates its option list from a JSON attribute; the registry models options
// as plain strings, so value and label are the same token.
const selectOptionsJson =
  control.kind === 'select' ? JSON.stringify(control.options.map((o) => ({ value: o, label: o }))) : undefined;
---

<div class="bcn-setting-row repel" id={rowId} data-kind={control.kind}>
  <div class="bcn-setting-row__def stack">
    {
      isGroup ? (
        <span class="bcn-setting-row__label type-body" id={labelId}>
          {item.label}
        </span>
      ) : (
        <label class="bcn-setting-row__label type-body" id={labelId} for={controlId}>
          {item.label}
        </label>
      )
    }
    <p class="bcn-setting-row__desc type-body-small">{item.description}</p>
  </div>

  <div class={controlClass} role={isGroup ? 'group' : undefined} aria-labelledby={isGroup ? labelId : undefined}>
    {
      control.kind === 'toggle' && (
        <esa-switch-toggle
          id={controlId}
          aria-labelledby={labelId}
          label={item.label}
          size="md"
          checked={control.value}
        ></esa-switch-toggle>
      )
    }

    {
      control.kind === 'text' && (
        <esa-text-field
          id={controlId}
          aria-labelledby={labelId}
          type="text"
          size="md"
          value={control.value}
          placeholder={control.placeholder}
          disabled={control.locked}
          help-text={control.locked ? control.lockedReason : undefined}
        ></esa-text-field>
      )
    }

    {
      control.kind === 'select' && (
        <esa-select
          id={controlId}
          aria-labelledby={labelId}
          size="md"
          options={selectOptionsJson}
          data-setting-value={control.value}
        ></esa-select>
      )
    }

    {
      control.kind === 'textarea' && (
        <esa-textarea
          id={controlId}
          aria-labelledby={labelId}
          size="md"
          rows={3}
          value={control.value}
        ></esa-textarea>
      )
    }

    {
      control.kind === 'upload' && (
        <>
          <div class="bcn-setting-row__file cluster">
            <span class={`bcn-setting-row__filename ${control.value ? '' : 'is-empty'}`}>
              {control.value ?? 'No file'}
            </span>
            <EsaButton
              size="sm"
              color="secondary"
              appearance="outline"
              icon="upload"
              aria-describedby={labelId}
            >
              {control.value ? 'Replace' : 'Upload'}
            </EsaButton>
          </div>
          <p class="bcn-setting-row__help">{control.hint}</p>
        </>
      )
    }

    {
      control.kind === 'chips' && (
        <>
          {control.value.map((v) => (
            <EsaPill label={v} size="sm" removable={false} />
          ))}
          <EsaButton size="sm" color="ghost" appearance="outline" icon="plus" aria-describedby={labelId}>
            Add
          </EsaButton>
        </>
      )
    }
  </div>
</div>

<script>
  // Register the Lit legos so the custom elements upgrade on any page that renders a row.
  import '@esa/ecology/esa-switch-toggle';
  import '@esa/ecology/esa-text-field';
  import '@esa/ecology/esa-select';
  import '@esa/ecology/esa-textarea';

  // esa-select's `value` is a property ACCESSOR — it is deliberately absent from the
  // lego's static properties, so there is no attribute to render a selection into.
  // Hand the fixture's value over as a property once the element upgrades. This is
  // initial-state hydration, not behavior: nothing here listens for change.
  customElements.whenDefined('esa-select').then(() => {
    document
      .querySelectorAll<HTMLElement & { value: string }>('esa-select[data-setting-value]')
      .forEach((el) => {
        el.value = el.dataset.settingValue ?? '';
      });
  });
</script>

<style>
  /* Row — .repel pushes definition and control apart and wraps to one column when
     cramped. Specificity 0,2,0 so the primitive's own --align/--gap defaults lose. */
  .bcn-setting-row.repel {
    --gap: var(--spacing-500);
    --align: center;
    padding-block: var(--spacing-300);
    padding-inline: var(--spacing-300);
    /* Deep-linked rows must clear a sticky app bar. */
    scroll-margin-block-start: var(--spacing-800);
  }
  /* The row owns no divider — the hosting list draws the hairline between rows,
     same contract as bcn-flag-row. */
  /* Tall controls hang off the top of the definition block, not its middle. */
  .bcn-setting-row.repel[data-kind='textarea'],
  .bcn-setting-row.repel[data-kind='upload'] {
    --align: start;
  }

  /* Search deep-link: settle a synthesis-blue tint back to transparent so arriving from
     a result shows WHICH row was meant. `both` holds the transparent end state. */
  @keyframes bcn-setting-row-target {
    from {
      background-color: var(--color-info-subtle);
      box-shadow: 0 0 0 1px var(--color-info-border);
    }
    to {
      background-color: transparent;
      box-shadow: 0 0 0 1px transparent;
    }
  }
  .bcn-setting-row:target {
    border-radius: var(--radius-200);
    animation: bcn-setting-row-target 2.6s ease-out both;
  }
  @media (prefers-reduced-motion: reduce) {
    .bcn-setting-row:target {
      animation: none;
      background-color: var(--color-info-subtle);
      box-shadow: 0 0 0 1px var(--color-info-border);
    }
  }

  /* Definition column — name over description, tight. */
  .bcn-setting-row__def.stack {
    --gap: var(--spacing-100);
    flex-basis: 24rem;
    flex-grow: 1;
    max-inline-size: 34rem;
  }
  /* 16px name / 14px description — the same dense pairing as bcn-flag-row, so every
     labelled row in the settings surface reads at one scale. */
  .bcn-setting-row__label {
    line-height: 1.4;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
  }
  .bcn-setting-row__desc {
    line-height: 1.4;
    color: var(--color-text-secondary);
    max-inline-size: 60ch;
  }

  /* Control column — fixed-ish basis so every control in a section lines up. */
  .bcn-setting-row__control {
    flex-basis: 20rem;
    flex-grow: 0;
    min-inline-size: 0;
  }
  .bcn-setting-row__control.cluster {
    --justify: flex-end;
    --gap: var(--spacing-200);
  }
  .bcn-setting-row__control.stack {
    --gap: var(--spacing-150);
  }
  /* A switch is content-width; it does not need the field column. */
  .bcn-setting-row[data-kind='toggle'] .bcn-setting-row__control {
    flex-basis: auto;
  }

  /* Field legos fill the control column. */
  .bcn-setting-row__control esa-text-field,
  .bcn-setting-row__control esa-select,
  .bcn-setting-row__control esa-textarea {
    display: block;
    inline-size: 100%;
  }

  /* Vertical-centering fix, same as bcn-flag-row: the lego's inline-block host puts its
     track on a text baseline inside an inherited line box, floating the switch high.
     A flex host collapses to track height so the row centers it truly. (NEEDS.md.) */
  .bcn-setting-row__control esa-switch-toggle {
    display: flex;
    align-items: center;
  }

  /* The switch's inner <button role="switch"> takes its accessible name from the lego's
     own label; clip that copy so the visible name stays the row's. Clipped, never
     display:none — it has to survive in the accessibility tree. */
  esa-switch-toggle::part(label) {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Upload — current filename beside the action, hint underneath. Font size and color
     match esa-text-field's own internal help text so a hint reads the same whether the
     lego renders it or this row does. */
  .bcn-setting-row__file.cluster {
    --justify: flex-end;
    --gap: var(--spacing-250);
  }
  .bcn-setting-row__filename {
    font-size: var(--type-size-150);
    color: var(--color-text-primary);
  }
  .bcn-setting-row__filename.is-empty {
    color: var(--color-text-muted);
  }
  .bcn-setting-row__help {
    font-size: var(--type-size-100);
    color: var(--form-help-color);
    text-align: end;
  }

  /* Stacked: the control column goes full width and re-aligns under its name. */
  @media (max-width: 40rem) {
    .bcn-setting-row__control {
      flex-basis: 100%;
    }
    .bcn-setting-row__control.cluster,
    .bcn-setting-row__file.cluster {
      --justify: flex-start;
    }
    .bcn-setting-row__help {
      text-align: start;
    }
  }
</style>
