---
// <BcnEvidenceEntryPoints> — the prototype page's demo section: the four ways the global
// evidence drawer gets opened, each one actually opening it in the state that entry point
// would produce.
//
// Two of the cards carry a mocked fragment of the surface they come FROM, because the
// point of a contextual entry is what it carries over: the action card shows the single
// action that lands on the right, and the bulk card shows four checked rows that all land
// on the right at once. Andrew named those two as the surfaces worth pre-populating from,
// and the bulk one is the case that replaces today's modal-on-top-of-a-sidebar flow.
//
// Wiring is by data-* hook, composed BLIND: this section adds no open behavior of its own,
// it only advertises [data-evidence-open="<preset>"], which the drawer listens for. Same
// convention BcnHelpBar uses for the guidance drawer and the search palette.
//
// bcn-lego-checked: esa-card is every card's chrome; esa-button is every trigger;
// bcn-commitment-badge is the action code chip — the same one the modules, timeline and
// tracker rows use, so a quoted action looks like an action. Checked Ecology for a
// "demo / entry-point gallery" lego and
// Beacon prod for an equivalent — neither exists (this is prototype-page furniture, not a
// product surface). bcn-evidence-entry-points is the reusable home for it; its own CSS is
// the card grid and the two mocked fragments.
import EsaCard from '@esa/ecology/esa-card.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import BcnCommitmentBadge from './BcnCommitmentBadge.astro';
import {
  ENTRY_PRESETS,
  BULK_PRESELECTED,
  SINGLE_ACTION_ID,
  actionById,
  FREQUENCY_LABEL,
} from '../../data/evidence-drawer';

const single = actionById(SINGLE_ACTION_ID)!;
const bulkRows = BULK_PRESELECTED.map((id) => actionById(id)!);
const preset = (id: string) => ENTRY_PRESETS.find((p) => p.id === id)!;
---

<section class="bcn-ev-entries stack" data-gap="md" aria-labelledby="bcn-ev-entries-title">
  <div class="bcn-ev-entries__intro">
    <h2 class="type-section-title" id="bcn-ev-entries-title">Four ways in</h2>
    <p class="type-body bcn-ev-entries__lede">
      The drawer is the same workspace every time. What changes is what is already on it when it
      opens. Try each one — then close it and open it from the Attach Evidence of Compliance button in the
      bottom bar.
    </p>
  </div>

  <div class="bcn-ev-entries__grid">
    <!-- 1 · Cold open -->
    <EsaCard variant="outlined">
      <div class="bcn-ev-entry">
        <h3 class="type-card-title">{preset('cold').label}</h3>
        <p class="type-body-small bcn-ev-entry__blurb">{preset('cold').blurb}</p>
        <div class="bcn-ev-entry__demo bcn-ev-entry__demo--quiet">
          <p class="type-body-small">
            The Attach Evidence of Compliance button sits in the floating bar at the bottom of every page,
            where Search used to be.
          </p>
        </div>
        <div class="bcn-ev-entry__act">
          <span data-evidence-open="cold">
            <EsaButton color="primary" size="md">Open the drawer</EsaButton>
          </span>
        </div>
      </div>
    </EsaCard>

    <!-- 2 · From a single action -->
    <EsaCard variant="outlined">
      <div class="bcn-ev-entry">
        <h3 class="type-card-title">{preset('single-action').label}</h3>
        <p class="type-body-small bcn-ev-entry__blurb">{preset('single-action').blurb}</p>
        <div class="bcn-ev-entry__demo">
          <p class="bcn-ev-entry__mocklabel type-caption">An open action</p>
          <p class="bcn-ev-entry__mocktitle">
            <BcnCommitmentBadge code={single.code} size="sm" />
            <span>{single.name}</span>
          </p>
          <p class="type-body-small bcn-ev-entry__mockmeta">
            {FREQUENCY_LABEL[single.frequency]} · {single.period}
          </p>
          <div class="bcn-ev-entry__mockact">
            <span data-evidence-open="single-action">
              <EsaButton color="ghost" appearance="outline" size="sm">Add evidence</EsaButton>
            </span>
          </div>
        </div>
      </div>
    </EsaCard>

    <!-- 3 · Bulk -->
    <EsaCard variant="outlined">
      <div class="bcn-ev-entry">
        <h3 class="type-card-title">{preset('bulk').label}</h3>
        <p class="type-body-small bcn-ev-entry__blurb">{preset('bulk').blurb}</p>
        <div class="bcn-ev-entry__demo">
          <p class="bcn-ev-entry__mocklabel type-caption">An action list, four selected</p>
          <ul class="bcn-ev-entry__rows">
            {bulkRows.map((a) => (
              <li class="bcn-ev-entry__row">
                <span class="bcn-ev-entry__check" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7" /></svg>
                </span>
                <BcnCommitmentBadge code={a.code} size="sm" />
                <span class="bcn-ev-entry__rowname">{a.name}</span>
              </li>
            ))}
          </ul>
          <div class="bcn-ev-entry__mockact">
            <span data-evidence-open="bulk">
              <EsaButton color="ghost" appearance="outline" size="sm">
                Add evidence to {bulkRows.length} actions
              </EsaButton>
            </span>
          </div>
        </div>
      </div>
    </EsaCard>

    <!-- 4 · Existing evidence -->
    <EsaCard variant="outlined">
      <div class="bcn-ev-entry">
        <h3 class="type-card-title">{preset('existing').label}</h3>
        <p class="type-body-small bcn-ev-entry__blurb">{preset('existing').blurb}</p>
        <div class="bcn-ev-entry__demo bcn-ev-entry__demo--quiet">
          <p class="type-body-small">
            Andrew raised this as a real need: the evidence table is already long, and it grows
            every day the monitoring portal runs.
          </p>
        </div>
        <div class="bcn-ev-entry__act">
          <span data-evidence-open="existing">
            <EsaButton color="ghost" appearance="outline" size="md">Open on existing evidence</EsaButton>
          </span>
        </div>
      </div>
    </EsaCard>
  </div>
</section>

<style>
  .bcn-ev-entries__lede {
    margin: var(--spacing-200) 0 0;
    max-width: 78ch;
    color: var(--color-text-secondary);
  }
  .bcn-ev-entries__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--spacing-400);
    align-items: start;
  }

  .bcn-ev-entry {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-300);
    height: 100%;
  }
  .bcn-ev-entry__blurb {
    margin: 0;
    color: var(--color-text-secondary);
  }

  /* The mocked fragment of the surface this entry comes from. Sunken so it reads as a
     quotation of another screen, not as part of this one. */
  .bcn-ev-entry__demo {
    margin-top: auto;
    padding: var(--spacing-300);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-200);
    background: var(--color-background);
  }
  .bcn-ev-entry__demo--quiet {
    color: var(--color-text-secondary);
  }
  .bcn-ev-entry__demo--quiet p {
    margin: 0;
  }
  .bcn-ev-entry__mocklabel {
    margin: 0 0 var(--spacing-200);
    color: var(--color-text-tertiary);
  }
  .bcn-ev-entry__mocktitle {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-200);
    margin: 0;
    font-size: var(--type-size-200, 0.9375rem);
    font-weight: var(--font-weight-semibold);
    line-height: 1.35;
    color: var(--color-text-primary);
  }
  .bcn-ev-entry__mockmeta {
    margin: 2px 0 0;
    color: var(--color-text-secondary);
  }
  .bcn-ev-entry__mockact {
    margin-top: var(--spacing-300);
  }

  .bcn-ev-entry__rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-150);
  }
  .bcn-ev-entry__row {
    display: flex;
    align-items: center;
    gap: var(--spacing-200);
    min-width: 0;
    font-size: var(--type-size-150, 0.875rem);
    color: var(--color-text-primary);
  }
  /* A checked box, drawn rather than interactive — this is a picture of another screen. */
  .bcn-ev-entry__check {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    border-radius: var(--radius-100);
    background: var(--color-primary);
    color: var(--color-text-inverse);
  }
  .bcn-ev-entry__rowname {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .bcn-ev-entry__act {
    margin-top: var(--spacing-100);
  }
</style>
