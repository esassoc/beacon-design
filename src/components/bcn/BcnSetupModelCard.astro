---
// <BcnSetupModelCard> — one of the two Component Setup models, presented as a
// door rather than a description.
//
// The models themselves are drawers, so a comparison page has nothing visible to
// look at until one is opened. This card is what stands in for a model on the
// page: its name, the bet it makes in one sentence, the handful of moves that
// distinguish it, and the button that actually opens it. Two of these side by
// side ARE the comparison section.
//
// Deliberately symmetrical. Both cards get the same shape, the same amount of
// room, and the same button weight, because a card that looks more finished
// wins arguments it has not earned. Neither is marked recommended.
//
// bcn-lego-checked: esa-card is the shell, esa-button is the door, esa-badge is
// the model letter. Checked Ecology for a "feature card / option card" lego
// (esa-card + esa-button is exactly it, which is why this composes rather than
// invents) and Beacon prod (no comparison surface exists). bcn-setup-model-card
// is the reusable home; its only CSS is the moves list and the equal-height rule.
import EsaCard from '@esa/ecology/esa-card.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaBadge from '@esa/ecology/esa-badge.astro';

interface Props {
  /** 'A' / 'B' — the letter used to refer to the model everywhere else on the page. */
  letter: string;
  name: string;
  /** The bet this model makes, in one sentence. */
  thesis: string;
  /** The three or four moves that distinguish it. Terse — this is not a feature list. */
  moves: string[];
  /** DOM id of the drawer this card opens. */
  opens: string;
  cta: string;
}

const { letter, name, thesis, moves, opens, cta } = Astro.props;
---

<EsaCard variant="outlined" padding="spacious">
  <div class="bcn-smc stack" data-gap="sm">
    <div class="cluster" data-gap="xs" data-align="center">
      <EsaBadge value={`Model ${letter}`} variant="secondary" size="sm" />
      <h3 class="type-card-title bcn-smc__name">{name}</h3>
    </div>

    <p class="type-body bcn-smc__thesis">{thesis}</p>

    <ul class="bcn-smc__moves">
      {moves.map((m) => <li class="bcn-smc__move">{m}</li>)}
    </ul>

    <div class="bcn-smc__foot">
      <span data-opens={opens}>
        <EsaButton color="primary" icon="external-link">{cta}</EsaButton>
      </span>
    </div>
  </div>
</EsaCard>

<style>
  /* Both cards hold the same height so neither reads as the fuller answer, and
     the button sits on a shared baseline. */
  .bcn-smc {
    height: 100%;
  }
  .bcn-smc__name {
    margin: 0;
  }
  .bcn-smc__thesis {
    margin: 0;
    color: var(--color-text-secondary);
    max-width: 60ch;
  }
  .bcn-smc__moves {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .bcn-smc__move {
    position: relative;
    padding: var(--spacing-200) 0 var(--spacing-200) var(--spacing-400);
    font-size: var(--type-size-150, 0.875rem);
    line-height: 1.5;
    color: var(--color-text-secondary);
  }
  .bcn-smc__move + .bcn-smc__move {
    border-top: 1px solid var(--color-border-light);
  }
  /* A dot marks the item; the row carries no colored edge. */
  .bcn-smc__move::before {
    content: '';
    position: absolute;
    left: var(--spacing-150);
    top: 1.1em;
    width: 5px;
    height: 5px;
    border-radius: var(--radius-full);
    background: var(--color-text-muted);
  }
  .bcn-smc__foot {
    margin-top: auto;
    padding-top: var(--spacing-300);
  }
</style>
