---
// <BcnSetupWorkspace> — Applicable Commitments: the wide side drawer in which a
// person decides which of the project's commitments apply to THIS component.
//
// BASELINE: what shipped (BCN-1629 / BCN-1636, Sept 2026), ported faithfully so the
// setup below has the real surface to sit on:
//   · Three views, Needs a decision / Applied / Dismissed, each counted off the rows.
//   · One header band: the figures on the left, the View toggle on the right (BCN-1721).
//   · One unlabelled filter row: search, Source document, Requirement type, Species,
//     and Clear all only while a filter is active.
//   · EVERY DECISION IS WRITTEN ON CLICK. Apply and Dismiss ask for an optional
//     rationale and then write; Undo clears the decision at once; a batch Undo asks
//     first. The drawer has one Close and nothing to save — undo is the safety net
//     (the epic overrode the staged Save/Cancel the prototype first carried).
//   · A batch rationale warns how many existing rationales it would overwrite.
//
// WHAT SETUP ADDS (the component-applicability-setup prototype):
//   · The list is the component's SCOPE: its mapped source documents' commitments
//     (every source while none is mapped, which is prod today), plus anything already
//     decided by hand.
//   · An undecided commitment the setup recommends out carries its reason on the row,
//     and the list header offers to dismiss every recommended one in view at once.
//     Nothing is dismissed until a person clicks.
//   · A dismissal accepted from a recommendation keeps its reason. When setup changes
//     and the reason no longer holds, the row comes back to Needs a decision and says
//     what it was dismissed for.
//
// Every row is SERVER-RENDERED and hidden; setup-workspace.ts reveals, hides and
// re-labels them from the shared applicability store. Nothing builds markup at runtime.
//
// Requirement type and species are FILTERS ONLY, never on the card or the preview
// (handoff decision, 2026-08-17). The recommendation's reason is the one exception,
// because it is the decision's own justification, not decoration.
//
// bcn-lego-checked: esa-side-dialog is the drawer, esa-button-toggle the view pivot,
// BcnFilterBar + esa-filter-dropdown + esa-text-field the filter row, esa-checkbox the
// selector, esa-badge the decision chips, esa-icon-button + esa-tooltip the row
// decisions, esa-button every other action, esa-dialog + esa-textarea + esa-alert-box
// the rationale prompt, esa-empty-state both empty states, esa-progress-bar the decided
// share, BcnCommitmentBadge every code, BcnKeyValue every fact. Not a lego, so built
// here: the selectable list row (no esa- selectable data row; prod's is a bespoke row
// too), the list header's selection actions, and the two-pane drawer geometry.
// bcn-setup-workspace is the reusable home for all three.
import EsaProgressBar from '@esa/ecology/esa-progress-bar.astro';
import EsaBadge from '@esa/ecology/esa-badge.astro';
import EsaIcon from '@esa/ecology/esa-icon.astro';
import EsaIconButton from '@esa/ecology/esa-button.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaEmptyState from '@esa/ecology/esa-empty-state.astro';
import EsaAlertBox from '@esa/ecology/esa-alert-box.astro';
import BcnFilterBar from './BcnFilterBar.astro';
import BcnCommitmentBadge from './BcnCommitmentBadge.astro';
import BcnKeyValue from './BcnKeyValue.astro';
import {
  SETUP_COMMITMENTS,
  SETUP_TOTALS,
  DECIDED_PERCENT,
  SOURCE_BY_ID,
  fmtDate,
} from '../../data/component-commitments';

interface Props {
  id?: string;
  componentName: string;
  heading?: string;
}
const { id = 'bcn-setup-workspace', componentName, heading = 'Applicable Commitments' } = Astro.props;

/** Not in esa-icon's registry; passed through its `paths` escape hatch. */
const CLIPBOARD_CHECK =
  '<rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="m9 14 2 2 4-4"/>';

const ACTION_TYPE_LABEL: Record<string, string> = {
  tracking: 'Tracking',
  monitoring: 'Monitoring',
  reporting: 'Reporting',
};
const plural = (n: number, one: string, many = `${one}s`) => (n === 1 ? one : many);
const reqCount = (n: number) => `${n} ${plural(n, 'requirement')}`;
---

<esa-side-dialog id={id} class="bcn-sw" size="lg" position="right" heading={heading} data-setup-workspace>
  <div slot="header" class="bcn-sw__head">
    <EsaIcon name="clipboard-check" paths={CLIPBOARD_CHECK} size="lg" />
    <h2 class="bcn-sw__headtitle">{heading}</h2>
    <EsaBadge value={componentName} variant="secondary" size="sm" />
  </div>

  <div class="bcn-sw__body">
    {/* One header band (prod BCN-1721): figures left, View right. */}
    <header class="bcn-sw__lead">
      <div class="bcn-sw__figures">
        <p class="bcn-sw__figure">
          <span class="bcn-sw__figval" data-sw-fig="undecided">{SETUP_TOTALS.undecided}</span>
          <span class="bcn-sw__figlabel">Need a decision</span>
        </p>
        <p class="bcn-sw__figure">
          <span class="bcn-sw__figval" data-sw-fig="decided">{`${SETUP_TOTALS.decided} of ${SETUP_TOTALS.total}`}</span>
          <span class="bcn-sw__figlabel">Decided</span>
        </p>
        <div class="bcn-sw__bar" data-sw-progress>
          <EsaProgressBar value={DECIDED_PERCENT} size="sm" showValue label="" />
        </div>
      </div>
      <esa-button-toggle data-sw-view size="md" label="View"></esa-button-toggle>
    </header>

    <div class="bcn-sw__controls">
      <BcnFilterBar filtersLabel="" searchPlacement="filters" compact>
        <span slot="search" class="bcn-sw__search">
          <esa-text-field data-sw-search size="sm" placeholder="Search commitments…" aria-label="Search commitments"></esa-text-field>
        </span>
        <esa-filter-dropdown data-sw-facet="source" name="source" label="Source Document" multiple size="sm"></esa-filter-dropdown>
        <esa-filter-dropdown data-sw-facet="type" name="type" label="Requirement Type" multiple size="sm"></esa-filter-dropdown>
        <esa-filter-dropdown data-sw-facet="species" name="species" label="Species" multiple size="sm"></esa-filter-dropdown>
        <span slot="actions" data-sw-clear hidden>
          <EsaButton size="sm" variant="ghost">Clear all</EsaButton>
        </span>
      </BcnFilterBar>
    </div>

    <div class="bcn-sw__panes">
      <section class="bcn-sw__pane bcn-sw__pane--list" aria-label="Commitments in view">
        <div class="bcn-sw__listhead">
          <esa-checkbox size="sm" data-sw-check-all aria-label="Select every commitment in view"></esa-checkbox>
          <span class="bcn-sw__listcount" data-sw-listcount></span>
          <span class="bcn-sw__listacts" data-sw-bulk hidden>
            <EsaButton size="sm" variant="primary" data-sw-bulk-apply>Apply</EsaButton>
            <EsaButton size="sm" variant="ghost" appearance="outline" data-sw-bulk-dismiss>Dismiss</EsaButton>
            <EsaButton size="sm" variant="ghost" appearance="outline" data-sw-bulk-undo>Undo</EsaButton>
            <EsaButton size="sm" variant="ghost" data-sw-bulk-clear>Clear</EsaButton>
          </span>
          {/* The setup's one door in the drawer: every recommended commitment in view,
              dismissed with its own reason, in one click. Only in Needs a decision, only
              while there are any. */}
          <span class="bcn-sw__listacts" data-sw-accept hidden>
            <EsaButton size="sm" variant="ghost" appearance="outline" data-sw-accept-all>
              <span data-sw-accept-label>Dismiss recommended</span>
            </EsaButton>
          </span>
        </div>

        <div class="bcn-sw__scroll" data-sw-scroll>
          <ul class="bcn-sw__rows" data-sw-rows>
            {
              SETUP_COMMITMENTS.map((c) => (
                <li class="bcn-sw-row" data-sw-row={c.id} data-decision={c.decision ?? ''} hidden>
                  <span class="bcn-sw-row__check">
                    <esa-checkbox size="sm" data-sw-check={c.id} aria-label={`Select ${c.code}`} />
                  </span>
                  <span class="bcn-sw-row__content">
                    <span class="bcn-sw-row__top">
                      <button type="button" class="bcn-sw-row__hit" aria-label={`Show ${c.code} ${c.title} in the preview`}>
                        <span class="bcn-sw-row__titleline">
                          <BcnCommitmentBadge code={c.code} size="sm" />
                          <span class="bcn-sw-row__name" title={c.title} data-sw-name>{c.title}</span>
                        </span>
                      </button>
                      <span class="bcn-sw-row__marks">
                        <span class="bcn-sw-row__state bcn-sw-row__state--applied">
                          <esa-tooltip text="Applied" position="top" data-sw-tip="applied">
                            <EsaBadge value="Applied" size="sm" />
                          </esa-tooltip>
                        </span>
                        <span class="bcn-sw-row__state bcn-sw-row__state--dismissed">
                          <esa-tooltip text="Dismissed" position="top" data-sw-tip="dismissed">
                            <EsaBadge value="Dismissed" size="sm" />
                          </esa-tooltip>
                        </span>
                      </span>
                      <span class="bcn-sw-row__acts">
                        <span class="bcn-sw-row__act bcn-sw-row__act--apply">
                          <esa-tooltip text="Apply to this component" position="top">
                            <span data-sw-apply={c.id}>
                              <EsaIconButton variant="chrome" iconOnly icon="check" label={`Apply ${c.code}`} size="sm" />
                            </span>
                          </esa-tooltip>
                        </span>
                        <span class="bcn-sw-row__act bcn-sw-row__act--dismiss">
                          <esa-tooltip text="Not applicable" position="top">
                            <span data-sw-dismiss={c.id}>
                              <EsaIconButton variant="chrome" iconOnly icon="x" label={`Dismiss ${c.code}`} size="sm" />
                            </span>
                          </esa-tooltip>
                        </span>
                        <span class="bcn-sw-row__act bcn-sw-row__act--undo">
                          <esa-tooltip text="Undo this decision" position="top">
                            <span data-sw-undo={c.id}>
                              <EsaIconButton variant="chrome" iconOnly icon="rotate-ccw" label={`Undo ${c.code}`} size="sm" />
                            </span>
                          </esa-tooltip>
                        </span>
                      </span>
                    </span>
                    {/* The setup's word on this row: why it's recommended out, or what it was
                        dismissed for before setup changed. Empty, and hidden, otherwise. */}
                    <span class="bcn-sw-row__note" data-sw-note hidden></span>
                    <span class="bcn-sw-row__flag" data-sw-flag hidden>
                      <EsaIcon name="triangle-alert" size="xs" />
                      <span data-sw-flag-text></span>
                    </span>
                  </span>
                </li>
              ))
            }
          </ul>

          <div class="bcn-sw__none" data-sw-none hidden>
            <EsaEmptyState title="No commitments match these filters" size="sm" />
          </div>
        </div>
      </section>

      <section class="bcn-sw__pane bcn-sw__pane--preview" aria-label="Selected commitment">
        <div class="bcn-sw__scroll bcn-sw__scroll--pad">
          <div class="bcn-sw__nopreview" data-sw-nopreview>
            <EsaEmptyState title="Select a commitment to preview it" size="sm" />
          </div>

          {
            SETUP_COMMITMENTS.map((c) => (
              <article class="bcn-sw-prev" data-sw-preview={c.id} hidden>
                <header class="bcn-sw-prev__head">
                  <BcnCommitmentBadge code={c.code} />
                  <h3 class="bcn-sw-prev__title">{c.title}</h3>
                </header>

                <p class="bcn-sw-prev__doc">{c.text}</p>

                <div class="bcn-sw-prev__facts">
                  <BcnKeyValue label="Source document" value={SOURCE_BY_ID[c.sourceId]?.name} />
                  <BcnKeyValue label="Requirements" value={reqCount(c.requirements.length)} />
                  <BcnKeyValue label="Added to the project" value={fmtDate(c.addedOn)} />
                </div>

                {/* The recommendation, when there is one: its reasons and the one-click
                    way to accept it. Toggled and filled by the controller. */}
                <section class="bcn-sw-prev__rec" data-sw-prev-rec hidden>
                  <h4 class="bcn-sw-prev__efftitle" data-sw-prev-rectitle>Recommended not applicable</h4>
                  <ul class="bcn-sw-prev__reasons" data-sw-prev-reasons></ul>
                  <span data-sw-prev-accept={c.id}>
                    <EsaButton size="sm" variant="ghost" appearance="outline">Dismiss with This Reason</EsaButton>
                  </span>
                </section>

                <section class="bcn-sw-prev__effect" data-sw-prev-effect hidden={c.actions.length === 0}>
                  <h4 class="bcn-sw-prev__efftitle">
                    {`Creates ${c.actions.length} ${plural(c.actions.length, 'action')} on this component`}
                  </h4>
                  <ul class="bcn-sw-prev__actions">
                    {c.actions.map((a) => (
                      <li class="bcn-sw-prev__action">
                        <BcnCommitmentBadge code={a.code} size="sm" />
                        <span class="bcn-sw-prev__actname">{a.name}</span>
                        <span class="bcn-sw-prev__acttype">
                          <EsaBadge value={ACTION_TYPE_LABEL[a.type] ?? a.type} size="sm" />
                        </span>
                      </li>
                    ))}
                  </ul>
                </section>

                <section class="bcn-sw-prev__decision" data-sw-prev-decision hidden>
                  <BcnKeyValue label="Decision">
                    <span class="bcn-sw-prev__decval" data-sw-prev-decval />
                  </BcnKeyValue>
                  <span data-sw-prev-ratwrap>
                    <BcnKeyValue label="Rationale">
                      <span class="bcn-sw-prev__decval" data-sw-prev-rationale />
                    </BcnKeyValue>
                  </span>
                </section>
              </article>
            ))
          }
        </div>
      </section>
    </div>
  </div>

  <div slot="footer" class="bcn-sw__foot">
    <span data-sw-close>
      <EsaButton variant="ghost" appearance="outline">Close</EsaButton>
    </span>
  </div>
</esa-side-dialog>

{/* The confirm prompt: rationale for Apply / Dismiss (single or batch), a plain
    confirm for a batch Undo or for dismissing every recommended commitment. */}
<esa-dialog id={`${id}-rationale`} class="bcn-sw-rationale" heading="Apply commitment" data-sw-dialog>
  <div class="bcn-sw-rationale__body">
    <p class="bcn-sw-rationale__what typography-body-md" data-sw-dialog-what></p>
    <div class="bcn-sw-rationale__warn" data-sw-dialog-warn hidden>
      <EsaAlertBox variant="warning" title="This replaces rationales already on record">
        <span data-sw-dialog-warn-text></span>
      </EsaAlertBox>
    </div>
    <span data-sw-dialog-ratwrap>
      <esa-textarea data-sw-dialog-rationale label="Rationale (optional)" rows="3"></esa-textarea>
    </span>
  </div>
  <div slot="footer" class="bcn-sw-rationale__foot">
    <EsaButton variant="primary" data-sw-dialog-confirm>Apply</EsaButton>
    <EsaButton variant="ghost" appearance="outline" data-sw-dialog-cancel>Cancel</EsaButton>
  </div>
</esa-dialog>

<script>
  import '@esa/ecology/esa-side-dialog';
  import '@esa/ecology/esa-dialog';
  import '@esa/ecology/esa-button-toggle';
  import '@esa/ecology/esa-filter-dropdown';
  import '@esa/ecology/esa-checkbox';
  import '@esa/ecology/esa-text-field';
  import '@esa/ecology/esa-tooltip';
  import '@esa/ecology/esa-textarea';
  import { initSetupWorkspace } from './setup-workspace';
  initSetupWorkspace();
</script>

<style>
  .bcn-sw {
    --side-dialog-width-lg: 1180px;
    --z-modal-backdrop: 1300;
    --z-modal: 1301;
    --side-dialog-backdrop-filter: blur(2px);
    /* Every small CONTROL here reads 14px, not 12px. */
    --typography-label-xs-font-size: var(--font-size-150);
  }

  .bcn-sw__body {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-400);
    height: 100%;
    min-height: 0;
    color: var(--color-content-default);
  }

  .bcn-sw__head {
    display: flex;
    align-items: center;
    gap: var(--spacing-300);
    min-width: 0;
  }
  .bcn-sw__headtitle {
    margin: 0;
    font-size: var(--font-size-400);
    font-weight: var(--typography-font-weight-semibold);
    color: var(--color-content-default);
    white-space: nowrap;
  }
  .bcn-sw__head :global(.esa-icon) { color: var(--color-content-default-secondary); }
  .bcn-sw__head :global(.esa-badge) {
    background: transparent;
    color: var(--color-content-default-secondary);
    border: 1px solid var(--color-border-default);
    font-weight: var(--typography-font-weight-medium);
  }

  .bcn-sw__search {
    display: inline-flex;
    width: 100%;
  }
  .bcn-sw__search :global(esa-text-field) { width: 100%; }

  /* ── One header band: figures cluster left, View right ── */
  .bcn-sw__lead {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--spacing-400);
  }
  .bcn-sw__figures {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--spacing-500);
  }
  .bcn-sw__figure {
    margin: 0;
    display: inline-flex;
    align-items: baseline;
    gap: var(--spacing-200);
  }
  .bcn-sw__figval {
    font-size: var(--font-size-500);
    font-weight: var(--typography-font-weight-semibold);
    font-variant-numeric: tabular-nums;
    color: var(--color-content-default);
  }
  .bcn-sw__figlabel {
    font-size: var(--font-size-150);
    color: var(--color-content-default-secondary);
  }
  .bcn-sw__bar {
    width: 140px;
  }

  .bcn-sw__controls {
    flex: none;
  }

  /* ── The two panes: a GRID, so each pane scrolls on its own ── */
  .bcn-sw__panes {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    gap: var(--spacing-400);
    flex: 1;
    min-height: 0;
    align-items: stretch;
  }
  .bcn-sw__pane {
    display: flex;
    flex-direction: column;
    min-height: 0;
    min-width: 0;
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-200);
    background: var(--color-background-elevation-raised);
  }
  .bcn-sw__pane--list {
    position: relative;
    background: var(--color-background-elevation-sunken);
    overflow: hidden;
  }
  .bcn-sw__scroll {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: var(--spacing-300);
  }
  .bcn-sw__scroll--pad {
    padding: var(--spacing-500);
  }
  .bcn-sw__rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-200);
  }
  .bcn-sw__none[hidden],
  .bcn-sw__nopreview[hidden] {
    display: none;
  }

  /* ── A row: a checkbox gutter, then the title line and an optional note ── */
  .bcn-sw-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    column-gap: var(--spacing-400);
    padding: var(--spacing-250, 0.625rem) var(--spacing-300);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-200);
    background: var(--color-background-elevation-raised);
    cursor: pointer;
    transition: border-color 120ms ease, background 120ms ease;
  }
  .bcn-sw-row[hidden] { display: none; }
  .bcn-sw-row:hover { border-color: var(--color-border-default-strong); }
  .bcn-sw-row[data-active] {
    border-color: var(--color-background-brand);
    background: color-mix(in srgb, var(--color-background-brand) 5%, var(--color-background-elevation-raised));
  }
  .bcn-sw-row__content {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .bcn-sw-row__top {
    display: flex;
    align-items: center;
    gap: var(--spacing-250, 0.625rem);
    min-width: 0;
  }
  .bcn-sw-row__check {
    display: inline-flex;
    align-items: center;
    min-height: 1.75rem;
    cursor: default;
  }
  .bcn-sw-row__hit {
    flex: 1;
    min-width: 0;
    display: flex;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .bcn-sw-row__hit:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring-color);
    outline-offset: 2px;
    border-radius: var(--radius-100);
  }
  .bcn-sw-row__titleline {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    gap: var(--spacing-200);
    min-width: 0;
  }
  .bcn-sw-row__name {
    min-width: 0;
    font-size: var(--font-size-150);
    font-weight: var(--typography-font-weight-semibold);
    line-height: 1.35;
    color: var(--color-content-default);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .bcn-sw-row__name :global(mark) {
    background: var(--color-background-utility-warning-subtle, color-mix(in srgb, var(--color-background-utility-warning) 25%, transparent));
    color: inherit;
    border-radius: 2px;
  }
  /* The setup's note: one line, 13px, secondary — meta under the title. */
  .bcn-sw-row__note {
    font-size: 0.8125rem;
    line-height: 1.35;
    color: var(--color-content-default-secondary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .bcn-sw-row__note[hidden] { display: none; }
  /* A setup apply the current setup would now dismiss: a warning line, the apply stands. */
  .bcn-sw-row__flag {
    display: flex;
    align-items: center;
    gap: var(--spacing-100);
    min-width: 0;
    font-size: 0.8125rem;
    line-height: 1.35;
    color: var(--color-content-utility-warning);
  }
  .bcn-sw-row__flag > span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .bcn-sw-row__flag[hidden] { display: none; }
  .bcn-sw-row__marks {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-150);
  }
  .bcn-sw-row__state {
    flex: none;
    display: none;
  }
  .bcn-sw-row[data-decision='applied'] .bcn-sw-row__state--applied,
  .bcn-sw-row[data-decision='dismissed'] .bcn-sw-row__state--dismissed {
    display: inline-flex;
  }
  .bcn-sw-row__state--applied :global(.esa-badge) {
    --badge-bg: transparent;
    --badge-text-color: var(--color-background-brand);
    border: 1px solid var(--color-border-brand, var(--color-border-default));
    font-weight: var(--typography-font-weight-medium);
  }
  .bcn-sw-row__state--dismissed :global(.esa-badge) {
    --badge-bg: transparent;
    --badge-text-color: var(--color-content-default-secondary);
    border: 1px solid var(--color-border-default);
    font-weight: var(--typography-font-weight-medium);
  }
  /* Row decisions: revealed on hover or focus, space reserved so nothing shifts (prod). */
  .bcn-sw-row__acts {
    display: flex;
    align-items: center;
    gap: var(--spacing-150);
    margin-left: auto;
    flex: none;
    visibility: hidden;
    cursor: default;
  }
  .bcn-sw-row:hover .bcn-sw-row__acts,
