---
// <BcnComponentHeader> — the component dashboard's identity band, and the
// deliberately QUIETER sibling of BcnProjectHeader. Same job ("where am I?"),
// one level down the tree: the component's mark beside its name as the page's
// sole H1, with its status and dates worn as facts. That is the whole band.
//
// WHAT IT DELIBERATELY DOES NOT CARRY (review, 2026-08-13). It opened with a
// T·M·R pulse strip and an "Edit component" button; both are gone. The pulse
// strip restated the Tracking / Monitoring / Reporting cards sitting directly
// beneath it — text about the page rather than of it — and those cards carry the
// same figures with more precision. The pulses still earn their place on the
// project dashboard's component boxes, where the cards they summarize are not on
// screen. "Edit component" pointed at the form the rail's Component info panel
// already opens. What is left is what only the header can say.
//
// WHY THERE IS NO COVER PHOTO. The project header opens with a full-bleed hero
// band; this one is a flat white bar. That is a design decision, not a missing
// feature (2026-08-13 design call): a project has ONE cover somebody will
// genuinely go find a photo for, but a project carries two dozen components and
// "what's a good picture for the Bouldin Island Launch Shaft?" is a question
// with no good answer — the field stays empty and every component page looks
// identical. So a component's landmark is its MARK (glyph × swatch, see
// src/data/entity-marks.ts): two clicks, always legible, impossible to get
// wrong, and readable at any size. A quieter band also keeps the hierarchy
// honest — the project is the place, the component is a room in it.
//
// Rendered into PageLayout's `bleed` slot with `hideTitleRow`, so this
// component owns the page's ONLY <h1> — same contract as BcnProjectHeader.
//
// THE MARK WEARS THE PROJECT SEAL'S TREATMENT (review, 2026-08-13): a circle
// with a white ring and a soft lift, the same idiom as BcnProjectHeader's org
// seal, so a project and a component read as one pattern a level apart.
//
// It is 72px rather than the seal's 92px, and that is the faithful choice, not a
// compromise. The project's seal carries `margin-top: -46px` to overlap the hero
// photo, so only 46px of it ever sits inside the white band — less than the text
// beside it. There is no hero here to overlap, so a 92px mark sat fully inside
// the band and became the tallest thing in it: the band's height stopped being
// set by its content, and the text floated centred with dead air above and below.
// At 72px the text is the tallest element again, exactly as on the project header,
// and the mark still reads larger in-band than the project's 46px sliver.
//
// Composes: BcnEntityLogo (the mark), BcnStatusChip (status), EsaIconButton
// (logo edit + star) + type roles. The band and the fact line are the only
// composition left inside this component.
//
// bcn-lego-checked: no esa-* lego is an entity identity header — esa-page-header
// is a title + lede + actions row with no mark and no status/date facts, and
// esa-card is a static shell. Checked Beacon (prod's component page is a plain
// title over a tab strip — this is the redesign). Checked the spoke:
// BcnProjectHeader is the PROJECT-level band (hero cover + org seal) and
// BcnComponentSummary is the project-wide roll-up, so neither covers a single
// component's identity. bcn-component-header is the reusable home; every control
// inside it is a lego.
import BcnEntityLogo from './BcnEntityLogo.astro';
import BcnStatusChip from './BcnStatusChip.astro';
import EsaIconButton from '@esa/ecology/esa-button.astro';
import type { ComponentRecord } from '../../data/component-detail';

interface Props {
  component: ComponentRecord;
  /** Rendered as pressed when the user has starred this component (per-user starring, BCN-1576). */
  starred?: boolean;
}
// No `siblings` prop (wayfinding is in the breadcrumb bar) and no `pulse` prop
// (the module cards below carry it) — both cut at review.
const { component, starred = false } = Astro.props;

// Deterministic ISO → display date (no Intl, no Date.now — every demo run
// renders the same string).
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const fmtDate = (iso: string): string => {
  const [y, m, d] = iso.split('-');
  return `${MONTHS[Number(m) - 1]} ${Number(d)}, ${y}`;
};

// ComponentStatus.Name → chip key + token reference. Deliberately NOT the
// green/amber/red urgency palette. Amber means "attention" on the Tracking /
// Monitoring / Reporting cards further down this page, so an Active component
// must not wear the same amber and imply a problem. Active reads as the neutral
// current state (brand primary, like the project's phase chip), Complete is the
// one status that earns success green, and On Hold recedes.
const STATUS_TONE: Record<ComponentRecord['status'], { key: string; hex: string }> = {
  Active: { key: 'active', hex: 'var(--color-background-brand)' },
  'On Hold': { key: 'on-hold', hex: 'var(--bcn-status-not-started)' },
  Complete: { key: 'complete', hex: 'var(--bcn-status-completed)' },
};
const tone = STATUS_TONE[component.status];

const starLabel = starred ? `Unstar ${component.name}` : `Star ${component.name}`;
---

<section class="bcn-chd" aria-label={`${component.name} — component home`}>
  <!-- WAYFINDING MOVED OUT (review, 2026-08-13). Both the way back up the tree and
       the prev/next walk now live in the breadcrumb bar above this band: the trail
       carries the hierarchy (project › All Components › this one) and bcn-sibling-nav
       sits at its end, which is where prod puts record navigation — breadcrumbs.component
       imports <commitment-navigation>. Keeping a second copy here would give one
       action two affordances on one screen. -->
  <div class="bcn-chd__id">
    <!-- The mark IS the cover here. Editing it stays on the page (product
         meeting, 2026-08-04: "mouse over that header area … a little change
         logo just to keep people in one spot"). -->
    <span class="bcn-chd__markwrap">
      <BcnEntityLogo mark={component.mark} size="xl" variant="seal" label={`${component.name} mark`} />
      <!-- The hook lives on the WRAPPER: esa-icon-button has a closed prop set
           and drops unknown attributes, so a data-* on the lego goes nowhere.
           The click bubbles out of the button to this span. -->
      <span class="bcn-chd__logo-edit" data-logo-edit>
        <EsaIconButton variant="chrome" iconOnly icon="pencil" label="Change component logo" size="sm" />
      </span>
    </span>

    {/* Name, state, and the personal star — that is the whole band now. The stored
        description and the start / expected-end dates were here and were cut at
        review (2026-08-13): the rail's Component details card carries all three,
        and a header that repeats the card beside it is a tagline with a bigger
        font. The star sits immediately after the status chip rather than pushed to
        the far edge, so the three things about THIS component read as one group. */}
    <div class="bcn-chd__ident">
      <div class="bcn-chd__title-row">
        <h1 class="bcn-chd__name typography-heading-lg">{component.name}</h1>
        <BcnStatusChip status={tone.key} label={component.status} hex={tone.hex} />
        <span class="bcn-chd__star" data-star-toggle data-pressed={String(starred)} data-name={component.name}>
          <EsaIconButton variant="chrome" iconOnly icon="star" label={starLabel} size="md" />
        </span>
      </div>
    </div>

  </div>

  <!-- The T·M·R pulse strip that sat here was cut at review (2026-08-13). The
       Tracking / Monitoring / Reporting cards are the next thing on the page and
       carry the same figures with more precision — the strip restated the table
       below it, which is exactly the kind of text-about-the-page the house rules
       ban. The pulses still earn their place on the project dashboard's component
       boxes, where the cards they summarize are NOT on screen. -->
</section>

<script>
  // Star toggle — prototype behavior, identical to the starred-components cards
  // (dev: writes the per-user star). aria-pressed is set here rather than in the
  // markup because esa-icon-button owns its own attributes.
  document.querySelectorAll<HTMLElement>('[data-star-toggle]').forEach((wrap) => {
    const btn = wrap.querySelector('button');
    if (!btn) return;
    const name = wrap.dataset.name ?? 'this component';
    const apply = (pressed: boolean) => {
      btn.setAttribute('aria-pressed', String(pressed));
      const label = pressed ? `Unstar ${name}` : `Star ${name}`;
      btn.setAttribute('aria-label', label);
      btn.setAttribute('title', label);
    };
    apply(wrap.dataset.pressed === 'true');
    btn.addEventListener('click', () => apply(btn.getAttribute('aria-pressed') !== 'true'));
  });

  // Logo edit → the picker the PAGE mounts (BcnLogoPicker at #bcn-logo-picker).
  // Setting `open` covers an esa-dialog/esa-side-dialog host; the bubbling event
  // is the contract for any other host that wants to intercept it.
  document.querySelectorAll<HTMLElement>('[data-logo-edit]').forEach((wrap) => {
    wrap.addEventListener('click', () => {
      const picker = document.getElementById('bcn-logo-picker') as (HTMLElement & { open?: boolean }) | null;
      if (picker) picker.open = true;
      document.dispatchEvent(new CustomEvent('bcn:edit-logo', { bubbles: true }));
    });
  });
</script>

<style>
  /* Full-bleed identity band: white surface, hairline base to part it from the
     gray canvas below. No cover photo — see the header note. */
  /* Vertical padding is symmetric and tight (review, 2026-08-13). It used to be
     16px top and 0 bottom, which was invisible: the 98px mark was the tallest
     child, so IT set the band height and the padding did nothing but push
     everything down. The mark is now 78px — shorter than the 83px text block — so
     the TEXT sets the height, the way it does on the project header, and this
     padding is the band's actual breathing room. */
  .bcn-chd {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-300);
    padding: var(--spacing-200) var(--spacing-600);
    background: var(--color-background-elevation-raised);
    border-bottom: 1px solid var(--color-border-default);
  }

  /* The eyebrow / wayfinding rules that lived here are gone with the markup —
     the breadcrumb bar owns both the way up and the prev/next walk now. */

  /* ── Identity row: mark, name, actions — vertically centred ──────────────── */
  .bcn-chd__id {
    display: flex;
    align-items: center;
    gap: var(--spacing-400);
    min-width: 0;
  }
  @media (max-width: 640px) {
    .bcn-chd__id {
      flex-wrap: wrap;
      gap: var(--spacing-300);
    }
  }

  /* The seal treatment (circle + white ring + soft lift) belongs to bcn-entity-logo's
     `seal` variant, not here — this wrapper only positions the hover edit chip. It
     used to carry the frame itself, which meant the picker's preview had to
     reproduce it and promptly diverged. */
  .bcn-chd__markwrap {
    position: relative;
    flex-shrink: 0;
    display: inline-flex;
  }
  /* Hover/keyboard-revealed logo edit — a chip on the mark's lower-right.
     :focus-within is the KEYBOARD path: the button stays in the tab order while
     transparent, so tabbing to it reveals it. A hover-only control here would be
     a keyboard trap (the gotcha recorded in the project-header handoff). */
  .bcn-chd__logo-edit {
    position: absolute;
    right: calc(var(--spacing-150) * -1);
    bottom: calc(var(--spacing-150) * -1);
    display: inline-flex;
    border-radius: var(--radius-full);
    background: var(--color-background-elevation-raised);
    border: 1px solid var(--color-border-default);
    color: var(--color-content-default-secondary);
    opacity: 0;
    transition: opacity 150ms ease;
  }
  .bcn-chd__markwrap:hover .bcn-chd__logo-edit,
  .bcn-chd__markwrap:focus-within .bcn-chd__logo-edit {
    opacity: 1;
  }
  /* Touch has no hover — the affordance would never appear. */
  @media (hover: none) {
    .bcn-chd__logo-edit {
      opacity: 1;
    }
  }

  .bcn-chd__ident {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-100);
    min-width: 0;
    flex: 1;
  }
  .bcn-chd__title-row {
    display: flex;
    align-items: center;
    gap: var(--spacing-300);
    flex-wrap: wrap;
    min-width: 0;
  }
  .bcn-chd__name {
    margin: 0;
    color: var(--color-content-default);
  }
  .bcn-chd__desc {
    margin: 0;
    font-size: var(--font-size-150);
    color: var(--color-content-default-secondary);
  }
  .bcn-chd__facts {
    display: flex;
    align-items: center;
    gap: var(--spacing-150);
    flex-wrap: wrap;
    margin: 0;
    font-size: var(--font-size-150);
    color: var(--color-content-default-tertiary);
  }
  .bcn-chd__fact-value {
    color: var(--color-content-default-secondary);
    font-weight: var(--typography-font-weight-medium);
  }
  .bcn-chd__dot-sep {
    color: var(--color-border-default-strong);
  }

  .bcn-chd__actions {
    display: flex;
    align-items: center;
    gap: var(--spacing-200);
    flex-shrink: 0;
    margin-left: auto;
  }
  /* Pressed = the user's own star (per-user, never a team designation). */
  .bcn-chd__star :global(button[aria-pressed='true']) {
    color: var(--color-background-utility-warning);
  }
  .bcn-chd__star :global(button[aria-pressed='true'] svg) {
    fill: currentColor;
  }

</style>
