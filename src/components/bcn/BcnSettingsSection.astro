---
// <BcnSettingsSection> — one section of the Unified Settings surface, rendered by
// its `kind`. Every section on the page is the same card shell; only the body
// anatomy changes:
//
//   rows       → a divided stack of <BcnSettingRow> (the setting-per-row anatomy)
//   collection → a records list, drawn one of exactly TWO ways, both of them delegated:
//                `presentation: 'grid'` — the pages that ARE ag-Grids in the real app —
//                hands the records to <BcnSettingsGrid> for sorting, per-column
//                filtering, and resize; `presentation: 'rows'` hands them to
//                <BcnRecordRows> for slim read-only rows with per-row actions and the
//                section's one edit modal. Nothing else: the semantic records table this
//                file used to draw was retired 2026-07-30, when every list on the surface
//                became one of those two. Either way a collection with no records renders
//                an esa-empty-state instead of an empty list, and one whose `total`
//                exceeds the records it holds says how much of the list it is showing.
//   pairs      → the Terminology anatomy: Entity / Singular / Plural, with the two
//                overrides as text fields whose PLACEHOLDER is the canonical term,
//                so a blank field shows the platform default in grey. The one table
//                left in this file, and a form grid rather than a records list.
//
// The shell is esa-card (outlined); `section.description` rides the card's own
// `subtitle` API so it renders under the title without extra chrome. The card
// itself can't take an id (esa-card's props are a closed set, no rest spread), so
// the `sec-<id>` anchor lives on a wrapping <section> — which also carries the
// scroll-margin the section nav needs when it jumps.
//
// bcn-lego-checked: this file draws no records list of its own any more — a collection is
// dispatched to <BcnSettingsGrid> or <BcnRecordRows>, which each carry their own lookup.
// What remains is the card shell and the PAIRS form grid, a semantic <table> because the
// hub ships no table lego (checked the full catalog: esa-card is a box, esa-link-column is
// a card of bare links, esa-collapsible is a single disclosure) and Terminology is a
// three-column form, not a records list — the same call BcnPrototypeIndex made for its
// index table. Everything else IS a lego: esa-card (shell), esa-button (add action),
// esa-text-field (terminology overrides), esa-empty-state (zero records). The CSS below is
// the pairs table's own glue plus the section anchor. bcn-settings-section is the
// reusable home.
import EsaCard from '@esa/ecology/esa-card.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaEmptyState from '@esa/ecology/esa-empty-state.astro';
import BcnSettingRow from './BcnSettingRow.astro';
import BcnSettingsGrid from './BcnSettingsGrid.astro';
import BcnRecordRows from './BcnRecordRows.astro';
import type { SettingsSection } from '../../data/settings-registry';

interface Props {
  section: SettingsSection;
}
const { section } = Astro.props;

// Anchor target for the section nav.
const anchorId = `sec-${section.id}`;

// A collection holding nothing shows the empty state; no list is drawn at all. That
// holds for the gridded pages too (People and Organizations are empty in the real
// tenant): AG Grid's no-rows overlay would sit in a tall blank body under a header of
// column names, which is exactly the raw treatment this page is arguing against.
const isEmpty = section.kind === 'collection' && section.records.length === 0;

// Where the real app ships an ag-Grid, so does this; everywhere else the records are slim
// rows. See the registry's `presentation` — there is no third answer.
const isGrid = section.kind === 'collection' && section.presentation === 'grid';

// The empty state's title is the section's own name — "People" → "No people yet".
const emptyTitle = `No ${section.title.toLowerCase()} yet`;

// The records shown are a sample only when the section says how many there really are.
const isSample =
  section.kind === 'collection' && section.total !== undefined && section.total > section.records.length;
---

<section id={anchorId} class="bcn-set">
  <EsaCard variant="outlined" title={section.title}>
    {section.description && <p class="bcn-set__desc typography-body-md">{section.description}</p>}
    {
      /* EVERY collection's add action sits in the card HEADER, right-aligned by
         esa-card's own actions slot (grids first, then the table sections joined them —
         Andy, 2026-07-30).

         The Astro quirk: a slot="" child registers the slot from its mere presence in
         the expression, so every other card grows an empty .esa-card__actions — an
         empty flex div in a header that is already space-between, no chrome and no
         height of its own. Tolerable here where the same quirk was NOT tolerable for
         the footer slot, which drew a filled band. Collection + addLabel is the only
         case that emits a button; data-settings-add rides it for page wiring. */
      section.kind === 'collection' && section.addLabel && (
        <EsaButton
          slot="actions"
          size="sm"
          variant="ghost"
          appearance="outline"
          icon="plus"
          data-settings-add={section.id}
        >
          {section.addLabel}
        </EsaButton>
      )
    }

    {
      section.kind === 'rows' && (
        <ul class="bcn-set__rows">
          {section.items.map((item) => (
            <li>
              <BcnSettingRow item={item} />
            </li>
          ))}
        </ul>
      )
    }

    {
      /* Size md, not sm: the lego's sm variant drops the title to 14px and the body
         copy to 12px, under this surface's 16px floor. */
      section.kind === 'collection' && isEmpty && (
        <EsaEmptyState title={emptyTitle} description={section.emptyText} />
      )
    }

    {section.kind === 'collection' && !isEmpty && isGrid && <BcnSettingsGrid section={section} />}

    {section.kind === 'collection' && !isEmpty && !isGrid && <BcnRecordRows section={section} />}

    {
      /* A tenant's real lists run to 75 users and 320 tags. Where the fixture holds a
         sample, the table says so rather than reading as the whole list. */
      section.kind === 'collection' && isSample && (
        <p class="bcn-set__count">
          Showing {section.records.length} of {section.total}
        </p>
      )
    }

    {
      section.kind === 'pairs' && (
        <div class="bcn-set__scroll">
          <table class="bcn-set__table">
            <thead>
              <tr>
                <th class="bcn-set__th" scope="col">
                  Entity
                </th>
                <th class="bcn-set__th" scope="col">
                  Singular
                </th>
                <th class="bcn-set__th" scope="col">
                  Plural
                </th>
              </tr>
            </thead>
            <tbody>
              {section.pairs.map((pair) => (
                <tr class="bcn-set__tr">
                  <th class="bcn-set__td bcn-set__td--lead" scope="row">
                    {pair.entity}
                  </th>
                  <td class="bcn-set__td bcn-set__td--field">
                    <esa-text-field
                      value={pair.singular ?? ''}
                      placeholder={pair.canonicalSingular}
                      aria-label={`${pair.entity} — singular`}
                    ></esa-text-field>
                  </td>
                  <td class="bcn-set__td bcn-set__td--field">
                    <esa-text-field
                      value={pair.plural ?? ''}
                      placeholder={pair.canonicalPlural}
                      aria-label={`${pair.entity} — plural`}
                    ></esa-text-field>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }

  </EsaCard>
</section>

<script>
  // esa-text-field is a Lit lego (.ts) — register the custom element.
  import '@esa/ecology/esa-text-field';
</script>

<style>
  /* bcn-lego-checked: the pairs table + divider glue ONLY (see the header note for why
     Terminology's form grid is a semantic <table>). No primitive is reinvented here —
     both records presentations moved out to their own components. */
  .bcn-set {
    display: block;
    /* The section nav jumps to #sec-<id>; keep the card clear of the sticky topbar. */
    scroll-margin-block-start: var(--spacing-600);
  }

  /* .esa-card__subtitle is esa-card's own header class; the lego sets its size and color
     but no leading, so the section's description inherits the page's relaxed 1.8. Tighten
     it to match the cells. esa-card exposes no subtitle token, so this re-skins the hub
     class directly — fenced to .bcn-set so no other card on the page is touched. */
  .bcn-set :global(.esa-card__subtitle) {
    line-height: 1.4;
  }

  /* ── rows: a divided stack. Each BcnSettingRow owns its own vertical rhythm;
     the <li> only carries the hairline between siblings. ── */
  .bcn-set__rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .bcn-set__rows > li + li {
    border-top: 1px solid var(--color-border-default-subtle);
  }

  /* ── pairs: a table that scrolls inside its own container when the three columns
     outgrow the card. ── */
  .bcn-set__scroll {
    overflow-x: auto;
  }
  .bcn-set__table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }

  .bcn-set__th {
    padding: 0 var(--spacing-400) var(--spacing-250);
    font-size: var(--font-size-150);
    font-weight: var(--typography-font-weight-semibold);
    color: var(--color-content-default-secondary);
    text-align: left;
    white-space: nowrap;
    border-bottom: 1px solid var(--color-border-default);
  }

  /* Cells carry the tenant's own terms, so they read as CONTENT in primary ink, not as
     secondary chrome. The tightened leading is between the ramp's tight (1.3) and normal
     (1.6) steps — neither lands where a dense data row wants to sit. */
  .bcn-set__td {
    padding: var(--spacing-250) var(--spacing-400);
    font-size: var(--font-size-200);
    line-height: 1.4;
    color: var(--color-content-default);
    text-align: left;
    vertical-align: middle;
  }
  .bcn-set__tr + .bcn-set__tr .bcn-set__td {
    border-top: 1px solid var(--color-border-default-subtle);
  }

  /* Flush the outer columns with the card's content edge. */
  .bcn-set__th:first-child,
  .bcn-set__td:first-child {
    padding-inline-start: 0;
  }
  .bcn-set__th:last-child,
  .bcn-set__td:last-child {
    padding-inline-end: 0;
  }

  /* The first column leads the row. */
  .bcn-set__td--lead {
    font-weight: var(--typography-font-weight-medium);
    color: var(--color-content-default);
    white-space: nowrap;
  }

  /* The section's own description — a stored registry field, and the reason this
     schema exists ("the real app ships almost no help text next to its settings").
     It moved out of esa-card's subtitle when that prop was deprecated (2026-08-16):
     a sentence has no field name, so it cannot be a meta pair, and it reads as the
     first thing in the body instead. */
  .bcn-set__desc {
    margin: 0 0 var(--spacing-400);
    color: var(--color-content-default-secondary);
  }

  /* How much of the list is on screen — a caption for the list above it, so it sits
     quiet: the 14px step, tertiary ink, no rule of its own. */
  .bcn-set__count {
    margin: var(--spacing-250) 0 0;
    font-size: var(--font-size-150);
    color: var(--color-content-default-tertiary);
  }

  /* Terminology override fields. */
  .bcn-set__td--field {
    min-width: 200px;
    padding-block: var(--spacing-250);
  }
  .bcn-set__td--field esa-text-field {
    display: block;
    width: 100%;
  }
</style>
