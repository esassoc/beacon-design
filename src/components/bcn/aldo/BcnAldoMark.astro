---
// <BcnAldoMark> — "Aldo", Beacon's help & guidance identity mark.
//
// Aldo is the friendly face of Beacon's whole help system, named after
// conservationist Aldo Leopold. The mark is "Eighty Years": the growth rings of a
// sawn oak, slightly off center, with one wedge cut out, after the Good Oak essay in
// A Sand County Almanac. It stands for the long record a compliance program keeps.
// White rings in a filled Aldo-green circle, the ONE badge that stands for guidance
// everywhere it appears: the help bar, the guidance drawer, the Aldo panel, the
// Help & Guidance hero. Aldo green (--bcn-aldo) is a deliberately distinct accent,
// never --color-background-brand, so the guide reads as its own presence.
// Chosen 2026-10-14 over the stock Lucide compass (review rounds 1 and 2).
//
// `variant="rings"` (2026-10-21, for the Guidance bar): the rings alone, no circle,
// stroked with a gradient from the hub's teal ramp and cropped to the rings so they
// fill the box. The gradient ends and the box size are hooks a host can re-point:
// --bcn-aldo-ring-from, --bcn-aldo-ring-to, --bcn-aldo-mark-size.
//
// Purely decorative (aria-hidden). It carries no interactivity of its own: a host
// wraps it in a button or link when the mark needs to be actionable.
//
// bcn-lego-checked: no esa-* lego is a branded identity badge. esa-avatar renders a
// PERSON (initials/photo); esa-badge and esa-icon-button are generic chrome; none
// carries a brand mark. Checked Beacon (no help-mark component exists). The rings are
// drawn on the circle's own 64 grid (inline SVG, not esa-icon's 24 grid) so they keep
// their proportion to the circle at every size; bcn-aldo-mark is their reusable home.

interface Props {
  /** sm=20px, md=40px, lg=64px. Default 'md'. */
  size?: 'sm' | 'md' | 'lg';
  /** Gentle pulse on the circle and a slow turn of the rings: Aldo at work. Default false. */
  animated?: boolean;
  /** 'badge' = white rings in the green circle (default); 'rings' = gradient rings alone. */
  variant?: 'badge' | 'rings';
}
const { size = 'md', animated = false, variant = 'badge' } = Astro.props;
const rings = variant === 'rings';
// Each instance's gradient needs its own id: two marks on a page share no defs.
const gradientId = `bcn-aldo-ring-${Math.random().toString(36).slice(2, 9)}`;
---

<span class="bcn-aldo-mark" data-size={size} data-variant={variant} data-animated={animated ? '' : undefined} aria-hidden="true">
  <svg
    class="bcn-aldo-mark__glyph"
    viewBox={rings ? '13 11 40 40' : '0 0 64 64'}
    fill="none"
    stroke={rings ? `url(#${gradientId})` : 'currentColor'}
    stroke-width="3.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    {
      rings && (
        <defs>
          <linearGradient id={gradientId} x1="14" y1="12" x2="52" y2="50" gradientUnits="userSpaceOnUse">
            <stop offset="0" class="bcn-aldo-mark__from" />
            <stop offset="1" class="bcn-aldo-mark__to" />
          </linearGradient>
        </defs>
      )
    }
    <path d="M47.59 23A18 18 0 1 1 31.37 14.01" />
    <path d="M43.05 25.55A12.3 12.3 0 1 1 31.97 19.41" />
    <path d="M38.52 28.1A6.6 6.6 0 1 1 32.57 24.8" />
    <circle cx="33.2" cy="31.1" r="2" fill={rings ? `url(#${gradientId})` : 'currentColor'} stroke="none" />
  </svg>
</span>

<style>
  .bcn-aldo-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border-radius: var(--radius-full);
    background: var(--bcn-aldo);
    color: var(--color-content-default-knockout);
    line-height: 0;
  }

  /* The circle per step; the rings fill it on its own 64 grid. */
  .bcn-aldo-mark[data-size='sm'] { width: 20px; height: 20px; }
  .bcn-aldo-mark[data-size='md'] { width: 40px; height: 40px; }
  .bcn-aldo-mark[data-size='lg'] { width: 64px; height: 64px; }

  .bcn-aldo-mark__glyph { display: block; width: 100%; height: 100%; }

  /* Rings alone: no circle, a light-to-deep teal gradient, the box sized by the host. */
  .bcn-aldo-mark[data-variant='rings'] {
    width: var(--bcn-aldo-mark-size, 24px);
    height: var(--bcn-aldo-mark-size, 24px);
    border-radius: 0;
    background: none;
  }
  .bcn-aldo-mark__from { stop-color: var(--bcn-aldo-ring-from, var(--color-teal-6)); }
  .bcn-aldo-mark__to { stop-color: var(--bcn-aldo-ring-to, var(--color-teal-9)); }

  /* When animated: a soft expanding-ring pulse on the circle and a slow turn of the rings.
     The ring grows outward as a box-shadow whose Aldo tint fades to transparent. */
  .bcn-aldo-mark[data-animated] {
    animation: bcn-aldo-pulse 2s ease-in-out infinite;
  }
  .bcn-aldo-mark[data-animated] .bcn-aldo-mark__glyph {
    animation: bcn-aldo-spin 12s linear infinite;
  }

  @keyframes bcn-aldo-pulse {
    0%   { box-shadow: 0 0 0 0 color-mix(in srgb, var(--bcn-aldo) 40%, transparent); }
    70%  { box-shadow: 0 0 0 10px color-mix(in srgb, var(--bcn-aldo) 0%, transparent); }
    100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--bcn-aldo) 0%, transparent); }
  }
  @keyframes bcn-aldo-spin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }

  /* Respect a reduced-motion preference: no pulse, no spin. */
  @media (prefers-reduced-motion: reduce) {
    .bcn-aldo-mark[data-animated],
    .bcn-aldo-mark[data-animated] .bcn-aldo-mark__glyph {
      animation: none;
    }
  }
</style>
