---
// <BcnAldoPanel> — the shell every Aldo conversation sits in: the mark and title, then the
// pieces in a fixed order (thread, instructions, needs, status, composer), each a slot a
// surface fills or leaves out. It carries Aldo's glow, renders the parts bin once, and
// loads the kit's stylesheet. Spec: docs/aldo-kit-spec.md.
//
// Expandable: the header's expand key pins the conversation over the right half of the window,
// where it is the work in front of the person. It is NOT modal: nothing dims, the page beside
// it stays live, and Aldo's page buttons move that page in view (a dialog would have to close
// for them). The host makes room from `--aldo-overlay-left`. Dock or Esc puts it back. Nothing
// moves in the DOM, so drafts, open forms and the thread are untouched. Events:
// `aldo:expand-overlay`, `aldo:dock`, `aldo:overlay-resize` (on the host).
//
// Open items and Instructions in effect live in the side region. Docked, it is a tray that
// drops from the header's indicator ("2 open items"), over the thread, the width of the panel;
// Esc, a click outside or the indicator closes it. Expanded, it is a sidebar beside the
// conversation, always open. One region, two placements, by CSS.
//
// Collapsible: the header's chevron folds the panel into a rail (the mark, the name, and a
// dot while something needs the person); the rail opens it again. The state is
// `data-aldo="open" | "closed"` on the nearest ancestor that carries it (the host's grid
// reads it), or on the panel. Events on the panel: `aldo:collapse`, `aldo:expand`.
//
// bcn-lego-checked: the indicator is a <button> holding an esa-badge and esa-icon (esa-button
// takes one label, not a badge); the tray is the side region placed by CSS, because
// esa-popover centers on its trigger and would hang off a 22rem panel. Expand and dock ARE esa-button chrome (the expanded panel is the panel
// itself, pinned: esa-side-dialog is modal, and the page beside Aldo must stay live),
// the mark IS bcn-aldo-mark, collapse IS esa-button chrome, the dot IS
// esa-badge dot, the chevron IS esa-icon. The rail is a <button> because it is one vertical
// target holding the mark and a vertical name; esa-button lays out one horizontal label.
// Checked Beacon (the side nav's collapsed rail is the same shape, hand-built). bcn-aldo-panel
// is the home for "Aldo's presence on a surface".
import '../../../styles/bcn-aldo.css';
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaBadge from '@esa/ecology/esa-badge.astro';
import EsaIcon from '@esa/ecology/esa-icon.astro';
import BcnAldoMark from './BcnAldoMark.astro';
import BcnAldoParts from './BcnAldoParts.astro';

interface Props {
  title?: string;
  /** Renders the collapse control and the rail. */
  collapsible?: boolean;
  /** The side the panel sits on: the chevrons point toward it. */
  rail?: 'left' | 'right';
  /** Aldo's border and shadow. Off inside a dialog that has its own chrome. */
  glow?: boolean;
  /** Renders the expand key and the overlay it opens. */
  expandable?: boolean;
  /** The collapse key's glyph, where the panel folds into something other than a side
   *  rail (a list page folds it back into its launcher above the Details card). */
  collapseIcon?: string;
  [attr: string]: unknown;
}
const { title = 'Aldo', collapsible = false, rail = 'right', glow = true, expandable = false, collapseIcon, ...rest } = Astro.props;
const away = collapseIcon ?? (rail === 'right' ? 'chevrons-right' : 'chevrons-left');
const back = rail === 'right' ? 'chevrons-left' : 'chevrons-right';
---

<div class:list={['bcn-aldo-panel', glow && 'bcn-aldo-panel--glow']} data-aldo-panel {...rest}>
  <section class="bcn-aldo-panel__body" aria-label={title}>
    <header class="bcn-aldo-panel__head">
      <BcnAldoMark size="sm" />
      <h3 class="bcn-aldo-panel__title">{title}</h3>
      <button type="button" class="bcn-aldo-panel__waiting" data-aldo-side-toggle aria-expanded="false" aria-controls="aldo-side" hidden>
        <span data-waiting-count><EsaBadge variant="warning" size="xs" value="0" /></span>
        <span data-waiting-label>open items</span>
        <EsaIcon name="chevron-down" size="sm" />
      </button>
      {
        expandable && (
          <span class="bcn-aldo-panel__expand">
            <EsaButton variant="chrome" iconOnly icon="plus" data-ico="maximize-2" label={`Expand ${title}`} size="xs" data-aldo-overlay="open" />
            <EsaButton variant="chrome" iconOnly icon="plus" data-ico="minimize-2" label={`Dock ${title}`} size="xs" data-aldo-overlay="dock" />
          </span>
        )
      }
      {
        collapsible && (
          <span class="bcn-aldo-panel__close">
            <EsaButton variant="chrome" iconOnly icon={away} label={`Collapse ${title}`} size="xs" data-aldo-collapse />
          </span>
        )
      }
    </header>
    <div class="bcn-aldo-panel__main">
      <slot name="thread" />
      <slot name="status" />
      <slot name="composer" />
    </div>
    <!-- What waits on the person and what governs Aldo: a tray from the header when docked,
         a sidebar beside the conversation when expanded. -->
    <aside class="bcn-aldo-panel__side" id="aldo-side" data-aldo-side aria-label="Open items and instructions">
      <slot name="needs" />
      <slot name="instructions" />
    </aside>
  </section>
  {
    collapsible && (
      <button type="button" class="bcn-aldo-panel__rail" data-aldo-expand aria-label={`Show ${title}`} title={`Show ${title}`}>
        <EsaIcon name={back} size="sm" />
        <BcnAldoMark size="sm" />
        <span class="bcn-aldo-panel__railname">{title}</span>
        <span class="bcn-aldo-panel__dot" data-aldo-dot hidden>
          <EsaBadge dot variant="warning" size="xs" label="An open item waits" />
        </span>
      </button>
    )
  }
  <BcnAldoParts />
</div>

<script>
  import { setupAldoPanel } from './aldo-panel';
  document.querySelectorAll<HTMLElement>('[data-aldo-panel]').forEach(setupAldoPanel);
</script>
