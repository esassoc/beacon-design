---
// <BcnVizMeter> — the stacked status meter from the Monitoring Portal dashboard
// (spec §4, the `.meter` primitive). One 14px bar whose segments divide the whole
// by share, ALWAYS paired with a legend carrying the same labels and counts as text.
//
// The bar is aria-hidden and the legend is the accessible content. That is the §4
// rule for every micro-viz on the dashboard: the graphic is reinforcement, the
// numbers it encodes are already in the DOM beside it, so a role="img" summary
// would only re-announce what the legend already says.
//
// EACH LEGEND ROW CARRIES A POPUP (2026-09-09, BcnVizTip) giving the segment's
// SHARE. The share is what a part-to-whole bar is FOR and the legend states only
// the count, so it is the reading the popup adds rather than repeats.
//
// ON THE LEGEND AND NOT THE BAR SEGMENTS, for two reasons that agree: the bar
// clips its segments to its own rounded corners with `overflow: hidden`, so a
// panel anchored inside one would be cut off at 14px unless that clipping were
// toggled off mid-hover (which squares the corners as you point at them); and the
// legend is the hover target BcnVizDonut uses for the same part-to-whole reading,
// so the two charts answer a pointer the same way. Magnitude-over-time charts
// (bcn-viz-trend, bcn-viz-stacked) put the popup on the mark, where the mark IS
// the period being asked about.
//
// `color` is REQUIRED and caller-supplied because meter segments are STATUS colors
// (Surveys: Final success / In QC warning / Draft gray) — the status system, not the
// widget's category accent, so the component must not reach for --_accent. Every
// other value in here is a token.
//
// bcn-lego-checked: esa-progress-bar is the only bar lego and it is single-fill —
// one clamped 0–100 `value`, one variant color, one role="progressbar" with
// aria-valuenow; N of them stacked would emit N progressbars and N tracks, which is
// not a part-to-whole meter. esa-chart is ruled out by spec §8 (a ~2.8MB AG Charts
// peer dep plus its paired esa-grid text alternative, for a 3-segment bar). Checked
// Beacon prod (origin/develop shared/ui/components) — no meter, segmented bar, or
// progress component exists there at all. bcn-viz-meter is the reusable home.

import BcnVizTip from './BcnVizTip.astro';

interface Segment {
  /** Names the count beside it — the legend row is a labeled pair, never a bare fact. */
  label: string;
  value: number;
  /** Status color, passed by the caller. A token reference or a hex. */
  color: string;
}

interface Props {
  segments: Segment[];
  /** What the popup's number IS, e.g. "Documents". The chart title says it once for the
   *  whole meter; the popup has to say it again per segment. */
  measure?: string;
}

const { segments, measure = 'Count' } = Astro.props;

// Zero total renders an empty track and a legend of zeros rather than dividing by it.
const total = segments.reduce((sum, s) => sum + s.value, 0);
const shareOf = (value: number) =>
  total > 0 ? Math.round((value / total) * 10000) / 100 : 0;
// The popup rounds to whole percents. Two decimals are right for a segment WIDTH (they
// stop rounding from leaving a visible sliver of track showing through) and wrong for a
// figure a person reads: "33.33%" claims a precision the eye cannot take off a 14px bar.
const sharePct = (value: number): string => (total > 0 ? `${Math.round(shareOf(value))}%` : '—');
---

<div class="bcn-viz-meter">
  <div class="bcn-viz-meter__bar" aria-hidden="true">
    {segments.map((segment) => (
      <span style={`width:${shareOf(segment.value)}%;background:${segment.color}`}></span>
    ))}
  </div>
  <div class="bcn-viz-meter__legend">
    {segments.map((segment) => (
      <div class="bcn-viz-meter__slot">
        <BcnVizTip
          title={segment.label}
          rows={[
            {
              label: measure,
              value: segment.value.toLocaleString('en-US'),
              color: segment.color,
              note: sharePct(segment.value),
            },
          ]}
        >
          <span class="bcn-viz-meter__row">
            <span class="bcn-viz-meter__dot" style={`background:${segment.color}`} />
            {segment.label}
            <span class="bcn-viz-meter__n">{segment.value.toLocaleString('en-US')}</span>
          </span>
        </BcnVizTip>
      </div>
    ))}
  </div>
</div>

<style>
  /* The host widget body spaces its children at --spacing-300 (spec §3). Bar and
     legend are two children there in the specimen and one child here, so the root
     carries that gap itself and composed spacing is unchanged. */
  .bcn-viz-meter {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-300);
    min-width: 0;
  }

  /* 14px is the dense floor: below it the thinnest segment stops reading as an area
     and starts reading as a rule. The track shows through wherever rounding leaves a
     sub-pixel remainder, which is why it is a real surface and not transparent. */
  .bcn-viz-meter__bar {
    display: flex;
    height: 14px;
    border-radius: var(--radius-xs);
    overflow: hidden;
    background: var(--color-background-elevation-sunken);
  }

  .bcn-viz-meter__bar span {
    display: block;
    height: 100%;
  }

  .bcn-viz-meter__legend {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-200);
    min-width: 0;
  }

  /* One segment's CELL — the whole legend row is the popup's hit target, not the 10px dot.
     The inline padding is cancelled by an equal negative margin, so the hover wash has room
     to breathe without the legend text shifting off its current alignment. Same treatment
     as BcnVizDonut's legend, so the two part-to-whole charts respond identically. */
  .bcn-viz-meter__slot {
    display: grid;
    min-width: 0;
    padding-inline: var(--spacing-100);
    margin-inline: calc(var(--spacing-100) * -1);
    border-radius: var(--radius-xs);
  }

  .bcn-viz-meter__slot:hover {
    background: var(--color-background-elevation-sunken);
  }

  .bcn-viz-meter__row {
    display: flex;
    align-items: center;
    gap: var(--spacing-250);
    font-size: var(--font-size-200);
    color: var(--color-content-default);
    /* Nested inside the popover's anchor now rather than being the legend's flex child. */
    width: 100%;
  }

  .bcn-viz-meter__dot {
    width: 10px;
    height: 10px;
    border-radius: var(--radius-full);
    flex: none;
  }

  /* margin-left:auto right-aligns the counts into a column of their own, and
     tabular-nums keeps that column from shifting as digit widths change. */
  .bcn-viz-meter__n {
    margin-left: auto;
    font-weight: var(--typography-font-weight-semibold);
    font-variant-numeric: tabular-nums;
  }

  /* FORCED COLORS. Segments differ only by background, so all of them flatten to
     Canvas and the bar reads as one undivided block. The legend still carries every
     label and count as text, so nothing is lost — the segments just take an edge so
     the proportions remain visible as proportions. */
  @media (forced-colors: active) {
    .bcn-viz-meter__bar {
      border: 1px solid CanvasText;
      background: Canvas;
    }
    .bcn-viz-meter__bar span {
      border-right: 1px solid CanvasText;
    }
    .bcn-viz-meter__bar span:last-child {
      border-right: 0;
    }
    .bcn-viz-meter__dot {
      border: 1px solid CanvasText;
    }
  }
</style>
