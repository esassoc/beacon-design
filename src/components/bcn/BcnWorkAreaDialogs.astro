---
// <BcnWorkAreaDialogs> — the Create and Bulk Import dialogs the work-area board's
// buttons open.
//
// Added at review (2026-08-13): the board's Create and Bulk import buttons emitted
// events and nothing listened, so they looked live and did nothing. These are ports
// of the dialogs prod already has, because the answer to "what happens when I click
// this" is "the same pop-up as today":
//
//   · Create  → `work-area-upsert-dialog`: Identifier (required) + the tenant's
//     WorkArea custom fields. That is the whole form.
//   · Import  → `work-area-bulk-import-dialog`: two stages, upload then map. Stage
//     two is the interesting one and the reason this is a dialog rather than a
//     drop-target — a CSV or zipped shapefile's columns never already match
//     Beacon's fields, so the user says what each column becomes, optionally
//     filters to a subset when one file covers several reaches, and sees a preview
//     of exactly what will land before committing.
//
// The board stays decoupled: it emits `bcn-work-area-create` and
// `bcn-work-areas-import`, this component listens on document. So the board is
// reusable without the dialogs and the dialogs can be swapped without touching it.
//
// Nothing saves — the import's Import button reports what it would have created.
//
// bcn-lego-checked: esa-dialog is the frame, esa-text-field / esa-select /
// esa-file-upload / esa-button / esa-alert-box / esa-badge are every control, and
// esa-file-upload is exactly prod's <file-drop-upload>. Checked Ecology for a
// column-mapping or import-wizard lego (none — esa-file-upload collects files and
// stops; esa-tab-layout switches panels but carries no stage model) and Beacon,
// whose two dialogs these are. bcn-work-area-dialogs is the reusable home; its own
// CSS is the mapping grid and the preview table.
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaAlertBox from '@esa/ecology/esa-alert-box.astro';
import { IMPORT_FIXTURE, WORK_AREA_CUSTOM_FIELDS } from '../../data/component-detail';

interface Props {
  /** Singular entity noun — tenants alias WorkArea. */
  entityLabel?: string;
  entityLabelPlural?: string;
  createId?: string;
  importId?: string;
}

const {
  entityLabel = 'Work Area',
  entityLabelPlural = 'Work Areas',
  createId = 'wa-create-dialog',
  importId = 'wa-import-dialog',
} = Astro.props;

// What a column can become. "Ignore" leads because most columns are.
const TARGETS = [
  { value: 'ignore', label: 'Ignore' },
  { value: 'identifier', label: 'Identifier' },
  ...WORK_AREA_CUSTOM_FIELDS.map((f) => ({ value: f.id, label: f.label })),
];

// A sensible opening guess, so stage two is not a wall of "Ignore". The user still
// confirms every row — this only saves the obvious keystrokes.
const GUESS: Record<string, string> = {
  SITE_ID: 'identifier',
  METHOD: 'cf-method',
  DEPTH_FT: 'cf-depth',
  APN: 'cf-apn',
  DCPN: 'cf-dcpn',
  COUNTY: 'cf-county',
  TEP_BATCH: 'cf-tep',
};

---

<!-- ── Create / Edit ──────────────────────────────────────────────────────── -->
<esa-dialog id={createId} heading={`Create ${entityLabel}`} size="sm" class="bcn-wad">
  <form class="stack" data-gap="md" data-wad-create-form onsubmit="return false">
    <esa-text-field label="Identifier" required data-wad-identifier placeholder="e.g. DCSHF-DH-072"></esa-text-field>

    <div class="stack" data-gap="sm">
      <h3 class="bcn-wad__section">Custom fields</h3>
      {
        WORK_AREA_CUSTOM_FIELDS.map((f) =>
          f.type === 'select' ? (
            <esa-select
              label={f.label}
              data-wad-cf={f.id}
              options={JSON.stringify((f.options ?? []).map((o) => ({ value: o, label: o })))}
              placeholder="Select…"
            />
          ) : (
            <esa-text-field label={f.label} type={f.type === 'number' ? 'number' : 'text'} data-wad-cf={f.id} />
          ),
        )
      }
    </div>
  </form>

  <div slot="footer" class="bcn-wad__foot">
    <div class="cluster" data-gap="sm">
      <span data-wad-create-save><EsaButton color="primary">Save</EsaButton></span>
      <span data-wad-create-cancel><EsaButton color="secondary" appearance="outline">Cancel</EsaButton></span>
    </div>
  </div>
</esa-dialog>

<!-- ── Bulk import ────────────────────────────────────────────────────────── -->
<esa-dialog id={importId} heading={`Bulk Import ${entityLabelPlural}`} size="lg" class="bcn-wad">
  <!-- STAGE 1 — upload -->
  <div class="stack" data-gap="md" data-wad-stage="upload">
    <p class="bcn-wad__lede">
      Upload a <strong>CSV</strong> or a zipped <strong>shapefile (.zip)</strong> to bulk-import
      {entityLabelPlural.toLowerCase()}. Columns can be mapped to the identifier and to custom fields.
    </p>
    <esa-file-upload label="Import file" accept=".csv,.zip" max-size-mb="10" data-wad-drop></esa-file-upload>
    <p class="bcn-wad__hint">Up to 10 MB and 5,000 rows.</p>
  </div>

  <!-- STAGE 2 — map -->
  <div class="stack" data-gap="lg" data-wad-stage="map" hidden>
    <p class="bcn-wad__lede">
      <strong data-wad-rowcount>{IMPORT_FIXTURE.rows.length}</strong> rows detected with geometry in
      <strong>{IMPORT_FIXTURE.fileName}</strong>.
    </p>

    <div class="stack" data-gap="sm">
      <h3 class="bcn-wad__section">Map columns</h3>
      <p class="bcn-wad__hint">
        Choose what each column becomes. Exactly one column must be the Identifier; geometry is imported
        automatically.
      </p>
      <div class="bcn-wad__map">
        {
          IMPORT_FIXTURE.columns.map((col) => (
            <div class="bcn-wad__maprow">
              <span class="bcn-wad__col" title={col}>
                {col}
              </span>
              {/* The opening guess rides a data-* attribute, not `value`: esa-select
                  exposes value as a PROPERTY only (it sits outside the lego's
                  reactive properties), so an SSR'd value attribute is silently
                  dropped and every column would read as Ignore. The controller
                  applies these on stage entry. */}
              <esa-select
                data-wad-target={col}
                data-wad-guess={GUESS[col] ?? 'ignore'}
                aria-label={`Map column ${col}`}
                size="sm"
                options={JSON.stringify(TARGETS)}
              />
            </div>
          ))
        }
      </div>
      <div data-wad-maperror hidden>
        <EsaAlertBox variant="danger">
          <span data-wad-maperror-text></span>
        </EsaAlertBox>
      </div>
    </div>

    <div class="stack" data-gap="sm">
      <h3 class="bcn-wad__section">Filter (optional)</h3>
      <p class="bcn-wad__hint">Import only a subset — a single reach, say — when one file covers everything.</p>
      <div class="cluster" data-gap="sm">
        <esa-select
          data-wad-filter-col
          aria-label="Filter column"
          size="sm"
          placeholder="No filter"
          options={JSON.stringify([
            { value: '', label: 'No filter' },
            ...IMPORT_FIXTURE.columns.map((c) => ({ value: c, label: c })),
          ])}
        />
        <span data-wad-filter-val-wrap hidden>
          <esa-select data-wad-filter-val aria-label="Filter value" size="sm" options="[]" />
        </span>
      </div>
    </div>

    <div class="stack" data-gap="sm">
      <h3 class="bcn-wad__section">Preview</h3>
      <p class="bcn-wad__hint">
        <strong data-wad-importcount></strong> <span data-wad-importnoun></span> will be imported.
      </p>
      <div class="bcn-wad__preview">
        <table data-wad-preview>
          <thead data-wad-preview-head></thead>
          <tbody data-wad-preview-body></tbody>
        </table>
      </div>
      <p class="bcn-wad__hint" data-wad-more hidden></p>
    </div>
  </div>

  <div slot="footer" class="bcn-wad__foot bcn-wad__foot--split">
    <span data-wad-reset hidden>
      <EsaButton color="secondary" appearance="outline">Choose Different File</EsaButton>
    </span>
    <div class="cluster" data-gap="sm">
      <span data-wad-import><EsaButton color="primary" icon="upload">Import</EsaButton></span>
      <span data-wad-import-cancel><EsaButton color="secondary" appearance="outline">Cancel</EsaButton></span>
    </div>
  </div>
</esa-dialog>

<script>
  import '@esa/ecology/esa-dialog';
  import '@esa/ecology/esa-text-field';
  import '@esa/ecology/esa-select';
  import '@esa/ecology/esa-file-upload';
  import { setupWorkAreaDialogs } from './work-area-dialogs';

  setupWorkAreaDialogs();
</script>

<style>
  /* A stage is a layout primitive, and `.stack { display: flex }` outranks the UA's
     low-specificity `[hidden] { display: none }` — so hiding a stage by setting
     `hidden` did nothing and both steps rendered at once. Restate it with enough
     specificity to win. Same trap for any primitive toggled by `hidden`. */
  [data-wad-stage][hidden] {
    display: none;
  }

  .bcn-wad__lede,
  .bcn-wad__hint {
    margin: 0;
    font-size: var(--type-size-150, 0.875rem);
    color: var(--color-text-secondary);
  }
  .bcn-wad__hint {
    color: var(--color-text-tertiary);
  }
  .bcn-wad__section {
    margin: 0;
    font-size: var(--type-size-200, 1rem);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
  }

  /* Column name against its target select, one row each. */
  .bcn-wad__map {
    display: grid;
    gap: var(--spacing-200);
  }
  .bcn-wad__maprow {
    display: grid;
    grid-template-columns: minmax(8rem, 14rem) minmax(0, 1fr);
    align-items: center;
    gap: var(--spacing-300);
  }
  .bcn-wad__col {
    font-size: var(--type-size-150, 0.875rem);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-primary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Wide content scrolls inside its own box, never the page. */
  .bcn-wad__preview {
    overflow-x: auto;
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-200);
  }
  .bcn-wad__preview table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--type-size-150, 0.875rem);
  }
  .bcn-wad__preview th,
  .bcn-wad__preview td {
    padding: var(--spacing-150) var(--spacing-250);
    text-align: left;
    white-space: nowrap;
    color: var(--color-text-secondary);
  }
  .bcn-wad__preview thead th {
    background: var(--color-surface-sunken);
    color: var(--color-text-primary);
    font-weight: var(--font-weight-semibold);
  }
  .bcn-wad__preview tbody tr + tr td {
    border-top: 1px solid var(--color-border-light);
  }

  /* Footer: tertiary far left, action group right, primary left of Cancel. */
  .bcn-wad__foot {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: var(--spacing-300);
  }
  .bcn-wad__foot--split {
    justify-content: space-between;
  }
  .bcn-wad__foot span[hidden] {
    display: none;
  }
</style>
