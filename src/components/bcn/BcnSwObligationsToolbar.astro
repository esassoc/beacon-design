---
// <BcnSwObligationsToolbar> — how a reviewer gets around 402 rows.
//
// Search and the class filter are WIRED, not chrome. A dead search box beside a
// 402-row list would leave the one question this step has to answer — is the list
// navigable at full size — untestable. The controller is the whole behaviour: match
// rows on title, species and commitment codes, hide the groups that empty out, open
// the ones that survive, and restage every group count to what is actually visible
// so a filtered "Water 47" never lies. Expand all / Collapse all works on the two
// GROUP tiers only; opening 402 record bodies is not a thing anyone wants.
//
// Add category and Add obligation are secondary on purpose. The step's single
// primary action is the approval in the footer, and a reviewer who has to add a
// whole category is telling us the draft was wrong, not doing the main task.
//
// bcn-lego-checked: every control is a lego — esa-text-field (search),
// esa-button-toggle (the class filter, whose options are an array property and so
// must be assigned in script; that is the lego's documented API, not a workaround),
// esa-button for the four verbs. Nothing bespoke but the bar's own layout and the
// controller that joins it to the tree.
import EsaButton from '@esa/ecology/esa-button.astro';
import { OBLIGATION_CLASS_LABEL } from '../../data/setup-wizard';

// Lit declares `options` as `{ type: Array }`, so its attribute converter JSON-parses
// the string — the options ship in the MARKUP and the controller never touches them.
const CLASS_OPTIONS = JSON.stringify([
  { label: 'All', value: 'all' },
  ...(['adhere', 'monitor', 'notify', 'roster'] as const).map((c) => ({
    label: OBLIGATION_CLASS_LABEL[c],
    value: c,
  })),
]);
---

<div class="bcn-swo-bar">
  <esa-text-field
    id="swo-search"
    class="bcn-swo-bar__search"
    label="Search obligations"
    placeholder="Title, species or commitment code"
    size="md"
    name="swo-search"></esa-text-field>

  <esa-button-toggle
    id="swo-class"
    label="Class"
    options={CLASS_OPTIONS}
    value="all"
    size="md"
    name="swo-class"></esa-button-toggle>

  <div class="bcn-swo-bar__verbs">
    <EsaButton variant="secondary" appearance="outline" size="md">Add category</EsaButton>
    <EsaButton variant="secondary" appearance="outline" size="md">Add obligation</EsaButton>
  </div>

  <div class="bcn-swo-bar__disclosure">
    <button class="bcn-swo-bar__link" type="button" data-swo-expand>Expand all</button>
    <button class="bcn-swo-bar__link" type="button" data-swo-collapse>Collapse all</button>
  </div>
</div>

<script>
  import '@esa/ecology/esa-text-field';
  import '@esa/ecology/esa-button-toggle';

  const search = document.getElementById('swo-search') as HTMLElement & { value: string };
  const classFilter = document.getElementById('swo-class') as HTMLElement & { value: string };
  const tree = document.querySelector<HTMLElement>('[data-swo-tree]');

  if (tree) {
    const empty = tree.querySelector<HTMLElement>('[data-swo-empty]');
    // Resolved ONCE. Re-querying per keystroke across 402 rows and 69 groups is the
    // difference between a filter that keeps up with typing and one that does not.
    const cats = [...tree.querySelectorAll<HTMLDetailsElement>('[data-swo-cat]')].map((cat) => ({
      el: cat,
      count: cat.querySelector<HTMLElement>(':scope > summary [data-swo-count]'),
      subs: [...cat.querySelectorAll<HTMLDetailsElement>('[data-swo-sub]')].map((sub) => ({
        el: sub,
        count: sub.querySelector<HTMLElement>(':scope > summary [data-swo-count]'),
        rows: [...sub.querySelectorAll<HTMLDetailsElement>('[data-swo-row]')],
      })),
    }));

    const setCount = (holder: HTMLElement | null, n: number) => {
      const chip = holder?.firstElementChild as HTMLElement | undefined;
      if (!chip) return;
      chip.textContent = String(n);
      chip.setAttribute('aria-label', `${n} obligations`);
    };

    let query = '';
    let cls = 'all';

    const apply = () => {
      const filtering = query.length > 0 || cls !== 'all';
      let visible = 0;

      for (const cat of cats) {
        let inCat = 0;
        for (const sub of cat.subs) {
          let inSub = 0;
          for (const row of sub.rows) {
            const hit =
              (!query || (row.dataset.swoHit ?? '').includes(query)) &&
              (cls === 'all' || row.dataset.swoClass === cls);
            row.hidden = !hit;
            if (!hit) row.open = false;
            if (hit) inSub++;
          }
          sub.el.hidden = inSub === 0;
          setCount(sub.count, filtering ? inSub : Number(sub.count?.dataset.swoCount ?? inSub));
          if (filtering) sub.el.open = inSub > 0;
          inCat += inSub;
        }
        cat.el.hidden = inCat === 0;
        setCount(cat.count, filtering ? inCat : Number(cat.count?.dataset.swoCount ?? inCat));
        if (filtering) cat.el.open = inCat > 0;
        visible += inCat;
      }

      if (empty) empty.hidden = visible > 0;
    };

    search?.addEventListener('change', () => {
      query = (search.value ?? '').trim().toLowerCase();
      apply();
    });
    classFilter?.addEventListener('change', () => {
      cls = classFilter.value || 'all';
      apply();
    });

    const setGroups = (open: boolean) => {
      for (const cat of cats) {
        cat.el.open = open;
        for (const sub of cat.subs) {
          sub.el.open = open;
          if (!open) for (const row of sub.rows) row.open = false;
        }
      }
    };
    document.querySelector('[data-swo-expand]')?.addEventListener('click', () => setGroups(true));
    document.querySelector('[data-swo-collapse]')?.addEventListener('click', () => setGroups(false));
  }
</script>

<style>
  .bcn-swo-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--spacing-300) var(--spacing-400);
    padding: var(--spacing-300);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md);
    background: var(--color-background-elevation-raised);
  }

  .bcn-swo-bar__search {
    flex: 1 1 280px;
    min-width: 240px;
    max-width: 380px;
  }

  .bcn-swo-bar__verbs {
    display: flex;
    align-items: center;
    gap: var(--spacing-200);
    margin-inline-start: auto;
  }

  .bcn-swo-bar__disclosure {
    display: flex;
    align-items: center;
    gap: var(--spacing-300);
    padding-block-end: var(--spacing-150);
  }
  .bcn-swo-bar__link {
    padding: 0;
    border: 0;
    background: none;
    font-family: inherit;
    font-size: var(--font-size-200);
    color: var(--color-content-brand);
    cursor: pointer;
    white-space: nowrap;
  }
  .bcn-swo-bar__link:hover {
    text-decoration: underline;
  }
  .bcn-swo-bar__link:focus-visible {
    outline: 2px solid var(--color-background-brand);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }
</style>
