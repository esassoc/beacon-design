---
// <BcnSw3IndexTree> — step 3's left pane: the Compliance Index as a book's index reads, all
// three levels open. Category is the heading, subcategory the subheading, each entry a line
// under it. A subcategory is the unit of review: pressing one brings its page into view; an
// entry brings its page into view with the entry open. A circle-check marks a reviewed
// subcategory (muted when everything in it was discarded); a dot, one with something to
// settle. The pane folds to a rail, as step 1's Library does.
//
// The headings and subheadings are the index's structure and render here; the entries under
// them move (a merge, a move, also filed) and are drawn by the host's controller (sw3-index.ts).
//
// bcn-lego-checked: each category IS esa-collapsible (flush); the fold keys ARE
// esa-button (chrome, as the Library's); the state marks ARE esa-icon. Checked Beacon: the compliance-index-step
// sidebar is a flat list of bins with draft and approved counts, no entries under them.
// bcn-registry-tree is the setup-step-5 registry with checkboxes and verbs on the rows;
// here the rows only navigate, so bcn-sw3-index-tree is its own home.
import EsaCollapsible from '@esa/ecology/esa-collapsible.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaIcon from '@esa/ecology/esa-icon.astro';
import type { Sw3Index } from '../../data/sw3-index-types';

interface Props {
  index: Sw3Index;
}
const { index } = Astro.props;
---

<nav class="bcn-sw3it" aria-label="Compliance Index" data-sw3-index-tree>
  <div class="bcn-sw3it__head">
    <h2 class="bcn-sw3it__title">Index</h2>
    <EsaButton variant="chrome" iconOnly icon="chevrons-left" label="Fold the index" size="xs" data-it-fold />
  </div>
  <span class="bcn-sw3it__unfold"><EsaButton variant="chrome" iconOnly icon="chevrons-right" label="Open the index" size="xs" data-it-unfold /></span>
  <div class="bcn-sw3it__body">
    {
      index.categories.map((cat) => (
        <EsaCollapsible title={cat.name} open flush>
          <ul class="bcn-sw3it__subs">
            {cat.subcategories.map((s) => (
              <li class="bcn-sw3it__sub" data-it-sub={s.id}>
                <a class="bcn-sw3it__subname" href={`#${s.id}`} data-it-go={s.id}>
                  <span>{s.name}</span>
                  <span class="bcn-sw3it__mark" data-it-mark="reviewed">
                    <EsaIcon name="circle-check" size="xs" label="Reviewed" />
                  </span>
                  <span class="bcn-sw3it__mark" data-it-mark="flagged">
                    <EsaIcon name="circle-alert" size="xs" label="Something to settle" />
                  </span>
                </a>
                <ol class="bcn-sw3it__entries" data-it-entries />
              </li>
            ))}
          </ul>
        </EsaCollapsible>
      ))
    }
  </div>
</nav>

<style>
  .bcn-sw3it {
    display: flex;
    flex-direction: column;
    min-height: 0;
    height: 100%;
    font-size: 0.8125rem;
  }
  .bcn-sw3it__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--spacing-200) var(--spacing-200) var(--spacing-100) var(--spacing-400);
  }
  .bcn-sw3it__title { margin: 0; font-size: 0.9375rem; font-weight: 600; }
  .bcn-sw3it__unfold { display: none; padding: var(--spacing-200); }
  .bcn-sw3it__body {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 0 var(--spacing-400) var(--spacing-400);
  }
  .bcn-sw3it__body :global(.esa-collapsible__summary) { font-size: 0.8125rem; font-weight: 600; }
  .bcn-sw3it__body :global(.esa-collapsible__body) { font-size: 0.8125rem; padding-top: 0; }

  .bcn-sw3it__subs,
  .bcn-sw3it__entries { list-style: none; margin: 0; padding: 0; }
  .bcn-sw3it__subs { display: flex; flex-direction: column; gap: var(--spacing-100); }

  .bcn-sw3it__subname {
    display: flex;
    align-items: center;
    gap: var(--spacing-100);
    padding: 3px var(--spacing-150);
    margin-inline: calc(-1 * var(--spacing-150));
    border-radius: var(--radius-100);
    color: var(--color-content-default);
    font-weight: 500;
    text-decoration: none;
  }
  .bcn-sw3it__subname:hover { background: var(--color-background-elevation-sunken); }
  .bcn-sw3it__sub[data-current] > .bcn-sw3it__subname {
    background: var(--color-background-elevation-sunken);
    font-weight: 600;
  }
  .bcn-sw3it__mark { display: none; margin-left: auto; line-height: 0; }
  .bcn-sw3it__sub[data-state='reviewed'] [data-it-mark='reviewed'] { display: inline-flex; color: var(--color-content-success); }
  .bcn-sw3it__sub[data-state='reviewed'][data-none] [data-it-mark='reviewed'] { color: var(--color-content-default-tertiary); }
  .bcn-sw3it__sub[data-state='flagged'] [data-it-mark='flagged'] { display: inline-flex; color: var(--color-content-warning); }

  /* Entries: the third level, the index's lines. */
  .bcn-sw3it__entries { padding-left: var(--spacing-300); }
  .bcn-sw3it__entries :global(a) {
    display: block;
    padding: 1px 0;
    color: var(--color-content-default-secondary);
    text-decoration: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .bcn-sw3it__entries :global(a:hover) { color: var(--color-content-default); text-decoration: underline; }
  .bcn-sw3it__entries :global(a[data-status='discarded']) { text-decoration: line-through; color: var(--color-content-default-tertiary); }
  .bcn-sw3it__entries :global(a[data-current]) { color: var(--color-content-default); font-weight: 600; }

  /* Folded: a rail with the open key. */
  :global([data-index='closed']) .bcn-sw3it__head,
  :global([data-index='closed']) .bcn-sw3it__body { display: none; }
  :global([data-index='closed']) .bcn-sw3it__unfold { display: block; }
</style>
