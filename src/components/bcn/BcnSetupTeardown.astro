---
// <BcnSetupTeardown> — the evidence half of the Component Setup comparison page:
// what the production screen does today, and why both replacement models are
// shaped the way they are.
//
// This section exists because the redesign is not a restyle. The screen Andy
// called "the first thing I ever designed in Beacon… I think it's actually
// broken" IS broken, and it is broken in the data model rather than in the CSS.
// A reviewer who does not know that will read the two models as taste, and pick
// the prettier one. So the finding goes on the page, stated once, with the
// defects it produces listed underneath it — each one traced to code rather
// than asserted.
//
// The rule this section is written to: every claim here is checkable. Nothing
// is characterized as bad without naming the mechanism that makes it bad.
//
// bcn-lego-checked: esa-card is each group's chrome, esa-badge marks the defect
// severity, esa-icon carries the structural glyphs. Checked Ecology for a
// findings/teardown lego (esa-alert-box is one inline notice; esa-empty-state is
// a zero-result; neither is a multi-claim evidence section) and Beacon prod
// (no annotation surface exists). bcn-setup-teardown is the reusable home for a
// prototype's "here is what's wrong today" section; its own CSS is the claim
// grid and the cross-product figure.
import EsaCard from '@esa/ecology/esa-card.astro';
import EsaBadge from '@esa/ecology/esa-badge.astro';
import { SETUP_TOTALS } from '../../data/component-commitments';

// The mechanism, in the order a reader needs it. This is the whole finding:
// "pending" is not a state anybody creates, it is a row that does not exist yet.
const MECHANISM = [
  {
    step: 'The table',
    detail:
      'ComponentCommitment stores one row per decision, with IsApplicable as a NOT NULL bit. There are two states in storage, not three.',
  },
  {
    step: 'The view',
    detail:
      'vComponentCommitmentDecisions LEFT JOINs every Component in the project against every Commitment in the project, and calls the misses "Pending".',
  },
  {
    step: 'The consequence',
    detail:
      'Pending is therefore a cross product, not a queue. It counts the project rather than the component, and it re-inflates every time any source document gains a commitment.',
  },
];

// Each defect names what a user sees and what produces it. Severity is about
// whether the screen misleads, not about how hard it is to fix.
const DEFECTS = [
  {
    seen: 'The count and the list disagree',
    cause:
      'The view toggle counts the unfiltered set; the pane below it renders one source document. "52 Pending" over a list of three is the normal case, not an edge case.',
    severity: 'danger' as const,
    label: 'Misleads',
  },
  {
    seen: 'The number never reaches zero',
    cause:
      'Every commitment added to any source document becomes pending again for every component in the project. The progress badge measures a treadmill.',
    severity: 'danger' as const,
    label: 'Misleads',
  },
  {
    seen: 'Bulk overwrites rationales silently',
    cause:
      'One PATCH carries one rationale string for every selected commitment. A commitment that already had its own reasoning loses it with no warning.',
    severity: 'danger' as const,
    label: 'Data loss',
  },
  {
    seen: 'The screen never says what a decision does',
    cause:
      'Applying reconciles action implementations onto the component — it is what fills the tracker. Dismissing deletes the deletable ones back out. Neither is stated anywhere on the surface.',
    severity: 'warning' as const,
    label: 'Hidden effect',
  },
  {
    seen: 'The selection resets while you work',
    cause:
      'The source-document options stream auto-selects the first document alphabetically as a side effect, and re-fires on every decision and every view switch.',
    severity: 'warning' as const,
    label: 'Fights the user',
  },
  {
    seen: 'The Construction Activity filter cannot be used',
    cause:
      'It is rendered, populated with real options, and hard-disabled, because commitments are not associated to construction activities in the data model.',
    severity: 'warning' as const,
    label: 'Dead control',
  },
  {
    seen: 'Applied and Dismissed show a spinner forever',
    cause:
      'The loading branch is inverted, and the flag never clears on those two streams because finalize() is attached to a combineLatest that does not complete.',
    severity: 'warning' as const,
    label: 'Broken state',
  },
];

// What both models are therefore required to do. This is the shared contract —
// the part that is NOT up for a vote between A and B.
const CONTRACT = [
  'Lead with a figure scoped to this component, and make every count agree with the list it labels.',
  'Separate what is new since the last review from the standing backlog, so the treadmill is legible instead of hidden inside one number.',
  'State what a decision will do — name the actions applying creates, before it is made.',
  'Capture rationale per commitment, and warn before a batch write overwrites one that already exists.',
  'Render no control that cannot act.',
];
---

<section class="bcn-td stack" data-gap="md" aria-labelledby="bcn-td-title">
  <div>
    <h2 class="type-section-title" id="bcn-td-title">What this screen does today</h2>
    <p class="type-body bcn-td__lede">
      Two models follow. They disagree about the interaction and agree about the diagnosis, so the
      diagnosis is stated once here.
    </p>
  </div>

  <EsaCard title="Why the count is wrong" variant="outlined">
    <ol class="bcn-td__mech">
      {
        MECHANISM.map((m, i) => (
          <li class="bcn-td__mechrow">
            <span class="bcn-td__mechnum" aria-hidden="true">
              {i + 1}
            </span>
            <span class="bcn-td__mechbody">
              <span class="bcn-td__mechstep">{m.step}</span>
              <span class="bcn-td__mechdetail">{m.detail}</span>
            </span>
          </li>
        ))
      }
    </ol>
    <p class="type-body-small bcn-td__figure">
      For this component the honest figures are <strong>{SETUP_TOTALS.undecided}</strong> undecided,
      of which <strong>{SETUP_TOTALS.newSince}</strong> arrived after the last review, against{' '}
      <strong>{SETUP_TOTALS.decided}</strong> already decided.
    </p>
  </EsaCard>

  <div class="bcn-td__grid">
    <EsaCard title="What a user runs into" variant="outlined">
      <ul class="bcn-td__defects">
        {
          DEFECTS.map((d) => (
            <li class="bcn-td__defect">
              <span class="bcn-td__defecthead">
                <span class="bcn-td__defectseen">{d.seen}</span>
                <EsaBadge value={d.label} variant={d.severity} size="xs" />
              </span>
              <span class="bcn-td__defectcause">{d.cause}</span>
            </li>
          ))
        }
      </ul>
    </EsaCard>

    <EsaCard title="What both models must do" variant="outlined">
      <ol class="bcn-td__contract">
        {CONTRACT.map((c) => <li class="bcn-td__item">{c}</li>)}
      </ol>
      <p class="type-caption bcn-td__caveat">
        Everything below this line is where the two models actually differ.
      </p>
    </EsaCard>
  </div>
</section>

<style>
  .bcn-td__lede {
    margin: var(--spacing-200) 0 0;
    max-width: 78ch;
    color: var(--color-text-secondary);
  }

  /* The mechanism reads as an ordered chain — the order IS the argument. */
  .bcn-td__mech {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-300);
  }
  .bcn-td__mechrow {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-300);
  }
  .bcn-td__mechnum {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: var(--radius-full);
    background: var(--color-surface-sunken);
    color: var(--color-text-secondary);
    font-size: var(--type-size-150, 0.875rem);
    font-weight: var(--font-weight-semibold);
    font-variant-numeric: tabular-nums;
  }
  .bcn-td__mechbody {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .bcn-td__mechstep {
    font-size: var(--type-size-150, 0.875rem);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
  }
  .bcn-td__mechdetail {
    font-size: var(--type-size-150, 0.875rem);
    line-height: 1.5;
    color: var(--color-text-secondary);
  }
  .bcn-td__figure {
    margin: var(--spacing-350) 0 0;
    padding-top: var(--spacing-300);
    border-top: 1px solid var(--color-border-light);
    color: var(--color-text-secondary);
  }
  .bcn-td__figure strong {
    color: var(--color-text-primary);
    font-variant-numeric: tabular-nums;
  }

  .bcn-td__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--spacing-400);
    align-items: start;
  }

  .bcn-td__defects {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .bcn-td__defect {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-100);
    padding: var(--spacing-250) 0;
  }
  .bcn-td__defect + .bcn-td__defect {
    border-top: 1px solid var(--color-border-light);
  }
  .bcn-td__defecthead {
    display: flex;
    align-items: center;
    gap: var(--spacing-200);
    flex-wrap: wrap;
  }
  .bcn-td__defectseen {
    font-size: var(--type-size-150, 0.875rem);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
  }
  .bcn-td__defectcause {
    font-size: var(--type-size-150, 0.875rem);
    line-height: 1.5;
    color: var(--color-text-secondary);
  }

  .bcn-td__contract {
    margin: 0;
    padding-left: 1.35rem;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-250, 0.625rem);
  }
  .bcn-td__item {
    font-size: var(--type-size-150, 0.875rem);
    line-height: 1.5;
    color: var(--color-text-secondary);
  }
  .bcn-td__caveat {
    margin: var(--spacing-300) 0 0;
    padding-top: var(--spacing-300);
    border-top: 1px solid var(--color-border-light);
    color: var(--color-text-tertiary);
  }
</style>
