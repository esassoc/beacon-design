---
// <BcnSwObligationsRow> — ONE obligation in the step 5 tree.
//
// The row is a native <details>. Its <summary> is the grid line a reviewer scans;
// opening it is the "View" verb, and the body shows the four fields the registry
// stores for every obligation: standard, condition, parameters, commitments.
//
// The whole summary is ONE grid whose template comes from --swo-grid, declared once
// on the tree root. Every row in all 17 categories therefore shares the same class,
// species, commitments and verbs columns no matter how deep it sits, because the
// indent is a constant padding on the row rather than padding on the groups above
// it. Column alignment is the thing that makes 402 rows scannable; card-per-row
// would destroy it, so there is no card, no shadow, and no radius here — just a
// hairline between rows.
//
// Overflow is capped, not wrapped: a row is one line tall, always. Species top out
// at 2 chips (the widest row carries 11) and commitments at 3 (the widest carries
// 28); the rest become a neutral "+n" companion and the full lists are in the body.
// Wrapping would make row height depend on content and the column rhythm would go.
//
// bcn-lego-checked: checked esa-collapsible — its summary is a `title` STRING plus
// one registry icon, with no slot, so it cannot carry a title, a class pill, chips,
// codes and three verbs. Checked esa-card (no disclosure, and a card per row is the
// pattern this row exists to avoid) and esa-table (a table cannot nest a disclosure
// body inside a row without colspan gymnastics, and the tree's groups are not rows).
// The parts INSIDE the row are all legos or existing bcn components: the class chip
// is bcn-sw-obligations-class-pill (esa-pill), the codes are bcn-commitment-badge,
// the field list is bcn-key-value, the glyphs are esa-icon.
import EsaIcon from '@esa/ecology/esa-icon.astro';
import BcnCommitmentBadge from './BcnCommitmentBadge.astro';
import BcnKeyValue from './BcnKeyValue.astro';
import BcnSwObligationsClassPill from './BcnSwObligationsClassPill.astro';
import type { ObligationRow } from '../../data/setup-wizard';

interface Props {
  obligation: ObligationRow;
  /** Render the row already expanded. */
  open?: boolean;
}
const { obligation: o, open = false } = Astro.props;

const SPECIES_SHOWN = 2;
const CODES_SHOWN = 3;
const speciesShown = o.species.slice(0, SPECIES_SHOWN);
const speciesRest = o.species.length - speciesShown.length;
const codesShown = o.commitments.slice(0, CODES_SHOWN);
const codesRest = o.commitments.length - codesShown.length;

// EN dash is the no-value mark: 170 rows state no parameters, 352 no window.
const DASH = '–';

// The toolbar's search matches against this: title, species, commitment codes.
const hit = [o.title, ...o.species, ...o.commitments].join(' ').toLowerCase();

const LOCK = '<rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>';
const CHEVRON = '<path d="m9 18 6-6-6-6"/>';
---

<details class="bcn-swo-row" data-swo-row data-swo-class={o.class} data-swo-hit={hit} data-gate={o.gate ? '' : undefined} open={open}>
  <summary class="bcn-swo-row__line">
    <span class="bcn-swo-row__gate">
      {o.gate && <EsaIcon name="lock" paths={LOCK} size="xs" label="Approval gate" />}
    </span>

    <span class="bcn-swo-row__title">{o.title}</span>

    <span class="bcn-swo-row__class">
      <BcnSwObligationsClassPill obligationClass={o.class} size="md" />
    </span>

    <span class="bcn-swo-row__species">
      {speciesShown.map((s) => <span class="bcn-swo-row__species-chip">{s}</span>)}
      {speciesRest > 0 && <span class="bcn-swo-row__more">+{speciesRest}</span>}
    </span>

    <span class="bcn-swo-row__codes">
      {codesShown.map((c) => <BcnCommitmentBadge code={c} size="sm" />)}
      {codesRest > 0 && <BcnCommitmentBadge code={`+${codesRest}`} size="sm" tone="neutral" />}
    </span>

    <span class="bcn-swo-row__verbs">
      <span class="bcn-swo-row__verb bcn-swo-row__verb--view">View</span>
      <button class="bcn-swo-row__verb" type="button">Edit</button>
      <button class="bcn-swo-row__verb bcn-swo-row__verb--remove" type="button">Remove</button>
    </span>

    <span class="bcn-swo-row__caret" aria-hidden="true"><EsaIcon name="chevron-right" paths={CHEVRON} size="sm" /></span>
  </summary>

  <div class="bcn-swo-row__body">
    <BcnKeyValue label="Standard" value={o.standard} />
    <BcnKeyValue label="Condition" value={o.condition} />
    <BcnKeyValue label="Parameters" value={o.parameters || DASH} />
    <BcnKeyValue label="Timing" value={o.window || DASH} />
    <BcnKeyValue label="Commitments">
      <span class="bcn-swo-row__body-codes">
        {o.commitments.map((c) => <BcnCommitmentBadge code={c} size="sm" />)}
      </span>
    </BcnKeyValue>
    {
      o.species.length > 0 && (
        <BcnKeyValue label="Species">
          <span class="bcn-swo-row__body-species">
            {o.species.map((s) => (
              <span class="bcn-swo-row__species-chip">{s}</span>
            ))}
          </span>
        </BcnKeyValue>
      )
    }
  </div>
</details>

<style>
  .bcn-swo-row {
    border-top: 1px solid var(--color-border-default-subtle);
  }
  .bcn-swo-row:first-of-type {
    border-top: 0;
  }

  /* ── The scan line ──────────────────────────────────────────────────────── */
  .bcn-swo-row__line {
    display: grid;
    grid-template-columns: var(--swo-grid, 18px minmax(0, 1fr) 96px 190px 184px 132px 18px);
    align-items: center;
    column-gap: var(--spacing-200);
    /* The indent is CONSTANT so every row's right-hand columns align with the
       header strip, whichever category and subcategory it sits under. */
    padding: var(--spacing-100) var(--spacing-300) var(--spacing-100) var(--spacing-700);
    cursor: pointer;
    list-style: none;
  }
  .bcn-swo-row__line::-webkit-details-marker {
    display: none;
  }
  .bcn-swo-row__line:hover {
    background: var(--color-background-elevation-sunken);
  }
  .bcn-swo-row__line:focus-visible {
    outline: 2px solid var(--color-background-brand);
    outline-offset: -2px;
  }
  .bcn-swo-row[open] > .bcn-swo-row__line {
    background: var(--color-background-elevation-sunken);
  }

  .bcn-swo-row__gate {
    display: inline-flex;
    justify-content: center;
    color: var(--color-content-default-secondary);
  }

  .bcn-swo-row__title {
    min-width: 0;
    font-size: var(--font-size-250);
    line-height: 1.35;
    color: var(--color-content-default);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .bcn-swo-row__class,
  .bcn-swo-row__species,
  .bcn-swo-row__codes {
    display: flex;
    align-items: center;
    gap: var(--spacing-100);
    min-width: 0;
    overflow: hidden;
  }
  .bcn-swo-row__codes {
    justify-content: flex-end;
  }

  .bcn-swo-row__species-chip {
    flex-shrink: 1;
    min-width: 0;
    padding: 1px var(--spacing-150);
    border-radius: var(--radius-chip);
    background: var(--color-background-elevation-sunken);
    color: var(--color-content-default-secondary);
    font-size: var(--font-size-150);
    line-height: 1.5;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .bcn-swo-row__more {
    flex-shrink: 0;
    color: var(--color-content-default-tertiary);
    font-size: var(--font-size-150);
    font-variant-numeric: tabular-nums;
  }

  /* ── Verbs. Quiet at rest so 402 rows stay co-equal; the approval is of the
        taxonomy, not of a row, so nothing here competes with the titles. ──── */
  .bcn-swo-row__verbs {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--spacing-200);
    opacity: 0;
    transition: opacity 100ms ease;
  }
  .bcn-swo-row__line:hover .bcn-swo-row__verbs,
  .bcn-swo-row__line:focus-within .bcn-swo-row__verbs,
  .bcn-swo-row[open] .bcn-swo-row__verbs {
    opacity: 1;
  }
  .bcn-swo-row__verb {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-050);
    padding: 0;
    border: 0;
    background: none;
    font-family: inherit;
    font-size: var(--font-size-150);
    line-height: 1.4;
    color: var(--color-content-default-secondary);
    cursor: pointer;
    white-space: nowrap;
  }
  .bcn-swo-row__verb:hover {
    color: var(--color-content-brand);
    text-decoration: underline;
  }
  .bcn-swo-row__verb--remove:hover {
    color: var(--color-content-utility-danger);
  }
  .bcn-swo-row__verb--view {
    color: var(--color-content-default-tertiary);
  }

  .bcn-swo-row__caret {
    display: inline-flex;
    justify-content: center;
    color: var(--color-content-default-tertiary);
    transition: transform 120ms ease;
  }
  .bcn-swo-row[open] .bcn-swo-row__caret {
    transform: rotate(90deg);
  }

  /* ── The opened record ──────────────────────────────────────────────────── */
  .bcn-swo-row__body {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--spacing-300) var(--spacing-500);
    padding: var(--spacing-300) var(--spacing-300) var(--spacing-400) var(--spacing-700);
    background: var(--color-background-elevation-sunken);
    border-top: 1px solid var(--color-border-default-subtle);
  }
  .bcn-swo-row__body-codes,
  .bcn-swo-row__body-species {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-100);
  }
</style>
