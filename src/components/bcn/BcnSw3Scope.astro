---
// <BcnSw3Scope> — the scope pass, before and during the run. Beacon reads the document's
// table of contents and headings and proposes where the commitments are; the person
// confirms it, edits the page range, or narrows it with a short instruction. The same
// fields steer the run once it has started: a new range applies without a restart.
//
// The instruction goes into every extraction call that follows; here it narrows the
// range when it names a condition ("Condition 11").
//
// Composes: bcn-file-row (the uploaded source), esa-text-field, esa-textarea, esa-button.
//
// bcn-lego-checked: esa-card is a titled content card with its own header type, not a
// proposal line with inline range fields; esa-form-field wraps one control. Checked
// Beacon: prod's setup has no scope pass (it extracts the whole upload). This card is
// the wizard's own; bcn-sw3-scope is its home.
import EsaButton from '@esa/ecology/esa-button.astro';
import BcnFileRow from './BcnFileRow.astro';
import { SOURCE_DOC, SCOPE_PROPOSAL, SCAN_SCOPE, SCOPE_INSTRUCTION_EXAMPLE } from '../../data/setup-wizard-3-step';
import itpPages from '../../data/itp-pages.json';

const counts = itpPages as Record<string, number>;
---

<section class="bcn-sw3scope" data-sw3-scope data-state="proposed">
  <BcnFileRow name={SOURCE_DOC.file} size={`${SOURCE_DOC.pages} pages`} />

  <div class="bcn-sw3scope__proposal">
    <p class="bcn-sw3scope__section typography-title-strong">{SCOPE_PROPOSAL.section}</p>
    <p class="bcn-sw3scope__line typography-body-md" aria-live="polite">
      <span data-scope-pages>Pages {SCOPE_PROPOSAL.first}–{SCOPE_PROPOSAL.last}</span>
      <span data-scope-likely>{SCOPE_PROPOSAL.commitmentsLikely} commitments likely</span>
    </p>
  </div>

  <div class="bcn-sw3scope__fields">
    <esa-text-field data-scope-first label="From page" type="number" size="md" value={String(SCOPE_PROPOSAL.first)}></esa-text-field>
    <esa-text-field data-scope-last label="To page" type="number" size="md" value={String(SCOPE_PROPOSAL.last)}></esa-text-field>
    <esa-textarea
      class="bcn-sw3scope__instruction"
      data-scope-instruction
      label="Instruction"
      size="md"
      rows="1"
      auto-resize
      placeholder={SCOPE_INSTRUCTION_EXAMPLE}></esa-textarea>
    <div class="bcn-sw3scope__go">
      <EsaButton variant="primary" size="md" data-scope-start>Start scan</EsaButton>
      <EsaButton variant="secondary" size="md" data-scope-update>Update scope</EsaButton>
    </div>
  </div>

  <script type="application/json" data-scope-counts set:html={JSON.stringify({ counts, scan: SCAN_SCOPE })} />
</section>

<style>
  .bcn-sw3scope {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-400);
    padding: var(--spacing-500);
    background: var(--color-background-elevation-raised);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-200);
  }

  .bcn-sw3scope__proposal {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--spacing-200) var(--spacing-400);
  }
  .bcn-sw3scope__section,
  .bcn-sw3scope__line { margin: 0; }
  .bcn-sw3scope__line {
    display: flex;
    gap: var(--spacing-400);
    color: var(--color-content-default);
    font-variant-numeric: tabular-nums;
  }

  .bcn-sw3scope__fields {
    display: grid;
    grid-template-columns: 8rem 8rem minmax(16rem, 1fr) auto;
    align-items: end;
    gap: var(--spacing-300);
  }
  .bcn-sw3scope__go { display: flex; gap: var(--spacing-200); }

  /* Before the run: Start. During it: Update steers the run in place. */
  .bcn-sw3scope[data-state='proposed'] [data-scope-update],
  .bcn-sw3scope[data-state='running'] [data-scope-start] { display: none; }

  /* While running, the card is only the steering row: the range and the instruction. */
  .bcn-sw3scope[data-state='running'] {
    padding: var(--spacing-300) var(--spacing-500) var(--spacing-400);
  }
  .bcn-sw3scope[data-state='running'] > :global(.bcn-file-row),
  .bcn-sw3scope[data-state='running'] .bcn-sw3scope__proposal { display: none; }

  @media (max-width: 900px) {
    .bcn-sw3scope__fields { grid-template-columns: 1fr 1fr; }
    .bcn-sw3scope__instruction,
    .bcn-sw3scope__go { grid-column: 1 / -1; }
  }
</style>

<script>
  import '@esa/ecology/esa-text-field';
  import '@esa/ecology/esa-textarea';
  import { initSw3, started, startRun, steer, state } from './sw3-store';

  type Field = HTMLElement & { value: string };
  const root = document.querySelector<HTMLElement>('[data-sw3-scope]');
  if (root) {
    initSw3();
    const first = root.querySelector<Field>('[data-scope-first]')!;
    const last = root.querySelector<Field>('[data-scope-last]')!;
    const instruction = root.querySelector<Field>('[data-scope-instruction]')!;
    const pagesEl = root.querySelector<HTMLElement>('[data-scope-pages]')!;
    const likelyEl = root.querySelector<HTMLElement>('[data-scope-likely]')!;
    const { counts, scan } = JSON.parse(root.querySelector('[data-scope-counts]')!.textContent!) as {
      counts: Record<string, number>;
      scan: { first: number; last: number };
    };

    const likely = (a: number, b: number) => Object.values(counts).filter((p) => p >= a && p <= b).length;
    const read = () => {
      const a = Number(first.value) || scan.first;
      const b = Number(last.value) || scan.last;
      return { first: Math.min(a, b), last: Math.max(a, b), instruction: instruction.value ?? '' };
    };
    const paintLine = () => {
      const s = read();
      pagesEl.textContent = `Pages ${s.first}–${s.last}`;
      likelyEl.textContent = `${likely(s.first, s.last)} commitments likely`;
    };

    // The instruction narrows the range when it names a condition: "Condition 11" is
    // pp. 131–180 in this permit (the scope pass knows where each condition starts).
    const narrow = () => {
      const m = /condition\s+(\d+)|species/i.exec(instruction.value ?? '');
      if (!m) return;
      if (m[1] && m[1] !== '11') return;
      first.value = String(scan.first);
      last.value = String(scan.last);
      paintLine();
    };

    for (const f of [first, last]) f.addEventListener('change', paintLine);
    for (const f of [first, last]) f.addEventListener('input', paintLine);
    instruction.addEventListener('change', narrow);

    // The prototype's run covers pp. 131–180; a wider scope still scans those pages.
    const clamp = (s: ReturnType<typeof read>) => ({
      ...s,
      first: Math.max(scan.first, Math.min(scan.last, s.first)),
      last: Math.min(scan.last, Math.max(scan.first, s.last)),
    });

    root.querySelector('[data-scope-start]')?.addEventListener('click', () => {
      narrow();
      startRun(clamp(read()));
    });
    root.querySelector('[data-scope-update]')?.addEventListener('click', () => steer(clamp(read())));

    const sync = () => {
      root.dataset.state = started() ? 'running' : 'proposed';
      if (started()) {
        const s = state().scope;
        if (document.activeElement !== first) first.value = String(s.first);
        if (document.activeElement !== last) last.value = String(s.last);
        if (!instruction.value && s.instruction) instruction.value = s.instruction;
        paintLine();
      }
    };
    document.addEventListener('sw3:change', sync);
    customElements.whenDefined('esa-text-field').then(sync);
  }
</script>
