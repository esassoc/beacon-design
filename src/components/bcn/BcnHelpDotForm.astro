---
// <BcnHelpDotForm> — the side panel an ESA admin writes a dot in: which spot it sits on,
// a title, a sentence or two, and an optional screenshot. Opens over the Help & Guidance
// drawer, a step above it, the way the drawer's own article reader does.
//
// The screenshot comes from Capture This Spot, which grabs the area around the spot
// (plan item 12; in the prototype it returns a crop made from this page), with an image
// upload as the fallback. Footer: Publish, Save as Draft, Cancel, primary first.
//
// Markup only. The help-dots controller fills it, reads it and closes it; every hook is
// `data-hdf-*`. The preview's alt text is set along with its image.
//
// bcn-lego-checked: the frame IS esa-side-dialog, the fields ARE esa-text-field and
// esa-textarea, the upload IS esa-file-upload, every action IS esa-button. The one owned
// piece is the screenshot preview frame (an image in a bordered box) which no lego
// renders. Checked Beacon: help authoring is a drawer form over the same parts.
// bcn-help-dot-form is the home.
import EsaButton from '@esa/ecology/esa-button.astro';
---

<esa-side-dialog
  class="bcn-hdf"
  data-hdf
  heading="Add Dot"
  position="right"
  show-close-button
>
  <div class="bcn-hdf__body stack" data-gap="lg">
    <div class="stack" data-gap="3xs">
      <span class="bcn-hdf__label typography-label-sm-strong">Spot</span>
      <span class="bcn-hdf__spot typography-body-md" data-hdf-spot></span>
    </div>

    <esa-text-field label="Title" name="hdf-title" size="md" required data-hdf-title></esa-text-field>
    <esa-textarea label="Text" name="hdf-text" size="md" rows="3" data-hdf-text></esa-textarea>

    <div class="stack" data-gap="xs">
      <span class="bcn-hdf__label typography-label-sm-strong">Screenshot</span>
      <figure class="bcn-hdf__shot" data-hdf-shot hidden>
        <img alt="" data-hdf-shot-img />
      </figure>
      <div class="cluster" data-gap="xs">
        <EsaButton variant="ghost" appearance="outline" size="sm" data-hdf-capture>Capture This Spot</EsaButton>
        <span data-hdf-remove-wrap hidden>
          <EsaButton variant="ghost" size="sm" data-hdf-remove>Remove</EsaButton>
        </span>
      </div>
      <esa-file-upload label="Or upload an image" accept="image/*" data-hdf-upload></esa-file-upload>
    </div>
  </div>

  <div slot="footer" class="bcn-hdf__foot cluster" data-gap="xs">
    <EsaButton variant="primary" size="sm" data-hdf-publish>Publish</EsaButton>
    <EsaButton variant="ghost" appearance="outline" size="sm" data-hdf-draft>Save as Draft</EsaButton>
    <EsaButton variant="ghost" size="sm" data-hdf-cancel>Cancel</EsaButton>
  </div>
</esa-side-dialog>

<style>
  /* A step above the guidance drawer (1300/1301), as its article reader sits. */
  .bcn-hdf {
    --z-modal-backdrop: 1302;
    --z-modal: 1303;
    --side-dialog-width: 460px;
  }
  .bcn-hdf__label {
    color: var(--color-content-default);
  }
  .bcn-hdf__spot {
    color: var(--color-content-default-secondary);
  }
  .bcn-hdf__shot {
    margin: 0;
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-200);
    overflow: hidden;
  }
  .bcn-hdf__shot img {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }
  .bcn-hdf__foot {
    justify-content: flex-end;
  }
  .bcn-hdf [hidden] {
    display: none;
  }
</style>
