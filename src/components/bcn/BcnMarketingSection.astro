---
// <BcnMarketingSection> — the homepage's section shell: full-bleed tone band
// (white / light / dark forest-photo), a centered max-width inner column, an
// optional centered BcnSectionIntro header, and scroll-reveal wiring for the
// header and body. Every homepage section sits inside one of these; the page
// itself stays a manifest.
//
// Owns the page-wide reveal contract: [data-reveal] elements (here and in any
// child section component) start shifted+transparent and fade up on entry —
// styled via :global() because slotted children are outside this scope, and
// bound once by the shared setupMarketingReveal controller.
//
// bcn-lego-checked: no esa-* lego is a full-bleed marketing band — esa-container
// is app content width without tone bands; checked Beacon (no marketing site).
// bcn-marketing-section is the reusable shell; CSS is band tone + column glue.
import BcnSectionIntro from './BcnSectionIntro.astro';
import { withBase } from '../../lib/base';

interface Props {
  tone?: 'white' | 'light' | 'forest';
  id?: string;
  eyebrow?: string;
  headline?: string;
  subtext?: string;
}
const { tone = 'white', id, eyebrow, headline, subtext } = Astro.props;
const onDark = tone === 'forest';
const forestImage =
  tone === 'forest' ? `--_forest-image: url(${withBase('/images/marketing/hero-aerial.jpg')})` : undefined;
---

<section class:list={['bcn-mkt-section', `bcn-mkt-section--${tone}`]} id={id} style={forestImage}>
  <div class="bcn-mkt-section__inner">
    {
      headline && (
        <div data-reveal>
          <BcnSectionIntro {eyebrow} headline={headline} subtext={subtext} center onDark={onDark} />
        </div>
      )
    }
    <div data-reveal>
      <slot />
    </div>
  </div>
</section>

<script>
  import { setupMarketingReveal } from './marketing-reveal';
  setupMarketingReveal();
</script>

<style>
  .bcn-mkt-section {
    --_section-pad: clamp(48px, 8vw, 96px);
    padding-block: var(--_section-pad);
  }
  .bcn-mkt-section--white {
    background: var(--color-surface);
  }
  .bcn-mkt-section--light {
    background: var(--color-surface-sunken, var(--color-gray-2));
  }
  /* Dark band: deep forest gradient over the aerial photo (specimen §7). */
  .bcn-mkt-section--forest {
    color: #ffffff;
    background:
      linear-gradient(
        160deg,
        rgba(2, 20, 10, 0.94) 0%,
        rgba(5, 35, 18, 0.92) 40%,
        rgba(8, 50, 28, 0.9) 100%
      ),
      var(--_forest-image) center / cover no-repeat;
  }

  .bcn-mkt-section__inner {
    max-inline-size: 1100px;
    margin-inline: auto;
    padding-inline: var(--spacing-500);
  }

  /* Page-wide scroll-reveal contract — :global so slotted section components'
     own [data-reveal] elements (e.g. staggered cards) pick it up too. */
  :global([data-reveal]) {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 600ms ease,
      transform 600ms ease;
  }
  :global([data-reveal].is-visible) {
    opacity: 1;
    transform: translateY(0);
  }
  :global([data-reveal-delay='1']) {
    transition-delay: 100ms;
  }
  :global([data-reveal-delay='2']) {
    transition-delay: 200ms;
  }
  :global([data-reveal-delay='3']) {
    transition-delay: 300ms;
  }
  @media (prefers-reduced-motion: reduce) {
    :global([data-reveal]) {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
