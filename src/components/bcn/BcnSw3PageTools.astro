---
// <BcnSw3PageTools> — the tools for working on the page by hand, in one bar pinned across
// the top of the page pane. The page is a shared markup surface: Aldo proposes where each
// commitment starts and stops (dashed), a person asserts it (solid). The bar never changes
// shape: a tool that needs a selection is in its place, off until there is one. Only the
// mode and the everyday tools show; the rest wait in More tools.
//
//   Select (V)                 click selects, Shift+click adds, drag moves, handles resize
//   Mark (M)                   one drag draws a commitment the scan missed; Esc cancels
//   Edit ID and name (Enter)   Aldo opens the commitment's ID, name and text
//   Delete (Delete)            the selected boxes on this page; the last box takes the find
//   More tools:
//     Split (S)                a guide follows the pointer inside the selected box; click cuts
//     Merge                    two or more selected become one; the first keeps its ID
//     Continue on next page    the next page, ready to draw this commitment's box there
//     Hide Aldo's boxes (B)    the dashed boxes go, to read the text under them
//   Follow (F)                 the view tracks the page being read
//   Zoom out, in (- +), Fit width (0)
//   Undo, Redo (Cmd+Z, Shift+Cmd+Z)  every edit, recorded in the conversation either way
//
// The keys are borderless, so the bar reads as one strip. In a narrow pane the labels fold
// away and the titles carry them.
// Markup only: the workspace controller (sw3-scan.ts) wires it.
//
// bcn-lego-checked: every control IS esa-button (labeled or icon-only, icons per
// lucide-extra.ts where the registry lacks the glyph), More tools is esa-dropdown-menu. No esa- lego is
// a document-markup toolbar; checked Beacon (source-pdf-viewer has page number and zoom
// only, which this keeps). bcn-sw3-page-tools is the home for "the tools over a source page".
import EsaButton from '@esa/ecology/esa-button.astro';
---

<div class="bcn-sw3tools" data-sw3-tools role="toolbar" aria-label="Page tools">
  <div class="bcn-sw3tools__group">
    <div class="bcn-sw3tools__modes" role="group" aria-label="Mode">
      <EsaButton variant="secondary" size="sm" icon="plus" data-ico="mouse-pointer-2" data-tool="select" title="Select (V)" aria-pressed="true">Select</EsaButton>
      <EsaButton variant="secondary" size="sm" icon="plus" data-ico="square-dashed" data-tool="mark" title="Mark a missed commitment (M)" aria-pressed="false">Mark</EsaButton>
    </div>
    <span class="bcn-sw3tools__rule" aria-hidden="true"></span>
    <EsaButton variant="ghost" size="sm" icon="pencil" iconOnly label="Edit ID and name (Enter)" data-tool="edit" />
    <EsaButton variant="ghost" size="sm" icon="trash-2" iconOnly label="Delete the selected box (Delete)" data-tool="delete" />
    <esa-dropdown-menu position="below-start" data-tools-more>
      <EsaButton variant="ghost" size="sm" icon="plus" data-ico="ellipsis" iconOnly label="More tools" data-tools-more-btn />
    </esa-dropdown-menu>
  </div>
  <div class="bcn-sw3tools__group">
    <EsaButton variant="ghost" size="sm" icon="plus" data-ico="locate" data-tool="follow" title="Follow the scan (F)" aria-pressed="false">Follow</EsaButton>
    <span class="bcn-sw3tools__rule" aria-hidden="true"></span>
    <EsaButton variant="ghost" size="sm" icon="plus" data-ico="zoom-out" iconOnly label="Zoom out (-)" data-tool="zoom-out" />
    <EsaButton variant="ghost" size="sm" data-tool="zoom-fit" title="Fit width (0)">100%</EsaButton>
    <EsaButton variant="ghost" size="sm" icon="plus" data-ico="zoom-in" iconOnly label="Zoom in (+)" data-tool="zoom-in" />
    <span class="bcn-sw3tools__rule" aria-hidden="true"></span>
    <EsaButton variant="ghost" size="sm" icon="plus" data-ico="undo-2" iconOnly label="Undo (Cmd+Z)" data-tool="undo" />
    <EsaButton variant="ghost" size="sm" icon="plus" data-ico="redo-2" iconOnly label="Redo (Shift+Cmd+Z)" data-tool="redo" />
  </div>
</div>

<style>
  .bcn-sw3tools {
    container-type: inline-size;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-300);
    padding: var(--spacing-150, 0.375rem) var(--spacing-200);
    background: var(--color-background-elevation-raised);
    border-bottom: 1px solid var(--color-border-default);
  }
  .bcn-sw3tools[hidden] { display: none; }
  .bcn-sw3tools__group {
    display: flex;
    align-items: center;
    gap: var(--spacing-100);
    min-width: 0;
  }
  /* Keys never squeeze: the mode pair keeps both its names. */
  .bcn-sw3tools :global(esa-button-group),
  .bcn-sw3tools :global(.esa-button),
  .bcn-sw3tools :global(esa-dropdown-menu) { flex: none; }
  /* More tools is dense, as the speed menu is (the lego has no density hook). */
  .bcn-sw3tools :global(esa-dropdown-menu[data-tools-more]) {
    --spacing-200: 0.25rem;
    --spacing-300: 0.5rem;
    --dropdown-menu-min-width: 13rem;
    --typography-body-md-font-size: 0.8125rem;
    --typography-body-md-line-height: 1.3;
    --typography-body-md-font-weight: var(--typography-font-weight-medium);
  }
  .bcn-sw3tools :global([data-tools-more] > *) {
    --spacing-200: 0.5rem;
    --spacing-300: 0.75rem;
  }
  /* The two modes, apart: each its own key. */
  .bcn-sw3tools__modes { display: flex; gap: var(--spacing-100); flex: none; }
  .bcn-sw3tools__rule {
    width: 1px;
    align-self: stretch;
    margin: 2px var(--spacing-100);
    background: var(--color-border-default);
  }
  /* A tool that cannot act now is plainly off, as on the console. */
  .bcn-sw3tools :global([data-tool]:disabled),
  .bcn-sw3tools :global([data-tool] button:disabled) { opacity: 0.38; }
  /* A tool that is on reads as a pressed key. */
  .bcn-sw3tools :global([data-tool][aria-pressed='true']) {
    background: var(--color-background-elevation-sunken);
    box-shadow: inset 0 1px 3px color-mix(in srgb, var(--color-content-default) 22%, transparent);
  }
  /* The zoom readout keeps its width as the number changes. */
  .bcn-sw3tools :global([data-tool='zoom-fit']) { min-width: 3.75rem; font-variant-numeric: tabular-nums; }
  /* A narrow pane: the labels fold away, the titles carry them. */
  @container (max-width: 680px) {
    .bcn-sw3tools :global([data-tool='follow'] .esa-button__label) { display: none; }
  }
  @container (max-width: 520px) {
    .bcn-sw3tools :global([data-tool]:not([data-tool='zoom-fit']) .esa-button__label) { display: none; }
  }
</style>

<script>
  import '@esa/ecology/esa-button-group';
  import '@esa/ecology/esa-dropdown-menu';
</script>
