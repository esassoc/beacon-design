---
// <BcnTrendPanel> — the Compliance Dashboard's "90-Day Trend" panel.
//
// An esa-card shell carrying (1) a three-up esa-stat band (still active /
// resolved / net change over the trailing 90 days) and (2) a compact grouped
// weekly bar-chart: 13 columns, two thin bars per column, all bars scaled
// against ONE shared max across every week AND both series so heights are
// comparable across the whole chart (never renormalized per week).
//
// This is a COHORT/AGING view, not an opened-vs-closed event flow: the caller
// counts each needs-attention/non-compliance observation exactly ONCE, under
// the week it was first reported, split by its CURRENT status — so no
// observation is ever counted in two different weeks or two different bars
// (an earlier version bucketed "resolved" by resolve-date instead, which
// double-counted every resolved item across two different bars).
//
// bcn-lego-checked: this is a bespoke time-series bar viz — there is NO esa-*
// chart lego in Ecology (confirmed catalog check: esa-progress-bar is a single
// fixed-value bar, esa-stat/esa-card are static blocks, esa-badge is a
// fixed-variant chip; nothing plots a series). Same category of gap already
// documented in BcnMonitoringStats.astro (donut + horizontal value bars) and in
// BcnObservationMap / BcnAttentionPanel, the sibling dashboard components built
// alongside this one. Checked Beacon prod — its dashboard charts are bespoke
// SVG/CSS there too. Series COLORS read the semantic status tokens through
// inline `--_c` custom properties (the value-driven idiom from
// BcnMonitoringStats / BcnStatusChip), never a hardcoded hex.
// bcn-trend-panel is the reusable home for this viz.
import EsaCard from '@esa/ecology/esa-card.astro';
import EsaStat from '@esa/ecology/esa-stat.astro';

interface TrendWeek {
  /** Already formatted by the caller, e.g. 'Jul 6'. */
  label: string;
  active: number;
  resolved: number;
}

interface Props {
  /** 13 weekly buckets, oldest first. */
  weeks: TrendWeek[];
}

const { weeks } = Astro.props;

// ── Summary stats: derived here, not passed in.
const activeTotal = weeks.reduce((sum, w) => sum + w.active, 0);
const resolvedTotal = weeks.reduce((sum, w) => sum + w.resolved, 0);
const netChange = activeTotal - resolvedTotal;

// The sign IS the information on net change, so it is always rendered
// (U+2212 MINUS SIGN for the negative case; a bare unsigned number would lie).
const signed = (n: number) => (n > 0 ? `+${n}` : n < 0 ? `−${Math.abs(n)}` : '±0');
const perWeek = (total: number) => `${(total / Math.max(1, weeks.length)).toFixed(1)}/wk average`;
const netCaption =
  netChange > 0 ? 'Backlog growing' : netChange < 0 ? 'Backlog shrinking' : 'Backlog flat';

// ── Bars: scale against the max across ALL weeks and BOTH series (the shared
// group-max technique from BcnMonitoringStats' barWidth(), turned vertical).
// No minimum floor here — a floor would draw a bar for a zero week and lie;
// non-zero bars instead get a 2px CSS min-height so a count of 1 stays visible.
const chartMax = Math.max(1, ...weeks.flatMap((w) => [w.active, w.resolved]));
const barHeight = (value: number) => `${((value / chartMax) * 100).toFixed(1)}%`;

// Two fixed series — declared as data so the bar loop stays uniform and the
// colors travel as token references, not literals.
const series = [
  { key: 'active', label: 'Active', color: 'var(--_c-active)' },
  { key: 'resolved', label: 'Resolved', color: 'var(--_c-resolved)' },
] as const;

// 13 tick labels crowd, so label every other week — and the last week always,
// so the first and last always anchor the visible time range.
const showTick = (i: number) => i % 2 === 0 || i === weeks.length - 1;
---

<EsaCard title="90-Day Trend">
  <div class="bcn-trend stack" data-gap="lg">
    <!-- ── summary band ── -->
    <div class="bcn-trend__stats cluster" data-gap="xl" data-align="start">
      <EsaStat value={activeTotal} label="Still Active (90d)" sub={perWeek(activeTotal)} />
      <EsaStat value={resolvedTotal} label="Resolved (90d)" sub={perWeek(resolvedTotal)} />
      <EsaStat value={signed(netChange)} label="Net change" sub={netCaption} />
    </div>

    <!-- ── weekly grouped bar chart ── -->
    <div class="stack" data-gap="sm">
      <ul class="bcn-trend__legend cluster" data-gap="md">
        {series.map((s) => (
          <li class="bcn-trend__legend-item">
            <span class="bcn-trend__dot" style={`--_c: ${s.color};`}></span>
            <span class="type-label">{s.label}</span>
          </li>
        ))}
      </ul>

      <div class="bcn-trend__chart" style={`--_cols: ${weeks.length};`}>
        <div class="bcn-trend__yaxis type-caption" aria-hidden="true">
          <span>{chartMax}</span>
          <span>0</span>
        </div>

        <div class="bcn-trend__plot" aria-hidden="true">
          {weeks.map((w) => (
            <div
              class="bcn-trend__col"
              title={`${w.label} — ${w.active} still active, ${w.resolved} resolved`}
            >
              <div class="bcn-trend__bars">
                {series.map((s) => (
                  <span
                    class="bcn-trend__bar"
                    style={`--_c: ${s.color}; --_h: ${barHeight(w[s.key])};`}
                    data-zero={w[s.key] === 0 ? '' : null}
                  ></span>
                ))}
              </div>
            </div>
          ))}
        </div>

        <div class="bcn-trend__ticks" aria-hidden="true">
          {weeks.map((w, i) => (
            <span class="bcn-trend__tick type-caption">{showTick(i) ? w.label : ''}</span>
          ))}
        </div>
      </div>

      <!-- The plot is aria-hidden; this table is the accessible reading of the
           same data (and the visible-values relief the low-contrast amber
           series owes against a near-white surface). -->
      <table class="bcn-trend__table">
        <caption>Needs-attention/non-compliance observations by week first reported, trailing 90 days</caption>
        <thead>
          <tr><th scope="col">Week of</th><th scope="col">Still Active</th><th scope="col">Resolved</th></tr>
        </thead>
        <tbody>
          {weeks.map((w) => (
            <tr>
              <th scope="row">{w.label}</th>
              <td>{w.active}</td>
              <td>{w.resolved}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</EsaCard>

<style>
  .bcn-trend {
    /* Series colors and plot geometry are the panel's theming hooks: private
       --_* names reading a public token (or a documented literal) as fallback.
       Still-active reads the same warning/amber used for "Needs Attention"
       chips and dots throughout this dashboard; resolved/closed reads a
       neutral grey, since "resolved" isn't a severity. */
    --_c-active: var(--bcn-trend-active-color, var(--color-warning));
    --_c-resolved: var(--bcn-trend-resolved-color, var(--color-text-tertiary));
    --_plot-h: var(--bcn-trend-plot-height, 132px);
    --_bar-w: var(--bcn-trend-bar-width, 9px);
  }

  /* Stat values and counts stay quiet and aligned. */
  .bcn-trend :global(.esa-stat__value) {
    font-variant-numeric: tabular-nums;
  }

  /* ── legend (identity is never color-alone) ── */
  .bcn-trend__legend {
    list-style: none;
    padding: 0;
  }
  .bcn-trend__legend-item {
    display: flex;
    align-items: center;
    gap: var(--spacing-200);
    color: var(--color-text-secondary);
  }
  .bcn-trend__dot {
    width: 10px;
    height: 10px;
    border-radius: var(--radius-full);
    background: var(--_c);
    flex-shrink: 0;
  }

  /* ── chart frame: y-axis gutter + plot, with the tick row beneath the plot.
     Plot and ticks share the same column template, so labels land under their
     week without any measuring. ── */
  .bcn-trend__chart {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
    column-gap: var(--spacing-200);
    row-gap: var(--spacing-100);
  }

  .bcn-trend__yaxis {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: var(--_plot-h);
    text-align: right;
    color: var(--color-text-secondary);
    font-variant-numeric: tabular-nums;
  }

  .bcn-trend__plot,
  .bcn-trend__ticks {
    grid-column: 2;
    display: grid;
    grid-template-columns: repeat(var(--_cols), minmax(0, 1fr));
    gap: var(--spacing-150);
  }

  /* The only axis line: a recessive baseline the bars sit on. */
  .bcn-trend__plot {
    height: var(--_plot-h);
    border-bottom: 1px solid var(--color-border);
  }

  .bcn-trend__col {
    display: flex;
    align-items: flex-end;
    border-radius: var(--radius-100) var(--radius-100) 0 0;
  }
  .bcn-trend__col:hover {
    background: var(--color-surface-sunken);
  }

  /* The two series bars, centered as a pair with a hair of surface between. */
  .bcn-trend__bars {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 2px;
    width: 100%;
    height: 100%;
  }

  .bcn-trend__bar {
    flex: 0 1 var(--_bar-w);
    height: var(--_h);
    background: var(--_c);
    /* rounded data-end on top, anchored square to the baseline */
    border-radius: var(--radius-100) var(--radius-100) 0 0;
  }
  /* a count of 1 against a tall max would round to nothing — hold a hairline */
  .bcn-trend__bar:not([data-zero]) {
    min-height: 2px;
  }

  .bcn-trend__tick {
    color: var(--color-text-secondary);
    text-align: center;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  /* ── the accessible table reading of the plot (off-screen, still announced) ── */
  .bcn-trend__table {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
