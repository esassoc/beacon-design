---
// <BcnSw3Commitment> — one commitment in step 2, as a marked-up page: its code, name and
// pages, then its text with each requirement highlighted over the words that are its basis,
// in six marker inks taken in turn. What the parse pulled out of those
// words (a species, a milestone, a season) is underlined inside the highlight. Text left
// plain is what nothing will be tracked from: the gap a spot check reads. Plain text the
// review thinks binds is underlined in the warning ink.
//
// The tools, in one bar pinned across the top of the pane, as the PDF's page tools are on
// step 1 (bcn-sw3-page-tools: borderless keys, a tool that needs a selection in its place,
// off until there is one):
//   Select (V)            click a highlight to select it; its ends grow grips to drag
//   Highlight (H)         one drag over free words makes them a new requirement; Esc cancels.
//                         With a wavy-underlined sentence selected (click it), it makes that one.
// A wavy-underlined sentence, clicked, also opens a small card under it: Make a requirement
// (its record opens to edit) and Not binding. Esc or a click elsewhere closes it.
//   Delete (Delete)       the selected requirement, highlight and record
//   Undo, Redo (Cmd+Z, Shift+Cmd+Z)  any change to step 2's record, here, in the rail, in a
//                         side panel or accepted from Aldo; it lands on the commitment it was on
//   p. 131                the source page (a side panel with the PDF)
//   Edit                  the commitment's ID, name and text, in a side panel
//   Confirm               the commitment; Confirmed reopens it
//
// The controller is the review's (sw3-review.ts): this component is markup and look.
//
// `readonly` (step 3's commitment panel): no highlight tools, Edit or Confirm; the keys are
// the source page and Open in Commitments, and the text carries one requirement's excerpt as
// a heavier pass (anchored-text-paint's `lit`).
//
// bcn-lego-checked: the code is bcn-commitment-badge, the keys are esa-button (icons per
// lucide-extra.ts where the registry lacks the glyph), as bcn-sw3-page-tools composes them; the text
// follows bcn-submission-text with the highlight grammar of bcn-comment-topics.css
// (mark.bcn-hl, data-suggested dashed) and its two end grips for resizing. The card on a
// wavy sentence is positioned in the page as the grips are: esa-popover anchors through an
// inline-block wrapper, which would break a sentence that runs across lines. Checked Beacon: its commitment page shows the full
// text plain in a box, with no requirement spans. bcn-sw3-commitment is the home for "one
// source passage, carved into requirements".
import '../../styles/bcn-comment-topics.css';
import EsaButton from '@esa/ecology/esa-button.astro';
import BcnCommitmentBadge from './BcnCommitmentBadge.astro';

interface Props {
  code: string;
  title: string;
  pages: number[];
  /** The painted text (anchored-text-paint.ts), with requirement highlights. */
  html: string;
  /** Read only, from step 3: the page key and Open in Commitments, nothing to change. */
  readonly?: boolean;
}
const { code, title, pages, html, readonly = false } = Astro.props;
const short = (c: string) => c.replace(/^COA\s+/, '');
const pagesLabel = (p: number[]) => (p.length > 1 ? `pp. ${p[0]}–${p.at(-1)}` : `p. ${p[0]}`);
---

<article class="bcn-sw3c" data-c={code} data-mode="select" aria-labelledby={readonly ? 'sw3c-ro-title' : 'sw3c-title'} data-readonly={readonly || undefined}>
  <div class="bcn-sw3c__tools" role="toolbar" aria-label="Commitment tools">
    {readonly ? <span /> : (
      <div class="bcn-sw3c__group">
        <EsaButton variant="secondary" size="sm" icon="plus" data-ico="mouse-pointer-2" data-c-tool="select" title="Select a requirement (V)" aria-pressed="true">Select</EsaButton>
        <EsaButton variant="secondary" size="sm" icon="plus" data-ico="highlighter" data-c-tool="mark" title="Highlight a new requirement (H)" aria-pressed="false">Highlight</EsaButton>
        <span class="bcn-sw3c__rule" aria-hidden="true"></span>
        <EsaButton variant="ghost" size="sm" icon="trash-2" iconOnly label="Delete the selected requirement (Delete)" data-c-tool="delete" />
        <span class="bcn-sw3c__rule" aria-hidden="true"></span>
        <EsaButton variant="ghost" size="sm" icon="plus" data-ico="undo-2" iconOnly label="Undo (Cmd+Z)" data-c-tool="undo" />
        <EsaButton variant="ghost" size="sm" icon="plus" data-ico="redo-2" iconOnly label="Redo (Shift+Cmd+Z)" data-c-tool="redo" />
      </div>
    )}
    <div class="bcn-sw3c__group">
      <span data-c-peek><EsaButton variant="ghost" size="sm" icon="file-text" title="Open the source page" data-c-pages>{pagesLabel(pages)}</EsaButton></span>
      {readonly ? (
        <span data-c-open><EsaButton variant="secondary" size="sm" iconRight="arrow-right">Open in Commitments</EsaButton></span>
      ) : (
        <Fragment>
          <span data-c-edit><EsaButton variant="ghost" size="sm" icon="pencil" iconOnly label="Edit ID, name and text" /></span>
          <span class="bcn-sw3c__rule" aria-hidden="true"></span>
          <span data-c-confirm><EsaButton variant="secondary" size="sm" icon="check">Confirm</EsaButton></span>
          <span data-c-reopen><EsaButton variant="ghost" size="sm" icon="circle-check" title="Reopen the commitment">Confirmed</EsaButton></span>
        </Fragment>
      )}
    </div>
  </div>
  <div class="bcn-sw3c__page" data-c-page>
    <header class="bcn-sw3c__head">
      <span data-c-badge><BcnCommitmentBadge code={short(code)} /></span>
      <h2 class="bcn-sw3c__title" id={readonly ? 'sw3c-ro-title' : 'sw3c-title'} data-c-title>{title}</h2>
    </header>
    <p class="bcn-sw3c__parsing" data-c-parsing hidden>Parsing</p>
    <div class="bcn-sw3c__text" data-c-text set:html={html} />
    <div class="bcn-sw3c__unanchored" data-c-unanchored />
    {!readonly && (
      <div class="bcn-sw3c__pop" data-c-gap-pop role="group" aria-label="Not tracked" hidden>
        <span data-c-gap-track><EsaButton variant="ghost" size="xs">Make a requirement</EsaButton></span>
        <span data-c-gap-not><EsaButton variant="ghost" size="xs">Not binding</EsaButton></span>
      </div>
    )}
    <span class="bcn-sw3c__grip" data-c-grip="start" hidden aria-hidden="true"></span>
    <span class="bcn-sw3c__grip" data-c-grip="end" hidden aria-hidden="true"></span>
  </div>
</article>

<style>
  .bcn-sw3c { display: flex; flex-direction: column; min-height: 100%; }
  /* The tools: one strip pinned across the top of the pane, as the PDF's page tools are. */
  .bcn-sw3c__tools {
    container-type: inline-size;
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--spacing-100) var(--spacing-300);
    padding: var(--spacing-150, 0.375rem) var(--spacing-200);
    background: var(--color-background-elevation-raised);
    border-bottom: 1px solid var(--color-border-default);
  }
  /* A narrow pane: the mode labels fold away, the titles carry them, so the bar stays one row. */
  @container (max-width: 640px) {
    .bcn-sw3c__group :global([data-c-tool] .esa-button__label) { display: none; }
  }
  /* Narrower still: the page key folds to its icon too; its title names the pages. */
  @container (max-width: 540px) {
    .bcn-sw3c__group :global([data-c-pages] .esa-button__label) { display: none; }
    .bcn-sw3c__rule { display: none; }
  }
  .bcn-sw3c__group { display: flex; align-items: center; gap: var(--spacing-100); flex: none; }
  .bcn-sw3c__group > :global(*) { flex: none; }
  .bcn-sw3c__rule { width: 1px; align-self: stretch; margin: 2px var(--spacing-100); background: var(--color-border-default); }
  .bcn-sw3c__tools :global([data-c-tool]:disabled),
  .bcn-sw3c__tools :global([data-c-tool] button:disabled),
  .bcn-sw3c__tools :global(button:disabled) { opacity: 0.38; }
  .bcn-sw3c__tools :global([data-c-tool][aria-pressed='true']) {
    background: var(--color-background-elevation-sunken);
    box-shadow: inset 0 1px 3px color-mix(in srgb, var(--color-content-default) 22%, transparent);
  }
  .bcn-sw3c__page {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-400);
    padding: var(--spacing-500) var(--spacing-600);
  }
  /* Room under the last line for the card on a sentence nothing tracks. */
  .bcn-sw3c:not([data-readonly]) .bcn-sw3c__page { padding-bottom: calc(var(--spacing-500) + 2.5rem); }
  .bcn-sw3c__head { display: flex; align-items: center; gap: var(--spacing-300); }
  .bcn-sw3c__title {
    flex: 1;
    min-width: 0;
    margin: 0;
    font-family: var(--font-decorative, var(--typography-font-family-sans));
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.25;
    text-wrap: balance;
  }
  .bcn-sw3c:not([data-confirmed]) [data-c-reopen],
  .bcn-sw3c[data-confirmed] [data-c-confirm] { display: none; }
  .bcn-sw3c__parsing { margin: 0; color: var(--color-content-default-tertiary); }

  /* The text: Beacon's document voice. */
  .bcn-sw3c__text {
    font-family: var(--font-decorative, var(--typography-font-family-sans));
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-content-default);
  }
  .bcn-sw3c__text[hidden] { display: none; }
  .bcn-sw3c__text :global(p) { margin: 0 0 var(--spacing-400) 0; max-width: 70ch; white-space: pre-line; }
  .bcn-sw3c__text :global(p:last-child) { margin-bottom: 0; }

  /* A requirement: a highlighter stroke over its words, drawn by hand (the marker
     strokes are theme tokens: an SVG stretched to each line, so every line of a requirement is
     its own pen stroke, ragged at the ends, uneven along its edges). No borders. Requirements
     take the six inks in turn, in text order; selected is a heavier pass. */
  .bcn-sw3c__text :global(mark.bcn-hl) {
    cursor: pointer;
    color: inherit;
    outline: none;
    text-decoration: none;
    box-shadow: none;
    background: var(--bcn-marker-1) 0 60% / 100% 96% no-repeat;
    padding: 0 0.3em;
    margin: 0 -0.22em;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    transition: opacity 120ms ease;
  }
  .bcn-sw3c__text :global(mark.bcn-hl[data-ink='2']) { background-image: var(--bcn-marker-2); background-position: 0 50%; }
  .bcn-sw3c__text :global(mark.bcn-hl[data-ink='3']) { background-image: var(--bcn-marker-3); }
  .bcn-sw3c__text :global(mark.bcn-hl[data-ink='4']) { background-image: var(--bcn-marker-4); background-position: 0 50%; }
  .bcn-sw3c__text :global(mark.bcn-hl[data-ink='5']) { background-image: var(--bcn-marker-5); }
  .bcn-sw3c__text :global(mark.bcn-hl[data-ink='6']) { background-image: var(--bcn-marker-6); background-position: 0 50%; }
  .bcn-sw3c__text :global(mark.bcn-hl[data-suggested]) { outline: none; text-decoration: none; }
  /* Selected: a heavier pass of the same ink. */
  .bcn-sw3c__text :global(mark.bcn-hl[data-active]) { filter: saturate(1.5) brightness(0.94); box-shadow: none; }
  /* With one in focus, the others' ink fades; their words stay black. */
  .bcn-sw3c__text[data-focus] :global(mark.bcn-hl[data-ink='1']:not([data-active]):not([data-hover])) { background-image: var(--bcn-marker-faint-1); }
  .bcn-sw3c__text[data-focus] :global(mark.bcn-hl[data-ink='2']:not([data-active]):not([data-hover])) { background-image: var(--bcn-marker-faint-2); }
  .bcn-sw3c__text[data-focus] :global(mark.bcn-hl[data-ink='3']:not([data-active]):not([data-hover])) { background-image: var(--bcn-marker-faint-3); }
  .bcn-sw3c__text[data-focus] :global(mark.bcn-hl[data-ink='4']:not([data-active]):not([data-hover])) { background-image: var(--bcn-marker-faint-4); }
  .bcn-sw3c__text[data-focus] :global(mark.bcn-hl[data-ink='5']:not([data-active]):not([data-hover])) { background-image: var(--bcn-marker-faint-5); }
  .bcn-sw3c__text[data-focus] :global(mark.bcn-hl[data-ink='6']:not([data-active]):not([data-hover])) { background-image: var(--bcn-marker-faint-6); }
  /* Highlight: the words a drag selects become a requirement. */
  .bcn-sw3c[data-mode='mark'] .bcn-sw3c__text { cursor: text; }
  .bcn-sw3c[data-mode='mark'] .bcn-sw3c__text ::selection,
  .bcn-sw3c[data-mode='mark'] .bcn-sw3c__text :global(*::selection) { background: var(--bcn-marker-selection); }
  .bcn-sw3c__text :global(mark.bcn-hl[data-dup]) { box-shadow: none; text-decoration: underline wavy var(--bcn-aldo); text-underline-offset: 5px; }

  /* Step 3: the words an index entry rests on (its excerpt), a heavier pass inside the stroke. */
  .bcn-sw3c__text :global(.bcn-at-lit) { font-weight: 600; }
  .bcn-sw3c[data-readonly] .bcn-sw3c__text :global(mark.bcn-hl) { cursor: default; }

  /* What the parse pulled out: underlined where it was read. */
  .bcn-sw3c__text :global(.bcn-at-val) {
    text-decoration: underline solid var(--bcn-topic-amber-ink);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .bcn-sw3c__text :global(.bcn-at-val[data-lit]) {
    background: var(--bcn-topic-amber-3);
    border-radius: 2px;
  }

  /* Plain text the review thinks binds: no requirement covers it, in Aldo's green (his
     question to the person, not an error). Lit from the rail. */
  .bcn-sw3c__text :global(mark.bcn-at-gap) { cursor: pointer; }
  .bcn-sw3c__text :global(mark.bcn-at-gap[data-lit]) { background: color-mix(in srgb, var(--bcn-aldo) 14%, transparent); border-radius: 2px; }
  .bcn-sw3c__text :global(mark.bcn-at-gap) {
    background: none;
    color: inherit;
    text-decoration: underline wavy var(--bcn-aldo);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 5px;
  }

  .bcn-sw3c__text ::selection,
  .bcn-sw3c__text :global(*::selection) { background: color-mix(in srgb, var(--bcn-aldo, var(--color-background-info)) 28%, transparent); }

  /* Resize grips: a bar the height of the line with a knob, at each end of the selected
     requirement (bcn-submission-text's, the text-editor selection handle people know). */
  /* The card on a sentence nothing tracks: under its last line, its two keys. */
  .bcn-sw3c__pop {
    position: absolute;
    z-index: 3;
    display: flex;
    gap: 2px;
    padding: 2px;
    background: var(--color-background-elevation-raised);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-200);
    box-shadow: 0 4px 14px color-mix(in srgb, var(--color-content-default) 14%, transparent);
    font-family: var(--typography-font-family-sans);
  }
  .bcn-sw3c__pop[hidden] { display: none; }
  .bcn-sw3c__grip {
    position: absolute;
    width: 2px;
    margin-left: -1px;
    background: var(--color-content-default);
    cursor: ew-resize;
    touch-action: none;
    z-index: 1;
  }
  .bcn-sw3c__grip[hidden] { display: none; }
  .bcn-sw3c__grip::after {
    content: '';
    position: absolute;
    left: 50%;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--color-content-default);
    border: 2px solid var(--color-background-elevation-raised);
    transform: translateX(-50%);
  }
  .bcn-sw3c__grip[data-c-grip='start']::after { top: -10px; }
  .bcn-sw3c__grip[data-c-grip='end']::after { bottom: -10px; }
  .bcn-sw3c__grip::before { content: ''; position: absolute; inset: -6px -10px; }
  .bcn-sw3c[data-dragging] .bcn-sw3c__text { user-select: none; cursor: ew-resize; }

  .bcn-sw3c__unanchored { display: flex; flex-direction: column; gap: var(--spacing-200); }
  .bcn-sw3c__unanchored:empty { display: none; }
  .bcn-sw3c__unanchored :global(.bcn-sw3c__ghost) {
    margin: 0;
    padding: var(--spacing-300);
    border: 1.5px dashed var(--color-border-warning);
    border-radius: var(--radius-100);
    color: var(--color-content-default-secondary);
    font-size: 0.875rem;
  }
</style>
