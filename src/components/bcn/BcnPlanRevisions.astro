---
// <BcnPlanRevisions> — the revisions screen for a plan (new design, 2026-10-26), after WordPress's revisions screen
// (the 3.6 slider, From / To author cards, "Restore This Revision") and Gutenberg's visual diff (2026: "Show changes",
// a minimap rail of changes, color-coded marks). One screen for both jobs the check-in named: publishing a draft
// ("you wanna see a diff before you do it") and restoring a past version.
//
//   head       what you're reviewing, Show changes, Exit
//   slider     BcnRevisionSlider: Live + every revision of the draft, or every version of the plan
//   cards      From and To, each with avatar, who, when and the change sentence; the To card carries the action
//              (Publish this revision / Restore this version), as WordPress puts Restore on the To side
//   diff       the change list (old dates struck, new dates, the shift, moved or followed) beside the Gantt in the To
//              state with the From positions dashed behind, Jamie's Change column, and a minimap rail of changes
//
// The chart is Jamie's BcnPlanGantt at her compact density: review is for scanning many rows, not grabbing one.
// The runtime is ./plan-revisions.ts.
//
// bcn-lego-checked: actions ARE esa-button, Show changes IS esa-switch-toggle, avatars ARE esa-avatar, the slider IS bcn-revision-slider and the chart IS bcn-plan-gantt. No esa-
// lego is a two-sided version comparison or a change list with struck and new values; checked Beacon (no diff or
// history surface; the replica's publish dialog is a summary, not a comparison). bcn-plan-revisions is the reusable
// home for comparing two states of a plan.
import EsaButton from '@esa/ecology/esa-button.astro';
import BcnRevisionSlider from './BcnRevisionSlider.astro';
import BcnPlanGantt from './BcnPlanGantt.astro';
import BcnChangeNote from './BcnChangeNote.astro';
---

<div class="bcn-prv" data-bcn-plan-revisions>
  <section class="bcn-prv__console">
    <div class="bcn-prv__compare typography-body-sm">
      <span class="bcn-prv__side" data-prv-card="from"><span data-prv-avatar></span><span class="bcn-prv__side-text"><b data-prv-title></b> <span class="bcn-prv__msg" data-prv-msg></span></span><span class="typography-meta" data-prv-when></span></span>
      <span class="bcn-prv__arrow" data-glyph="arrow-right" aria-label="to"></span>
      <span class="bcn-prv__side" data-prv-card="to"><span data-prv-avatar></span><span class="bcn-prv__side-text"><b data-prv-title></b> <span class="bcn-prv__msg" data-prv-msg></span></span><span class="typography-meta" data-prv-when></span></span>
    </div>
    <BcnRevisionSlider />
  </section>

  <div class="bcn-prv__bar">
    <esa-switch-toggle data-prv-show label="Show changes" checked size="sm"></esa-switch-toggle>
    <div data-prv-behind class="bcn-prv__behind typography-body-sm" hidden><span data-glyph="triangle-alert"></span><span data-prv-behind-text></span></div>
    <span class="bcn-prv__spacer"></span>
    <a data-prv-exit><EsaButton variant="ghost" size="sm" icon="x">Exit</EsaButton></a>
    <span data-prv-act><EsaButton variant="primary" size="sm" icon="git-merge" data-fill-icon="git-merge"><span data-prv-act-label>Publish</span></EsaButton></span>
  </div>

  <div class="bcn-prv__diff">
    <aside class="bcn-prv__changes" aria-label="Changes">
      <header class="bcn-prv__changes-head"><span class="typography-label-md-strong">Changes</span><span data-prv-summary></span></header>
      <ul data-prv-list></ul>
    </aside>
    <div class="bcn-prv__canvas">
      <BcnPlanGantt label="Plan compared" />
      <div class="bcn-prv__rail" data-prv-rail aria-label="Changes in the plan"></div>
    </div>
  </div>
</div>

<BcnChangeNote />
<script>
  import '@esa/ecology/esa-switch-toggle';
</script>

<style>
  .bcn-prv { display: flex; flex-direction: column; gap: var(--spacing-400); }
  .bcn-prv :global([hidden]) { display: none !important; }
  .bcn-prv :global([data-glyph]) { display: inline-flex; color: var(--color-content-default-tertiary); }
  .bcn-prv :global([data-glyph] svg) { display: block; }

  /* The console: the setup wizard's step panel, From → To over the slider. */
  .bcn-prv__console {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-400);
    padding: var(--spacing-400);
    background: var(--color-background-elevation-raised);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-200);
    box-shadow: var(--elevation-2);
  }
  .bcn-prv__compare { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; gap: var(--spacing-300); }
  .bcn-prv__side { display: flex; align-items: center; gap: var(--spacing-200); min-inline-size: 0; }
  .bcn-prv__side-text { min-inline-size: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .bcn-prv__side b { font-weight: 600; }
  .bcn-prv__msg { color: var(--color-content-default-secondary); }
  .bcn-prv__side .typography-meta { margin-inline-start: auto; white-space: nowrap; color: var(--color-content-default-secondary); }

  .bcn-prv__bar { display: flex; align-items: center; gap: var(--spacing-300); flex-wrap: wrap; }
  .bcn-prv__bar a { text-decoration: none; }
  .bcn-prv__spacer { flex: 1; }
  .bcn-prv__behind { display: inline-flex; align-items: center; gap: var(--spacing-150); color: var(--color-content-default-secondary); }
  .bcn-prv__behind [data-glyph] { color: var(--color-content-utility-warning); }

  .bcn-prv__diff { display: grid; grid-template-columns: 20rem minmax(0, 1fr); gap: var(--spacing-400); align-items: start; }
  .bcn-prv__changes {
    position: sticky;
    top: var(--spacing-400);
    max-block-size: calc(100vh - 8rem);
    overflow: auto;
    background: var(--color-background-elevation-raised);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-200);
    box-shadow: var(--elevation-2);
  }
  .bcn-prv__changes-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--spacing-200) var(--spacing-400);
    background: var(--color-background-elevation-sunken);
    border-block-end: 1px solid var(--color-border-default);
    position: sticky;
    top: 0;
  }
  .bcn-prv__changes ul { list-style: none; margin: 0; padding: var(--spacing-100) var(--spacing-200); display: flex; flex-direction: column; }
  .bcn-prv__changes :global(li + li) { border-block-start: 1px solid var(--color-border-default-subtle); }
  .bcn-prv__changes :global(a.bcn-prv__change) {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--spacing-200);
    border-radius: var(--radius-100, 4px);
    color: inherit;
    text-decoration: none;
  }
  .bcn-prv__changes :global(a.bcn-prv__change:hover),
  .bcn-prv__changes :global(a.bcn-prv__change[aria-current='true']) { background: var(--color-background-elevation-sunken); }
  .bcn-prv__changes :global(.bcn-prv__change-top) { display: flex; gap: var(--spacing-200); align-items: baseline; justify-content: space-between; }
  .bcn-prv__changes :global(.bcn-prv__change-name) { font-weight: 600; }
  .bcn-prv__changes :global(.bcn-prv__change-dates) { display: flex; flex-wrap: wrap; gap: 0 var(--spacing-200); font-variant-numeric: tabular-nums; color: var(--color-content-default-secondary); }
  /* WordPress's diff, on dates: the old value struck, the new one plain. Colour only on the strike. */
  .bcn-prv__changes :global(del) { text-decoration: line-through; text-decoration-color: var(--color-content-utility-danger); }
  .bcn-prv__changes :global(ins) { text-decoration: none; color: var(--color-content-default); }
  .bcn-prv__changes :global(.bcn-prv__shift) { font-weight: 600; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .bcn-prv__changes :global(.bcn-prv__cause) { color: var(--color-content-default-secondary); }
  .bcn-prv__changes :global(.bcn-prv__empty) { color: var(--color-content-default-secondary); padding: var(--spacing-300) var(--spacing-200); }

  .bcn-prv__canvas { position: relative; min-inline-size: 0; padding-inline-end: 18px; }
  /* Gutenberg's minimap rail: one mark per changed row, at its place in the plan; click to go to it. */
  .bcn-prv__rail { position: absolute; inset-block: 0; inset-inline-end: 0; inline-size: 10px; background: var(--color-background-elevation-sunken); border-radius: 999px; }
  .bcn-prv__rail :global(a) { position: absolute; inset-inline: 1px; min-block-size: 6px; border-radius: 3px; background: var(--color-content-default-tertiary); }
  .bcn-prv__rail :global(a[data-own]) { background: var(--color-content-default); }
  .bcn-prv__rail :global(a:hover) { opacity: 0.7; }
  .bcn-prv__rail :global(a:focus-visible) { outline: var(--focus-ring-width, 2px) solid var(--focus-ring-color); outline-offset: 1px; }

  @media (max-width: 1100px) {
    .bcn-prv__diff, .bcn-prv__compare { grid-template-columns: 1fr; }
    .bcn-prv__changes { position: static; max-block-size: none; }
  }

  /* The draft-mode concepts (2026-10-27): bench reviews in the same folded frame as the draft it came from: the page
     header steps aside and the chart takes the window's height. */
  :global(html[data-bench] .page-layout) { padding: var(--spacing-400); }
  :global(html[data-bench] .page-layout__breadcrumbs) { display: none; }
  :global(html[data-bench] .page-layout__title) { padding-block: 0 var(--spacing-300); border: 0; }
  :global(html[data-bench] .page-layout__content) { padding-block: 0; }
  :global(html[data-bench]) .bcn-prv { --bcn-plan-gantt-max-height: calc(100vh - 22rem); }
</style>
