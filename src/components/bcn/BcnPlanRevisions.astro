---
// <BcnPlanRevisions> — the revisions screen for a plan (new design, 2026-10-26), after WordPress's revisions screen
// (the 3.6 slider, From / To author cards, "Restore This Revision") and Gutenberg's visual diff (2026: "Show changes",
// a minimap rail of changes, color-coded marks). One screen for both jobs the check-in named: publishing a draft
// ("you wanna see a diff before you do it") and restoring a past version.
//
//   head       what you're reviewing, Show changes, Exit
//   slider     BcnRevisionSlider: Live + every revision of the draft, or every version of the plan
//   cards      From and To, each with avatar, who, when and the change sentence; the To card carries the action
//              (Publish this revision / Restore this version), as WordPress puts Restore on the To side
//   diff       the change list (old dates struck, new dates, the shift, moved or followed) beside the Gantt in the To
//              state with the From positions dashed behind, Jamie's Change column, and a minimap rail of changes
//
// The chart is Jamie's BcnPlanGantt at her compact density: review is for scanning many rows, not grabbing one.
// The runtime is ./plan-revisions.ts.
//
// bcn-lego-checked: actions ARE esa-button, Show changes IS esa-switch-toggle, the behind-Live notice IS
// esa-alert-box, avatars ARE esa-avatar, the slider IS bcn-revision-slider and the chart IS bcn-plan-gantt. No esa-
// lego is a two-sided version comparison or a change list with struck and new values; checked Beacon (no diff or
// history surface; the replica's publish dialog is a summary, not a comparison). bcn-plan-revisions is the reusable
// home for comparing two states of a plan.
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaAlertBox from '@esa/ecology/esa-alert-box.astro';
import BcnRevisionSlider from './BcnRevisionSlider.astro';
import BcnPlanGantt from './BcnPlanGantt.astro';
---

<div class="bcn-prv" data-bcn-plan-revisions>
  <div class="bcn-prv__head">
    <p class="bcn-prv__lede" data-prv-lede></p>
    <span class="bcn-prv__head-actions">
      <esa-switch-toggle data-prv-show label="Show changes" checked></esa-switch-toggle>
      <a data-prv-exit><EsaButton variant="secondary" appearance="outline" size="sm">Exit</EsaButton></a>
    </span>
  </div>

  <section class="bcn-prv__controls">
    <BcnRevisionSlider />
  </section>

  <div class="bcn-prv__cards">
    <article class="bcn-prv__card" data-prv-card="from">
      <span class="bcn-prv__card-label">From</span>
      <div class="bcn-prv__card-who"><span data-prv-avatar></span><span><b data-prv-title></b><small data-prv-when></small></span></div>
      <p data-prv-msg></p>
    </article>
    <article class="bcn-prv__card" data-prv-card="to">
      <span class="bcn-prv__card-label">To</span>
      <div class="bcn-prv__card-who"><span data-prv-avatar></span><span><b data-prv-title></b><small data-prv-when></small></span></div>
      <p data-prv-msg></p>
      <div class="bcn-prv__card-action">
        <span data-prv-act><EsaButton variant="primary" size="sm" icon="git-merge" data-fill-icon="git-merge"><span data-prv-act-label>Publish this revision</span></EsaButton></span>
        <small data-prv-act-note></small>
      </div>
    </article>
  </div>

  <div data-prv-behind hidden>
    <EsaAlertBox variant="warning"><span data-prv-behind-text></span></EsaAlertBox>
  </div>

  <div class="bcn-prv__diff">
    <aside class="bcn-prv__changes" aria-label="What changes">
      <h2 data-prv-summary></h2>
      <p class="bcn-prv__summary-sub" data-prv-summary-sub></p>
      <ul data-prv-list></ul>
    </aside>
    <div class="bcn-prv__canvas">
      <BcnPlanGantt label="Plan compared" />
      <div class="bcn-prv__rail" data-prv-rail aria-label="Changes in the plan"></div>
    </div>
  </div>
</div>

<script>
  import '@esa/ecology/esa-switch-toggle';
</script>

<style>
  .bcn-prv { display: flex; flex-direction: column; gap: var(--spacing-400); }
  .bcn-prv :global([hidden]) { display: none !important; }

  .bcn-prv__head { display: flex; align-items: center; gap: var(--spacing-300); flex-wrap: wrap; }
  .bcn-prv__lede { margin: 0; color: var(--color-content-default-secondary); max-inline-size: 70ch; }
  .bcn-prv__head-actions { margin-inline-start: auto; display: inline-flex; align-items: center; gap: var(--spacing-400); }
  .bcn-prv__head-actions a { text-decoration: none; }

  .bcn-prv__controls {
    padding: var(--spacing-500) var(--spacing-500) var(--spacing-300);
    padding-block-start: var(--spacing-800, 4.5rem);
    background: var(--color-background-elevation-raised);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-300, 8px);
  }

  .bcn-prv__cards { display: grid; grid-template-columns: 1fr 1fr; gap: var(--spacing-400); }
  .bcn-prv__card {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-200);
    padding: var(--spacing-300) var(--spacing-400);
    background: var(--color-background-elevation-raised);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-300, 8px);
    min-inline-size: 0;
  }
  .bcn-prv__card[data-prv-card='from'] { border-inline-start: 4px solid var(--bcn-gray-400); }
  .bcn-prv__card[data-prv-card='to'] { border-inline-start: 4px solid var(--color-background-brand); }
  .bcn-prv__card-label { font-size: var(--font-size-100); font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-content-default-tertiary); }
  .bcn-prv__card-who { display: flex; gap: var(--spacing-200); align-items: center; }
  .bcn-prv__card-who > span:last-child { display: flex; flex-direction: column; }
  .bcn-prv__card-who small { color: var(--color-content-default-tertiary); font-size: var(--font-size-100); }
  .bcn-prv__card p { margin: 0; color: var(--color-content-default-secondary); font-size: var(--font-size-150); }
  .bcn-prv__card-action { display: flex; align-items: center; gap: var(--spacing-300); margin-block-start: auto; padding-block-start: var(--spacing-200); flex-wrap: wrap; }
  .bcn-prv__card-action small { color: var(--color-content-default-tertiary); font-size: var(--font-size-100); }

  .bcn-prv__diff { display: grid; grid-template-columns: 22rem minmax(0, 1fr); gap: var(--spacing-400); align-items: start; }
  .bcn-prv__changes {
    position: sticky;
    top: var(--spacing-400);
    max-block-size: calc(100vh - 8rem);
    overflow: auto;
    background: var(--color-background-elevation-raised);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-300, 8px);
    padding: var(--spacing-400);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-200);
  }
  .bcn-prv__changes h2 { margin: 0; font-size: var(--font-size-300, 1.2rem); font-weight: 600; }
  .bcn-prv__summary-sub { margin: 0; font-size: var(--font-size-150); color: var(--color-content-default-secondary); }
  .bcn-prv__changes ul { list-style: none; margin: var(--spacing-200) 0 0; padding: 0; display: flex; flex-direction: column; }
  .bcn-prv__changes :global(li) { border-block-start: 1px solid var(--color-border-default-subtle); }
  .bcn-prv__changes :global(a.bcn-prv__change) {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: var(--spacing-200) var(--spacing-200);
    margin-inline: calc(-1 * var(--spacing-200));
    border-radius: var(--radius-200, 6px);
    color: inherit;
    text-decoration: none;
    font-size: var(--font-size-150);
  }
  .bcn-prv__changes :global(a.bcn-prv__change:hover),
  .bcn-prv__changes :global(a.bcn-prv__change[aria-current='true']) { background: var(--color-background-brand-subtle, var(--bcn-gray-100)); }
  .bcn-prv__changes :global(.bcn-prv__change-top) { display: flex; gap: var(--spacing-200); align-items: baseline; justify-content: space-between; }
  .bcn-prv__changes :global(.bcn-prv__change-name) { font-weight: 600; }
  .bcn-prv__changes :global(.bcn-prv__change-path) { color: var(--color-content-default-tertiary); font-size: var(--font-size-100); }
  .bcn-prv__changes :global(.bcn-prv__change-dates) { display: flex; flex-direction: column; font-variant-numeric: tabular-nums; font-size: var(--font-size-100); }
  /* WordPress's diff colours, on dates: the old value struck on red, the new one on green. */
  .bcn-prv__changes :global(del) { color: var(--color-content-utility-danger, #b42318); text-decoration: line-through; background: color-mix(in srgb, var(--color-background-utility-danger, #d63638) 8%, transparent); border-radius: 3px; padding: 0 3px; align-self: flex-start; }
  .bcn-prv__changes :global(ins) { color: var(--color-content-utility-success, #146c2e); text-decoration: none; background: color-mix(in srgb, var(--color-background-utility-success, #00a32a) 10%, transparent); border-radius: 3px; padding: 0 3px; align-self: flex-start; }
  .bcn-prv__changes :global(.bcn-prv__shift) { font-weight: 600; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .bcn-prv__changes :global(.bcn-prv__cause) { font-size: var(--font-size-100); color: var(--color-content-default-tertiary); }
  .bcn-prv__changes :global(.bcn-prv__cause[data-own]) { color: var(--color-content-brand); font-weight: 600; }
  .bcn-prv__changes :global(.bcn-prv__empty) { color: var(--color-content-default-tertiary); padding-block: var(--spacing-300); border: 0; }

  .bcn-prv__canvas { position: relative; min-inline-size: 0; padding-inline-end: 22px; }
  /* Gutenberg's minimap rail: one mark per changed row, at its place in the plan; click to go to it. */
  .bcn-prv__rail {
    position: absolute;
    inset-block: 0;
    inset-inline-end: 0;
    inline-size: 14px;
    background: var(--bcn-gray-100);
    border-radius: 999px;
  }
  .bcn-prv__rail :global(a) {
    position: absolute;
    inset-inline: 2px;
    min-block-size: 6px;
    border-radius: 3px;
    background: var(--color-background-utility-warning, #9a7000);
  }
  .bcn-prv__rail :global(a[data-own]) { background: var(--color-background-brand); }
  .bcn-prv__rail :global(a:hover) { opacity: 0.7; }
  .bcn-prv__rail :global(a:focus-visible) { outline: 2px solid var(--color-content-default); outline-offset: 1px; }

  @media (max-width: 1100px) {
    .bcn-prv__diff, .bcn-prv__cards { grid-template-columns: 1fr; }
    .bcn-prv__changes { position: static; max-block-size: none; }
  }
</style>
