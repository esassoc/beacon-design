---
// <BcnRevisionSlider> — a slider over a document's revisions, after WordPress's revisions screen (wp-admin/revision.php,
// revisions.js; 3.6+): one stop per revision, oldest on the left, a tick at each; Previous and Next at the ends
// (disabled at either end); a tooltip card on hover or while scrubbing (avatar, "Revision by Name", time, the change
// sentence); and "Compare any two" — two handles that cannot cross. One handle compares a stop with the one before it.
//
// Domain-free: the host hands it stops ({ author, title, when, message }) and listens for `change`
// ({ from, to, compareTwo }). The runtime is ./revision-slider.ts (setupRevisionSlider).
//
// bcn-lego-checked: Previous / Next ARE esa-button, the compare toggle IS esa-checkbox, the tooltip's avatar IS
// esa-avatar (BcnPlanPeople). No esa- lego is a stepped two-handle slider with ticks and rich stop tooltips:
// esa-range-slider takes one number with no per-stop content, and BcnPlanGanttRange is a date window over a
// mini-map. Checked Beacon (no revisions UI). bcn-revision-slider is the reusable home for scrubbing versions.
import EsaButton from '@esa/ecology/esa-button.astro';
---

<div class="bcn-rvs" data-bcn-revision-slider>
  <div class="bcn-rvs__row">
    <span data-rvs-prev><EsaButton variant="secondary" appearance="outline" size="sm" icon="chevron-left" data-fill-icon="chevron-left">Previous</EsaButton></span>
    <div class="bcn-rvs__track" data-rvs-track>
      <div class="bcn-rvs__rail"></div>
      <div class="bcn-rvs__fill" data-rvs-fill></div>
      <div class="bcn-rvs__ticks" data-rvs-ticks aria-hidden="true"></div>
      <span class="bcn-rvs__handle" data-rvs-handle="from" role="slider" tabindex="0" aria-label="Compare from" hidden></span>
      <span class="bcn-rvs__handle" data-rvs-handle="to" role="slider" tabindex="0" aria-label="Revision"></span>
      <div class="bcn-rvs__tip" data-rvs-tip hidden>
        <span data-rvs-tip-avatar></span>
        <span class="bcn-rvs__tip-body">
          <span class="bcn-rvs__tip-title" data-rvs-tip-title></span>
          <span class="bcn-rvs__tip-when" data-rvs-tip-when></span>
          <span class="bcn-rvs__tip-msg" data-rvs-tip-msg></span>
        </span>
      </div>
    </div>
    <span data-rvs-next><EsaButton variant="secondary" appearance="outline" size="sm" iconRight="chevron-right" data-fill-icon="chevron-right">Next</EsaButton></span>
  </div>
  <div class="bcn-rvs__foot">
    <esa-checkbox data-rvs-compare label="Compare any two revisions"></esa-checkbox>
    <span class="bcn-rvs__count" data-rvs-count></span>
  </div>
</div>

<script>
  import '@esa/ecology/esa-checkbox';
</script>

<style>
  .bcn-rvs { display: flex; flex-direction: column; gap: var(--spacing-200); }
  .bcn-rvs :global([hidden]) { display: none !important; }
  .bcn-rvs__row { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: var(--spacing-400); }
  .bcn-rvs__track { position: relative; block-size: 2.5rem; cursor: pointer; touch-action: none; }
  .bcn-rvs__rail, .bcn-rvs__fill {
    position: absolute;
    inset-inline: 0;
    top: 50%;
    block-size: 6px;
    translate: 0 -50%;
    border-radius: 999px;
  }
  .bcn-rvs__rail { background: var(--bcn-gray-200); box-shadow: inset 0 1px 1px rgb(0 0 0 / 0.08); }
  .bcn-rvs__fill { background: var(--color-background-brand); inset-inline: auto; }
  .bcn-rvs__ticks { position: absolute; inset: 0; pointer-events: none; }
  .bcn-rvs__ticks :global(span) {
    position: absolute;
    top: 50%;
    inline-size: 2px;
    block-size: 14px;
    translate: -50% -50%;
    background: var(--bcn-gray-400);
    border-radius: 1px;
  }
  .bcn-rvs__ticks :global(span[data-labelled]) { background: var(--color-content-utility-success, var(--color-content-brand)); block-size: 18px; }
  .bcn-rvs__ticks :global(span[data-live]) { background: var(--color-content-default); block-size: 18px; }
  /* The handles: the same raised, grabbable language as the tactile Gantt bars. */
  .bcn-rvs__handle {
    position: absolute;
    top: 50%;
    inline-size: 22px;
    block-size: 22px;
    translate: -50% -50%;
    border-radius: 50%;
    background: var(--color-background-elevation-raised);
    border: 2px solid var(--color-background-brand);
    box-shadow: 0 1px 0 rgb(0 0 0 / 0.18), 0 2px 5px rgb(0 0 0 / 0.16);
    cursor: grab;
    transition: box-shadow 120ms ease, scale 120ms ease;
    z-index: 2;
  }
  .bcn-rvs__handle:hover { scale: 1.1; box-shadow: 0 2px 0 rgb(0 0 0 / 0.16), 0 6px 10px rgb(0 0 0 / 0.2); }
  .bcn-rvs__handle:active { cursor: grabbing; scale: 0.96; }
  .bcn-rvs__handle:focus-visible { outline: 3px solid color-mix(in srgb, var(--color-background-brand) 40%, transparent); outline-offset: 2px; }
  .bcn-rvs__handle[data-rvs-handle='from'] { border-color: var(--bcn-gray-500, var(--color-border-strong)); }

  .bcn-rvs__tip {
    position: absolute;
    bottom: calc(100% + 8px);
    translate: -50% 0;
    display: flex;
    gap: var(--spacing-200);
    align-items: flex-start;
    inline-size: max-content;
    max-inline-size: 22rem;
    padding: var(--spacing-200) var(--spacing-300);
    background: var(--color-background-elevation-raised);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-200, 6px);
    box-shadow: var(--shadow-200);
    font-size: var(--font-size-150);
    pointer-events: none;
    z-index: 5;
  }
  .bcn-rvs__tip-body { display: flex; flex-direction: column; gap: 2px; min-inline-size: 0; }
  .bcn-rvs__tip-title { font-weight: 600; }
  .bcn-rvs__tip-when { color: var(--color-content-default-tertiary); font-size: var(--font-size-100); }
  .bcn-rvs__tip-msg { color: var(--color-content-default-secondary); white-space: normal; }

  .bcn-rvs__foot { display: flex; align-items: center; justify-content: space-between; gap: var(--spacing-300); flex-wrap: wrap; }
  .bcn-rvs__count { font-size: var(--font-size-100); color: var(--color-content-default-tertiary); }
  @media (prefers-reduced-motion: reduce) { .bcn-rvs__handle { transition: none; } }
</style>
