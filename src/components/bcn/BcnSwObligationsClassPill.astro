---
// <BcnSwObligationsClassPill> — the obligation CLASS chip (Adhere / Monitor /
// Notify / Roster), the one place the four classes get a colour.
//
// It is esa-pill driven through the lego's own open-set colour axis: `category`
// emits `data-category`, and the pill then reads the PUBLIC --category-2 / -6 /
// -11 trio for fill, border and text. This component supplies that trio per
// class, so the ramp has exactly one home instead of being restated in the tree,
// the stat strip, the toolbar and the editor.
//
// WHY THESE FOUR HUES. Beacon has already spent red, amber, green-teal, azure and
// brand teal on utility status, and the five setup-wizard step colours (#003f5c
// through #f95d6a) run violet → plum → pink → coral, all of them on the step nav
// at the top of this very page. Slate / iris / gold / jade are what is left that
// collides with neither set. They are read at Radix step 2 (a near-white fill) and
// step 11 (the text), which is the quiet pairing — at 402 rows the class has to be
// legible without turning the list into confetti, so the WORD is the signal and
// the colour is the accelerant. Adhere, the 225-row majority, gets the near-neutral
// slate deliberately: the most common class should be the quietest thing on screen.
//
// bcn-lego-checked: esa-pill IS the lego and this composes it rather than replacing
// it — no bespoke chip markup here. What the hub cannot supply is the class→hue
// mapping, because `variant` covers only the six SYSTEM intents (success, danger,
// warning…) and an obligation class is not an intent: Notify is not a warning and
// Roster is not a success. The lego documents `category` as the axis for exactly
// this open set, scoped "by a spoke's theme"; the spoke theme is not this feature's
// to edit, and a four-value vocabulary owned by one feature belongs with the
// feature. Checked Beacon prod: obligations do not exist there yet, so there is no
// class chip to port.
import EsaPill from '@esa/ecology/esa-pill.astro';
import { OBLIGATION_CLASS_LABEL, type ObligationClass } from '../../data/setup-wizard';

interface Props {
  obligationClass: ObligationClass;
  /** Pill size, straight through to esa-pill. */
  size?: 'xs' | 'sm' | 'md' | 'lg';
  /** Appended to the label as a count, e.g. "Adhere 225". Omitted renders the word alone. */
  count?: number;
}
const { obligationClass, size = 'md', count } = Astro.props;
---

<span class="bcn-swo-class" data-class={obligationClass}>
  <EsaPill label={OBLIGATION_CLASS_LABEL[obligationClass]} category={obligationClass} removable={false} size={size} />
  {count !== undefined && <span class="bcn-swo-class__count">{count}</span>}
</span>

<style>
  .bcn-swo-class {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-150);
  }

  /* The public trio esa-pill's [data-category] rule reads. Inherited, so it reaches
     the lego without anyone touching its private --_pill-* surface. */
  .bcn-swo-class[data-class='adhere'] {
    --category-2: var(--color-slate-2);
    --category-6: var(--color-slate-6);
    --category-11: var(--color-slate-11);
  }
  .bcn-swo-class[data-class='monitor'] {
    --category-2: var(--color-iris-2);
    --category-6: var(--color-iris-6);
    --category-11: var(--color-iris-11);
  }
  .bcn-swo-class[data-class='notify'] {
    --category-2: var(--color-gold-2);
    --category-6: var(--color-gold-6);
    --category-11: var(--color-gold-11);
  }
  .bcn-swo-class[data-class='roster'] {
    --category-2: var(--color-jade-2);
    --category-6: var(--color-jade-6);
    --category-11: var(--color-jade-11);
  }

  .bcn-swo-class__count {
    font-size: var(--font-size-200);
    font-weight: var(--typography-font-weight-semibold);
    font-variant-numeric: tabular-nums;
    color: var(--color-content-default);
  }
</style>
