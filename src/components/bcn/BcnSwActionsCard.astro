---
// <BcnSwActionsCard> — one drafted action, as the reviewer has to judge it: what the work
// is, when it happens, how many requirements it covers, whether it is still a draft, and
// the two things that can be done to it.
//
// PROD'S CARD IS A ROW and this one is not. Prod packs chevron, status dot, name, edit
// pencil, a type tag, one tag per phase, a linked-requirement count and a delete x onto a
// single line, and hides the timing entirely — you expand the row to see the requirements
// and open the dialog to see the schedule. Timing is the thing this step now has to get
// right (Stewart, Beacon PM check-in 2026-09-14), so it is promoted onto the card, which
// costs a second line.
//
// EVERY FACT UNDER THE NAME IS LABELED. Prod's tag strip is the packed-metadata
// construction: "Monitoring | Construction | Pre-Construction | 3" is four different
// kinds of thing set side by side with the relation left to the reader, and it reads as
// four tags of equal weight. esa-card's `meta` renders a real definition list, so
// Deadline, Cadence, Phases and Requirements each say what they are.
//
// NO TYPE FIELD: the filter band scopes the whole board to one requirement type, so every
// card on screen carries the same one.
//
// bcn-lego-checked: the card IS esa-card (title + `meta` definition list + actions and
// footer slots); the status IS esa-badge; both verbs ARE esa-button. Checked Ecology for
// a record-card lego with a status and a verb rail — esa-card with its two slots IS that
// lego, which is why this component is a thin composition and not a new primitive — and
// Beacon (.action-card, the row this replaces). bcn-sw-actions-card exists to fix the
// composition in one place across eleven instances.
import EsaBadge from '@esa/ecology/esa-badge.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaCard from '@esa/ecology/esa-card.astro';

interface Props {
  /** The action's name. */
  name: string;
  /** Whether the action has been approved yet. */
  status: 'draft' | 'approved';
  /** How that status is written on the badge. */
  statusLabel: string;
  /** Labeled facts under the name. Rendered by esa-card as a definition list. */
  meta: { label: string; value: string }[];
}
const { name, status, statusLabel, meta } = Astro.props;
---

<div class="bcn-swacard" data-status={status}>
  <EsaCard title={name} meta={meta} variant="outlined" padding="compact">
    <EsaBadge
      slot="actions"
      value={statusLabel}
      variant={status === 'approved' ? 'success' : 'secondary'}
      size="sm"
    />
    <div slot="footer" class="bcn-swacard__verbs">
      <EsaButton variant="ghost" size="sm" icon="pencil">Edit</EsaButton>
      <EsaButton variant="ghost" size="sm" icon="rotate-ccw">Discard</EsaButton>
    </div>
  </EsaCard>
</div>

<style>
  .bcn-swacard :global(.esa-card) {
    /* The board's own frame already draws the outer rule, so the cards inside it read as
       a list rather than a grid of panels. */
    box-shadow: none;
  }
  .bcn-swacard__verbs {
    display: flex;
    align-items: center;
    gap: var(--spacing-150);
  }
  /* An approved action is settled work. It keeps its place in the list and its full
     record, and gives up only emphasis. */
  .bcn-swacard[data-status='approved'] :global(.esa-card) {
    background: var(--color-background-elevation-sunken);
  }
</style>
