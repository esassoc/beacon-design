---
// <BcnSwActionsFooter> — the step's commit bar: how far the review has got, the two bulk
// verbs, and the way out to the next step. Sticky to the bottom of the page, because the
// board scrolls and a commit control you have to scroll to find is a commit control that
// does not get used.
//
// Prod splits these across two per-column footers and glues its progress line together
// with a middot ("2 Approved | 9 Draft"). One bar, and the progress reads as a single
// labeled ratio instead of two counts the reader has to relate.
//
// THE BULK VERBS ACT ON THE FILTERED VIEW, which is why their counts are the drafts on
// screen and not the project's 267. Prod's tooltips said so in prose; here the filter
// band is directly above the board the counts come from, so the scope is visible rather
// than described.
//
// bcn-lego-checked: all three controls ARE esa-button (the last one an <a> via `href`,
// which esa-button renders natively); the progress ratio IS BcnKeyValue. Checked Ecology
// for a sticky action-bar lego (none — esa-app-bar is the top chrome and esa-card's
// footer slot is per-record) and Beacon (.board-col__footer, two of them, which this
// consolidates). bcn-sw-actions-footer is the reusable home for a wizard step's commit
// bar.
import EsaButton from '@esa/ecology/esa-button.astro';
import BcnKeyValue from './BcnKeyValue.astro';

interface Props {
  /** Names the ratio, e.g. "Approved". */
  progressLabel: string;
  /** The ratio itself, e.g. "2 of 11". */
  progressValue: string;
  /** How many drafts the two bulk verbs would act on. */
  pendingCount: number;
  /** Label on the link out to the next step. */
  nextLabel: string;
  /** Where that link goes, already base-prefixed. */
  nextHref: string;
}
const { progressLabel, progressValue, pendingCount, nextLabel, nextHref } = Astro.props;
---

<div class="bcn-swafoot">
  <div class="bcn-swafoot__progress">
    <BcnKeyValue label={progressLabel} value={progressValue} />
  </div>

  <div class="bcn-swafoot__verbs">
    <EsaButton variant="primary" size="md" icon="circle-check">Approve all ({pendingCount})</EsaButton>
    <EsaButton variant="ghost" size="md" icon="rotate-ccw">Discard all ({pendingCount})</EsaButton>
  </div>

  <div class="bcn-swafoot__next">
    <EsaButton variant="secondary" appearance="outline" size="md" iconRight="arrow-right" href={nextHref}>
      {nextLabel}
    </EsaButton>
  </div>
</div>

<style>
  .bcn-swafoot {
    position: sticky;
    bottom: 0;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-300) var(--spacing-400);
    padding: var(--spacing-300) var(--spacing-400);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md);
    background: var(--color-background-elevation-floating);
    box-shadow: 0 -2px 10px rgb(0 0 0 / 6%);
  }
  .bcn-swafoot__progress {
    flex: 0 0 auto;
  }
  .bcn-swafoot__verbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-200);
    margin-left: auto;
  }
  /* The way out sits past a rule, so it never reads as a third bulk verb. */
  .bcn-swafoot__next {
    flex: 0 0 auto;
    padding-left: var(--spacing-400);
    border-left: 1px solid var(--color-border-default-subtle);
  }
</style>
