---
// <BcnSwActionsReceipt> — the drafting receipt: who drafted the rows on this step and
// how many of each came out of the pass. Collapsed on load; the counts are the detail.
//
// This replaces prod's `.ai-panel` on the review step. Prod's panel is a BUILDER — a
// prompt textarea, "Suggest a Prompt", a send button, a species/milestone/activity
// filter tray — because in prod the AI is invoked FROM this screen. The bulk-extraction
// tool now runs outside Beacon and the actions arrive already drafted (Beacon PM
// check-in, 2026-09-14), so everything that COMMISSIONS a pass is gone and only the
// receipt survives: what ran, over what, and what it produced.
//
// THE MARK SITS OUTSIDE THE DISCLOSURE, not in its summary. esa-collapsible's summary
// takes an icon NAME plus optional paths, never a slot, so <BcnAldoMark> cannot be
// placed inside it. Putting the compass glyph on the summary via `iconPaths` would
// render the mark's glyph without the mark's disc, which is a different mark. Setting
// it beside the disclosure keeps the real component.
//
// bcn-lego-checked: the disclosure IS esa-collapsible (native details/summary, no JS);
// every fact inside IS BcnKeyValue, the spoke's read-only label/value tier; the agent
// mark IS BcnAldoMark. Checked Ecology for a "receipt"/"provenance panel" lego (none —
// esa-alert-box is for a message needing acknowledgement, not a collapsed record) and
// Beacon (only the .ai-panel builder this narrows). bcn-sw-actions-receipt is the
// reusable home for the row that pairs the agent mark with its disclosure.
import EsaCollapsible from '@esa/ecology/esa-collapsible.astro';
import BcnAldoMark from './BcnAldoMark.astro';
import BcnKeyValue from './BcnKeyValue.astro';

interface Props {
  /** The drafting tool's own label for itself (DRAFTED_BY on the data module). */
  draftedBy: string;
  /** Labeled counts from the same pass. Rendered as read-only key/value pairs. */
  facts: { label: string; value: string }[];
}
const { draftedBy, facts } = Astro.props;
---

<div class="bcn-swar">
  <BcnAldoMark size="sm" />
  <div class="bcn-swar__panel">
    <EsaCollapsible title={draftedBy}>
      <div class="bcn-swar__facts">
        {facts.map((f) => <BcnKeyValue label={f.label} value={f.value} />)}
      </div>
    </EsaCollapsible>
  </div>
</div>

<style>
  .bcn-swar {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-300);
  }
  /* The mark is 20px; the summary row is taller, so nudge the mark onto its baseline. */
  .bcn-swar > :global(.bcn-aldo-mark) {
    margin-top: var(--spacing-250);
    flex-shrink: 0;
  }
  .bcn-swar__panel {
    flex: 1;
    min-width: 0;
  }
  /* Facts wrap into a row; each pair carries its own label, so the row never needs a
     separator between them. */
  .bcn-swar__facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-300) var(--spacing-600);
  }
</style>
