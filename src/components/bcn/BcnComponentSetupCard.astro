---
// <BcnComponentSetupCard> — "Component setup" on the component dashboard: how much of
// this component's commitment applicability is settled, and the two doors that settle
// it: the setup (source documents, location, species, activities, dates) and the
// Applicable Commitments drawer.
//
// BASELINE: prod's card (BCN-1635): Need a decision with "N actions waiting", Decided
// N / M with its share, a progress bar, Review commitments. Every figure is counted off
// the component's scoped list, so it agrees with the drawer it opens.
//
// WHAT SETUP ADDS: before setup, Start setup is the primary door. After it, the card
// carries the setup's answers as one row of facts, a third figure for the commitments
// recommended not applicable, and Edit setup. Figures and facts are re-read from the
// shared applicability store on every change.
//
// bcn-lego-checked: esa-card is the shell, esa-stat the figures, esa-progress-bar the
// completion, esa-button the doors, BcnKeyValue the setup facts. No esa- "pipeline
// status card"; prod's equivalent is this same card. The CSS is the figure row only.
import EsaCard from '@esa/ecology/esa-card.astro';
import EsaStat from '@esa/ecology/esa-stat.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaProgressBar from '@esa/ecology/esa-progress-bar.astro';
import BcnKeyValue from './BcnKeyValue.astro';
import { SETUP_TOTALS, DECIDED_PERCENT, PENDING_ACTION_COUNT } from '../../data/component-commitments';

interface Props {
  /** DOM id of the Applicable Commitments drawer. */
  opensDrawer: string;
  /** DOM id of the setup dialog. */
  opensSetup: string;
}
const { opensDrawer, opensSetup } = Astro.props;
---

<EsaCard title="Component Setup">
  <div class="bcn-csc stack" data-gap="md" data-csc>
    <div class="bcn-csc__figures">
      <span data-csc-fig="undecided">
        <EsaStat value={String(SETUP_TOTALS.undecided)} label="Need a decision" sub={`${PENDING_ACTION_COUNT} actions waiting`} />
      </span>
      <span data-csc-fig="recommended" hidden>
        <EsaStat value="0" label="Recommended not applicable" sub="From setup" />
      </span>
      <span data-csc-fig="decided">
        <EsaStat value={`${SETUP_TOTALS.decided} / ${SETUP_TOTALS.total}`} label="Decided" sub={`${DECIDED_PERCENT}% of this component`} />
      </span>
    </div>

    <span data-csc-progress>
      <EsaProgressBar value={DECIDED_PERCENT} variant="primary" size="sm" label="Commitments decided" />
    </span>

    {/* The setup's answers, once there are any. One fact per answer. */}
    <div class="bcn-csc__facts" data-csc-facts hidden>
      <BcnKeyValue label="Source documents" size="sm"><span class="bcn-csc__val" data-csc-val="sources"></span></BcnKeyValue>
      <BcnKeyValue label="Species" size="sm"><span class="bcn-csc__val" data-csc-val="species"></span></BcnKeyValue>
      <BcnKeyValue label="Construction Activities" size="sm"><span class="bcn-csc__val" data-csc-val="activities"></span></BcnKeyValue>
      <BcnKeyValue label="Dates" size="sm"><span class="bcn-csc__val" data-csc-val="dates"></span></BcnKeyValue>
    </div>

    <div class="bcn-csc__foot cluster" data-gap="sm">
      <span data-opens={opensSetup} data-csc-start>
        <EsaButton variant="primary">Start Setup</EsaButton>
      </span>
      {/* Two renderings of the one door: outline beside Start Setup, primary once setup
          is done. Only one is ever shown. */}
      <span data-opens={opensDrawer} data-csc-review="secondary">
        <EsaButton variant="ghost" appearance="outline">Review Commitments</EsaButton>
      </span>
      <span data-opens={opensDrawer} data-csc-review="primary" hidden>
        <EsaButton variant="primary">Review Commitments</EsaButton>
      </span>
      <span data-opens={opensSetup} data-csc-edit hidden>
        <EsaButton variant="ghost" appearance="outline">Edit Setup</EsaButton>
      </span>
    </div>
  </div>
</EsaCard>

<script>
  import { applicability as store } from './applicability-store';
  import { SETUP_SOURCES, fmtDate } from '../../data/component-commitments';

  const card = document.querySelector<HTMLElement>('[data-csc]');
  if (card) {
    const stat = (name: string, value: string, sub?: string) => {
      const host = card.querySelector<HTMLElement>(`[data-csc-fig="${name}"]`);
      const v = host?.querySelector<HTMLElement>('.esa-stat__value');
      const s = host?.querySelector<HTMLElement>('.esa-stat__sub');
      if (v) v.textContent = value;
      if (s && sub !== undefined) s.textContent = sub;
      return host;
    };
    const val = (name: string, text: string) => {
      const el = card.querySelector<HTMLElement>(`[data-csc-val="${name}"]`);
      if (el) el.textContent = text;
    };
    const render = () => {
      const f = store.figures();
      const setup = store.getSetup();
      stat('undecided', String(f.undecided), `${f.actionsWaiting} actions waiting`);
      stat('decided', `${f.decided} / ${f.total}`, `${f.percent}% of this component`);
      const rec = stat('recommended', String(f.recommended));
      if (rec) rec.hidden = !setup || f.recommended === 0;

      const bar = card.querySelector<HTMLElement>('[data-csc-progress] .esa-progress-bar');
      const fill = bar?.querySelector<HTMLElement>('.esa-progress-bar__fill');
      if (fill) fill.style.width = `${f.percent}%`;
      const pct = bar?.querySelector<HTMLElement>('.esa-progress-bar__value');
      if (pct) pct.textContent = `${f.percent}%`;
      bar?.setAttribute('aria-valuenow', String(f.percent));

      const facts = card.querySelector<HTMLElement>('[data-csc-facts]')!;
      facts.hidden = !setup;
      if (setup) {
        val('sources', setup.sources.length ? `${setup.sources.length} of ${SETUP_SOURCES.length}` : 'All');
        val('species', String(setup.species.length));
        val('activities', String(setup.activities.length));
        val('dates', `${fmtDate(setup.startDate)} – ${fmtDate(setup.endDate)}`);
      }
      const start = card.querySelector<HTMLElement>('[data-csc-start]');
      const edit = card.querySelector<HTMLElement>('[data-csc-edit]');
      if (start) start.hidden = !!setup;
      if (edit) edit.hidden = !setup;
      card.querySelector<HTMLElement>('[data-csc-review="secondary"]')!.hidden = !!setup;
      card.querySelector<HTMLElement>('[data-csc-review="primary"]')!.hidden = !setup;
    };
    store.subscribe(render);
    render();
  }
</script>

<style>
  .bcn-csc__figures {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: var(--spacing-400);
  }
  .bcn-csc__figures > [hidden] {
    display: none;
  }
  .bcn-csc__facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: var(--spacing-300) var(--spacing-400);
    padding-top: var(--spacing-300);
    border-top: 1px solid var(--color-border-default-subtle);
  }
  .bcn-csc__facts[hidden] {
    display: none;
  }
  .bcn-csc__val {
    font-size: var(--font-size-150);
    font-weight: var(--typography-font-weight-medium);
    color: var(--color-content-default);
  }
  .bcn-csc__foot {
    padding-top: var(--spacing-100);
  }
  .bcn-csc__foot > [hidden] {
    display: none;
  }
</style>
