---
// <BcnComponentSetupCard> — Applicable Commitments on the component dashboard: the
// slim card that says how much of this component's commitment applicability is
// settled, and opens the surface that settles it.
//
// It sits where the project dashboard puts its Setup Wizard card, and for the
// same reason: setup is a PIPELINE with a state, not a work area, so it gets its
// own quiet strip in the main column rather than a fourth module beside
// Tracking / Monitoring / Reporting.
//
// The figures are the point. Prod's tab badge shows a percentage derived from a
// cross product of every component against every commitment in the project, so
// it measures the project, drifts every time a source document gains a
// commitment, and never reaches 100. These three figures are all scoped to THIS
// component and each one names a list the user can actually open — which is the
// minimum bar for a number on a dashboard.
//
// ONE door. This card briefly carried two, plus a link to a side-by-side
// comparison page, while a decision workspace and a triage queue were being
// chosen between. The workspace won on 2026-08-14; the queue and the comparison
// page were deleted, and their argument is preserved in
// docs/component-setup-model-comparison.md. A card offering a choice that has
// already been made is a prototype leaking its own history into the product.
//
// bcn-lego-checked: esa-card is the shell, esa-stat the figures, esa-progress-bar
// the completion, esa-button the door. Checked
// Ecology (no "pipeline status card" lego — esa-stat is a single metric, not a
// carded group) and Beacon prod (its equivalent is a tab badge, not a card).
// bcn-component-setup-card is the reusable home; its own CSS is the figure row.
import EsaCard from '@esa/ecology/esa-card.astro';
import EsaStat from '@esa/ecology/esa-stat.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaProgressBar from '@esa/ecology/esa-progress-bar.astro';

interface Props {
  /** Commitments with no decision on this component. */
  undecided: number;
  /** Of those, the ones that arrived after the last decision was made here. */
  newSince: number;
  /** Decisions made, against the component's whole commitment set. */
  decided: number;
  total: number;
  percent: number;
  /** Formatted date of the last decision, e.g. "Feb 11, 2026". */
  lastReviewed: string;
  /** Actions that would be created if every undecided commitment were applied. */
  pendingActions: number;
  /** DOM id of the drawer this card opens. */
  opensPrimary: string;
}

const {
  undecided,
  newSince,
  decided,
  total,
  percent,
  lastReviewed,
  pendingActions,
  opensPrimary,
} = Astro.props;
---

{/* "Applicable Commitments", matching the drawer it opens — "Component setup" was
    the retired tab's name, and a card that opens a surface should say that surface's
    name. The "N new" badge that sat in the header is gone: the New-since-last-review
    figure is one of the three stats an inch below it. */}
<EsaCard title="Applicable Commitments">
  <div class="bcn-csc stack" data-gap="md">
    <div class="bcn-csc__figures">
      <EsaStat value={String(undecided)} label="Need a decision" sub={`${pendingActions} actions waiting`} />
      <EsaStat value={String(newSince)} label="New since your last review" sub={lastReviewed} />
      <EsaStat value={`${decided} / ${total}`} label="Decided" sub={`${percent}% of this component`} />
    </div>

    <EsaProgressBar value={percent} variant="primary" size="sm" label="Commitments decided" />

    <div class="bcn-csc__foot">
      <span data-opens={opensPrimary}>
        <EsaButton color="primary">Review commitments</EsaButton>
      </span>
    </div>
  </div>
</EsaCard>

<style>
  .bcn-csc__figures {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: var(--spacing-400);
  }
  .bcn-csc__foot {
    padding-top: var(--spacing-100);
  }
</style>
