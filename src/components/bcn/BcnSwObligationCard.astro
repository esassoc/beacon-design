---
// <BcnSwObligationCard> — one obligation in the registry tree, with its requirements
// as children, the way an action card carries its linked requirements. The card line:
// grip, chevron, class tag, the one-line statement, the requirement count, and the
// pencil, copy and × that appear on hover. Clicking the statement or the pencil opens
// the editor drawer; Duplicate (added 2026-09-15) makes a copy of the whole obligation
// beside it, ready to drag into another subcategory; the chevron folds the children. Each child row is a requirement:
// grip, commitment code, name, a faint "also in n actions" when it is, and two hover
// verbs — Duplicate (a copy that can be dragged somewhere else, since a requirement
// may sit in several obligations) and Unlink.
//
// Drag contract (wired by bcn-sw-obligations-tree): the card is draggable as an
// obligation, each child as a requirement; the card line is a drop target for
// requirements. Everything is 13px.
//
// The SHAPE of this card — shell, row, chevron, class chip, title, verbs and the
// requirement children — moved to src/styles/bcn-obligation-card.css on 2026-09-16,
// where it is defined once with <BcnListObligationCard>'s namespace paired into every
// selector. Andy asked for the list's card to present exactly like this one; pairing
// the selectors is what makes that true rather than true-for-now. What is still
// scoped here is what only the REGISTRY card has: the grips, every drag state, the
// empty-requirements message, and the verbs on a requirement row.
//
// bcn-lego-checked: esa-card / esa-list-item carry their own type scale; esa-tree-view
// has no card leaf. Beacon HAS this card shape (action-card + linked requirements).
// The code chip IS BcnCommitmentBadge, the count IS bcn-sw-count-badge, glyphs esa-icon.
import EsaIcon from '@esa/ecology/esa-icon.astro';
import BcnCommitmentBadge from './BcnCommitmentBadge.astro';
import BcnSwCountBadge from './BcnSwCountBadge.astro';
import { OBLIGATION_CLASS_LABEL, STEP_GLYPH, type ObligationNode } from '../../data/setup-wizard';
// The card anatomy this card shares, verbatim, with <BcnListObligationCard>.
import '../../styles/bcn-obligation-card.css';

interface Props {
  obligation: ObligationNode;
  /** Children folded open on load. */
  open?: boolean;
  /**
   * 'review' — setup step 5: grips, drag, the pencil that opens the editor, and the
   * remove/duplicate/unlink verbs.
   * 'browse' — the Obligation Tracking page's registry section: the SAME card, read-only.
   * No grips (nothing moves), no verbs (nothing to decide), and the title links to the
   * duty's record instead of opening an editor that is not on that page.
   */
  mode?: 'review' | 'browse';
}
const { obligation: o, open = false, mode = 'review' } = Astro.props;
const review = mode === 'review';
---

<li class="bcn-swoc" data-swo-card data-id={o.id} data-class={o.class} draggable={review} data-swo-drag={review ? 'obligation' : undefined}>
  <details class="bcn-swoc__node" data-swo-branch open={open}>
    <summary class="bcn-swoc__main" data-swo-drop={review ? 'obligation' : undefined}>
      {review && (
        <esa-tooltip text="Drag to move"><span class="bcn-swoc__grip" aria-hidden="true"><EsaIcon name="grip-vertical" size="xs" paths={STEP_GLYPH['grip-vertical']} /></span></esa-tooltip>
      )}
      <span class="bcn-swoc__chevron" aria-hidden="true"><EsaIcon name="chevron-right" size="sm" /></span>
      <span class="bcn-swoc__class" data-swo-class-tag>{OBLIGATION_CLASS_LABEL[o.class]}</span>
      {review
        ? <button type="button" class="bcn-swoc__title" data-swo-open data-swo-text={o.title}>{o.title}</button>
        : <span class="bcn-swoc__title bcn-swoc__title--static" data-swo-text={o.title}>{o.title}</span>}
      <span data-swo-count="obligation"><BcnSwCountBadge value={o.requirements.length} label={`${o.requirements.length} requirements`} /></span>
      {/* MERGE 2026-09-18: main added Duplicate here while this branch wrapped the verb set in
          `review`. Both are kept — the new verb belongs to setup step 5, and browse mode still
          renders none of them, because nothing on the Tracking page decides anything. */}
      {review && (
        <Fragment>
          <esa-tooltip text="Edit"><button type="button" class="bcn-swoc__verb" aria-label="Edit obligation" data-swo-open>
            <EsaIcon name="square-pen" size="xs" paths={STEP_GLYPH['square-pen']} />
          </button></esa-tooltip>
          <esa-tooltip text="Duplicate"><button type="button" class="bcn-swoc__verb" aria-label="Duplicate obligation" data-swo-dup-card>
            <EsaIcon name="copy" size="xs" paths={STEP_GLYPH.copy} />
          </button></esa-tooltip>
          <esa-tooltip text="Remove"><button type="button" class="bcn-swoc__verb bcn-swoc__verb--danger" aria-label="Remove obligation" data-swo-remove>
            <EsaIcon name="x" size="xs" paths={STEP_GLYPH.x} />
          </button></esa-tooltip>
        </Fragment>
      )}
    </summary>
    <ul class="bcn-swoc__reqs">
      {o.requirements.map((r) => (
        <li class="bcn-swoc__req" draggable={review} data-swo-drag={review ? 'requirement' : undefined} data-req={r.id} data-code={r.code}>
          {review && (
            <esa-tooltip text="Drag to move"><span class="bcn-swoc__grip" aria-hidden="true"><EsaIcon name="grip-vertical" size="xs" paths={STEP_GLYPH['grip-vertical']} /></span></esa-tooltip>
          )}
          <BcnCommitmentBadge code={r.code} size="sm" />
          <span class="bcn-swoc__req-name" data-swo-text={r.name}>{r.name}</span>
          {r.inActions > 0 && <span class="bcn-swoc__also">also in {r.inActions} {r.inActions === 1 ? 'action' : 'actions'}</span>}
          {review && (
            <Fragment>
              <esa-tooltip text="Duplicate"><button type="button" class="bcn-swoc__verb" aria-label="Duplicate requirement" data-swo-dup>
                <EsaIcon name="copy" size="xs" paths={STEP_GLYPH.copy} />
              </button></esa-tooltip>
              <esa-tooltip text="Unlink"><button type="button" class="bcn-swoc__verb bcn-swoc__verb--danger" aria-label="Unlink requirement" data-swo-unlink>
                <EsaIcon name="x" size="xs" paths={STEP_GLYPH.x} />
              </button></esa-tooltip>
            </Fragment>
          )}
        </li>
      ))}
    </ul>
  </details>
</li>

<style>
  /* Everything this card shares with the list's is in bcn-obligation-card.css.
     What is left here is what only the REGISTRY card has, because only it can refile,
     drop, empty out and edit a requirement in place. */

  /* The read-only title is the same line as the button, minus the affordance — it is not
     a control, so it must not look like one. */
  .bcn-swoc__title--static { cursor: default; text-align: left; }

  .bcn-swoc.is-dragging { opacity: 0.4; }
  .bcn-swoc__main.is-over {
    box-shadow: inset 0 0 0 2px var(--color-obligation);
    background: color-mix(in srgb, var(--color-obligation) 6%, transparent);
  }

  .bcn-swoc__grip { display: inline-flex; flex-shrink: 0; color: var(--bcn-gray-400); cursor: grab; }
  .bcn-swoc__grip:active { cursor: grabbing; }

  /* A registry obligation may legitimately be emptied out mid-edit; a list's may not,
     because a list holds the obligation whole or not at all. */
  .bcn-swoc__reqs:empty::after {
    content: 'No requirements — drop one here or remove this obligation.';
    display: block;
    padding: var(--spacing-100) var(--spacing-200);
    color: var(--color-content-default-tertiary);
    font-style: italic;
  }
  .bcn-swoc__req.is-dragging { opacity: 0.4; }
  .bcn-swoc__req.is-new { animation: bcn-obl-flash 900ms ease-out; }
</style>
