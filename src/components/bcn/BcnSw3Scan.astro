---
// <BcnSw3Scan> — step 1's workspace: the controls, the documents, the page being read,
// and Aldo.
//
// The toolbar runs across the top: what the run is doing now, its pace, pause and
// resume, follow, mark missed, and the scrubber of every page in the document. Below it,
// the project's documents (with the commitments found in the open one as slim cards) and
// the page itself, rendered from the PDF, with a box drawn around each commitment as it is
// found and its requirement spans filling in as they parse. Aldo is the panel on the
// right, opened and closed from the toolbar: where each document is scoped, where the run
// stops after its first commitments for a person to check them, and where it is steered.
//
// Each document has its own run, its own conversation and its own record (sw3-store), and
// every run keeps going while another document is in view. A return lands where it is.
//
// Composes: bcn-sw3-toolbar, bcn-sw3-docs, bcn-page-view, bcn-sw3-aldo.
//
// bcn-lego-checked: every control is a lego inside bcn-sw3-toolbar; each column is a bcn-
// component. No esa- lego is a document workspace with a run; checked Beacon (its
// source-pdf-viewer is the page pane alone, bcn-page-view here). bcn-sw3-scan is the home
// for this step's workspace.
import BcnPageView from './BcnPageView.astro';
import BcnSw3Docs from './BcnSw3Docs.astro';
import BcnSw3Aldo from './BcnSw3Aldo.astro';
import BcnSw3Toolbar from './BcnSw3Toolbar.astro';
import { SW3_REVIEW } from '../../data/setup-wizard-3-step';
import { SCAN_DOCS } from '../../data/sw3-docs';
import { withBase } from '../../lib/base';

const payload = { docs: SCAN_DOCS.map((d) => ({ ...d, requirements: [] })) };
---

<section class="bcn-sw3scan" data-sw3-scan data-base={withBase('/')} data-aldo="open">
  <div class="bcn-sw3scan__work">
    <div class="bcn-sw3scan__bar">
      <BcnSw3Toolbar />
    </div>
    <div class="bcn-sw3scan__body">
      <div class="bcn-sw3scan__docs">
        <BcnSw3Docs />
      </div>
      <div class="bcn-sw3scan__page">
        <BcnPageView aspect={1.2941} />
      </div>
    </div>
  </div>

  <div class="bcn-sw3scan__aldo">
    <BcnSw3Aldo review={withBase(SW3_REVIEW)} />
  </div>

  <script type="application/json" data-sw3-payload set:html={JSON.stringify(payload)} />
</section>

<style>
  .bcn-sw3scan {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 22rem;
    gap: var(--spacing-400);
    align-items: start;
  }
  .bcn-sw3scan[data-aldo='closed'] { grid-template-columns: minmax(0, 1fr); }
  .bcn-sw3scan[data-aldo='closed'] .bcn-sw3scan__aldo { display: none; }

  .bcn-sw3scan__work {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-300);
    min-width: 0;
  }
  /* The controls stay in reach while the page scrolls. */
  .bcn-sw3scan__bar {
    position: sticky;
    top: 0;
    z-index: 2;
    padding-top: var(--spacing-200);
    background: var(--color-background-default);
  }

  .bcn-sw3scan__body {
    display: grid;
    grid-template-columns: 15rem minmax(0, 1fr);
    gap: var(--spacing-400);
    align-items: start;
  }

  /* The side columns hold to the viewport; their lists scroll inside them. 52px is
     AppShell's header, above the scroller these columns stick in. */
  .bcn-sw3scan__docs {
    position: sticky;
    top: 9.5rem;
    display: flex;
    flex-direction: column;
    height: calc(100vh - 52px - 9.5rem - var(--spacing-400));
    min-height: 0;
  }
  .bcn-sw3scan__aldo {
    position: sticky;
    top: var(--spacing-200);
    display: flex;
    flex-direction: column;
    height: calc(100vh - 52px - 2 * var(--spacing-400));
    min-height: 0;
  }
  .bcn-sw3scan__aldo > :global(*) { flex: 1; }

  .bcn-sw3scan__page {
    padding: var(--spacing-300);
    background: var(--color-background-elevation-sunken);
    border-radius: var(--radius-200);
    min-width: 0;
  }

  @media (max-width: 1100px) {
    .bcn-sw3scan { grid-template-columns: 1fr; }
    .bcn-sw3scan__body { grid-template-columns: 1fr; }
    .bcn-sw3scan__docs,
    .bcn-sw3scan__aldo { position: static; height: auto; max-height: 32rem; }
  }
</style>

<script>
  import { setupSw3Scan } from './sw3-scan';
  document.querySelectorAll<HTMLElement>('[data-sw3-scan]').forEach(setupSw3Scan);
</script>
