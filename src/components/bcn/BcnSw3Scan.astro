---
// <BcnSw3Scan> — step 1's workspace: the step's header and the scan's controls in one
// panel, then three panes: the source documents and their files, the page of the file in
// view, and Aldo.
//
// The workspace owns the viewport: it is sized to the window below the wizard's stepper,
// and only the three panes scroll, each inside itself. So the controls never scroll away,
// the three panes' tops align, and Aldo's composer is always on screen.
//
// The header holds the step's title and what it is for; the library and Aldo each fold
// into a narrow rail from their own headers (as the app's side nav does). The console is the run's transport (Play, Pause, Stop, Restart) and speed, then
// every page of the file in one strip. Where the run is lives in Aldo, as its status. The
// tools for working on the page by hand sit in a bar across the page pane's top. Reset the
// prototype sits below. Selecting a
// source shows its details (name, reference number, files, upload); selecting a file shows
// its scan: the page, rendered from the PDF, with a box per commitment that a person can
// select, move, resize, redraw or delete. Aldo, on the right, scopes, checks and steers.
//
// Each file has its own run, conversation and record (sw3-store); sources and files are
// sw3-sources.ts. Every run keeps going while another file is in view.
//
// Composes: bcn-sw-step-panel, bcn-sw3-toolbar, bcn-sw3-page-tools, bcn-sw3-sources, bcn-page-view,
// bcn-sw3-source-editor, bcn-sw3-aldo; esa-side-dialog (new source), esa-confirm-dialog
// (deletes), esa-empty-state (no sources).
//
// bcn-lego-checked: every control is a lego; each pane is a bcn- component. No esa- lego is a document
// workspace with a run; checked Beacon (source-pdf-viewer is the page pane alone).
// bcn-sw3-scan is the home for this step's workspace.
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaEmptyState from '@esa/ecology/esa-empty-state.astro';
import EsaIcon from '@esa/ecology/esa-icon.astro';
import BcnSwStepPanel from './BcnSwStepPanel.astro';
import BcnPageView from './BcnPageView.astro';
import BcnSw3Sources from './BcnSw3Sources.astro';
import BcnSw3SourceEditor from './BcnSw3SourceEditor.astro';
import BcnSw3Aldo from './BcnSw3Aldo.astro';
import BcnSw3EditFind from './BcnSw3EditFind.astro';
import BcnSw3Toolbar from './BcnSw3Toolbar.astro';
import BcnSw3PageTools from './BcnSw3PageTools.astro';
import { SW3_REVIEW, SW3_STEPS } from '../../data/setup-wizard-3-step';
import { SCAN_DOCS, SCAN_SOURCES } from '../../data/sw3-docs';
import { withBase } from '../../lib/base';

const STEP = SW3_STEPS[0];
const payload = { docs: SCAN_DOCS.map((d) => ({ ...d, requirements: [] })) };
const sources = {
  sources: SCAN_SOURCES,
  files: SCAN_DOCS.map((d) => ({ id: d.id, file: d.file, pdf: d.pdf, total: d.total })),
};
---

<section class="bcn-sw3scan" data-sw3-scan data-base={withBase('/')} data-aldo="open" data-library="open">
  <div class="bcn-sw3scan__panel">
    <BcnSwStepPanel n={STEP.n} token={STEP.token} intro="Upload permits, contracts, and specifications that contain compliance commitments.">
      <Fragment slot="title"><span>Source Documents</span></Fragment>
      <BcnSw3Toolbar />
    </BcnSwStepPanel>
  </div>

  <div class="bcn-sw3scan__sources">
    <BcnSw3Sources />
    <!-- Collapsed: a narrow rail, as the app's side nav collapses. -->
    <button type="button" class="bcn-sw3scan__rail" data-rail="library" aria-label="Show the library" title="Show the library">
      <EsaIcon name="chevrons-right" size="sm" />
      <span class="bcn-sw3scan__railname">Library</span>
    </button>
  </div>

  <div class="bcn-sw3scan__main">
    <BcnSw3PageTools />
    <div class="bcn-sw3scan__scroll" data-sw3-main>
      <div class="bcn-sw3scan__page" data-sw3-pagepane>
        <BcnPageView aspect={1.2941} />
      </div>
      <BcnSw3SourceEditor />
      <div class="bcn-sw3scan__empty" data-sw3-empty hidden>
        <EsaEmptyState title="No source documents" description="Add a source document, then upload its files." />
        <EsaButton variant="primary" size="sm" icon="plus" data-ico="file-plus" data-empty-new>New source document</EsaButton>
      </div>
    </div>
  </div>

  <div class="bcn-sw3scan__aldo">
    <!-- Folds into its own rail (the panel's), on this section's data-aldo. -->
    <BcnSw3Aldo review={withBase(SW3_REVIEW)} />
  </div>

  <esa-side-dialog heading="New source document" size="md" data-new-dialog>
    <form class="bcn-sw3scan__newform" data-new-form id="sw3-new-form">
      <esa-text-field label="Name" size="sm" required placeholder="Incidental Take Permit" data-new-name></esa-text-field>
      <esa-text-field label="Reference number" size="sm" placeholder="2081-2024-018-00" data-new-ref></esa-text-field>
      <esa-file-upload label="Files" accept=".pdf,application/pdf" multiple max-size-mb="200" data-new-files></esa-file-upload>
    </form>
    <div slot="footer" class="bcn-sw3scan__newfoot">
      <EsaButton variant="secondary" size="sm" data-new-cancel>Cancel</EsaButton>
      <EsaButton variant="primary" size="sm" type="submit" form="sw3-new-form">Create</EsaButton>
    </div>
  </esa-side-dialog>

  <BcnSw3EditFind />

  <esa-confirm-dialog variant="danger" confirm-label="Delete" data-confirm></esa-confirm-dialog>

  <script type="application/json" data-sw3-payload set:html={JSON.stringify(payload)} />
  <script type="application/json" data-sw3-sources-seed set:html={JSON.stringify(sources)} />
</section>
<div class="bcn-sw3scan__reset">
  <EsaButton variant="ghost" size="sm" icon="rotate-ccw" data-sw3-reset>Reset the prototype</EsaButton>
</div>

<style>
  /* The workspace fills the window below the stepper (height set by sw3-scan.ts from where
     it starts); only the panes scroll. On a short window the panes keep 520px of their
     own and the page scrolls to them (sw3-scan.ts, PANES_MIN). */
  .bcn-sw3scan {
    display: grid;
    grid-template-columns: 16rem minmax(0, 1fr) 22rem;
    grid-template-rows: auto minmax(0, 1fr);
    gap: var(--spacing-300);
    height: var(--_fit, calc(100vh - 12rem));
    /* Secondary buttons here are neutral, not brand-tinted: white keys with a gray edge.
       Color is kept for what it means (a primary, a danger, Aldo). */
    --color-background-brand-muted: var(--color-background-elevation-raised);
    --color-background-brand-muted-hover: var(--color-background-elevation-sunken);
    --color-content-on-brand-muted: var(--color-content-default);
  }
  .bcn-sw3scan + .bcn-sw3scan__reset {
    --color-background-brand-muted: var(--color-background-elevation-raised);
    --color-content-on-brand-muted: var(--color-content-default);
  }
  /* Collapsed panels are rails, wide enough for their mark. The page takes the rest, and
     Aldo widens when the library is a rail. */
  .bcn-sw3scan[data-library='closed'] { grid-template-columns: 2.75rem minmax(0, 1fr) 30rem; }
  .bcn-sw3scan[data-aldo='closed'] { grid-template-columns: 16rem minmax(0, 1fr) 2.75rem; }
  .bcn-sw3scan[data-library='closed'][data-aldo='closed'] { grid-template-columns: 2.75rem minmax(0, 1fr) 2.75rem; }
  .bcn-sw3scan[data-library='closed'] .bcn-sw3scan__sources > :global(.bcn-sw3src),
  .bcn-sw3scan__rail { display: none; }
  .bcn-sw3scan[data-library='closed'] .bcn-sw3scan__rail[data-rail='library'] { display: flex; }
  /* Aldo expanded is an overlay: the workspace under it does not move. */
  .bcn-sw3scan__rail {
    flex: 1;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-300);
    padding: var(--spacing-300) 0;
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-200);
    background: var(--color-background-elevation-raised);
    box-shadow: var(--elevation-2);
    color: var(--color-content-default-secondary);
    font: inherit;
    cursor: pointer;
  }
  .bcn-sw3scan__rail:hover { color: var(--color-content-default); background: var(--color-background-elevation-sunken); }
  .bcn-sw3scan__rail:focus-visible { outline: var(--focus-ring-width, 2px) solid var(--focus-ring-color); outline-offset: 2px; }
  .bcn-sw3scan__railname {
    writing-mode: vertical-rl;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-content-default);
  }

  /* Contrast: the step's panel and the library sit up off the page; Aldo has its own glow. */
  .bcn-sw3scan__panel :global(.bcn-swsp) { box-shadow: var(--elevation-3); }

  .bcn-sw3scan__panel { grid-column: 1 / -1; }
  .bcn-sw3scan__reset { display: flex; justify-content: flex-end; padding: var(--spacing-400) 0 var(--spacing-200); }

  .bcn-sw3scan__sources,
  .bcn-sw3scan__main,
  .bcn-sw3scan__aldo {
    min-height: 0;
    display: flex;
    flex-direction: column;
  }
  .bcn-sw3scan__sources > :global(*),
  .bcn-sw3scan__aldo > :global(*) { flex: 1; min-height: 0; }

  /* The page pane: the tools across its top, then the page, which alone scrolls. */
  .bcn-sw3scan__main {
    background: var(--color-background-elevation-sunken);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-200);
    overflow: hidden;
  }
  .bcn-sw3scan__scroll {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    overflow: auto;
  }
  /* The page fills the pane's width at fit (zoom 1); zoomed in, it is wider than the pane
     and the pane scrolls both ways; zoomed out, it sits centered on the gray. */
  .bcn-sw3scan__page {
    width: calc(100% * var(--_zoom, 1));
    margin-inline: auto;
    flex: none;
    padding: var(--spacing-200);
    box-sizing: border-box;
  }
  .bcn-sw3scan__page[hidden] { display: none; }

  .bcn-sw3scan__empty {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-300);
  }
  .bcn-sw3scan__empty[hidden] { display: none; }

  .bcn-sw3scan__newform {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-400);
  }
  .bcn-sw3scan__newfoot { display: flex; justify-content: flex-end; gap: var(--spacing-200); width: 100%; }

  @media (max-width: 1280px) {
    .bcn-sw3scan { grid-template-columns: 14rem minmax(0, 1fr) 20rem; }
    .bcn-sw3scan[data-aldo='closed'] { grid-template-columns: 14rem minmax(0, 1fr) 2.75rem; }
    .bcn-sw3scan[data-library='closed'] { grid-template-columns: 2.75rem minmax(0, 1fr) 26rem; }
    .bcn-sw3scan[data-library='closed'][data-aldo='closed'] { grid-template-columns: 2.75rem minmax(0, 1fr) 2.75rem; }
  }
  @media (max-width: 1100px) {
    .bcn-sw3scan { grid-template-columns: 14rem minmax(0, 1fr); }
    .bcn-sw3scan__aldo { grid-column: 1 / -1; height: 36rem; }
  }
</style>

<script>
  import '@esa/ecology/esa-side-dialog';
  import '@esa/ecology/esa-confirm-dialog';
  import '@esa/ecology/esa-text-field';
  import '@esa/ecology/esa-file-upload';
  import { setupSw3Scan } from './sw3-scan';
  document.querySelectorAll<HTMLElement>('[data-sw3-scan]').forEach(setupSw3Scan);
</script>
