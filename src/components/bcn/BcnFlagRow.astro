---
// <BcnFlagRow> — one feature flag in the Unified Settings flag list, as a
// SELF-DESCRIBING, SELF-SAVING row. The old page was a bare stack of toggles behind a
// single page-wide Save; here every flag carries its own name and plain-language
// description, and the toggle IS the save (flag-rows.ts confirms with a toast). There is
// no page Save button. The changed-date/person line was removed on review (2026-07-30) —
// change history belongs to log surfaces (the home page's Recent changes), not row chrome;
// `flag.lastChanged` stays in the registry unrendered.
//
// DENSITY: this reads as a preference LIST, not a stack of cards — small switch, 15px
// semibold name, 14px description, tight block padding. The name stands alone; the
// PascalCase dbo.FeatureFlag key was dropped on review (2026-07-29) as developer trivia
// in a tenant-facing list, and the right-edge lifecycle/GA chips followed it (also
// 2026-07-29): the page already groups rows under lifecycle headings, so the chip
// re-stated the heading. Remove-at-GA survives as text on the meta line — it is registry
// data, not chrome. `flag.name` and `flag.lifecycle` are still the registry's fields.
//
// The row deliberately owns no card — the page stacks these under lifecycle headings with
// hairline dividers, so this renders as bare grid content with block padding only.
//
// LAYOUT: a 2-column grid — switch beside the name column; description and meta continue
// under the name.
//
// The switch gets no visible label — the row is its label. `label` is still passed, for
// the accessible name (it renders INSIDE the lego's shadow button, so it names the
// control), then hidden with ::part(label) so the title isn't printed twice.
//
// bcn-lego-checked: no esa-* lego is a settings/feature-flag row (esa-card is a generic
// container and would give the row a card it must not have); checked Beacon — the prod
// flag screen is a bare ui-switch list with no per-flag metadata to port. bcn-flag-row is
// the reusable home, composing esa-switch-toggle + type-roles.
import type { FeatureFlag } from '../../data/settings-registry';

interface Props {
  flag: FeatureFlag;
}
const { flag } = Astro.props;

const gaNote = flag.removeAtGa ? `Remove at GA${flag.gaTarget ? ` (${flag.gaTarget})` : ''}` : '';
---

<div
  class="bcn-flag-row"
  data-bcn-flag-row
  data-flag-id={flag.id}
  data-display-name={flag.displayName}
  data-enabled={flag.enabled ? '' : undefined}
>
  <esa-switch-toggle
    class="bcn-flag-row__switch"
    data-bcn-flag-toggle
    label={flag.displayName}
    size="sm"
    checked={flag.enabled ? '' : undefined}
  ></esa-switch-toggle>

  <p class="bcn-flag-row__name type-body">{flag.displayName}</p>

  <p class="bcn-flag-row__desc type-body-small">{flag.description}</p>
  {gaNote && <p class="bcn-flag-row__meta type-caption">{gaNote}</p>}
</div>

<script>
  import '@esa/ecology/esa-switch-toggle';
  import { setupFlagRows } from './flag-rows';
  setupFlagRows();
</script>

<style>
  /* No card, no divider, no background — the page stacks rows and owns the hairlines. */
  .bcn-flag-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: var(--spacing-400);
    row-gap: var(--spacing-100);
    align-items: center;
    padding-block: var(--spacing-250);
  }

  /* Row 1 pairs the switch with the name; rows 2–3 continue the name column. */
  /* display:flex on the HOST is the vertical-centering fix: the lego ships
     :host{display:inline-block}, so its track sits on a text baseline inside an
     inherited line box — the host grows taller than the 18px track and the switch rides
     visibly HIGH beside the name. A flex host has no anonymous line box: host height =
     track height, and the grid's align-items:center then truly centers it. (Hub gap
     filed in NEEDS.md.) */
  .bcn-flag-row__switch {
    grid-column: 1;
    grid-row: 1;
    display: flex;
    align-items: center;
  }
  .bcn-flag-row__name   { grid-column: 2; grid-row: 1; }
  .bcn-flag-row__desc   { grid-column: 2; grid-row: 2; }
  .bcn-flag-row__meta   { grid-column: 2; grid-row: 3; }

  /* Accessible name only — it lives inside the switch's button, so it must stay in the
     a11y tree rather than be display:none'd. :global() around the custom element is the
     repo's proven ::part() idiom; the .bcn-flag-row ancestor keeps it off other switches. */
  .bcn-flag-row :global(esa-switch-toggle)::part(label) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* The display name is the whole line, so weight and ink sit on the paragraph itself.
     type-body's relaxed 1.8 would open a gap between the name and the description under
     it; both are tightened here (a scoped selector outranks the role class). */
  .bcn-flag-row__name {
    margin: 0;
    line-height: 1.4;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
  }
  .bcn-flag-row__desc { margin: 0; line-height: 1.4; color: var(--color-text-secondary); }
  .bcn-flag-row__meta { margin: 0; color: var(--color-text-tertiary); }
</style>
