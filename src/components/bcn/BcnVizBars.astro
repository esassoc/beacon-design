---
// <BcnVizBars> — the horizontal-bar micro-viz for Monitoring Portal dashboard
// widgets: species counts (Nesting Birds), miles by vehicle, hours by equipment
// class, workers by company. One row per category, ranked by the caller.
//
// The row is a three-column grid — name / track / value — and the value owns its
// own right-hand cell. That is the whole point of the primitive: a long category
// name ("Chevrolet Silverado 2500") truncates with an ellipsis and can never push
// the number out of the widget. `variant="code"` swaps the fluid name column for a
// fixed 46px one, which is what four-letter species codes want.
//
// The graphic is REINFORCEMENT, not the content. Every row renders its name and its
// value as real DOM text, so the track is aria-hidden and no offscreen table is
// needed — the spec's accessibility position for the micro-viz set.
//
// bcn-lego-checked: esa-progress-bar is the only bar lego and it is the wrong
// primitive twice over — it renders role="progressbar" with aria-valuenow (a
// completion semantic, not a magnitude comparison between categories), and its fill
// color is fixed to four STATUS variants (primary/success/warning/danger) with no
// hook for the --bcn-mark-* category ramp these widgets require. It also has no
// name/value cells, so five of them stacked would leave the row layout bespoke
// anyway. esa-chart is rejected in spec §8 (a ~2.8MB AG Charts peer dep plus a
// mandatory paired esa-grid text alternative, for five bars in a 1x3 widget).
// Checked Beacon: prod's per-species bars are bespoke SCSS in the dashboard widget,
// not a shared ui-* component. bcn-viz-bars is the reusable home.

export interface BarRow {
  name: string;
  value: number;
  /** CSS color for the fill; absent → the host widget's `--_accent`. */
  color?: string;
}

interface Props {
  rows: BarRow[];
  /** `code` narrows the name column to 46px for fixed-width species codes. */
  variant?: 'code';
  /** Denominator override. Default: the largest value in `rows`. */
  max?: number;
}

const { rows, variant, max } = Astro.props;

// A caller-supplied max lets sibling widgets share a scale; otherwise the tallest
// bar fills the track. Guard the all-zero and empty cases so no row divides by 0.
const denominator = max ?? Math.max(0, ...rows.map((r) => r.value));
const pct = (value: number) =>
  denominator > 0
    ? Math.round(Math.min(100, Math.max(0, (value / denominator) * 100)) * 100) / 100
    : 0;
---

<div class:list={['bcn-viz-bars', variant === 'code' && 'bcn-viz-bars--code']}>
  {
    rows.map((row) => (
      <div class="bcn-viz-bars__row">
        <span class="bcn-viz-bars__name">{row.name}</span>
        <span class="bcn-viz-bars__track" aria-hidden="true">
          <span
            class="bcn-viz-bars__fill"
            style={`width:${pct(row.value)}%${row.color ? `;--_bar-fill:${row.color}` : ''}`}
          />
        </span>
        <span class="bcn-viz-bars__val">{row.value.toLocaleString('en-US')}</span>
      </div>
    ))
  }
</div>

<style>
  .bcn-viz-bars {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-200);
    /* Without this the grid's minmax(0,1fr) name column cannot shrink below its
       content and the truncation never fires. */
    min-width: 0;
  }

  .bcn-viz-bars__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(52px, 1.15fr) auto;
    align-items: center;
    gap: var(--spacing-250);
  }

  .bcn-viz-bars--code .bcn-viz-bars__row {
    grid-template-columns: 46px 1fr auto;
  }

  .bcn-viz-bars__name {
    font-size: var(--font-size-150);
    color: var(--color-content-default-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }

  .bcn-viz-bars__track {
    display: block;
    height: 12px;
    background: var(--color-background-elevation-sunken);
    border-radius: var(--radius-xs);
    overflow: hidden;
  }

  .bcn-viz-bars__fill {
    display: block;
    height: 100%;
    /* --_mono is the widget config's mono color override (spec §10.6) and beats
       everything. Then per-row `color` (inline --_bar-fill), then the host
       widget's --_accent, then secondary content. */
    background: var(--_mono, var(--_bar-fill, var(--_accent, var(--color-content-default-secondary))));
    border-radius: var(--radius-xs);
  }

  .bcn-viz-bars__val {
    font-size: var(--font-size-150);
    font-weight: var(--typography-font-weight-semibold);
    color: var(--color-content-default);
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  /* Track and fill differ only by background, so both flatten to Canvas and every
     bar reads as empty. The numbers beside them still carry the data. */
  @media (forced-colors: active) {
    .bcn-viz-bars__track {
      border: 1px solid CanvasText;
    }
    .bcn-viz-bars__fill {
      background: Highlight;
    }
  }
</style>
