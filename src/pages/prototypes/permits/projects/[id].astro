---
// Permits — a project's Overview: can we break ground on time? The readiness verdict,
// the figures it is judged on, the site-by-site schedule, and what to keep an eye on.
// The permits themselves live on the project's Permits page (List or Board) and its
// Schedule page, each its own item under the project in the rail.
import PermitsLayout from '../../../../permits/layouts/PermitsLayout.astro';
import BcnProjectHeader from '../../../../permits/components/BcnProjectHeader.astro';
import BcnPermitReadiness from '../../../../permits/components/BcnPermitReadiness.astro';
import { PROJECTS, type Project } from '../../../../permits/data/permit-tracker';

export function getStaticPaths() {
  return PROJECTS.map((p) => ({ params: { id: p.id }, props: { project: p } }));
}

interface Props {
  project: Project;
}
const { project } = Astro.props;
---

<!-- manifest:
  layout: PermitsLayout(project, overview) > stack(xl)
  sections:
    - page header -> bcn-project-header      # project name h1, client / no. / PM / construction start; Team, Edit, Share, Add Permit (+ their drawers)
    - readiness   -> bcn-permit-readiness    # verdict, permits issued + mix, expected all issued vs construction start, Sites (Add / edit site), Keep an Eye On
-->

<PermitsLayout title={project.name} active="overview" projectId={project.id}>
  <div class="stack" data-gap="xl">
    <BcnProjectHeader projectId={project.id} actions={['team', 'edit', 'share', 'add']} />
    <BcnPermitReadiness projectId={project.id} editable />
  </div>
</PermitsLayout>
