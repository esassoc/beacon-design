---
// Comments — one comment period's page (Planning module), for the SEA Part 150 study.
// The title is the period; its facts and burn-down sit in a strip beneath it, then every
// submission By date (an inbox) or By topic (the editable topic hierarchy). A row opens
// its submission at /prototypes/comments/<submission id>. State is comments-store
// (sessionStorage); ?reset restores the fixture.
import AppShell from '../../../layouts/AppShell.astro';
import PageLayout from '../../../layouts/PageLayout.astro';
import BcnCommentPeriod from '../../../components/bcn/BcnCommentPeriod.astro';
import BcnSubmissionInbox from '../../../components/bcn/BcnSubmissionInbox.astro';
import { commentsNav, COMMENTS_PROJECT } from '../../../data/comments-nav';
import { COMMENT_PERIOD } from '../../../data/comments';
---

<!-- manifest:
  layout: PageLayout > stack(lg)                      # SPINE
  sections:
    - period facts    -> bcn-comment-period          # opens, closes, response format + compact bcn-comment-burn-down
    - inbox           -> bcn-submission-inbox        # By date inbox / By topic bcn-comments-by-topic
-->

<AppShell title={COMMENT_PERIOD.name} tenantName={COMMENTS_PROJECT.tenant} projectName={COMMENTS_PROJECT.name} navSections={commentsNav()} activeNavId="comments">
  <PageLayout
    title={COMMENT_PERIOD.name}
    icon="notepad-text"
    iconColor="var(--color-content-brand)"
    breadcrumbs={[{ label: 'Planning', href: '#planning' }, { label: 'Comments', href: '#comments' }, { label: COMMENT_PERIOD.name }]}
  >
    <div class="stack" data-gap="lg">
      <BcnCommentPeriod />
      <BcnSubmissionInbox />
    </div>
  </PageLayout>
</AppShell>
