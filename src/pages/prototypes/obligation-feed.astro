---
// Obligation Feed — the Feed half of Kim's Obligation Tracking prototype
// (/prototypes/obligation-tracking), copied onto its own route for a UI polish pass
// that carries the Lists work across (Andy, 2026-09-23). Same fixture, same four views,
// no pivot (cut 2026-09-23); the Registry half stays on Kim's page. Second pass (same day): the feed
// holds RECORDS from every source (src/data/obligation-feed.ts), not only Event Hub events.
import AppShell from '../../layouts/AppShell.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import BcnFeed from '../../components/bcn/BcnFeed.astro';
import BcnComponentPicker from '../../components/bcn/BcnComponentPicker.astro';
import { COMPONENTS } from '../../data/geotech-fixture-bio';
import { STEP_GLYPH } from '../../data/setup-wizard';
import { withBase } from '../../lib/base';

// This prototype's menu (Andy, 2026-09-23): every section collapsed but Tracking, and
// Tracking's links cut to the three things it tracks.
const TRACKING_NAV = [
  { id: 'tracking-actions', label: 'Actions' },
  { id: 'tracking-obligations', label: 'Obligations', href: withBase('/prototypes/obligation-feed') },
  { id: 'tracking-permits', label: 'Permits', href: withBase('/prototypes/permit-tracking') },
];
---

<!-- manifest:
  layout: AppShell > PageLayout                            # SPINE
  sections:
    - title badge     -> bcn-component-picker              # the standard switcher beside the H1 (Andy, 2026-09-23)
    - views           -> bcn-feed                          # All · Important · To-do · Pinned, underline tabs, ?view=
        - each view   -> bcn-feed-workspace                # filter panel + pale rail of bcn-feed-rail-card by date group
            - record  -> bcn-feed-record                   # the open record as a report: header, meta, files, obligations
            - duties  -> bcn-feed-obligation-card          # Lists slim card, Triggered / Evidence mark, pin + remove verbs
        - links       -> bcn-feed-links                    # add-obligations drawer + remove guard, once per page
-->

<AppShell
  title="Obligation Tracking"
  tenantName="DWR"
  projectName="Delta Conveyance"
  activeNavId="tracking-obligations"
  expandedSections={['tracking']}
  sectionItems={{ tracking: TRACKING_NAV }}
>
  <PageLayout
    title="Obligations"
    icon="shield-check"
    iconPaths={STEP_GLYPH['shield-check']}
    breadcrumbs={[{ label: 'Tracking', href: '#tracking' }, { label: 'Obligations' }]}
  >
    <span slot="title-badge">
      <BcnComponentPicker components={COMPONENTS} />
    </span>
    <BcnFeed />
  </PageLayout>
</AppShell>
