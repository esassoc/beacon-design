---
// One list, of any type. The obligation list is the rich one (below); action and
// commitment lists (2026-09-23) are sets of pointers on the same page chrome — the
// same header, rail and add drawer — with <BcnListMemberTree> as their body. A
// Compliance Index list (2026-10-19) has <BcnListIndexTree> as its body and no add
// drawer: it arranges the index's items and adds none. The canonical index has no
// title-row verbs and no Danger Zone; its filing is edited in the setup wizard.
//
// One obligation list.
//
// The list IS the export: a Word document for a construction kickoff, a CSV, and the
// field elements of a Fulcrum form. So this page is where its contents and its wording
// get right — not where the registry gets edited. Members can leave the list, categories
// and subcategories can be renamed for this list alone, and every obligation carries a
// description that overrides the registry's for this output. Nothing here changes the
// registry, and nothing here refiles anything: filing belongs to the registry tree in
// Setup Wizard step 5.
//
// Each obligation and action shows its implementations, one per component, with a
// status filter over them (2026-09-23); a commitment shows its requirements. Every list
// page ends in prod's Danger Zone.
//
// A list may hold the same registry obligation more than once, each copy carrying its own
// wording, so one form can ask about one duty twice. Both copies sit where the registry
// files the obligation, because this page does not refile.
//
// Every value is read from the ObligationList record in src/data/lists.ts. The tree is
// listTree(list); the add drawer is candidateTree(list); the export preview is
// formFields(list). All three are pure derivations, so the JSON a contractor's form is
// built from cannot drift from what this page shows.
import AppShell from '../../../layouts/AppShell.astro';
import PageLayout from '../../../layouts/PageLayout.astro';
import BcnSwCountBadge from '../../../components/bcn/BcnSwCountBadge.astro';
import BcnListActions from '../../../components/bcn/BcnListActions.astro';
import BcnListObligationTree from '../../../components/bcn/BcnListObligationTree.astro';
import BcnListDetailsRail from '../../../components/bcn/BcnListDetailsRail.astro';
import BcnListAddObligations from '../../../components/bcn/BcnListAddObligations.astro';
import BcnListExportPanel from '../../../components/bcn/BcnListExportPanel.astro';
import BcnListEditDetailsDialog from '../../../components/bcn/BcnListEditDetailsDialog.astro';
import BcnListObligationPanel from '../../../components/bcn/BcnListObligationPanel.astro';
import BcnListRequirementPanel from '../../../components/bcn/BcnListRequirementPanel.astro';
import BcnListMemberTree from '../../../components/bcn/BcnListMemberTree.astro';
import BcnListActionPanel from '../../../components/bcn/BcnListActionPanel.astro';
import BcnListAddMembers from '../../../components/bcn/BcnListAddMembers.astro';
import BcnListIndexTree from '../../../components/bcn/BcnListIndexTree.astro';
import BcnListAldo from '../../../components/bcn/BcnListAldo.astro';
import { NEW_LISTS, isNewList } from '../../../data/list-aldo';
import BcnDangerZone from '../../../components/bcn/BcnDangerZone.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import { ITP } from '../../../data/setup-wizard';
import { PROJECT } from '../../../data/project-dashboard';
import {
  ACTION_LISTS,
  COMMITMENT_LISTS,
  COMPLIANCE_INDEX_LISTS,
  LIST_MEMBER_NOUN,
  OBLIGATION_LISTS,
  memberCountLabel,
  type ActionList,
  type CommitmentList,
  type ComplianceIndexList,
  type ObligationList,
} from '../../../data/lists';
import { withBase } from '../../../lib/base';

export function getStaticPaths() {
  return [...OBLIGATION_LISTS, ...ACTION_LISTS, ...COMMITMENT_LISTS, ...COMPLIANCE_INDEX_LISTS, ...NEW_LISTS].map((list) => ({ params: { id: list.id }, props: { list } }));
}

const { list } = Astro.props as { list: ObligationList | ActionList | CommitmentList | ComplianceIndexList };
const index = list.type === 'compliance-index' ? list : null;
// A list the create dialog just made: named from the URL, with Aldo open (BcnListAldo).
const fresh = isNewList(list);
const members = list.type === 'action' || list.type === 'commitment' ? list : null;
// The requirement panel carries only what this page can reach: an action page, every
// requirement any action answers to (the drawer can add any action); a commitment page,
// every requirement. An obligation page keeps the panel's own default.
const reqIds = list.type === 'action'
  ? [...new Set(ITP.actions.flatMap((a) => a.requirementIds))]
  : list.type === 'commitment' ? ITP.requirements.map((r) => r.id) : undefined;
// Prod's wording, with the list's type in it: "Delete this Action List".
const typeTitle = { obligation: 'Obligation', action: 'Action', commitment: 'Commitment', 'compliance-index': 'Compliance Index' }[list.type];
const typeMany = LIST_MEMBER_NOUN[list.type][1];
---

<!-- manifest:
  layout: PageLayout > sidebar(end)                        # SPINE — tree is the content column, rail the aside
  sections:
    - title actions   -> bcn-list-actions                  # Edit details, Add obligations — both neutral outline
    - obligation tree -> bcn-list-obligation-tree          # category > subcategory > bcn-list-obligation-card; rename for this list, remove from list, per-list description
    - aldo            -> bcn-list-aldo                     # above Details on every list but the canonical index: a launcher that opens the Aldo conversation in place; say what the list is for, Aldo proposes, Add fills it
    - details rail    -> bcn-list-details-rail             # the list record: name, description, type, created, last updated, member count
    - export panel    -> bcn-list-export-panel             # Word and CSV on every list; the JSON endpoint (key, URL, formFields preview) on obligation lists only
    - add members     -> bcn-list-add-obligations          # right drawer over candidateTree(list), checkboxes, emits list:members-added
    - edit details    -> bcn-list-edit-details-panel       # right panel, name and description
    - obligation panel-> bcn-list-obligation-panel         # right panel over one member; registry fields read-only, list description the one live control
    - member tree     -> bcn-list-member-tree              # action / commitment lists: By type / By commitment / A–Z (actions), flat (commitments); bcn-list-member-card leaves
    - index tree      -> bcn-list-index-tree               # Compliance Index lists: the list's own category > subcategory outline over the index's actions and obligations
    - action panel    -> bcn-list-action-panel             # right panel over one action; read only, footer links to the action page
    - add members     -> bcn-list-add-members              # action / commitment drawer over memberCandidates(list), emits list:members-added
    - view tabs       -> bcn-list-view-tabs                # esa-tab-layout as a bare switch; ?view= keeps the choice
    - requirement panel-> bcn-list-requirement-panel       # right panel over one requirement row; full text + fields, read only, footer links to the requirement page
    - danger zone     -> bcn-danger-zone + esa-button       # delete this list, behind esa-confirm-dialog (danger); prod's copy, per list type
-->

<AppShell
  title={list.name}
  tenantName={PROJECT.tenant}
  projectName="Delta Conveyance"
  activeNavId="lists"
  expandedSections={['project']}
>
  <PageLayout
    title={list.name}
    icon="notepad-text"
    iconColor="var(--color-content-brand)"
    breadcrumbs={[
      { label: 'Project', href: '#project' },
      { label: 'Lists', href: withBase('/prototypes/lists') },
      { label: list.name },
    ]}
  >
    <Fragment slot="title-badge">
      {/* The tree rewrites this badge on every add and remove, so the header and the
          tree can never report different member counts. */}
      <span data-list-count="title">
        <BcnSwCountBadge value={list.memberCount} label={memberCountLabel(list.type, list.memberCount)} />
      </span>
    </Fragment>
    <Fragment slot="utilities">
      {index
        ? !index.canonical && <BcnListActions addLabel="" />
        : members
        ? <BcnListActions addLabel={`Add ${LIST_MEMBER_NOUN[list.type][1]}`} addEvent="list:add-members" evidence={list.type === 'action' ? LIST_MEMBER_NOUN.action : undefined} />
        : <BcnListActions evidence={LIST_MEMBER_NOUN.obligation} />}
    </Fragment>

    {/* The tree is the content column and the rail is the aside. .sidebar keys those
        two roles off :first-child and :last-child, and Astro emits a component's
        <script> in place — so the tree's own script, not the tree, was the last child
        the content rules landed on. The tree fell back to shrink-to-fit (flex-grow 0)
        and the rail grew into everything left over: measured 546px of tree against
        526px of rail, which is also why a collapsed tree did not fill its column.
        Wrapping the tree puts its script inside the flex item, so the element that
        grows is the tree. data-side="end" keeps the rail on the right while it stays
        first in the DOM. The rail column is a .stack of two cards — the list record,
        then the ways it leaves Beacon — so the aside stays ONE sidebar child. */}
    <div class="stack" data-gap="xl" data-new-list={fresh ? list.name : undefined}>
    <div class="sidebar" data-side="end" data-gap="lg" style="--sidebar-width: 22rem; --sidebar-content-min: 55%;">
      <div class="stack" data-gap="md">
        {!index?.canonical && <BcnListAldo list={list} />}
        <BcnListDetailsRail list={list} />
        <BcnListExportPanel list={list} />
      </div>
      <div>{index ? <BcnListIndexTree list={index} /> : members ? <BcnListMemberTree list={members} /> : <BcnListObligationTree list={list as ObligationList} />}</div>
    </div>

    {!index?.canonical && <BcnDangerZone
      title={`Delete this ${typeTitle} List`}
      description={`Once you delete this list, it will delete all of its metadata and relationships to associated ${typeMany}. There is no going back. Please be certain.`}
    >
      <span data-list-delete><EsaButton variant="danger" appearance="soft">Delete</EsaButton></span>
    </BcnDangerZone>}
    </div>

    {members && <BcnListAddMembers list={members} />}
    {list.type === 'obligation' && <BcnListAddObligations list={list} />}
    {!index?.canonical && <BcnListEditDetailsDialog list={list} />}
    {list.type === 'obligation' && <BcnListObligationPanel list={list} />}
    {list.type === 'action' && <BcnListActionPanel />}
    {!index && <BcnListRequirementPanel ids={reqIds} />}

    <esa-confirm-dialog
      data-list-delete-confirm
      variant="danger"
      heading={`Delete ${list.name}?`}
      message={`The list and its relationships to its ${typeMany} are deleted. The ${typeMany} themselves stay in the project. This cannot be undone.`}
      confirm-label="Delete list"
      cancel-label="Cancel"
      data-lists-href={withBase('/prototypes/lists')}
      style="--z-modal: 1400; --z-modal-backdrop: 1350;"
    ></esa-confirm-dialog>
  </PageLayout>
</AppShell>

<script>
  import '@esa/ecology/esa-confirm-dialog';
  // A new list carries the name and description the create dialog was given, in its URL.
  // They land everywhere the record shows: the title, the crumb, Details and Edit details.
  const page = document.querySelector<HTMLElement>('[data-new-list]');
  const q = new URLSearchParams(location.search);
  if (page && q.get('name')) {
    const name = q.get('name')!;
    const description = q.get('description') ?? '';
    const was = page.dataset.newList ?? '';
    document.title = document.title.replace(was, name);
    document.querySelectorAll<HTMLElement>('h1, .breadcrumbs li:last-child, .breadcrumbs [aria-current]').forEach((el) => {
      const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
      for (let n = walker.nextNode(); n; n = walker.nextNode()) if (n.textContent?.includes(was)) n.textContent = n.textContent.replace(was, name);
    });
    document.querySelectorAll<HTMLElement>('.bcn-ldr .bcn-key-value').forEach((kv) => {
      const key = kv.querySelector('.bcn-key-value__key')?.textContent?.trim();
      const val = kv.querySelector<HTMLElement>('.bcn-key-value__val');
      if (val && key === 'Name') val.textContent = name;
      if (val && key === 'Description' && description) val.textContent = description;
    });
    document.querySelector('[data-list-edit-name]')?.setAttribute('value', name);
    if (description) document.querySelector('[data-list-edit-description]')?.setAttribute('value', description);
  }
  // The prototype deletes nothing; confirming goes back to the index the way a real
  // delete would land.
  const confirm = document.querySelector<HTMLElement & { open: boolean }>('[data-list-delete-confirm]');
  document.querySelector('[data-list-delete]')?.addEventListener('click', () => { if (confirm) confirm.open = true; });
  confirm?.addEventListener('confirm', () => { location.href = confirm.dataset.listsHref ?? '/'; });
</script>
