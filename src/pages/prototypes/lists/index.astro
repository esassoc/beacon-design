---
// Lists — one index for every list on the project, of any type.
//
// A list is a named subset of one of the project's three registries: actions,
// obligations, commitments. Beacon ships Action Lists and Commitment Lists as
// separate nav entries today; this page replaces both with a single index, because
// the thing a user looks for is "the list called X", not "the action list called X".
// The three types keep their own detail surfaces — they are different shapes and are
// deliberately NOT unified into one editor.
//
// The index files them under the registry they draw from: Commitments, Actions,
// Obligations, in the order setup fills those registries. Each heading carries the verb
// that makes a list of its own type.
//
// Only obligation lists have a detail page in this branch; action and commitment rows
// carry stub hrefs.
//
// Every row is read from PROJECT_LISTS in src/data/lists.ts. The action lists and their
// counts are the twelve on the live project.
import AppShell from '../../../layouts/AppShell.astro';
import PageLayout from '../../../layouts/PageLayout.astro';
import BcnListIndexBoard from '../../../components/bcn/BcnListIndexBoard.astro';
import BcnListCreateDialog from '../../../components/bcn/BcnListCreateDialog.astro';
import { PROJECT } from '../../../data/project-dashboard';
---

<!-- manifest:
  layout: PageLayout > stack(md)                      # SPINE
  sections:
    - lists index -> bcn-list-index-board             # keyword search, then three groups, one per registry, each heading carrying its own add verb
    - add list    -> bcn-list-create-dialog           # name and description, preset to the type of the heading that opened it
-->

<AppShell
  title="Lists"
  tenantName={PROJECT.tenant}
  projectName="Delta Conveyance"
  activeNavId="lists"
  expandedSections={['project']}
>
  <PageLayout
    title="Lists"
    icon="notepad-text"
    breadcrumbs={[{ label: 'Project', href: '#project' }, { label: 'Lists' }]}
  >
    <BcnListIndexBoard />
    <BcnListCreateDialog />
  </PageLayout>
</AppShell>
