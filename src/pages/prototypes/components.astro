---
// Components — the component INDEX, level two of the tree (project → components
// → component detail). Formerly at /prototypes/component-dashboard; that route
// now belongs to the per-component dashboard this page routes into.
//
// Its job is deliberately small. From the 2026-08-13 call: "this page itself is
// only useful in getting to a particular component… it doesn't need to do
// anything besides routing people. Beyond that it's very low utility beyond
// setup. Once we get into cross-component comparison, maybe there'll be
// interesting stuff to do here, but not at the moment." So no new utility was
// added — the investment went into making 16 rows SCANNABLE:
//
//   · Each component carries its identity MARK, so you find yours by color and
//     glyph instead of reading sixteen names.
//   · Status is a real colored taxonomy rather than the word "Active".
//   · A MAP view, which the call asked for explicitly. Components overlap on it,
//     and that is correct — they are areas over areas over time in the same
//     place. Color separates them, the way habitat layers do.
//
// TWO views, not three (review, 2026-08-13). A card board briefly sat beside
// these, reading each component as a tracking unit. It was cut: Grid already
// answers "which one do I want" now that the mark and the colored status do the
// scanning, and Map answers "where", which Grid cannot. The board was a second
// answer to the question Grid already answers, and a toggle whose options overlap
// makes someone choose before they know what they are choosing between. Its
// components (bcn-component-board / bcn-component-card) were deleted with it —
// recoverable from git if a cross-component comparison surface ever wants them.
//
// The 16-component set is the default rather than the 7, because sixteen is
// where scanning actually gets hard and therefore where the mark has to earn
// itself. Nav note: this page has MOVED out of Tracking and into the Project
// section, and the Data Catalog's duplicate Components entry is retired — see
// src/data/component-nav.ts.
import AppShell from '../../layouts/AppShell.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaEmptyState from '@esa/ecology/esa-empty-state.astro';
import BcnComponentSummary from '../../components/bcn/BcnComponentSummary.astro';
import BcnComponentGrid from '../../components/bcn/BcnComponentGrid.astro';
import BcnComponentMap from '../../components/bcn/BcnComponentMap.astro';
import { DENSE, summarize } from '../../data/component-dashboard';
import { INDEX_MAP_LEGEND, indexMapPoints } from '../../data/component-index-map';
import { componentNav, COMPONENT_DASHBOARD_HREF } from '../../data/component-nav';

const summary = summarize(DENSE);
const mapPoints = indexMapPoints(DENSE);
---

<!-- manifest:
  layout: stack(lg)                                    # the page SPINE
  sections:
    - view toggle     -> esa-button-toggle             # Grid · Map
    - dataset toggle  -> esa-button-toggle             # populated / empty preview
    - new component   -> esa-button
    - status summary  -> bcn-component-summary         # project-wide component health
    - grid view       -> bcn-component-grid            # mark + colored status; routes to the dashboard
    - map view        -> bcn-component-map             # footprints along the alignment, colored by status
    - empty state     -> esa-empty-state
-->

<AppShell
  title="Components — Delta Conveyance"
  tenantName="DWR"
  projectName="Delta Conveyance"
  navSections={componentNav('components')}
>
  <PageLayout
    title="Components"
    breadcrumbs={[{ label: 'Delta Conveyance', href: '/prototypes/project-dashboard' }, { label: 'Components' }]}
  >
    <div slot="utilities" class="cluster" data-gap="sm" data-align="center">
      <esa-button-toggle id="view-toggle" value="grid" size="sm"></esa-button-toggle>
      <esa-button-toggle id="state-toggle" value="populated" size="sm"></esa-button-toggle>
      <span id="new-cmp-wrap">
        <EsaButton color="primary" icon="plus">New component</EsaButton>
      </span>
    </div>

    <!-- STATE A — a real project's worth of components -->
    <div class="stack" data-gap="lg" data-state-panel="populated">
      <BcnComponentSummary summary={summary} />

      <div data-view-panel="grid">
        <BcnComponentGrid components={DENSE} />
      </div>

      <div data-view-panel="map" hidden>
        <BcnComponentMap
          points={mapPoints}
          variant="full"
          idPrefix="cmp-index-map"
          title="Component footprints"
          sourceLabel={`${DENSE.length} components on the project alignment`}
          legend={INDEX_MAP_LEGEND}
        />
      </div>
    </div>

    <!-- STATE B — empty (first run) -->
    <div data-state-panel="empty" hidden>
      <EsaEmptyState
        title="No components yet"
        description="Components are the pieces of Delta Conveyance you track compliance against — intakes, shafts, forebays, staging areas. Add the first one to start rolling up its requirements, actions, and monitoring activity here."
        size="lg"
      >
        <svg slot="icon" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z"/>
          <path d="M3.29 7 12 12l8.71-5"/>
          <path d="M12 22V12"/>
        </svg>
        <EsaButton color="primary" icon="plus">Add first component</EsaButton>
        <EsaButton color="ghost" appearance="outline">Import from source documents</EsaButton>
      </EsaEmptyState>
    </div>
  </PageLayout>
</AppShell>

<script>
  import '@esa/ecology/esa-button-toggle';

  interface ToggleEl extends HTMLElement {
    options: { label: string; value: string }[];
    value: string;
  }

  const viewToggle = document.getElementById('view-toggle') as ToggleEl | null;
  const stateToggle = document.getElementById('state-toggle') as ToggleEl | null;
  const statePanels = Array.from(document.querySelectorAll<HTMLElement>('[data-state-panel]'));
  const viewPanels = Array.from(document.querySelectorAll<HTMLElement>('[data-view-panel]'));
  const newBtnWrap = document.getElementById('new-cmp-wrap');
  const viewWrap = viewToggle?.parentElement ? viewToggle : null;

  const showView = (view: string) => {
    viewPanels.forEach((p) => {
      p.hidden = p.dataset.viewPanel !== view;
    });
    // The map and the grid both measure themselves on layout; reveal them before
    // anything asks for a size. Each component re-measures on its own signal.
    window.dispatchEvent(new Event('resize'));
  };

  const showState = (state: string) => {
    statePanels.forEach((p) => {
      p.hidden = p.dataset.statePanel !== state;
    });
    if (newBtnWrap) newBtnWrap.hidden = state === 'empty';
    // A view choice is meaningless with nothing to view.
    if (viewWrap) viewWrap.hidden = state === 'empty';
  };

  if (viewToggle) {
    viewToggle.options = [
      { label: 'Grid', value: 'grid' },
      { label: 'Map', value: 'map' },
    ];
    viewToggle.value = 'grid';
    viewToggle.addEventListener('change', (e) => showView((e as CustomEvent).detail.value as string));
    showView('grid');
  }

  if (stateToggle) {
    stateToggle.options = [
      { label: 'Populated', value: 'populated' },
      { label: 'Empty', value: 'empty' },
    ];
    stateToggle.value = 'populated';
    stateToggle.addEventListener('change', (e) => showState((e as CustomEvent).detail.value as string));
    showState('populated');
  }
</script>
