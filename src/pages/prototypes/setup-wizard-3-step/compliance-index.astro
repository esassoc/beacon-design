---
// Setup Wizard in three steps — step 3, Compliance Index, in develop's two phases
// (docs/setup-wizard-3-step-ci-brief.md): build the index (categories and subcategories,
// edited by hand, locked, re-run with guidance), then one Draft run makes the actions and
// obligations and files them, and a person reviews them a subcategory at a time.
//
// Each draft rests on step 2 requirement IDs; a locator opens the commitment as step 2
// marked it up, and its page key opens the PDF. Aldo takes Re-run guidance and corrections
// in plain words; Edit opens a draft's record in a side panel.
import AppShell from '../../../layouts/AppShell.astro';
import PageLayout from '../../../layouts/PageLayout.astro';
import BcnSetupWizardFrame from '../../../components/bcn/BcnSetupWizardFrame.astro';
import BcnSwStepNav from '../../../components/bcn/BcnSwStepNav.astro';
import BcnSwStepPanel from '../../../components/bcn/BcnSwStepPanel.astro';
import BcnSw3IndexActions from '../../../components/bcn/BcnSw3IndexActions.astro';
import BcnSw3IndexRun from '../../../components/bcn/BcnSw3IndexRun.astro';
import BcnSw3IndexMerge from '../../../components/bcn/BcnSw3IndexMerge.astro';
import BcnSw3IndexSuggest from '../../../components/bcn/BcnSw3IndexSuggest.astro';
import BcnSw3Index from '../../../components/bcn/BcnSw3Index.astro';
import BcnSw3EntryEdit from '../../../components/bcn/BcnSw3EntryEdit.astro';
import BcnSw3CommitmentPanel from '../../../components/bcn/BcnSw3CommitmentPanel.astro';
import BcnSw3SourcePeek from '../../../components/bcn/BcnSw3SourcePeek.astro';
import { PROJECT } from '../../../data/project-dashboard';
import { SW3_STEPS, SW3_BASE, SW3_NAME, SW3_GLYPH, SW3_NAV } from '../../../data/setup-wizard-3-step';

const STEP = SW3_STEPS[2];
---

<!-- manifest:
  layout: PageLayout (title row hidden) > bcn-setup-wizard-frame > stack(md)   # SPINE
  sections:
    - wizard chrome     -> bcn-setup-wizard-frame   # three steps, straight run, step 3 active
    - step panel        -> bcn-sw-step-panel        # numeral, title
    - status line       -> bcn-sw3-index-run        # the run, what is left
    - console           -> bcn-sw-step-nav          # the panel's foot: Previous, Next, the step's keys, the subcategory scrubber
    - step keys         -> bcn-sw3-index-actions    # in the console: Build index; Re-run, Draft; then Start over, Draft again, Approve
    - index review      -> bcn-sw3-index            # empty state; index, subcategory, Aldo
    - entry edit        -> bcn-sw3-entry-edit       # side panel: a draft's record
    - merge             -> bcn-sw3-index-merge      # dialog: ticked drafts into one
    - suggest           -> bcn-sw3-index-suggest    # dialog: homes for what fit no subcategory
    - commitment        -> bcn-sw3-commitment-panel # side panel: where a locator leads
    - source peek       -> bcn-sw3-source-peek      # side panel: the commitment on the PDF
-->

<AppShell title={SW3_NAME} hiddenSections={['setup-wizard']} sectionItems={{ project: SW3_NAV }} tenantName={PROJECT.tenant} projectName="Delta Conveyance" activeNavId="sw3-setup" expandedSections={['project']}>
  <PageLayout title="Setup Wizard" hideTitleRow>
    <BcnSetupWizardFrame steps={SW3_STEPS} active="compliance-index" complete={['source-documents', 'commitments']} homeHref={SW3_BASE} title={SW3_NAME} glyph={SW3_GLYPH}>
      <div class="stack" data-gap="md">
        <BcnSwStepPanel n={STEP.n} token={STEP.token} intro="Build the index, then draft its actions and obligations and review them.">
          <Fragment slot="title"><span>Compliance Index</span></Fragment>
          <BcnSw3IndexRun />
          <BcnSwStepNav hook="ix" label="Subcategory"><BcnSw3IndexActions /></BcnSwStepNav>
        </BcnSwStepPanel>
        <BcnSw3Index />
      </div>
      <BcnSw3EntryEdit />
      <BcnSw3IndexMerge />
      <BcnSw3IndexSuggest />
      <BcnSw3CommitmentPanel />
      <BcnSw3SourcePeek />
    </BcnSetupWizardFrame>
  </PageLayout>
</AppShell>
