---
// Setup Wizard in three steps — step 2, Commitments: a QA/QC pass over each commitment,
// carved into structured data, before the Compliance Index makes actions and obligations
// of it.
//
// One commitment at a time, picked from the scrubber. Its text is marked up: each
// requirement a yellow highlight over the words that are its basis, the values it names
// underlined, and plain what nothing will be tracked from. The rail lists everything
// parsed out of it, read only. Aldo takes corrections in plain words; Edit opens a
// requirement's record in a side panel; the source page opens beside it for a spot check.
import AppShell from '../../../layouts/AppShell.astro';
import PageLayout from '../../../layouts/PageLayout.astro';
import BcnSetupWizardFrame from '../../../components/bcn/BcnSetupWizardFrame.astro';
import BcnSwReset from '../../../components/bcn/BcnSwReset.astro';
import BcnSwStepNav from '../../../components/bcn/BcnSwStepNav.astro';
import BcnSwStepPanel from '../../../components/bcn/BcnSwStepPanel.astro';
import BcnSw3ReviewActions from '../../../components/bcn/BcnSw3ReviewActions.astro';
import BcnSw3Review from '../../../components/bcn/BcnSw3Review.astro';
import BcnSw3ReqEdit from '../../../components/bcn/BcnSw3ReqEdit.astro';
import BcnSw3SourcePeek from '../../../components/bcn/BcnSw3SourcePeek.astro';
import BcnSw3EditFind from '../../../components/bcn/BcnSw3EditFind.astro';
import { PROJECT } from '../../../data/project-dashboard';
import { SW3_STEPS, SW3_BASE, SW3_NAME, SW3_GLYPH, SW3_NAV } from '../../../data/setup-wizard-3-step';

const STEP = SW3_STEPS[1];
---

<!-- manifest:
  layout: PageLayout (title row hidden) > bcn-setup-wizard-frame > stack(md)   # SPINE
  sections:
    - wizard chrome     -> bcn-setup-wizard-frame   # three steps, straight run, step 2 active
    - step panel        -> bcn-sw-step-panel        # numeral, title
    - console           -> bcn-sw-step-nav          # the panel's foot: Previous, Next, the step's keys, the commitment scrubber
    - step keys         -> bcn-sw3-review-actions   # in the console: Confirm all (undo), Export
    - review            -> bcn-sw3-review           # marked-up commitment, parsed-data rail, Aldo
    - reset             -> bcn-sw-reset             # Reset the prototype: step 2 starts over
    - requirement edit  -> bcn-sw3-req-edit         # side panel: the requirement's record
    - source peek       -> bcn-sw3-source-peek      # side panel: the commitment on the PDF
    - commitment edit   -> bcn-sw3-edit-find        # side panel: ID, name, text
-->

<AppShell title={SW3_NAME} hiddenSections={['setup-wizard']} sectionItems={{ project: SW3_NAV }} tenantName={PROJECT.tenant} projectName="Delta Conveyance" activeNavId="sw3-setup" expandedSections={['project']}>
  <PageLayout title="Setup Wizard" hideTitleRow>
    <BcnSetupWizardFrame steps={SW3_STEPS} active="commitments" complete={['source-documents']} homeHref={SW3_BASE} title={SW3_NAME} glyph={SW3_GLYPH}>
      <div class="stack" data-gap="md">
        <BcnSwStepPanel n={STEP.n} token={STEP.token} intro="Check what each commitment requires before the Compliance Index makes actions and obligations of it.">
          <Fragment slot="title"><span>Commitments</span></Fragment>
          <BcnSwStepNav hook="rev" label="Commitment" token={STEP.token}><BcnSw3ReviewActions /></BcnSwStepNav>
        </BcnSwStepPanel>
        <BcnSw3Review />
        <BcnSwReset step="review" />
      </div>
      <BcnSw3ReqEdit />
      <BcnSw3SourcePeek />
      <BcnSw3EditFind />
    </BcnSetupWizardFrame>
  </PageLayout>
</AppShell>
