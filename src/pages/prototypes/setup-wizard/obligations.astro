---
// Setup Wizard step 5 — Obligations, in the same clothes as step 4.
//
// One bordered top panel (numeral, serif title with the category chip and the count,
// intro line) with Approve at the right of the title row; a filter row with search,
// a class picker and the expand / collapse verbs; then one list panel holding the
// registry four levels deep — category > subcategory > obligation > requirement(s) —
// every line at one small size. Clicking an obligation's statement or its pencil opens
// the editor drawer, the only view of the record. Obligations drag between
// subcategories; requirements drag between obligations (or onto a subcategory to start
// a new one), duplicate in place, and unlink. "New category" closes the list panel.
//
// The tree and every count are derived from the ITP fixture (OBLIGATION_TREE): the 333
// obligations the actions pass wrote, filed into the registry's subject taxonomy, each
// carrying the requirements it was written from.
import AppShell from '../../../layouts/AppShell.astro';
import PageLayout from '../../../layouts/PageLayout.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaIcon from '@esa/ecology/esa-icon.astro';
import BcnSetupWizardFrame from '../../../components/bcn/BcnSetupWizardFrame.astro';
import BcnSwStepPanel from '../../../components/bcn/BcnSwStepPanel.astro';
import BcnSwSelectChip from '../../../components/bcn/BcnSwSelectChip.astro';
import BcnSwCountBadge from '../../../components/bcn/BcnSwCountBadge.astro';
import BcnSwFilterRow from '../../../components/bcn/BcnSwFilterRow.astro';
import BcnSwObligationsTree from '../../../components/bcn/BcnSwObligationsTree.astro';
import BcnSwObligationsEditor from '../../../components/bcn/BcnSwObligationsEditor.astro';
import { PROJECT } from '../../../data/project-dashboard';
import { SETUP_STEPS, STEP_GLYPH, OBLIGATION_TREE_TOTALS } from '../../../data/setup-wizard';

const STEP = SETUP_STEPS.find((s) => s.id === 'obligations')!;
const total = OBLIGATION_TREE_TOTALS.obligations;
---

<!-- manifest:
  layout: PageLayout (title row hidden) > bcn-setup-wizard-frame > stack(md)   # SPINE
  sections:
    - wizard chrome     -> bcn-setup-wizard-frame     # compass mark, serif title, five-step pill nav with step 5 active
    - step panel        -> bcn-sw-step-panel          # numeral, serif title with category chip (bcn-sw-select-chip) and count, Approve at right, intro
    - filter row        -> bcn-sw-filter-row          # search (yellow hit highlighting), class picker, expand / collapse verbs
    - obligation tree   -> bcn-sw-obligations-tree    # category > subcategory > bcn-sw-obligation-card > requirement rows; drag to refile; New category at the foot
    - edit one          -> bcn-sw-obligations-editor  # side drawer a statement or pencil opens: statement, class, filing, scope, trigger, thresholds, gate, requirements with source text
-->

<AppShell title="Setup Wizard" tenantName={PROJECT.tenant} projectName="Delta Conveyance" activeNavId="setup-wizard">
  <PageLayout title="Setup Wizard" hideTitleRow>
    <BcnSetupWizardFrame active="obligations">
      <div class="stack" data-gap="md">
        <BcnSwStepPanel
          n={STEP.n}
          token={STEP.token}
          intro="Review the standing obligations Beacon drafted from requirements that are not tracked as actions. Open any obligation to read and correct it, drag obligations and requirements to where they belong, then approve the set."
        >
          <Fragment slot="title">
            <span>Obligations in</span>
            <BcnSwSelectChip label="Category" value="All categories" />
            <span data-swo-count="title"><BcnSwCountBadge value={total} label={`${total} obligations`} /></span>
          </Fragment>
          <Fragment slot="actions">
            <EsaButton variant="primary" size="sm" title="Approve every obligation in this list">
              <span class="sw-verb"><EsaIcon name="circle-check" size="xs" />Approve obligations <span data-swo-total>({total})</span></span>
            </EsaButton>
          </Fragment>
          <BcnSwFilterRow
            searchPlaceholder="Search obligations and requirements by statement, class, name or commitment..."
            searchName="swo-search"
            pickers={[{ label: 'Class', value: 'All classes' }]}
          >
            <EsaButton variant="ghost" size="xs" data-swo-expand title="Open every category, subcategory and obligation">
              <span class="sw-verb"><EsaIcon name="chevrons-up-down" size="xs" paths={STEP_GLYPH['chevrons-up-down']} />Expand all</span>
            </EsaButton>
            <EsaButton variant="ghost" size="xs" data-swo-collapse title="Close everything">
              <span class="sw-verb"><EsaIcon name="chevrons-down-up" size="xs" paths={STEP_GLYPH['chevrons-down-up']} />Collapse all</span>
            </EsaButton>
          </BcnSwFilterRow>
        </BcnSwStepPanel>

        <BcnSwObligationsTree />
      </div>

      <BcnSwObligationsEditor />
    </BcnSetupWizardFrame>
  </PageLayout>
</AppShell>

<style>
  .sw-verb { display: inline-flex; align-items: center; gap: var(--spacing-100); }
</style>
