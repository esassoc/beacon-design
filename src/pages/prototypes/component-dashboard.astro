---
// Component Dashboard — the per-component homepage, one level below the project
// dashboard. The follow-up epic to BCN-1039, shaped on the 2026-08-13 design call.
//
// THE JOB, in the user's words: someone is working the geotech component and
// nothing else. They arrive from a starred box on the project dashboard and
// everything narrows to that component — its tracking, its monitoring, its
// reporting, its work areas, its dates, its footprint. "I don't need to worry
// about anything else, any project setup sort of stuff. Let me focus my efforts
// on this one segment."
//
// So this page is the project dashboard with the SAME SPINE and a smaller set.
// Actions are still the spine; urgency is still derived from due date and never
// stored; the modules still sit above everything else. What changes:
//
//   · NO COVER PHOTO. The project gets a hero band; a component gets a white bar
//     with its MARK — a glyph and a color from closed sets — beside its name.
//     The argument (see src/data/entity-marks.ts) is the parking-garage floor:
//     a landmark that tells two dozen components apart at a glance, and a
//     question a user can always answer, unlike "what's a good photo for a
//     launch shaft?"
//   · COMPONENTS → WORK AREAS. Where the project lists its starred components,
//     the component lists its work areas — the grid lifted off the tab that this
//     effort retires, bulk import and delete included. Prod's version showed one
//     column, Identifier, while discarding the geometry, measure and custom
//     fields it already fetched; the columns here are the fields that were
//     always there.
//   · SETUP WIZARD → COMPONENT SETUP. The project's four-step pipeline card is
//     replaced by the applicable-commitments card, which opens a WIDE drawer.
//     Two models of that drawer are mounted here and compared on
//     /prototypes/component-setup-models.
//   · A THIN RAIL. The project has six data panels. A component has four, and
//     really only one it edits — milestones. Species, seasons and construction
//     activities are project-level; a component copy would imply an override the
//     data model does not have.
//   · NO EVIDENCE SURFACE (decided 2026-08-13). The retired Summary tab ended in
//     a "Highlighted Evidence of Compliance" grid, so its absence here could read
//     as something lost in the move. It is not: that grid is fed by an opt-in
//     join nothing in the app writes, and it renders nothing when empty — which
//     is why nobody has seen it in QA. Evidence already has homes (the app-wide
//     drawer attaches it, the Data Catalog lists it). A component-scoped evidence
//     view may earn its place later; it would be a new surface, not that grid.
//
// The map draws WORK AREAS, not a boundary, because Component has no geometry
// column and the boundary epic (BCN-1582) is Ready-for-Dev with zero commits.
// Work-area coordinates are real, already returned by the endpoint, and thrown
// away by every surface today — which is exactly what BCN-1583 slice 1 proposes
// to fix. Honest now, and forward-compatible.
import AppShell from '../../layouts/AppShell.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import BcnComponentHeader from '../../components/bcn/BcnComponentHeader.astro';
import BcnSiblingNav from '../../components/bcn/BcnSiblingNav.astro';
import BcnProjectTimeline from '../../components/bcn/BcnProjectTimeline.astro';
import BcnModules from '../../components/bcn/BcnModules.astro';
import BcnWorkAreaBoard from '../../components/bcn/BcnWorkAreaBoard.astro';
import BcnComponentSetupCard from '../../components/bcn/BcnComponentSetupCard.astro';
import BcnLinkRowCard from '../../components/bcn/BcnLinkRowCard.astro';
import BcnComponentMap from '../../components/bcn/BcnComponentMap.astro';
import BcnProjectFacts from '../../components/bcn/BcnProjectFacts.astro';
import BcnComponentDataPanel from '../../components/bcn/BcnComponentDataPanel.astro';
import BcnLogoPicker from '../../components/bcn/BcnLogoPicker.astro';
import BcnSetupWorkspace from '../../components/bcn/BcnSetupWorkspace.astro';
import BcnSetupQueue from '../../components/bcn/BcnSetupQueue.astro';
import { componentNav } from '../../data/component-nav';
import {
  COMPONENT,
  COMPONENT_ACTIONS,
  COMPONENT_FACTS,
  COMPONENT_MAP_LEGEND,
  COMPONENT_MAP_POINTS,
  COMPONENT_MODULES,
  COMPONENT_TIMELINE_MILESTONES,
  COMPONENT_UTILITIES,
  SIBLINGS,
  WORK_AREAS,
  WORK_AREA_ACRES,
  WORK_AREA_COUNT,
} from '../../data/component-detail';
import { DECIDED_PERCENT, LAST_REVIEWED, PENDING_ACTION_COUNT, SETUP_TOTALS, fmtDate } from '../../data/component-commitments';
---

<!-- manifest:
  layout: full-bleed header (PageLayout bleed slot), then stack(xl) > timeline + sidebar   # SPINE
  sections:
    - breadcrumb sibling nav -> bcn-sibling-nav           # prev/next at the end of the trail, as prod does it
    - component header      -> bcn-component-header       # white identity bar; mark, not a cover photo
    - timeline              -> bcn-project-timeline       # 30/60/90d, scoped to this component's actions
    - modules               -> bcn-modules                # Tracking / Monitoring / Reporting, scoped
    - work areas            -> bcn-work-area-board        # the retired tab's grid + its bulk actions
    - component setup       -> bcn-component-setup-card   # applicable-commitment progress; opens the wide drawer
    - component data rail   -> bcn-link-row-card          # four rows, not six; opens panels via ?data=<key>
    - component map         -> bcn-component-map          # work-area footprint, inset -> modal
    - component details     -> bcn-project-facts          # Component-record fields + files
    - component data panel  -> bcn-component-data-panel   # the ?data= side panels
    - logo picker           -> bcn-logo-picker            # glyph x color mark editor
    - setup model A         -> bcn-setup-workspace        # faceted decision workspace (overlay)
    - setup model B         -> bcn-setup-queue            # one-at-a-time triage queue (overlay)
-->

<AppShell
  title={`${COMPONENT.name} — Beacon`}
  tenantName="DWR"
  projectName="Delta Conveyance"
  navSections={componentNav('components')}
>
  <PageLayout
    title={COMPONENT.name}
    hideTitleRow
    bleedHeader
    breadcrumbs={[
      { label: 'Delta Conveyance', href: '/prototypes/project-dashboard' },
      { label: 'All Components', href: SIBLINGS.indexHref },
      { label: COMPONENT.name },
    ]}
  >
    <BcnSiblingNav slot="breadcrumb-end" items={SIBLINGS.items} currentIndex={SIBLINGS.currentIndex} />
    <BcnComponentHeader slot="bleed" component={COMPONENT} starred />

    <div class="stack" data-gap="xl">
      <BcnProjectTimeline
        actions={COMPONENT_ACTIONS}
        milestones={COMPONENT_TIMELINE_MILESTONES}
        idPrefix="cmp-tl"
        title="Timeline"
      />

      {/* 21.5rem, not the project dashboard's declared 16rem, so the two pages LOOK
          alike. Both declare 16rem; the project's rail renders ~343px anyway because
          its content (long data labels, the project description) pushes past the
          basis, while this page's shorter labels sit at it — 257px, and a main column
          86px wider. Matching the rendered width is what actually matches the pages;
          matching the declared one is what let them drift. */}
      <div class="sidebar" data-side="end" data-gap="xl" style="--sidebar-width: 21.5rem; --sidebar-content-min: 64%;">
        <div class="stack" data-gap="lg">
          <BcnLinkRowCard title="Component data" rows={COMPONENT_UTILITIES} chevrons />
          <BcnComponentMap
            points={COMPONENT_MAP_POINTS}
            variant="inset"
            idPrefix="cmp-footprint"
            title="Component footprint"
            sourceLabel={`Work area locations (${WORK_AREA_COUNT})`}
            legend={COMPONENT_MAP_LEGEND}
          />
          {/* No `files`: ComponentDto has no Files field. Component files in prod are
              EvidenceOfComplianceFile rows reached through evidence records, which is
              a different entity and a different surface. */}
          <BcnProjectFacts title="Component details" facts={COMPONENT_FACTS} description={COMPONENT.description} />
        </div>

        <div class="stack" data-gap="xl">
          <BcnModules modules={COMPONENT_MODULES} actions={COMPONENT_ACTIONS} idPrefix="" />
          <BcnWorkAreaBoard workAreas={WORK_AREAS} acres={WORK_AREA_ACRES} />
          <BcnComponentSetupCard
            undecided={SETUP_TOTALS.undecided}
            newSince={SETUP_TOTALS.newSince}
            decided={SETUP_TOTALS.decided}
            total={SETUP_TOTALS.total}
            percent={DECIDED_PERCENT}
            lastReviewed={fmtDate(LAST_REVIEWED)}
            pendingActions={PENDING_ACTION_COUNT}
            opensPrimary="bcn-setup-workspace"
            opensSecondary="bcn-setup-queue"
            compareHref="/prototypes/component-setup-models"
          />
        </div>
      </div>
    </div>
  </PageLayout>

  <BcnComponentDataPanel />
  <BcnLogoPicker mark={COMPONENT.mark} entityName={COMPONENT.name} heading="Component logo" />
  <BcnSetupWorkspace id="bcn-setup-workspace" componentName={COMPONENT.name} />
  <BcnSetupQueue id="bcn-setup-queue" componentName={COMPONENT.name} />
</AppShell>

<script>
  // The setup card's two buttons are the only doors into the drawers on this
  // page. Same handshake the comparison page uses: the launcher carries the
  // target's id, opening is show()/open on the dialog host.
  document.querySelectorAll<HTMLElement>('[data-opens]').forEach((launcher) => {
    launcher.addEventListener('click', () => {
      const target = document.getElementById(launcher.dataset.opens ?? '');
      if (!target) return;
      const host = target as HTMLElement & { open?: boolean; show?: () => void };
      if (typeof host.show === 'function') host.show();
      else host.open = true;
    });
  });
</script>
