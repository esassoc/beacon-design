<script>
  // The dashboard controller (spec §10): layout application, the widget ⋯ menu,
  // the configure dialog (real-clone preview), drag-to-reorder with insertion
  // carets, and the add-widget picker. The persisted layout is the ONE record in
  // lib/mpdash-config; every path here reads, mutates, writes, re-applies.
  import '@esa/ecology/esa-dialog';
  import {
    readDashboardConfig as readConfig,
    writeDashboardConfig as writeConfig,
    type DashboardConfig,
    type SectionState,
  } from '../../../lib/mpdash-config';
  import { orderedSections, type SectionValue } from '../../../data/monitoring-streams';
  import type { MarkKey, WidgetColor, WidgetConfig } from '../../../data/monitoring-streams';

  interface CfgInfo {
    id: string;
    title: string;
    charts: string[];
    scopes: string[];
    colorMode: 'mono' | 'series' | 'status';
    sections: {
      id: string;
      label: string;
      title: string;
      display: string;
      on: boolean;
      settings?: readonly { id: string; label: string; kind: string; default?: unknown }[];
    }[];
    windowed: boolean;
    width: 1 | 2 | 3;
    series: string[];
    stream: string;
  }
  interface Option {
    label: string;
    value: string;
  }
  interface SizeDetail {
    width: number;
  }

  const CHART_LABEL: Record<string, string> = {
    donut: 'Donut by type',
    bars: 'Horizontal bars',
    trend: 'Daily columns',
    list: 'Latest records',
    stat: 'Total only',
    meter: 'Status meter',
    seasons: 'Season lane',
  };
  const SCOPE_LABEL: Record<string, string> = {
    '7d': 'Past 7 days',
    '14d': 'Past 14 days',
    '30d': 'Past 30 days',
    '90d': 'Past 90 days',
  };

  const grid = document.querySelector<HTMLElement>('[data-mpdash]');
  /** Set once the span observer exists; ensureEl enrols later-created widgets. */
  let spanObserver: ResizeObserver | null = null;
  const payloadEl = document.querySelector('[data-mpd-payload]');
  const INFO: CfgInfo[] = payloadEl ? JSON.parse(payloadEl.textContent || '[]') : [];
  const infoById = new Map(INFO.map((i) => [i.id, i]));

  // instanceId -> element. The server renders ONE element per widget type, which
  // doubles as instance #1 (its instance id IS the type id) and as the clone
  // template for added copies. It is never removed from the DOM — only hidden —
  // so a template is always available even when instance #1 is off.
  const widgetEls = new Map<string, HTMLElement>();
  const templates = new Map<string, HTMLElement>();
  grid?.querySelectorAll<HTMLElement>('.bcn-dwidget').forEach((el) => {
    const inst = el.dataset.widgetId;
    const type = el.dataset.widgetType || inst;
    if (!inst) return;
    widgetEls.set(inst, el);
    if (type && !templates.has(type)) templates.set(type, el);
  });

  const typeOf = (instanceId: string): string =>
    widgetEls.get(instanceId)?.dataset.widgetType || instanceId.split('~')[0];

  /** Existing element for an instance, or a fresh clone of its type's template. */
  const ensureEl = (instanceId: string, type: string): HTMLElement | null => {
    const existing = widgetEls.get(instanceId);
    if (existing) return existing;
    const template = templates.get(type);
    if (!template) return null;

    const el = template.cloneNode(true) as HTMLElement;
    el.dataset.widgetId = instanceId;
    el.dataset.widgetType = type;
    // Drag chrome is transient state, never part of a new instance.
    el.classList.remove('is-drag-origin', 'is-drag-lifted');
    el.removeAttribute('inert');
    // A clone carries the template's measured span; drop it so this instance is
    // measured from its own content (its sections may differ) rather than inheriting
    // a footprint that was right for a different widget.
    delete el.dataset.span;
    el.style.gridRowEnd = '';
    spanObserver?.observe(el);

    // Leaflet hosts carry a per-host "already built" flag and a DOM id. Clear the
    // flag and re-key the id, then ask the map component to rescan — otherwise the
    // clone shows an empty well forever (BcnObservationMap's build() self-skips a
    // host it has already mounted, and duplicate ids are invalid besides).
    let hasMap = false;
    el.querySelectorAll<HTMLElement>('[data-bcn-obsmap]').forEach((host) => {
      hasMap = true;
      delete host.dataset.bcnObsmapReady;
      host.id = `bcn-obsmap-${host.dataset.mapId ?? 'map'}-${instanceId}`;
      // Leaflet leaves its own scaffolding in the cloned subtree; a fresh mount
      // needs the container empty or it double-renders panes.
      host.innerHTML = '';
    });

    widgetEls.set(instanceId, el);
    grid?.appendChild(el);
    if (hasMap) document.dispatchEvent(new CustomEvent('bcn-obsmap-scan'));
    // A cloned date-range select arrives un-hydrated (options are a property).
    document.dispatchEvent(new CustomEvent('bcn-wdate-scan'));
    return el;
  };

  /**
   * Render a widget's parts in the order its instance stores, ON before OFF.
   *
   * Reads orderedSections() so the board and the configure form derive the sequence
   * from the same function — the alternative is two orderings that agree until one
   * of them is edited.
   *
   * Every section is a DIRECT CHILD of the widget's BcnWidgetFlow, so appending them
   * in order is the whole job — the sequence they end up in is the sequence they
   * wrap in. This used to need a wrapper lookup (each section was the only child of a
   * generated panel, so appending the section itself reordered nothing) and it used
   * to be in tension with the layout: whichever section came first landed in the old
   * fixed rail, so promoting a chart squeezed it to 190px. The flow has no rail, so
   * both problems went with it.
   */
  const applySectionOrder = (
    el: HTMLElement,
    type: string,
    inst: { sections?: Record<string, SectionState>; sectionOrder?: string[] },
  ): void => {
    const wanted = orderedSections(type, inst);
    if (wanted.length < 2) return;
    for (const def of wanted) {
      for (const node of el.querySelectorAll<HTMLElement>(`[data-section="${def.id}"]`)) {
        node.parentElement?.appendChild(node);
      }
    }
  };

  /**
   * Apply an instance's section state: which parts are on, and each section's own
   * settings.
   *
   * Both reads fall back to the registry — an absent section key to its `on`, an
   * absent setting to the SETTING's default — so a widget gaining either does not
   * have every saved layout silently hide a part or lose a value.
   */
  const applySections = (
    el: HTMLElement,
    type: string,
    state?: Record<string, SectionState>,
  ): void => {
    const defs = infoById.get(type)?.sections ?? [];
    if (defs.length === 0) return;
    for (const def of defs) {
      const saved = state?.[def.id];
      const visible = saved?.on ?? def.on;
      el.querySelectorAll<HTMLElement>(`[data-section="${def.id}"]`).forEach((node) => {
        node.hidden = !visible;
        applySectionSettings(node, def, saved);
      });
    }
  };

  /**
   * One section's settings, applied to its own subtree.
   *
   * `count` is the only kind with a rendering consequence today, and it means "show
   * the first N rows of the list in here" — the table is rendered at
   * SECTION_ROW_MAX and the tail is hidden, so moving the number never re-renders
   * anything. `choice` and `flag` exist in the model without a consumer yet; they
   * fall through deliberately rather than being asserted on, because a registry
   * that declares one before the page reads it should degrade to "no effect", not
   * throw in a dashboard.
   */
  const applySectionSettings = (
    node: HTMLElement,
    def: { settings?: readonly { id: string; kind: string }[] },
    saved?: SectionState,
  ): void => {
    for (const setting of def.settings ?? []) {
      const raw = saved?.values?.[setting.id];

      if (setting.kind === 'text' && setting.id === 'title') {
        // BOTH targets, because a count section has two: the heading's title and the
        // esa-stat label that names the number in reading order (visually hidden —
        // see BcnDashboardWidget). Writing only the heading would leave a renamed
        // section announcing its OLD name to a screen reader.
        const next = typeof raw === 'string' && raw.trim() ? raw : sectionTitle(def, setting.id);
        node
          .querySelectorAll<HTMLElement>('[data-section-title], .esa-stat__label')
          .forEach((el) => {
            el.textContent = next;
          });
        continue;
      }

      if (setting.kind !== 'count') continue;
      const limit = typeof raw === 'number' ? raw : sectionDefault(def, setting.id);
      node.querySelectorAll<HTMLElement>('tbody tr').forEach((tr, i) => {
        tr.hidden = i >= limit;
      });
    }
  };

  /** A title setting's declared default — the registry's own section heading. An
   *  EMPTY saved value falls back to it rather than blanking the section: a user who
   *  clears the field is telling us they want the default back, and a heading-less
   *  chart is not a state worth being able to save. */
  const sectionTitle = (
    def: { settings?: readonly { id: string; default?: unknown }[] },
    settingId: string,
  ): string => {
    const d = def.settings?.find((x) => x.id === settingId)?.default;
    return typeof d === 'string' ? d : '';
  };

  /** A setting's declared default, from the payload the page was rendered with. */
  const sectionDefault = (
    def: { settings?: readonly { id: string; default?: unknown }[] },
    settingId: string,
  ): number => {
    const d = def.settings?.find((x) => x.id === settingId)?.default;
    return typeof d === 'number' ? d : SECTION_ROW_MAX;
  };
  // The server-rendered accent (the stream's stored mark) — restored when a
  // color override is cleared.
  const baseAccent = new Map<string, string>();
  widgetEls.forEach((el, id) => baseAccent.set(id, el.style.getPropertyValue('--_accent')));

  const markVar = (key: MarkKey): string => `var(--bcn-mark-${key})`;

  // ── Color application (spec §10.6): mono re-points --_accent/--_mono; series
  //    re-points --_series-n by the widget's real series order. ──
  const applyColor = (el: HTMLElement, id: string, color?: WidgetColor): void => {
    el.style.setProperty('--_accent', baseAccent.get(id) || '');
    el.style.removeProperty('--_mono');
    for (let i = 1; i <= 6; i++) el.style.removeProperty(`--_series-${i}`);
    if (!color) return;
    if (color.mode === 'mono') {
      el.style.setProperty('--_accent', markVar(color.color));
      el.style.setProperty('--_mono', markVar(color.color));
    } else {
      (infoById.get(id)?.series ?? []).forEach((label, i) => {
        const key = color.series[label];
        if (key) el.style.setProperty(`--_series-${i + 1}`, markVar(key));
      });
    }
  };

  const scopesEl = document.querySelector('[data-mpd-scopes]');
  const SCOPE_DATA: Record<string, Record<string, { value: string; sub: string }>> =
    scopesEl ? JSON.parse(scopesEl.textContent || '{}') : {};

  /** Re-derive one widget's headline figure for a window. */
  /**
   * Show the pre-rendered chart for this scope (see scopedSeries). Every window is
   * already in the DOM; this picks one.
   *
   * Falls back to the FIRST chart if the saved scope has none — a stored layout can
   * name a scope the widget no longer offers, and a widget showing no chart at all is
   * a worse outcome than one showing its default window.
   */
  const applyScopeChart = (el: HTMLElement, scope: string): void => {
    const charts = el.querySelectorAll<HTMLElement>('[data-scope-chart]');
    if (!charts.length) return; // most widgets have one chart and no windows
    let shown = false;
    for (const c of charts) {
      const on = c.dataset.scopeChart === scope;
      c.hidden = !on;
      shown = shown || on;
    }
    if (!shown) charts[0].hidden = false;
  };

  const applyScopeFigure = (el: HTMLElement, type: string, scope: string): void => {
    const fig = SCOPE_DATA[type]?.[scope];
    if (!fig) return; // only the three windowed widgets have a figure to re-derive
    const value = el.querySelector<HTMLElement>('.esa-stat__value');
    const sub = el.querySelector<HTMLElement>('.esa-stat__sub');
    // Guard against the component-picker's empty-scope override, which parks the
    // original in data-scopeOrig and shows 0 — don't fight it.
    if (value && value.dataset.scopeOrig === undefined) value.textContent = fig.value;
    // The subtext names the window's first day, so it MUST move with the figure —
    // a stale "since" date beside a re-derived count is worse than no date at all.
    if (sub) sub.textContent = fig.sub;
  };

  const apply = (config: DashboardConfig): void => {
    if (!grid) return;
    for (const id of config.order) {
      const c = config.widgets[id];
      if (!c) continue;
      const type = c.type ?? typeOf(id);
      const el = ensureEl(id, type);
      if (!el) continue;
      grid.appendChild(el); // append in order — DOM order is grid order
      el.hidden = !c.on;
      el.dataset.w = String(c.width);
      const h = el.querySelector('.bcn-dwidget__title');
      if (h) h.textContent = c.title ?? infoById.get(type)?.title ?? '';
      applySections(el, type, c.sections);
      applySectionOrder(el, type, c);
      applyScopeFigure(el, type, c.scope);
      applyScopeChart(el, c.scope);
      // Keep the widget's own control in step with the saved value — the configure
      // dialog writes the same key, so a default changed there must show up here.
      const dr = el.querySelector<HTMLElement & { value: string }>('[data-widget-daterange]');
      if (dr) dr.value = c.scope;
      applyColor(el, id, c.color);
      // Sync the ⋯ menu's size block (the menu arms itself; rAF lets it attach).
      const menu = el.querySelector('[data-widget-menu]');
      if (menu) {
        requestAnimationFrame(() =>
          menu.dispatchEvent(new CustomEvent('bcn-size-set', { detail: { width: c.width } })),
        );
      }
    }
    // An instance that left config.order was REMOVED (a copy, not just toggled
    // off). Its element goes with it — but never a template, which has to survive
    // to clone from.
    const live = new Set(config.order);
    for (const [id, el] of [...widgetEls]) {
      if (live.has(id)) continue;
      if (templates.get(typeOf(id)) === el) {
        el.hidden = true;
        continue;
      }
      el.remove();
      widgetEls.delete(id);
    }
    const addTile = grid.querySelector('.mpd-add');
    if (addTile) grid.appendChild(addTile); // the add tile always trails
    measureSpans();
  };

  /**
   * ── THE ONLY LAYOUT ARITHMETIC ON THE BOARD ──
   *
   * Convert each card's own height into a row span over the page's 8px unit. That is
   * the whole mechanism by which two cards in one visual row can be different
   * heights: in a row-aligned grid every item in a row shares that row's height, so
   * the only way out is for each item to span a different number of much smaller
   * rows.
   *
   * WHY THIS IS SAFE where a computed span generally is not. The span is a pure
   * function of the card's OWN content: ceil((its height + gap) / unit). It does not
   * depend on what packed beside it, so there is no policy to get wrong, nothing to
   * simulate, and no convergence to worry about. The one thing that could feed back —
   * a card whose height depends on its span — cannot happen, because `align-self:
   * start` means the card is never sized by its grid area. Height depends on WIDTH
   * (text wraps), and width comes from the column span, which this never touches.
   *
   * Floored at the old 84px minimum so a nearly-empty widget still reads as a card
   * rather than a strip.
   */
  const ROW_UNIT = 8;
  const MIN_SPAN = Math.ceil(84 / ROW_UNIT);

  const spanOf = (el: HTMLElement): number => {
    const gap = parseFloat(getComputedStyle(el).marginBlockEnd) || 0;
    // offsetHeight excludes the margin, which is why the gap is added back rather
    // than measured — the margin IS the row spacing (see .mpdash's row-gap note).
    const h = el.offsetHeight;
    return Math.max(MIN_SPAN, Math.ceil((h + gap) / ROW_UNIT));
  };

  const measureSpans = (): void => {
    if (!grid) return;
    for (const el of grid.querySelectorAll<HTMLElement>('.bcn-dwidget')) {
      if (el.hidden) continue;
      // A lifted card is position: fixed at a pinned height — measuring it would
      // record the drag, not the content. Its span is left alone until it lands.
      if (el.classList.contains('is-drag-lifted')) continue;
      const span = String(spanOf(el));
      if (el.dataset.span !== span) {
        el.dataset.span = span;
        el.style.gridRowEnd = `span ${span}`;
      }
    }
  };

  /**
   * Re-measure when a card's own height changes — a section toggled, a scope
   * re-derived, a font loaded, the column count changing at a breakpoint (which
   * changes width, which re-wraps text, which changes height). One observer for the
   * whole board rather than one per card: the callback is cheap and the entries are
   * only used as a "something moved" signal.
   */
  if (grid && 'ResizeObserver' in window) {
    const ro = new ResizeObserver(() => measureSpans());
    ro.observe(grid);
    for (const el of grid.querySelectorAll<HTMLElement>('.bcn-dwidget')) ro.observe(el);
    // Widgets added later (a copy placed from the picker) join the observer when
    // they are created — see ensureEl.
    spanObserver = ro;
  }

  apply(readConfig());

  const mutate = (fn: (c: DashboardConfig) => void): void => {
    const c = readConfig();
    fn(c);
    writeConfig(c);
    apply(c);
  };

  /**
   * Removing a COPY deletes it — its id leaves `order` and apply() drops the
   * element. Removing instance #1 only switches it off, because its element is the
   * clone template every added copy of that type is made from, and because its id
   * staying in `order` is what lets a re-add return it to its saved position.
   */
  const removeInstance = (id: string): void => {
    const isTemplate = templates.get(typeOf(id)) === widgetEls.get(id);
    mutate((c) => {
      if (isTemplate) {
        c.widgets[id] = { ...c.widgets[id], on: false };
      } else {
        delete c.widgets[id];
        c.order = c.order.filter((x) => x !== id);
      }
    });
  };

  // ── Widget ⋯ menu ──
  document.addEventListener('bcn-widget-menu', (event) => {
    const action = (event as CustomEvent<{ action: string }>).detail.action;
    const id = (event.target as Element | null)?.closest<HTMLElement>('.bcn-dwidget')?.dataset.widgetId;
    if (!id) return;
    if (action === 'configure') openConfig(id);
    else if (action === 'remove') removeInstance(id);
  });

  // Size changes from a widget menu apply live and persist. (The dialog's own
  // picker bubbles the same event — the dialog handler below stops it there.)
  document.addEventListener('bcn-size-change', (event) => {
    if ((event.target as Element | null)?.closest('[data-config-dialog]')) return;
    const { width } = (event as CustomEvent<SizeDetail>).detail;
    const id = (event.target as Element | null)?.closest<HTMLElement>('.bcn-dwidget')?.dataset.widgetId;
    if (!id) return;
    mutate(
      (c) =>
        (c.widgets[id] = {
          ...c.widgets[id],
          type: c.widgets[id]?.type ?? typeOf(id),
          width: width as WidgetConfig['width'],
        }),
    );
  });

  // ── Configure dialog (spec §10.3): a real clone in the stage, options right. ──
  const dialog = document.querySelector<HTMLElement & { open: boolean }>('[data-config-dialog]');
  const stage = dialog?.querySelector<HTMLElement>('[data-preview-stage]');
  const tabs = dialog?.querySelector<HTMLElement & { value: string }>('[data-cfg-tabs]');
  const titleField = dialog?.querySelector<HTMLElement & { value: string }>('[data-cfg-title]');
  const showsField = dialog?.querySelector<HTMLElement>('[data-cfg-shows-field]');
  const scopeField = dialog?.querySelector<HTMLElement>('[data-cfg-scope-field]');
  const showsSelect = dialog?.querySelector<HTMLElement & { options: Option[]; value: string }>('[data-cfg-shows]');
  const scopeSelect = dialog?.querySelector<HTMLElement & { options: Option[]; value: string }>('[data-cfg-scope]');
  const sectionsField = dialog?.querySelector<HTMLElement>('[data-cfg-sections-field]');
  const sectionsWrap = dialog?.querySelector<HTMLElement>('[data-cfg-sections]');
  const addBtn = dialog?.querySelector<HTMLElement>('[data-cfg-add]');
  const saveBtn = dialog?.querySelector<HTMLElement>('[data-cfg-save]');
  const removeBtn = dialog?.querySelector<HTMLElement>('[data-cfg-remove]');
  const monoWrap = dialog?.querySelector<HTMLElement>('[data-cfg-color-mono]');
  const seriesWrap = dialog?.querySelector<HTMLElement>('[data-cfg-color-series]');

  let openId: string | null = null;
  // The open instance's TYPE — every registry fact (title, charts, scopes, colorMode,
  // sections) is keyed by type, while the config record is keyed by instance.
  let openType: string | null = null;
  // Add mode: the dialog is configuring a widget that is NOT on the board yet, so
  // Save/Remove are swapped for "Add to dashboard" and nothing is written until then.
  let adding = false;
  let draft: (WidgetConfig & { sections?: Record<string, SectionState> }) | null = null;
  /** The open widget's section order while the dialog is up. Empty means "registry
   *  order" — the same absent-is-default rule the saved record uses. */
  let draftSectionOrder: string[] = [];
  /** The fields a commit may write. Mirrors WidgetInstance without importing it —
   *  the page speaks in WidgetConfig plus the two instance-only keys it sets. */
  type WidgetInstanceLike = WidgetConfig & {
    type?: string;
    sections?: Record<string, SectionState>;
    sectionOrder?: string[];
    on?: boolean;
  };
  let clone: HTMLElement | null = null;

  // Frame math, read from the live grid (spec: measured, never hardcoded).
  const frameMath = () => {
    const style = grid ? getComputedStyle(grid) : null;
    const gap = style ? parseFloat(style.columnGap) || 16 : 16;
    const col = grid ? (grid.clientWidth - gap * 2) / 3 : 360;
    return {
      frameW: (w: number) => col * w + gap * (w - 1),
      /* A FLOOR, not a height — the stage measures what the clone actually takes and
         scales from that. It used to be derived from the authored row span; with
         heights measured from content there is no span to derive from, and the honest
         floor is the one a card has anyway. */
      minH: 84,
    };
  };

  const stageEvent = (name: string, detail: object): void => {
    stage?.dispatchEvent(new CustomEvent(name, { detail }));
  };

  /** Columns only: width is the one axis a user chooses, and the other is now
      whatever the content needs. */
  const badgeOf = (w: number) => (w === 1 ? '1 column' : `${w} columns`);

  // One esa-switch-toggle per declared section. Hidden entirely when the widget has
  // none, so a single-block widget shows no dead control.
  /**
   * Show the open widget's pre-rendered section list and set every control in it.
   *
   * Nothing is created here — BcnConfigSections rendered a bar per section of every
   * widget at build time, so this reveals one block and writes values into controls
   * that already exist. What that buys, beyond the markup living in a component: the
   * fields keep their identity across opens, so a select does not lose its options
   * and a disclosure does not lose its state just because the dialog closed.
   */
  const setSectionFields = (info: CfgInfo, state?: Record<string, SectionState>): void => {
    if (!sectionsField || !sectionsWrap) return;
    const defs = info.sections ?? [];
    sectionsField.hidden = defs.length === 0;

    for (const list of sectionsWrap.querySelectorAll<HTMLElement>('[data-cfgsec-list]')) {
      list.hidden = list.dataset.cfgsecList !== info.id;
    }
    const list = sectionsWrap.querySelector<HTMLElement>(`[data-cfgsec-list="${info.id}"]`);
    if (!list) return;

    for (const def of defs) {
      const row = list.querySelector<HTMLElement>(`[data-cfgsec="${def.id}"]`);
      if (!row) continue;
      const saved = state?.[def.id];
      const on = saved?.on ?? def.on;

      const toggle = row.querySelector<HTMLElement & { checked: boolean }>('[data-cfgsec-toggle]');
      if (toggle) toggle.checked = on;

      // The caret is DISABLED until the section is on: a settings panel for a part
      // that is not rendering configures nothing. Disabled rather than hidden, so a
      // section that HAS settings still looks different from one that has none.
      const caret = row.querySelector<HTMLButtonElement>('[data-cfgsec-expand]');
      const body = row.querySelector<HTMLElement>('[data-cfgsec-body]');
      if (caret && body) {
        caret.disabled = !on;
        // Reopening the dialog starts each section collapsed. The expansion is a
        // reading state, not a saved preference — persisting it would put UI state
        // in the layout record next to the widget's actual configuration.
        setExpanded(caret, body, false);
      }

      for (const field of row.querySelectorAll<HTMLElement>('[data-cfgsec-setting]')) {
        setSectionSetting(field, def, saved);
      }
    }
    reorderSectionRows(list, info, state);
  };

  /**
   * Put the bars in display order: ON sections first, then OFF, each keeping its
   * relative sequence. Mirrors orderedSections() in the data module — the same rule
   * the widget itself renders its parts by, so the form and the board agree about
   * where a section sits.
   *
   * Reordering the DOM rather than storing a display order is what makes "toggling
   * moves it between the groups" free: the partition is re-derived from the switches
   * every time, so it cannot drift from them.
   */
  const reorderSectionRows = (
    list: HTMLElement,
    info: CfgInfo,
    state?: Record<string, SectionState>,
  ): void => {
    const defs = info.sections ?? [];
    const order = draftSectionOrder.length ? draftSectionOrder : defs.map((d) => d.id);
    const rank = (id: string) => {
      const i = order.indexOf(id);
      return i === -1 ? order.length + defs.findIndex((d) => d.id === id) : i;
    };
    const isOn = (id: string) => state?.[id]?.on ?? defs.find((d) => d.id === id)?.on ?? false;
    const rows = [...list.querySelectorAll<HTMLElement>('[data-cfgsec]')];
    rows
      .sort((a, b) => {
        const ida = a.dataset.cfgsec!;
        const idb = b.dataset.cfgsec!;
        const on = Number(isOn(idb)) - Number(isOn(ida));
        return on !== 0 ? on : rank(ida) - rank(idb);
      })
      .forEach((row) => list.appendChild(row));
  };

  /** One disclosure's open state, kept on the caret and its body together so the
      arrow and the panel can never disagree. */
  const setExpanded = (caret: HTMLButtonElement, body: HTMLElement, open: boolean): void => {
    caret.setAttribute('aria-expanded', String(open));
    body.hidden = !open;
  };

  /**
   * Fill one setting control and set its value.
   *
   * `count` builds its options from the declared min/max rather than carrying a
   * written-out list, so widening a range in the registry is a number change and not
   * a markup edit. esa-select takes `options` as a PROPERTY, which is why this runs
   * at all — markup cannot express it.
   */
  const setSectionSetting = (
    field: HTMLElement,
    def: { settings?: readonly { id: string; kind: string; default?: unknown }[] },
    saved?: SectionState,
  ): void => {
    const id = field.dataset.cfgsecSetting;
    if (!id) return;
    const setting = def.settings?.find((x) => x.id === id);
    const value = saved?.values?.[id] ?? setting?.default;

    if (field.dataset.kind === 'count') {
      const min = Number(field.dataset.min ?? 1);
      const max = Number(field.dataset.max ?? 1);
      const el = field as HTMLElement & { options: { value: string; label: string }[]; value: string };
      el.options = Array.from({ length: Math.max(0, max - min + 1) }, (_, i) => {
        const n = min + i;
        return { value: String(n), label: String(n) };
      });
      el.value = String(value ?? min);
      return;
    }
    if (field.dataset.kind === 'text') {
      (field as HTMLElement & { value: string }).value = String(value ?? '');
      return;
    }
    if (field.dataset.kind === 'choice') {
      const el = field as HTMLElement & { options: unknown; value: string };
      try {
        el.options = JSON.parse(field.dataset.options ?? '[]');
      } catch {
        el.options = [];
      }
      el.value = String(value ?? '');
      return;
    }
    (field as HTMLElement & { checked: boolean }).checked = value === true;
  };

  const setColorFields = (info: CfgInfo, color?: WidgetColor): void => {
    if (monoWrap) monoWrap.hidden = info.colorMode !== 'mono';
    if (seriesWrap) seriesWrap.hidden = info.colorMode !== 'series';
    monoWrap?.querySelector('[data-color-field]')?.dispatchEvent(
      new CustomEvent('bcn-color-set', { detail: { value: color?.mode === 'mono' ? color.color : null } }),
    );
    seriesWrap?.querySelectorAll('[data-color-field]').forEach((field) => {
      const key = field.getAttribute('data-series') || '';
      const value = color?.mode === 'series' ? (color.series[key] ?? null) : null;
      field.dispatchEvent(new CustomEvent('bcn-color-set', { detail: { value } }));
    });
  };

  /**
   * Opens the dialog for a placed instance (edit) or for a type not yet on the
   * board (add). In add mode the preview is a clone of the TYPE's template rather
   * than of a live tile, which is what lets someone see and section a widget
   * before committing it.
   */
  const openConfig = (id: string, addType?: string): void => {
    adding = Boolean(addType);
    const type = addType ?? typeOf(id);
    const el = adding ? templates.get(type) : widgetEls.get(id);
    const info = infoById.get(type);
    if (!el || !info || !dialog) return;
    const saved = readConfig().widgets[id];
    const c: WidgetConfig & { sections?: Record<string, boolean> } = adding || !saved
      ? {
          on: true,
          width: info.width ?? 2,
          chart: info.charts[0],
          scope: info.scopes[0],
          sections: Object.fromEntries((info.sections ?? []).map((x) => [x.id, x.on])),
        }
      : saved;
    openId = id;
    openType = type;
    draft = { ...c, color: c.color ? JSON.parse(JSON.stringify(c.color)) : undefined };
    // Seed the drag order from the saved record; empty means registry order, which
    // is the same absent-is-default rule the record itself uses.
    draftSectionOrder = [...(c.sectionOrder ?? [])];

    // The preview is the REAL widget: clone, made inert, tools dropped.
    clone = el.cloneNode(true) as HTMLElement;
    clone.hidden = false;
    clone.setAttribute('inert', '');
    clone.querySelector('.bcn-dwidget__tools')?.remove();
    // The preview honours the DRAFT's sections, so toggling a switch shows the
    // widget it would actually add — the whole point of previewing before commit.
    applySections(clone, type, draft.sections);
    // A cloned Leaflet host would render an empty well; the preview is a still
    // picture of layout, so drop the map's scaffolding and let the well stand in.
    clone.querySelectorAll<HTMLElement>('[data-bcn-obsmap]').forEach((host) => {
      delete host.dataset.bcnObsmapReady;
      host.removeAttribute('id');
    });
    const { frameW, minH } = frameMath();
    stageEvent('bcn-stage-show', {
      node: clone,
      frameWidth: frameW(draft.width),
      minHeight: minH,
      badge: badgeOf(draft.width),
    });

    if (dialog) dialog.setAttribute('heading', adding ? `Add ${info.title}` : 'Configure widget');
    if (addBtn) addBtn.hidden = !adding;
    if (saveBtn) saveBtn.hidden = adding;
    if (removeBtn) removeBtn.hidden = adding;
    if (tabs) tabs.value = String(draft.width);
    if (titleField) titleField.value = draft.title ?? info.title;
    if (showsField) showsField.hidden = info.charts.length < 2;
    // Same flag that decides whether the widget renders a range control at all.
    if (scopeField) scopeField.hidden = !info.windowed;
    if (showsSelect) {
      showsSelect.options = info.charts.map((v) => ({ label: CHART_LABEL[v] ?? v, value: v }));
      showsSelect.value = draft.chart;
    }
    if (scopeSelect) {
      scopeSelect.options = info.scopes.map((v) => ({ label: SCOPE_LABEL[v] ?? v, value: v }));
      scopeSelect.value = draft.scope;
    }
    setSectionFields(info, draft.sections);
    setColorFields(info, draft.color);

    dialog.open = true;
  };

  const closeConfig = (): void => {
    if (dialog) dialog.open = false;
    openId = null;
    openType = null;
    adding = false;
    draft = null;
    clone = null;
  };

  const reframe = (): void => {
    if (!draft) return;
    const { frameW, minH } = frameMath();
    stageEvent('bcn-stage-show', {
      node: clone,
      frameWidth: frameW(draft.width),
      minHeight: minH,
      badge: badgeOf(draft.width),
    });
  };

  dialog?.addEventListener('change', (event) => {
    if (!draft || !openId) return;
    const el = event.target as HTMLElement;
    const value = (event as CustomEvent<{ value?: string }>).detail?.value ?? (el as HTMLInputElement).value;
    if (el.hasAttribute('data-cfg-tabs')) {
      // The column tabs are the dialog's ONLY size control (Andy round 5) —
      // height stays the widget's stored footprint.
      draft.width = Number(value) as WidgetConfig['width'];
      reframe();
    } else if (el.hasAttribute('data-cfg-title')) {
      draft.title = value || undefined;
      const h = clone?.querySelector('.bcn-dwidget__title');
      if (h) h.textContent = value || infoById.get(openType ?? '')?.title || '';
    } else if (el.hasAttribute('data-cfg-shows')) {
      draft.chart = value as WidgetConfig['chart'];
    } else if (el.hasAttribute('data-cfg-scope')) {
      draft.scope = value as WidgetConfig['scope'];
    } else if (el.hasAttribute('data-cfgsec-toggle')) {
      const row = el.closest<HTMLElement>('[data-cfgsec]');
      const key = row?.dataset.cfgsec;
      if (!key) return;
      const checked = (el as HTMLElement & { checked: boolean }).checked;
      // Merge, never replace: a section's `values` must survive its toggle being
      // flipped off and on again, or every setting resets the moment a user hides a
      // part and changes their mind.
      draft.sections = {
        ...(draft.sections ?? {}),
        [key]: { ...(draft.sections?.[key] ?? {}), on: checked },
      };

      // Switching ON opens the settings, because that is the moment a user is most
      // likely to want them — they just asked for the part. Switching OFF collapses
      // and disables, so the panel cannot be left open over a section that is not
      // rendering.
      const caret = row.querySelector<HTMLButtonElement>('[data-cfgsec-expand]');
      const body = row.querySelector<HTMLElement>('[data-cfgsec-body]');
      if (caret && body) {
        caret.disabled = !checked;
        setExpanded(caret, body, checked);
      }

      // Re-section the preview so the switch shows its own consequence.
      //
      // The bar deliberately does NOT move (Jamie, 2026-09-10). It used to jump
      // between the on and off groups on every flip, which meant the row you just
      // clicked left under the pointer — and turning two sections off in a row moved
      // the second one before you reached it. The partition is applied when the list
      // is BUILT (setSectionFields, i.e. on open) and by the board on save; between
      // those, the list holds still. orderedSections() is still the single rule, so
      // nothing diverges — this only changes WHEN it is applied.
      if (clone && openType) applySections(clone, openType, draft.sections);
      reframe();
    } else if (el.hasAttribute('data-cfgsec-setting')) {
      const row = el.closest<HTMLElement>('[data-cfgsec]');
      const key = row?.dataset.cfgsec;
      const settingId = el.dataset.cfgsecSetting;
      if (!key || !settingId) return;
      const kind = el.dataset.kind;
      const next: SectionValue =
        kind === 'count'
          ? Number(value)
          : kind === 'flag'
            ? (el as HTMLElement & { checked: boolean }).checked
            : value;
      const current = draft.sections?.[key] ?? {
        on: infoById.get(openType ?? '')?.sections?.find((d) => d.id === key)?.on ?? true,
      };
      draft.sections = {
        ...(draft.sections ?? {}),
        [key]: { ...current, values: { ...(current.values ?? {}), [settingId]: next } },
      };
      // The preview honours settings the same way the board does, so a row count
      // shows its effect in the clone before anything is saved.
      if (clone && openType) applySections(clone, openType, draft.sections);
      reframe();
    }
  });

  // ── Section reorder (2026-09-10) ────────────────────────────────────────────
  //    A vertical list inside a dialog, which is a far smaller problem than the
  //    board's drag: one axis, no column spans, no placeholder to size, and the
  //    list is short enough that moving the row itself IS the preview. So there is
  //    no lifted clone and no slot — the row moves in the DOM as the pointer
  //    crosses midlines, and the drop just reads the result back out.
  let secDrag: { row: HTMLElement; list: HTMLElement } | null = null;

  /** The row the pointer sits above, by midline — the one to insert BEFORE. Null
      means past the last row, i.e. append. */
  const sectionRowAt = (list: HTMLElement, y: number): HTMLElement | null => {
    for (const row of list.querySelectorAll<HTMLElement>('[data-cfgsec]')) {
      const r = row.getBoundingClientRect();
      if (y < r.top + r.height / 2) return row;
    }
    return null;
  };

  /**
   * Read the dragged result into the draft, then re-derive the partition.
   *
   * The re-derive is deliberate and visible: drag an ON section down among the OFF
   * ones and it snaps back above them, having kept the new position it gained WITHIN
   * its own group. That is the rule the user asked for — selected sections stay above
   * unselected — and it holds without a special case, because the stored order only
   * ever carries the relative sequence.
   */
  const commitSectionOrder = (): void => {
    if (!secDrag) return;
    const { list } = secDrag;
    // RECORD FIRST, then react. The order is a fact about the DOM the user just
    // rearranged, so it is captured before anything that depends on other open-dialog
    // state — an early return further down must not be able to lose the drag.
    draftSectionOrder = [...list.querySelectorAll<HTMLElement>('[data-cfgsec]')].map(
      (r) => r.dataset.cfgsec!,
    );
    if (!draft || !openType) return;
    const info = infoById.get(openType);
    if (info) reorderSectionRows(list, info, draft.sections);
    // The preview reorders with it, so the drag shows the widget it would produce.
    if (clone) {
      applySectionOrder(clone, openType, {
        sections: draft.sections,
        sectionOrder: draftSectionOrder,
      });
    }
    reframe();
  };

  dialog?.addEventListener('pointerdown', (event) => {
    const grip = (event.target as Element | null)?.closest<HTMLElement>('[data-cfgsec-grip]');
    if (!grip) return;
    const row = grip.closest<HTMLElement>('[data-cfgsec]');
    const list = grip.closest<HTMLElement>('[data-cfgsec-list]');
    if (!row || !list) return;
    event.preventDefault(); // the grip is a button; do not let it click or select
    secDrag = { row, list };
    row.classList.add('is-dragging');
    grip.setPointerCapture?.(event.pointerId);
  });

  dialog?.addEventListener('pointermove', (event) => {
    if (!secDrag) return;
    const { row, list } = secDrag;
    const before = sectionRowAt(list, event.clientY);
    if (before === row) return;
    if (before) list.insertBefore(row, before);
    else list.appendChild(row);
  });

  const endSectionDrag = (): void => {
    if (!secDrag) return;
    secDrag.row.classList.remove('is-dragging');
    commitSectionOrder();
    secDrag = null;
  };
  dialog?.addEventListener('pointerup', endSectionDrag);
  dialog?.addEventListener('pointercancel', endSectionDrag);

  // ── The settings disclosure. Click-only: the caret is disabled while the section
  //    is off, and the switch beside it owns the auto-expand. ──
  dialog?.addEventListener('click', (event) => {
    const caret = (event.target as Element | null)?.closest<HTMLButtonElement>('[data-cfgsec-expand]');
    if (!caret || caret.disabled) return;
    const body = caret.closest<HTMLElement>('[data-cfgsec]')?.querySelector<HTMLElement>('[data-cfgsec-body]');
    if (!body) return;
    setExpanded(caret, body, caret.getAttribute('aria-expanded') !== 'true');
  });

  dialog?.addEventListener('bcn-color-change', (event) => {
    if (!draft || !openId || !clone) return;
    const { value, seriesKey } = (event as CustomEvent<{ value: MarkKey; seriesKey?: string }>).detail;
    const info = infoById.get(openType ?? '')!;
    if (info.colorMode === 'mono') draft.color = { mode: 'mono', color: value };
    else if (info.colorMode === 'series' && seriesKey) {
      const series = draft.color?.mode === 'series' ? { ...draft.color.series } : {};
      series[seriesKey] = value;
      draft.color = { mode: 'series', series };
    }
    applyColor(clone, openId, draft.color); // live on the preview clone
  });

  /**
   * What a commit writes. BOTH the save path and the add path go through this,
   * because they had already diverged: sectionOrder was added to the add branch and
   * silently missing from save, so dragging a section then pressing "Save widget"
   * discarded the drag with no error anywhere. Two hand-maintained object literals
   * describing the same commit is the drift; one builder is the fix.
   *
   * `sectionOrder` is written ONLY when the user actually dragged. An empty array
   * would claim an order the registry already provides, and a later registry change
   * could then never move a section for anyone who had opened the dialog once.
   */
  const commitPatch = (): Partial<WidgetInstanceLike> => ({
    ...(draft as WidgetConfig),
    type: openType ?? undefined,
    ...(draftSectionOrder.length ? { sectionOrder: [...draftSectionOrder] } : {}),
  });

  dialog?.addEventListener('click', (event) => {
    const target = event.target as Element | null;
    if (!target) return;
    if (target.closest('[data-cfg-save]')) {
      if (openId && openType && draft) {
        const id = openId;
        const type = openType;
        const next = draft;
        mutate((c) => (c.widgets[id] = { ...c.widgets[id], ...commitPatch(), type }));
      }
      closeConfig();
    } else if (target.closest('[data-cfg-add]')) {
      // Commit point for add mode: the instance is written and appended to the
      // END of the order, so a newly added widget lands where the user last
      // looked (beside the add tile) rather than at its type's old position.
      if (openId && openType && draft) {
        const id = openId;
        const type = openType;
        mutate((c) => {
          c.widgets[id] = { ...commitPatch(), type, on: true };
          if (!c.order.includes(id)) c.order.push(id);
        });
      }
      closeConfig();
      syncAddCards();
    } else if (target.closest('[data-cfg-cancel]')) {
      closeConfig();
    } else if (target.closest('[data-cfg-remove]')) {
      if (openId) removeInstance(openId);
      closeConfig();
    }
  });

  // ── Drag mode (spec §11.3): column tracks show the structure; ONE reflowing
  //    placeholder (.mpd-slot) is both the origin hole and the drop target. The
  //    placeholder is not a picture of the insertion index — it IS the insertion
  //    index, laid out by the same auto-placement that runs on drop, so the
  //    board reflows now exactly as it will on release. ──
  let dragId: string | null = null;
  let slotEl: HTMLElement | null = null;

  const visibleOrder = (): HTMLElement[] =>
    Array.from(grid?.querySelectorAll<HTMLElement>('.bcn-dwidget:not([hidden])') ?? []);

  /** The reflowing placeholder, at the dragged widget's real footprint. Its row span
      is the MEASURED span the card is carrying, so the hole is exactly the size of
      the card that will land in it. The badge reads columns, since that is the only
      part of the footprint the user chose. */
  const makeSlot = (w: string, span: string): HTMLElement => {
    const slot = document.createElement('div');
    slot.className = 'mpd-slot';
    slot.style.gridColumn = `span ${w}`;
    slot.style.gridRowEnd = `span ${span}`;
    slot.dataset.size = w === '1' ? '1 column' : `${w} columns`;
    return slot;
  };

  /** Move the slot so it sits before `ref` (or before the add tile at the end).
      One DOM move per index change — never per pointermove. */
  const placeSlotBefore = (ref: Element | null): void => {
    if (!grid || !slotEl) return;
    const target = ref ?? grid.querySelector('.mpd-add');
    if (!target || target === slotEl || slotEl.nextElementSibling === target) return;
    grid.insertBefore(slotEl, target);
  };

  /** The candidate insertion point for a pointer position: the nearest visible
      widget (the lifted one excluded), split at its midline — vertical for the
      row axis, horizontal within a band. Returns the element to insert BEFORE
      (null = end of board). */
  const insertionRefAt = (x: number, y: number): Element | null => {
    const els = visibleOrder().filter((el) => el.dataset.widgetId !== dragId);
    let best: HTMLElement | null = null;
    let bestDist = Infinity;
    for (const el of els) {
      const r = el.getBoundingClientRect();
      const dx = Math.max(r.left - x, 0, x - r.right);
      const dy = Math.max(r.top - y, 0, y - r.bottom);
      const dist = dx * dx + dy * dy;
      if (dist < bestDist) {
        bestDist = dist;
        best = el;
      }
    }
    if (!best) return null;
    const r = best.getBoundingClientRect();
    const before = y < r.top ? true : y > r.bottom ? false : x < r.left + r.width / 2;
    return before ? best : best.nextElementSibling;
  };

  const reorderTo = (id: string, index: number): void => {
    const visible = visibleOrder()
      .map((el) => el.dataset.widgetId!)
      .filter(Boolean);
    const from = visible.indexOf(id);
    if (from < 0) return;
    let to = index;
    if (from < to) to -= 1;
    visible.splice(from, 1);
    visible.splice(Math.max(0, Math.min(to, visible.length)), 0, id);
    mutate((c) => {
      c.order = [...visible, ...c.order.filter((x) => !visible.includes(x))];
    });
  };

  const endDrag = (): void => {
    if (!grid) return;
    dragScrollTarget()?.removeEventListener('scroll', onDragScroll);
    stopEdgeScroll();
    delete grid.dataset.mode;
    slotEl?.remove();
    slotEl = null;
    grid.querySelectorAll<HTMLElement>('.bcn-dwidget').forEach((el) => {
      el.classList.remove('is-drag-origin', 'is-drag-lifted');
    });
    dragId = null;
  };

  // ── The pointer drag (Andy round 5): a real lift. HTML5 dnd is gone — its
  //    OS-rendered snapshot gave no sense of HOLDING the card and no control
  //    over the settle. Now: press the header (M8), move past the 4px click
  //    threshold, and the widget pins fixed at its origin rect and follows the
  //    pointer via translate3d while the slot reflows underneath; release
  //    animates it INTO the slot before the order commits; Escape or
  //    pointercancel flies it home and changes nothing. ──
  interface DragState {
    id: string;
    el: HTMLElement;
    startX: number;
    startY: number;
    lastX: number;
    lastY: number;
    originRect: DOMRect;
    lifted: boolean;
    raf: number;
  }
  let ptrDrag: DragState | null = null;

  /**
   * ── EDGE AUTO-SCROLL, and why it needs the scroller rather than the window ──
   *
   * This board does NOT scroll the document: the app shell puts the page inside an
   * `overflow-y: auto` container, so `window.scrollBy` moves nothing and
   * `scrollingElement.scrollTop` stays 0 forever. Measured on this page: the
   * document reports no overflow at all while the shell's content div is 4464px of
   * scrollHeight in a 1198px viewport. So the scroller is DISCOVERED from the DOM,
   * not assumed — and discovered rather than hardcoded to the shell's class name,
   * because that class belongs to @esa/ecology and is free to change.
   */
  const scrollerOf = (from: HTMLElement): HTMLElement => {
    for (let p: HTMLElement | null = from; p; p = p.parentElement) {
      const cs = getComputedStyle(p);
      if (/(auto|scroll|overlay)/.test(cs.overflowY) && p.scrollHeight > p.clientHeight + 1) {
        return p;
      }
    }
    return (document.scrollingElement as HTMLElement | null) ?? document.body;
  };

  /** Distance from the scroller's edge at which auto-scroll starts, and the speed at
   *  the very edge (px per frame). 72px is about a card header, so the zone is
   *  reachable without leaving the board; 18px/frame is ~1000px/s, fast enough to
   *  cross this board in a couple of seconds without overshooting a target. */
  const EDGE_ZONE = 72;
  const EDGE_SPEED = 18;

  let dragScroller: HTMLElement | null = null;
  let edgeRaf = 0;

  /** Ramped so the speed is proportional to how far into the zone the pointer is —
   *  a hard on/off at the boundary makes the board feel like it lurches. */
  const edgeSpeed = (depth: number): number =>
    Math.min(EDGE_SPEED, (EDGE_SPEED * depth) / EDGE_ZONE);

  const edgeScrollStep = (): void => {
    edgeRaf = 0;
    if (!ptrDrag?.lifted || !dragScroller) return;

    const y = ptrDrag.lastY;
    // The zone is measured against the SCROLLER's box, not the viewport: its top
    // sits below the app bar, and scrolling should start when the pointer nears the
    // edge of the scrolling region the user can actually see into.
    const box =
      dragScroller === document.scrollingElement || dragScroller === document.body
        ? { top: 0, bottom: window.innerHeight }
        : dragScroller.getBoundingClientRect();

    let dy = 0;
    if (y < box.top + EDGE_ZONE) dy = -edgeSpeed(box.top + EDGE_ZONE - y);
    else if (y > box.bottom - EDGE_ZONE) dy = edgeSpeed(y - (box.bottom - EDGE_ZONE));

    if (dy !== 0) {
      const before = dragScroller.scrollTop;
      dragScroller.scrollTop = before + dy;
      // The pointer held still but the content moved under it, so the drop target
      // is not the one it was a frame ago. Without this the placeholder stays put
      // while the board slides past — the drag appears to stop tracking.
      if (dragScroller.scrollTop !== before) {
        placeSlotBefore(insertionRefAt(ptrDrag.lastX, y));
      }
    }

    // Keep the loop alive for the whole lift: the pointer can sit motionless in the
    // zone and must keep scrolling, which a pointermove-driven version cannot do.
    edgeRaf = requestAnimationFrame(edgeScrollStep);
  };

  const startEdgeScroll = (): void => {
    if (!grid) return;
    dragScroller = scrollerOf(grid);
    if (!edgeRaf) edgeRaf = requestAnimationFrame(edgeScrollStep);
  };

  const stopEdgeScroll = (): void => {
    if (edgeRaf) cancelAnimationFrame(edgeRaf);
    edgeRaf = 0;
    dragScroller = null;
  };

  /** Manual scrolling during a drag — wheel or trackpad — moves the board under a
      stationary pointer, so the placeholder has to be re-derived for the same reason
      the auto-scroll does. This also fires (harmlessly) for the auto-scroll's own
      writes; the placement call is idempotent, and having one path rather than a
      "was that me?" flag is worth one extra rect read per frame. */
  const onDragScroll = (): void => {
    if (!ptrDrag?.lifted) return;
    placeSlotBefore(insertionRefAt(ptrDrag.lastX, ptrDrag.lastY));
  };

  /** Where to listen for that scroll. A scrolling ELEMENT emits on itself, but the
   *  document's scroll emits on window — not on <html> — so the two cases need
   *  different targets. Wrong target here means the manual-scroll case silently does
   *  nothing on a page whose shell does not use an inner scroller. */
  const dragScrollTarget = (): EventTarget | null =>
    !dragScroller
      ? null
      : dragScroller === document.scrollingElement || dragScroller === document.body
        ? window
        : dragScroller;

  const lift = (): void => {
    if (!grid || !ptrDrag) return;
    const { el, originRect: r } = ptrDrag;
    dragId = ptrDrag.id;
    grid.dataset.mode = 'drag';
    slotEl = makeSlot(el.dataset.w || '1', el.dataset.span || String(MIN_SPAN));
    grid.insertBefore(slotEl, el);
    // Pin the root at its origin rect; the shell's .is-drag-lifted owns the
    // rest (fixed, z-index, pointer-events none, card scale + shadow).
    el.style.top = `${r.top}px`;
    el.style.left = `${r.left}px`;
    el.style.width = `${r.width}px`;
    el.style.height = `${r.height}px`;
    el.classList.add('is-drag-lifted');
    document.body.classList.add('is-widget-drag');
    startEdgeScroll();
    dragScrollTarget()?.addEventListener('scroll', onDragScroll, { passive: true });
  };

  const paintDrag = (): void => {
    if (!ptrDrag?.lifted) return;
    const { el, startX, startY, lastX, lastY } = ptrDrag;
    el.style.transform = `translate3d(${lastX - startX}px, ${lastY - startY}px, 0)`;
    placeSlotBefore(insertionRefAt(lastX, lastY));
    ptrDrag.raf = 0;
  };

  const clearLift = (el: HTMLElement): void => {
    el.style.top = '';
    el.style.left = '';
    el.style.width = '';
    el.style.height = '';
    el.style.transform = '';
    el.style.transition = '';
    document.body.classList.remove('is-widget-drag');
  };

  const stopPtrListeners = (): void => {
    window.removeEventListener('pointermove', onPtrMove);
    window.removeEventListener('pointerup', onPtrUp);
    window.removeEventListener('pointercancel', onPtrCancel);
    document.removeEventListener('keydown', onPtrKey, true);
  };

  /** Animate the lifted card by (dx, dy) from its origin, then run `done`.
      transitionend can be swallowed (a zero-distance move fires nothing) — the
      timeout is the floor under it. */
  const settleTo = (el: HTMLElement, dx: number, dy: number, done: () => void): void => {
    let ran = false;
    const finish = (): void => {
      if (ran) return;
      ran = true;
      done();
    };
    el.style.transition = 'transform 160ms ease';
    el.style.transform = `translate3d(${dx}px, ${dy}px, 0)`;
    el.addEventListener('transitionend', finish, { once: true });
    window.setTimeout(finish, 220);
  };

  const onPtrMove = (event: PointerEvent): void => {
    if (!ptrDrag) return;
    ptrDrag.lastX = event.clientX;
    ptrDrag.lastY = event.clientY;
    if (!ptrDrag.lifted) {
      if (Math.hypot(event.clientX - ptrDrag.startX, event.clientY - ptrDrag.startY) < 4) return;
      ptrDrag.lifted = true;
      lift();
    }
    if (!ptrDrag.raf) ptrDrag.raf = requestAnimationFrame(paintDrag);
  };

  const cancelPtrDrag = (): void => {
    if (!ptrDrag) return;
    const d = ptrDrag;
    ptrDrag = null;
    stopPtrListeners();
    if (!d.lifted) return;
    // Fly home: only the slot moved in the DOM, so zeroing the translate IS the
    // origin position; endDrag then removes the slot and the board is untouched.
    settleTo(d.el, 0, 0, () => {
      clearLift(d.el);
      endDrag();
    });
  };

  const onPtrUp = (): void => {
    if (!ptrDrag) return;
    const d = ptrDrag;
    ptrDrag = null;
    stopPtrListeners();
    if (!d.lifted) return; // never left click territory
    if (!grid || !slotEl) {
      clearLift(d.el);
      endDrag();
      return;
    }
    // The slot's DOM position IS the committed order: its index among the other
    // visible widgets (the lifted one excluded) is where the id re-enters.
    const others = visibleOrder()
      .map((el) => el.dataset.widgetId!)
      .filter((x) => x && x !== d.id);
    let index = 0;
    for (let el = slotEl.previousElementSibling; el; el = el.previousElementSibling) {
      const id = (el as HTMLElement).dataset?.widgetId;
      if (id && others.includes(id)) index++;
    }
    // Settle INTO the slot, then commit — the reflow lands where the card
    // visibly came to rest.
    const slotRect = slotEl.getBoundingClientRect();
    settleTo(d.el, slotRect.left - d.originRect.left, slotRect.top - d.originRect.top, () => {
      clearLift(d.el);
      endDrag();
      others.splice(index, 0, d.id);
      mutate((c) => {
        c.order = [...others, ...c.order.filter((x) => !others.includes(x))];
      });
    });
  };

  const onPtrCancel = (): void => cancelPtrDrag();
  const onPtrKey = (event: KeyboardEvent): void => {
    if (event.key === 'Escape') {
      event.preventDefault();
      cancelPtrDrag();
    }
  };

  // The WHOLE card header starts a drag (Andy round 3, M8) — any header press
  // that isn't the ⋯ menu. The grip stays as the visual cue and the keyboard
  // entry (Enter/Space → move mode, replacing the menu's removed Move row).
  grid?.addEventListener('pointerdown', (event) => {
    if (event.button !== 0 || ptrDrag) return;
    const target = event.target as Element | null;
    if (target?.closest('[data-widget-menu]')) return;
    const head = target?.closest('.bcn-dwidget__head');
    const widget = head?.closest<HTMLElement>('.bcn-dwidget');
    if (!widget?.dataset.widgetId) return;
    event.preventDefault(); // no text selection under the drag
    ptrDrag = {
      id: widget.dataset.widgetId,
      el: widget,
      startX: event.clientX,
      startY: event.clientY,
      lastX: event.clientX,
      lastY: event.clientY,
      originRect: widget.getBoundingClientRect(),
      lifted: false,
      raf: 0,
    };
    window.addEventListener('pointermove', onPtrMove);
    window.addEventListener('pointerup', onPtrUp);
    window.addEventListener('pointercancel', onPtrCancel);
    document.addEventListener('keydown', onPtrKey, true);
  });
  grid?.addEventListener('keydown', (event) => {
    if (event.key !== 'Enter' && event.key !== ' ') return;
    const grip = (event.target as Element | null)?.closest('[data-widget-grip]');
    const id = grip?.closest<HTMLElement>('.bcn-dwidget')?.dataset.widgetId;
    if (!id) return;
    event.preventDefault();
    enterMoveMode(id);
  });

  // Keyboard path (Enter/Space on the grip): arrows move one position, Enter
  // commits, Escape restores the pre-move order.
  const enterMoveMode = (id: string): void => {
    if (!grid) return;
    const before = readConfig();
    grid.dataset.mode = 'drag';
    widgetEls.get(id)?.classList.add('is-drag-origin');
    const onKey = (event: KeyboardEvent): void => {
      if (event.key === 'ArrowLeft' || event.key === 'ArrowUp' || event.key === 'ArrowRight' || event.key === 'ArrowDown') {
        event.preventDefault();
        const visible = visibleOrder().map((el) => el.dataset.widgetId!);
        const from = visible.indexOf(id);
        const dir = event.key === 'ArrowLeft' || event.key === 'ArrowUp' ? -1 : 1;
        const to = from + dir + (dir > 0 ? 1 : 0);
        if (from >= 0 && to >= 0 && to <= visible.length) reorderTo(id, to);
        grid.dataset.mode = 'drag'; // apply() cleared nothing, but keep the state explicit
        widgetEls.get(id)?.classList.add('is-drag-origin');
      } else if (event.key === 'Enter') {
        event.preventDefault();
        exit();
      } else if (event.key === 'Escape') {
        event.preventDefault();
        writeConfig(before);
        apply(before);
        exit();
      }
    };
    const exit = (): void => {
      document.removeEventListener('keydown', onKey, true);
      endDrag();
    };
    document.addEventListener('keydown', onKey, true);
  };

  // ── Add widget (spec §10.8): the picker lists what the layout has turned off. ──
  const addDialog = document.getElementById('mpd-add-dialog') as (HTMLElement & { open: boolean }) | null;

  // ── Add-widget gallery (spec §11.4). Cards are server-rendered; this only
  //    syncs their placed-state from config. Picks commit on click and the
  //    dialog STAYS OPEN — the card's flip to `On dashboard` is the confirmation. ──
  /**
   * Gallery cards are never DISABLED any more (2026-09-08): a widget may be added
   * more than once, so "already on the dashboard" is a fact worth showing but not
   * a reason to block the click. data-on still drives the card's placed styling;
   * the count tells the user how many are out there.
   */
  const syncAddCards = (): void => {
    const config = readConfig();
    const placed = new Map<string, number>();
    for (const id of config.order) {
      const w = config.widgets[id];
      if (!w?.on) continue;
      const t = w.type ?? typeOf(id);
      placed.set(t, (placed.get(t) ?? 0) + 1);
    }
    addDialog?.querySelectorAll<HTMLButtonElement>('[data-widget-card]').forEach((card) => {
      const n = placed.get(card.dataset.widgetId ?? '') ?? 0;
      card.toggleAttribute('data-on', n > 0);
      card.disabled = false;
      card.dataset.placedCount = n > 0 ? String(n) : '';
    });
  };

  document.addEventListener('click', (event) => {
    const target = event.target as Element | null;
    if (target?.closest('[data-mpd-add-open]')) {
      syncAddCards();
      if (addDialog) addDialog.open = true;
      return;
    }
    const card = target?.closest<HTMLButtonElement>('[data-widget-card]');
    if (card && card.dataset.widgetId) {
      const type = card.dataset.widgetId;
      const config = readConfig();
      // Picking a type no longer places it. It opens the configure dialog with a
      // live preview so sections can be chosen BEFORE it lands on the board.
      const off = config.widgets[type] && !config.widgets[type].on;
      // Re-enabling the switched-off original reuses its id, so it returns to its
      // saved position; anything else is a genuinely new instance.
      const instanceId = off
        ? type
        : (() => {
            const taken = new Set(Object.keys(config.widgets));
            if (!taken.has(type)) return type;
            for (let n = 2; ; n++) if (!taken.has(`${type}~${n}`)) return `${type}~${n}`;
          })();
      if (addDialog) addDialog.open = false;
      openConfig(instanceId, type);
    }
  });

  // ── Per-widget date range (2026-09-08) ──────────────────────────────────────
  // Each widget owns its own window. Changing one writes `scope` on THAT INSTANCE
  // and re-derives only that widget's figures — the rest of the board is untouched,
  // which is the whole point ("refresh without reloading the page").
  //
  // The value already had a home: WidgetInstance.scope has existed since the
  // registry was written, and the configure dialog's field (now "Default date
  // range") writes the same key. So this control is not new state — it is a second
  // way to set state the model already had.
  // Fires from esa-select's `change`. Scoped to [data-widget-daterange] so the
  // configure dialog's own selects (which bubble the same event) are ignored.
  document.addEventListener('change', (event) => {
    const el = event.target as HTMLElement | null;
    if (!el?.hasAttribute?.('data-widget-daterange')) return;
    if (el.closest('[data-config-dialog]')) return;
    const widget = el.closest<HTMLElement>('.bcn-dwidget');
    const id = widget?.dataset.widgetId;
    if (!widget || !id) return;
    const scope = (event as CustomEvent<{ value?: string }>).detail?.value
      ?? (el as HTMLInputElement).value;
    if (!scope) return;
    mutate((c) => {
      c.widgets[id] = { ...c.widgets[id], type: c.widgets[id]?.type ?? typeOf(id), scope: scope as WidgetConfig['scope'] };
    });
  });

  // ── Component scope (spec §11.1). The picker announces; this page decides
  //    what re-scoping means — and against this fixture the honest answer for
  //    the three non-geotech components is EMPTY: stats read 0, every viz and
  //    table hides, foot link-throughs stay. Absence renders as absence. ──
  const GEOTECH = grid?.dataset.geotechComponent ?? '';
  const setScope = (component: string): void => {
    if (!grid) return;
    const empty = component !== GEOTECH;
    grid.toggleAttribute('data-scope-empty', empty);
    grid.querySelectorAll<HTMLElement>('.esa-stat__value').forEach((el) => {
      if (empty) {
        if (el.dataset.scopeOrig === undefined) el.dataset.scopeOrig = el.textContent ?? '';
        el.textContent = '0';
      } else if (el.dataset.scopeOrig !== undefined) {
        el.textContent = el.dataset.scopeOrig;
        delete el.dataset.scopeOrig;
      }
    });
  };
  document.addEventListener('bcn:component-change', (event) => {
    const component = (event as CustomEvent<{ component: string }>).detail?.component;
    if (component) setScope(component);
  });
  try {
    const saved = localStorage.getItem('beacon.activeComponent');
    if (saved && saved !== GEOTECH) setScope(saved);
  } catch {
    /* storage unavailable — default scope stands */
  }
</script>

<style>
  /* Composition glue only: the page owns the 3-column grid and its row-unit
     FLOOR (minmax — a band grows to its tallest widget; spec.md §2). Widgets
     own their spans; the shell owns drag-mode chrome; the tracks, slot and add
     tile below are the board's own affordances (spec §11.3, §10.8).
     --_col/--_gap are read by BOTH the real grid and the drag tracks, so their
     alignment is by construction and cannot drift at the breakpoints. */
  .mpdash {
    --_col: 3;
    --_gap: var(--spacing-400);
    /* THE ROW UNIT (2026-09-09). 8px, not a widget-sized band. Each widget spans
       however many of these its OWN content needs (computed in the script, see
       measureSpans), which is what lets two cards in the same visual row have
       different heights — impossible in a row-aligned grid, where every item in a
       row shares that row's height.
       8px is the quantisation error: a card's footprint rounds up to at most 8px
       more than its content. Finer costs more rows for the browser to lay out;
       coarser starts to show as inconsistent gaps. */
    --_row: 8px;
    position: relative; /* the drag tracks are an absolute underlay */
    display: grid;
    grid-template-columns: repeat(var(--_col), minmax(0, 1fr));
    grid-auto-rows: var(--_row);
    /* ROW GAP IS ZERO and each widget carries its own bottom margin instead. With a
       row gap, a span of N rows measures N*unit + (N-1)*gap, so converting a pixel
       height into a span means solving for N against the gap as well — and every
       rounding error lands in the gaps, which then read as uneven. Margin keeps the
       arithmetic to one division and puts the spacing INSIDE the footprint being
       measured. */
    row-gap: 0;
    column-gap: var(--_gap);
  }
  /* Widgets sit over the tracks. (Every widget is already a stacking context
     via container-type; the explicit index just orders it above the underlay.)
     :global — the widget root carries the SHELL's scope attribute, not this
     page's, and the slot is JS-created with no scope at all. The old §10.7
     carets silently missed for exactly this reason. */
  .mpdash > :global(.bcn-dwidget) {
    position: relative;
    z-index: 1;
  }

  /* The add tile — full-width dashed affordance after the last band (§10.8). */
  .mpd-add {
    grid-column: 1 / -1;
    /* Its own row-gap replacement — see the row-gap note on .mpdash. */
    margin-block-end: var(--_gap);
    min-block-size: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-200);
    border: 1.5px dashed var(--color-border-default-strong);
    border-radius: var(--radius-md);
    background: var(--color-background-elevation-base);
    color: var(--color-content-default-secondary);
    font-size: var(--font-size-150);
    font-weight: 600;
    cursor: pointer;
  }
  .mpd-add:hover {
    border-color: var(--color-background-brand);
    background: var(--bcn-teal-100, var(--color-background-elevation-sunken));
    color: var(--color-content-default-primary);
  }
  .mpd-add > span {
    font-size: var(--font-size-400);
    line-height: 1;
  }
  [data-mode='drag'] .mpd-add {
    opacity: 0.4;
    pointer-events: none;
  }

  /* ── Drag canvas (spec §11.3). Two elements replace the §10.7 carets. ── */

  /* 1 — Column tracks: the structure. Neutral-canvas — no brand anywhere in
     the structure — but stepped up from the round-3 gray-50 whisper (Andy
     round 5: the targets have to READ while a card is in hand): the sunken
     surface plus the default border, both semantic. The negative vertical
     inset keeps a full band of all three columns visible above and below the
     board. */
  .mpd-tracks {
    position: absolute;
    inset: calc(var(--_gap) * -1) 0;
    display: grid;
    grid-template-columns: repeat(var(--_col), minmax(0, 1fr));
    gap: var(--_gap);
    pointer-events: none;
    opacity: 0;
    transition: opacity 120ms ease;
    z-index: 0;
  }
  .mpdash[data-mode='drag'] .mpd-tracks {
    opacity: 1;
  }
  .mpd-tracks > i {
    background: var(--color-background-elevation-sunken);
    border: 1px dashed var(--color-border-default-strong);
    border-radius: var(--radius-200);
  }

  /* 2 — The reflowing placeholder: origin hole and drop target are one object,
     at the dragged widget's true footprint. Brand is reserved for it alone.
     :global — the slot is created by the page script, so it never carries the
     scope attribute Astro stamps on template elements. */
  .mpdash :global(.mpd-slot) {
    position: relative;
    /* Matches the widgets' own row spacing — see .mpdash's row-gap note. */
    margin-block-end: var(--_gap);
    border: 2px dashed var(--color-background-brand);
    border-radius: var(--radius-200);
    background: var(--bcn-teal-100, var(--color-background-brand-subtle));
    z-index: 1;
  }
  .mpdash :global(.mpd-slot)::after {
    content: attr(data-size);
    position: absolute;
    inset-block-start: var(--spacing-200);
    inset-inline-end: var(--spacing-200);
    padding: 2px var(--spacing-200);
    border-radius: var(--radius-100);
    background: var(--color-content-default);
    color: var(--color-background-elevation-base);
    font-size: var(--font-size-100);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  /* While a widget is in hand the whole page shows the holding cursor and text
     can't smear-select under the pointer. (The lifted widget itself is pinned
     fixed by the shell's .is-drag-lifted — it does NOT hide; it IS the thing
     being held.) :global — body is outside this page's scope. */
  :global(body.is-widget-drag),
  :global(body.is-widget-drag *) {
    cursor: grabbing;
    user-select: none;
  }

  /* Add-widget gallery (spec §11.4): three across at the dialog's 760px. */
  .mpd-add-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(216px, 1fr));
    gap: var(--spacing-400);
    padding-block: var(--spacing-200);
  }

  /* ── Component scope: the honest empty state (spec §11.1). Everything that is
     not a stat hides; stats read 0 (the page script swaps values); the foot
     link-throughs stay. No copy — absence renders as absence. ── */
  [data-scope-empty] :global(.bcn-viz-donut),
  [data-scope-empty] :global(.bcn-viz-bars),
  [data-scope-empty] :global(.bcn-viz-meter),
  [data-scope-empty] :global(.bcn-viztrend),
  [data-scope-empty] :global(.bcn-mt),
  [data-scope-empty] :global([data-bcn-obsmap]),
  [data-scope-empty] :global([data-cc]),
  [data-scope-empty] :global([data-cc-show]),
  [data-scope-empty] :global(.esa-stat__sub) {
    display: none;
  }
  /* Body groups that hold no stat (table sections, panel labels) hide whole. */
  [data-scope-empty] :global(.bcn-dwidget__body > :not(:has(.esa-stat))) {
    display: none;
  }

  @media (max-width: 1180px) {
    .mpdash {
      --_col: 2;
    }
  }
  @media (max-width: 820px) {
    .mpdash {
      --_col: 1;
    }
  }
</style>
