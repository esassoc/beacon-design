---
// Monitoring Portal — the composable dashboard (WordPress dashboard × iOS widget
// grid; design: specimens/spec.md, remy 2026-08-24).
//
// A 3-column grid whose row unit is a FLOOR (grid-auto-rows: minmax(84px, auto)),
// carrying nine widgets across mixed 1/2/3-column footprints. Every widget is one
// glanceable derivation over a data stream plus a link-through to the stream's
// index — the portal is a launching point, not a destination. Layout editing
// lives ON the dashboard (spec §10, the composer page is dead): the ⋯ menu
// (width, remove), the configure dialog (real-clone preview), pointer
// drag-to-reorder (lift + reflowing slot), and the add-widget tile — all
// writing one saved layout.
//
// Derivations follow prod (esassoc/Beacon origin/develop): active count, "N total
// in the past 30 days", donut by observation type, Outstanding Issues = active
// observations ≥ 7 days (DERIVED — see monitoring.ts), species bars by code.
// Chart/scope variants chosen in the composer persist in the layout record; this
// prototype renders each widget's default chart (variant re-render is out of
// prototype scope).
import AppShell from '../../../layouts/AppShell.astro';
import PageLayout from '../../../layouts/PageLayout.astro';
import EsaStat from '@esa/ecology/esa-stat.astro';
import BcnDashboardWidget from '../../../components/bcn/BcnDashboardWidget.astro';
import BcnVizDonut from '../../../components/bcn/BcnVizDonut.astro';
import BcnVizStacked from '../../../components/bcn/BcnVizStacked.astro';
import BcnVizBars from '../../../components/bcn/BcnVizBars.astro';
import BcnVizTrend from '../../../components/bcn/BcnVizTrend.astro';
import BcnWidgetFlow from '../../../components/bcn/BcnWidgetFlow.astro';
import BcnMiniTable from '../../../components/bcn/BcnMiniTable.astro';
import BcnObservationMap from '../../../components/bcn/BcnObservationMap.astro';
import BcnConfigDialog from '../../../components/bcn/BcnConfigDialog.astro';
import BcnComponentPicker from '../../../components/bcn/BcnComponentPicker.astro';
import BcnComplianceList from '../../../components/bcn/BcnComplianceList.astro';
import BcnWidgetCard from '../../../components/bcn/BcnWidgetCard.astro';
import BcnVizSeasons from '../../../components/bcn/BcnVizSeasons.astro';
import BcnSectionHeading from '../../../components/bcn/BcnSectionHeading.astro';
import BcnWidgetDateRange from '../../../components/bcn/BcnWidgetDateRange.astro';
import { COMPONENTS, GEOTECH_COMPONENT } from '../../../data/geotech-fixture-bio';
import {
  WIDGETS,
  sectionDefs,
  streamById,
  STREAM_ICON_PATHS,
  CONCERNS_ROLLUP,
  DMR_ROLLUP,
  MILEAGE_ROLLUP,
  RUNTIME_ROLLUP,
  WEAP_ROLLUP,
  SEASON_WINDOWS,
  TODAY,
} from '../../../data/monitoring-streams';
import {
  FINDS,
  SURVEYS,
  DASHBOARD,
  SURVEY_STATUS_META,
  PROJECT_NAME,
  outstandingIssues,
  ageDays,
  findStateMeta,
} from '../../../data/monitoring';
import { workAreas } from '../../../data/geotech-fixture-simple';
import { withBase } from '../../../lib/base';
import { bucketSeries, bucketStacked } from '../../../lib/bucket-series';

const st = (id: string) => streamById(id)!;
const streamHref = (id: string) => withBase(`/prototypes/monitoring/stream/${id}`);

// ── "Latest N" rows (2026-09-10) ─────────────────────────────────────────────
// Every list renders SECTION_ROW_MAX rows, and the section's `rows` setting reveals
// the first N of them (applySections). Rendered at the maximum rather than at the
// saved count because these rows are server-rendered markup: slicing to the saved
// value would mean re-rendering the table in the page script every time the setting
// moved. Hiding the tail is one attribute per row and needs no second renderer.
const SECTION_ROW_MAX = 7;

const fmtShort = (iso: string) =>
  new Date(`${iso}T00:00:00`).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });

// Full month name. Deliberately NOT a change to fmtShort: that one labels chart
// axes and mini-table cells, where the abbreviation earns its space. The "since"
// line has room for the whole word.
const fmtLongMonth = (iso: string) =>
  new Date(`${iso}T00:00:00`).toLocaleDateString('en-US', { month: 'long', day: 'numeric' });

// ── Active Observations (anchor) ─────────────────────────────────────────────
const issues = outstandingIssues();
const issueRows = issues.map((f) => [
  { text: `${ageDays(f.observedDate)}d`, num: true },
  { text: f.shortId, href: streamHref('observations') },
  { text: f.species },
  { text: f.workArea || '–' },
]);

// Filter row segments (port of prod's observationTypeToggleOptions): one segment
// per observation type, keyed on the type as it lands in the data — never a
// literal — with the type's own stream glyph, the way prod hands each segment its
// BeaconEntityType icon. The "All Observations" segment is prepended by the
// component itself, matching prod's null-valued first option.
const OBS_TYPE_SEGMENTS = [
  { label: 'Nesting Birds', value: 'Nesting Bird', iconPaths: STREAM_ICON_PATHS['bird'] },
  { label: 'Biological Resources', value: 'Biological Resource', iconPaths: STREAM_ICON_PATHS['leaf'] },
  { label: 'Compliance Concerns', value: 'Compliance Concern', iconPaths: STREAM_ICON_PATHS['triangle-alert'] },
];

// Inset map (Andy round 4, X2): same pin derivation as the stream index —
// Find.workArea → KMZ site coordinates, deterministic per-index fan-out for
// co-located finds, state meta drives the pin color. Finds with no recorded
// work area are absent from the map, present in the tables.
const siteById = new Map(workAreas.map((w) => [w.id, w]));
const obsPins = FINDS.flatMap((f, i) => {
  const site = siteById.get(f.workArea);
  if (!site) return [];
  const meta = findStateMeta(f);
  return [
    {
      id: f.id,
      lat: site.lat + ((i % 5) - 2) * 0.0011,
      lng: site.lng + ((Math.floor(i / 5) % 5) - 2) * 0.0013,
      label: `${f.kind === 'concern' ? (f.title ?? f.species) : f.species} · ${meta.label}`,
      hex: meta.hex,
    },
  ];
});

// ── Compliance Concerns: raised per day, past 30 days, split open vs closed ──
// Two series rather than one (2026-09-09). A single "concerns raised" count could
// not answer the question the widget exists for — how much is still UNRESOLVED —
// and reading it off FINDS gave 29 zero columns and one mark, because FINDS holds a
// single concern record. CONCERNS_ROLLUP is the stream's aggregate, the same
// relationship the mileage and runtime widgets already have with their samples.
//
// STACK ORDER: closed first, so it sits on the axis and OPEN RIDES ON TOP (Jamie,
// 2026-09-09). `series` is bottom-first — BcnVizStacked reverses the column with
// flex-direction: column-reverse — so the array reads closed, open and the legend,
// which follows the same array, reads the same way.
//
// THE GREY. --color-border-default-strong (#bdbdbd), picked by measurement rather
// than eye: against the open red it separates at 2.77:1, where the darker
// --color-content-default-tertiary managed only 1.12:1 — near-identical in
// lightness, so the two series were told apart by HUE alone and would collapse into
// each other for a red-blind reader. Lighter also matches what grey means everywhere
// else on this board: resolved, quiet, not the thing to look at. It is a fill, never
// text, which is the only reason a value this light is legitimate.
const CONCERN_SERIES = [
  { key: 'closed', label: 'Closed', color: 'var(--color-border-default-strong)' },
  { key: 'open', label: 'Open', color: 'var(--color-background-utility-danger)' },
];
const concernActivity = bucketStacked(CONCERNS_ROLLUP.perDay);
const openConcerns = DASHBOARD.complianceConcerns.active;

// ── Daily Monitoring Reports ─────────────────────────────────────────────────
const dmr = st('daily-monitoring-reports');
// CHANGE OVER TIME, not weekday bins (2026-09-09). This was a 7-day presence strip with
// Sat/Sun dropped — "weekdays only", because monitoring is a field-day expectation and a
// weekend cell read as a report that was missed rather than never due. That reasoning was
// right about the WEEKEND and wrong about the AXIS: the widget offers a 30-day scope (and
// the board is heading for 90-day and all-time), and five weekday cells cannot summarise
// three months of filing — the same binning that reads well over one week says almost
// nothing over one quarter. So it now uses the pattern its own registry entry already
// declared (WIDGETS['dmr-recent'].charts is ['list', 'trend']): a dated series through
// bucketSeries, coarsening itself as the span grows.
//
// The weekend concern is answered rather than dropped: DMR_ROLLUP.perDay is zero on Sat/Sun,
// so the cadence still reads as a weekly beat, and every column's popup names the weekday —
// so a quiet Saturday and a genuinely missed Thursday are told apart instead of guessed at.
const dmrBuckets = bucketSeries(DMR_ROLLUP.perDay);
const DMR_STATUS: Record<string, { label: string; hex: string }> = {
  Draft: { label: 'Draft', hex: '#989898' },
  Final: { label: 'Final', hex: '#2e7571' },
};
// The date IS the report file: clicking it downloads the DMR (prototype stand-in
// for the generated report — a small text rendition of the record).
const dmrFile = (r: Record<string, unknown>) => ({
  name: `DMR_${String(r.workAreas).split(',')[0].trim()}_${r.reportDate}.txt`,
  href: `data:text/plain;charset=utf-8,${encodeURIComponent(
    [
      `Daily Monitoring Report — ${r.reportDate}`,
      `Monitor: ${r.monitor}`,
      `Work areas: ${r.workAreas}`,
      `Activities: ${r.activities}`,
      `Observations logged: ${r.observationsLogged}`,
      `Status: ${r.status}`,
    ].join('\n'),
  )}`,
});
const dmrRows = dmr.sampleRecords.slice(0, SECTION_ROW_MAX).map((r) => {
  const file = dmrFile(r);
  return [
    { text: fmtShort(String(r.reportDate)), href: file.href, download: file.name, num: true },
    { text: String(r.monitor) },
    { text: String(r.workAreas) },
    { text: String(r.status), status: DMR_STATUS[String(r.status)] },
  ];
});

// ── Biological Resources: latest record ──────────────────────────────────────
const latestBio = [...FINDS]
  .filter((f) => f.type === 'Biological Resource')
  .sort((a, b) => (a.observedDate < b.observedDate ? 1 : -1))[0];

// ── Surveys: status donut + latest ───────────────────────────────────────────
// A donut rather than the one-bar proportion meter (Jamie, 2026-09-09). Same
// part-to-whole reading, and the ring gives three statuses more room to be told
// apart than three segments of a 14px bar do. The order is deliberate — final, in
// QC, draft is the pipeline's own direction, so the ring reads as progress.
const surveyOrder = ['final', 'qc', 'draft'] as const;
const surveyStatuses = surveyOrder.map((s) => ({
  label: SURVEY_STATUS_META[s].label,
  value: SURVEYS.filter((d) => d.status === s).length,
  color: SURVEY_STATUS_META[s].hex,
}));
// The five most recent survey documents (Andy round 4, X3).
const surveyRows = [...SURVEYS]
  .sort((a, b) => (a.date < b.date ? 1 : -1))
  .slice(0, SECTION_ROW_MAX)
  .map((s) => [
    { text: s.id, href: streamHref('surveys') },
    { text: fmtShort(s.date), num: true },
  ]);

// ── WEAP: latest confirmations ───────────────────────────────────────────────
const weap = st('weap');
const weapRows = weap.sampleRecords.slice(0, SECTION_ROW_MAX).map((r) => [
  { text: String(r.worker) },
  { text: String(r.trade) },
  { text: fmtShort(String(r.trainingDate)), num: true },
]);

// ── Config payload: everything the page script needs per widget ──────────────
// Series labels are the widget's REAL data series (spec §10.6) — for the one
// series widget, the observation-type breakdown.
const cfgPayload = WIDGETS.map((w) => ({
  id: w.id,
  title: w.title,
  charts: w.charts,
  scopes: w.scopes,
  colorMode: w.colorMode,
  series: w.colorMode === 'series' ? DASHBOARD.observationBreakdown.map((b) => b.label) : [],
  stream: streamById(w.streamId)!.name,
  // sectionDefs(), NOT w.sections: the authored list has no `title` setting on it —
  // that one is synthesized — so a payload built from w.sections gives the client a
  // section with no inputs. Cost the title feature a debug round: it SAVED (the
  // change handler reads data-kind off the DOM) and then neither applied nor
  // pre-filled, because both of those read the payload.
  sections: sectionDefs(w.id),
  windowed: w.windowed === true,
  width: w.width,
}));

// ── Observation activity over time, stacked by type (2026-09-08) ─────────────
// The "spread over time" reading for widgets with no date-range control. One column
// per bucketed period, segmented by observation type, colored from the SAME source
// the donut uses (DASHBOARD.observationBreakdown / the concern status hue) so the
// two readings of the same data cannot disagree about which color means what.
//
// The series runs from the earliest record to TODAY rather than only over dates
// that have records: a gap is information ("nothing logged that week"), and
// omitting empty periods would compress the axis and hide it.
const OBS_TYPES = ['Nesting Bird', 'Biological Resource'] as const;

const breakdownHex = new Map(DASHBOARD.observationBreakdown.map((b) => [b.label, b.hex]));
// Concerns are deliberately absent (2026-09-08): they have their own widget with
// their own per-day trend, and folding them in here mixed a compliance signal into
// an observation count. The two remaining series ARE the donut's two segments, so
// this chart and the donut now derive from one source and cannot disagree.
const obsTypeSeries = [
  { key: 'Nesting Bird', label: 'Nesting birds', color: breakdownHex.get('Nesting Birds') ?? 'var(--bcn-mark-cyan)' },
  { key: 'Biological Resource', label: 'Biological resources', color: breakdownHex.get('Biological Resources') ?? 'var(--bcn-mark-olive)' },
];

const obsFirstDate = [...FINDS].sort((a, b) => (a.observedDate < b.observedDate ? -1 : 1))[0]?.observedDate ?? TODAY;
const obsDays: { date: string; values: Record<string, number> }[] = [];
for (let t = Date.parse(obsFirstDate); t <= Date.parse(TODAY); t += 86_400_000) {
  const day = new Date(t).toISOString().slice(0, 10);
  const values: Record<string, number> = {};
  for (const ty of OBS_TYPES) {
    const n = FINDS.filter((f) => f.observedDate === day && f.type === ty).length;
    if (n > 0) values[ty] = n;
  }
  obsDays.push({ date: day, values });
}
const obsActivity = bucketStacked(obsDays);

// ── Chart bucketing (2026-09-08, titles revised 2026-09-09) ──────────────────
// Every dated strip runs through bucketSeries, which sums into the finest period that
// keeps the column count readable (<=31) and reports the unit it chose.
//
// THE TITLES SAY "OVER TIME" AND NOT THE UNIT. They used to interpolate perLabel, so a
// heading read "Miles per day" and became "Miles per week" when the span grew. That was
// honest but wrong in a second way: the unit is a property of the CURRENT range, not of
// the chart, so the heading changed identity every time the scope moved and a reader
// comparing two widgets was comparing two different sentences. "Miles over time" is
// stable and true at every unit, and the unit is now stated where it is actually needed
// — in each column's popup, which names its own period in full ("Week of June 8, 2026").
// perLabel is still interpolated into the aria-label, because a screen-reader summary of
// the whole strip has nowhere else to name the derivation.
/**
 * ONE BUCKETED SERIES PER SCOPE (2026-09-09). The date-range control persists
 * `scope` and apply() re-derives the headline figure from it — but the chart was
 * built once from the WHOLE series and nothing re-rendered it, so picking 7d moved
 * the number and left the strip alone.
 *
 * Pre-rendered rather than re-derived on the client, and that is the deliberate
 * choice: a trend is server-rendered markup — a column per period, each wrapped in
 * its own popover with its own period label — so rebuilding it in JS would mean
 * reimplementing the component in the page script and losing the Astro-rendered
 * popups. Rendering each window once and toggling which is visible costs some DOM
 * and keeps every column, popup, axis label and y-axis max correct per scope, with
 * no second implementation to keep in step.
 *
 * The window is filtered BEFORE bucketing, so each scope picks its own unit: on
 * mileage's 90 days of data 7d and 30d come out daily and 90d comes out weekly.
 */
const scopedSeries = (rows: { date: string; value: number }[], scopes: readonly string[]) =>
  scopes.map((scope) => {
    const windowed = rows.filter((r) => inWindow(r.date, scope));
    return { scope, ...bucketSeries(windowed) };
  });


// ── "Latest" tables (2026-09-08) ─────────────────────────────────────────────
// Same shape the Surveys and Biological Resources widgets already use: a
// BcnMiniTable of the most recent records, newest first, with the id linking
// through to the stream. Five rows is the house length (surveyRows, dmrRows).
const newest = <T extends { observedDate: string }>(rows: T[], n = SECTION_ROW_MAX): T[] =>
  [...rows].sort((a, b) => (a.observedDate < b.observedDate ? 1 : -1)).slice(0, n);

const latestBioRows = newest(FINDS.filter((f) => f.type === 'Biological Resource')).map((f) => [
  { text: f.shortId, href: streamHref('biological-resources') },
  { text: f.species },
  { text: fmtShort(f.observedDate), num: true },
]);

const latestObsRows = newest(FINDS).map((f) => [
  { text: f.shortId, href: streamHref('observations') },
  { text: f.kind === 'concern' ? (f.title ?? f.species) : f.species },
  { text: fmtShort(f.observedDate), num: true },
]);

const latestNestingRows = newest(FINDS.filter((f) => f.type === 'Nesting Bird')).map((f) => [
  { text: f.shortId, href: streamHref('nesting-birds') },
  { text: f.species },
  { text: fmtShort(f.observedDate), num: true },
]);

// OPEN concerns only, per the ask — a resolved concern is not something to action.
const latestConcernRows = newest(
  FINDS.filter((f) => f.kind === 'concern' && f.state === 'open'),
).map((f) => [
  { text: f.shortId, href: streamHref('compliance-concerns') },
  // Free text of uncontrolled length — clipped to one line, full string on hover.
  { text: f.title ?? f.species, truncate: true },
  { text: fmtShort(f.observedDate), num: true },
]);

// LABEL RULE (2026-09-08): a headline label gets "Total" prepended ONLY if it has
// no qualifier of its own AND no date range. "Active observations" and "Open
// compliance concerns" already qualify the count. The three windowed widgets are
// excluded too — their subtext says "since <date>", and "Total … since Jun 3"
// contradicts itself, since Total reads as all-time.
//
// ── Per-scope data, for the per-widget date range (2026-09-08) ───────────────
// The date range lives on exactly THREE widgets — vehicle mileage, equipment
// runtime and WEAP trainings — because those are the only ones whose headline
// figure is a QUANTITY ACCUMULATED OVER A PERIOD, which is the only kind of figure
// a window can honestly re-derive.
//
// Why the others do not have one (decided 2026-09-08): Active Observations and
// Nesting Birds report live STATE — `9 active` means active *now*. Making that
// windowed is impossible with this model, because Find carries only `observedDate`
// and no cleared/resolved date, so an observation's state at a past point is simply
// not recorded. "Observed in the window" IS derivable, but it answers a different
// question than the widget's title asks. Commitment Compliance is a status list and
// Season Windows' range drives lane geometry, not a figure.
// Those widgets get a data-density-over-time segment instead — a separate piece of
// work, not yet built.
//
// HONEST LIMIT: runtime and weap are still 14-point series, so their 30d and 90d
// windows return everything available and read identically. Mileage is the one that
// now carries 90 days (see MILEAGE_ROLLUP), so it is where the windows — and the
// bucketing they drive — actually differ.
//
// OFF BY ONE, FIXED (2026-09-09). The window was `date >= TODAY - days`, which
// includes BOTH endpoints and so covers days+1 days: a "14d" scope summed Jun 3
// through Jun 17, fifteen dates. It went unnoticed because the fixtures started
// exactly at the window edge — there was no Jun 3 datum to over-count. Extending
// mileage to 90 days put one there, and the 14d figure jumped to 3,636 against the
// stored miles14d of 3,284. A 14-day window ending Jun 17 begins Jun 4, hence
// days - 1.
const dayMs = 86_400_000;
const scopeDays = (sc: string): number => Number(sc.replace('d', ''));
/** The window's first day: TODAY counts as one of the N. */
const windowStart = (sc: string): number => Date.parse(TODAY) - (scopeDays(sc) - 1) * dayMs;
const inWindow = (iso: string, sc: string): boolean => Date.parse(iso) >= windowStart(sc);

/** Sum a {date,value} series over a window. */
const sumSeries = (rows: { date: string; value: number }[], sc: string): number =>
  rows.filter((r) => inWindow(r.date, sc)).reduce((n, r) => n + r.value, 0);

/** The window's first day, as the widget states it: "since June 4". Reads the SAME
    windowStart() the sum filters on, so the date named and the records counted cannot
    disagree — including through the off-by-one fix above. */
const sinceLabel = (sc: string): string =>
  `since ${fmtLongMonth(new Date(windowStart(sc)).toISOString().slice(0, 10))}`;

/** The headline figure for one widget in one window, plus the window it covers. */
const scopeFigures = (widgetId: string, sc: string): { value: string; sub: string } | null => {
  switch (widgetId) {
    case 'mileage-total':
      return { value: sumSeries(MILEAGE_ROLLUP.perDay, sc).toLocaleString('en-US'), sub: sinceLabel(sc) };
    case 'runtime-total':
      return { value: String(Math.round(sumSeries(RUNTIME_ROLLUP.perDayMinutes, sc) / 60)), sub: sinceLabel(sc) };
    case 'weap-trained':
      // Confirmations FILED in the window — training records, not the cumulative
      // 418 workers-to-date the widget used to show beside it. Those were two
      // different entities on two different time bases (people ever vs events
      // recently), which is what made the old stat hard to read.
      return {
        value: String(st('weap').sampleRecords.filter((r) => inWindow(String(r.trainingDate), sc)).length),
        sub: sinceLabel(sc),
      };
    default:
      return null;
  }
};

/** widgetId -> its registry scopes, for the markup. */
const WIDGET_SCOPES = Object.fromEntries(WIDGETS.map((w) => [w.id, w.scopes]));

// Placed AFTER WIDGET_SCOPES, which it reads — `const` is not hoisted.
const mileageScoped = scopedSeries(MILEAGE_ROLLUP.perDay, WIDGET_SCOPES['mileage-total']);
const runtimeScoped = scopedSeries(RUNTIME_ROLLUP.perDayMinutes, WIDGET_SCOPES['runtime-total']);

/** widgetId -> scope -> figure, serialized for the controller. */
const SCOPE_DATA = Object.fromEntries(
  WIDGETS.map((w) => [
    w.id,
    Object.fromEntries(w.scopes.map((sc) => [sc, scopeFigures(w.id, sc)]).filter(([, v]) => v !== null)),
  ]).filter(([, v]) => Object.keys(v as object).length > 0),
);

// ── Add-widget gallery (spec §11.4): every registered widget, always shown ───
const addCards = WIDGETS.map((w) => {
  const stream = streamById(w.streamId)!;
  return {
    id: w.id,
    title: w.title,
    streamName: stream.name,
    iconName: w.id === 'commitment-compliance' ? 'clipboard-check' : stream.icon,
    on: w.defaultOn,
  };
});

---

<!-- manifest:
  layout: grid
  sections:
    - component picker          -> bcn-component-picker
    - active observations       -> bcn-dashboard-widget
    - nesting birds             -> bcn-dashboard-widget
    - compliance concerns       -> bcn-dashboard-widget
    - daily monitoring reports  -> bcn-dashboard-widget
    - biological resources      -> bcn-dashboard-widget
    - commitment compliance     -> bcn-dashboard-widget
    - vehicle mileage           -> bcn-dashboard-widget
    - equipment runtime         -> bcn-dashboard-widget
    - surveys                   -> bcn-dashboard-widget
    - weap trainings            -> bcn-dashboard-widget
    - season windows            -> bcn-dashboard-widget
    - configure dialog          -> bcn-config-dialog
    - add-widget gallery        -> bcn-widget-card
-->

<AppShell
  title={`Monitoring Portal — ${PROJECT_NAME}`}
  tenantName="DWR"
  projectName="Delta Conveyance"
  activeNavId="mp-dashboard"
  expandedSections={['monitoring']}
>
  <PageLayout
    title="Monitoring Portal"
    icon="map-pinned"
    iconPaths={STREAM_ICON_PATHS['map-pinned']}
    breadcrumbs={[{ label: 'Delta Conveyance', href: '#project' }, { label: 'Monitoring Portal' }]}
  >
    {/* Component switcher beside the H1 (spec §11.1) — same register site-clearance
        scopes by. The picker only announces; the page script below owns what
        re-scoping means (the honest empty state for the three record-less components). */}
    <span slot="title-badge">
      <BcnComponentPicker components={COMPONENTS} />
    </span>
    <script type="application/json" data-mpd-scopes set:html={JSON.stringify(SCOPE_DATA)}></script>
    <div class="mpdash" data-mpdash data-geotech-component={GEOTECH_COMPONENT}>
      {/* Drag-mode column tracks (spec §11.3) — reads the grid's own --_col/--_gap
          so alignment is by construction; visible only while data-mode='drag'. */}
