---
// Monitoring → Notifications & Daily Logs — the expected field documents for every
// exploration location in the Delta Conveyance 2026 geotechnical campaign (DCA
// request, George Valenzuela, 2026-09-25). Two views over one filtered set: the
// Matrix (what is missing on which hole) and the Timeline (what goes out when, what
// is drilling when). `?view=timeline` and `?hole=<id>` deep-link.
//
// Each drill hole generates its expected documents from its drill dates: the
// pre-drilling notifications, site clearances and USA ticket back-dated in working
// days, and one biological / field coordinator / geologist log per drill day. Status
// is derived against the fixture clock, never stored — see
// src/data/field-notifications-fixture.ts for the model, George's rows, and the
// seeded mock records.
import AppShell from '../../../layouts/AppShell.astro';
import PageLayout from '../../../layouts/PageLayout.astro';
import BcnFieldDocReadiness from '../../../components/bcn/BcnFieldDocReadiness.astro';
import BcnFieldDocFilters from '../../../components/bcn/BcnFieldDocFilters.astro';
import BcnFieldDocMatrix from '../../../components/bcn/BcnFieldDocMatrix.astro';
import BcnFieldDocTimeline from '../../../components/bcn/BcnFieldDocTimeline.astro';
import BcnFieldDocChecklist from '../../../components/bcn/BcnFieldDocChecklist.astro';
import BcnStatusChip from '../../../components/bcn/BcnStatusChip.astro';
import { withBase } from '../../../lib/base';
import { summarizeCampaign, campaignReadiness, HOLE_STATUS_META } from '../../../data/field-notifications-fixture';

const holes = summarizeCampaign();
const readiness = campaignReadiness(holes);
---

<!-- manifest:
  layout: stack(xl)
  sections:
    - readiness strip -> bcn-field-doc-readiness     # holes with gaps, missing, late, due in 5 working days
    - view + filters  -> bcn-field-doc-filters       # Matrix | Timeline pivot, search, facets, sort (shared by both views)
    - document matrix -> bcn-field-doc-matrix        # drill hole × document grid, grouped by agreement
    - timeline        -> bcn-field-doc-timeline      # working days × drill holes: notices on due dates, drill bars, TODAY
    - hole record     -> esa-side-dialog             # header + bcn-field-doc-checklist per hole, SSR'd hidden
-->

<AppShell
  title="Notifications & Daily Logs"
  tenantName="DWR"
  projectName="Delta Conveyance"
  activeNavId="mp-field-documentation"
  expandedSections={['monitoring']}
>
  <PageLayout
    title="Notifications & Daily Logs"
    icon="notepad-text"
    breadcrumbs={[
      { label: 'Delta Conveyance', href: '#project' },
      { label: 'Monitoring Portal', href: withBase('/prototypes/monitoring/dashboard') },
      { label: 'Notifications & Daily Logs' },
    ]}
  >
    <div class="stack" data-gap="xl">
      <BcnFieldDocReadiness readiness={readiness} />
      <div class="stack" data-gap="md">
        <BcnFieldDocFilters holes={holes} />
        <div data-fd-view-panel="matrix"><BcnFieldDocMatrix holes={holes} /></div>
        <div data-fd-view-panel="timeline" hidden><BcnFieldDocTimeline holes={holes} /></div>
      </div>
    </div>
  </PageLayout>

  <esa-side-dialog
    id="fd-record"
    heading="Drill hole"
    style="--_width: 640px; --z-modal: 1300; --z-modal-backdrop: 1250;"
  >
    <div slot="header">
      {
        holes.map((h) => (
          <div data-fd-head={h.location.id} hidden>
            <div class="cluster" data-gap="sm">
              <h2 class="typography-title-strong">{h.location.id}</h2>
              <BcnStatusChip status={`fd-hole-${h.status}`} label={HOLE_STATUS_META[h.status].label} hex={HOLE_STATUS_META[h.status].hex} />
            </div>
          </div>
        ))
      }
    </div>
    {
      holes.map((h) => (
        <div data-fd-body={h.location.id} hidden>
          <BcnFieldDocChecklist hole={h} />
        </div>
      ))
    }
  </esa-side-dialog>
</AppShell>

<script>
  import '@esa/ecology/esa-side-dialog';
  import { SELECT_EVENT, VIEW_EVENT, type FieldDocSelectDetail } from '../../../lib/field-doc-filter';

  // ── Views: the pivot lives in BcnFieldDocFilters; the page only shows the panel. ──
  const panels = [...document.querySelectorAll<HTMLElement>('[data-fd-view-panel]')];
  const showView = (view?: string) => view && panels.forEach((p) => (p.hidden = p.dataset.fdViewPanel !== view));
  document.addEventListener(VIEW_EVENT, (e) => showView((e as CustomEvent).detail?.view));
  showView(document.documentElement.dataset.fdView);

  // ── The hole drawer ──
  type SideDialog = HTMLElement & { show(): void; close(): void; heading: string };
  const dialog = document.getElementById('fd-record') as SideDialog;
  const heads = [...document.querySelectorAll<HTMLElement>('[data-fd-head]')];
  const bodies = [...document.querySelectorAll<HTMLElement>('[data-fd-body]')];
  const known = new Set(bodies.map((b) => b.dataset.fdBody));
  let openId: string | null = null;
  // Back/forward closes the drawer without pushing a second entry for a navigation
  // the user already made (the lego's close event fires after its slide-out).
  let closingFromHistory = false;
  let opener: HTMLElement | null = null;

  /** The URL keeps the view and the record, never the depth into it. */
  function urlFor(hole: string | null) {
    const params = new URLSearchParams(location.search);
    params.delete('doc');
    params.delete('day');
    if (hole) params.set('hole', hole);
    else params.delete('hole');
    const qs = params.toString();
    return qs ? `?${qs}` : location.pathname;
  }

  /** Aim the open drawer at one document or drill day: open it, scroll to it, tint it. */
  function aim(body: HTMLElement, kind?: string, day?: string) {
    body.querySelectorAll('[data-fd-target]').forEach((el) => el.removeAttribute('data-fd-target'));
    const target = day
      ? body.querySelector<HTMLDetailsElement>(`[data-fd-day="${day}"]`)
      : kind
        ? body.querySelector<HTMLElement>(`[data-fd-doc="${kind}"]`)
        : null;
    if (!target) return;
    if (target instanceof HTMLDetailsElement) target.open = true;
    target.setAttribute('data-fd-target', '');
    requestAnimationFrame(() => target.scrollIntoView({ block: 'center' }));
  }

  function openHole(id: string, push = true, kind?: string, day?: string) {
    if (!known.has(id)) return;
    heads.forEach((h) => (h.hidden = h.dataset.fdHead !== id));
    bodies.forEach((b) => (b.hidden = b.dataset.fdBody !== id));
    dialog.heading = id;
    openId = id;
    if (push) history.pushState({ hole: id }, '', urlFor(id));
    dialog.show();
    const body = bodies.find((b) => b.dataset.fdBody === id)!;
    if (kind || day) setTimeout(() => aim(body, kind, day), 60);
    else aim(body);
  }

  document.addEventListener(SELECT_EVENT, (e) => {
    const d = (e as CustomEvent<FieldDocSelectDetail>).detail;
    const active = document.activeElement as HTMLElement | null;
    opener = active && active !== document.body ? active : document.querySelector<HTMLElement>(`[data-fd-link="${d.holeId}"]`);
    openHole(d.holeId, true, d.kind, d.day);
  });

  dialog.addEventListener('close', () => {
    if (!openId) return;
    openId = null;
    if (!closingFromHistory) history.pushState({}, '', urlFor(null));
    closingFromHistory = false;
    opener?.focus();
  });

  window.addEventListener('popstate', () => {
    const id = new URLSearchParams(location.search).get('hole');
    if (id) openHole(id, false);
    else if (openId) {
      closingFromHistory = true;
      dialog.close();
    }
  });

  const params = new URLSearchParams(location.search);
  const initial = params.get('hole');
  if (initial) {
    customElements
      .whenDefined('esa-side-dialog')
      .then(() => openHole(initial, false, params.get('doc') ?? undefined, params.get('day') ?? undefined));
  }
</script>
