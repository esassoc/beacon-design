---
// Monitoring Portal → Compliance Dashboard → Observations — the filterable
// list/map view the Compliance Dashboard's donut segments and outstanding-item
// rows link into (?severity=<value> pre-filters; ?open=<id> auto-opens that
// row's read-only detail on load). Every Fieldstone Environmental Monitoring
// field observation on the Cottonwood Solar + Storage project, active and
// resolved. See src/data/monitoring-oversight-fixture.ts for the scenario.
import AppShell from '../../../layouts/AppShell.astro';
import PageLayout from '../../../layouts/PageLayout.astro';
import EsaIconButton from '@esa/ecology/esa-icon-button.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import FilterContainer from '@esa/ecology/esa-filter-container.astro';
import FilterClearButton from '@esa/ecology/esa-filter-clear-button.astro';
import BcnObservationMap from '../../../components/bcn/BcnObservationMap.astro';
import BcnKeyValue from '../../../components/bcn/BcnKeyValue.astro';
import BcnStatusChip from '../../../components/bcn/BcnStatusChip.astro';
import { withBase } from '../../../lib/base';
import {
  OBSERVATIONS,
  SEVERITY_META,
  AREAS,
  PROJECT_NAME,
  TENANT_NAME,
  FIRST_PARTY_FIRM,
  TODAY,
  formatDate,
  daysActive,
} from '../../../data/monitoring-oversight-fixture';

const STATUS_DISPLAY_META: Record<'active' | 'resolved', { label: string; hex: string }> = {
  active: { label: 'Active', hex: 'var(--color-info)' },
  resolved: { label: 'Resolved', hex: 'var(--color-text-tertiary)' },
};

const gridRows = OBSERVATIONS.map((o) => ({
  id: o.id,
  category: o.category,
  severity: o.severity,
  severityLabel: SEVERITY_META[o.severity].label,
  status: o.status,
  statusLabel: STATUS_DISPLAY_META[o.status].label,
  reportedDate: o.reportedDate,
  resolvedDate: o.resolvedDate ?? '',
  daysActive: daysActive(o),
  area: AREAS[o.area].label,
  lat: AREAS[o.area].lat,
  lng: AREAS[o.area].lng,
  inspector: o.inspector,
  esaReviewed: o.esaReviewed,
  description: o.description,
}));

const gridPayload = { rows: gridRows, severityMeta: SEVERITY_META, statusMeta: STATUS_DISPLAY_META };

// First row seeds the detail dialog's SSR markup (openDetail() overwrites every
// field before the dialog is ever shown).
const seed = gridRows[0];

// Same per-project nav as the Compliance Dashboard (see that page's header for why).
const LAYOUT_DASHBOARD_PATHS =
  '<rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/>';
const MAP_PINNED_PATHS =
  '<path d="M18 8c0 3.613-3.869 7.429-5.393 8.795a1 1 0 0 1-1.214 0C9.87 15.429 6 11.613 6 8a6 6 0 0 1 12 0"/><circle cx="12" cy="8" r="2"/><path d="M8.714 14h-3.71a1 1 0 0 0-.948.683l-2.004 6A1 1 0 0 0 3 22h18a1 1 0 0 0 .948-1.316l-2-6a1 1 0 0 0-.949-.684h-3.712"/>';
const SLIDERS_PATHS =
  '<line x1="21" x2="14" y1="4" y2="4"/><line x1="10" x2="3" y1="4" y2="4"/><line x1="21" x2="12" y1="12" y2="12"/><line x1="8" x2="3" y1="12" y2="12"/><line x1="21" x2="16" y1="20" y2="20"/><line x1="12" x2="3" y1="20" y2="20"/><line x1="14" x2="14" y1="2" y2="6"/><line x1="8" x2="8" y1="10" y2="14"/><line x1="16" x2="16" y1="18" y2="22"/>';

const oversightNav = [
  { id: 'project', title: 'Project', icon: 'layout-dashboard', iconPaths: LAYOUT_DASHBOARD_PATHS, link: true },
  {
    id: 'monitoring',
    title: 'Monitoring',
    icon: 'map-pinned',
    iconPaths: MAP_PINNED_PATHS,
    expanded: true,
    dividerAfter: true,
    items: [
      { id: 'mp-compliance-dashboard', label: 'Compliance Dashboard', href: withBase('/prototypes/monitoring/compliance-dashboard') },
      { id: 'mp-compliance-observations', label: 'Observations', href: withBase('/prototypes/monitoring/compliance-observations') },
    ],
  },
  {
    id: 'admin',
    title: 'Admin',
    icon: 'sliders-horizontal',
    iconPaths: SLIDERS_PATHS,
    items: [{ id: 'dashboard-widgets', label: 'Dashboard Widgets' }],
  },
];
---

<!-- manifest:
  layout: stack
  sections:
    - filter bar   -> esa-filter-container   # Severity/Category/Status facets + search (carded shell = glue; every control is a lego)
    - view toggle  -> esa-button-toggle       # List | Map
    - list view    -> beacon-grid             # AG Grid — shared kit already used by Surveys/Permits & Studies
    - map view     -> bcn-observation-map      # reused, full-size, interactive
    - detail panel -> esa-side-dialog          # read-only observation detail (BcnKeyValue + BcnStatusChip)
-->

<AppShell
  title={`Observations — ${PROJECT_NAME}`}
  tenantName={TENANT_NAME}
  projectName={PROJECT_NAME}
  activeNavId="mp-compliance-observations"
  expandedSections={['monitoring']}
  navSections={oversightNav}
>
  <PageLayout
    title="Observations"
    icon="map"
    breadcrumbs={[
      { label: PROJECT_NAME, href: '#project' },
      { label: 'Monitoring Portal', href: withBase('/prototypes/monitoring/compliance-dashboard') },
      { label: 'Observations' },
    ]}
  >
    <!-- ═══ Filter bar — carded (Tracker / Surveys / Permits & Studies parity) ═══
         bcn-lego-checked: the carded toolbar SHELL + "Filters"/"View" labels are
         page-composition glue (same .bcn-filterbar class already used by
         requirement-tracker.astro, monitoring/surveys.astro, and
         permits-studies-tracking.astro); every CONTROL inside is a lego —
         esa-button-toggle (view), esa-text-field (search), esa-filter-dropdown ×3
         in esa-filter-container, esa-filter-clear-button. -->
    <div class="bcn-filterbar">
      <div class="bcn-filterbar__top">
        <div class="bcn-filterbar__group">
          <span class="bcn-filterbar__label">View</span>
          <esa-button-toggle id="ov-view" size="sm"></esa-button-toggle>
        </div>
        <span class="bcn-filterbar__label">Filters</span>
        <FilterContainer>
          <esa-filter-dropdown id="flt-severity" label="Severity" multiple size="sm"></esa-filter-dropdown>
          <esa-filter-dropdown id="flt-category" label="Category" multiple size="sm"></esa-filter-dropdown>
          <esa-filter-dropdown id="flt-status" label="Status" multiple size="sm"></esa-filter-dropdown>
        </FilterContainer>
        <span id="ov-clear-filters" class="bcn-filterbar__clear"><FilterClearButton /></span>
        <div class="bcn-filterbar__search">
          <esa-text-field id="ov-search" placeholder="Search ID, category, area, inspector…" size="md"></esa-text-field>
          <span id="ov-search-clear" hidden><EsaIconButton icon="x" label="Clear search" size="sm" /></span>
        </div>
      </div>
    </div>

    <!-- ═══ List view — AG Grid (existing shared kit) ═══ -->
    <div id="ov-list-pane">
      <div id="ov-grid" class="ov-grid"></div>
      <div class="table-footer">
        <span id="ov-download"><EsaButton color="ghost" appearance="outline" size="sm" icon="download">Download as CSV</EsaButton></span>
        <div class="row-count-data">
          Total Records: <span id="ov-total">0</span>
          <span id="ov-filtered" class="filtered-rows-count" hidden></span>
        </div>
      </div>
    </div>

    <!-- ═══ Map view — bcn-observation-map, reused (interactive, full-size) ═══ -->
    <div id="ov-map-pane" hidden>
      <BcnObservationMap observations={[]} mapId="observations-full" height="min(70vh, 620px)" interactive={true} />
    </div>
  </PageLayout>

  <!-- ═══ Detail panel — esa-side-dialog lego, read-only (BcnKeyValue/BcnStatusChip) ═══
       bcn-lego-checked: no esa- fits a slide-in read-only record panel besides
       esa-side-dialog itself; header pill/chip row + key-value grid are
       page-composition glue around reused bcn-* components, same pattern as
       permits-studies-tracking.astro's detail dialog. ═══ -->
  <esa-side-dialog id="ov-detail" size="md" style="--_width: 520px; --z-modal: 1200; --z-modal-backdrop: 1150;">
    <div slot="header" class="bcn-detail__head">
      <div class="bcn-detail__title-row">
        <h2 id="ov-detail-title" class="bcn-detail__title">{seed.id}</h2>
      </div>
    </div>

    <div class="bcn-detail__body">
      <div id="ov-detail-chips" class="bcn-detail__chips">
        <span id="ov-detail-severity-chip"><BcnStatusChip status={seed.severity} label={seed.severityLabel} hex={SEVERITY_META[seed.severity].hex} /></span>
        <span id="ov-detail-status-chip"><BcnStatusChip status={seed.status} label={seed.statusLabel} hex={STATUS_DISPLAY_META[seed.status].hex} /></span>
      </div>
      <div class="bcn-detail__grid">
        <span id="ov-detail-category"><BcnKeyValue label="Category" value={seed.category} /></span>
        <span id="ov-detail-area"><BcnKeyValue label="Area" value={seed.area} /></span>
        <span id="ov-detail-inspector"><BcnKeyValue label="Inspector" value={`${seed.inspector} (${FIRST_PARTY_FIRM})`} /></span>
        <span id="ov-detail-reported"><BcnKeyValue label="Reported" value={formatDate(seed.reportedDate)} /></span>
        <span id="ov-detail-resolved"><BcnKeyValue label="Resolved" value={seed.resolvedDate ? formatDate(seed.resolvedDate) : '—'} /></span>
        <span id="ov-detail-age"><BcnKeyValue label="Days active" value={`${seed.daysActive}d`} /></span>
        <span id="ov-detail-reviewed"><BcnKeyValue label="ESA QC reviewed" value={seed.esaReviewed ? 'Yes' : 'Not yet'} /></span>
      </div>
      <span id="ov-detail-description"><BcnKeyValue label="Description" value={seed.description} /></span>
    </div>
  </esa-side-dialog>

  <script type="application/json" id="ov-grid-data" set:html={JSON.stringify(gridPayload)}></script>
</AppShell>

<script>
  import { createGrid, ModuleRegistry, AllCommunityModule } from 'ag-grid-community';
  import type { GridApi, GridOptions, ColDef, IRowNode } from 'ag-grid-community';
  import { beaconTheme, makeStatusRenderer, linkRenderer } from '../../../lib/beacon-grid';
  import { formatDate } from '../../../data/monitoring-oversight-fixture';
  import '@esa/ecology/esa-text-field';
  import '@esa/ecology/esa-filter-dropdown';
  import '@esa/ecology/esa-button-toggle';
  import '@esa/ecology/esa-side-dialog';

  ModuleRegistry.registerModules([AllCommunityModule]);

  interface Row {
    id: string;
    category: string;
    severity: string;
    severityLabel: string;
    status: 'active' | 'resolved';
    statusLabel: string;
    reportedDate: string;
    resolvedDate: string;
    daysActive: number;
    area: string;
    lat: number;
    lng: number;
    inspector: string;
    esaReviewed: boolean;
    description: string;
  }
  interface Payload {
    rows: Row[];
    severityMeta: Record<string, { label: string; hex: string }>;
    statusMeta: Record<string, { label: string; hex: string }>;
  }

  const payload: Payload = JSON.parse(document.getElementById('ov-grid-data')!.textContent || '{}');
  const { rows, severityMeta, statusMeta } = payload;

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  // ── Columns ──────────────────────────────────────────────────────────────
  const columnDefs: ColDef<Row>[] = [
    { field: 'id', headerName: 'ID', width: 110, cellRenderer: linkRenderer, pinned: 'left' },
    { field: 'category', headerName: 'Category', width: 240 },
    {
      field: 'severity',
      headerName: 'Severity',
      width: 170,
      cellRenderer: makeStatusRenderer(severityMeta),
      cellClass: 'bcn-grid-status-cell',
      filterValueGetter: (p) => severityMeta[p.data!.severity]?.label,
    },
    {
      field: 'status',
      headerName: 'Status',
      width: 130,
      cellRenderer: makeStatusRenderer(statusMeta),
      cellClass: 'bcn-grid-status-cell',
      filterValueGetter: (p) => statusMeta[p.data!.status]?.label,
    },
    { field: 'area', headerName: 'Area', width: 240 },
    { field: 'reportedDate', headerName: 'Reported', width: 130, valueFormatter: (p) => (p.value ? formatDate(p.value) : '') },
    { field: 'daysActive', headerName: 'Days Active', width: 120, valueFormatter: (p) => `${p.value}d` },
    { field: 'inspector', headerName: 'Inspector', width: 140 },
  ];

  // ── Faceted filters (Severity / Category / Status) + search → one external pass ──
  type FacetKey = 'severity' | 'category' | 'status';
  const facets: Record<FacetKey, string[]> = { severity: [], category: [], status: [] };
  const severityLabelOf = (r: Row) => severityMeta[r.severity]?.label ?? r.severity;
  const statusLabelOf = (r: Row) => statusMeta[r.status]?.label ?? r.status;
  const anyFacetActive = () => Object.values(facets).some((v) => v.length > 0);

  function rowPassesFacets(r: Row) {
    if (facets.severity.length && !facets.severity.includes(severityLabelOf(r))) return false;
    if (facets.category.length && !facets.category.includes(r.category)) return false;
    if (facets.status.length && !facets.status.includes(statusLabelOf(r))) return false;
    return true;
  }

  function doesExternalFilterPass(node: IRowNode<Row>) {
    const r = node.data;
    if (!r) return true;
    return rowPassesFacets(r);
  }

  let quickFilterText = '';
  const matchesSearch = (r: Row) => {
    if (!quickFilterText) return true;
    const haystack = `${r.id} ${r.category} ${r.area} ${r.inspector} ${r.description}`.toLowerCase();
    return haystack.includes(quickFilterText.toLowerCase());
  };

  const gridOptions: GridOptions<Row> = {
    theme: beaconTheme,
    rowData: rows,
    columnDefs,
    defaultColDef: { sortable: true, resizable: true, filter: true, suppressHeaderMenuButton: true, tooltipValueGetter: (p) => p.value },
    tooltipShowDelay: 0,
    tooltipShowMode: 'whenTruncated',
    isExternalFilterPresent: anyFacetActive,
    doesExternalFilterPass,
    onFirstDataRendered: updateCounts,
    onFilterChanged: updateCounts,
    onRowClicked: (e) => e.data && openDetail(e.data),
  };

  const api: GridApi<Row> = createGrid($('ov-grid'), gridOptions);

  // ── Footer counts ──
  const totalEl = $('ov-total');
  const filteredEl = $('ov-filtered');
  function updateCounts() {
    totalEl.textContent = String(rows.length);
    const shown = api.getDisplayedRowCount();
    if (shown < rows.length) {
      filteredEl.hidden = false;
      filteredEl.textContent = `Filtered Records: ${shown}`;
    } else {
      filteredEl.hidden = true;
    }
    syncMapIfVisible();
  }

  // ── Search → AG Grid quick filter + local predicate (map reuses the latter) ──
  const search = $('ov-search') as HTMLElement & { value: string };
  const searchClear = $('ov-search-clear');
  search.addEventListener('change', (e) => {
    const v = (e as CustomEvent).detail?.value ?? search.value ?? '';
    quickFilterText = String(v);
    api.setGridOption('quickFilterText', quickFilterText);
    searchClear.hidden = !v;
    syncMapIfVisible();
  });
  searchClear.addEventListener('click', () => {
    search.value = '';
    quickFilterText = '';
    api.setGridOption('quickFilterText', '');
    searchClear.hidden = true;
    syncMapIfVisible();
  });

  // ── Filter dropdowns (Severity defaults from ?severity=, Status defaults to Active) ──
  const uniq = (xs: string[]) => [...new Set(xs.filter(Boolean))].sort();
  const toOpts = (xs: string[]) => xs.map((v) => ({ label: v, value: v }));
  const severityOptsOrdered = Object.entries(severityMeta)
    .filter(([k]) => rows.some((r) => r.severity === k))
    .map(([, m]) => ({ value: m.label, label: m.label, color: m.hex }));
  const statusOptsOrdered = Object.entries(statusMeta)
    .filter(([k]) => rows.some((r) => r.status === k))
    .map(([, m]) => ({ value: m.label, label: m.label, color: m.hex }));
  const facetOptions: Record<FacetKey, { label: string; value: string; color?: string }[]> = {
    severity: severityOptsOrdered,
    category: toOpts(uniq(rows.map((r) => r.category))),
    status: statusOptsOrdered,
  };
  const facetIds: Record<FacetKey, string> = { severity: 'flt-severity', category: 'flt-category', status: 'flt-status' };
  type FilterDropdownEl = HTMLElement & { options: { label: string; value: string; color?: string }[]; _selected: string[] };
  const dropdowns: Record<FacetKey, FilterDropdownEl> = {} as Record<FacetKey, FilterDropdownEl>;
  (Object.entries(facetIds) as [FacetKey, string][]).forEach(([key, id]) => {
    const el = $(id) as FilterDropdownEl;
    el.options = facetOptions[key];
    el.addEventListener('selection-change', (e) => {
      facets[key] = ((e as CustomEvent).detail?.value as string[]) ?? [];
      api.onFilterChanged();
    });
    dropdowns[key] = el;
  });

  $('ov-clear-filters').addEventListener('esa-filter-clear', () => {
    (Object.keys(facets) as FacetKey[]).forEach((k) => (facets[k] = []));
    (Object.keys(dropdowns) as FacetKey[]).forEach((k) => (dropdowns[k]._selected = []));
    api.setFilterModel(null);
    api.onFilterChanged();
  });

  // ── Download CSV ──
  $('ov-download').addEventListener('click', () => api.exportDataAsCsv({ fileName: 'oversight-observations.csv' }));

  // ── List | Map view toggle ──
  interface ToggleEl extends HTMLElement { options: { label: string; value: string }[]; value: string; }
  const viewToggle = $('ov-view') as ToggleEl;
  viewToggle.options = [
    { label: 'List', value: 'list' },
    { label: 'Map', value: 'map' },
  ];
  viewToggle.value = 'list';
  const listPane = $('ov-list-pane');
  const mapPane = $('ov-map-pane');
  viewToggle.addEventListener('change', (e) => {
    const v = (e as CustomEvent).detail.value as string;
    listPane.hidden = v !== 'list';
    mapPane.hidden = v !== 'map';
    if (v === 'map') {
      // The map mounts inside a hidden (display:none) container on first load,
      // so Leaflet measures a 0×0 box and never paints tiles. Un-hiding alone
      // doesn't tell it the size changed — invalidateSize() does, and it must
      // run AFTER the browser has applied the unhide (hence the rAF), before
      // syncMapIfVisible() re-fits bounds against the now-correct size.
      requestAnimationFrame(() => {
        mapHost?._bcnMap?.invalidateSize();
        syncMapIfVisible();
      });
    }
  });

  // ── Map sync: filtered rows → bcn-observation-map's pins ──
  interface ObsMapHost extends HTMLElement {
    _bcnMap?: { invalidateSize: () => void };
    _bcnSetObservations?: (obs: { id: string; lat: number; lng: number; label: string; hex: string }[]) => void;
  }
  const mapHost = document.getElementById('bcn-obsmap-observations-full') as ObsMapHost | null;
  function syncMapIfVisible() {
    if (!mapHost || mapPane.hidden) return;
    const visible = rows.filter((r) => rowPassesFacets(r) && matchesSearch(r));
    mapHost._bcnSetObservations?.(
      visible.map((r) => ({ id: r.id, lat: r.lat, lng: r.lng, label: `${r.id} — ${r.category}`, hex: severityMeta[r.severity]?.hex ?? '#8a9099' })),
    );
  }

  // ── Detail dialog (read-only) ──
  const detailDialog = $('ov-detail') as HTMLElement & { show(): void; close(): void };
  const severityChipWrap = $('ov-detail-severity-chip');
  const statusChipWrap = $('ov-detail-status-chip');

  function setChip(wrap: HTMLElement, status: string, label: string, hex: string) {
    const chip = wrap.querySelector('.bcn-status-chip') as HTMLElement;
    if (!chip) return;
    chip.dataset.status = status;
    chip.style.setProperty('--_chip', hex);
    const labelEl = chip.querySelector('.bcn-status-chip__label');
    if (labelEl) labelEl.textContent = label;
  }

  function setKV(id: string, value: string) {
    const wrap = $(id);
    const val = wrap.querySelector('.bcn-key-value__val');
    if (val) val.textContent = value || '—';
  }

  function openDetail(row: Row) {
    $('ov-detail-title').textContent = row.id;
    setChip(severityChipWrap, row.severity, row.severityLabel, severityMeta[row.severity]?.hex ?? '#8a9099');
    setChip(statusChipWrap, row.status, row.statusLabel, statusMeta[row.status]?.hex ?? '#8a9099');

    setKV('ov-detail-category', row.category);
    setKV('ov-detail-area', row.area);
    setKV('ov-detail-inspector', row.inspector);
    setKV('ov-detail-reported', formatDate(row.reportedDate));
    setKV('ov-detail-resolved', row.resolvedDate ? formatDate(row.resolvedDate) : '—');
    setKV('ov-detail-age', `${row.daysActive}d`);
    setKV('ov-detail-reviewed', row.esaReviewed ? 'Yes' : 'Not yet');
    setKV('ov-detail-description', row.description);

    detailDialog.show();
  }

  // A map pin click opens the same read-only detail as a grid row click.
  document.addEventListener('bcn-observation-pin-click', (e) => {
    const id = (e as CustomEvent).detail?.id as string | undefined;
    const row = rows.find((r) => r.id === id);
    if (row) openDetail(row);
  });

  // ── Inbound query params: ?severity=<value> pre-filters, ?open=<id> auto-opens ──
  const params = new URLSearchParams(location.search);
  const severityParam = params.get('severity');
  const openParam = params.get('open');

  // Status defaults to Active-only unless the URL asks for a specific severity
  // slice that includes resolved items (it never does today, but this keeps the
  // default honest rather than hardcoding "Active" past the point it's true).
  facets.status = ['Active'];
  dropdowns.status._selected = ['Active'];

  if (severityParam) {
    const label = severityMeta[severityParam]?.label;
    if (label) {
      facets.severity = [label];
      dropdowns.severity._selected = [label];
    }
  }
  api.onFilterChanged();

  if (openParam) {
    const row = rows.find((r) => r.id === openParam);
    if (row) openDetail(row);
  }
</script>

<style>
  /* bcn-lego-checked: PAGE-COMPOSITION GLUE ONLY, replicating the established
     filter-bar / grid-footer shell (requirement-tracker.astro,
     monitoring/surveys.astro, permits-studies-tracking.astro) and the detail
     dialog's header/body glue (permits-studies-tracking.astro). No reinvented
     primitives — checked esa-* (no filter-bar-shell, no data-grid,
     no read-only-record-panel lego) and Beacon. */

  .bcn-filterbar { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-200); margin-bottom: var(--spacing-400); }
  .bcn-filterbar__top { display: flex; align-items: center; gap: var(--spacing-300); padding: var(--spacing-300) var(--spacing-400); flex-wrap: wrap; }
  .bcn-filterbar__group { display: inline-flex; align-items: center; gap: var(--spacing-200); padding-right: var(--spacing-300); border-right: 1px solid var(--color-border-light); }
  .bcn-filterbar__label { font-size: var(--type-size-150); font-weight: var(--font-weight-semibold); color: var(--color-text-tertiary); white-space: nowrap; }
  .bcn-filterbar__clear { margin-left: var(--spacing-100); }
  .bcn-filterbar__search { margin-left: auto; display: inline-flex; align-items: center; gap: var(--spacing-150); min-width: 280px; }
  .bcn-filterbar__search :global(esa-text-field) { flex: 1; }

  /* Grid host + footer */
  .ov-grid { width: 100%; height: calc(100vh - 460px); min-height: 480px; }
