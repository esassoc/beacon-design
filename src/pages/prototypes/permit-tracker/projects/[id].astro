---
// Permit Tracker — one project. Answers "can we break ground on time?" first, then the
// permits themselves as a List (AG Grid), a Board whose columns are this project's own
// statuses (the Actions board model: user columns over the Not Started / In Progress /
// Completed backbone, edited in Configure statuses), or a Schedule of bars on a calendar
// with dependents under what gates them. One static route per project.
import PermitTrackerLayout from '../../../../layouts/PermitTrackerLayout.astro';
import EsaPageHeader from '@esa/ecology/esa-page-header.astro';
import EsaBreadcrumbs from '@esa/ecology/esa-breadcrumbs.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import BcnPermitReadiness from '../../../../components/bcn/BcnPermitReadiness.astro';
import BcnPermitSchedule from '../../../../components/bcn/BcnPermitSchedule.astro';
import BcnPermitTable from '../../../../components/bcn/BcnPermitTable.astro';
import BcnPermitBoard from '../../../../components/bcn/BcnPermitBoard.astro';
import BcnPermitStatusConfig from '../../../../components/bcn/BcnPermitStatusConfig.astro';
import BcnProjectTeam from '../../../../components/bcn/BcnProjectTeam.astro';
import BcnAddPermit from '../../../../components/bcn/BcnAddPermit.astro';
import BcnProjectEditor from '../../../../components/bcn/BcnProjectEditor.astro';
import { PROJECTS, fmtDate, ROUTES, type Project } from '../../../../data/permit-tracker';
import { withBase } from '../../../../lib/base';

export function getStaticPaths() {
  return PROJECTS.map((p) => ({ params: { id: p.id }, props: { project: p } }));
}

interface Props {
  project: Project;
}
const { project } = Astro.props;
const VIEWS = [{ label: 'List' }, { label: 'Board' }, { label: 'Schedule' }];
---

<!-- manifest:
  layout: PermitTrackerLayout > stack(xl)        # SPINE
  sections:
    - page header -> esa-page-header              # breadcrumbs, project name, client / no. / PM / construction start; Edit project, Team, Configure statuses, Add permit
    - readiness   -> bcn-permit-readiness         # issued of total, forecast all-issued date vs construction start, Sites table (Add site / edit via bcn-site-editor), risks
    - permits     -> esa-tab-layout               # List | Board | Schedule
        # panel 0 -> bcn-permit-table             #   AG Grid of every permit, store-resolved status + flags
        # panel 1 -> bcn-permit-board             #   workflow columns; drag or Move to change status
        # panel 2 -> bcn-permit-schedule          #   bar per permit on a calendar; dependents under what gates them; site filter
    - configure   -> bcn-permit-status-config     # per-project workflows over the status backbone
    - team        -> bcn-project-team             # drawer: add / remove people; drives My projects
    - add permit  -> bcn-add-permit               # drawer: type, applies to, agency, assignee, trigger, waits on
    - edit        -> bcn-project-editor           # drawer: client, no., PM, construction start; re-runs readiness
-->

<PermitTrackerLayout title={project.name} active="projects">
  <div class="stack" data-gap="xl">
    <EsaPageHeader
      title={project.name}
      meta={[
        { label: 'Client', value: project.client },
        { label: 'Project no.', value: project.number },
        { label: 'Project manager', value: project.manager },
        { label: 'Construction start', value: fmtDate(project.constructionStart) },
      ]}
    >
      <EsaBreadcrumbs slot="breadcrumbs" items={[{ label: 'Projects', href: withBase(ROUTES.projects) }, { label: project.name }]} />
      <Fragment slot="actions">
        <div class="cluster" data-gap="sm">
          <EsaButton variant="ghost" appearance="outline" icon="pencil" iconOnly label="Edit project" data-project-edit />
          <EsaButton variant="ghost" appearance="outline" icon="users" iconOnly label="Project team" data-project-team />
          <EsaButton variant="ghost" appearance="outline" icon="settings" iconOnly label="Configure statuses" data-permit-configure data-project-id={project.id} />
          <EsaButton variant="primary" icon="plus" data-add-permit>Add permit</EsaButton>
        </div>
      </Fragment>
    </EsaPageHeader>

    <BcnPermitReadiness projectId={project.id} editable />

    <esa-tab-layout tabs={JSON.stringify(VIEWS)} appearance="segmented" size="md" active-index="0">
      <div slot="panel-0"><BcnPermitTable projectId={project.id} /></div>
      <div slot="panel-1"><BcnPermitBoard projectId={project.id} /></div>
      <div slot="panel-2"><BcnPermitSchedule projectId={project.id} /></div>
    </esa-tab-layout>
  </div>

  <BcnPermitStatusConfig projectId={project.id} />
  <BcnProjectTeam projectId={project.id} />
  <BcnAddPermit projectId={project.id} />
  <BcnProjectEditor projectId={project.id} />
</PermitTrackerLayout>

<script>
  import '@esa/ecology/esa-tab-layout';
</script>
