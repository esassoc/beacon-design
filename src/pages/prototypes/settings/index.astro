---
// Unified Settings — HOME. The front door to the one settings framework that spans ESA
// and tenant administration. The rail is the index of every settings page, so the home
// route holds no second copy of it: it lands on a null state that points at the rail and
// the search, then shows the record of what has recently changed across all of them.
import AppShell from '../../../layouts/AppShell.astro';
import PageLayout from '../../../layouts/PageLayout.astro';
import EsaCard from '@esa/ecology/esa-card.astro';
import EsaEmptyState from '@esa/ecology/esa-empty-state.astro';
import EsaIcon from '@esa/ecology/esa-icon.astro';
import BcnSettingsShell from '../../../components/bcn/BcnSettingsShell.astro';
import BcnChangeLog from '../../../components/bcn/BcnChangeLog.astro';
import {
  SETTINGS_CHANGES,
  settingsPage,
  settingsPagePath,
} from '../../../data/settings-registry';
import { withBase } from '../../../lib/base';

const crumbs = [{ label: 'Home', href: withBase('/') }, { label: 'Settings' }];

// SETTINGS_CHANGES is newest-first and flat; BcnChangeLog groups by day. Parse the ISO
// parts by hand — new Date('2026-07-28') reads UTC midnight and renders a day early
// west of Greenwich.
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const fmtDate = (on: string): string => {
  const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(on);
  if (!m) return on;
  return `${MONTHS[Number(m[2]) - 1]} ${Number(m[3])}, ${m[1]}`;
};

const byDay = new Map<string, { text: string; emphasis?: string; href?: string; by: string }[]>();
for (const change of SETTINGS_CHANGES) {
  const page = settingsPage(change.pageId);
  const events = byDay.get(change.on) ?? [];
  events.push({
    text: `${change.summary} in`,
    emphasis: page?.title ?? change.pageId,
    href: withBase(settingsPagePath(change.pageId)),
    by: change.by,
  });
  byDay.set(change.on, events);
}
const changeDays = [...byDay.entries()].map(([on, events]) => ({ date: fmtDate(on), events }));
---

<!-- manifest:
  layout: AppShell > PageLayout > stack(xl)      # SPINE — the shell owns the rail, the stack the two bands
  sections:
    - settings frame -> bcn-settings-shell       # search + zone nav + view-as switch; wraps all page content
    - null state     -> esa-empty-state          # no page selected — points at the rail and the search
    - recent changes -> bcn-change-log           # SETTINGS_CHANGES grouped by day, each linked to its page
-->

<AppShell expandedSections={[]} title="Settings — Beacon">
  <PageLayout title="Settings" breadcrumbs={crumbs}>
    <BcnSettingsShell activePageId="home">
      <div class="stack" data-gap="xl">
        <EsaCard variant="outlined">
          <!-- esa-empty-state and esa-icon BOTH size the slotted svg, at equal
               specificity — point their public size tokens at one value so the glyph
               renders the same regardless of which rule the build orders last. -->
          <div style="--empty-state-icon-size-lg: 3rem; --icon-size-xl: 3rem;">
            <EsaEmptyState
              size="lg"
              title="Select a settings page"
              description="Pick a page from the rail, or search across every setting."
            >
              <EsaIcon slot="icon" name="settings" size="xl" />
            </EsaEmptyState>
          </div>
        </EsaCard>

        <EsaCard variant="outlined" title="Recent changes">
          <BcnChangeLog days={changeDays} />
        </EsaCard>
      </div>
    </BcnSettingsShell>
  </PageLayout>
</AppShell>
