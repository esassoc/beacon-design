---
// Unified Settings — the /settings route itself has NO page (2026-08-03 shaping call). It
// lands on the first settings page the signed-in user can reach.
//
// The landing page it replaced was a null state ("Select a settings page") over a Recent
// changes feed. The feed needed a settings audit trail Beacon has no table for and left
// scope with the other two data-backed surfaces; what remained was a screen whose only job
// was to point at the rail — and the rail is already the index of every page, present on
// every route. So there is no home to design or maintain: the rail IS the home.
//
// FIRST PAGE, DERIVED. The target is the rail's own first row, computed the way
// <BcnSettingsNav> computes it — audience blocks in AUDIENCE_ORDER, zones in registry
// order inside each — so re-ordering the rail moves this redirect with it and the two can
// never disagree. In the real app the audience comes from the signed-in user
// (User.IsEsaAdmin), which is what makes the target differ per user; the prototype has no
// session, so it resolves the ESA-admin rail it renders.
//
// STATIC REDIRECT. The spoke builds to static HTML with no server to send a 302, so this
// is a meta refresh plus a real link for anyone who lands with it disabled. `canonical`
// points at the destination so the redirect is not the indexed URL.
import { SETTINGS_ZONES, pagesByZone, settingsPagePath } from '../../../data/settings-registry';
import type { SettingsAudience } from '../../../data/settings-registry';
import { withBase } from '../../../lib/base';

const AUDIENCE_ORDER: SettingsAudience[] = ['esa-admin', 'tenant-admin'];

const firstPage = AUDIENCE_ORDER.flatMap((audience) =>
  SETTINGS_ZONES.flatMap((zone) => pagesByZone(zone.id).filter((p) => p.audience === audience))
)[0];

const target = withBase(settingsPagePath(firstPage.id));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <title>Settings — Beacon</title>
  </head>
  <body>
    <a href={target}>Continue to {firstPage.title}</a>
  </body>
</html>
