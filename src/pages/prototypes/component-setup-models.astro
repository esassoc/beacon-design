---
// Component Setup — two models. A comparison page, not a proposal.
//
// The job: decide which of a project's commitments apply to a given component.
// Prod calls this the "{Component} Setup" tab, and it is the screen Andy
// described on the 2026-08-13 call as "the first thing I ever designed in
// Beacon… I actually don't think it's working very well right now, it looks
// broken, it says 52 pending."
//
// It is broken, and reading the code says where: `ComponentCommitment` stores a
// NOT NULL bit, so there is no pending state in the data at all. Pending is
// manufactured by a view that LEFT JOINs every component in the project against
// every commitment in the project and calls the misses pending. That single fact
// produces the whole symptom set — a count that measures the project instead of
// the component, a count that re-inflates whenever any source document gains a
// commitment, and a badge that counts the unfiltered set over a list filtered to
// one source document. "52 pending" over a list of three is the normal case.
//
// So this page leads with the diagnosis and then puts TWO answers beside each
// other, because the diagnosis does not settle the interaction:
//
//   · MODEL A — a decision workspace. Facets that actually agree with their
//     counts, a preview beside the list, real bulk with a rationale that warns
//     before it overwrites. Bets the job is a backlog you work down.
//   · MODEL B — a triage queue. One commitment at a time, full width, keyboard
//     decisions, a batch that ENDS. Bets the job is a stream you keep up with,
//     and that the reason nothing gets decided is that nobody starts.
//
// Both are held to the same contract (see bcn-setup-teardown): scoped counts
// that match their lists, "new since last review" separated from the standing
// backlog, an explicit statement of what a decision DOES — applying materializes
// actions onto the component, which is what fills the tracker and which the
// current screen never mentions — per-commitment rationale, and no control that
// cannot act (prod's Construction Activity filter is rendered, populated, and
// permanently disabled; neither model reproduces it).
//
// Deliberately symmetrical: same card shape, same button weight, neither marked
// recommended. Andy asked for the comparison, not for a winner picked here.
import AppShell from '../../layouts/AppShell.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import BcnSetupTeardown from '../../components/bcn/BcnSetupTeardown.astro';
import BcnSetupModelCard from '../../components/bcn/BcnSetupModelCard.astro';
import BcnSetupNotes from '../../components/bcn/BcnSetupNotes.astro';
import BcnSetupWorkspace from '../../components/bcn/BcnSetupWorkspace.astro';
import BcnSetupQueue from '../../components/bcn/BcnSetupQueue.astro';
import { COMPONENT } from '../../data/component-detail';
import { componentNav } from '../../data/component-nav';
---

<!-- manifest:
  layout: stack(2xl)                                   # the page SPINE
  sections:
    - what's broken today -> bcn-setup-teardown        # the diagnosis, stated once, with the evidence
    - model A card        -> bcn-setup-model-card      # the door into Model A
    - model B card        -> bcn-setup-model-card      # the door into Model B
    - model A drawer      -> bcn-setup-workspace       # faceted decision workspace (overlay)
    - model B drawer      -> bcn-setup-queue           # one-at-a-time triage queue (overlay)
    - choosing between    -> bcn-setup-notes           # the contrast, the open questions, what to react to
-->

<AppShell
  title="Component Setup — two models"
  tenantName="DWR"
  projectName="Delta Conveyance"
  navSections={componentNav('components')}
>
  <PageLayout
    title="Component Setup — two models"
    breadcrumbs={[
      { label: 'Delta Conveyance', href: '/prototypes/project-dashboard' },
      { label: 'Components', href: '/prototypes/components' },
      { label: COMPONENT.name, href: '/prototypes/component-dashboard' },
      { label: 'Setup' },
    ]}
  >
    <div class="stack" data-gap="2xl">
      <BcnSetupTeardown />

      <div class="grid" data-gap="lg" style="--grid-min: 22rem;">
        <BcnSetupModelCard
          letter="A"
          name="Decision workspace"
          thesis="Deciding is slow because the list is unusable. Give the user facets that work and the power to act on many commitments at once."
          moves={[
            'Facets recompute per view, and every option carries the count it will produce.',
            'A preview pane beside the list, so a commitment can be read without losing your place.',
            'Bulk apply and dismiss, with a rationale step that names how many existing rationales it would overwrite.',
            'Inline apply and dismiss on hover, for the ones that need no thought.',
          ]}
          opens="bcn-setup-workspace"
          cta="Open Model A"
        />
        <BcnSetupModelCard
          letter="B"
          name="Triage queue"
          thesis="Deciding is slow because nobody starts. Show one commitment at a time, and make the batch end."
          moves={[
            'Pick a batch first — what is new since your last review, everything undecided, or one source document.',
            'One commitment, full width, with room to actually read it.',
            'Apply, dismiss or skip from the keyboard; progress is always on screen.',
            'A closing summary that names what was applied, dismissed and skipped before anything commits.',
          ]}
          opens="bcn-setup-queue"
          cta="Open Model B"
        />
      </div>

      <BcnSetupNotes />
    </div>
  </PageLayout>

  <BcnSetupWorkspace id="bcn-setup-workspace" componentName={COMPONENT.name} />
  <BcnSetupQueue id="bcn-setup-queue" componentName={COMPONENT.name} />
</AppShell>

<script>
  // The model cards are the only way in, since both models are overlays. Each
  // card carries the id of the drawer it opens; opening is setting `open` on the
  // esa-side-dialog host, the same handshake BcnEvidenceEntryPoints uses.
  document.querySelectorAll<HTMLElement>('[data-opens]').forEach((launcher) => {
    launcher.addEventListener('click', () => {
      const target = document.getElementById(launcher.dataset.opens ?? '');
      if (!target) return;
      const host = target as HTMLElement & { open?: boolean; show?: () => void };
      if (typeof host.show === 'function') host.show();
      else host.open = true;
    });
  });
</script>
