---
// Revisions, for a plan in the repo model (new design, 2026-10-26), after WordPress's revisions screen. `?id=` is the
// plan. With `&draft=` it reviews that draft against Live and publishes a revision; without, it is the plan's
// history, where any version can be restored as a new one.
import AppShell from '../../../../layouts/AppShell.astro';
import PageLayout from '../../../../layouts/PageLayout.astro';
import BcnPlanRevisions from '../../../../components/bcn/BcnPlanRevisions.astro';
import BcnPlanPeople from '../../../../components/bcn/BcnPlanPeople.astro';
import { withBase } from '../../../../lib/base';
---

<!-- manifest:
  layout: AppShell > PageLayout                       # SPINE
  sections:
    - revisions -> bcn-plan-revisions                 # head, bcn-revision-slider, From / To cards, change list + Gantt + rail
    - people    -> bcn-plan-people                    # the avatar bank
-->

<AppShell title="Revisions" tenantName="DWR" projectName="Delta Conveyance" activeNavId="plans" planningFirst>
  <PageLayout
    title="Revisions"
    icon="history"
    breadcrumbs={[{ label: 'Plans', href: withBase('/prototypes/plans-repo/') }, { label: 'Plan', href: withBase('/prototypes/plans-repo/') }, { label: 'Revisions' }]}
  >
    <BcnPlanRevisions />
    <BcnPlanPeople />
  </PageLayout>
</AppShell>

<script>
  // Retired (2026-10-29) for the plan page's Revisions modal: a link here opens that (or the draft it named), carrying
  // the rest of its query (?user=, the studies).
  const p = new URLSearchParams(location.search);
  if (!p.has('draft')) p.set('revisions', '1');
  location.replace(`${location.pathname.replace(/revisions\/?$/, 'plan/')}?${p.toString()}`);
</script>
