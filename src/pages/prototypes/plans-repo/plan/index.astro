---
// One plan, in the repo model (new design, 2026-10-26). `?id=` is the plan; `&draft=` opens a draft (yours to edit,
// anyone else's read-only). Dragging a bar on Live checks out your draft. Review and publish opens the revisions page.
import AppShell from '../../../../layouts/AppShell.astro';
import PageLayout from '../../../../layouts/PageLayout.astro';
import BcnPlanRepoPage from '../../../../components/bcn/BcnPlanRepoPage.astro';
import BcnPlanElementDrawer from '../../../../components/bcn/BcnPlanElementDrawer.astro';
import BcnPlanPeople from '../../../../components/bcn/BcnPlanPeople.astro';
import BcnDividerTabs from '../../../../components/bcn/BcnDividerTabs.astro';
import { PLAN_ICON_PATHS } from '../../../../lib/planning/icons';
import { withBase } from '../../../../lib/base';
---

<!-- manifest:
  layout: AppShell > PageLayout                       # SPINE
  sections:
    - views       -> bcn-divider-tabs > esa-button-toggle  # Schedule, Budget, Documents, Deliverables, on the divider
    - page        -> bcn-plan-repo-page               # repo bar, status band, scrubber + tactile Gantt, About rail
    - people      -> bcn-plan-people                  # the avatar bank
-->

<AppShell title="Plan" tenantName="DWR" projectName="Delta Conveyance" activeNavId="plans" planningFirst>
  <PageLayout
    title="Plan"
    icon="square-chart-gantt"
    iconColor="var(--color-content-brand)"
    iconPaths={PLAN_ICON_PATHS['square-chart-gantt']}
    breadcrumbs={[{ label: 'Plans', href: withBase('/prototypes/plans-repo/') }, { label: 'Plan' }]}
  >
    <!-- The plan's views on the divider under the title (2026-10-28, Andy: "centered tabs through the divider", a step
         smaller than the header's toggle). -->
    <div class="bcn-plan-views">
      <BcnDividerTabs><esa-button-toggle size="sm" label="" aria-label="View" data-prp-view-toggle></esa-button-toggle></BcnDividerTabs>
    </div>
    <BcnPlanRepoPage />
    <BcnPlanPeople />
    <BcnPlanElementDrawer />
  </PageLayout>
</AppShell>

<style>
  /* The tabs row is this page's divider: the title row drops its own, and the row sits where it was. */
  :global(.page-layout .page-layout__container .page-layout__title) {
    border-bottom: 0;
  }
  .bcn-plan-views {
    margin-block: calc(-1 * var(--spacing-500)) var(--spacing-600);
  }
</style>

<script>
  import { setupPlanRepoPage } from '../../../../components/bcn/plan-repo-page';
  const root = document.querySelector<HTMLElement>('[data-bcn-plan-repo-page]');
  if (root) void setupPlanRepoPage(root);
</script>
